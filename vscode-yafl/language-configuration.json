{
    "comments": {
        "lineComment": "#"
    },
    "brackets": [
        ["(", ")"],
        ["[", "]"]
    ],
    "autoClosingPairs": [
        { "open": "(", "close": ")" },
        { "open": "[", "close": "]" },
        { "open": "\"", "close": "\"" },
        { "open": "'", "close": "'" },
        { "open": "`", "close": "`" }
    ],
    "surroundingPairs": [
        ["(", ")"],
        ["[", "]"],
        ["\"", "\""],
        ["'", "'"],
        ["`", "`"]
    ],
    "wordPattern": "(`[^`]+`)|([A-Za-z_][A-Za-z0-9_]*)",
    "onEnterRules": [
        {
            "beforeText": "^\\s*#.*$",
            "action": { "indent": "none", "appendText": "# " }
        }
    ],
    "indentationRules": {
        "increaseIndentPattern": "^\\s*(fun|class|interface|instance|enum|typealias|namespace|match|if|else|where|let)\\b.*$"
    }
}
