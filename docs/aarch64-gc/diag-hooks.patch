+    gc_page_t* page = (gc_page_t*)((uintptr_t)obj & ~(uintptr_t)(GC_PAGE_SIZE - 1));
+    bitmap_t b; memset(&b, 0, sizeof b);
+    long slot = ((char*)obj - (char*)page->slots) / GC_SLOT_SIZE;
+    if (slot >= 0 && slot < SLOTS_PER_PAGE) b.a[slot / GC_MASK_SIZE] |= (mask_bits_t)1 << (slot % GC_MASK_SIZE);
+    gc_trace_page_event(page, (enum gc_trace_kind)kind, &b, aux);
+}
