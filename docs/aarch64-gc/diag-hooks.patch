+EXPORT void gc_diag_bad(const char* what, object_t* bad, const void* via) {
+    gc_trace_report_begin();
+    fprintf(stderr, "\nDIAG %s: %p (via %p) cycle-now %llu\n", what, (void*)bad, via,
+            (unsigned long long)atomic_load(&gc_cycle_count));
+    gc_trace_explain("bad", bad);
+    if (via && gc_in_heap(via)) gc_trace_explain("via", via);
+    void* bt[40]; int n = backtrace(bt, 40);
+    fprintf(stderr, "  backtrace:");
+    for (int i = 0; i < n; ++i) fprintf(stderr, " %p", bt[i]);
+    fprintf(stderr, "\n");
+    FILE* m = fopen("/proc/self/maps", "r"); char line[512];
+    while (m && fgets(line, sizeof line, m)) if (strstr(line, "r-xp") && strstr(line, "mesh")) fputs(line, stderr);
+    if (m) fclose(m);
+    fflush(stderr);
+    abort();
+}
