namespace Main

import System
import System::IO

# Copy stdin to stdout, prefixing each line with its 1-based line number.
#
# Read stdin whole, then run one stream pipeline over its text: split it into
# lines, number them, and drain the result to stdout. No hand-written loop —
# `toLines` and `prependLineNumbers` are the stream transformers; `writeStream`
# drains a string stream into any IO.
#
# Exit codes:
#   0  ok
#   1  IO error

fun main(): System::Int
  let input = readAll(stdin())
  let inClosed = input.io.close()
  ret match(input.v)
    (text: String) => number(text, inClosed)
    (e: IOError)   => 1

# Number the lines of `text` onto stdout, then report the outcome: a write
# error wins, otherwise a failed close (of stdin or stdout), otherwise success.
fun number(text: String, inClosed: IOError|None): System::Int
  let out = writeStream(stdout(), once(text) |> toLines |> prependLineNumbers)
  let outClosed = out.io.close()
  ret out.v !is None || inClosed !is None || outClosed !is None ? 1 : 0
