namespace Main

import System
import System::IO
import System::Json


# Pretty-print JSON read from stdin to stdout, in constant memory.
#
# The whole pipeline is a lazy stream: bytes are pulled from stdin only as the
# formatter needs them and written to stdout as they are produced, so an
# arbitrarily large document never has to be held in memory at once.
#
#   stdin → asStream → tokenize → prettyEmit → writeStream → stdout
#
# No type argument is written anywhere, and no `let`: each pipe stage binds the
# previous stage's tuple positionally. The stdin handle `i` is never referenced,
# so it auto-closes at scope exit through the `Drop<IO>` instance — AFTER the
# stream is drained (scope-exit timing) — and a read-side close error is
# discarded by that instance's declared policy. The stdout handle's close is
# the final flush, so ITS error matters: `o` is consumed explicitly on every
# path, and a close failure turns an otherwise clean run into an IO error.
# Exit codes:
#   0  ok
#   1  IO error (including a failed output flush/close)
#   2  parse error
# ── file/tree modes ──────────────────────────────────────────────────────────
#   json_pretty                 stdin -> stdout (as before)
#   json_pretty <file.json>     convert ONE file to <file.json.pretty>
#   json_pretty -r <dir>        RECURSIVELY convert every .json under <dir>,
#                               in parallel ([future] divide-and-conquer)
# Recursion is deliberately opt-in behind -r: a bare directory argument is
# refused rather than silently walking a tree. Exit code = failed-file count.

fun gatherJson(path: String): List<String>
  fun skipEntry(name: String): Bool
    ret length(name) == 0 || byteAt(name, 0) == '.'
  fun gatherDir(): List<String>
    ret match(listDir(path))
      # Sorted: the fold concatenates each subtree in turn, so the order the
      # names arrive in decides the order files are visited, and readdir order
      # is not stable from one run to the next.
      (names: Set<String>) =>
          fold<String, List<String> >(sort<String>(names), List<String>(),
            (acc: List<String>, name: String) =>
              skipEntry(name) ? acc : concat<String>(acc, gatherJson(path + "/" + name)))
      (e: IOError) => List<String>()
  ret match(stat(path))
    (info: FileInfo) => info.isDir ? gatherDir()
      : (endsWith(path, ".json") ? prepend<String>(path, List<String>()) : List<String>())
    (e: IOError)     => List<String>()

# One file: both linear handles are opened, threaded and closed entirely
# within this call, so a conversion is safe inside its own [future] worker.
fun convertOne(path: String): Int
  fun pipe(i: IO, o: IO): Int
    ret i.asStream()
      |> (i2, s) => writeStream(o, prettyEmit(tokenize(s)))
      |> (o2, v) => (o2.close(), i2.close(), v)
      |> (c1, c2, v) => match(v)
        (e: IOError)        => 1
        (p: JsonParseError) => 1
        (n: System::None)   => (c1 !is None || c2 !is None) ? 1 : 0
  fun failCleanup(): Int
    ret remove(path + ".pretty") |> (r) => 1
  fun run(i: IO, o: IO): Int
    ret pipe(i, o) == 0 ? 0 : failCleanup()
  ret match(open_read(path))
    (i: IO) => match(open_write(path + ".pretty", true))
      (o: IO)      => run(i, o)
      (e: IOError) => i.close() |> (c) => 1
    (e: IOError) => 1

# Failure count over the list: one half spawns as a [future], the other
# converts here; reading the future is the join.
fun convertAll(files: List<String>): Int
  fun splitAndGo(): Int
    let (l, r) = splitHalf<String>(files)
    let [future] a = convertAll(l)
    let b = convertAll(r)
    ret a + b
  ret match(head<String>(files))
    (p: String) => isEmpty<String>(tail<String>(files)) ? convertOne(p) : splitAndGo()
    (e: None)   => 0

fun runTree(dir: String): System::Int
  fun report(total: Int, failed: Int): Int
    print("converted " + String(total - failed) + " ok, " + String(failed) + " failed\n")
    ret failed
  let files = gatherJson(dir)
  let total = chainLength<String>(chain<String>(files))
  ret report(total, convertAll(files))

fun runSingle(path: String): System::Int
  ret match(stat(path))
    (info: FileInfo) => info.isDir
      ? (print(path + " is a directory — pass -r to convert a tree\n") |> (u) => 2)
      : convertOne(path)
    (e: IOError) => print("cannot stat " + path + "\n") |> (u) => 2

fun runStdio(): System::Int
  ret stdin().asStream()
    |> (i, s) => writeStream(stdout(), prettyEmit(tokenize(s)))
    |> (o, v) => (o.close(), v)
    |> (c, v) => match(v)
      (e: IOError)        => 1
      (p: JsonParseError) => 2
      (n: System::None)   => c !is None ? 1 : 0

fun main(): System::Int
  fun runFlagged(a: List<String>): System::Int
    ret match(head<String>(tail<String>(a)))
      (dir: String)     => runTree(dir)
      (e: System::None) => print("-r requires a directory\n") |> (u) => 2
  let a = args()
  ret match(head<String>(a))
    (first: String)   => first == "-r" ? runFlagged(a) : runSingle(first)
    (e: System::None) => runStdio()
