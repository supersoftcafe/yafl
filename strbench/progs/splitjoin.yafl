namespace SplitJoin

import System

# Build a text of words, split it, join it back with a different separator —
# several rounds. Lots of short slices and one big join per round.
fun [tail] words(i: Int, n: Int, acc: String): String
  ret i >= n ? acc : words(i + 1, n, acc + " w" + String(i % 1000))

fun [tail] rounds(k: Int, text: String, total: Int): Int
  if k <= 0
    ret total
  let parts = split(text, " ")
  let joined = join(parts, ",")
  ret rounds(k - 1, joined, total + length(joined))

fun main(): System::Int
  let text = words(0, 400000, "start")
  println(String(rounds(6, text, 0)))
  ret 0
