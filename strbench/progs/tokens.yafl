namespace Tokens

import System

# Parser-style scanning: skipAny/findAny over a big buffer, slicing every
# token out and summing their lengths — the tokenizer shape.
fun [tail] build(i: Int, n: Int, acc: String): String
  ret i >= n ? acc : build(i + 1, n, acc + "alpha" + String(i % 97) + "  beta_" + String(i % 13) + "\t")

fun [tail] scan(s: String, pos: Int, n: Int, count: Int, total: Int): (c: Int, t: Int)
  let start = skipAny(s, " \t", pos)
  if start >= n
    ret (count, total)
  let end = findAny(s, " \t", start)
  let tok = slice(s, start, end)
  ret scan(s, end, n, count + 1, total + length(tok))

fun main(): System::Int
  let s = build(0, 800000, "")
  let r = scan(s, 0, length(s), 0, 0)
  println(String(r.c) + " " + String(r.t))
  ret 0
