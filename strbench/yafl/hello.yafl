namespace Hello

import System

fun main(): System::Int
  let short = "hi"
  let mid = "fifteen chars!!"
  let long = "this string is definitely longer than fifteen bytes"
  let joined = short + " / " + mid + " / " + long
  let m: String|Int|None = joined
  let label = match(m)
    (s: String) => "string of " + String(length(s))
    (i: Int)    => "int"
    (n: None)   => "none"
  System::print(joined + "\n")
  System::print(label + "\n")
  ret 0
