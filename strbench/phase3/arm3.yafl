namespace ArmU

import System

enum QKind
  enum QUnit()
  enum QScalar(qScalar: String)
  enum QFun()

fun a1(kind: QKind|None): String => match(kind)
  (sc: QScalar) => "pack:" + sc.qScalar
  (f: QFun)     => "fun"
  (k: QKind)    => "word"
  ()            => "none"

fun a2(kind: QKind|None): String => match(kind)
  (sc: QScalar) => "pack:" + sc.qScalar
                   + "x"
  (f: QFun)     => "fun"
  (k: QKind)    => "word"
  ()            => "none"

fun a3(kind: QKind|None, word: Int): String => match(kind)
  (sc: QScalar) => "pack:" + sc.qScalar + String(word)
  (f: QFun)     => "fun"
  (k: QKind)    => "word"
  ()            => "none"

fun main(): System::Int
  print(a1(QFun()) + a2(None) + a3(QUnit(), 3) + "\n")
  ret 0
