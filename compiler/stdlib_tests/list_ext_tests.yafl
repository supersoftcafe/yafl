# Tests for the List<T> combinators: fold, splitHalf, flatMap, zipMap, and the
# EMPTY-LIST edge cases of any/all.
#
# Ported from compiler/tests/test_list_ext.py and test_list_ops.py, which each
# ran one program printing `label=value` lines and compared the whole stdout
# block. One behaviour per test here, so a failure names the combinator instead
# of pointing at a diff of thirty lines.
#
# `length` is deliberately absent from the stdlib (a list is a sequence, not an
# indexable buffer), so counts are taken with an explicit fold — which is also
# what the Python original did.
#
# See list_tests.yafl for why these live outside stdlib/.

namespace StdlibTests::ListExtTests

import System
import System::Test


fun _ints(a: Int, b: Int, c: Int, d: Int, e: Int): List<Int>
    ret build(push(push(push(push(push(builder<Int>(), a), b), c), d), e))

fun _sum(l: List<Int>): Int
    ret fold(l, 0, (acc: Int, x: Int) => acc + x)

fun _count(l: List<Int>): Int
    ret fold(l, 0, (acc: Int, x: Int) => acc + 1)

fun _headOr(l: List<Int>, fallback: Int): Int
    ret match(head(l))
        (v: Int)  => v
        (n: None) => fallback

fun _lastOr(l: List<Int>, fallback: Int): Int
    ret match(last(l))
        (v: Int)  => v
        (n: None) => fallback


# ── fold ────────────────────────────────────────────────────────────────────

fun [test("fold accumulates left to right over every element")] foldSums(): None|TestFailure
    ret assertEqInt(_sum(_ints(1, 2, 3, 4, 5)), 15, "sum 1..5")
     ?? assertEqInt(_count(_ints(1, 2, 3, 4, 5)), 5, "count")

fun [test("fold over an empty list returns the seed untouched")] foldEmptySeed(): None|TestFailure
    ret assertEqInt(_sum(List<Int>()), 0, "sum of empty")
     ?? assertEqInt(fold(List<Int>(), 99, (acc: Int, x: Int) => acc + x), 99, "seed kept")

# Order matters and a commutative operator cannot show it: subtraction can.
# Left-to-right gives ((((0-1)-2)-3)-4)-5 = -15; right-to-left would give 3.
fun [test("fold is LEFT to right, shown with a non-commutative operator")] foldIsLeftToRight(): None|TestFailure
    ret assertEqInt(fold(_ints(1, 2, 3, 4, 5), 0,
            (acc: Int, x: Int) => acc - x), 0 - 15, "left fold")


# ── splitHalf ───────────────────────────────────────────────────────────────

fun [test("splitHalf divides a list, the extra element going right")] splitHalfDivides(): None|TestFailure
    let parts = splitHalf(_ints(1, 2, 3, 4, 5))
    ret assertEqInt(_count(parts.left), 2, "left count")
     ?? assertEqInt(_count(parts.right), 3, "right count")
     ?? assertEqInt(_headOr(parts.left, 0), 1, "left head")
     ?? assertEqInt(_lastOr(parts.left, 0), 2, "left last")
     ?? assertEqInt(_headOr(parts.right, 0), 3, "right head")
     ?? assertEqInt(_lastOr(parts.right, 0), 5, "right last")

fun [test("splitHalf of one element leaves the left side empty")] splitHalfSingle(): None|TestFailure
    let parts = splitHalf(prepend(7, List<Int>()))
    ret assertTrue(isEmpty(parts.left), "left empty")
     ?? assertEqInt(_headOr(parts.right, 0), 7, "right head")

fun [test("splitHalf of an empty list gives two empty lists")] splitHalfEmpty(): None|TestFailure
    let parts = splitHalf(List<Int>())
    ret assertTrue(isEmpty(parts.left), "left empty")
     ?? assertTrue(isEmpty(parts.right), "right empty")


# ── flatMap ─────────────────────────────────────────────────────────────────

fun _twice(x: Int): List<Int>
    ret prepend(x, prepend(x, List<Int>()))

fun [test("flatMap concatenates the lists its function returns")] flatMapConcatenates(): None|TestFailure
    let l = prepend(1, prepend(4, List<Int>()))
    ret assertEqInt(_count(flatMap(l, _twice)), 4, "count")
     ?? assertEqInt(_sum(flatMap(l, _twice)), 10, "sum")

fun [test("flatMap returning empty lists yields an empty list")] flatMapEmpties(): None|TestFailure
    let l = prepend(1, prepend(2, List<Int>()))
    ret assertTrue(isEmpty(flatMap(l, (x: Int) => List<Int>())), "all empty")


# ── zipMap ──────────────────────────────────────────────────────────────────

fun [test("zipMap combines two lists element by element")] zipMapCombines(): None|TestFailure
    let a = prepend(1, prepend(2, List<Int>()))
    let b = prepend(10, prepend(20, List<Int>()))
    ret assertEqInt(_sum(zipMap(a, b, (x: Int, y: Int) => x * y)), 50, "1*10 + 2*20")

# The shorter input decides the length — the surplus tail is dropped, not an
# error and not padded.
fun [test("zipMap stops at the shorter of the two lists")] zipMapStopsShort(): None|TestFailure
    let a = prepend(1, prepend(2, List<Int>()))
    let b = prepend(10, List<Int>())
    ret assertEqInt(_count(zipMap(a, b, (x: Int, y: Int) => x + y)), 1, "one pair")


# ── any / all on the EMPTY list ─────────────────────────────────────────────
# The vacuous cases, and the ones most often got wrong: `any` over nothing is
# FALSE (no witness exists) while `all` over nothing is TRUE (no counterexample
# exists). A test over non-empty lists cannot distinguish a correct
# implementation from one that simply returns its seed.

fun [test("any over an empty list is false, all over an empty list is true")] vacuousQuantifiers(): None|TestFailure
    ret assertFalse(any(List<Int>(), (x: Int) => true), "any of empty is false")
     ?? assertTrue(all(List<Int>(), (x: Int) => false), "all of empty is true")
