# Tests for System::Uri (stdlib/Uri/uri.yafl).
# See Containers/list_tests.yafl for why these live outside stdlib/.

namespace StdlibTests::UriTests

import System
import System::Test
import System::Uri


# A parse as one string: the URI back as text, or "err".
fun _text(s: String): String => match(parseUri(s))
    (u: Uri)      => String(u)
    (e: UriError) => "err"

# The position a parse failed at, -1 when it did not fail.
fun _errAt(s: String): Int => match(parseUri(s))
    (u: Uri)      => -1
    (e: UriError) => e.pos

# One component of a parse, "<err>" when the parse failed, "-" when absent.
fun _part(s: String, get: (:Uri): String|None): String => match(parseUri(s))
    (u: Uri)      => get(u) ?? "-"
    (e: UriError) => "<err>"

fun _port(s: String): Int => match(parseUri(s))
    (u: Uri)      => uriPort(u) ?? -1
    (e: UriError) => -2

fun _path(s: String): String => match(parseUri(s))
    (u: Uri)      => uriPath(u)
    (e: UriError) => "<err>"

fun _scheme(s: String): String => match(parseUri(s))
    (u: Uri)      => uriScheme(u)
    (e: UriError) => "<err>"

# The file path of a URI string, "-" when it names none.
fun _file(s: String): String => match(parseUri(s))
    (u: Uri)      => filePath(u) ?? "-"
    (e: UriError) => "<err>"

# The URI text for a path, "-" when the path has none.
fun _fileUri(p: String): String => match(fileUri(p))
    (u: Uri)  => String(u)
    (_: None) => "-"


fun [test("the RFC 3986 examples round trip")] rfcExamples(): None|TestFailure
    ret assertEqStr(_text("ftp://ftp.is.co.za/rfc/rfc1808.txt"), "ftp://ftp.is.co.za/rfc/rfc1808.txt", "ftp")
     ?? assertEqStr(_text("http://www.ietf.org/rfc/rfc2396.txt"), "http://www.ietf.org/rfc/rfc2396.txt", "http")
     ?? assertEqStr(_text("ldap://[2001:db8::7]/c=GB?objectClass?one"), "ldap://[2001:db8::7]/c=GB?objectClass?one", "ldap")
     ?? assertEqStr(_text("mailto:John.Doe@example.com"), "mailto:John.Doe@example.com", "mailto")
     ?? assertEqStr(_text("news:comp.infosystems.www.servers.unix"), "news:comp.infosystems.www.servers.unix", "news")
     ?? assertEqStr(_text("tel:+1-816-555-1212"), "tel:+1-816-555-1212", "tel")
     ?? assertEqStr(_text("telnet://192.0.2.16:80/"), "telnet://192.0.2.16:80/", "telnet")
     ?? assertEqStr(_text("urn:oasis:names:specification:docbook:dtd:xml:4.1.2"), "urn:oasis:names:specification:docbook:dtd:xml:4.1.2", "urn")

fun [test("a URI splits into its components")] components(): None|TestFailure
    let u = "foo://user:pw@example.com:8042/over/there?name=ferret#nose"
    ret assertEqStr(_part(u, (x: Uri) => uriScheme(x)), "foo", "scheme")
     ?? assertEqStr(_part(u, uriUserinfo), "user:pw", "userinfo")
     ?? assertEqStr(_part(u, uriHost), "example.com", "host")
     ?? assertEqInt(_port(u), 8042, "port")
     ?? assertEqStr(_path(u), "/over/there", "path")
     ?? assertEqStr(_part(u, uriQuery), "name=ferret", "query")
     ?? assertEqStr(_part(u, uriFragment), "nose", "fragment")

fun [test("absent components are None")] absentComponents(): None|TestFailure
    ret assertEqStr(_part("http://h/p", uriUserinfo), "-", "no userinfo")
     ?? assertEqInt(_port("http://h/p"), -1, "no port")
     ?? assertEqStr(_part("http://h/p", uriQuery), "-", "no query")
     ?? assertEqStr(_part("http://h/p", uriFragment), "-", "no fragment")
     ?? assertEqStr(_part("mailto:a@b", uriHost), "-", "no authority")
     ?? assertEqStr(_part("http://h:/p", uriHost), "h", "host before an empty port")
     ?? assertEqInt(_port("http://h:/p"), -1, "empty port")
     ?? assertEqStr(_part("http://h/p?", uriQuery), "", "empty query is not absent")
     ?? assertEqStr(_part("http://h/p#", uriFragment), "", "empty fragment is not absent")
     ?? assertEqStr(_path("http://h"), "", "empty path")

fun [test("the shapes of authority and path")] shapes(): None|TestFailure
    ret assertEqStr(_part("file:///a/b", uriHost), "", "empty host")
     ?? assertEqStr(_path("file:///a/b"), "/a/b", "path after an empty host")
     ?? assertEqStr(_path("file:/a/b"), "/a/b", "path-absolute")
     ?? assertEqStr(_part("file:/a/b", uriHost), "-", "no authority")
     ?? assertEqStr(_path("mailto:a@b"), "a@b", "path-rootless")
     ?? assertEqStr(_part("ldap://[2001:db8::7]:389/x", uriHost), "[2001:db8::7]", "bracketed host")
     ?? assertEqInt(_port("ldap://[2001:db8::7]:389/x"), 389, "port after a bracketed host")
     ?? assertEqStr(_part("a://h/p?q?r#f?g", uriQuery), "q?r", "? inside a query")
     ?? assertEqStr(_part("a://h/p?q?r#f?g", uriFragment), "f?g", "? inside a fragment")
     ?? assertEqStr(_part("a://h#f/g?h", uriQuery), "-", "? after # is no query")

fun [test("the scheme must be well formed")] schemes(): None|TestFailure
    ret assertEqInt(_errAt("no-colon-here"), 0, "no scheme")
     ?? assertEqInt(_errAt(":x"), 0, "empty scheme")
     ?? assertEqInt(_errAt("1a:x"), 0, "digit first")
     ?? assertEqInt(_errAt("a_b:x"), 1, "underscore")
     ?? assertEqInt(_errAt("a/b:x"), 1, "slash before the colon")
     ?? assertEqStr(_text("a+b-c.d1:x"), "a+b-c.d1:x", "the allowed marks")
     ?? assertEqStr(_scheme("HTTP://h/"), "HTTP", "case is kept")

fun [test("bad bytes are refused with their position")] badBytes(): None|TestFailure
    ret assertEqInt(_errAt("a:b c"), 3, "space in a path")
     ?? assertEqInt(_errAt("a://h/p q"), 7, "space in a path after //")
     ?? assertEqInt(_errAt("a://h/p?q r"), 9, "space in a query")
     ?? assertEqInt(_errAt("a://h/p#f r"), 9, "space in a fragment")
     ?? assertEqInt(_errAt("a://h/p#f#g"), 9, "second #")
     ?? assertEqInt(_errAt("a:b" + Char(0xE9i32)), 3, "non-ASCII byte")
     ?? assertEqInt(_errAt("a://h/[x]"), 6, "[ in a path")
     ?? assertEqInt(_errAt("a://u ser@h/"), 5, "space in userinfo")
     ?? assertEqInt(_errAt("a://h st/"), 5, "space in a host")

fun [test("escapes must be well formed")] escapes(): None|TestFailure
    ret assertEqStr(_text("a:b%20c%2f%2F"), "a:b%20c%2f%2F", "good escapes")
     ?? assertEqInt(_errAt("a:b%G1"), 3, "not hex")
     ?? assertEqInt(_errAt("a:b%1"), 3, "one digit")
     ?? assertEqInt(_errAt("a:b%"), 3, "trailing %")
     ?? assertEqInt(_errAt("a://h/p?%zz"), 8, "bad escape in a query")
     ?? assertEqInt(_errAt("a:%41"), -1, "an escape in the first path byte")

fun [test("ports are digits")] ports(): None|TestFailure
    ret assertEqInt(_errAt("a://h:80x/"), 8, "letter in a port")
     ?? assertEqInt(_errAt("a://h:8 0/"), 7, "space in a port")
     ?? assertEqInt(_port("a://h:0080/"), 80, "leading zeros")
     ?? assertEqInt(_errAt("a://[::1/"), 4, "unclosed bracket")
     ?? assertEqInt(_errAt("a://[::1]x/"), 4, "junk after a bracket")

fun [test("percent encoding")] encoding(): None|TestFailure
    ret assertEqStr(percentEncode("abcXYZ019-._~"), "abcXYZ019-._~", "unreserved stay")
     ?? assertEqStr(percentEncode("a b/c"), "a%20b%2Fc", "space and slash")
     ?? assertEqStr(percentEncode("50%"), "50%25", "percent")
     ?? assertEqStr(percentEncode(Char(0xE9i32)), "%C3%A9", "non-ASCII, per byte, upper case")
     ?? assertEqStr(encodePath("/a b/c"), "/a%20b/c", "a path keeps its slashes")
     ?? assertEqStr(percentEncode(""), "", "empty")

fun [test("percent decoding")] decoding(): None|TestFailure
    ret assertEqStr(percentDecode("a%20b"), "a b", "space")
     ?? assertEqStr(percentDecode("%c3%A9"), Char(0xE9i32), "both cases, bytes")
     ?? assertEqStr(percentDecode("%G1x"), "%G1x", "bad escape kept")
     ?? assertEqStr(percentDecode("50%"), "50%", "trailing % kept")
     ?? assertEqStr(percentDecode("%2"), "%2", "one digit kept")
     ?? assertEqStr(percentDecode(percentEncode("a b%/é\n")), "a b%/é\n", "round trip")

fun [test("a path becomes a file URI and back")] fileRoundTrip(): None|TestFailure
    ret assertEqStr(_fileUri("/home/me/x.yafl"), "file:///home/me/x.yafl", "plain")
     ?? assertEqStr(_fileUri("/a b/c%d"), "file:///a%20b/c%25d", "space and percent")
     ?? assertEqStr(_fileUri("/" + Char(0xE9i32)), "file:///%C3%A9", "non-ASCII")
     ?? assertEqStr(_file("file:///home/me/x.yafl"), "/home/me/x.yafl", "plain back")
     ?? assertEqStr(_file(_fileUri("/a b/c%d/" + Char(0xE9i32))), "/a b/c%d/" + Char(0xE9i32), "round trip")
     ?? assertEqStr(_file("file:///a%20b"), "/a b", "decoded")
     ?? assertEqStr(_file("file:/a/b"), "/a/b", "no authority")
     ?? assertEqStr(_file("file://localhost/a/b"), "/a/b", "localhost")
     ?? assertEqStr(_file("FILE:///a"), "/a", "scheme in capitals")
     ?? assertEqStr(_file("file:///a/b?q#f"), "/a/b", "query and fragment ignored")
     ?? assertEqStr(_fileUri("relative/x"), "-", "a relative path has no URI")
     ?? assertEqStr(_fileUri(""), "-", "empty path")

fun [test("other schemes name no file")] notFiles(): None|TestFailure
    ret assertEqStr(_file("http://h/a"), "-", "http")
     ?? assertEqStr(_file("untitled:Untitled-1"), "-", "untitled")
     ?? assertEqStr(_file("file:"), "-", "no path")
     ?? assertEqStr(_file("not a uri"), "<err>", "malformed")

fun [test("Windows paths")] windows(): None|TestFailure
    ret assertEqStr(_fileUri("C:\\Users\\me\\a b.txt"), "file:///C:/Users/me/a%20b.txt", "drive, backslashes")
     ?? assertEqStr(_fileUri("c:/x"), "file:///c:/x", "drive, slashes")
     ?? assertEqStr(_fileUri("C:"), "file:///C:", "drive alone")
     ?? assertEqStr(_file("file:///C:/Users/me"), "C:/Users/me", "drive back")
     ?? assertEqStr(_file("file:///c%3A/Users/me"), "c:/Users/me", "the editor's escaped colon")
     ?? assertEqStr(_file("file:///C:"), "C:", "drive alone back")
     ?? assertEqStr(_fileUri("\\\\server\\share\\a b"), "file://server/share/a%20b", "UNC")
     ?? assertEqStr(_file("file://server/share/a%20b"), "//server/share/a b", "UNC back")
     ?? assertEqStr(_file("file:///1:/x"), "/1:/x", "a digit is no drive")
