# Tests for sort / sortBy (stdlib/list.yafl).
# Ported from compiler/tests/test_list_sort.py, which drove one big program and
# grepped its stdout with assertIn — a SUBSTRING check, so "empty=[]" also
# matched "empty=[]anything". These assert equality instead, one behaviour per
# test, so a failure names the case rather than a line of output.
#
# See list_tests.yafl for why these live outside stdlib/.

namespace StdlibTests::ListSortTests

import System
import System::Test


fun _of(xs: List<Int>): String
    ret fold(xs, "", (acc: String, x: Int) => acc + String(x) + ".")

fun _strsOf(xs: List<String>): String
    ret fold(xs, "", (acc: String, x: String) => acc + x + ".")

# Built with a ListBuilder: in-order and O(1) per push.
fun _ints4(a: Int, b: Int, c: Int, d: Int): List<Int>
    ret build(push(push(push(push(builder<Int>(), a), b), c), d))


# isEmpty, not a rendered comparison against "": routing an emptiness check
# through _of would also pass if _of itself were broken and always returned
# "". Assert the property directly rather than a rendering of it.
fun [test("sorting an empty list yields an empty list")] sortEmpty(): None|TestFailure
    ret assertTrue(isEmpty(sort(List<Int>())), "empty")

fun [test("sorting a single element is the identity")] sortSingle(): None|TestFailure
    ret assertEqStr(_of(sort(prepend(5, List<Int>()))), "5.", "single")

fun [test("the smallest real merge: two elements out of order")] sortTwo(): None|TestFailure
    ret assertEqStr(_of(sort(prepend(2, prepend(1, List<Int>())))), "1.2.", "two")

fun [test("an all-ties list takes the equal-elements path")] sortAllEqual(): None|TestFailure
    ret assertEqStr(_of(sort(_ints4(7, 7, 7, 7))), "7.7.7.7.", "all ties")

fun [test("an already-sorted list is unchanged")] sortAlreadySorted(): None|TestFailure
    ret assertEqStr(_of(sort(_ints4(1, 2, 3, 4))), "1.2.3.4.", "sorted")

fun [test("a fully reversed list is the worst case")] sortReversed(): None|TestFailure
    ret assertEqStr(_of(sort(_ints4(4, 3, 2, 1))), "1.2.3.4.", "reversed")

fun [test("duplicates are all kept, not collapsed")] sortKeepsDuplicates(): None|TestFailure
    ret assertEqStr(_of(sort(_ints4(3, 1, 3, 1))), "1.1.3.3.", "duplicates")

fun [test("negative values order below positive ones")] sortNegatives(): None|TestFailure
    ret assertEqStr(_of(sort(_ints4(2, 0 - 5, 0, 0 - 1))), "-5.-1.0.2.", "negatives")

fun [test("strings sort lexicographically")] sortStrings(): None|TestFailure
    let l = build(push(push(push(push(builder<String>(),
        "pear"), "apple"), "fig"), "banana"))
    ret assertEqStr(_strsOf(sort(l)), "apple.banana.fig.pear.", "strings")

fun [test("sortBy orders by the supplied comparison, here descending")] sortByDescending(): None|TestFailure
    ret assertEqStr(_of(sortBy(_ints4(1, 3, 2, 4),
            (a: Int, b: Int) => a > b)), "4.3.2.1.", "descending")

fun [test("sortBy on an empty list yields an empty list")] sortByEmpty(): None|TestFailure
    ret assertTrue(isEmpty(sortBy(List<Int>(), (a: Int, b: Int) => a < b)), "empty")


# STABILITY. The key alone decides the order; the tag records where each record
# started. A stable sort leaves equal keys in their original relative order, so
# 1b must precede 1d and 2a must precede 2c. An unstable sort is free to swap
# them, which is exactly what this catches — and it cannot be caught by sorting
# plain integers, where equal elements are indistinguishable.
class [final] Rec(key: Int, tag: String)

fun _recs(): List<Rec>
    ret build(push(push(push(push(push(builder<Rec>(), Rec(2, "a")), Rec(1, "b")), Rec(2, "c")),
        Rec(1, "d")), Rec(2, "e")))

fun _recsOf(xs: List<Rec>): String
    ret fold(xs, "", (acc: String, r: Rec) => acc + String(r.key) + r.tag + ".")

fun [test("sortBy is STABLE: equal keys keep their original order")] sortByIsStable(): None|TestFailure
    ret assertEqStr(_recsOf(sortBy(_recs(), (a: Rec, b: Rec) => a.key < b.key)),
                    "1b.1d.2a.2c.2e.", "stability")
