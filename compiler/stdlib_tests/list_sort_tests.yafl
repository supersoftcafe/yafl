# Tests for sort / sortBy (stdlib/list.yafl).
# Ported from compiler/tests/test_list_sort.py, which drove one big program and
# grepped its stdout with assertIn — a SUBSTRING check, so "empty=[]" also
# matched "empty=[]anything". These assert equality instead, one behaviour per
# test, so a failure names the case rather than a line of output.
#
# See list_tests.yafl for why these live outside stdlib/.

namespace StdlibTests::ListSortTests

import System
import System::Test


fun _of(xs: List<System::Int>): System::String
    ret fold<System::Int, System::String>(xs, "",
        (acc: System::String, x: System::Int) => acc + String(x) + ".")

fun _strsOf(xs: List<System::String>): System::String
    ret fold<System::String, System::String>(xs, "",
        (acc: System::String, x: System::String) => acc + x + ".")

# Built with a ListBuilder: in-order and O(1) per push.
fun _ints4(a: System::Int, b: System::Int, c: System::Int,
           d: System::Int): List<System::Int>
    ret build<System::Int>(push<System::Int>(push<System::Int>(push<System::Int>(
        push<System::Int>(builder<System::Int>(), a), b), c), d))


fun [test("sorting an empty list yields an empty list")] sortEmpty(): System::None|TestFailure
    ret assertEqStr(_of(sort<System::Int>(List<System::Int>())), "", "empty")

fun [test("sorting a single element is the identity")] sortSingle(): System::None|TestFailure
    ret assertEqStr(_of(sort<System::Int>(prepend<System::Int>(5, List<System::Int>()))),
                    "5.", "single")

fun [test("the smallest real merge: two elements out of order")] sortTwo(): System::None|TestFailure
    ret assertEqStr(_of(sort<System::Int>(
            prepend<System::Int>(2, prepend<System::Int>(1, List<System::Int>())))),
                    "1.2.", "two")

fun [test("an all-ties list takes the equal-elements path")] sortAllEqual(): System::None|TestFailure
    ret assertEqStr(_of(sort<System::Int>(_ints4(7, 7, 7, 7))), "7.7.7.7.", "all ties")

fun [test("an already-sorted list is unchanged")] sortAlreadySorted(): System::None|TestFailure
    ret assertEqStr(_of(sort<System::Int>(_ints4(1, 2, 3, 4))), "1.2.3.4.", "sorted")

fun [test("a fully reversed list is the worst case")] sortReversed(): System::None|TestFailure
    ret assertEqStr(_of(sort<System::Int>(_ints4(4, 3, 2, 1))), "1.2.3.4.", "reversed")

fun [test("duplicates are all kept, not collapsed")] sortKeepsDuplicates(): System::None|TestFailure
    ret assertEqStr(_of(sort<System::Int>(_ints4(3, 1, 3, 1))), "1.1.3.3.", "duplicates")

fun [test("negative values order below positive ones")] sortNegatives(): System::None|TestFailure
    ret assertEqStr(_of(sort<System::Int>(_ints4(2, 0 - 5, 0, 0 - 1))),
                    "-5.-1.0.2.", "negatives")

fun [test("strings sort lexicographically")] sortStrings(): System::None|TestFailure
    let l = build<System::String>(push<System::String>(push<System::String>(
        push<System::String>(push<System::String>(builder<System::String>(),
        "pear"), "apple"), "fig"), "banana"))
    ret assertEqStr(_strsOf(sort<System::String>(l)), "apple.banana.fig.pear.",
                    "strings")

fun [test("sortBy orders by the supplied comparison, here descending")] sortByDescending(): System::None|TestFailure
    ret assertEqStr(_of(sortBy<System::Int>(_ints4(1, 3, 2, 4),
            (a: System::Int, b: System::Int) => a > b)), "4.3.2.1.", "descending")

fun [test("sortBy on an empty list yields an empty list")] sortByEmpty(): System::None|TestFailure
    ret assertEqStr(_of(sortBy<System::Int>(List<System::Int>(),
            (a: System::Int, b: System::Int) => a < b)), "", "empty")


# STABILITY. The key alone decides the order; the tag records where each record
# started. A stable sort leaves equal keys in their original relative order, so
# 1b must precede 1d and 2a must precede 2c. An unstable sort is free to swap
# them, which is exactly what this catches — and it cannot be caught by sorting
# plain integers, where equal elements are indistinguishable.
class [final] Rec(key: System::Int, tag: System::String)

fun _recs(): List<Rec>
    ret build<Rec>(push<Rec>(push<Rec>(push<Rec>(push<Rec>(push<Rec>(
        builder<Rec>(), Rec(2, "a")), Rec(1, "b")), Rec(2, "c")),
        Rec(1, "d")), Rec(2, "e")))

fun _recsOf(xs: List<Rec>): System::String
    ret fold<Rec, System::String>(xs, "",
        (acc: System::String, r: Rec) => acc + String(r.key) + r.tag + ".")

fun [test("sortBy is STABLE: equal keys keep their original order")] sortByIsStable(): System::None|TestFailure
    ret assertEqStr(_recsOf(sortBy<Rec>(_recs(),
            (a: Rec, b: Rec) => a.key < b.key)),
                    "1b.1d.2a.2c.2e.", "stability")
