# Tests for System::Containers::Array<T> (stdlib/System/Containers/array.yafl).
# Ported from compiler/tests/test_array_class.py.
#
# `Array<T>(n, initFn)` tabulates initFn over 0..n-1; `a[i]` reads element i.
# Note the WIDTHS: the length and the init function's index are Int32, while
# `[]` takes an Int at the API surface. Nothing converts between them — a
# width mismatch is the language working, not an inconvenience — so the
# literals below are spelled `5i32` and results are widened with Int(...)
# before being compared.
#
# See Containers/list_tests.yafl for why these live outside stdlib/.

namespace StdlibTests::ArrayTests

import System
import System::Containers
import System::Test


fun _squares(n: Int32): Array<Int32>
    ret Array<Int32>(n, (i: Int32) => i * i)

fun _sum(a: Array<Int32>): Int
    ret fold(a, 0, (acc: Int, x: Int32) => acc + Int(x))

fun _count(a: Array<Int32>): Int
    ret fold(a, 0, (acc: Int, x: Int32) => acc + 1)


fun [test("Array tabulates its initialiser over 0..n-1")] tabulates(): None|TestFailure
    let a = _squares(4i32)
    ret assertEqInt(Int(a[0]), 0, "0*0")
     ?? assertEqInt(Int(a[1]), 1, "1*1")
     ?? assertEqInt(Int(a[2]), 4, "2*2")
     ?? assertEqInt(Int(a[3]), 9, "3*3")

fun [test("an array of length 0 is empty")] emptyArray(): None|TestFailure
    ret assertTrue(isEmpty(Array<Int32>()), "empty constructor")
     ?? assertTrue(isEmpty(Array<Int32>(0i32, (i: Int32) => i)), "empty tabulation")
     ?? assertFalse(isEmpty(_squares(1i32)), "one element is not empty")

fun [test("fold accumulates over every element in index order")] foldsInOrder(): None|TestFailure
    ret assertEqInt(_sum(_squares(4i32)), 14, "0+1+4+9")
     ?? assertEqStr(fold(_squares(3i32), "",
            (acc: String, x: Int32) => acc + String(Int(x)) + "."), "0.1.4.",
            "index order")

fun [test("fold over an empty array returns the seed")] foldEmpty(): None|TestFailure
    ret assertEqInt(fold(Array<Int32>(0i32, (i: Int32) => i), 99,
            (acc: Int, x: Int32) => acc + Int(x)), 99, "seed kept")

fun [test("map produces a new array of the same length")] mapsSameLength(): None|TestFailure
    let m = map(_squares(4i32), (x: Int32) => x + 1i32)
    ret assertEqInt(Int(m[0]), 1, "0+1")
     ?? assertEqInt(Int(m[3]), 10, "9+1")
     ?? assertEqInt(_count(m), 4, "length kept")

fun [test("filter keeps only matching elements")] filters(): None|TestFailure
    let f = filter(_squares(5i32), (x: Int32) => x % 2i32 == 0i32)
    ret assertEqInt(_count(f), 3, "0,4,16")
     ?? assertEqInt(_sum(f), 20, "their sum")

fun [test("filter matching nothing yields an empty array")] filterNone(): None|TestFailure
    ret assertTrue(isEmpty(filter(_squares(4i32), (x: Int32) => x > 100i32)), "nothing")

fun [test("any finds a match and rejects when there is none")] anyFinds(): None|TestFailure
    ret assertTrue(any(_squares(4i32), (x: Int32) => x == 4i32), "4 is present")
     ?? assertFalse(any(_squares(4i32), (x: Int32) => x > 100i32), "none over 100")
     ?? assertFalse(any(Array<Int32>(0i32, (i: Int32) => i), (x: Int32) => true),
                    "any of empty")

fun [test("convenience constructors hold one to three values")] convenienceCtors(): None|TestFailure
    let a = arrayOf<Int32>(7i32)
    let b = arrayOf<Int32>(1i32, 2i32)
    let c = arrayOf<Int32>(1i32, 2i32, 3i32)
    ret assertEqInt(Int(a.length), 1, "one")
     ?? assertEqInt(Int(a[0]), 7, "one value")
     ?? assertEqInt(Int(b.length), 2, "two")
     ?? assertEqInt(Int(b[1]), 2, "second value")
     ?? assertEqInt(Int(c.length), 3, "three")
     ?? assertEqInt(Int(c[2]), 3, "third value")

fun [test("push builds in append order")] pushKeepsOrder(): None|TestFailure
    let a = push(push(push(Array<Int32>(), 7i32), 8i32), 9i32)
    ret assertEqInt(Int(a[0]), 7, "first")
     ?? assertEqInt(Int(a[2]), 9, "last")
     ?? assertEqInt(_count(a), 3, "three")

# Pushing past the buffer's capacity must grow rather than truncate or abort.
fun [test("push grows past the initial capacity")] pushGrows(): None|TestFailure
    let a = push(push(push(push(Array<Int32>(), 1i32), 2i32), 3i32), 4i32)
    ret assertEqInt(_count(a), 4, "all four kept")
     ?? assertEqInt(Int(a[3]), 4, "last survived the grow")

fun [test("an array of strings works the same way")] stringArray(): None|TestFailure
    let a = Array<String>(3i32, (i: Int32) => String(Int(i)))
    ret assertEqStr(a[0], "0", "first")
     ?? assertEqStr(a[2], "2", "last")

fun _upTo(n: Int32): Array<Int32>
    ret _fill(Array<Int32>(), 1i32, n)

fun [tail] _fill(a: Array<Int32>, i: Int32, n: Int32): Array<Int32>
    ret i > n ? a : _fill(push(a, i), i + 1i32, n)

fun _render(a: Array<Int32>): String
    ret fold(a, "", (acc: String, x: Int32) => acc + String(Int(x)) + ".")

# A thousand pushes cross every doubling of the buffer from empty.
fun [test("a long push chain keeps every element in order")] longPushChain(): None|TestFailure
    let a = _upTo(1000i32)
    ret assertEqInt(_count(a), 1000, "all present")
     ?? assertEqInt(_sum(a), 500500, "sum 1..1000")
     ?? assertEqInt(Int(a[999]), 1000, "last")

fun [test("pushAll appends an entire List in order")] pushAllList(): None|TestFailure
    ret assertEqStr(_render(pushAll(_upTo(2i32), List<Int32>(7i32, 8i32))), "1.2.7.8.", "appended")
     ?? assertTrue(isEmpty(pushAll(Array<Int32>(), List<Int32>())), "empty onto empty")

fun [test("pushAll appends an entire Array in order")] pushAllArray(): None|TestFailure
    ret assertEqStr(_render(pushAll(_upTo(3i32), _upTo(2i32))), "1.2.3.1.2.", "appended")
     ?? assertEqStr(_render(pushAll(Array<Int32>(), _upTo(2i32))), "1.2.", "onto empty")
     ?? assertEqStr(_render(pushAll(_upTo(2i32), Array<Int32>())), "1.2.", "nothing appended")

# Two values sharing one buffer: whichever appends second must copy, and the
# first keeps its own elements.
fun [test("appending to a shared prefix leaves the other value intact")] sharedPrefix(): None|TestFailure
    let base = _upTo(3i32)
    let x = push(base, 10i32)
    let y = push(base, 20i32)
    ret assertEqStr(_render(x), "1.2.3.10.", "first branch")
     ?? assertEqStr(_render(y), "1.2.3.20.", "second branch")
     ?? assertEqStr(_render(base), "1.2.3.", "prefix unchanged")

fun [test("arrayStream drives every element in order")] streams(): None|TestFailure
    ret assertEqInt(_drain(arrayStream(_upTo(20i32)), 0), 210, "sum 1..20 via stream")
     ?? assertEqInt(_drain(arrayStream(Array<Int32>()), 0), 0, "empty stream")

fun [tail] _drain(st: ArrayStream<Int32>, acc: Int): Int
    let r = streamNext<ArrayStream<Int32>, Int32, Never>(st)
    ret match(r.value)
        (ok: Ok<Int32 | None, Never>) => match(ok.value)
            (x: Int32) => _drain(r.stream, acc + Int(x))
            (n: None)  => acc
        (er: Error<Int32 | None, Never>) => acc
