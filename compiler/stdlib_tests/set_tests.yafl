# Tests for System::Set (stdlib/set.yafl).
# Ported from compiler/tests/test_set.py, which printed `label=value` lines and
# compared the whole stdout block against a list of eleven strings. One
# behaviour per test here.
#
# See list_tests.yafl for why these live outside stdlib/.

namespace StdlibTests::SetTests

import System
import System::Test


fun _ints3(): Set<Int>
    ret add(add(add(Set<Int>(), 1), 2), 3)


fun [test("a new set is empty and contains nothing")] emptySet(): None|TestFailure
    ret assertEqInt(size(Set<Int>()), 0, "size")
     ?? assertFalse(contains(Set<Int>(), 1), "contains nothing")
     ?? assertTrue(isEmpty(Set<Int>()), "isEmpty")

fun [test("a value is present after being added")] addThenContains(): None|TestFailure
    ret assertTrue(contains(add(Set<Int>(), 7), 7), "added value present")

fun [test("adding distinct values grows the set")] addDistinct(): None|TestFailure
    ret assertEqInt(size(_ints3()), 3, "three distinct")

# The defining property of a set, and the one a list would fail.
fun [test("adding the SAME value twice leaves the size at one")] addDuplicate(): None|TestFailure
    let s = add(add(Set<Int>(), 5), 5)
    ret assertEqInt(size(s), 1, "duplicate collapses")
     ?? assertTrue(contains(s, 5), "still present")

fun [test("a removed value is no longer present")] removePresent(): None|TestFailure
    let s = remove(add(Set<Int>(), 9), 9)
    ret assertFalse(contains(s, 9), "gone")
     ?? assertEqInt(size(s), 0, "empty again")

fun [test("removing an absent value is a no-op, not an error")] removeAbsent(): None|TestFailure
    let s = remove(add(Set<Int>(), 1), 42)
    ret assertEqInt(size(s), 1, "unchanged size")
     ?? assertTrue(contains(s, 1), "1 kept")

fun [test("removing one of several leaves the rest")] removeOneOfSeveral(): None|TestFailure
    ret assertEqInt(size(remove(_ints3(), 2)), 2, "size")
     ?? assertFalse(contains(remove(_ints3(), 2), 2), "2 gone")
     ?? assertTrue(contains(remove(_ints3(), 2), 1), "1 kept")

# Sets are VALUES: remove returns a new set and the original is untouched. This
# is the test that would catch an in-place implementation, and it is why the
# check is worth making explicitly rather than assuming purity.
fun [test("remove returns a NEW set; the original is unchanged")] removeIsPure(): None|TestFailure
    let original = _ints3()
    let reduced = remove(original, 2)
    ret assertEqInt(size(reduced), 2, "copy shrank")
     ?? assertEqInt(size(original), 3, "original unchanged")
     ?? assertTrue(contains(original, 2), "original still has 2")

fun [test("add likewise leaves the original set alone")] addIsPure(): None|TestFailure
    let original = _ints3()
    let grown = add(original, 4)
    ret assertEqInt(size(grown), 4, "copy grew")
     ?? assertEqInt(size(original), 3, "original unchanged")

fun [test("sets of strings work the same way")] stringSet(): None|TestFailure
    let s = add(add(Set<String>(), "a"), "b")
    ret assertTrue(contains(s, "a"), "a present")
     ?? assertEqInt(size(s), 2, "two distinct")
     ?? assertEqInt(size(add(s, "a")), 2, "re-adding a string does not grow it")

fun [test("a set built from a list drops the list's duplicates")] fromListDedupes(): None|TestFailure
    let withDups = build(push(push(push(builder<Int>(), 1), 2), 1))
    ret assertEqInt(size(Set<Int>(withDups)), 2, "1,2,1 -> 2")
