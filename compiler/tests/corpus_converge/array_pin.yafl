# Regression pin (2026-08-26, retargeted 2026-11-10 when Seq was removed): a
# [final] class with a trailing inline array field — Array's _ArrayBuf —
# instantiated through push, fold and the ArrayStream drive. This pins the
# emission both compilers must agree on byte-for-byte: the vtable's
# array_len_offset names the length field's MANGLED struct member (the
# divergence found 2026-08-26 — the port emitted the bare spelling), and the
# in-place append stores into a pinned buffer.
namespace ArrayPin

import System
import System::Containers

fun [tail] fill(a: Array<Int32>, n: Int32, stop: Int32): Array<Int32>
  ret n > stop ? a : fill(push<Int32>(a, n), n + 1i32, stop)

fun [tail] drain(st: ArrayStream<Int32>, acc: Int): Int
  let r = streamNext<ArrayStream<Int32>, Int32, Never>(st)
  ret match(r.value)
    (ok: Ok<Int32 | None, Never>) => match(ok.value)
      (x: Int32) => drain(r.stream, acc * 31 + Int(x))
      (n: None)  => acc
    (er: Error<Int32 | None, Never>) => acc

fun [tail] href(n: Int, stop: Int, acc: Int): Int
  ret n > stop ? acc : href(n + 1, stop, acc * 31 + n)

fun main(): System::Int
  let a = fill(Array<Int32>(), 1i32, 21i32)
  let viaFold = fold<Int32, Int>(a, 7, (acc: Int, x: Int32) => acc * 31 + Int(x))
  ret viaFold == href(1, 21, 7) && drain(arrayStream<Int32>(a), 7) == viaFold ? 0 : 1
