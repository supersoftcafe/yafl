# Converge-contract corpus: per-statement IMPORTS are BLOCK-SCOPED. Each
# namespace block's statements carry that block's ImportGroup — the block's
# self-import plus the imports written in the block — and a bare name is
# retried under exactly those scopes. `Other` reaches `Corpus::util` and
# `Corpus::Int` only through its `import Corpus`; a port that hardcodes the
# scope list, or pools imports file-wide, resolves the wrong set.
namespace Corpus

typealias Int : __builtin_type__<bigint>

fun util(x: Int): Int
  ret x

namespace Other

import Corpus

fun use(y: Int): Int
  ret util(y)
