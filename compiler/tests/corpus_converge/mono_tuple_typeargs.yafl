# Two instantiations of the same generic differing ONLY inside a TUPLE type
# argument (the accumulator pairs swap List<String>/List<Int>). The mono
# redirect must look its table up with the REWRITTEN params (children first,
# Python's rw.rewrite order) — a raw-params lookup matches the stale
# bare-spelling instantiation from an earlier round and collapses the two
# onto one symbol (48 fold instantiations became 38 on the bootstrap
# stream).
namespace Main

import System

class [final] F(v: System::Int)

fun addPairS(acc: (a: List<System::String>, b: List<System::Int>),
             f: F): (a: List<System::String>, b: List<System::Int>)
  ret (prepend("x", acc.a), acc.b)

fun addPairI(acc: (a: List<System::Int>, b: List<System::String>),
             f: F): (a: List<System::Int>, b: List<System::String>)
  ret (prepend(f.v, acc.a), acc.b)

fun main(): System::Int
  let fs = prepend(F(3), List<F>())
  let p1 = fold(fs, (List<System::String>(), List<System::Int>()), addPairS)
  let p2 = fold(fs, (List<System::Int>(), List<System::String>()), addPairI)
  ret chainLength(chain(p1.a)) + chainLength(chain(p2.a))
