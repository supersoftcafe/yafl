# Converge-contract corpus: parameter inference from the BODY (B8). `v`
# declares no type; the declared result of `bump` bounds what `ret v` may be,
# so the parameter is an Int. A port whose parameter inference never reads the
# result type leaves `v` untyped forever.
namespace Corpus

typealias Int : __builtin_type__<bigint>

fun bump(v): Int
  ret v

fun use(x: Int): Int
  ret bump(x)
