# ─── Int64 ──────────────────────────────────────────────────────────────────

instance [ambient] BasicMath<System::Int64>
  fun `+`(left: System::Int64, right: System::Int64): System::Int64
    ret __builtin_op__<int64>("int64_add", left, right)
  fun `-`(right: System::Int64): System::Int64
    ret __builtin_op__<int64>("int64_neg", right)
  fun `-`(left: System::Int64, right: System::Int64): System::Int64
    ret __builtin_op__<int64>("int64_sub", left, right)
  fun `*`(left: System::Int64, right: System::Int64): System::Int64
    ret __builtin_op__<int64>("int64_mul", left, right)
  fun `/`(left: System::Int64, right: System::Int64): System::Int64
    ret __builtin_op__<int64>("int64_div", left, right)
  fun `%`(left: System::Int64, right: System::Int64): System::Int64
    ret __builtin_op__<int64>("int64_rem", left, right)
  fun `<`(left: System::Int64, right: System::Int64): System::Bool
    ret __builtin_op__<bool>("int64_test_lt", left, right)
  fun `==`(left: System::Int64, right: System::Int64): System::Bool
    ret __builtin_op__<bool>("int64_test_eq", left, right)
  fun `>`(left: System::Int64, right: System::Int64): System::Bool
    ret __builtin_op__<bool>("int64_test_gt", left, right)
  # Truncating: the low 32 bits are the hash (deterministic; collisions on
  # the high word are the hash's job to tolerate, not avoid).
  fun hashOf(value: System::Int64): System::Int32
    ret _maskHash(truncateToInt32(value))

fun Int(value: System::Int64): System::Int
  ret __builtin_op__<bigint>("integer_from_int64", value)
fun Float(value: System::Int64): System::Float
  ret __builtin_op__<float64>("float64_from_int64", value)
fun Float32(value: System::Int64): System::Float32
  ret __builtin_op__<float32>("float32_from_int64", value)

fun truncateToInt64(value: System::Int): System::Int64
  ret __builtin_op__<int64>("int64_from_integer_truncate", value)
fun truncateToInt64(value: System::Float): System::Int64
  ret __builtin_op__<int64>("int64_from_float64", value)
fun truncateToInt64(value: System::Float32): System::Int64
  ret __builtin_op__<int64>("int64_from_float32", value)

fun String(value: System::Int64): System::String
  ret __builtin_op__<str>("string_from_int64", value)

fun _checkFitsInt64(i: System::Int): System::Int64|System::None
  let narrow: System::Int64 = truncateToInt64(i)
  ret Int(narrow) == i ? narrow : None

fun parseInt64(s: System::String): System::Int64|System::None
  ret match(parseInt(s))
    (i: System::Int)  => _checkFitsInt64(i)
    (n: System::None) => None

instance [ambient] Show<System::Int64>
  fun show(value: System::Int64): System::String
    ret String(value)


# Bitwise instances — one per integer type. `&`/`|`/`^` are operators;
# `andNot(a, b)` is `a & ~b`. Float and String implement no Bitwise instance.

instance [ambient] Bitwise<System::Int>
  fun `~`(value: System::Int): System::Int
    ret __builtin_op__<bigint>("integer_inv", value)
  fun `&`(left: System::Int, right: System::Int): System::Int
    ret __builtin_op__<bigint>("integer_and", left, right)
  fun `|`(left: System::Int, right: System::Int): System::Int
    ret __builtin_op__<bigint>("integer_or", left, right)
  fun `^`(left: System::Int, right: System::Int): System::Int
    ret __builtin_op__<bigint>("integer_xor", left, right)
  fun andNot(left: System::Int, right: System::Int): System::Int
    ret __builtin_op__<bigint>("integer_andnot", left, right)

instance [ambient] Bitwise<System::Int8>
  fun `~`(value: System::Int8): System::Int8
    ret __builtin_op__<int8>("int8_inv", value)
  fun `&`(left: System::Int8, right: System::Int8): System::Int8
    ret __builtin_op__<int8>("int8_and", left, right)
  fun `|`(left: System::Int8, right: System::Int8): System::Int8
    ret __builtin_op__<int8>("int8_or", left, right)
  fun `^`(left: System::Int8, right: System::Int8): System::Int8
