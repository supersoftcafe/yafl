namespace System

import System


# Set<T> — a collection of unique values of type T. Built on `Dict<T,()>`
# so every operation routes through the value's `BasicEquality<T>` instance
# for hashing and key comparison. Functional / persistent: each operation
# returns a new Set; the original is unchanged.

class Set<T>(_d: Dict<T,()>)


# Public factory — an empty set.
fun Set<T>(): Set<T>
  ret Set<T>(Dict<T,()>())


# From a List, dropping its order and any duplicates. This direction is free
# and needs no decision from the caller — forgetting an ordering always makes
# sense, where RECOVERING one does not, which is why the way back is `sort` and
# the caller has to say which order they mean.
fun Set<T>(l: List<T>): Set<T> where BasicEquality<T>
  ret fold<T, Set<T> >(l, Set<T>(), (s: Set<T>, x: T) => add<T>(s, x))


# Insert `value` if absent; if already present the returned set is
# observationally identical to the input. Cost is one Dict.put.
fun add<T>(s: Set<T>, value: T): Set<T> where BasicEquality<T>
  ret Set<T>(put<T,()>(s._d, value, ()))


# True iff `value` is a member of `s`. Cost is one Dict.contains.
fun contains<T>(s: Set<T>, value: T): Bool where BasicEquality<T>
  ret contains<T,()>(s._d, value)


# Drop `value` if present; if absent the result is observationally
# identical to the input. Cost is one Dict.remove.
fun remove<T>(s: Set<T>, value: T): Set<T> where BasicEquality<T>
  ret Set<T>(remove<T,()>(s._d, value))


# Number of members. Cost is whatever Dict.size costs (linear in the
# Dict structure — fine for symbol tables and seen-sets, not for hot
# loops).
fun size<T>(s: Set<T>): Int
  ret size<T,()>(s._d)


# ── questions whose answer does not depend on order ──────────────────────────
# A Set is UNORDERED and exposes no walk: no chain(), no head, no fold. These
# are the questions worth asking of one, answered without materialising an
# order that would only be a lie.

fun isEmpty<T>(s: Set<T>): Bool
  ret isEmpty<T,()>(s._d)


# The member of a one-member set, else None — for the shape where a filter is
# expected to narrow to exactly one answer.
fun singleOrNone<T>(s: Set<T>): T|None
  ret match(_dictKeyChain<T,()>(s._d))
    (l: ChainLink) => l.next is ChainEnd ? l.value : None
    (e: ChainEnd)  => None


fun isMoreThanOne<T>(s: Set<T>): Bool
  ret match(_dictKeyChain<T,()>(s._d))
    (l: ChainLink) => l.next !is ChainEnd
    (e: ChainEnd)  => false


fun any<T>(s: Set<T>, f: (:T): Bool): Bool
  ret _chainAny<T>(_dictKeyChain<T,()>(s._d), f)


fun all<T>(s: Set<T>, f: (:T): Bool): Bool
  ret !any<T>(s, (x: T) => !f(x))


# ── bulk transforms — unordered in, unordered out ────────────────────────────
# `map` may collapse two members onto one image, so the result is a Set of
# whatever survived, not a same-sized collection.

fun map<T,U>(s: Set<T>, f: (:T): U): Set<U> where BasicEquality<U>
  ret _chainToSet<U>(_chainMapRev<T,U>(_dictKeyChain<T,()>(s._d), f, ChainEnd<U>()),
                     Set<U>())


fun filter<T>(s: Set<T>, f: (:T): Bool): Set<T> where BasicEquality<T>
  ret _chainToSet<T>(_chainFilterRev<T>(_dictKeyChain<T,()>(s._d), f, ChainEnd<T>()),
                     Set<T>())


# Every member of both. Done the SLOW way for now — one insert per member of
# `b` — which is the standing position on merging two containers.
fun union<T>(a: Set<T>, b: Set<T>): Set<T> where BasicEquality<T>
  ret _chainToSet<T>(_dictKeyChain<T,()>(b._d), a)


# ── the one way out ──────────────────────────────────────────────────────────
# sort names an ordering, so it alone may hand back a List.

fun sort<T>(s: Set<T>): List<T> where BasicCompare<T>
  ret sort<T>(_setDrain<T>(s))

# The same, for element types with no natural order: `less` must be a STRICT
# ordering, true iff its first argument precedes its second. This is the only
# way a Set becomes a sequence, and naming the ordering is what makes that
# legitimate.
fun sortBy<T>(s: Set<T>, less: (:T, :T): Bool): List<T>
  ret sortBy<T>(_setDrain<T>(s), less)

# Private: members as a List in unspecified order. NOT public — handing this
# out would be iteration on an unordered container by another name.
fun _setDrain<T>(s: Set<T>): List<T>
  ret build<T>(_pushChain<T>(builder<T>(), _dictKeyChain<T,()>(s._d)))


# fold — a REDUCTION, not a walk. `f` must be COMMUTATIVE and ASSOCIATIVE in
# the elements: the container has no order, so the sequence in which they reach
# `f` is unspecified, and a fold that cares would silently depend on the
# container's internal shape. That is the one thing this design exists to stop.
#
# Legitimate: union, intersection, sum, max, "any error seen", counting.
# NOT legitimate: string concatenation, building a list, first-wins lookup,
# anything whose result differs when two elements swap places.
#
# It is offered because the alternative is worse: without it, callers reach for
# sort() purely to get a walk, imposing an ordering they do not need and paying
# O(n log n) to do it. Nothing enforces commutativity — this comment is the
# contract.
fun fold<T,U>(s: Set<T>, init: U, f: (:U, :T): U): U
  ret _chainFold<T,U>(_dictKeyChain<T,()>(s._d), init, f)

fun [tail] _chainFold<T,U>(c: Chain<T>, acc: U, f: (:U, :T): U): U
  ret match(c)
    (l: ChainLink) => _chainFold<T,U>(l.next, f(acc, l.value), f)
    (e: ChainEnd)  => acc
