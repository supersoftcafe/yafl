namespace System
import System


# Fixed-size array with O(1) indexed access — a sibling to the persistent
# List<T>. Where a List is a chain of cons nodes, an Array<T> is a single heap
# object storing its `length` elements inline. Build it once from an init
# function — `Array<T>(n, (i) => ...)` — then read by index with `a[i]`.
class [final] Array<T>(length: Int32, array: T[length])


# Indexed read: `a[i]` lowers to ``[]``(a, i). Aborts if `i` is out of range
# (0 <= i < length). The index is Int at the API surface — `a[0]` works
# because 0 IS an Int (literals are their spelling; nothing converts) — and
# is truncated internally, where the runtime bounds check catches any value
# an Int32 could not have addressed anyway.
fun `[]`<T>(a: Array<T>, i: Int): T
  ret a.array(truncateToInt32(i))

# Int32 form for byte-scanning code that already holds a sized index.
fun `[]`<T>(a: Array<T>, i: Int32): T
  ret a.array(i)


# ── combinators ──────────────────────────────────────────────────────────────
# The List combinators' Array overloads: same names, resolved by argument
# type, so a container migration is a type change at the call site.

fun isEmpty<T>(a: Array<T>): Bool
  ret a.length == 0i32

# In-order left fold over the elements.
fun fold<T, TAcc>(a: Array<T>, acc: TAcc, f: (acc: TAcc, x: T): TAcc): TAcc
  ret _foldFrom<T, TAcc>(a, 0i32, acc, f)

fun [tail] _foldFrom<T, TAcc>(a: Array<T>, i: Int32, acc: TAcc,
                              f: (acc: TAcc, x: T): TAcc): TAcc
  ret i < a.length ? _foldFrom<T, TAcc>(a, i + 1i32, f(acc, a[i]), f) : acc

# Element-wise transform; the result size is known exactly, so this is the
# tabulating ctor, not a builder.
fun map<T, TOut>(a: Array<T>, f: (x: T): TOut): Array<TOut>
  ret Array<TOut>(a.length, (i: Int32) => f(a[i]))

fun filter<T>(a: Array<T>, pred: (:T): Bool): Array<T>
  ret build<T>(_filterFrom<T>(a, 0i32, pred, arrayBuilder<T>(Int(a.length))))

fun [tail] _filterFrom<T>(a: Array<T>, i: Int32, pred: (:T): Bool,
                          [terminal] b: ArrayBuilder<T>): ArrayBuilder<T>
  ret i < a.length
    ? _filterFrom<T>(a, i + 1i32, pred, pred(a[i]) ? push<T>(b, a[i]) : b)
    : b

fun any<T>(a: Array<T>, pred: (:T): Bool): Bool
  ret _anyFrom<T>(a, 0i32, pred)

# Chain-into-builder push, the ListBuilder helper's Array overload.
fun [tail] _pushChain<T>([terminal] b: ArrayBuilder<T>, c: Chain<T>): ArrayBuilder<T>
  ret match(c)
    (nil: ChainEnd) => b
    (l: ChainLink)  => _pushChain<T>(push<T>(b, l.value), l.next)

fun [tail] _anyFrom<T>(a: Array<T>, i: Int32, pred: (:T): Bool): Bool
  ret i < a.length && (pred(a[i]) || _anyFrom<T>(a, i + 1i32, pred))


# ── ArrayBuilder ─────────────────────────────────────────────────────────────
# Linear incremental construction: allocate at an ESTIMATED capacity, push
# elements, and build() publishes by SHORTENING length from capacity to the
# filled count.
#
# The array is PINNED from allocation to seal (array_builder_pin/seal): a
# fill may suspend — an async producer parks in a heap frame — so the
# half-built array crosses safe points, and pinned it never moves: every
# push is an ordinary store at a stable address, and no reader anywhere
# pays a forwarding resolve (the once.c locking bracket is Memoize's price,
# not construction's).
#
# The length field starts AT CAPACITY and never understates the traceable
# extent: the scanner walks every slot from birth (the payload is
# zero-filled, so unwritten slots trace as NULLs), each pushed element is
# traceable the moment it lands, and the sealing write trims only
# never-written zeros while telling readers the true count.
#
# Linearity certifies the single-writer confinement (every operation consumes
# the builder), and _ok threads the runtime results so no pass can discard
# the calls — both exactly as ListBuilder.
class [linear,final] ArrayBuilder<T>(_arr: Array<T>, _at: Int32, _cap: Int32,
                                     _ok: Bool)

fun arrayBuilder<T>(estimate: Int): ArrayBuilder<T>
  let cap = truncateToInt32(estimate < 1 ? 1 : estimate)
  let arr = __builtin_op__<Array<T> >("array_builder_alloc", cap)
  ret ArrayBuilder<T>(arr, 0i32, cap,
                      __builtin_op__<bool>("array_builder_pin", arr))

fun push<T>([terminal] b: ArrayBuilder<T>, x: T): ArrayBuilder<T>
  ret b._at < b._cap
    ? ArrayBuilder<T>(b._arr, b._at + 1i32, b._cap,
                      b._ok && __builtin_op__<bool>("array_builder_store",
                                                    b._arr, b._at, x))
    : _pushGrown<T>(b, x)

# Capacity exhausted: a fresh run at double, elements copied across, the old
# run sealed empty — releasing its pin — and abandoned (it was never
# published — builder-owned only — so it dies as ordinary garbage). The
# estimate parameter exists to make this path rare.
fun _pushGrown<T>([terminal] b: ArrayBuilder<T>, x: T): ArrayBuilder<T>
  let cap2 = b._cap + b._cap
  let arr2 = __builtin_op__<Array<T> >("array_builder_alloc", cap2)
  let ok2 = b._ok && __builtin_op__<bool>("array_builder_pin", arr2)
  let ok3 = ok2 && _copyInto<T>(b._arr, arr2, 0i32, b._at)
  let ok4 = ok3 && __builtin_op__<bool>("array_builder_seal", b._arr, 0i32)
  ret push<T>(ArrayBuilder<T>(arr2, b._at, cap2, ok4), x)

fun [tail] _copyInto<T>(src: Array<T>, dst: Array<T>, i: Int32, n: Int32): Bool
  ret i < n
    ? (__builtin_op__<bool>("array_builder_store", dst, i, src[i])
        ? _copyInto<T>(src, dst, i + 1i32, n)
        : false)
    : true

# Publish: shorten length to the filled count and unpin. The array is
# immutable — and compactable — from here on.
fun build<T>([terminal] b: ArrayBuilder<T>): Array<T>
  ret b._ok && __builtin_op__<bool>("array_builder_seal", b._arr, b._at)
    ? b._arr
    : b._arr   # unreachable: seal always succeeds; keeps the call live

# The failure-path counterpart of build (ListBuilder's discard precedent):
# seal empty — releasing the run's pin — so run and referents die as
# ordinary garbage at the next cycle.
fun discard<T>([terminal] b: ArrayBuilder<T>): None
  ret _sealDiscarded(b._ok && __builtin_op__<bool>("array_builder_seal",
                                                   b._arr, 0i32))

fun _sealDiscarded(_ok: Bool): None
  ret None

# Drop: an ABANDONED builder — a failed parse alternative, an early exit —
# must still release its pinned run (a leaked pin is a permanently unmovable
# object). [ambient]: the drops pass inserts plain `drop(x)` calls that must
# resolve in concrete user code without a spelled `where`.
instance [ambient]<T> Drop<ArrayBuilder<T>>
  fun drop(self: ArrayBuilder<T>): None
    ret discard<T>(self)
