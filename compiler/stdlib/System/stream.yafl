namespace System

# Pure, lazy stream transducers built on generic trait instances.
#
# A Stream is just a state value `S` plus a `next` function: given the current
# state it hands back the next state and one element. It's pull-based and lazy —
# you generate items one at a time, on demand. The element is a `Result<T|None, E>`:
#   * Ok(value: T)  — a value,
#   * Ok(None)      — a clean end of stream,
#   * Error(e: E)   — a failure (also terminal).
# Two orthogonal axes. The Ok/Error axis is error handling, identical to a
# Result-returning bind chain: an Error is forwarded by every transformer without
# being interpreted (a `map` over Strings can't make sense of an IO error, it
# just passes it on) and ends the stream. The inner `T | None` axis is the stream
# protocol every stage shares: `None` means "I'm done", and a stage may ORIGINATE
# it — a filter hunting for a sentinel line can emit `Ok(None)` and stop the whole
# pipeline even though the source still had input. So the stream system is not
# tied to IO: `E` is a parameter (`IOError`, `ParseError`, …), and a source that
# cannot fail uses `E = Never`, whose emptiness makes `Error` unconstructable.
#
# Each combinator (`Map`, `Filter`) is a dedicated generic type that wraps its
# source and is itself a Stream, conditional on the source being one — so a
# pipeline is a single static type like `Map<Filter<Src>>` whose `next` chain is
# monomorphic (and, in time, fusible). No allocation-per-element beyond the
# immutable state structs; no memoisation (that belongs only at an IO leaf — see
# System::IO). `Ok(None)` and `Error` pass straight through Map/Filter.
#
# A concrete source supplies the leaf instance, e.g.
#   class [final] Count(cur: Int, hi: Int)
#   class _SC() : Stream<Count, Int, Never>
#     fun next(self: Count): (stream: Count, value: Result<Int|None, Never>) ...
#   let [trait] _sc: _SC = _SC()
# The `[trait]` let registers the instance; there is deliberately NO
# `typealias [where]`, so `Stream<S,T,E>` is never ambiently in scope — a
# function that drives a stream must declare `where Stream<S,T,E>` explicitly.

# Success-or-failure, the standard two-variant result. (General enough to deserve
# a home outside the stream module eventually, alongside Never.)
enum Result<T, E>
  enum Ok(value: T)
  enum Error(error: E)

# The uninhabited type: no values, so `Error<_, Never>` cannot be constructed — a
# `Stream<S,T,Never>` cannot fail, and the type says so.
enum Never

interface Stream<S, T, E>
  fun next(self: S): (stream: S, value: Result<T | System::None, E>)

# Advance any constrained stream by one step. Use this rather than calling `next`
# directly from inside a combinator's own `next` method: a same-named member call
# there binds to the enclosing method, not the trait method, so the free helper
# is the reliable dispatch. Consumers may use it too.
fun [inline(always)] streamNext<S, T, E>(s: S): (stream: S, value: Result<T | System::None, E>) where Stream<S, T, E>
  ret next(s)


# ── sources: an Array or a Chain as a stream ─────────────────────────────────
# The by-value states are pool structs — (array, index) and (chain) — stepped
# in registers; with [inline(always)] a drive loop over one of these compiles
# to the indexed walk / chain match it replaces. E = Never: in-memory sources
# cannot fail, and Never's emptiness makes the Error arm unconstructable.

class [final] ArrayStream<T>(asArr: System::Array<T>, asAt: System::Int32)

fun arrayStream<T>(a: System::Array<T>): ArrayStream<T>
  ret ArrayStream<T>(a, 0i32)

instance<T> Stream<ArrayStream<T>, T, Never>
  fun [inline(always)] next(self: ArrayStream<T>): (stream: ArrayStream<T>, value: Result<T | System::None, Never>)
    ret self.asAt < self.asArr.length
      ? (ArrayStream<T>(self.asArr, self.asAt + 1i32),
         Ok<T | System::None, Never>(self.asArr[self.asAt]))
      : (self, Ok<T | System::None, Never>(None))

class [final] ChainStream<T>(csChain: System::Chain<T>)

fun chainStream<T>(c: System::Chain<T>): ChainStream<T>
  ret ChainStream<T>(c)

instance<T> Stream<ChainStream<T>, T, Never>
  fun [inline(always)] next(self: ChainStream<T>): (stream: ChainStream<T>, value: Result<T | System::None, Never>)
    ret match(self.csChain)
      (nil: System::ChainEnd) => (self, Ok<T | System::None, Never>(None))
      (l: System::ChainLink)  => (ChainStream<T>(l.next),
                                  Ok<T | System::None, Never>(l.value))


# ── map: apply `f` to every value; Ok(None) and Error pass through ───────────
class [final] Map<S, A, B, E>(inner: S, f: (A): B) where Stream<S, A, E>

instance<S, A, B, E> Stream<Map<S, A, B, E>, B, E> where Stream<S, A, E>
  fun [inline(always)] next(self: Map<S, A, B, E>): (stream: Map<S, A, B, E>, value: Result<B | System::None, E>)
    let r = streamNext<S, A, E>(self.inner)
    ret match(r.value)
      (ok: Ok<A | System::None, E>) => match(ok.value)
        (v: A)            => (Map<S, A, B, E>(r.stream, self.f), Ok<B | System::None, E>(self.f(v)))
        (n: System::None) => (Map<S, A, B, E>(r.stream, self.f), Ok<B | System::None, E>(None))
      (er: Error<A | System::None, E>) => (Map<S, A, B, E>(r.stream, self.f), Error<B | System::None, E>(er.error))

# NB no free `map(source, f)` constructor: a type param appearing only in the
# function value (`B`) can't be inferred from the arguments yet, so it would need
# explicit `<S,A,B>` — no better than `Map<S,A,B>(source, f)` — and a free `map`
# would also overload-clash with `System::map` over List. Construct `Map`
# directly for now.


# ── filter: keep only values satisfying `keep`; Ok(None)/Error pass through ───
class [final] Filter<S, T, E>(inner: S, keep: (T): System::Bool) where Stream<S, T, E>

instance<S, T, E> Stream<Filter<S, T, E>, T, E> where Stream<S, T, E>
  fun [inline(always)] next(self: Filter<S, T, E>): (stream: Filter<S, T, E>, value: Result<T | System::None, E>)
    ret _filterAdvance<S, T, E>(self.inner, self.keep)

# The skip-loop is a free [tail] helper: it recurses past rejected values, and
# being free (not the combinator's `next` member) it can dispatch the inner pull
# and call itself without member shadowing. Ok(None) and Error stop the skip and
# are forwarded unchanged.
fun [tail,inline(always)] _filterAdvance<S, T, E>(inner: S, keep: (T): System::Bool): (stream: Filter<S, T, E>, value: Result<T | System::None, E>) where Stream<S, T, E>
  let r = streamNext<S, T, E>(inner)
  ret match(r.value)
    (ok: Ok<T | System::None, E>) => match(ok.value)
      (v: T) => keep(v)
        ? (Filter<S, T, E>(r.stream, keep), Ok<T | System::None, E>(v))
        : _filterAdvance<S, T, E>(r.stream, keep)
      (n: System::None) => (Filter<S, T, E>(r.stream, keep), Ok<T | System::None, E>(None))
    (er: Error<T | System::None, E>) => (Filter<S, T, E>(r.stream, keep), Error<T | System::None, E>(er.error))

# No free `filter(source, keep)` for the same reasons as `map` above (it would
# clash with `System::filter` over List). Construct `Filter` directly.


# ── toLines: split a String stream into lines ────────────────────────────────
#
# A stateful, many-to-many transducer over ANY `Stream<S, String, E>` (not just
# IO): it buffers a partial line in `pending` and assembles lines across input
# chunks. The trailing '\n' (and any preceding '\r') is removed; a final
# unterminated line is emitted at end of stream. `toLines(source)` infers S from
# the argument — `Lines<S, E>` carries only S, so no explicit type args are needed.
# `pending[pos..]` is the unconsumed carry: lines advance the INDEX (slicing
# the carry per line recopies up to a whole chunk per line); the consumed
# prefix compacts away once per refill.
class [final] Lines<S, E>(inner: S, pending: System::String, pos: System::Int) where Stream<S, System::String, E>

instance<S, E> Stream<Lines<S, E>, System::String, E> where Stream<S, System::String, E>
  fun [inline(always)] next(self: Lines<S, E>): (stream: Lines<S, E>, value: Result<System::String|System::None, E>)
    ret _linesStep<S, E>(self.inner, self.pending, self.pos)

# Emit a buffered line if one is complete, otherwise pull a chunk and retry. A
# single self-`[tail]` loop (the `if` early-returns the emit case, the recursion
# is a direct self-call), so it lowers to a loop and is inlinable into callers.
fun [tail,inline(always)] _linesStep<S, E>(inner: S, pending: System::String, pos: System::Int): (stream: Lines<S, E>, value: Result<System::String|System::None, E>) where Stream<S, System::String, E>
  let nl = System::findByte(pending, '\n', pos)
  if nl >= 0
    ret _linesEmit<S, E>(inner, pending, pos, nl)
  let r = streamNext<S, System::String, E>(inner)
  ret match(r.value)
    (ok: Ok<System::String|System::None, E>) => match(ok.value)
      (chunk: System::String) => _linesStep<S, E>(r.stream, (pos == 0 ? pending : System::slice(pending, pos, System::length(pending))) + chunk, 0)
      (n: System::None)       => _linesEOF<S, E>(r.stream, pending, pos)
    (er: Error<System::String|System::None, E>) => (Lines<S, E>(r.stream, "", 0), Error<System::String|System::None, E>(er.error))

fun [inline(always)] _linesEmit<S, E>(inner: S, pending: System::String, pos: System::Int, nl: System::Int): (stream: Lines<S, E>, value: Result<System::String|System::None, E>) where Stream<S, System::String, E>
  let line = _stripCR(System::slice(pending, pos, nl))
  ret (Lines<S, E>(inner, pending, nl + 1), Ok<System::String|System::None, E>(line))

fun [inline(always)] _linesEOF<S, E>(inner: S, pending: System::String, pos: System::Int): (stream: Lines<S, E>, value: Result<System::String|System::None, E>) where Stream<S, System::String, E>
  ret System::length(pending) == pos
    ? (Lines<S, E>(inner, "", 0), Ok<System::String|System::None, E>(None))
    : (Lines<S, E>(inner, "", 0), Ok<System::String|System::None, E>(_stripCR(System::slice(pending, pos, System::length(pending)))))

fun _stripCR(s: System::String): System::String
  let n = System::length(s)
  ret n > 0 && System::byteAt(s, n - 1) == '\r' ? System::slice(s, 0, n - 1) : s

# `source |> toLines` over any String stream. S is inferred from the argument.
fun toLines<S, E>(source: S): Lines<S, E> where Stream<S, System::String, E>
  ret Lines<S, E>(source, "", 0)


# ── prependLineNumbers: prefix each line with its 1-based number ─────────────
#
# A stateful 1:1 transducer over any `Stream<S, String, E>`: each value becomes
# "N: <value>\n" with N counting from 1. Errors and end pass through.
class [final] Numbered<S, E>(inner: S, n: System::Int) where Stream<S, System::String, E>

instance<S, E> Stream<Numbered<S, E>, System::String, E> where Stream<S, System::String, E>
  fun [inline(always)] next(self: Numbered<S, E>): (stream: Numbered<S, E>, value: Result<System::String|System::None, E>)
    let r = streamNext<S, System::String, E>(self.inner)
    ret match(r.value)
      (ok: Ok<System::String|System::None, E>) => match(ok.value)
        (line: System::String) => (Numbered<S, E>(r.stream, self.n + 1), Ok<System::String|System::None, E>(_numberLine(self.n, line)))
        (no: System::None)     => (Numbered<S, E>(r.stream, self.n), Ok<System::String|System::None, E>(None))
      (er: Error<System::String|System::None, E>) => (Numbered<S, E>(r.stream, self.n), Error<System::String|System::None, E>(er.error))

# "N: <line>\n". The number is anchored to a String-typed let first so the `+`
# overloads resolve unambiguously (see the same idiom in format.yafl).
fun _numberLine(n: System::Int, line: System::String): System::String
  let num: System::String = System::String(n)
  ret num + ": " + line + "\n"

# `source |> prependLineNumbers` over any String stream. S inferred from the arg.
fun prependLineNumbers<S, E>(source: S): Numbered<S, E> where Stream<S, System::String, E>
  ret Numbered<S, E>(source, 1)


# ── once: a one-shot source — yields a single value, then ends ───────────────
# The error type is `Never`, honestly: this source cannot fail. Downstream
# unions carry the uninhabited member (`Never | JsonParseError`), which costs
# consumers nothing — exhaustiveness counts inhabited members only, so no arm
# is ever owed for it — and the type says exactly what can happen.
class [final] Once<T>(value: T, done: System::Bool)

instance<T> Stream<Once<T>, T, System::Never>
  fun next(self: Once<T>): (stream: Once<T>, value: Result<T | System::None, System::Never>)
    ret self.done
      ? (self, Ok<T | System::None, System::Never>(None))
      : (Once<T>(self.value, true), Ok<T | System::None, System::Never>(self.value))
fun once<T>(value: T): Once<T>
  ret Once<T>(value, false)


# ── collect: drain a String stream into one String ───────────────────────────
# Builds through a linear StringBuilder (cost linear in total size), threaded
# through the [tail] loop. An error consumes the builder — the partial output
# is meaningless — and surfaces as the stream's own `E`.
fun collect<S, E>(s: S): System::String | E where Stream<S, System::String, E>
  ret _collectInto<S, E>(s, System::StringBuilder())

fun _discardBuilder<E>(sb: System::StringBuilder, e: E): E
  System::discard(sb)
  ret e

fun [tail] _collectInto<S, E>(s: S, sb: System::StringBuilder): System::String | E where Stream<S, System::String, E>
  let r = streamNext<S, System::String, E>(s)
  ret match(r.value)
    (ok: Ok<System::String | System::None, E>) => match(ok.value)
      (chunk: System::String) => _collectInto<S, E>(r.stream, System::append(sb, chunk))
      (n: System::None)       => System::toString(sb)
    (er: Error<System::String | System::None, E>) => _discardBuilder<E>(sb, er.error)
