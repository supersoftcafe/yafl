namespace System


# The value of a hexadecimal digit byte: 0-9, a-f or A-F. None for any other
# byte.
fun hexValue(b: System::Int32): System::Int32|System::None
  ret b >= '0' && b <= '9' ? b - '0'
    : b >= 'a' && b <= 'f' ? b - 'a' + 10i32
    : b >= 'A' && b <= 'F' ? b - 'A' + 10i32
    : None

# The digit for a value from 0 to 15, as a one-byte string, with its letters
# upper case when `upper` is set. None for any other value.
fun hexDigit(n: System::Int32, upper: System::Bool): System::String|System::None
  ret n < 0i32 || n > 15i32 ? None
    : asciiToString(n < 10i32 ? '0' + n : (upper ? 'A' : 'a') + n - 10i32)

# The low eight bits of `b` as two hex digits.
fun hexByte(b: System::Int32, upper: System::Bool): System::String
  let low: System::Int32 = b & 255i32
  ret (hexDigit(low / 16i32, upper) ?? "") + (hexDigit(low % 16i32, upper) ?? "")
