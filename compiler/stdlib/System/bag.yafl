namespace System

import System


# Bag<T> — an UNORDERED collection that may hold duplicates.
#
# The shape is the banker's pair (`_front`, `_rear`) with the reversal
# DELETED. That reversal only ever existed to restore ORDER when draining the
# rear of an ordered list; a Bag has no order to restore, so both chains are
# walked as they lie and nothing is ever reversed. Two chains rather than one
# because a List is then convertible in O(1) — its front becomes the front,
# its rear the rear — and because a cheap merge has somewhere to land when we
# come to it.
#
# NO ITERATION. A Bag has no order, so it exposes none: there is no chain(),
# no head, no fold. Exposing the order the elements happen to lay in would be
# a lie callers would come to depend on. What a Bag offers is bulk transforms
# whose result is also unordered (map, filter), questions whose answer does
# not depend on order (isEmpty, any, all, singleOrNone, isMoreThanOne), and
# ONE way out: sort, which names an ordering and hands back a List.
#
# No `size` either, by the same rule that killed list length: ask the question
# you actually have (isEmpty / singleOrNone / isMoreThanOne) instead of
# counting to answer it.
class Bag<T>(_front: _BagNode<T>|None)
class _BagNode<T>(_next: _BagNode<T>|None, _value: T)

# Create an empty bag
fun Bag<T>() => Bag<T>(None)

# From a List, forgetting its order but keeping its duplicates
fun Bag<T>(l: List<T>): Bag<T>
  ret fold<T, Bag<T>>(l, Bag<T>(), (bag, value) => add<T>(bag, value))

# Add an element. O(1). Duplicates allowed
fun add<T>(bag: Bag<T>, value: T) => Bag<T>(_BagNode<T>(bag._front, value))

# Is this bag empty
fun isEmpty<T>(bag: Bag<T>) => bag._front is None

# How many elements. O(n)
fun count<T>(bag: Bag<T>): Int
  fun [tail] chainCount(node: _BagNode<T>|None, acc: Int): Int
    ret match(node)
      (n: _BagNode<T>) => chainCount(n._next, acc + 1)
      () => acc
  ret chainCount(bag._front, 0)

# The element of a one-element bag, else None
fun singleOrNone<T>(bag: Bag<T>): T|None
  ret match (bag._front)
    (node: _BagNode<T>) => node._next is None ? node._value : None
    () => None

# 2 or more elements?
fun isMoreThanOne<T>(bag: Bag<T>): Bool
  ret match (bag._front)
    (node: _BagNode<T>) => node._next !is None
    () => false

# Map to transform bag values into another bag
fun map<T,U>(bag: Bag<T>, f: (:T):U): Bag<U>
  fun [tail] mapNode(node: _BagNode<T>|None, next: _BagNode<U>|None): _BagNode<U>|None
    ret match(node)
      (n: _BagNode<T>) => mapNode(n._next, _BagNode<U>(next, f(n._value)))
      () => next
  ret Bag<U>(mapNode(bag._front, None))

# Filter bag values to only retain matching values into another bag
fun filter<T>(bag: Bag<T>, predicate: (:T):Bool): Bag<T>
  fun [tail] filterNode(node: _BagNode<T>|None, next: _BagNode<T>|None): _BagNode<T>|None
    ret match(node)
      (n: _BagNode<T>) => filterNode(n._next, predicate(n._value) ? _BagNode<T>(next, n._value) : next)
      () => next
  ret Bag<T>(filterNode(bag._front, None))

# Does at least one element match the predicate
fun any<T>(bag: Bag<T>, predicate: (:T):Bool): Bool
  fun [tail] anyNode(node: _BagNode<T>|None): Bool
    ret match(node)
      (n: _BagNode<T>) => predicate(n._value) || anyNode(n._next)
      () => false
  ret anyNode(bag._front)

# Do all elements match the predicate
fun all<T>(bag: Bag<T>, predicate: (:T): Bool): Bool
  fun [tail] allNode(node: _BagNode<T>|None): Bool
    ret match(node)
      (n: _BagNode<T>) => predicate(n._value) && allNode(n._next)
      () => true
  ret allNode(bag._front)

# Does the bag contain the given element
fun contains<T>(bag: Bag<T>, element: T): Bool where BasicEquality<T>
  ret any<T>(bag, (value: T) => value == element)

# Largest element, or `otherwise` when empty
fun maxOr<T>(bag: Bag<T>, otherwise: T): T where BasicCompare<T>
  ret fold<T, T>(bag, otherwise, (acc, val) => val > acc ? val : acc)

# The same, for element types with no natural order.
fun sortBy<T>(bag: Bag<T>, less: (:T, :T): Bool): List<T>
  fun [tail] nodeToList(node: _BagNode<T>|None, [terminal] acc: ListBuilder<T>): List<T>
    ret match(node)
      (n: _BagNode<T>) => nodeToList(n._next, push(acc, n._value))
      () => build(acc)
  ret sortBy<T>(nodeToList(bag._front, builder<T>()), less)

# Natural sort that returns a list
fun sort<T>(bag: Bag<T>): List<T> where BasicCompare<T>
  ret sortBy<T>(bag, (a: T, b: T) => a < b)

# fold — a REDUCTION, not a walk. `op` must be COMMUTATIVE and ASSOCIATIVE in
# the elements: the container has no order, so the sequence in which they reach
# `op` is unspecified, and a fold that cares would be non-deterministic.
#
# Legitimate: union, intersection, sum, max, "any error seen", counting.
# NOT legitimate: string concatenation, building a list, first-wins lookup,
# anything whose result differs when two elements swap places.
fun fold<T, [linear] U>(bag: Bag<T>, init: U, op: (:U, :T): U): U
  fun [tail] reduceNode(node: _BagNode<T>|None, acc: U): U
    ret match(node)
      (n: _BagNode<T>) => reduceNode(n._next, op(acc, n._value))
      () => acc
  ret reduceNode(bag._front, init)
