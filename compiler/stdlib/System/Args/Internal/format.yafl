# System::Args::Internal — the text of a command line: its usage, its help,
# and a failed parse, as Python 3.14's argparse formats them — the same
# wrapping at the same width, the same colours.
#
# The caller says how wide the terminal is and whether to colour; nothing here
# reads the environment.

namespace System::Args::Internal

import System
import System::Args
import System::Containers


# ── the formatter's settings ─────────────────────────────────────────────────

# `fmWidth`: the columns to wrap within — argparse keeps two clear of the
# terminal's edge.
class [final] Format(fmProg: String, fmWidth: Int, fmTheme: Theme)

fun formatFor(prog: String, width: Int, colour: Bool): Format =>
  Format(prog, width - 2, colour ? colourTheme() : plainTheme())

# argparse's colour theme (_colorize.Argparse), or every field "" for none.
class [final] Theme(thUsage: String, thProg: String, thHeading: String,
                    thSumLong: String, thSumShort: String, thSumLabel: String,
                    thSumAction: String, thLong: String, thShort: String,
                    thLabel: String, thAction: String, thError: String,
                    thMessage: String, thReset: String)

fun plainTheme(): Theme => Theme("", "", "", "", "", "", "", "", "", "", "", "", "", "")

fun colourTheme(): Theme => Theme(
  "\u{1B}[1;34m",   # usage:   bold blue
  "\u{1B}[1;35m",   # prog:    bold magenta
  "\u{1B}[1;34m",   # heading: bold blue
  "\u{1B}[36m",     # summary long option:  cyan
  "\u{1B}[32m",     # summary short option: green
  "\u{1B}[33m",     # summary label:        yellow
  "\u{1B}[32m",     # summary action:       green
  "\u{1B}[1;36m",   # long option:  bold cyan
  "\u{1B}[1;32m",   # short option: bold green
  "\u{1B}[1;33m",   # label:        bold yellow
  "\u{1B}[1;32m",   # action:       bold green
  "\u{1B}[1;35m",   # error:   bold magenta
  "\u{1B}[35m",     # message: magenta
  "\u{1B}[0m")      # reset


# ── the arguments, as shown ──────────────────────────────────────────────────
# A piece of text both bare (for measuring) and as shown (with colour).

class [final] Shown(swPlain: String, swText: String)

fun shown(plain: String, colour: String, t: Theme): Shown => Shown(plain, colour + plain + t.thReset)

fun joinShown(a: Shown, sep: String, b: Shown): Shown => Shown(a.swPlain + sep + b.swPlain,
                                                               a.swText + sep + b.swText)

# An option string is long when it is more than a dash and a letter.
fun isLong(o: String): Bool => length(o) > 2

# An option as the usage shows it, by its first name: `[-O LEVEL]`, `[--profile]`.
fun usageOption(t: Theme, d: Decl): Shown
  let o = head(d.dNames) ?? ""
  let colour = isLong(o) ? t.thSumLong : t.thSumShort
  ret match(d.dMetavar)
    (label: String) => Shown("[" + o + " " + label + "]",
                             "[" + colour + o + " " + t.thSumLabel + label + t.thReset + "]")
    ()              => Shown("[" + o + "]", "[" + colour + o + t.thReset + "]")

# A positional as the usage shows it, by the words it takes: `file`, `[file]`,
# `files [files ...]`, `[files ...]`.
fun usagePositional(t: Theme, name: String, c: Count): Shown =>
  shown(countedName(name, c), t.thSumAction, t)

fun countedName(name: String, c: Count): String => match(c)
  (o: ExactlyOne) => name
  (o: AtMostOne)  => "[" + name + "]"
  (o: AtLeastOne) => name + " [" + name + " ...]"
  (o: AnyNumber)  => "[" + name + " ...]"

fun usageOptionals(t: Theme, ds: List<Decl>): List<Shown> =>
  map(filter(ds, (d: Decl) => !isPositional(d)), (d: Decl) => usageOption(t, d))

fun usagePositionals(t: Theme, ds: List<Decl>): List<Shown> =>
  flatMap(ds, (d: Decl) => usagePositionalOf(t, d))

fun usagePositionalOf(t: Theme, d: Decl): List<Shown> => match(d.dCount)
  (c: Count) => List(usagePositional(t, displayName(d), c))
  ()         => List()

# An argument as the help lists it: `-L, --lib-path DIR`, with its help text.
class [final] HelpEntry(heInvocation: Shown, heHelp: String)

fun optionString(t: Theme, o: String): Shown => shown(o, isLong(o) ? t.thLong : t.thShort, t)

fun helpOption(t: Theme, d: Decl): HelpEntry
  let names = map(d.dNames, (o: String) => optionString(t, o))
  let all = fold(dropOne(names), head(names) ?? Shown("", ""),
                 (acc, n) => joinShown(acc, ", ", n))
  ret match(d.dMetavar)
    (label: String) => HelpEntry(joinShown(all, " ", shown(label, t.thLabel, t)), d.dHelp)
    ()              => HelpEntry(all, d.dHelp)

fun helpPositionals(t: Theme, ds: List<Decl>): List<HelpEntry> =>
  map(filter(ds, (d: Decl) => isPositional(d)),
      (d: Decl) => HelpEntry(shown(displayName(d), t.thAction, t), d.dHelp))

fun helpOptionals(t: Theme, ds: List<Decl>): List<HelpEntry> =>
  map(filter(ds, (d: Decl) => !isPositional(d)), (d: Decl) => helpOption(t, d))


# ── a failed parse (ArgumentParser.error) ────────────────────────────────────

fun errorText(prog: String, ds: List<Decl>, e: ArgError, width: Int, colour: Bool): String
  let f = formatFor(prog, width, colour)
  let t = f.fmTheme
  ret usageSection(f, ds) + "\n" + prog + ": " + t.thError + "error:" + t.thReset + " "
    + t.thMessage + why(e) + t.thReset + "\n"

fun why(e: ArgError): String => match(e)
  (a: AmbiguousOption) => "ambiguous option: " + a.word + " could match " + join(a.matches, ", ")
  (m: MissingValue)    => "argument " + m.argument + ": expected one argument"
  (i: IgnoredValue)    => "argument " + i.argument + ": ignored explicit argument " + quoted(i.value)
  (b: BadValue)        => "argument " + b.argument + ": " + b.why
  (r: MissingRequired) => "the following arguments are required: " + join(r.names, ", ")
  (u: Unrecognised)    => "unrecognized arguments: " + join(u.words, " ")
  (i: Invalid)         => i.why

# Python's `repr` of a string: single-quoted unless it holds a single quote
# and no double one.
fun quoted(s: String): String
  let useDouble = containsByte(s, '\'') && !containsByte(s, '"')
  let q = useDouble ? "\"" : "'"
  ret q + quotedBody(s, 0, useDouble ? '"' : '\'', "") + q

fun [tail] quotedBody(s: String, at: Int, quote: Int32, acc: String): String
  if at >= length(s)
    ret acc
  ret quotedBody(s, at + 1, quote, acc + quotedByte(byteAt(s, at), quote))

fun quotedByte(c: Int32, quote: Int32): String
  if c == '\\'
    ret "\\\\"
  if c == quote
    ret "\\" + asciiToString(quote)
  if c == '\n'
    ret "\\n"
  if c == '\r'
    ret "\\r"
  if c == '\t'
    ret "\\t"
  if c < 32i32 || c == 127i32
    ret "\\x" + hexByte(Int(c))
  ret asciiToString(c)

fun hexByte(v: Int): String
  let digits = "0123456789abcdef"
  ret slice(digits, v / 16, v / 16 + 1) + slice(digits, v % 16, v % 16 + 1)


# ── usage (HelpFormatter._format_usage) ──────────────────────────────────────

# `usage: PROG [-h] …`, wrapped to the width without its trailing newline.
fun usageSection(f: Format, ds: List<Decl>): String
  let t = f.fmTheme
  let prog = Shown(f.fmProg, f.fmProg)
  let opts = usageOptionals(t, ds)
  let poss = usagePositionals(t, ds)
  let all = concat(opts, poss)
  let oneLine = join(prepend(f.fmProg, map(all, (p: Shown) => p.swPlain)), " ")
  let body = 7 + length(oneLine) > f.fmWidth
    ? join(wrappedUsage(f.fmWidth, prog, opts, poss), "\n")
    : join(prepend(f.fmProg, map(all, (p: Shown) => p.swText)), " ")
  ret t.thUsage + "usage: " + t.thReset + t.thProg + f.fmProg + t.thReset
    + slice(body, length(f.fmProg), length(body))

# A short program name is followed by the optionals, the positionals on lines
# of their own beneath; a long one sits on a line by itself.
fun wrappedUsage(width: Int, prog: Shown, opts: List<Shown>, poss: List<Shown>): List<String>
  let progLen = length(prog.swPlain)
  if 4 * (7 + progLen) <= 3 * width
    ret concat(usageLines(width, prepend(prog, opts), 7 + progLen + 1, true),
               usageLines(width, poss, 7 + progLen + 1, false))
  let together = usageLines(width, concat(opts, poss), 7, false)
  ret prepend(prog.swText, sizeAtLeast(together, 2)
    ? concat(usageLines(width, opts, 7, false), usageLines(width, poss, 7, false))
    : together)

# `get_lines`: parts joined by spaces, a new line (indented) when the next part
# would pass the width. With the `usage: ` prefix, the first line is measured
# from it and carries no indent.
fun usageLines(width: Int, parts: List<Shown>, indent: Int, prefixed: Bool): List<String>
  let lines = usageLoop(parts, width, indent, spaces(indent),
                        prefixed ? 7 - 1 : indent - 1, List(), List())
  ret prefixed ? mapFirst(lines, (l: String) => slice(l, indent, length(l))) : lines

# Words fill the current line until the next would overflow it; the open line
# is flushed at the end.
fun usageLoop(ps: List<Shown>, width: Int, indent: Int, pad: String, lineLen: Int,
              line: List<String>, out: List<String>): List<String> =>
  fold(ps, (len = lineLen, line = line, out = out),
       (st, p) =>
         st.len + 1 + length(p.swPlain) > width && !isEmpty(st.line)
           ? (len = indent - 1 + length(p.swPlain) + 1, line = List(p.swText),
              out = append(st.out, pad + join(st.line, " ")))
           : (len = st.len + length(p.swPlain) + 1, line = append(st.line, p.swText), out = st.out))
    |> (st) => isEmpty(st.line) ? st.out : append(st.out, pad + join(st.line, " "))

fun mapFirst(l: List<String>, f: (:String): String): List<String> => match(head(l))
  (x: String) => prepend(f(x), dropOne(l))
  ()          => l


# ── help (ArgumentParser.format_help) ────────────────────────────────────────

fun helpText(prog: String, description: String, ds: List<Decl>, width: Int, colour: Bool): String
  let f = formatFor(prog, width, colour)
  let t = f.fmTheme
  let entries = concat(helpPositionals(t, ds), helpOptionals(t, ds))
  let maxLen = 2 + fold<HelpEntry, Int>(entries, 0,
    (m: Int, e: HelpEntry) => greater(m, length(e.heInvocation.swPlain)))
  let raw = usageSection(f, ds) + "\n\n"
    + join(twWrap(description, greater(f.fmWidth, 11)), "\n") + "\n\n"
    + helpSection(f, maxLen, "positional arguments", helpPositionals(t, ds))
    + helpSection(f, maxLen, "options", helpOptionals(t, ds))
  ret trimNewlines(collapseNewlines(raw, 0, "")) + "\n"

# A section with nothing to list is left out.
fun helpSection(f: Format, maxLen: Int, heading: String, es: List<HelpEntry>): String
  ret isEmpty(es) ? "" : "\n" + f.fmTheme.thHeading + heading + ":" + f.fmTheme.thReset + "\n"
    + join(map(es, (e: HelpEntry) => helpEntry(f.fmWidth, maxLen, e)), "") + "\n"

# `_format_action`, at indent 2: the invocation padded to the help column, or
# on a line of its own when it does not fit; then the help, wrapped. An
# argument with no help is its invocation alone.
fun helpEntry(width: Int, maxLen: Int, e: HelpEntry): String
  if e.heHelp == ""
    ret "  " + e.heInvocation.swText + "\n"
  let helpPos = lesser(maxLen + 2, lesser(24, greater(width - 20, 4)))
  let actionWidth = helpPos - 4
  let inv = e.heInvocation
  let fits = length(inv.swPlain) <= actionWidth
  let header = fits
    ? "  " + inv.swText + spaces(actionWidth - length(inv.swPlain)) + "  "
    : "  " + inv.swText + "\n"
  let lines = twWrap(e.heHelp, greater(width - helpPos, 11))
  ret header + spaces(fits ? 0 : helpPos) + (head(lines) ?? "") + "\n"
    + join(map(dropOne(lines), (l: String) => spaces(helpPos) + l + "\n"), "")

# Runs of three or more newlines become two (`_long_break_matcher`).
fun [tail] collapseNewlines(s: String, at: Int, acc: String): String
  if at >= length(s)
    ret acc
  let run = newlineEnd(s, at) - at
  ret run > 0
    ? collapseNewlines(s, at + run, acc + (run >= 3 ? "\n\n" : slice(s, at, at + run)))
    : collapseNewlines(s, nextNewline(s, at), acc + slice(s, at, nextNewline(s, at)))

fun [tail] newlineEnd(s: String, at: Int): Int
  ret at < length(s) && byteAt(s, at) == '\n' ? newlineEnd(s, at + 1) : at

fun nextNewline(s: String, at: Int) => findByte(s, '\n', at) < 0 ? length(s) : findByte(s, '\n', at)

fun trimNewlines(s: String) => slice(s, leadingNewlines(s, 0), trailingEnd(s, length(s)))

fun [tail] leadingNewlines(s: String, at: Int): Int
  ret at < length(s) && byteAt(s, at) == '\n' ? leadingNewlines(s, at + 1) : at

fun [tail] trailingEnd(s: String, end: Int): Int
  ret end > 0 && byteAt(s, end - 1) == '\n' ? trailingEnd(s, end - 1) : end

fun spaces(n: Int) => spacesLoop(n, "")

fun [tail] spacesLoop(n: Int, acc: String): String => n <= 0 ? acc : spacesLoop(n - 1, acc + " ")

fun lesser(a: Int, b: Int) => a < b ? a : b

fun greater(a: Int, b: Int) => a > b ? a : b


# ── textwrap.wrap (break_long_words, break_on_hyphens) ───────────────────────
# Over text that is single-spaced already, as every help text here is.

fun twWrap(text: String, width: Int): List<String> =>
  twLines(twChunks(text, 0, List()), width, true, List())

# `wordsep_re`: runs of spaces; words, split after a hyphen that has two
# letters (or letter-hyphen-letter) before it and a letter, an optional hyphen
# and a letter after; and an em-dash (`--`) between words. Letters are `\w`
# without the digits — ASCII here, and every byte of a non-ASCII character.
fun [tail] twChunks(s: String, at: Int, b: List<String>): List<String>
  if at >= length(s)
    ret b
  if byteAt(s, at) == ' '
    ret twChunks(s, spaceEnd(s, at), append(b, slice(s, at, spaceEnd(s, at))))
  if isEmDash(s, at)
    ret twChunks(s, dashEnd(s, at), append(b, slice(s, at, dashEnd(s, at))))
  let end = twWordEnd(s, at + 1)
  ret twChunks(s, end, append(b, slice(s, at, end)))

fun [tail] spaceEnd(s: String, at: Int): Int
  ret at < length(s) && byteAt(s, at) == ' ' ? spaceEnd(s, at + 1) : at

fun [tail] dashEnd(s: String, at: Int): Int
  ret at < length(s) && byteAt(s, at) == '-' ? dashEnd(s, at + 1) : at

# `(?<=wp) -{2,} (?=\w)`
fun isEmDash(s: String, at: Int) => at > 0 && twWordPunct(byteAt(s, at - 1))
  && dashEnd(s, at) - at >= 2 && dashEnd(s, at) < length(s) && twWordChar(byteAt(s, dashEnd(s, at)))

# The word's end, checked after each character it takes (`nws+?`): a breaking
# hyphen (taken with the word), a space or the end, or an em-dash ahead.
fun [tail] twWordEnd(s: String, at: Int): Int
  if at >= length(s) || byteAt(s, at) == ' '
    ret at
  if byteAt(s, at) == '-' && hyphenBreaks(s, at)
    ret at + 1
  if twWordPunct(byteAt(s, at - 1)) && dashEnd(s, at) - at >= 2
       && dashEnd(s, at) < length(s) && twWordChar(byteAt(s, dashEnd(s, at)))
    ret at
  ret twWordEnd(s, at + 1)

fun hyphenBreaks(s: String, at: Int) => (twoLettersBefore(s, at) || letterHyphenLetterBefore(s, at))
  && twLetterAt(s, at + 1)
  && (twLetterAt(s, at + 2) || (at + 2 < length(s) && byteAt(s, at + 2) == '-' && twLetterAt(s, at + 3)))

fun twoLettersBefore(s: String, at: Int) => at >= 2 && twLetterAt(s, at - 1) && twLetterAt(s, at - 2)

fun letterHyphenLetterBefore(s: String, at: Int) => at >= 3 && twLetterAt(s, at - 1)
  && byteAt(s, at - 2) == '-' && twLetterAt(s, at - 3)

fun twLetterAt(s: String, at: Int) => at < length(s) && twLetter(byteAt(s, at))

fun twLetter(c: Int32) => (c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z') || c == '_' || c >= 128i32

fun twWordChar(c: Int32) => twLetter(c) || (c >= '0' && c <= '9')

fun twWordPunct(c: Int32) => twWordChar(c) || c == '!' || c == '"' || c == '\'' || c == '&'
  || c == '.' || c == ',' || c == '?'

# `_wrap_chunks`: fill each line with whole chunks; a chunk wider than a whole
# line is broken (after its last hyphen that fits, if any); spaces at a line's
# end, and at the start of any line but the first, are dropped.
fun twLines(cs: List<String>, width: Int, first: Bool,
            out: List<String>): List<String> => isEmpty(cs)
  ? out
  : twNext(twLongWord(twFill(skipLeading(cs, first), width, List(), 0), width), width, first, out)

# `first`: no line has been emitted yet.
fun twNext(f: Filled, width: Int, first: Bool, out: List<String>): List<String>
  let line = dropBlankEnd(f.flLine)
  ret twLines(f.flRest, width, first && isEmpty(line),
              isEmpty(line) ? out : append(out, join(line, "")))

fun skipLeading(cs: List<String>, first: Bool): List<String> => match(head(cs))
  (w: String) => !first && isBlank(w) ? dropOne(cs) : cs
  ()          => cs

class [final] Filled(flLine: List<String>, flLen: Int, flRest: List<String>)

fun [tail] twFill(cs: List<String>, width: Int, line: List<String>, len: Int): Filled => match(head(cs))
  (w: String) => len + length(w) <= width
    ? twFill(dropOne(cs), width, append(line, w), len + length(w))
    : Filled(line, len, cs)
  ()          => Filled(line, len, cs)

fun twLongWord(f: Filled, width: Int): Filled => match(head(f.flRest))
  (w: String) => length(w) <= width ? f : twBreak(f, w, dropOne(f.flRest), width)
  ()          => f

fun twBreak(f: Filled, chunk: String, rest: List<String>, width: Int): Filled
  let spaceLeft = width < 1 ? 1 : width - f.flLen
  if spaceLeft <= 0
    ret isEmpty(f.flLine) ? Filled(List(chunk), length(chunk), rest) : f
  let hyphen = lastHyphenBefore(chunk, spaceLeft)
  let end = length(chunk) > spaceLeft && hyphen > 0 && hasNonHyphen(chunk, hyphen)
    ? hyphen + 1 : spaceLeft
  ret Filled(concat(f.flLine, List(slice(chunk, 0, end))), f.flLen + end,
             prepend(slice(chunk, end, length(chunk)), rest))

fun [tail] lastHyphenBefore(s: String, end: Int): Int
  ret end <= 0 ? 0 - 1 : byteAt(s, end - 1) == '-' ? end - 1 : lastHyphenBefore(s, end - 1)

fun [tail] hasNonHyphen(s: String, end: Int): Bool
  ret end <= 0 ? false : byteAt(s, end - 1) != '-' ? true : hasNonHyphen(s, end - 1)

fun dropBlankEnd(line: List<String>): List<String> => match(head(takeLastOne(line)))
  (x: String) => isBlank(x) ? dropLastOne(line) : line
  ()          => line

# All spaces — or empty, as a broken word's remainder can be.
fun isBlank(c: String) => blankFrom(c, 0)

fun [tail] blankFrom(c: String, at: Int): Bool
  ret at >= length(c) ? true : byteAt(c, at) != ' ' ? false : blankFrom(c, at + 1)
