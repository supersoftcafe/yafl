namespace System::Internal

import System


# Object pinning, for a class whose fields are written after construction
# (`[pinnable]`, or `[mutable]`) with `subject.field := value`. The pin is the
# LOCK: a pinned object is neither moved by the compactor nor written by anyone
# else, so the plain stores between `pin` and `unpin` are the whole critical
# section. The compiler checks that the class admits a write; it does not check
# that the pin is held.
#
#     import System::Internal
#
#     let held = pin(cell)
#     if held.next is None
#       held.next := Cell(2, None)
#     unpin(held)
#
# `pin` waits for a peer's pin and follows a relocation, so it always succeeds,
# and answers the object actually pinned: write through that, never through the
# reference passed in. See yafl.h `object_pin`.
#
# For the write-once case above — fill a heap-object field only if it is
# empty — `__builtin_pin_set__(cell, cell.next, Cell(2, None))` does the pin,
# the check, the store and the release in one step, answering None when it
# stored and the value already there when it did not (yafl.h object_pin_set).
fun [foreign("yafl_pin"), impure, sync] pin<T>(o: T): T

# Release the pin taken by `pin`. Only on an object you pinned.
fun [foreign("yafl_unpin"), impure, sync] unpin<T>(o: T): System::None
