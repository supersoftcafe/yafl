
namespace System::Containers

import System


class [final, pinnable] _ListNode<T>(_next: _ListNode<T>|None, _value: T)
enum NewList<T>
  enum _NewListEmpty()
  enum _NewListFull(_head: _ListNode<T>, _tail: _ListNode<T>)

fun NewList<T>(): NewList<T> => _NewListEmpty<T>()

fun NewList<T>(value: T): NewList<T>
  let node = _ListNode<T>(None, value)
  ret _NewListFull<T>(node, node)

fun NewList<T>(v1: T, v2: T): NewList<T>
  let n2 = _ListNode<T>(None, v2)
  let n1 = _ListNode<T>(n2, v1)
  ret _NewListFull<T>(n1, n2)

fun NewList<T>(v1: T, v2: T, v3: T): NewList<T>
  let n3 = _ListNode<T>(None, v3)
  let n2 = _ListNode<T>(n3, v2)
  let n1 = _ListNode<T>(n2, v1)
  ret _NewListFull<T>(n1, n3)


instance<T> Stream<NewList<T>, T, Never>
  fun next(self: NewList<T>): (stream: NewList<T>, value: Result<T|None, Never>)
    let first = takeOne(self)
    ret (dropOne(self), Ok<T|None, Never>(head(first)))


fun _casTail<T>(obj: _ListNode<T>, newTail: _ListNode<T>): _ListNode<T>|None
  ret __builtin_pin_set__(obj, obj._next, newTail)

fun _setTail<T>(obj: _ListNode<T>, newTail: _ListNode<T>): _ListNode<T>
  obj._next := newTail
  ret newTail

fun _getNextNode<T>(head: _ListNode<T>, tail: _ListNode<T>): _ListNode<T>|None
  ret __builtin_op__<bool>("object_same", head, tail) ? None : head._next

# A private copy of `from` whose last node links to `onto`'s head, so it reads
# as from followed by onto. Nobody else can see the copy until it is returned,
# so plain stores are enough.
fun _copyOnto<T>(from: _NewListFull<T>, onto: _NewListFull<T>): _NewListFull<T>
  fun link(head: _ListNode<T>, tail: _ListNode<T>): _NewListFull<T>
    tail._next := onto._head
    ret _NewListFull<T>(head, onto._tail)
  fun [tail] copy(head: _ListNode<T>, tail: _ListNode<T>, next: _ListNode<T>|None): _NewListFull<T>
    ret match(next)
      (_:None) => link(head, tail)
      (n:_ListNode<T>) => copy(head, _setTail<T>(tail, _ListNode<T>(None, n._value)), _getNextNode<T>(n, from._tail))
  let h = _ListNode<T>(None, from._head._value)
  ret copy(h, h, _getNextNode<T>(from._head, from._tail))

fun _count<T>(list: NewList<T>): Int
  ret fold(list, 0, (acc, n) => acc + 1)


# If nothing has linked past the list's tail node yet, we can link the new
# node there unobserved: every other list sharing that node ends at its own
# tail (walks stop by identity, see _getNextNode), so none of them can see
# the new node. If the tail is already linked onward, we copy the list first.
fun [inline(never)] append<T>(list: NewList<T>, value: T): NewList<T>
  let newTail = _ListNode<T>(None, value)
  ret match(list)
    (_: _NewListEmpty<T>) => _NewListFull<T>(newTail, newTail)
    (head: _NewListFull<T>) => match(_casTail(head._tail, newTail))
      (_: None) => _NewListFull<T>(head._head, newTail)
      (_: _ListNode<T>) => _copyOnto<T>(head, _NewListFull<T>(newTail, newTail))


# Simplest and fastest of all list operations, just construct a new head node and link to the list.
fun prepend<T>(value: T, list: NewList<T>): NewList<T>
  ret match(list)
    (_: _NewListEmpty<T>) => NewList<T>(value)
    (head: _NewListFull<T>) => _NewListFull<T>(_ListNode<T>(head._head, value), head._tail)


# Return a list of at most 'count' elements from the start of 'list'.
fun [inline(never)] take<T>(list: NewList<T>, count: Int): NewList<T>
  fun [tail] expand(l: _NewListFull<T>, end: _ListNode<T>, count: Int): NewList<T>
    ret match(count > 1 ? _getNextNode<T>(l._tail, end) : None)
      (_:None) => l
      (n:_ListNode<T>) => expand(_NewListFull<T>(l._head, n), end, count - 1)
  ret match(count <= 0 ? _NewListEmpty<T>() : list)
    (_:_NewListEmpty<T>) => _NewListEmpty<T>()
    (l:_NewListFull<T>) => expand(_NewListFull<T>(l._head, l._head), l._tail, count)


# Return a list that comes after the first 'count' elements from the start of 'list'.
fun [inline(never), tail] drop<T>(list: NewList<T>, count: Int): NewList<T>
  ret match (list)
    (_:_NewListEmpty<T>) => _NewListEmpty<T>()
    (l:_NewListFull<T>) => count > 0 ? drop(dropOne(l), count-1) : l


# Fast path
#   The target list hasn't had a concat or append operation applied previously
#   and there is no risk of duplicate nodes in the two lists. We can link the
#   two lists safely. Original observers don't see this change.
# Slow path
#   We copy the to list and link the copy's last node to the from list's head
#   (_copyOnto). The copy is private, so that link is always safe.
fun [inline(never)] concat<T>(listTo: NewList<T>, listFrom: NewList<T>): NewList<T>
  ret match(listTo)
    (_:_NewListEmpty<T>) => listFrom
    (to:_NewListFull<T>) => match(listFrom)
      (_:_NewListEmpty<T>) => listTo
      (from:_NewListFull<T>) => __builtin_op__<bool>("object_same", to._tail, from._tail)
       || from._tail._next !is None || _casTail(to._tail, from._head) !is None
        ? _copyOnto<T>(to, from) : _NewListFull<T>(to._head, from._tail)
      

fun head<T>(list: NewList<T>): T|None
  ret match(list)
    (_: _NewListEmpty<T>) => None
    (l: _NewListFull<T>) => l._head._value

fun dropOne<T>(list: NewList<T>): NewList<T>
  ret match(list)
    (_: _NewListEmpty<T>) => _NewListEmpty<T>()
    (l: _NewListFull<T>) => match(_getNextNode(l._head, l._tail))
      (_: None) => _NewListEmpty<T>()
      (n: _ListNode<T>) => _NewListFull<T>(n, l._tail)

fun takeOne<T>(list: NewList<T>): NewList<T>
  ret match(list)
    (_: _NewListEmpty<T>) => _NewListEmpty<T>()
    (l: _NewListFull<T>) => _NewListFull<T>(l._head, l._head)


fun takeLastOne<T>(list: NewList<T>): NewList<T>
  ret match(list)
    (_: _NewListEmpty<T>) => _NewListEmpty<T>()
    (l: _NewListFull<T>) => _NewListFull<T>(l._tail, l._tail)

# All but the last element. The result shares the source's nodes: one walk to
# find the node before the last, no copying.
fun dropLastOne<T>(list: NewList<T>): NewList<T>
  fun [tail] walk(l: _NewListFull<T>, node: _ListNode<T>): NewList<T>
    ret match(_getNextNode<T>(node, l._tail))
      (_: None) => _NewListEmpty<T>()
      (n: _ListNode<T>) => __builtin_op__<bool>("object_same", n, l._tail)
        ? _NewListFull<T>(l._head, node)
        : walk(l, n)
  ret match(list)
    (_: _NewListEmpty<T>) => _NewListEmpty<T>()
    (l: _NewListFull<T>) => walk(l, l._head)


fun isEmpty<T>(list: NewList<T>): Bool
  ret list is _NewListEmpty<T>


fun findIndex<T>(list: NewList<T>, predicate: (:T): Bool): Int|None
  fun [tail] findIndex2(list: NewList<T>, index: Int): Int|None
    ret match(list)
      (_:_NewListEmpty<T>) => None
      (n:_NewListFull<T>) => predicate(n._head._value) ? index : findIndex2(dropOne(n), index+1)
  ret findIndex2(list, 0)

fun any<T>(list: NewList<T>, predicate: (:T): Bool): Bool
  ret findIndex<T>(list, predicate) !is None

fun all<T>(list: NewList<T>, predicate: (:T): Bool): Bool
  ret fold<T, Bool>(list, true, (acc: Bool, x: T) => acc && predicate(x))

fun contains<T>(list: NewList<T>, x: T): Bool where BasicEquality<T>
  ret any<T>(list, (y: T) => y == x)


fun flatMap<T,U>(list: NewList<T>, func: (:T): NewList<U>): NewList<U>
  ret fold<T, NewList<U>>(list, NewList<U>(), (acc: NewList<U>, x: T) => concat<U>(acc, func(x)))

fun filter<T>(list: NewList<T>, predicate: (:T): Bool): NewList<T>
  ret fold<T, NewList<T>>(list, NewList<T>(), (acc: NewList<T>, x: T) => predicate(x) ? append<T>(acc, x) : acc)

fun map<T,U>(list: NewList<T>, func: (:T): U): NewList<U>
  ret fold<T, NewList<U>>(list, NewList<U>(), (acc: NewList<U>, x: T) => append<U>(acc, func(x)))

fun [tail] fold<T, [linear] U>(list: NewList<T>, init: U, accFunc: (:U, :T): U): U
  let first = takeOne(list)
  ret match(first)
    (_:_NewListEmpty<T>) => init
    (l:_NewListFull<T>) => fold(dropOne(list), accFunc(init, l._head._value), accFunc)

# fold that stops early: `predicate` sees the accumulator before each element,
# and the first accumulator it rejects is the result. If it accepts them all,
# this is fold.
fun [tail] foldWhile<T, U>(list: NewList<T>, init: U, accFunc: (:U, :T): U, predicate: (:U): Bool): U
  ret match(list)
    (_:_NewListEmpty<T>) => init
    (l:_NewListFull<T>) => predicate(init)
      ? foldWhile(dropOne(list), accFunc(init, l._head._value), accFunc, predicate)
      : init

# fold over two lists in step, stopping at the end of the shorter one.
fun [tail] zipFold<A, B, [linear] U>(a: NewList<A>, b: NewList<B>, init: U, accFunc: (:U, :A, :B): U): U
  ret match(a)
    (_:_NewListEmpty<A>) => init
    (la:_NewListFull<A>) => match(b)
      (_:_NewListEmpty<B>) => init
      (lb:_NewListFull<B>) => zipFold(dropOne(a), dropOne(b), accFunc(init, la._head._value, lb._head._value), accFunc)

fun [tail] sizeAtLeast<T>(list: NewList<T>, size: Int): Bool
  ret size<=0 || (!isEmpty(list) && sizeAtLeast(dropOne(list), size-1))


# Two lists are equal when they have the same length and `same` holds for each
# pair. One list ending while the other still has an element IS the inequality.
fun [tail] eqBy<T>(a: NewList<T>, b: NewList<T>, same: (:T, :T): Bool): Bool
  ret match(a)
    (_: _NewListEmpty<T>) => isEmpty(b)
    (la: _NewListFull<T>) => match(b)
      (_: _NewListEmpty<T>) => false
      (lb: _NewListFull<T>) => same(la._head._value, lb._head._value) && eqBy(dropOne(a), dropOne(b), same)

# Pairwise map, stopping at the shorter list.
fun zipMap<A, B, C>(a: NewList<A>, b: NewList<B>, func: (:A, :B): C): NewList<C>
  ret zipFold<A, B, NewList<C>>(a, b, NewList<C>(), (acc: NewList<C>, x: A, y: B) => append<C>(acc, func(x, y)))

# Split into the elements that satisfy `predicate` and those that don't, each
# in list order.
fun partition<T>(list: NewList<T>, predicate: (:T): Bool): (yes: NewList<T>, no: NewList<T>)
  fun step(acc: (yes: NewList<T>, no: NewList<T>), x: T): (yes: NewList<T>, no: NewList<T>)
    ret predicate(x) ? (yes = append(acc.yes, x), no = acc.no) : (yes = acc.yes, no = append(acc.no, x))
  ret fold(list, (yes = NewList<T>(), no = NewList<T>()), step)

# The leading floor(n/2) elements and the rest; both halves share the source's
# nodes. For n >= 2 both are non-empty, which is what dividing work needs.
fun splitHalf<T>(list: NewList<T>): (left: NewList<T>, right: NewList<T>)
  fun [tail] half(fast: NewList<T>, k: Int): Int
    ret isEmpty(fast) || isEmpty(dropOne(fast)) ? k : half(dropOne(dropOne(fast)), k + 1)
  let k = half(list, 0)
  ret (left = take(list, k), right = drop(list, k))


# Stable natural mergesort. The seed pass cuts the list into its maximal
# ascending runs, each one a slice that shares the source's nodes, so sorted
# input costs one walk and no allocation per element. Runs then merge in pairs
# until one is left. Ties take from the earlier run, which is what makes it
# stable.
fun sort<T>(list: NewList<T>): NewList<T> where BasicCompare<T>
  ret sortBy<T>(list, (a: T, b: T) => a < b)

# `less` must be a STRICT ordering: true iff its first argument precedes its
# second. Ties keep their original order.
fun sortBy<T>(list: NewList<T>, less: (:T, :T): Bool): NewList<T>
  ret match(list)
    (_: _NewListEmpty<T>) => list
    (l: _NewListFull<T>) => _mergeRuns<T>(_ascendingRuns<T>(l, less), less)

fun _ascendingRuns<T>(l: _NewListFull<T>, less: (:T, :T): Bool): NewList<NewList<T>>
  # A run continues while the next element is not strictly less than the one
  # before it; a descent closes it.
  fun [tail] walk(start: _ListNode<T>, node: _ListNode<T>, runs: NewList<NewList<T>>): NewList<NewList<T>>
    ret match(_getNextNode<T>(node, l._tail))
      (_: None) => append(runs, _NewListFull<T>(start, node))
      (n: _ListNode<T>) => less(n._value, node._value)
        ? walk(n, n, append(runs, _NewListFull<T>(start, node)))
        : walk(start, n, runs)
  ret walk(l._head, l._head, NewList<NewList<T>>())

fun [tail] _mergeRuns<T>(runs: NewList<NewList<T>>, less: (:T, :T): Bool): NewList<T>
  ret match(runs)
    (_: _NewListEmpty<NewList<T>>) => NewList<T>()
    (r: _NewListFull<NewList<T>>) => isEmpty(dropOne(runs))
      ? r._head._value
      : _mergeRuns<T>(_mergePairs<T>(runs, NewList<NewList<T>>(), less), less)

# An odd trailing run passes through untouched.
fun [tail] _mergePairs<T>(runs: NewList<NewList<T>>, acc: NewList<NewList<T>>, less: (:T, :T): Bool): NewList<NewList<T>>
  ret match(runs)
    (_: _NewListEmpty<NewList<T>>) => acc
    (r: _NewListFull<NewList<T>>) => match(dropOne(runs))
      (_: _NewListEmpty<NewList<T>>) => append(acc, r._head._value)
      (r2: _NewListFull<NewList<T>>) => _mergePairs<T>(dropOne(r2), append(acc, _merge2<T>(r._head._value, r2._head._value, less)), less)

# Takes from `a` unless `b` is STRICTLY less, so a tie takes the earlier run's
# element first. When one side runs out the other is linked on with concat.
fun _merge2<T>(a: NewList<T>, b: NewList<T>, less: (:T, :T): Bool): NewList<T>
  fun [tail] walk(out: NewList<T>, x: NewList<T>, y: NewList<T>): NewList<T>
    ret match(x)
      (_: _NewListEmpty<T>) => concat(out, y)
      (lx: _NewListFull<T>) => match(y)
        (_: _NewListEmpty<T>) => concat(out, x)
        (ly: _NewListFull<T>) => less(ly._head._value, lx._head._value)
          ? walk(append(out, ly._head._value), x, dropOne(y))
          : walk(append(out, lx._head._value), dropOne(x), y)
  ret walk(NewList<T>(), a, b)


fun groupBy<T,K>(list: NewList<T>, keyFunc: (:T): K): Dict<K,NewList<T>> where BasicEquality<K>
  fun appendOrCreate(l: NewList<T>|None, v: T): NewList<T>
    ret match(l)
      (_:None) => NewList<T>(v)
      (l:NewList<T>) => append(l, v)
  fun groupByAppend(d: Dict<K,NewList<T>>, v: T): Dict<K,NewList<T>>
    let k = keyFunc(v)
    ret put(d, k, appendOrCreate(get(d, k), v))
  ret fold(list, Dict<K,NewList<T>>(), groupByAppend)


fun [future, inline(never)] powerMap<T,U>(list: NewList<T>, func: (:T): U): NewList<U>
  let prefix = take(list, 16)
  let suffix = drop(list, 16)
  if isEmpty(suffix)
    ret map(prefix, func)
  fun [future] futureMap(list: NewList<T>) => map(list, func)
  let prefixResult = futureMap(prefix)
  let suffixResult =  powerMap(suffix, func)
  ret concat(prefixResult, suffixResult)

