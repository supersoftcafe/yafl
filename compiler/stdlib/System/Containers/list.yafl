
namespace System::Containers

import System


class [final, pinnable] _ListNode<T>(_next: _ListNode<T>|None, _value: T)
enum NewList<T>
  enum NewListEmpty()
  enum NewListFull(_head: _ListNode<T>, _tail: _ListNode<T>)

fun NewList<T>(): NewList<T> => NewListEmpty<T>()

fun NewList<T>(value: T): NewList<T>
  let node = _ListNode<T>(None, value)
  ret NewListFull<T>(node, node)

fun NewList<T>(v1: T, v2: T): NewList<T>
  let n2 = _ListNode<T>(None, v2)
  let n1 = _ListNode<T>(n2, v1)
  ret NewListFull<T>(n1, n2)


instance<T> Stream<NewList<T>, T, Never>
  fun next(self: NewList<T>): (stream: NewList<T>, value: Result<T|None, Never>)
    let (value: T|None, next: NewList<T>) = splitFirst(self)
    ret (next, Ok<T|None, Never>(value))


fun _casTail<T>(obj: _ListNode<T>, newTail: _ListNode<T>): _ListNode<T>|None
  ret __builtin_pin_set__(obj, obj._next, newTail)

fun _setTail<T>(obj: _ListNode<T>, newTail: _ListNode<T>): _ListNode<T>
  obj._next := newTail
  ret newTail

fun _getNextNode<T>(head: _ListNode<T>, tail: _ListNode<T>): _ListNode<T>|None
  ret __builtin_op__<bool>("object_same", head, tail) ? None : head._next

fun _deepCopy<T>(from: NewListFull<T>): NewListFull<T>
  fun [tail] copyFullList(head: _ListNode<T>, tail: _ListNode<T>, next: _ListNode<T>|None, endMark: _ListNode<T>): NewListFull<T>
    ret match(next)
      (_:None) => NewListFull(head, tail)
      (n:_ListNode<T>) => copyFullList(head, _setTail<T>(tail, _ListNode<T>(None, n._value)), _getNextNode<T>(n, endMark), endMark)
  let h = _ListNode<T>(None, from._head._value)
  ret copyFullList(h, h, _getNextNode(from._head, from._tail), from._tail)

fun _count<T>(list: NewList<T>): Int
  ret fold(list, 0, (acc, n) => acc + 1)


# If nothing else has mutated the end of the list we can safely do that 
# unobserved, because every observer holds their own count for iteration,
# so won't overflow into our new node. If some other mutation has happened
# we fall back to a slower copy approach.
fun [tail, inline(never)] append<T>(list: NewList<T>, value: T): NewList<T>
  let newTail = _ListNode<T>(None, value)
  ret match(list)
    (_: NewListEmpty<T>) => NewListFull<T>(newTail, newTail)
    (head: NewListFull<T>) => match(_casTail(head._tail, newTail))
      (_: None) => NewListFull<T>(head._head, newTail)
      (_: _ListNode<T>) => append(_deepCopy<T>(head), value)


# Simplest and fastest of all list operations, just construct a new head node and link to the list.
fun prepend<T>(list: NewList<T>, value: T): NewList<T>
  ret match(list)
    (_: NewListEmpty<T>) => NewList<T>(value)
    (head: NewListFull<T>) => NewListFull<T>(_ListNode<T>(head._head, value), head._tail)


# Return a list of at most 'count' elements from the start of 'list'.
fun [inline(never)] take<T>(list: NewList<T>, count: Int): NewList<T>
  fun [tail] expand(l: NewListFull<T>, count: Int): NewList<T>
    ret match(count > 1 ? l._tail._next : None)
      (_:None) => l
      (n:_ListNode<T>) => expand(NewListFull<T>(l._head, n), count - 1)
  ret match(count <= 0 ? NewListEmpty<T>() : list)
    (_:NewListEmpty<T>) => NewListEmpty<T>()
    (l:NewListFull<T>) => expand(NewListFull<T>(l._head, l._head), count)


# Return a list that comes after the first 'count' elements from the start of 'list'.
fun [inline(never), tail] drop<T>(list: NewList<T>, count: Int): NewList<T>
  ret match (list)
    (_:NewListEmpty<T>) => NewListEmpty<T>()
    (l:NewListFull<T>) => count > 0 ? drop(tail(list), count-1) : list


# Fast path
#   The target list hasn't had a concat or append operation applied previously
#   and there is no risk of duplicate nodes in the two lists. We can link the
#   two lists safely. Original observers don't see this change.
# Slow path
#   We take a full copy of the to list and go straight to append since we now
#   can guarentee that it's safe.
fun [inline(never)] concat<T>(listTo: NewList<T>, listFrom: NewList<T>): NewList<T>
  fun concatSlowPath(to: NewListFull<T>, from: NewListFull<T>): NewList<T>
    let copy = _deepCopy(to)
    let _ = _setTail(copy._tail, from._head)
    ret NewListFull<T>(copy._head, from._tail)
  ret match(listTo)
    (_:NewListEmpty<T>) => listFrom
    (to:NewListFull<T>) => match(listFrom)
      (_:NewListEmpty<T>) => listTo
      (from:NewListFull<T>) => __builtin_op__<bool>("object_same", to._tail, from._tail)
       || from._tail._next !is None || _casTail(to._tail, from._head) !is None
        ? concatSlowPath(to, from) : NewListFull<T>(to._head, from._tail)
      


fun splitFirst<T>(list: NewList<T>): (value: T|None, list: NewList<T>)
  fun extractTail(head: NewListFull<T>): NewList<T>
    ret match(_getNextNode<T>(head._head, head._tail))
      (_:None) => NewListEmpty<T>()
      (n:_ListNode<T>) => NewListFull<T>(n, head._tail)
  ret match(list)
    (_: NewListEmpty<T>) => (None, NewListEmpty<T>())
    (head: NewListFull<T>) => (head._head._value, extractTail(head))


fun head<T>(list: NewList<T>) => splitFirst(list).value
fun tail<T>(list: NewList<T>) => splitFirst(list).list
fun last<T>(list: NewList<T>): T|None
  ret match(list)
    (_: NewListEmpty<T>) => None
    (head: NewListFull<T>) => head._tail._value


fun isEmpty<T>(list: NewList<T>): Bool
  ret list is NewListEmpty<T>


fun findIndex<T>(list: NewList<T>, predicate: (:T): Bool): Int|None
  fun [tail] findIndex2(list: NewList<T>, index: Int): Int|None
    ret match(list)
      (_:NewListEmpty<T>) => None
      (n:NewListFull<T>) => predicate(n._head._value) ? index : findIndex2(tail(n), index+1)
  ret findIndex2(list, 0)

fun any<T>(list: NewList<T>, predicate: (:T): Bool): Bool
  ret findIndex<T>(list, predicate) !is None

fun all<T>(list: NewList<T>, predicate: (:T): Bool): Bool
  ret fold<T, Bool>(list, true, (acc: Bool, x: T) => acc && predicate(x))

fun contains<T>(list: NewList<T>, x: T): Bool where BasicEquality<T>
  ret any<T>(list, (y: T) => y == x)


fun flatMap<T,U>(list: NewList<T>, func: (:T): NewList<U>): NewList<U>
  ret fold<T, NewList<U>>(list, NewList<U>(), (acc: NewList<U>, x: T) => append<U>(acc, func(x)))

fun filter<T>(list: NewList<T>, predicate: (:T): Bool): NewList<T>
  ret fold<T, NewList<T>>(list, NewList<T>(), (acc: NewList<T>, x: T) => predicate(x) ? append<T>(acc, x) : acc)

fun map<T,U>(list: NewList<T>, func: (:T): U): NewList<U>
  ret fold<T, NewList<U>>(list, NewList<U>(), (acc: NewList<U>, x: T) => append<U>(acc, func(x)))

fun [tail] fold<T, [linear] U>(list: NewList<T>, init: U, accFunc: (:U, :T): U): U
  let (value, remainder) = splitFirst(list)
  ret match(value)
    (_:None) => init
    (v:T) => fold(remainder, accFunc(init, v), accFunc)

fun [tail] sizeAtLeast<T>(list: NewList<T>, size: Int): Bool
  ret size<=0 || (!isEmpty(list) && sizeAtLeast(tail(list), size-1))


fun groupBy<T,K>(list: NewList<T>, keyFunc: (:T): K): Dict<K,NewList<T>> where BasicEquality<K>
  fun appendOrCreate(l: NewList<T>|None, v: T): NewList<T>
    ret match(l)
      (_:None) => NewList<T>(v)
      (l:NewList<T>) => append(l, v)
  fun groupByAppend(d: Dict<K,NewList<T>>, v: T): Dict<K,NewList<T>>
    let k = keyFunc(v)
    ret put(d, k, appendOrCreate(get(d, k), v))
  ret fold(list, Dict<K,NewList<T>>(), groupByAppend)


fun [future, inline(never)] powerMap<T,U>(list: NewList<T>, func: (:T): U): NewList<U>
  let prefix = take(list, 16)
  let suffix = drop(list, 16)
  if isEmpty(suffix)
    ret map(prefix, func)
  fun [future] futureMap(list: NewList<T>) => map(list, func)
  let prefixResult = futureMap(prefix)
  let suffixResult =  powerMap(suffix, func)
  ret concat(prefixResult, suffixResult)

