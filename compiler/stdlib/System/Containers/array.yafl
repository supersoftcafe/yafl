namespace System::Containers
import System
import System::Internal


# An array with O(1) indexed access and append — a sibling to the persistent
# List<T>. Build it from an init function — `Array<T>(n, (i) => ...)` —
# from one to three values — `arrayOf<T>(a, b, c)` — or empty, appending with
# `push`, then read by index with `a[i]`; `size(a)` is its element count.
#
# A value is its own length over a shared buffer, as a String is (str.c). The
# buffer holds elements past any one value's length: `append` writes the next
# element IN PLACE when the value owns the end of the buffer (its length is
# the buffer's) and there is room, and copies into a buffer of twice the size
# otherwise. A value reads only its own [0, length), which never changes, so
# every value keeps its own elements, and one reached through a stale copy of
# a moved buffer reads the same ones.
class [final, pinnable] _ArrayBuf<T>(_used: Int32, [capacity] _cap: Int32, _items: T[_used])

# Empty or full, as List is: an empty array holds no buffer, so making one
# allocates nothing. `_length` is shared by both (0 for an empty one); every
# field is internal, and `size` is the public count. The Int32 `_length` is
# read directly only by this file and by the stdlib's own companions in
# System::Containers (rrbtree.yafl), whose node arithmetic is Int32.
enum Array<T>(_length: Int32)
  enum _EmptyArray()
  enum _FullArray(_buffer: _ArrayBuf<T>)

# The number of elements.
fun size<T>(a: Array<T>): Int
  ret Int(a._length)

# The tabulating constructor: n elements, the i-th init(i), with no room spare.
fun Array<T>(n: Int32, init: (i: Int32): T): Array<T>
  ret n > 0i32 ? _FullArray<T>(n, _ArrayBuf<T>(n, n, init)) : _EmptyArray<T>(0i32)

# Convenience constructors: an empty array, or one holding one to three values.
fun Array<T>(): Array<T>
  ret _EmptyArray<T>(0i32)

fun arrayOf<T>(v1: T): Array<T>
  ret _FullArray<T>(1i32, _ArrayBuf<T>(1i32, 1i32, (i: Int32) => v1))

fun arrayOf<T>(v1: T, v2: T): Array<T>
  ret _FullArray<T>(2i32, _ArrayBuf<T>(2i32, 2i32, (i: Int32) => i == 0i32 ? v1 : v2))

fun arrayOf<T>(v1: T, v2: T, v3: T): Array<T>
  ret _FullArray<T>(3i32, _ArrayBuf<T>(3i32, 3i32,
    (i: Int32) => i == 0i32 ? v1 : (i == 1i32 ? v2 : v3)))


# Indexed read: `a[i]` lowers to ``[]``(a, i). Aborts if `i` is out of range
# (0 <= i < size). The index is Int at the API surface — `a[0]` works
# because 0 IS an Int (literals are their spelling; nothing converts) — and
# is truncated internally, where the runtime bounds check catches any value
# an Int32 could not have addressed anyway.
fun `[]`<T>(a: Array<T>, i: Int): T
  ret a[truncateToInt32(i)]

# Int32 form for byte-scanning code that already holds a sized index. The
# buffer may hold elements past this value's length (another value appended
# them), so the length is checked here; a negative index fails the buffer's
# own check.
fun `[]`<T>(a: Array<T>, i: Int32): T
  ret match(a)
    (f: _FullArray<T>)  => i < f._length ? f._buffer._items(i) : _noSuchIndex<T>(i)
    (e: _EmptyArray<T>) => _noSuchIndex<T>(i)

# TEMPORARY (issue #95): an index past the length aborts, as the old Array
# did, by reading it from a buffer with no elements — the runtime bounds
# check. To be replaced by an answer in the API that says the element is not
# there, as List's head does.
fun _noSuchIndex<T>(i: Int32): T
  ret _ArrayBuf<T>(0i32, 0i32, (j: Int32) => _noSuchIndex<T>(j))._items(i)

# `a` followed by `x`. In place when `a` owns the end of its buffer and there
# is room — the pin is the lock, against other appenders and the compactor —
# and into a fresh buffer of twice the size otherwise. An empty array has no
# buffer: its first element allocates one.
fun append<T>(a: Array<T>, x: T): Array<T>
  ret match(a)
    (f: _FullArray<T>)  => _appendFull<T>(f, x)
    (e: _EmptyArray<T>) => _FullArray<T>(1i32, _ArrayBuf<T>(1i32, 2i32, (i: Int32) => x))

fun _appendFull<T>(f: _FullArray<T>, x: T): Array<T>
  let held = pin(f._buffer)
  let owns = held._used == f._length && held._used < held._cap
  if owns
    held._items(held._used) := x
    held._used := held._used + 1i32
  unpin(held)
  ret owns ? _FullArray<T>(f._length + 1i32, held) : _appendCopy<T>(f, x)

fun _appendCopy<T>(f: _FullArray<T>, x: T): Array<T>
  let n = f._length + 1i32
  ret _FullArray<T>(n, _ArrayBuf<T>(n, n + n,
    (i: Int32) => i < f._length ? f._buffer._items(i) : x))


# ── combinators ──────────────────────────────────────────────────────────────
# The List combinators' Array overloads: same names, resolved by argument
# type, so a container migration is a type change at the call site.

fun isEmpty<T>(a: Array<T>): Bool
  ret a._length == 0i32

# In-order left fold over the elements. The combinators match once and then
# walk the buffer, so a loop pays no per-element test of emptiness.
fun fold<T, [linear] TAcc>(a: Array<T>, acc: TAcc, f: (acc: TAcc, x: T): TAcc): TAcc
  ret match(a)
    (full: _FullArray<T>) => _foldFrom<T, TAcc>(full, 0i32, acc, f)
    (e: _EmptyArray<T>)   => acc

fun [tail] _foldFrom<T, [linear] TAcc>(a: _FullArray<T>, i: Int32, acc: TAcc,
                              f: (acc: TAcc, x: T): TAcc): TAcc
  ret i < a._length ? _foldFrom<T, TAcc>(a, i + 1i32, f(acc, a._buffer._items(i)), f) : acc

# Element-wise transform; the result size is known exactly, so this is the
# tabulating ctor, not a builder.
fun map<T, TOut>(a: Array<T>, f: (x: T): TOut): Array<TOut>
  ret match(a)
    (full: _FullArray<T>) => _FullArray<TOut>(full._length,
                               _ArrayBuf<TOut>(full._length, full._length,
                                               (i: Int32) => f(full._buffer._items(i))))
    (e: _EmptyArray<T>)   => _EmptyArray<TOut>(0i32)

fun filter<T>(a: Array<T>, pred: (:T): Bool): Array<T>
  ret match(a)
    (full: _FullArray<T>) => _filterFrom<T>(full, 0i32, pred, Array<T>())
    (e: _EmptyArray<T>)   => a

fun [tail] _filterFrom<T>(a: _FullArray<T>, i: Int32, pred: (:T): Bool,
                          b: Array<T>): Array<T>
  ret i < a._length
    ? _filterFrom<T>(a, i + 1i32, pred,
                     pred(a._buffer._items(i)) ? push<T>(b, a._buffer._items(i)) : b)
    : b

fun any<T>(a: Array<T>, pred: (:T): Bool): Bool
  ret match(a)
    (full: _FullArray<T>) => _anyFrom<T>(full, 0i32, pred)
    (e: _EmptyArray<T>)   => false

fun [tail] _anyFrom<T>(a: _FullArray<T>, i: Int32, pred: (:T): Bool): Bool
  ret i < a._length && (pred(a._buffer._items(i)) || _anyFrom<T>(a, i + 1i32, pred))


# ── incremental construction ─────────────────────────────────────────────────
# Append one element. `append` is the value-returning operation; `push` is the
# builder-shaped spelling, so a growing sequence reads the same over an Array.
fun push<T>(a: Array<T>, x: T): Array<T>
  ret append<T>(a, x)

# Append every element of `l`, in order. An empty `l` is `a` itself.
fun pushAll<T>(a: Array<T>, l: List<T>): Array<T>
  ret isEmpty(l) ? a : fold<T, Array<T>>(l, a, (acc: Array<T>, x: T) => push<T>(acc, x))

# Append every element of `b`, in order — the concatenation primitive. With
# either side empty the answer is the other value as it stands: values share
# buffers by design, so there is nothing to copy. Otherwise `b` goes in place
# when `a` owns the end of a buffer with room for all of it, and into ONE
# buffer of twice the combined size when not, rather than growing by repeated
# doubling copies.
fun pushAll<T>(a: Array<T>, b: Array<T>): Array<T>
  ret match(b)
    (fb: _FullArray<T>)  => match(a)
      (fa: _FullArray<T>)  => _pushAllFull<T>(fa, fb)
      (ea: _EmptyArray<T>) => b
    (eb: _EmptyArray<T>) => a

fun _pushAllFull<T>(a: _FullArray<T>, b: _FullArray<T>): Array<T>
  let held = pin(a._buffer)
  let room = held._used == a._length && held._cap - held._used >= b._length
  unpin(held)
  ret room ? _pushInPlace<T>(a, b, 0i32) : _concatCopy<T>(a, b)

# Room was there when checked; each push re-checks under its own pin, so a
# competing appender that took the end meanwhile only turns a push into a copy.
fun [tail] _pushInPlace<T>(a: Array<T>, b: _FullArray<T>, i: Int32): Array<T>
  ret i < b._length ? _pushInPlace<T>(append<T>(a, b._buffer._items(i)), b, i + 1i32) : a

fun _concatCopy<T>(a: _FullArray<T>, b: _FullArray<T>): Array<T>
  let n = a._length + b._length
  ret _FullArray<T>(n, _ArrayBuf<T>(n, n + n,
    (i: Int32) => i < a._length ? a._buffer._items(i) : b._buffer._items(i - a._length)))


# ── an Array as a Stream ─────────────────────────────────────────────────────
# The by-value state is a pool struct — (array, index) — stepped in registers;
# with [inline(always)] a drive loop over one compiles to the indexed walk it
# replaces. E = Never: in-memory sources cannot fail, and Never's emptiness
# makes the Error arm unconstructable. (A List is a Stream of its own.)
class [final] ArrayStream<T>(_asArr: Array<T>, _asAt: Int32)

fun arrayStream<T>(a: Array<T>): ArrayStream<T>
  ret ArrayStream<T>(a, 0i32)

instance<T> Stream<ArrayStream<T>, T, Never>
  fun [inline(always)] next(self: ArrayStream<T>): (stream: ArrayStream<T>, value: Result<T | None, Never>)
    ret self._asAt < self._asArr._length
      ? (ArrayStream<T>(self._asArr, self._asAt + 1i32),
         Ok<T | None, Never>(self._asArr[self._asAt]))
      : (self, Ok<T | None, Never>(None))
