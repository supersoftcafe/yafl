namespace System::Containers
import System
import System::Internal


# An array with O(1) indexed access and append — a sibling to the persistent
# List<T>. Build it from an init function — `Array<T>(n, (i) => ...)` — or with
# an ArrayBuilder, then read by index with `a[i]`.
#
# A value is its own length over a shared buffer, as a String is (str.c). The
# buffer holds elements past any one value's length: `_append` writes the next
# element IN PLACE when the value owns the end of the buffer (its length is
# the buffer's) and there is room, and copies into a buffer of twice the size
# otherwise. A value reads only its own [0, length), which never changes, so
# every value keeps its own elements, and one reached through a stale copy of
# a moved buffer reads the same ones.
class [final, pinnable] _ArrayBuf<T>(_used: Int32, [capacity] _cap: Int32, _items: T[_used])
class [final] Array<T>(length: Int32, _buf: _ArrayBuf<T>)

# The tabulating constructor: n elements, the i-th init(i), with no room spare.
fun Array<T>(n: Int32, init: (i: Int32): T): Array<T>
  ret Array<T>(n, _ArrayBuf<T>(n, n, init))

# An empty array with room for `capacity` appends before its first copy. A
# buffer fills only [0, used), so its init function is never called here; the
# constructor takes one, and nothing can make a T from nothing.
fun _emptyArray<T>(capacity: Int32): Array<T>
  ret Array<T>(0i32, _ArrayBuf<T>(0i32, capacity, (i: Int32) => _noSuchIndex<T>(i)))


# Indexed read: `a[i]` lowers to ``[]``(a, i). Aborts if `i` is out of range
# (0 <= i < length). The index is Int at the API surface — `a[0]` works
# because 0 IS an Int (literals are their spelling; nothing converts) — and
# is truncated internally, where the runtime bounds check catches any value
# an Int32 could not have addressed anyway.
fun `[]`<T>(a: Array<T>, i: Int): T
  ret a[truncateToInt32(i)]

# Int32 form for byte-scanning code that already holds a sized index. The
# buffer may hold elements past this value's length (another value appended
# them), so the length is checked here; a negative index fails the buffer's
# own check.
fun `[]`<T>(a: Array<T>, i: Int32): T
  ret i < a.length ? a._buf._items(i) : _noSuchIndex<T>(i)

# TEMPORARY (issue #95): an index past the length aborts, as the old Array
# did, by reading it from a buffer with no elements — the runtime bounds
# check. To be replaced by an answer in the API that says the element is not
# there, as List's head does.
fun _noSuchIndex<T>(i: Int32): T
  ret _ArrayBuf<T>(0i32, 0i32, (j: Int32) => _noSuchIndex<T>(j))._items(i)

# `a` followed by `x`. In place when `a` owns the end of its buffer and there
# is room — the pin is the lock, against other appenders and the compactor —
# and into a fresh buffer of twice the size otherwise.
#
# NOTE (issue #95): named `_append`, not `append`, for now. A public `append`
# overload for Array beside List's makes every untyped parameter used only
# through `append` ambiguous, so its type can no longer be inferred (19 such
# parameters in the bootstrap alone). Appending goes through ArrayBuilder's
# `push` until those parameters are typed and this can become `append`.
fun _append<T>(a: Array<T>, x: T): Array<T>
  let held = pin(a._buf)
  let owns = held._used == a.length && held._used < held._cap
  if owns
    held._items(held._used) := x
    held._used := held._used + 1i32
  unpin(held)
  ret owns ? Array<T>(a.length + 1i32, held) : _appendCopy<T>(a, x)

fun _appendCopy<T>(a: Array<T>, x: T): Array<T>
  let n = a.length + 1i32
  ret Array<T>(n, _ArrayBuf<T>(n, n + n, (i: Int32) => i < a.length ? a[i] : x))


# ── combinators ──────────────────────────────────────────────────────────────
# The List combinators' Array overloads: same names, resolved by argument
# type, so a container migration is a type change at the call site.

fun isEmpty<T>(a: Array<T>): Bool
  ret a.length == 0i32

# In-order left fold over the elements.
fun fold<T, [linear] TAcc>(a: Array<T>, acc: TAcc, f: (acc: TAcc, x: T): TAcc): TAcc
  ret _foldFrom<T, TAcc>(a, 0i32, acc, f)

fun [tail] _foldFrom<T, [linear] TAcc>(a: Array<T>, i: Int32, acc: TAcc,
                              f: (acc: TAcc, x: T): TAcc): TAcc
  ret i < a.length ? _foldFrom<T, TAcc>(a, i + 1i32, f(acc, a[i]), f) : acc

# Element-wise transform; the result size is known exactly, so this is the
# tabulating ctor, not a builder.
fun map<T, TOut>(a: Array<T>, f: (x: T): TOut): Array<TOut>
  ret Array<TOut>(a.length, (i: Int32) => f(a[i]))

fun filter<T>(a: Array<T>, pred: (:T): Bool): Array<T>
  ret build<T>(_filterFrom<T>(a, 0i32, pred, arrayBuilder<T>(Int(a.length))))

fun [tail] _filterFrom<T>(a: Array<T>, i: Int32, pred: (:T): Bool,
                          [terminal] b: ArrayBuilder<T>): ArrayBuilder<T>
  ret i < a.length
    ? _filterFrom<T>(a, i + 1i32, pred, pred(a[i]) ? push<T>(b, a[i]) : b)
    : b

fun any<T>(a: Array<T>, pred: (:T): Bool): Bool
  ret _anyFrom<T>(a, 0i32, pred)

fun [tail] _anyFrom<T>(a: Array<T>, i: Int32, pred: (:T): Bool): Bool
  ret i < a.length && (pred(a[i]) || _anyFrom<T>(a, i + 1i32, pred))


# ── ArrayBuilder ─────────────────────────────────────────────────────────────
# Incremental construction by `_append`: an array with room for the estimate,
# pushed onto, and published by `build`. Linear, so every push extends the
# array the builder owns, in place until the room runs out.
class [linear,final] ArrayBuilder<T>(_arr: Array<T>)

fun arrayBuilder<T>(estimate: Int): ArrayBuilder<T>
  ret ArrayBuilder<T>(_emptyArray<T>(truncateToInt32(estimate < 1 ? 1 : estimate)))

fun push<T>([terminal] b: ArrayBuilder<T>, x: T): ArrayBuilder<T>
  ret ArrayBuilder<T>(_append(b._arr, x))

fun build<T>([terminal] b: ArrayBuilder<T>): Array<T>
  ret b._arr

# The failure-path counterpart of build: the array is ordinary garbage.
fun discard<T>([terminal] b: ArrayBuilder<T>): None
  ret _discarded<T>(b._arr)

fun _discarded<T>(_a: Array<T>): None
  ret None

# Drop: an abandoned builder — a failed parse alternative, an early exit — is
# discarded. [ambient]: the drops pass inserts plain `drop(x)` calls that must
# resolve in concrete user code without a spelled `where`.
instance [ambient]<T> Drop<ArrayBuilder<T>>
  fun drop(self: ArrayBuilder<T>): None
    ret discard<T>(self)
