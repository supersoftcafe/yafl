namespace System
import System


# ─── List<T>: an ordered sequence ────────────────────────────────────────────
#
# A List is a set of functions, not a shape. Build with List() / append /
# prepend / concat, take apart with isEmpty / first / head / tail, and walk
# with fold / map / filter or as a Stream (List<T> is itself the Stream
# state). Nothing outside this file knows how the elements are stored.
#
# HOW THEY ARE STORED. A list value is a by-value handle — four fields, so it
# flattens to a register-passed struct — onto a forward chain of SEGMENTS,
# each one heap object holding up to 16 elements inline:
#
#   * `_first` / `_start`: the first segment and the index of the first element
#   * `_last`  / `_end`:   the last segment and one past the last element
#
# Empty is both segments None. A list lying in one segment has `_first` and
# `_last` naming it (equal ordinals — see below). Between first and last,
# every segment is FULL: a segment is only ever linked behind one whose
# capacity is used up.
#
# A segment has spare room at the back (or, built by prepend, at the front).
# Appending to a list whose last element is the last one CLAIMED in that
# segment writes the next slot in place: O(1), no copy, no builder. The claim
# is taken under the segment's late pin (yafllib object.c, "List segments"),
# so of two list values sharing a segment only the FIRST to append extends
# it; the other finds the slot taken and copies. Every slot is written once,
# and a list value only ever reads slots written before it existed — so no
# program can observe which fork won, and List stays a pure value.
#
#   append / prepend      O(1); a FORK (a second append to the same value)
#                         copies — the whole list at the back, ≤ one segment
#                         at the front
#   head / first / tail   O(1), allocation-free
#   last                  O(1)
#   concat(a, b)          O(|b|): b's elements are appended onto a
#
# There is deliberately no indexing: a list is walked, not addressed (an Array
# is the indexed container). `size` counts, at segment rather than element
# granularity, but it is still a walk — ask isEmpty when that is the question.


# A segment. FIELD ORDER IS A RUNTIME CONTRACT: the claim word must be the
# first field and the ordinal the second (object.c reads them at fixed
# offsets), and lsNext must be the only pointer field before the array (its
# slot is the top bit of the pointer mask). lsClaim is runtime-private —
# YAFL code never reads it.
#
# lsOrd is a segment's identity within a list: appending a segment numbers it
# one up from the last, prepending one down from the first. Two segments of
# one list are the same segment exactly when their ordinals agree — which is
# how a walk knows it has reached `_last`, whichever copy of it (the GC may
# relocate a segment) it is holding.
class [final] ListSeg<T>(lsClaim: Int64, lsOrd: Int32, lsNext: ListSeg<T>|None,
                         length: Int32, array: T[length])

class [final] List<T>(_first: ListSeg<T>|None, _start: Int32,
                      _last: ListSeg<T>|None, _end: Int32)


# ─── Runtime primitives (yafllib object.c, "List segments") ──────────────────

# Fill in a FRESH segment's claim range, ordinal and next. `stored` threads
# the first element's store so it stays live and ordered first.
fun [foreign("list_seg_init"), impure, sync] _lsInit<T>(seg: ListSeg<T>, lo: Int32, hi: Int32,
      next: ListSeg<T>|None, ord: Int32, stored: Bool): ListSeg<T>

# Claim the slot after `end` / before `start`: the current copy, still pinned,
# or None if another list value claimed it first. Release after the store.
fun [foreign("list_seg_claim_back"), impure, sync] _lsClaimBack<T>(seg: ListSeg<T>,
      end: Int32): ListSeg<T>|None
fun [foreign("list_seg_claim_front"), impure, sync] _lsClaimFront<T>(seg: ListSeg<T>,
      start: Int32): ListSeg<T>|None
fun [foreign("list_seg_release"), impure, sync] _lsRelease<T>(seg: ListSeg<T>,
      stored: Bool): ListSeg<T>

# Link `next` behind a full segment: `next` on success, None if another list
# value got there first.
fun [foreign("list_seg_link"), impure, sync] _lsLink<T>(seg: ListSeg<T>, end: Int32,
      next: ListSeg<T>): ListSeg<T>|None

# The current copy of a segment reached through lsNext. A list value's own
# segment pointers are always good for its own elements; a `next` pointer is
# written once, when its target was brand new, so a walk resolves each
# segment it ENTERS (once per ≤ 16 elements, never per element).
fun [foreign("list_seg_resolve"), sync] _lsResolve<T>(seg: ListSeg<T>): ListSeg<T>


# ─── Internal helpers ────────────────────────────────────────────────────────

fun _lsStore<T>(s: ListSeg<T>, at: Int32, x: T): Bool
  ret __builtin_op__<bool>("array_builder_store", s, at, x)

# A fresh segment of capacity `cap` holding x at `at`.
fun _lsFresh<T>(cap: Int32, at: Int32, x: T, next: ListSeg<T>|None, ord: Int32): ListSeg<T>
  let s = __builtin_op__<ListSeg<T> >("array_builder_alloc", cap)
  ret _lsInit<T>(s, at, at + 1i32, next, ord, _lsStore<T>(s, at, x))

# Capacity ramp: 2, 3, 5, 8, 13, then 16 for ever — small lists stay small,
# long ones settle at the largest allocation unit that is still GC-friendly.
fun _lsNextCap(cap: Int32): Int32
  ret cap < 2i32 ? 2i32
    : cap == 2i32 ? 3i32
    : cap == 3i32 ? 5i32
    : cap == 5i32 ? 8i32
    : cap == 8i32 ? 13i32
    : 16i32

fun _lsSame<T>(a: ListSeg<T>, b: ListSeg<T>): Bool
  ret a.lsOrd == b.lsOrd

fun _lsWhole<T>(s: ListSeg<T>, start: Int32, end: Int32): List<T>
  ret List<T>(s, start, s, end)


# ─── Construction ────────────────────────────────────────────────────────────

fun List<T>(): List<T>
  ret List<T>(None, 0i32, None, 0i32)

# Add an element at the back. O(1); see the header for forks.
fun append<T>(l: List<T>, x: T): List<T>
  ret match(l._last)
    (last: ListSeg<T>) => l._end < last.length
      ? _appendClaim<T>(l, last, x, _lsClaimBack<T>(last, l._end))
      : _appendGrow<T>(l, last, x)
    (nil: None) => _lsWhole<T>(_lsFresh<T>(2i32, 0i32, x, None, 0i32), 0i32, 1i32)

fun _appendClaim<T>(l: List<T>, last: ListSeg<T>, x: T, claim: ListSeg<T>|None): List<T>
  ret match(claim)
    (o: ListSeg<T>) => _appended<T>(l, last, _lsRelease<T>(o, _lsStore<T>(o, l._end, x)))
    (nil: None)     => _appendCopy<T>(l, x)

# The slot is someone else's: rebuild, then append to the private copy.
fun _appendCopy<T>(l: List<T>, x: T): List<T>
  ret append<T>(_copy<T>(l), x)

# `o` is the current copy of the last segment; a one-segment list's first
# moves with it, so first and last keep naming the same copy.
fun _appended<T>(l: List<T>, last: ListSeg<T>, o: ListSeg<T>): List<T>
  ret match(l._first)
    (f: ListSeg<T>) => _lsSame<T>(f, last)
      ? List<T>(o, l._start, o, l._end + 1i32)
      : List<T>(f, l._start, o, l._end + 1i32)
    (nil: None)     => List<T>(o, l._start, o, l._end + 1i32)

fun _appendGrow<T>(l: List<T>, last: ListSeg<T>, x: T): List<T>
  let seg = _lsFresh<T>(_lsNextCap(last.length), 0i32, x, None, last.lsOrd + 1i32)
  ret match(_lsLink<T>(last, l._end, seg))
    (s2: ListSeg<T>) => List<T>(l._first, l._start, s2, 1i32)
    (nil: None)      => _appendCopy<T>(l, x)

# Add an element at the front. O(1); a fork copies at most one segment.
fun prepend<T>(x: T, l: List<T>): List<T>
  ret match(l._first)
    (f: ListSeg<T>) => l._start > 0i32
      ? _prependClaim<T>(x, l, f, _lsClaimFront<T>(f, l._start))
      : _prependGrow<T>(x, l, f)
    (nil: None) => _lsWhole<T>(_lsFresh<T>(2i32, 1i32, x, None, 0i32), 1i32, 2i32)

fun _prependClaim<T>(x: T, l: List<T>, f: ListSeg<T>, claim: ListSeg<T>|None): List<T>
  ret match(claim)
    (o: ListSeg<T>) => _prepended<T>(l, f, _lsRelease<T>(o, _lsStore<T>(o, l._start - 1i32, x)))
    (nil: None)     => _prependCopy<T>(x, l, f)

fun _prepended<T>(l: List<T>, f: ListSeg<T>, o: ListSeg<T>): List<T>
  ret match(l._last)
    (last: ListSeg<T>) => _lsSame<T>(f, last)
      ? List<T>(o, l._start - 1i32, o, l._end)
      : List<T>(o, l._start - 1i32, last, l._end)
    (nil: None) => List<T>(o, l._start - 1i32, o, l._end)

# No room in front of the first element: a new segment ahead of it, filled
# from its back so later prepends claim downwards.
fun _prependGrow<T>(x: T, l: List<T>, f: ListSeg<T>): List<T>
  let cap = _lsNextCap(f.length)
  let seg = _lsFresh<T>(cap, cap - 1i32, x, f, f.lsOrd - 1i32)
  ret List<T>(seg, cap - 1i32, l._last, l._end)

# The front slot is someone else's: copy the first segment's live part
# behind x and keep the rest of the chain. The copy is full (no slack), so it
# is a valid interior segment when the list grows past it.
fun _prependCopy<T>(x: T, l: List<T>, f: ListSeg<T>): List<T>
  ret match(l._last)
    (last: ListSeg<T>) => _lsSame<T>(f, last)
      ? _prependCopied<T>(x, f, l._start, l._end, None, f.lsOrd, None, 0i32)
      : _prependCopied<T>(x, f, l._start, f.length, f.lsNext, f.lsOrd, last, l._end)
    (nil: None) => l

# `last`/`end` are the list's own when the copy is not the last segment;
# None when it is (the copy then becomes the last too).
fun _prependCopied<T>(x: T, f: ListSeg<T>, start: Int32, lim: Int32,
                      next: ListSeg<T>|None, ord: Int32,
                      last: ListSeg<T>|None, end: Int32): List<T>
  let n = lim - start + 1i32
  let s = __builtin_op__<ListSeg<T> >("array_builder_alloc", n)
  let s2 = _lsInit<T>(s, 0i32, n, next, ord,
                      _lsCopyInto<T>(s, 1i32, f, start, lim, _lsStore<T>(s, 0i32, x)))
  ret match(last)
    (l2: ListSeg<T>) => List<T>(s2, 0i32, l2, end)
    (nil: None)      => List<T>(s2, 0i32, s2, n)

fun [tail] _lsCopyInto<T>(dst: ListSeg<T>, at: Int32, src: ListSeg<T>, i: Int32, lim: Int32,
                          ok: Bool): Bool
  ret i < lim
    ? _lsCopyInto<T>(dst, at + 1i32, src, i + 1i32, lim, ok && _lsStore<T>(dst, at, src.array(i)))
    : ok

# A private copy: every claim on it is free.
fun _copy<T>(l: List<T>): List<T>
  ret concat<T>(List<T>(), l)

# Every element of `a` then every element of `b`. O(|b|): b's elements are
# appended onto a (in place when a's spare room is unclaimed).
fun concat<T>(a: List<T>, b: List<T>): List<T>
  fun [tail] go(acc: List<T>, c: List<T>): List<T>
    ret isEmpty<T>(c) ? acc : go(append<T>(acc, first<T>(c)), tail<T>(c))
  ret isEmpty<T>(a) ? (isEmpty<T>(b) ? a : go(a, b)) : go(a, b)

# Push every element of `l` onto `acc`, in order. (concat, named for the
# accumulate-loop call sites that read better as "add these".)
fun appendAll<T>(acc: List<T>, l: List<T>): List<T>
  ret concat<T>(acc, l)


# ─── Taking apart ────────────────────────────────────────────────────────────

fun [inline(always)] isEmpty<T>(l: List<T>): Bool
  ret match(l._first)
    (f: ListSeg<T>) => false
    (nil: None)     => true

# The first element, or None when empty.
fun head<T>(l: List<T>): T|None
  ret match(l._first)
    (f: ListSeg<T>) => f.array(l._start)
    (nil: None)     => None

# The first element of a list KNOWN to be non-empty — test isEmpty first. On
# an empty list it aborts (an array bounds failure): there is no T to return.
fun [inline(always)] first<T>(l: List<T>): T
  ret match(l._first)
    (f: ListSeg<T>) => f.array(l._start)
    (nil: None)     => __builtin_op__<ListSeg<T> >("array_builder_alloc", 0i32).array(0i32)

# Everything after the first element. O(1), allocation-free; the empty list's
# tail is the empty list.
fun [inline(always)] tail<T>(l: List<T>): List<T>
  ret match(l._first)
    (f: ListSeg<T>) => match(l._last)
      (last: ListSeg<T>) => _lsSame<T>(f, last)
        ? (l._start + 1i32 < l._end
            ? List<T>(f, l._start + 1i32, last, l._end)
            : List<T>())
        : (l._start + 1i32 < f.length
            ? List<T>(f, l._start + 1i32, last, l._end)
            : _lsHop<T>(f, last, l._end))
      (nil: None) => l
    (nil: None) => l

# Cross from a full segment into the next one, resolving it once.
fun _lsHop<T>(f: ListSeg<T>, last: ListSeg<T>, end: Int32): List<T>
  ret match(f.lsNext)
    (n: ListSeg<T>) => _lsEnter<T>(_lsResolve<T>(n), last, end)
    (nil: None)     => List<T>()     # unreachable: an interior segment is linked

# Entering the last segment switches to the list's own pointer for it, so
# first and last name the same copy (and its ordinal) from here on.
fun _lsEnter<T>(n: ListSeg<T>, last: ListSeg<T>, end: Int32): List<T>
  ret _lsSame<T>(n, last) ? List<T>(last, 0i32, last, end) : List<T>(n, 0i32, last, end)

# The last element, or None when empty. O(1).
fun last<T>(l: List<T>): T|None
  ret match(l._last)
    (s: ListSeg<T>) => s.array(l._end - 1i32)
    (nil: None)     => None

# How many elements. O(segments) — it adds up segment fills rather than
# stepping through elements — but still a walk: ask isEmpty when that is the
# real question.
fun size<T>(l: List<T>): Int
  ret match(l._first)
    (f: ListSeg<T>) => match(l._last)
      (last: ListSeg<T>) => _lsSame<T>(f, last)
        ? Int(l._end - l._start)
        : _lsSizeFrom<T>(f, l._start, last, l._end, 0)
      (nil: None) => 0
    (nil: None) => 0

fun [tail] _lsSizeFrom<T>(s: ListSeg<T>, from: Int32, last: ListSeg<T>, end: Int32,
                          acc: Int): Int
  ret match(s.lsNext)
    (n: ListSeg<T>) => _lsSame<T>(n, last)
      ? acc + Int(s.length - from) + Int(end)
      : _lsSizeFrom<T>(_lsResolve<T>(n), 0i32, last, end, acc + Int(s.length - from))
    (nil: None) => acc + Int(s.length - from)   # unreachable: interior segments link

# Allocation-free uncons: the first element (None when empty) and the rest.
fun uncons<T>(l: List<T>): (head: T|None, rest: List<T>)
  ret (head = head<T>(l), rest = tail<T>(l))


# ─── Iteration ───────────────────────────────────────────────────────────────

# A List is its own Stream state: `next` is first + tail, and an empty list
# is the end. E = Never — an in-memory source cannot fail.
instance<T> Stream<List<T>, T, Never>
  fun [inline(always)] next(self: List<T>): (stream: List<T>, value: Result<T | None, Never>)
    ret isEmpty<T>(self)
      ? (self, Ok<T | None, Never>(None))
      : (tail<T>(self), Ok<T | None, Never>(first<T>(self)))

fun fold<T,U>(l: List<T>, init: U, f: (:U, :T): U): U
  fun [tail] go(c: List<T>, acc: U): U
    ret isEmpty<T>(c) ? acc : go(tail<T>(c), f(acc, first<T>(c)))
  ret go(l, init)

fun map<T,U>(l: List<T>, f: (:T): U): List<U>
  fun [tail] go(acc: List<U>, c: List<T>): List<U>
    ret isEmpty<T>(c) ? acc : go(append<U>(acc, f(first<T>(c))), tail<T>(c))
  ret go(List<U>(), l)

# map, preserving identity: when every f(x) is bit-identical to x (yafl_same,
# the `with` expression's guard), the result IS `l` — the same value, no
# allocation — so an identity-preserving rewrite can propagate "nothing
# changed" up through list fields. Otherwise the unchanged prefix is copied
# once and the rest mapped; f runs exactly once per element either way.
fun mapSame<T>(l: List<T>, f: (:T): T): List<T>
  # `c` is non-empty and `y` is f of its first element.
  fun [tail] scan(c: List<T>, i: Int, y: T): List<T>
    ret __builtin_op__<bool>("yafl_same", y, first<T>(c))
      ? (isEmpty<T>(tail<T>(c)) ? l : scan(tail<T>(c), i + 1, f(first<T>(tail<T>(c)))))
      : _mapRest<T>(append<T>(take<T>(l, i), y), tail<T>(c), f)
  ret isEmpty<T>(l) ? l : scan(l, 0, f(first<T>(l)))

fun [tail] _mapRest<T>(acc: List<T>, c: List<T>, f: (:T): T): List<T>
  ret isEmpty<T>(c) ? acc : _mapRest<T>(append<T>(acc, f(first<T>(c))), tail<T>(c), f)

fun filter<T>(l: List<T>, f: (:T): Bool): List<T>
  fun [tail] go(acc: List<T>, c: List<T>): List<T>
    ret isEmpty<T>(c) ? acc
      : go(f(first<T>(c)) ? append<T>(acc, first<T>(c)) : acc, tail<T>(c))
  ret go(List<T>(), l)

# True if any / every element satisfies `pred`; both stop at the answer.
fun any<T>(l: List<T>, pred: (:T): Bool): Bool
  fun [tail] go(c: List<T>): Bool
    ret isEmpty<T>(c) ? false : pred(first<T>(c)) ? true : go(tail<T>(c))
  ret go(l)

fun all<T>(l: List<T>, pred: (:T): Bool): Bool
  fun [tail] go(c: List<T>): Bool
    ret isEmpty<T>(c) ? true : pred(first<T>(c)) ? go(tail<T>(c)) : false
  ret go(l)

# Membership test, for any element type with an equality instance.
fun contains<T>(l: List<T>, x: T): Bool where BasicEquality<T>
  ret any<T>(l, (y: T) => y == x)

# Map each element to a list and concatenate the results, in order. Linear:
# each result is appended onto the accumulator in place.
fun flatMap<T,U>(l: List<T>, f: (:T): List<U>): List<U>
  ret fold<T, List<U> >(l, List<U>(), (acc: List<U>, x: T) => concat<U>(acc, f(x)))

# First `n` elements (fewer if the list is shorter); `n <= 0` gives the empty
# list. Counterpart `drop` discards them. Order is preserved.
fun take<T>(l: List<T>, n: Int): List<T>
  fun [tail] go(acc: List<T>, c: List<T>, k: Int): List<T>
    ret k <= 0 || isEmpty<T>(c) ? acc : go(append<T>(acc, first<T>(c)), tail<T>(c), k - 1)
  ret go(List<T>(), l, n)

fun [tail] drop<T>(l: List<T>, n: Int): List<T>
  ret n <= 0 || isEmpty<T>(l) ? l : drop<T>(tail<T>(l), n - 1)

# Split a list into two near-equal halves, `left` the leading elements and
# `right` the trailing ones (left = floor(n/2)); for n >= 2 both are non-empty.
# The length-free way to divide work for recursion or `__parallel__`: the
# right half shares the list's own segments, only the left is copied.
fun splitHalf<T>(l: List<T>): (left: List<T>, right: List<T>)
  fun [tail] go(acc: List<T>, slow: List<T>, fast: List<T>): (left: List<T>, right: List<T>)
    ret isEmpty<T>(fast) || isEmpty<T>(tail<T>(fast))
      ? (left = acc, right = slow)
      : go(append<T>(acc, first<T>(slow)), tail<T>(slow), tail<T>(tail<T>(fast)))
  ret go(List<T>(), l, l)


# ─── Co-walks: two lists advanced in step ────────────────────────────────────

# Element-wise equality under a caller-supplied comparator: the same elements,
# in the same order, and neither list longer than the other.
fun eqBy<T>(a: List<T>, b: List<T>, same: (:T, :T): Bool): Bool
  fun [tail] walk(x: List<T>, y: List<T>): Bool
    ret isEmpty<T>(x) ? isEmpty<T>(y)
      : isEmpty<T>(y) ? false
      : same(first<T>(x), first<T>(y)) && walk(tail<T>(x), tail<T>(y))
  ret walk(a, b)

# Pairwise map, stopping at the shorter list. The ragged tail is DISCARDED.
fun zipMap<A, B, C>(a: List<A>, b: List<B>, f: (:A, :B): C): List<C>
  fun [tail] walk(acc: List<C>, x: List<A>, y: List<B>): List<C>
    ret isEmpty<A>(x) || isEmpty<B>(y) ? acc
      : walk(append<C>(acc, f(first<A>(x), first<B>(y))), tail<A>(x), tail<B>(y))
  ret walk(List<C>(), a, b)


# Index of the first element satisfying `pred`, or None when no element
# matches.
fun findIndex<T>(l: List<T>, pred: (:T): Bool): Int|None
  fun [tail] go(c: List<T>, i: Int): Int|None
    ret isEmpty<T>(c) ? None : pred(first<T>(c)) ? i : go(tail<T>(c), i + 1)
  ret go(l, 0)


# Split `l` into `(yes, no)` by `pred`.  Order is preserved within each
# output list.
fun partition<T>(l: List<T>, pred: (:T): Bool): (yes: List<T>, no: List<T>)
  ret (yes = filter<T>(l, pred), no = filter<T>(l, (x: T) => !pred(x)))


# Group elements by `key(x)`.  Entries appear in original list order
# within each group: each group is `filter`ed straight out of the list.
fun _groupFor<K,T>(l: List<T>, key: (:T): K, k: K): List<T> where BasicEquality<K>
  ret filter<T>(l, (x: T) => key(x) == k)

fun groupBy<T,K>(l: List<T>, key: (:T): K): Dict<K,List<T> > where BasicEquality<K>
  ret fold<K, Dict<K,List<T> > >(
        fold<K, Set<K> >(map<T,K>(l, key), Set<K>(), (s: Set<K>, k: K) => add<K>(s, k)),
        Dict<K,List<T> >(),
        (acc: Dict<K,List<T> >, k: K) =>
          put<K,List<T> >(acc, k, _groupFor<K,T>(l, key, k)))


# ─── Sort ───────────────────────────────────────────────────────────────────
#
# Stable natural mergesort in which every run and every merge is produced
# ASCENDING, so there is no direction bookkeeping and nothing is reversed.
# The seed pass cuts the input into maximal ordered stretches (sorted input is
# ONE run and the merge phase vanishes); merges append in order.
#
# Stability: ties take from the EARLIER run. The merge pops `a` unless `b` is
# STRICTLY less, and the run queue is built in order.

fun sort<T>(l: List<T>): List<T> where BasicCompare<T>
  ret sortBy<T>(l, (a: T, b: T) => a < b)

# `less` must be a STRICT ordering: true iff its first argument precedes its
# second. Ties — neither less(a,b) nor less(b,a) — keep their original order.
fun sortBy<T>(l: List<T>, less: (:T, :T): Bool): List<T>
  ret _mergeUntilOne<T>(_seedAll<T>(l, less), less)

# A run continues while the next element is NOT strictly less than the
# previous one — equal keeps it going, which is what makes a run of ties
# stable — and a descent closes it.
fun _seedAll<T>(l: List<T>, less: (:T, :T): Bool): List<List<T> >
  ret isEmpty<T>(l) ? List<List<T> >()
    : _seedLoop<T>(append<T>(List<T>(), first<T>(l)), List<List<T> >(),
                   tail<T>(l), less, first<T>(l))

fun [tail] _seedLoop<T>(run: List<T>, runs: List<List<T> >, c: List<T>,
                        less: (:T, :T): Bool, prev: T): List<List<T> >
  ret isEmpty<T>(c) ? append<List<T> >(runs, run)
    : less(first<T>(c), prev)
      # descent: close this run and start the next at first(c)
      ? _seedLoop<T>(append<T>(List<T>(), first<T>(c)), append<List<T> >(runs, run),
                     tail<T>(c), less, first<T>(c))
      : _seedLoop<T>(append<T>(run, first<T>(c)), runs, tail<T>(c), less, first<T>(c))

fun [tail] _mergeUntilOne<T>(runs: List<List<T> >, less: (:T, :T): Bool): List<T>
  ret isEmpty<List<T> >(runs) ? List<T>()
    : isEmpty<List<T> >(tail<List<T> >(runs)) ? first<List<T> >(runs)
    : _mergeUntilOne<T>(_mergePairs<T>(List<List<T> >(), runs, less), less)

# An odd trailing run passes through untouched.
fun [tail] _mergePairs<T>(acc: List<List<T> >, runs: List<List<T> >,
                          less: (:T, :T): Bool): List<List<T> >
  ret isEmpty<List<T> >(runs) ? acc
    : isEmpty<List<T> >(tail<List<T> >(runs)) ? append<List<T> >(acc, first<List<T> >(runs))
    : _mergePairs<T>(append<List<T> >(acc, _merge2<T>(first<List<T> >(runs),
                                                      first<List<T> >(tail<List<T> >(runs)), less)),
                     tail<List<T> >(tail<List<T> >(runs)), less)

fun _merge2<T>(a: List<T>, b: List<T>, less: (:T, :T): Bool): List<T>
  ret _mergeInto<T>(List<T>(), a, b, less)

# Pops `a` unless `b` is STRICTLY less — so a tie takes the earlier run's
# element first, which is the whole of stability.
fun [tail] _mergeInto<T>(out: List<T>, a: List<T>, b: List<T>,
                         less: (:T, :T): Bool): List<T>
  ret isEmpty<T>(a) ? concat<T>(out, b)
    : isEmpty<T>(b) ? concat<T>(out, a)
    : less(first<T>(b), first<T>(a))
      ? _mergeInto<T>(append<T>(out, first<T>(b)), a, tail<T>(b), less)
      : _mergeInto<T>(append<T>(out, first<T>(a)), tail<T>(a), b, less)


# ─── Migration shims — to be removed ─────────────────────────────────────────
# The ListBuilder spellings, now plain List operations. Kept only while call
# sites move over; nothing new should use them.
fun push<T>(l: List<T>, x: T): List<T>
  ret append<T>(l, x)

fun build<T>(l: List<T>): List<T>
  ret l

fun pushAll<T>(l: List<T>, more: List<T>): List<T>
  ret concat<T>(l, more)

fun discard<T>(l: List<T>): None
  ret None
