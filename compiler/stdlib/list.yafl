namespace System
import System


# A bare cons chain: the zero-overhead CONSUMPTION view of a sequence.
# List<T> below is the BUILDING structure (O(1) at both ends, paid for with a
# wrapper allocation per operation — element-at-a-time consumption through
# head/tail churns one wrapper per step). Code that walks a sequence should
# take a Chain once (see `chain` below) and match ChainLink/ChainEnd
# directly: nothing is allocated per step, and whatever the walk builds packs
# densely instead of interleaving with wrapper garbage. fold and sort already
# work this way internally.
enum Chain<T>
  enum ChainEnd()
  enum ChainLink(value: T, next: Chain<T>)


# Public list: ONE chain, in traversal order.
#
# There was a rear chain, holding appended elements in reverse. It made
# append O(1), and it made every walk pay to put the elements back in order —
# `chain()` materialised front ++ reverse(rear), and map/filter/fold each
# reversed too. That normalisation was the ONLY reason _chainReverse existed.
#
# A List is now constructed in the order it will be walked, so walking it is
# just walking it. Build with ListBuilder (in order, O(1) per push) or prepend
# (the cons). `append` survives as a convenience and is O(n): it rebuilds.
# Reach for a builder in a loop.
enum List<T>
  enum ListEmpty()
  enum ListFull(front: Chain<T>)


# ─── Internal helpers ────────────────────────────────────────────────────────

fun _chainHead<T>(n: Chain<T>): T|None
  ret match(n)
    (nil: ChainEnd) => None
    (c: ChainLink)  => c.value


# A chain as a List. O(1) — the chain IS the list.
fun _listOf<T>(c: Chain<T>): List<T>
  ret match(c)
    (nil: ChainEnd) => ListEmpty<T>()
    (l: ChainLink)  => ListFull<T>(c)


# ─── Public API ──────────────────────────────────────────────────────────────

fun List<T>(): List<T>
  ret ListEmpty<T>()


# The list's elements as a Chain, in traversal order. Zero-copy when no
# appends are pending (the front IS the chain); otherwise materialised once —
# the reversed rear becomes the tail and the front is copied onto it (≤ n
# cells, one-off) — after which the walk itself allocates nothing.
fun chain<T>(l: List<T>): Chain<T>
  ret match(l)
    (e: ListEmpty) => ChainEnd<T>()
    (fl: ListFull) => fl.front


# A List over an existing chain: O(1), the chain becomes the front.
fun List<T>(c: Chain<T>): List<T>
  ret _listOf<T>(c)


# Allocation-free uncons: the first element (None when exhausted) and the
# remaining chain, returned by value. The Chain itself can be matched
# directly inside generic code; from non-generic code use this. (Matching a
# CONCRETE Chain<X>'s variants from outside currently mistypes the binder's
# fields as the enum's placeholders — a known generics gap.)
fun chainNext<T>(c: Chain<T>): (head: T|None, rest: Chain<T>)
  ret match(c)
    (link: ChainLink) => (head=link.value, rest=link.next)
    (e: ChainEnd)     => (head=None, rest=c)


# Number of elements in a chain: O(n), allocation-free.
fun chainLength<T>(c: Chain<T>): Int
  fun [tail] walk(n: Chain<T>, acc: Int): Int
    ret match(n)
      (link: ChainLink) => walk(link.next, acc + 1)
      (e: ChainEnd)     => acc
  ret walk(c, 0)


# Add element to the front: O(1)
fun prepend<T>(x: T, l: List<T>): List<T>
  ret ListFull<T>(ChainLink<T>(x, chain<T>(l)))


# There is no `append`. This List is a CONS CHAIN, stored in the order it is
# walked, so putting an element at the BACK means the last cell must point at
# the new one — and mutating it would be visible to every sharer, so the spine
# is copied. O(n) per call, O(n^2) in a loop.
#
# That is a property of THIS REPRESENTATION, not of immutability. A tree-backed
# sequence (finger tree, 2-3 tree) gives O(1) amortised append AND prepend,
# fully persistent, no mutation and no linearity proof. It is the standard
# answer, and it is not the answer here: the compiler's dominant access pattern
# is the sequential walk, where a cons chain is one pointer per step and a tree
# is a descent plus per-node overhead on every element. We would be paying the
# walk to speed up the build.
#
# ListBuilder escapes the copy a different way: [linear] PROVES there are no
# sharers, so it writes the tail cell in place — O(1) push, and the result is
# an ordinary immutable chain the moment build() hands it over.
#
# So: build with a ListBuilder (in order, O(1) per push), or prepend (the cons),
# or ask whether the thing wants to be a List at all — a Bag or a Set has no
# order to maintain and no end to append to.


fun head<T>(l: List<T>): T|None
  ret match(l)
    (e: ListEmpty) => None
    (fl: ListFull) => _chainHead<T>(fl.front)


fun tail<T>(l: List<T>): List<T>
  ret match(chain<T>(l))
    (nil: ChainEnd) => ListEmpty<T>()
    (c: ChainLink)  => _listOf<T>(c.next)


# O(1) emptiness test. There is deliberately no `length`: a list is a sequence,
# not an indexable buffer, and asking for its size invites the O(n) `length == 0`
# / index-by-count patterns that walk the whole list. Match on the structure
# (`head`/`tail`/`isEmpty`), fold to a count when you genuinely need one, or use
# `splitHalf` to divide for parallel/recursive work.
fun isEmpty<T>(l: List<T>): Bool
  ret match(l)
    (e: ListEmpty) => true
    (fl: ListFull) => false


# Last element, or None when empty. O(1) when the list has pending appends (the
# rear holds them newest-first, so its head is the true last element); otherwise
# O(n), walking to the end of the front.
fun last<T>(l: List<T>): T|None
  fun [tail] lastNode(n: Chain<T>): T|None
    ret match(n)
      (nil: ChainEnd) => None
      (c: ChainLink)  => match(c.next)
        (next: ChainLink) => lastNode(c.next)
        (e: ChainEnd)     => c.value
  ret lastNode(chain<T>(l))


# Concatenate two lists, preserving order: every element of `a` then every
# element of `b`. O(length b) — each of b's elements is appended onto `a`.
# foldRev is GONE. It existed to walk a list newest-first without paying for
# the rear's reversal; with one in-order chain there is no cheap reverse walk,
# and a function whose whole purpose is "these elements, backwards" is the
# thing this design set out to remove. Fold in order, or name an ordering
# with sortBy.

fun concat<T>(a: List<T>, b: List<T>): List<T>
  ret build<T>(_pushChain<T>(_pushChain<T>(builder<T>(), chain<T>(a)), chain<T>(b)))


# First `n` elements (fewer if the list is shorter); `n <= 0` gives the empty
# list. Counterpart `drop` discards them. Order is preserved.
fun take<T>(l: List<T>, n: Int): List<T>
  ret build<T>(_takeInto<T>(builder<T>(), chain<T>(l), n))

fun [tail] _takeInto<T>([terminal] b: ListBuilder<T>, c: Chain<T>, k: Int): ListBuilder<T>
  ret k <= 0 ? b
    : match(c)
        (nil: ChainEnd) => b
        (l2: ChainLink) => _takeInto<T>(push<T>(b, l2.value), l2.next, k - 1)

fun [tail] drop<T>(l: List<T>, n: Int): List<T>
  ret n <= 0 ? l
    : match(head<T>(l))
        (h: T)    => drop<T>(tail<T>(l), n - 1)
        (e: None) => l


# Split a list into two near-equal halves in a single pass, WITHOUT computing a
# length: a slow pointer advances one element for every two the fast pointer
# takes, so when the fast pointer reaches the end the slow one is at the middle.
# `left` keeps the leading elements in order, `right` the trailing ones. For a
# list of n >= 2 both halves are non-empty (left = floor(n/2)); this is the
# length-free way to divide work for recursion or `__parallel__`.
# [tail]: the walk advances one element per step, so on a long list it MUST
# lower to a loop — plain recursion here overflows the C stack via the async
# hot path (found by sorting a half-million-word dictionary).
fun [tail] _splitWalk<T>([terminal] acc: ListBuilder<T>, slow: List<T>,
                         fast: List<T>): (left: ListBuilder<T>, right: List<T>)
  ret match(head<T>(slow))
    (s: T) => isEmpty<T>(fast) || isEmpty<T>(tail<T>(fast))
        ? (left=acc, right=slow)
        : _splitWalk<T>(push<T>(acc, s), tail<T>(slow), tail<T>(tail<T>(fast)))
    (e: None) => (left=acc, right=slow)

fun splitHalf<T>(l: List<T>): (left: List<T>, right: List<T>)
  ret _splitWalk<T>(builder<T>(), l, l)
    |> (left, right) => (left = build<T>(left), right = right)


# True if any / every element satisfies `pred`. Both fold the whole list, but the
# short-circuiting `||`/`&&` skip `pred` once the answer is settled.
fun any<T>(l: List<T>, pred: (:T): Bool): Bool
  ret fold<T, Bool>(l, false, (acc: Bool, x: T) => acc || pred(x))

fun all<T>(l: List<T>, pred: (:T): Bool): Bool
  ret fold<T, Bool>(l, true, (acc: Bool, x: T) => acc && pred(x))


# Membership test, for any element type with an equality instance.
fun contains<T>(l: List<T>, x: T): Bool where BasicEquality<T>
  ret any<T>(l, (y: T) => y == x)


# Map each element to a list and concatenate the results, in order.
fun flatMap<T,U>(l: List<T>, f: (:T): List<U>): List<U>
  ret fold<T, List<U> >(l, List<U>(), (acc: List<U>, x: T) => concat<U>(acc, f(x)))




# map/filter walk FORWARD and push into a ListBuilder, so the result is built
# in the order it will be read. They used to walk in reverse — rear as stored,
# then the reversed front — and prepend, which arrived at forward order the
# long way round; with one in-order chain there is no rear to walk and nothing
# to reverse.
#
# Both are [tail] over the chain: per-element ChainLink recursion put one C
# frame on the stack per element and overflowed a standard 8MB stack on
# compiler-sized lists (an -O3 mega-function's label index).
fun map<T,U>(l: List<T>, f: (:T): U): List<U>
  ret build<U>(_mapInto<T,U>(builder<U>(), chain<T>(l), f))

fun [tail] _mapInto<T,U>([terminal] b: ListBuilder<U>, c: Chain<T>,
                         f: (:T): U): ListBuilder<U>
  ret match(c)
    (nil: ChainEnd) => b
    (l: ChainLink)  => _mapInto<T,U>(push<U>(b, f(l.value)), l.next, f)


fun filter<T>(l: List<T>, f: (:T): Bool): List<T>
  ret build<T>(_filterInto<T>(builder<T>(), chain<T>(l), f))

fun [tail] _filterInto<T>([terminal] b: ListBuilder<T>, c: Chain<T>,
                          f: (:T): Bool): ListBuilder<T>
  ret match(c)
    (nil: ChainEnd) => b
    (l: ChainLink)  => _filterInto<T>(f(l.value) ? push<T>(b, l.value) : b,
                                      l.next, f)


fun fold<T,U>(l: List<T>, init: U, f: (:U, :T): U): U
  fun [tail] foldNode(n: Chain<T>, acc: U): U
    ret match(n)
      (nil: ChainEnd) => acc
      (c: ChainLink)  => foldNode(c.next, f(acc, c.value))
  ret foldNode(chain<T>(l), init)


# Index of the first element satisfying `pred`, or None when no element
# matches.  Always traverses the full list — once `found` is set the
# step short-circuits to a pass-through.
fun findIndex<T>(l: List<T>, pred: (:T): Bool): Int|None
  fun step(acc: (idx: Int, found: Int|None), x: T): (idx: Int, found: Int|None)
    ret match(acc.found)
      (i: Int)  => acc
      (n: None) => pred(x)
        ? (idx=acc.idx + 1, found=acc.idx)
        : (idx=acc.idx + 1, found=None)
  let r = fold<T, (idx: Int, found: Int|None)>(l, (idx=0, found=None), step)
  ret r.found


# Split `l` into `(yes, no)` by `pred`.  Order is preserved within each
# output list.
fun partition<T>(l: List<T>, pred: (:T): Bool): (yes: List<T>, no: List<T>)
  ret (yes = filter<T>(l, pred), no = filter<T>(l, (x: T) => !pred(x)))


# Group elements by `key(x)`.  Entries appear in original list order
# within each group.
# Each group is `filter`ed straight out of the original list, so it is in list
# order BY CONSTRUCTION — no per-group accumulator to append to. A ListBuilder
# cannot live in a Dict (it is [linear]) and prepending would need a reversal
# at the end, which is precisely what this design removes.
fun _groupFor<K,T>(l: List<T>, key: (:T): K, k: K): List<T> where BasicEquality<K>
  ret filter<T>(l, (x: T) => key(x) == k)

fun groupBy<T,K>(l: List<T>, key: (:T): K): Dict<K,List<T> > where BasicEquality<K>
  ret fold<K, Dict<K,List<T> > >(
        _chainToSet<K>(chain<K>(map<T,K>(l, key)), Set<K>()),
        Dict<K,List<T> >(),
        (acc: Dict<K,List<T> >, k: K) =>
          put<K,List<T> >(acc, k, _groupFor<K,T>(l, key, k)))


# ─── Sort ───────────────────────────────────────────────────────────────────
#
# Stable natural mergesort in which every run and every merge is produced
# ASCENDING, so there is no direction bookkeeping, no ping-pong, and nothing
# is ever reversed.
#
#   * NATURAL RUNS: the seed pass still cuts the input into maximal ordered
#     stretches, so sorted OR reverse-sorted input is ONE run and the merge
#     phase vanishes. An ASCENDING stretch is collected with a ListBuilder
#     (O(1) in-order push). A DESCENDING stretch is collected by PREPENDING,
#     which yields it ascending for free — consing, not a reversal: there is
#     no function here whose job is "these elements, backwards".
#   * MERGES BUILD IN ORDER: the old design alternated direction every pass
#     because a [tail] merge could only prepend, which reverses. ListBuilder
#     gives O(1) append, so a merge emits ascending directly — and with that
#     premise gone, so is the final flip.
#
# Stability: ties take from the EARLIER run. The merge pops `a` unless `b` is
# STRICTLY less, and the run queue is built in order, so "earlier" keeps
# meaning what it says.

fun sort<T>(l: List<T>): List<T> where BasicCompare<T>
  ret sortBy<T>(l, (a: T, b: T) => a < b)

# `less` must be a STRICT ordering: true iff its first argument precedes its
# second. Ties — neither less(a,b) nor less(b,a) — keep their original order.
fun sortBy<T>(l: List<T>, less: (:T, :T): Bool): List<T>
  ret _mergeUntilOne<T>(_seedAll<T>(chain<T>(l), less), less)


# ── seed: cut into maximal ASCENDING stretches ───────────────────────────────
# Runs are appended in encounter order, because "earlier run" is what makes
# the merge stable. A run continues while the next element is NOT strictly
# less than the previous one — equal keeps it going, which is what makes a run
# of ties stable — and a descent closes it.
#
# ONE self-recursive function, because [tail] requires DIRECT self-recursion
# and the seed must be [tail]: a long list would otherwise recurse on the C
# stack. That constraint costs the old design's reverse-sorted special case.
# It used to collect a descending stretch and reverse it, turning
# reverse-sorted input into one run (O(n)); collecting it ascending instead
# needs a different accumulator from the builder, which means a second
# mutually-recursive function, which [tail] forbids. So a descent simply
# starts a new run: already-sorted input is still ONE run and still O(n),
# while reverse-sorted input is now n singleton runs and O(n log n). Paying
# log n on the rarer input is the honest trade for never reversing anything.

fun _seedAll<T>(c: Chain<T>, less: (:T, :T): Bool): List<List<T> >
  ret match(c)
    (e: ChainEnd)  => List<List<T> >()
    (l: ChainLink) => build<List<T> >(
        _seedLoop<T>(push<T>(builder<T>(), l.value), builder<List<T> >(),
                     l.next, less, l.value))

# TWO builders in flight: `run` collects the current stretch, `runs` collects
# the finished ones. Both are linear and both are consumed exactly once on
# every path, which is what lets the run queue be built in order too — the
# order of runs is what makes the merge stable.
fun [tail] _seedLoop<T>([terminal] run: ListBuilder<T>,
                        [terminal] runs: ListBuilder<List<T> >,
                        c: Chain<T>, less: (:T, :T): Bool,
                        prev: T): ListBuilder<List<T> >
  ret match(c)
    (e: ChainEnd)  => push<List<T> >(runs, build<T>(run))
    (l: ChainLink) => less(l.value, prev)
      # descent: close this run and start the next at l.value
      ? _seedLoop<T>(push<T>(builder<T>(), l.value),
                     push<List<T> >(runs, build<T>(run)), l.next, less, l.value)
      : _seedLoop<T>(push<T>(run, l.value), runs, l.next, less, l.value)


# ── merge: pairwise passes until one run remains ─────────────────────────────

fun [tail] _mergeUntilOne<T>(runs: List<List<T> >, less: (:T, :T): Bool): List<T>
  ret match(head<List<T> >(runs))
    (e: None)     => List<T>()
    (only: List<T>) => isEmpty<List<T> >(tail<List<T> >(runs))
      ? only
      : _mergeUntilOne<T>(build<List<T> >(_mergePairs<T>(builder<List<T> >(), runs, less)), less)

# An odd trailing run passes through untouched — every run is ascending, so
# there is no direction for it to be out of step with.
fun [tail] _mergePairs<T>([terminal] acc: ListBuilder<List<T> >,
                          runs: List<List<T> >,
                          less: (:T, :T): Bool): ListBuilder<List<T> >
  ret match(head<List<T> >(runs))
    (e: None) => acc
    (a: List<T>) => match(head<List<T> >(tail<List<T> >(runs)))
      (e2: None) => push<List<T> >(acc, a)
      (b: List<T>) => _mergePairs<T>(push<List<T> >(acc, _merge2<T>(a, b, less)),
                                     tail<List<T> >(tail<List<T> >(runs)), less)

fun _merge2<T>(a: List<T>, b: List<T>, less: (:T, :T): Bool): List<T>
  ret build<T>(_mergeInto<T>(builder<T>(), chain<T>(a), chain<T>(b), less))

# Pops `a` unless `b` is STRICTLY less — so a tie takes the earlier run's
# element first, which is the whole of stability.
fun [tail] _mergeInto<T>([terminal] out: ListBuilder<T>, a: Chain<T>, b: Chain<T>,
                         less: (:T, :T): Bool): ListBuilder<T>
  ret match(a)
    (ae: ChainEnd)  => _pushChain<T>(out, b)
    (ac: ChainLink) => match(b)
      (be: ChainEnd)  => _pushChain<T>(out, a)
      (bc: ChainLink) => less(bc.value, ac.value)
        ? _mergeInto<T>(push<T>(out, bc.value), a, bc.next, less)
        : _mergeInto<T>(push<T>(out, ac.value), ac.next, b, less)

# ── ListBuilder ──────────────────────────────────────────────────────────────
# Linear in-order construction: O(1) push, natural order, no reversals, and
# build() hands back a FRONT-NORMAL list whose chain() is free. The cells are
# ordinary immutable ChainLinks; the one mutable step — writing the previous
# tail's `next` — lives in the runtime, on a cell that is PINNED (compaction
# never moves it: concurrent lazy relocation's "either copy is fine" contract
# only covers immutable objects) and not yet published. Linearity certifies
# the confinement: the builder is consumed by every operation, so no push can
# race another or follow build. Exactly one cell is pinned per live builder.
# The runtime calls' results thread through _ok so no pass can discard them.
class [linear,final] ListBuilder<T>(_head: Chain<T>, _tail: Chain<T>,
                                     _slot: Int64, _ok: Bool)

fun builder<T>(): ListBuilder<T>
  ret ListBuilder<T>(ChainEnd<T>(), ChainEnd<T>(), truncateToInt64(0), true)

fun push<T>([terminal] b: ListBuilder<T>, x: T): ListBuilder<T>
  let cell = ChainLink<T>(x, ChainEnd<T>())
  let pinned = __builtin_op__<bool>("list_builder_pin", cell)
  ret match(b._tail)
    (prev: ChainLink) => ListBuilder<T>(b._head, cell, b._slot,
        pinned && __builtin_op__<bool>("list_builder_link", prev, cell, b._slot))
    # First push: compute the cell layout's next-slot index ONCE; every later
    # link is a single indexed store.
    (nil: ChainEnd)   => ListBuilder<T>(cell, cell,
        __builtin_op__<int64>("list_builder_slot", cell), pinned)

fun build<T>([terminal] b: ListBuilder<T>): List<T>
  ret match(b._tail)
    (t2: ChainLink) => __builtin_op__<bool>("list_builder_seal", t2)
      ? ListFull<T>(b._head)
      : ListEmpty<T>()   # unreachable: seal always succeeds; keeps the call live
    (nil: ChainEnd)  => ListEmpty<T>()

# Push every element of `l`, in order.
fun pushAll<T>([terminal] b: ListBuilder<T>, l: List<T>): ListBuilder<T>
  ret _pushChain<T>(b, chain(l))

fun [tail] _pushChain<T>([terminal] b: ListBuilder<T>, c: Chain<T>): ListBuilder<T>
  ret match(c)
    (nil: ChainEnd) => b
    (l: ChainLink)  => _pushChain<T>(push(b, l.value), l.next)

# Explicitly consume a builder without keeping its list — the failure-path
# counterpart of build (StringBuilder's discard precedent). A ternary whose
# branches mix implicit drop with consumption is rejected by the linearity
# checker; route the failure branch through a helper that takes the builder
# and lets the drop happen at statement level, or call discard directly.
fun discard<T>([terminal] b: ListBuilder<T>): None
  ret _discardBuilt(build(b))

# Drop: an ABANDONED builder — a failed parse alternative, an early exit —
# must still release its pinned tail cell (a leaked pin is a permanently
# unmovable object). Dropping is building and discarding the result: build's
# seal unpins, and the discarded cells are ordinary garbage. [ambient]: the
# drops pass inserts plain `drop(x)` calls that must resolve in concrete
# user code without a spelled `where`.
instance [ambient]<T> Drop<ListBuilder<T>>
  fun drop(self: ListBuilder<T>): None
    ret _discardBuilt(build(self))

fun _discardBuilt<T>(_l: List<T>): None
  ret None
