  ret 3 * x
fun program(): System::Int
  ret triple(14)

fun [test("arithmetic pins the parameter")] check(): None|TestFailure
    ret assertEqInt(program(), 42, "program()")


namespace CompilerTests::ParamBodyInference::BranchesWithNoCommonParentAreTheUnion

import System
import System::Test

fun maybe(flag: System::Bool)
  ret flag ? 5 : None
fun program(): System::Int
  ret match(maybe(true))
    (n: System::Int) => n
    (z: System::None) => 0

fun [test("branches with no common parent are the union")] check(): None|TestFailure
    ret assertEqInt(program(), 5, "program()")


