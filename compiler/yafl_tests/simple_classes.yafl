import System
import System::Test

class Point(x: Int, y: Int)
    fun sum(): Int
        ret x + y

fun program(): Int
    let p: Point = Point(5, 8)
    ret p.sum()

fun [test("Method that combines two fields; value choice distinguishes field-swap corruption")] check(): None|TestFailure
    ret assertEqInt(program(), 13, "program()")


namespace CompilerTests::SimpleClasses::TwoInstancesIndependent

import System
import System::Test

class Box(value: Int)
    fun get(): Int
        ret value

fun program(): Int
    let a: Box = Box(9)
    let b: Box = Box(4)
    ret a.get() + b.get()

fun [test("Two instances of the same simple class hold independent values")] check(): None|TestFailure
