namespace CompilerTests::SimpleClasses::StructReturningFunctionWithStateMachine

import System
import System::Test

class Box(value: Int)

fun bump(n: Int): Int
    ret n

fun make_box(n: Int): Box
    let v: Int = bump(n)
    ret Box(v)

fun program(): Int
    let b: Box = make_box(17)
    ret b.value

fun [test("make_box has a non-tail call before constructing and returning a Box")] check(): None|TestFailure
    ret assertEqInt(program(), 17, "program()")


