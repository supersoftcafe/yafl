# `subject.field := value`: the write a `[pinnable]` or `[mutable]` class admits
# after construction. With `System::Internal`'s `pinYoung` / `unpin` it is the
# whole critical section of a write-once publication: take the pin (and fail
# fast), check the slot is still empty, store, release.
#
# One namespace per test: each program as written, its `main` renamed
# `program`, checked by the [test] beside it.

namespace CompilerTests::FieldAssign::SetOnlyIfNull

import System
import System::Internal
import System::Test

class [pinnable] Cell(value: System::Int, next: Cell|None)

# Pin; if the pin is refused, give up; if the slot is empty, fill it; release.
# True when THIS call stored.
fun publish(c: Cell, v: System::Int): System::Bool
  if !pinYoung(c)
    ret false
  if c.next is None
    c.next := Cell(v, None)
    unpin(c)
    ret true
  unpin(c)
  ret false

fun valueOfNext(c: Cell): System::Int
  ret match(c.next)
    (n: Cell) => n.value
    ()        => 0

# The first publish finds the slot empty and fills it with 2. The second finds
# it taken and leaves it alone: the 3 is never stored.
fun program(): System::Int
  let c = Cell(1, None)
  if publish(c, 2)
    if !publish(c, 3)
      ret valueOfNext(c)
  ret -1

fun [test("pin, check null, store only if null, unpin")] check(): None|TestFailure
    ret assertEqInt(program(), 2, "program()")


namespace CompilerTests::FieldAssign::PinIsALock

import System
import System::Internal
import System::Test

class [pinnable] Cell(value: System::Int, next: Cell|None)

# While one pin is held a second is refused, and once released it is granted
# again. Statements, not lets: lets of effects may reorder among themselves.
fun program(): System::Int
  let c = Cell(1, None)
  if pinYoung(c)
    if pinYoung(c)
      ret 0
    unpin(c)
    if pinYoung(c)
      unpin(c)
      ret 1
  ret 0

fun [test("a held pin refuses a second; released, it is granted again")] check(): None|TestFailure
    ret assertEqInt(program(), 1, "program()")


namespace CompilerTests::FieldAssign::MutableNeedsNoPin

import System
import System::Test

class [mutable] Counter(n: System::Int)

fun program(): System::Int
  let k = Counter(1)
  k.n := 7
  ret k.n

fun [test("a [mutable] class is written with no pin")] check(): None|TestFailure
    ret assertEqInt(program(), 7, "program()")


namespace CompilerTests::FieldAssign::AssignNone

import System
import System::Internal
import System::Test

class [pinnable] Cell(value: System::Int, next: Cell|None)

# `None` stored into a `Cell|None` field is the union's empty case (NULL in C),
# and a later `is None` sees it: the value is received at the FIELD's type.
fun program(): System::Int
  let c = Cell(1, Cell(2, None))
  if pinYoung(c)
    c.next := None
    unpin(c)
    if c.next is None
      ret 1
  ret 0

fun [test("assigning None empties a union field")] check(): None|TestFailure
    ret assertEqInt(program(), 1, "program()")
