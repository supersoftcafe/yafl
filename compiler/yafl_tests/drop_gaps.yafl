# Two drops/linearity gaps found during ListBuilder adoption (07-29); they
# are exercised here through Holder, a test-local linear class with a
# generic Drop instance (the stdlib no longer has a linear builder).
#
# 1. GENERIC Drop instances don't discharge: a generic `[ambient]` instance
#    `Drop<Holder<T>>` exists, but an implicitly-dropped Holder<Int> failed
#    to compile — the drops pass only recognised CONCRETE instance targets.
#
# 2. A ternary whose branches mix implicit drop with consumption is rejected
#    ("linear value ... used inconsistently across branches") instead of the
#    dropping branch receiving its drop, the way match arms and early returns
#    do.
#
# One namespace per test: each program as written, its `main` renamed
# `program`, checked by the [test] beside it.

namespace CompilerTests::DropGaps::GenericDropInstanceDischarges

import System
import System::Test

# A generic linear class with a generic [ambient] Drop instance — the shape
# the drops pass must discharge.
class [linear, final] Holder<T>(value: T)

fun release<T>([terminal] h: Holder<T>): T
  ret h.value

fun _released<T>(_v: T): None
  ret None

instance [ambient]<T> Drop<Holder<T>>
  fun drop(self: Holder<T>): None
    ret _released<T>(release<T>(self))

fun f(flag: Bool): Int
  let b = Holder<Int>(7)
  if flag
    ret 1
  ret release(b)

fun program(): Int
  ret f(true) == 1 && f(false) == 7 ? 0 : 1

fun [test("generic drop instance discharges")] check(): None|TestFailure
    ret assertEqInt(program(), 0, "program()")


namespace CompilerTests::DropGaps::TernaryBranchGetsImplicitDrop

import System
import System::Test

# A generic linear class with a generic [ambient] Drop instance — the shape
# the drops pass must discharge.
class [linear, final] Holder<T>(value: T)

fun release<T>([terminal] h: Holder<T>): T
  ret h.value

fun _released<T>(_v: T): None
  ret None

instance [ambient]<T> Drop<Holder<T>>
  fun drop(self: Holder<T>): None
    ret _released<T>(release<T>(self))

fun g(flag: Bool): Int
  let b = Holder<Int>(9)
  ret flag ? 1 : release(b) - 8

fun program(): Int
  ret g(true) == 1 && g(false) == 1 ? 0 : 1

fun [test("ternary branch gets implicit drop")] check(): None|TestFailure
    ret assertEqInt(program(), 0, "program()")
