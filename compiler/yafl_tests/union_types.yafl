        () => 7

fun program(): Int
    ret classify(None)

fun [test("() else arm executes when no typed arm matches — None input to String|None")] check(): None|TestFailure
    ret assertEqInt(program(), 7, "program()")


namespace CompilerTests::UnionTypes::MatchBoundVariableUsed

import System
