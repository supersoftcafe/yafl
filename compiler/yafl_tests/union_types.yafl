        (n:None) => 0

fun program(): Int
    ret unwrap_or_zero("hi") + unwrap_or_zero(None)

fun [test("The bound variable in a match arm is accessible in the arm body")] check(): None|TestFailure
    ret assertEqInt(program(), 3, "program()")


