namespace CompilerTests::UnionTypes::NestedMatchOuterNoneArm

import System
import System::Test

fun classify(x: (s: String|None, n: Int) | None, s: String|None): Int
    ret match(x)
        (pair: (s: String|None, n: Int)) => match(s)
            (y: String) => 1
            (y: None) => 0
        (n: None) => 9

fun program(): Int
    ret classify(None, "world")

fun [test("Outer match on (String|None,Int)|None dispatches to None arm regardless of inner param")] check(): None|TestFailure
    ret assertEqInt(program(), 9, "program()")


