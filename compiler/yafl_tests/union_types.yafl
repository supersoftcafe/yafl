# Tests for union (CombinationSpec) types: type-checking, binary output, and negative cases.
#
# One namespace per test: each program as written, its `main` renamed
# `program`, checked by the [test] beside it.

namespace CompilerTests::UnionTypes::ElseArmNotTakenWhenTypedArmMatches

import System
import System::Test

fun classify(x: String|None): Int
    ret match(x)
        (s: String) => 2
        () => 7

fun program(): Int
    ret classify("hello")

fun [test("() else arm is skipped when an earlier typed arm matches — String input")] check(): None|TestFailure
    ret assertEqInt(program(), 2, "program()")


namespace CompilerTests::UnionTypes::ElseArmTaken

import System
import System::Test

fun classify(x: String|None): Int
    ret match(x)
