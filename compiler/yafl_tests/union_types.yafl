namespace CompilerTests::UnionTypes::DispatchMixesClassesIntStringNone

import System
import System::Test

class A(a1: Int, a2: Int, a3: Int, a4: Int, a5: Int)
class B(b1: Int, b2: Int, b3: Int, b4: Int, b5: Int)
class C(c1: Int, c2: Int, c3: Int, c4: Int, c5: Int)

fun classify(v: A|B|String|Int|None): Int
    ret match(v)
        (a: A)      => 1
        (b: B)      => 2
        (s: String) => 3
        (n: Int)    => 4
        (x: None)   => 5

fun callA(): Int
    let a: A = A(0,0,0,0,0)
    ret classify(a)

fun callStr(): Int
    ret classify("hello")

fun callInt(): Int
    ret classify(42)

fun callNone(): Int
    ret classify(None)

fun program(): Int
    ret callA() + callStr() + callInt() + callNone()

fun [test("The full menagerie: class + class + Int + String + None in one union")] check(): None|TestFailure
    ret assertEqInt(program(), 13, "program()")


