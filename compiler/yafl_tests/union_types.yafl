namespace CompilerTests::UnionTypes::ExactVtableMatchOnSiblings

import System
import System::Test

class A(a1: Int, a2: Int, a3: Int, a4: Int, a5: Int)
class B(b1: Int, b2: Int, b3: Int, b4: Int, b5: Int)

fun pick(v: A|B|None): Int
    ret match(v)
        (a: A)    => 10
        (b: B)    => 20
        (n: None) => 30

fun program(): Int
    let a: A = A(0,0,0,0,0)
    let b: B = B(0,0,0,0,0)
    ret pick(a) + pick(b) + pick(None)

fun [test("Two classes with no shared interface: each arm matches only its")] check(): None|TestFailure
    ret assertEqInt(program(), 60, "program()")


