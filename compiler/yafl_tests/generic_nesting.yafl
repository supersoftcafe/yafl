# Generic enums as type ARGUMENTS of other generics, with the inner type
# still a placeholder of the enclosing function.
#
# `List<List<String>>` (fully concrete nesting) has always worked; the failing
# shape is `List<_N<T>>` inside a generic function `f<T>`, where monomorphising
# `f<Int>` must substitute T through BOTH generic layers. Found writing the
# stdlib natural mergesort (runs queue = List<_ListNode<T>>); previously
# crashed codegen with "GenericPlaceholderSpec should be replaced with a
# concrete type".
#
# One namespace per test: each program as written, its `main` renamed
# `program`, checked by the [test] beside it.

namespace CompilerTests::GenericNesting::GenericEnumAsGenericArgument

import System
import System::Containers
import System::Test

enum _N<T>
  enum _X()
  enum _C(v: T, n: _N<T>)

# A generic function whose body instantiates a generic enum (List) with a
# generic-enum argument (_N<T>) over its own placeholder.
fun mk<T>(x: T): List<_N<T> >
  ret prepend<_N<T> >(_C<T>(x, _X<T>()), List<_N<T> >())

fun headValue<T>(l: List<_N<T> >, dflt: T): T
  ret match(head<_N<T> >(l))
    (n: _N<T>) => match(n)
      (c: _C)  => c.v
      (e: _X)  => dflt
    (e: None)  => dflt

fun program(): System::Int
  let one = mk<Int>(7)
  let two = prepend<_N<Int> >(_C<Int>(3, _X<Int>()), one)
  System::print(String(headValue<Int>(two, -1)) + "," + String(headValue<Int>(one, -1)) + "\n")
  ret 0

fun [test("generic enum as generic argument", stdout = "3,7\n")] check(): None|TestFailure
    ret assertEqInt(program(), 0, "program()")


# A generic [tail] function instantiated at a TUPLE holding a nested generic
# — `(String, Dict<String, List<Int>>)`. The monomorphiser named the
# instantiation while `List<Int>` and `Dict<…>` inside the tuple were still
# unspecialised, then again once each landed: two copies, each one's
# self-call naming the other, and [tail] reported "requires direct
# self-recursion". (Found when Array's [tail] fold met such an accumulator.)
namespace CompilerTests::GenericNesting::TailOverTupleOfNestedGenerics

import System
import System::Test
import System::Containers

fun [tail] loop<A>(n: Int, acc: A, f: (:A): A): A
  ret n <= 0 ? acc : loop<A>(n - 1, f(acc), f)

fun step(st: (s: String, d: Dict<String, List<Int>>)) => (st.s + "k", put(st.d, st.s, List<Int>(1)))

fun program(): System::Int
  let r = loop(2, ("", Dict<String, List<Int>>()), step)
  ret size(r.d)

fun [test("a [tail] generic over a tuple of nested generics")] check(): None|TestFailure
    ret assertEqInt(program(), 2, "program()")
