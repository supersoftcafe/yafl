# System::splitLines — split a String into lines on '\n', dropping a trailing
# '\r' so both LF and CRLF work; the text after the final newline is the last
# element.
#
# One namespace per test: each program as written, its `main` renamed
# `program`, checked by the [test] beside it.

namespace CompilerTests::SplitLines::EmptyStringOneEmptyLine

import System
import System::Test

fun program(): System::Int
  let parts: List<System::String> = System::splitLines("")
  print(fold<System::String, System::String>(parts, "",
        (acc: System::String, s: System::String) => acc + "[" + s + "]"))
  ret 0

fun [test("empty string one empty line", stdout = "[]")] check(): None|TestFailure
    ret assertEqInt(program(), 0, "program()")


namespace CompilerTests::SplitLines::LfAndCrlf

import System
import System::Test

fun program(): System::Int
  let parts: List<System::String> = System::splitLines("a\nbb\r\nccc")
  print(fold<System::String, System::String>(parts, "",
        (acc: System::String, s: System::String) => acc + "[" + s + "]"))
  ret 0

fun [test("lf and crlf", stdout = "[a][bb][ccc]")] check(): None|TestFailure
    ret assertEqInt(program(), 0, "program()")


namespace CompilerTests::SplitLines::NoNewlineSingleElement

import System
import System::Test

fun program(): System::Int
  let parts: List<System::String> = System::splitLines("x")
  print(fold<System::String, System::String>(parts, "",
        (acc: System::String, s: System::String) => acc + "[" + s + "]"))
  ret 0

fun [test("no newline single element", stdout = "[x]")] check(): None|TestFailure
    ret assertEqInt(program(), 0, "program()")


namespace CompilerTests::SplitLines::TrailingNewlineGivesEmptyLast

import System
import System::Test

fun program(): System::Int
  let parts: List<System::String> = System::splitLines("a\n")
  print(fold<System::String, System::String>(parts, "",
        (acc: System::String, s: System::String) => acc + "[" + s + "]"))
  ret 0

fun [test("trailing newline gives empty last", stdout = "[a][]")] check(): None|TestFailure
    ret assertEqInt(program(), 0, "program()")
