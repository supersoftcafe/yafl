namespace CompilerTests::ShortCircuit::ComparisonBindsTighterThanLogical

import System
import System::Test

fun left(v: System::Bool): System::Bool
  System::print("L")
  ret v

fun right(v: System::Bool): System::Bool
  System::print("R")
  ret v
fun program(): System::Int
  ret 1 > 0 && 2 > 3 ? 1 : 0

fun [test("comparison binds tighter than logical")] check(): None|TestFailure
    ret assertEqInt(program(), 0, "program()")


