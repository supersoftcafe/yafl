# Short-circuit logical operators `&&` and `||`.
#
# These are parse-time sugar for the ternary expression (`parser.py`):
#     a && b   ->   a ? b : false
#     a || b   ->   a ? true : b
# so short-circuit is a *guaranteed* semantic — the right operand is not evaluated
# when the left already decides the result — rather than an optimiser artefact.
# The eager both-operands bool ops remain `&`/`|`.
#
# Precedence (tightest first among these): comparison/bind > `&&` > `||` > `?:`.
#
# One namespace per test: each program as written, its `main` renamed
# `program`, checked by the [test] beside it.

namespace CompilerTests::ShortCircuit::AndBindsTighterThanOr

import System
import System::Test

fun left(v: System::Bool): System::Bool
  System::print("L")
  ret v

fun right(v: System::Bool): System::Bool
  System::print("R")
  ret v
fun program(): System::Int
  ret false && false || true ? 1 : 0

fun [test("and binds tighter than or")] check(): None|TestFailure
    ret assertEqInt(program(), 1, "program()")


namespace CompilerTests::ShortCircuit::AndEvaluatesRightWhenLeftTrue

import System
import System::Test

fun left(v: System::Bool): System::Bool
  System::print("L")
  ret v

fun right(v: System::Bool): System::Bool
  System::print("R")
  ret v
fun program(): System::Int
  ret left(true) && right(true) ? 1 : 0

fun [test("and evaluates right when left true", stdout = "LR")] check(): None|TestFailure
    ret assertEqInt(program(), 1, "program()")


