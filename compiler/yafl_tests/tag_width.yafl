fun c0(): System::Int
  ret match(f0(1))
    (t: (a0: System::Int, b0: System::Int)) => t.a0
    ()                                          => 0

fun c77(): System::Int
  ret match(f77(1))
    (t: (a77: System::Int, b77: System::Int)) => t.a77
    ()                                          => 0

fun c139(): System::Int
  ret match(f139(1))
    (t: (a139: System::Int, b139: System::Int)) => t.a139
    ()                                          => 0

fun program(): System::Int
  ret c0() + c77() + c139()

fun [test("wide discriminators compile and run")] check(): None|TestFailure
    ret assertEqInt(program(), 3, "program()")
