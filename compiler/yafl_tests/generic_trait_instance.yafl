# Generic trait instances: a generic type registered as a trait instance,
# conditional on a `where` constraint over its own type parameter.
#
# This is the language feature underpinning fusible stream transducers (see
# TODO.md "Fusible stream transformers via generic trait instances"): a wrapping
# combinator `Wrap<S>` is a `Box` *whenever* its inner `S` is, declared once and
# monomorphised per concrete carrier.
#
# The pieces exercised end to end:
#   * `let [trait] _w<S,T>: _W<S,T> where Box<S,T>`  — a generic trait instance,
#     registered by the `[trait]` let alone (no `typealias [where]`, so the
#     instance is NOT ambiently in scope — callers declare `where Box<S,T>`).
#   * constraint-driven instantiation in lowering/generics.py: discharging a
#     concrete `Box<Wrap<Leaf,Int>,Int>` instantiates the witness (and, by
#     recursion through the witness's own `where`, every inner instance).
#
# Two ergonomic work-arounds appear in the source below; both are pre-existing,
# separately-tracked compiler limitations, NOT part of this feature:
#   * the recursive unwrap is routed through a free helper `_unwrapInner` because a
#     same-named call inside the witness method binds to the enclosing method
#     (member shadowing);
#   * `Wrap<...>` and `_unwrapInner<...>` are given explicit type args because `T`
#     appears only in the return/`where`, so it can't be inferred from arguments.
#
# One namespace per test: each program as written, its `main` renamed
# `program`, checked by the [test] beside it.

namespace CompilerTests::GenericTraitInstance::NestedWrapRecurses

import System
import System::Test

interface Box<S, T>
  fun unwrap(self: S): T

class [final] Leaf(v: System::Int)
instance [ambient] Box<Leaf, System::Int>
  fun unwrap(self: Leaf): System::Int
    ret self.v

class [final] Wrap<S, T>(inner: S)
# The `where` belongs on the INSTANCE, not on the member — a member declares
# neither generics nor constraints of its own.
instance [ambient] <S, T> Box<Wrap<S, T>, T> where Box<S, T>
  fun unwrap(self: Wrap<S, T>): T
    ret _unwrapInner<S, T>(self.inner)
fun _unwrapInner<S, T>(b: S): T where Box<S, T>
  ret unwrap(b)

fun useBox<S, T>(b: S): T where Box<S, T>
  ret unwrap(b)

fun program(): System::Int
  let inner = Wrap<Leaf, System::Int>(Leaf(5))
  let outer = Wrap<Wrap<Leaf, System::Int>, System::Int>(inner)
  ret useBox(outer)

fun [test("nested wrap recurses")] check(): None|TestFailure
    ret assertEqInt(program(), 5, "program()")


namespace CompilerTests::GenericTraitInstance::SingleWrap

import System
import System::Test

interface Box<S, T>
  fun unwrap(self: S): T

class [final] Leaf(v: System::Int)
instance [ambient] Box<Leaf, System::Int>
  fun unwrap(self: Leaf): System::Int
    ret self.v

class [final] Wrap<S, T>(inner: S)
# The `where` belongs on the INSTANCE, not on the member — a member declares
# neither generics nor constraints of its own.
instance [ambient] <S, T> Box<Wrap<S, T>, T> where Box<S, T>
  fun unwrap(self: Wrap<S, T>): T
    ret _unwrapInner<S, T>(self.inner)
fun _unwrapInner<S, T>(b: S): T where Box<S, T>
  ret unwrap(b)

fun useBox<S, T>(b: S): T where Box<S, T>
  ret unwrap(b)

fun program(): System::Int
  let w = Wrap<Leaf, System::Int>(Leaf(7))
  ret useBox(w)

fun [test("single wrap")] check(): None|TestFailure
    ret assertEqInt(program(), 7, "program()")


namespace CompilerTests::GenericTraitInstance::ErrorPropagatesThroughPipeline

import System
import System::Test

enum Boom(code: System::Int)
class [final] Src(cur: System::Int)
class _S() : System::Stream<Src, System::Int, Boom>
  fun next(self: Src): (stream: Src, value: System::Result<System::Int|System::None, Boom>)
    ret self.cur == 3
      ? (self, System::Error<System::Int|System::None, Boom>(Boom(42)))
      : (Src(self.cur + 1), System::Ok<System::Int|System::None, Boom>(self.cur))
let [trait] _s: _S = _S()
fun dbl(x: System::Int): System::Int
  ret x * 10
fun [tail] run<S, E>(s: S, acc: System::Int): System::Result<System::Int, E> where System::Stream<S, System::Int, E>
  let r = System::streamNext<S, System::Int, E>(s)
  ret match(r.value)
    (ok: System::Ok<System::Int|System::None, E>) => match(ok.value)
      (x: System::Int)  => run<S, E>(r.stream, acc + x)
      (n: System::None) => System::Ok<System::Int, E>(acc)
    (er: System::Error<System::Int|System::None, E>) => System::Error<System::Int, E>(er.error)
fun program(): System::Int
  ret match(run(System::Map(Src(1), dbl), 0))
    (ok: System::Ok<System::Int, Boom>)  => ok.value
    (er: System::Error<System::Int, Boom>) => er.error.code

fun [test("error propagates through pipeline")] check(): None|TestFailure
    ret assertEqInt(program(), 42, "program()")


namespace CompilerTests::GenericTraitInstance::FilterMapPipeline

import System
import System::Test

# A leaf source that counts cur..hi and cannot fail — its error type is Never,
# so it only ever yields Ok(value) or Ok(None) (Error is unconstructable).
class [final] Count(cur: System::Int, hi: System::Int)
class _StreamCount() : System::Stream<Count, System::Int, System::Never>
  fun next(self: Count): (stream: Count, value: System::Result<System::Int|System::None, System::Never>)
    ret self.cur > self.hi
      ? (self, System::Ok<System::Int|System::None, System::Never>(None))
      : (Count(self.cur + 1, self.hi), System::Ok<System::Int|System::None, System::Never>(self.cur))
let [trait] _stream_count: _StreamCount = _StreamCount()

# Sum the values into Ok(total), forwarding an Error of type E if one occurs.
fun [tail] sumStream<S, E>(s: S, acc: System::Int): System::Result<System::Int, E> where System::Stream<S, System::Int, E>
  let r = System::streamNext<S, System::Int, E>(s)
  ret match(r.value)
    (ok: System::Ok<System::Int|System::None, E>) => match(ok.value)
      (x: System::Int)  => sumStream<S, E>(r.stream, acc + x)
      (n: System::None) => System::Ok<System::Int, E>(acc)
    (er: System::Error<System::Int|System::None, E>) => System::Error<System::Int, E>(er.error)

# Drive an infallible (Never) Int stream to its sum. S is inferred from the
# argument; the Error arm is unreachable (Never is uninhabited).
fun drain<S>(s: S): System::Int where System::Stream<S, System::Int, System::Never>
  ret match(sumStream<S, System::Never>(s, 0))
    (ok: System::Ok<System::Int, System::Never>)  => ok.value
    (er: System::Error<System::Int, System::Never>) => 0

fun isOdd(x: System::Int): System::Bool
  ret x % 2 == 1
fun dbl(x: System::Int): System::Int
  ret x * 10

fun program(): System::Int
  ret drain(System::Map(System::Filter(Count(1, 5), isOdd), dbl))

fun [test("filter map pipeline")] check(): None|TestFailure
    ret assertEqInt(program(), 90, "program()")


namespace CompilerTests::GenericTraitInstance::GenericLinesSplitter

import System
import System::Test

class [final] Feed(idx: System::Int)
class _SF() : System::Stream<Feed, System::String, System::Never>
  fun next(self: Feed): (stream: Feed, value: System::Result<System::String|System::None, System::Never>)
    ret self.idx == 0 ? (Feed(1), System::Ok<System::String|System::None, System::Never>("ab\nc"))
      : self.idx == 1 ? (Feed(2), System::Ok<System::String|System::None, System::Never>("d\nef"))
                      : (self, System::Ok<System::String|System::None, System::Never>(None))
let [trait] _sf: _SF = _SF()
fun [tail] tally<S>(s: S, ln: System::Int, ch: System::Int): System::Int where System::Stream<S, System::String, System::Never>
  let r = System::streamNext<S, System::String, System::Never>(s)
  ret match(r.value)
    (ok: System::Ok<System::String|System::None, System::Never>) => match(ok.value)
      (line: System::String) => tally<S>(r.stream, ln + 1, ch + System::length(line))
      (n: System::None)       => ln * 10 + ch
    (er: System::Error<System::String|System::None, System::Never>) => 0 - 1
fun program(): System::Int
  ret tally(System::toLines(Feed(0)), 0, 0)

fun [test("generic lines splitter")] check(): None|TestFailure
    ret assertEqInt(program(), 36, "program()")


