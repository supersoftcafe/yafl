namespace CompilerTests::GenericTraitInstance::UnionMemberGroundsToUnion

import System
import System::Test

class [final] ErrX()

interface Box<S, T>
  fun unwrap(self: S): T

class [final] Leaf(v: System::Int)
instance [ambient] Box<Leaf, System::Int>
  fun unwrap(self: Leaf): System::Int
    ret self.v

class [final] Grow<S, T>(inner: S)
instance [ambient] <S, T> Box<Grow<S, T>, T | ErrX> where Box<S, T>
  fun unwrap(self: Grow<S, T>): T | ErrX
    ret _unwrapInner<S, T>(self.inner)
fun _unwrapInner<S, T>(b: S): T where Box<S, T>
  ret unwrap(b)

fun useBox<S, T>(b: S): T where Box<S, T>
  ret unwrap(b)

fun program(): System::Int
  let g = Grow<Grow<Leaf, System::Int>, System::Int | ErrX>(Grow<Leaf, System::Int>(Leaf(7)))
  ret match(useBox<Grow<Grow<Leaf, System::Int>, System::Int | ErrX>, System::Int | ErrX>(g))
    (n: System::Int) => n
    (e: ErrX)        => 9

fun [test("union member grounds to union")] check(): None|TestFailure
    ret assertEqInt(program(), 7, "program()")
