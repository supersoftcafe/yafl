# The `with` expression — copy-with-replacements, identity-preserving.
#
# docs/preserving-rewrites-design.md, all rulings applied:
#
#   * `with subject(name = value, …)` — call-shaped, not a call;
#   * zero replacements is a CHECK error, not a parse error;
#   * subjects are class- and enum-typed (ROOT included: the dynamic leaf is
#     preserved, and names must be fields visible at the STATIC type);
#   * the lowering returns the ORIGINAL object when every replacement is
#     bit-identical to the current field ("SAME"), else a copy whose `$hash`
#     slot is zeroed.
#
# Identity preservation is unobservable by design, so the tests observe it
# through the sanctioned doors: a `[refeq]` compare skips its compute for the
# original-returned case, and `hashOf` must NOT serve a stale cache from a
# copy.
#
# One namespace per test: each program as written, its `main` renamed
# `program`, checked by the [test] beside it.

namespace CompilerTests::WithExpr::ClassSubjectReplacesAndCarries

import System
import System::Test

class [final] P2(px: System::Int, py: System::Int)

fun program(): System::Int
  let a = P2(3, 4)
  let b = with a(py = 40)
  ret a.px == 3 && a.py == 4 && b.px == 3 && b.py == 40 ? 0 : 1

fun [test("class subject replaces and carries")] check(): None|TestFailure
    ret assertEqInt(program(), 0, "program()")


namespace CompilerTests::WithExpr::CopyDoesNotServeAStaleHash

import System
import System::Test

enum H3
  enum H31(v: System::Int)
  enum H32(w: System::Int, x: H3)

fun [hashed] h3Hash(h: H3): System::Int32
  ret match(h)
    (a: H31) => hashOf(a.v)
    (b: H32) => (h3Hash(b.x) * 31i32 + hashOf(b.w)) & 2147483647i32

fun program(): System::Int
  ret match(H31(5))
    (a: H31) => h3Hash(a) != h3Hash(with a(v = 6)) ? 0 : 1

fun [test("The copy's `$hash` slot must be ZEROED: hash the original (fills")] check(): None|TestFailure
    ret assertEqInt(program(), 0, "program()")


namespace CompilerTests::WithExpr::ReplacingAnOptionalFieldWithNoneCopies

import System
import System::Test

class [final] Opt3(name: System::String, ty: System::Int|None)

fun tyOr(o: Opt3): System::Int
  ret match(o.ty)
    (n: System::Int) => n
    ()               => 100

fun program(): System::Int
  let a = Opt3("a", 7)
  let b = with a(ty = None)
  ret tyOr(a) == 7 && tyOr(b) == 100 ? 0 : 1

fun [test("The SAME guard compares at the FIELD's representation: a None")] check(): None|TestFailure
    ret assertEqInt(program(), 0, "program()")


namespace CompilerTests::WithExpr::RootTypedSubjectPreservesDynamicLeaf

import System
import System::Test

enum Colour3(shade: System::Int)
  enum Red3()
  enum Green3(glow: System::Int)

fun dim(c: Colour3): Colour3
  ret with c(shade = 1)

fun program(): System::Int
  ret match(dim(Green3(9, 7)))
    (g: Green3) => g.shade == 1 && g.glow == 7 ? 0 : 1
    (o: Colour3) => 2

fun [test("The ruling's own example: static type Colour, instance Green —")] check(): None|TestFailure
    ret assertEqInt(program(), 0, "program()")


namespace CompilerTests::WithExpr::UnchangedReplacementReturnsTheOriginal

import System
import System::Test

enum Box3
  enum B3(v: System::Int)
  enum BL3(inner: Box3)

fun [refeq, impure] boxEq(l: Box3, r: Box3): System::Bool
  print("E")
  ret match(l)
    (x: B3) => match(r)
      (y: B3) => x.v == y.v
      (o: Box3) => false
    (o2: Box3) => false

fun program(): System::Int
  ret match(B3(7))
    (b: B3) => boxEq(b, with b(v = b.v)) ? 0 : 1

fun [test("Observed through [refeq]: comparing the subject with a `with` whose", stdout = "")] check(): None|TestFailure
    ret assertEqInt(program(), 0, "program()")


namespace CompilerTests::WithExpr::VariantSubject

import System
import System::Test

enum Tree3
  enum Leaf3(val: System::Int)
  enum Node3(left: Tree3, right: Tree3)

fun program(): System::Int
  ret match(Node3(Leaf3(1), Leaf3(2)))
    (n: Node3) => match(with n(right = Leaf3(9)))
      (m: Node3) => match(m.right)
        (l: Leaf3) => l.val == 9 ? 0 : 1
        (o: Tree3) => 2

fun [test("variant subject")] check(): None|TestFailure
    ret assertEqInt(program(), 0, "program()")
