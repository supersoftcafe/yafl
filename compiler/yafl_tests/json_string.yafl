namespace CompilerTests::JsonString::ValueParserStringBodyBuilder

import System
import System::Json
import System::Test

fun program(): System::Int
  ret match(parse("\"a\\nb\""))
    (v: JsonValue)      => match(v)
      (s: JsonStr)      => System::length(s.strValue) == 3 ? 0 : 3
      (other)           => 4
    (p: JsonParseError) => 2

fun [test("value parser string body builder")] check(): None|TestFailure
    ret assertEqInt(program(), 0, "program()")


namespace CompilerTests::JsonString::ValueParserUnterminatedString

import System
import System::Json
import System::Test

fun program(): System::Int
  ret match(parse("\"abc"))
    (p: JsonParseError) => 2
    (other)             => 4

fun [test("value parser unterminated string")] check(): None|TestFailure
    ret assertEqInt(program(), 2, "program()")
