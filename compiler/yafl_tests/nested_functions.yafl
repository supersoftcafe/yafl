namespace CompilerTests::NestedFunctions::MemberNestedTailRecursive

import System
import System::Test

class Counter(base: Int)
  fun sumTo(n: Int): Int
    fun [tail] go(i: Int, acc: Int): Int
      ret i > n ? acc : go(i + 1, acc + base)
    ret go(1, 0)

fun program(): Int
  ret Counter(10).sumTo(4)

fun [test("A `[tail]` helper inside a member lowers to a loop like any other —")] check(): None|TestFailure
    ret assertEqInt(program(), 40, "program()")


namespace CompilerTests::NestedFunctions::MemberNestedTwoMembersSameHelperName

import System
import System::Test

class Counter(base: Int)
  fun addTo(x: Int): Int
    fun helper(y: Int): Int
      ret y + base
    ret helper(x)
  fun subFrom(x: Int): Int
    fun helper(y: Int): Int
      ret base - y
    ret helper(x)

fun program(): Int
  ret Counter(10).addTo(5) + Counter(10).subFrom(3)

fun [test("Two members may each nest a helper of the same source name; they")] check(): None|TestFailure
    ret assertEqInt(program(), 22, "program()")


namespace CompilerTests::NestedFunctions::DeepCaptureThroughACalledHelper

import System
import System::Test

fun outer(x: Int, k: Int): Int
  fun merge(a: Int): Int
    fun rebalance(c: Int): Int
      fun optimal(b: Int): Int
        ret b + 1
      ret c > 0 ? optimal(c) : x
    ret rebalance(a) * 10
  ret merge(k)

fun program(): Int
  ret outer(5, 1) + outer(5, 0)

fun [test("deep capture through a called helper")] check(): None|TestFailure
    ret assertEqInt(program(), 70, "program()")


namespace CompilerTests::NestedFunctions::DeepCaptureThroughAHelperUsedAsAValue

import System
import System::Test

fun apply(f: (:Int): Int, v: Int): Int
  ret f(v)
fun outer(x: Int, k: Int): Int
  fun merge(a: Int): Int
    fun rebalance(c: Int): Int
      fun optimal(b: Int): Int
        ret b + 1
      ret c > 0 ? optimal(c) : x
    ret rebalance(a) * 10
  ret apply(merge, k)

fun program(): Int
  ret apply((v: Int) => outer(5, v), 1) + outer(5, 0)

fun [test("deep capture through a helper used as a value")] check(): None|TestFailure
    ret assertEqInt(program(), 70, "program()")


namespace CompilerTests::NestedFunctions::GenericHostKeepsInnerNamesApart

import System
import System::Test

fun apply(f: (:Int): Int, v: Int): Int
  ret f(v)
fun outer<T>(x: T, k: Int, size: (:T): Int): Int
  fun merge(a: Int): Int
    fun rebalance(c: Int): Int
      fun pick(b: Int): Int
        ret b * 2
      ret c > 0 ? pick(c) : size(x)
    ret rebalance(a)
  ret apply(merge, k)

fun program(): Int
  ret outer<Int>(4, 0, (v: Int) => v) + outer<String>("abc", 0, (v: String) => length(v))
      + outer<Int>(4, 5, (v: Int) => v)

fun [test("generic host keeps inner names apart")] check(): None|TestFailure
    ret assertEqInt(program(), 17, "program()")


namespace CompilerTests::NestedFunctions::MutualRecursionInsideAClosure

import System
import System::Test

fun apply(f: (:Int): Int, v: Int): Int
  ret f(v)
fun outer(x: Int, n: Int): Int
  fun walk(m: Int): Int
    fun isEven(y: Int): Int
      ret y < 1 ? x : isOdd(y - 1)
    fun isOdd(y: Int): Int
      ret y < 1 ? 0 : isEven(y - 1)
    ret isEven(m)
  ret apply(walk, n)

fun program(): Int
  ret outer(7, 4) + outer(7, 3)

fun [test("mutual recursion inside a closure")] check(): None|TestFailure
    ret assertEqInt(program(), 7, "program()")
