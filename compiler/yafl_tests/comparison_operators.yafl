# The derived comparison operators `!=`, `<=`, `>=`.
#
# These are generic functions in stdlib/traits.yafl defined over the comparison
# interfaces (BasicEquality for `!=`, BasicCompare for `<=`/`>=`), so every
# numeric type and String gets them. The parser accepts the `!=`/`<=`/`>=`
# tokens at the same precedence as `<`/`==`/`>`.
#
# One namespace per test: each program as written, its `main` renamed
# `program`, checked by the [test] beside it.

namespace CompilerTests::ComparisonOperators::IntNeLeGe

import System
import System::Test

fun program(): System::Int
  let a: System::Int = 3
  let b: System::Int = 2
  ret (a != b ? 1 : 0)
    + (a != a ? 2 : 0)
    + (a <= b ? 4 : 0)
    + (b <= b ? 8 : 0)
    + (a >= b ? 16 : 0)
    + (b >= a ? 32 : 0)

fun [test("int ne le ge")] check(): None|TestFailure
    ret assertEqInt(program(), 25, "program()")


namespace CompilerTests::ComparisonOperators::LogicalNot

import System
import System::Test

fun program(): System::Int
  let x: System::Bool = 3 > 2
  ret (!(3 > 2) ? 1 : 0)
    + (!(2 > 3) ? 2 : 0)
    + (!x ? 4 : 0)
    + (!(1 != 1) ? 8 : 0)

fun [test("logical not")] check(): None|TestFailure
    ret assertEqInt(program(), 10, "program()")


namespace CompilerTests::ComparisonOperators::StringAndFloat

import System
import System::Test

fun program(): System::Int
  ret ("abc" != "abd" ? 1 : 0)
    + ("abc" <= "abc" ? 2 : 0)
    + ("abd" >= "abc" ? 4 : 0)
    + (1.5 != 2.5 ? 8 : 0)
    + (1.5 <= 1.5 ? 16 : 0)
    + (2.5 >= 1.5 ? 32 : 0)

fun [test("string and float")] check(): None|TestFailure
    ret assertEqInt(program(), 63, "program()")
