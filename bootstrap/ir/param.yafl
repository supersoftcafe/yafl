namespace Bootstrap::Ir

import System

import Bootstrap::Ast

import Bootstrap::Codegen
import Bootstrap::Resolve
import Bootstrap::StdlibCandidates
import Bootstrap::Types



# bootstrap/param.yafl — port of compiler/codegen/param.py: the RParam/LParam
# value tree (right-hand-side and writable-location IR nodes).
#
# NAMING: every RParam variant is "Rp"-prefixed (mirroring the Pe/Ps prefix
# convention already used for the pyast node tree in nodes.yafl) rather than
# Python's bare names (String, Integer, Float, ...) — those collide with
# System builtins in this single flat namespace.
#
# NO INHERITANCE: Python's `LParam(RParam)` (further subclassed by
# StackVar/GlobalVar/ObjectField) collapses into ordinary RParam variants —
# there is no separate LParam enum. Anywhere Python's static type is
# specifically `LParam` (a writable location: Move.target, PointerTo.value,
# Phi.target, ...) the YAFL field is typed `RParam` with a comment noting the
# narrowing invariant; callers must only ever construct one of RpStackVar /
# RpGlobalVar / RpObjectField there, exactly as Python's type checker (not
# its runtime) enforced.
#
# CACHE THREADING: `to_c` needs the shared anon-struct cache from
# typedecl.yafl for any nested `CgType.declare()`; see the caching-contract
# note at the top of typedecl.yafl. Every `rpToC`-family function threads it
# through as `(text, cache)`, exactly like the `cgDeclare*` family.

enum RParam
  enum RpInitArray(memberType: CgType, values: List<RParam>)                 # static array-literal initialiser
  enum RpNewStruct(values: List<RpNamedValue>)
  enum RpRuntimeInvoke(function: String, parameters: RParam, resultType: CgType)
  enum RpStructField(structVal: RParam, field: String)
  enum RpString(value: String)
  enum RpInteger(value: Int, precision: Int)
  enum RpFloat(value: Float, precision: Int)
  enum RpIntEqConst(value: RParam, constVal: Int)
  enum RpNullPointer()
  enum RpStaticObjectRef(name: String)
  enum RpVtableDiscriminator(value: RParam)
  enum RpObjVtableEq(value: RParam, className: String|None, externSymbol: String|None)
  enum RpSyncWrap(value: RParam, wrapperType: CgType)
  enum RpZeroOf(valueType: CgType)
  enum RpNewStructTyped(structType: CgType, values: List<RpNamedValue>)
  enum RpTagTask(task: RParam, targetType: CgType)
  enum RpGlobalFunction(name: String, object: RParam|None, external: Bool, cSymbol: String|None, impure: Bool, sync: Bool)
  enum RpVirtualFunction(name: String, object: RParam, fastLookup: Bool)
  enum RpPointerTo(value: RParam)                      # `value` MUST be StackVar/GlobalVar/ObjectField (Python: LParam)
  enum RpStackVar(fieldType: CgType, name: String)
  enum RpGlobalVar(fieldType: CgType, name: String)
  enum RpObjectField(fieldType: CgType, pointer: RParam, objectName: String, field: String, index: RParam|None, fresh: Bool)
  enum RpArrayElement(elementType: CgType, pointer: RParam, objectName: String, field: String, lengthField: String, index: RParam, checked: Bool)
  # Union slotting of closures (param.py FunField/MakeFun — the enum-encoding
  # principle: a closure IS a struct). RpFunField projects one primitive out
  # of a closure value ("f" = code pointer as a NON-GC intptr word, "o" =
  # environment as a GC pointer); RpMakeFun reassembles the closure from the
  # two slot reads.
  enum RpFunField(ffFun: RParam, ffPart: String)
  enum RpMakeFun(mfCode: RParam, mfEnv: RParam)

class [final] RpNamedValue(name: String, value: RParam)

class [final] RpRename(oldName: String, newName: String)

# ── small helpers ────────────────────────────────────────────────────────────

fun [tail] renameLookup(renames: List<RpRename>, name: String): String
  ret match(head<RpRename>(renames))
    (r: RpRename) => r.oldName == name ? r.newName : renameLookup(tail<RpRename>(renames), name)
    ()            => name

fun orNullOpt(o: String|None): String
  ret match(o)
    (s: String) => s
    ()          => "NULL"

# `isinstance(_, LParam)` — the 3 writable-location variants.
fun rpIsLParam(r: RParam): Bool
  ret match(r)
    (s: RpStackVar) => true
    (g: RpGlobalVar) => true
    (o: RpObjectField) => true
    (o: RParam) => false

# ── get_type ─────────────────────────────────────────────────────────────────
# Python's base RParam.get_type() raises ValueError() — variants without an
# override never have get_type() called on them; the fallback below is
# documented as unreachable.

fun rpGetType(r: RParam): CgType
  ret match(r)
    (x: RpNewStruct) => CgStruct(map(x.values, (v: RpNamedValue) => CgField(v.name, rpGetType(v.value))))
    (x: RpRuntimeInvoke) => x.resultType
    (x: RpStructField) => rpStructFieldType(x)
    (x: RpString) => CgDataPointer()
    (x: RpInteger) => x.precision == 0 ? CgDataPointer() : CgInt(x.precision)
    (x: RpFloat) => CgFloat(x.precision)
    (x: RpIntEqConst) => CgInt(32)
    (x: RpNullPointer) => CgDataPointer()
    (x: RpStaticObjectRef) => CgDataPointer()
    (x: RpVtableDiscriminator) => CgInt(32)
    (x: RpObjVtableEq) => CgInt(8)
    (x: RpSyncWrap) => x.wrapperType
    (x: RpZeroOf) => x.valueType
    (x: RpNewStructTyped) => x.structType
    (x: RpTagTask) => x.targetType
    (x: RpGlobalFunction) => CgFuncPointer()
    (x: RpVirtualFunction) => CgFuncPointer()
    (x: RpPointerTo) => CgDataPointer()
    (x: RpStackVar) => x.fieldType
    (x: RpGlobalVar) => x.fieldType
    (x: RpObjectField) => x.fieldType
    (x: RpArrayElement) => x.elementType
    (x: RpInitArray) => CgVoid()   # unreachable: Python's InitArray never overrides get_type()
    (x: RpFunField) => x.ffPart == "f" ? CgIntPtr() : CgDataPointer()
    (x: RpMakeFun) => CgFuncPointer()

fun rpStructFieldType(x: RpStructField): CgType
  ret match(cgFieldsOf(rpGetType(x.structVal)))
    (fields: List<CgField>) => rpStructFieldLookup(fields, x.field)
    () => rpStructFieldTypeSpecial(rpGetType(x.structVal), x.field)

fun rpStructFieldTypeSpecial(xtype: CgType, field: String): CgType
  ret match(xtype)
    (w: CgTaskWrapper) => field == "task" ? CgDataPointer() : w.inner
    (fp: CgFuncPointer) => CgDataPointer()   # both "f" and "o" are DataPointer per Python
    (o: CgType) => CgVoid()                  # unreachable (Python raises ValueError)

fun [tail] rpStructFieldLookup(fields: List<CgField>, name: String): CgType
  ret match(head<CgField>(fields))
    (f: CgField) => f.fieldName == name ? f.fieldType : rpStructFieldLookup(tail<CgField>(fields), name)
    ()           => CgVoid()   # unreachable (Python raises ValueError)

# ── flatten(is_reader) ───────────────────────────────────────────────────────

fun rpFlatten(r: RParam, isReader: Bool): List<RParam>
  ret match(r)
    (x: RpInitArray) => prepend<RParam>(r, rpFlattenValues(x.values))
    (x: RpNewStruct) => prepend<RParam>(r, rpFlattenNamedValues(x.values))
    (x: RpRuntimeInvoke) => prepend<RParam>(r, rpFlatten(x.parameters, true))
    (x: RpStructField) => prepend<RParam>(r, rpFlatten(x.structVal, true))
    (x: RpIntEqConst) => prepend<RParam>(r, rpFlatten(x.value, true))
    (x: RpVtableDiscriminator) => prepend<RParam>(r, rpFlatten(x.value, true))
    (x: RpObjVtableEq) => prepend<RParam>(r, rpFlatten(x.value, true))
    (x: RpSyncWrap) => prepend<RParam>(r, rpFlatten(x.value, isReader))
    (x: RpNewStructTyped) => prepend<RParam>(r, rpFlattenNamedValues(x.values))
    (x: RpTagTask) => prepend<RParam>(r, rpFlatten(x.task, true))
    (x: RpGlobalFunction) => prepend<RParam>(r, rpFlattenOpt(x.object, true))
    (x: RpVirtualFunction) => prepend<RParam>(r, rpFlatten(x.object, true))
    (x: RpPointerTo) => prepend<RParam>(r, rpFlatten(x.value, true))
    (x: RpStackVar) => isReader ? list1(r) : List<RParam>()
    (x: RpGlobalVar) => isReader ? list1(r) : List<RParam>()
    (x: RpObjectField) => rpFlattenObjectField(r, x, isReader)
    (x: RpArrayElement) => concat<RParam>(prepend<RParam>(r, rpFlatten(x.pointer, true)), rpFlatten(x.index, true))
    (x: RpFunField) => prepend<RParam>(r, rpFlatten(x.ffFun, true))
    (x: RpMakeFun) => prepend<RParam>(r, concat<RParam>(rpFlatten(x.mfCode, true), rpFlatten(x.mfEnv, true)))
    (o: RParam) => list1(r)   # base default: [self]

fun rpFlattenObjectField(r: RParam, x: RpObjectField, isReader: Bool): List<RParam>
  let head2 = isReader ? list1(r) : List<RParam>()
  let withPointer = concat<RParam>(head2, rpFlatten(x.pointer, true))
  ret match(x.index)
    (idx: RParam) => concat<RParam>(withPointer, rpFlatten(idx, true))
    ()            => withPointer

fun rpFlattenValues(values: List<RParam>): List<RParam>
  ret fold(values, List<RParam>(), (acc: List<RParam>, v: RParam) => concat<RParam>(acc, rpFlatten(v, true)))

fun rpFlattenNamedValues(values: List<RpNamedValue>): List<RParam>
  ret fold(values, List<RParam>(), (acc: List<RParam>, v: RpNamedValue) => concat<RParam>(acc, rpFlatten(v.value, true)))

fun rpFlattenOpt(o: RParam|None, isReader: Bool): List<RParam>
  ret match(o)
    (v: RParam) => rpFlatten(v, isReader)
    ()          => List<RParam>()

# ── test(predicate) ──────────────────────────────────────────────────────────

fun rpTest(r: RParam, pred: (:RParam): Bool): Bool
  ret pred(r) || rpTestChildren(r, pred)

fun rpTestChildren(r: RParam, pred: (:RParam): Bool): Bool
  ret match(r)
    (x: RpInitArray) => any<RParam>(x.values, (v: RParam) => rpTest(v, pred))
    (x: RpNewStruct) => any<RpNamedValue>(x.values, (v: RpNamedValue) => rpTest(v.value, pred))
    (x: RpRuntimeInvoke) => rpTest(x.parameters, pred)
    (x: RpStructField) => rpTest(x.structVal, pred)
    (x: RpIntEqConst) => rpTest(x.value, pred)
    (x: RpVtableDiscriminator) => rpTest(x.value, pred)
    (x: RpObjVtableEq) => rpTest(x.value, pred)
    (x: RpSyncWrap) => rpTest(x.value, pred)
    (x: RpNewStructTyped) => any<RpNamedValue>(x.values, (v: RpNamedValue) => rpTest(v.value, pred))
    (x: RpTagTask) => rpTest(x.task, pred)
    (x: RpGlobalFunction) => rpTestOpt(x.object, pred)
    (x: RpVirtualFunction) => rpTest(x.object, pred)
    (x: RpPointerTo) => rpTest(x.value, pred)
    (x: RpObjectField) => rpTest(x.pointer, pred) || rpTestOpt(x.index, pred)
    (x: RpArrayElement) => rpTest(x.pointer, pred) || rpTest(x.index, pred)
    (x: RpFunField) => rpTest(x.ffFun, pred)
    (x: RpMakeFun) => rpTest(x.mfCode, pred) || rpTest(x.mfEnv, pred)
    (o: RParam) => false

fun rpTestOpt(o: RParam|None, pred: (:RParam): Bool): Bool
  ret match(o)
    (v: RParam) => rpTest(v, pred)
    ()          => false

# ── rename_vars(renames) ─────────────────────────────────────────────────────

fun rpRenameVars(r: RParam, renames: List<RpRename>): RParam
  ret match(r)
    (x: RpInitArray) => RpInitArray(x.memberType, map(x.values, (v: RParam) => rpRenameVars(v, renames)))
    (x: RpNewStruct) => RpNewStruct(map(x.values, (v: RpNamedValue) => RpNamedValue(v.name, rpRenameVars(v.value, renames))))
    (x: RpRuntimeInvoke) => RpRuntimeInvoke(x.function, rpRenameVars(x.parameters, renames), x.resultType)
    (x: RpStructField) => RpStructField(rpRenameVars(x.structVal, renames), x.field)
    (x: RpIntEqConst) => RpIntEqConst(rpRenameVars(x.value, renames), x.constVal)
    (x: RpVtableDiscriminator) => RpVtableDiscriminator(rpRenameVars(x.value, renames))
    (x: RpObjVtableEq) => RpObjVtableEq(rpRenameVars(x.value, renames), x.className, x.externSymbol)
    (x: RpSyncWrap) => RpSyncWrap(rpRenameVars(x.value, renames), x.wrapperType)
    (x: RpNewStructTyped) => RpNewStructTyped(x.structType, map(x.values, (v: RpNamedValue) => RpNamedValue(v.name, rpRenameVars(v.value, renames))))
    (x: RpTagTask) => RpTagTask(rpRenameVars(x.task, renames), x.targetType)
    (x: RpGlobalFunction) => RpGlobalFunction(x.name, rpRenameVarsOpt(x.object, renames), x.external, x.cSymbol, x.impure, x.sync)
    (x: RpVirtualFunction) => RpVirtualFunction(x.name, rpRenameVars(x.object, renames), x.fastLookup)
    (x: RpPointerTo) => RpPointerTo(rpRenameVars(x.value, renames))
    (x: RpStackVar) => RpStackVar(x.fieldType, renameLookup(renames, x.name))
    (x: RpGlobalVar) => r   # GlobalVar.rename_vars is identity in Python
    (x: RpObjectField) => RpObjectField(x.fieldType, rpRenameVars(x.pointer, renames), x.objectName, x.field, rpRenameVarsOpt(x.index, renames), x.fresh)
    (x: RpArrayElement) => RpArrayElement(x.elementType, rpRenameVars(x.pointer, renames), x.objectName, x.field, x.lengthField, rpRenameVars(x.index, renames), x.checked)
    (x: RpFunField) => RpFunField(rpRenameVars(x.ffFun, renames), x.ffPart)
    (x: RpMakeFun) => RpMakeFun(rpRenameVars(x.mfCode, renames), rpRenameVars(x.mfEnv, renames))
    (o: RParam) => r   # base default: self

fun rpRenameVarsOpt(o: RParam|None, renames: List<RpRename>): RParam|None
  ret match(o)
    (v: RParam) => rpRenameVars(v, renames)
    ()          => None

# ── replace_params(replacer) ─────────────────────────────────────────────────
# Every override in Python calls `replacer(dataclasses.replace(self, ...))` —
# i.e. rebuild the node with its children replaced FIRST, then run the WHOLE
# node through the replacer. LParam.replace_params additionally checked-casts
# the replacer's result back to LParam; StackVar/GlobalVar inherit that,
# ObjectField re-implements it (same effect). We thread `RParam` throughout
# and rely on callers only ever installing a replacer that preserves the
# LParam-shape invariant at those call sites, exactly as Python's static type
# checker (not its runtime) enforced it.

fun rpReplaceParams(r: RParam, replacer: (:RParam): RParam): RParam
  ret match(r)
    (x: RpInitArray) => replacer(with x(values = map(x.values, (v: RParam) => rpReplaceParams(v, replacer))))
    (x: RpNewStruct) => replacer(with x(values = map(x.values, (v: RpNamedValue) => with v(value = rpReplaceParams(v.value, replacer)))))
    (x: RpRuntimeInvoke) => replacer(with x(parameters = rpReplaceParams(x.parameters, replacer)))
    (x: RpStructField) => replacer(with x(structVal = rpReplaceParams(x.structVal, replacer)))
    (x: RpIntEqConst) => replacer(with x(value = rpReplaceParams(x.value, replacer)))
    (x: RpVtableDiscriminator) => replacer(with x(value = rpReplaceParams(x.value, replacer)))
    (x: RpObjVtableEq) => replacer(with x(value = rpReplaceParams(x.value, replacer)))
    (x: RpSyncWrap) => replacer(with x(value = rpReplaceParams(x.value, replacer)))
    (x: RpNewStructTyped) => replacer(with x(values = map(x.values, (v: RpNamedValue) => with v(value = rpReplaceParams(v.value, replacer)))))
    (x: RpTagTask) => replacer(with x(task = rpReplaceParams(x.task, replacer)))
    (x: RpGlobalFunction) => replacer(with x(object = rpReplaceParamsOpt(x.object, replacer)))
    (x: RpVirtualFunction) => replacer(with x(object = rpReplaceParams(x.object, replacer)))
    (x: RpPointerTo) => replacer(with x(value = rpReplaceParams(x.value, replacer)))
    (x: RpStackVar) => replacer(r)
    (x: RpGlobalVar) => replacer(r)
    (x: RpObjectField) => replacer(with x(pointer = rpReplaceParams(x.pointer, replacer),
                                          index   = rpReplaceParamsOpt(x.index, replacer)))
    (x: RpArrayElement) => replacer(with x(pointer = rpReplaceParams(x.pointer, replacer),
                                           index   = rpReplaceParams(x.index, replacer)))
    (x: RpFunField) => replacer(with x(ffFun = rpReplaceParams(x.ffFun, replacer)))
    (x: RpMakeFun) => replacer(with x(mfCode = rpReplaceParams(x.mfCode, replacer),
                                      mfEnv  = rpReplaceParams(x.mfEnv, replacer)))
    (o: RParam) => replacer(r)   # base default: replacer(self)

fun rpReplaceParamsOpt(o: RParam|None, replacer: (:RParam): RParam): RParam|None
  ret match(o)
    (v: RParam) => rpReplaceParams(v, replacer)
    ()          => None

# ── get_live_vars() — set of StackVar-shaped RParam values ──────────────────

fun eqRpStackVar(a: RParam, b: RParam): Bool
  ret match(a)
    (x: RpStackVar) => match(b)
      (y: RpStackVar) => x.name == y.name && eqCgType(x.fieldType, y.fieldType)
      (o: RParam)     => false
    (o: RParam) => false

fun rpStackVarMember(l: List<RParam>, x: RParam): Bool
  ret any<RParam>(l, (y: RParam) => eqRpStackVar(x, y))

# A SET UNION. Python's get_live_vars returns a frozenset, and every consumer
# here treats the result the same way — membership (stack_promotion), a count
# (ssa_defs), an `any` (string_accumulation), or a fold into another set
# (deadstores). So the order elements land in is not observed and new members
# go on the front.
#
# Not a stdlib Set<RParam> because the identity is a CUSTOM one: two live vars
# are the same var when their name and C type match, and every non-StackVar
# RParam is outside the set entirely. Derived equality on the RParam enum would
# compare the whole tree instead.
fun rpStackVarUnion(a: List<RParam>, b: List<RParam>): List<RParam>
  ret fold(b, a, (acc: List<RParam>, x: RParam) =>
        rpStackVarMember(acc, x) ? acc : prepend<RParam>(x, acc))

fun rpGetLiveVars(r: RParam): List<RParam>
  ret match(r)
    (x: RpInitArray) => fold(x.values, List<RParam>(), (acc: List<RParam>, v: RParam) => rpStackVarUnion(acc, rpGetLiveVars(v)))
    (x: RpNewStruct) => fold(x.values, List<RParam>(), (acc: List<RParam>, v: RpNamedValue) => rpStackVarUnion(acc, rpGetLiveVars(v.value)))
    (x: RpRuntimeInvoke) => rpGetLiveVars(x.parameters)
    (x: RpStructField) => rpGetLiveVars(x.structVal)
    (x: RpIntEqConst) => rpGetLiveVars(x.value)
    (x: RpVtableDiscriminator) => rpGetLiveVars(x.value)
    (x: RpObjVtableEq) => rpGetLiveVars(x.value)
    (x: RpSyncWrap) => rpGetLiveVars(x.value)
    (x: RpNewStructTyped) => fold(x.values, List<RParam>(), (acc: List<RParam>, v: RpNamedValue) => rpStackVarUnion(acc, rpGetLiveVars(v.value)))
    (x: RpTagTask) => rpGetLiveVars(x.task)
    (x: RpGlobalFunction) => rpGetLiveVarsOpt(x.object)
    (x: RpVirtualFunction) => rpGetLiveVars(x.object)
    (x: RpPointerTo) => rpGetLiveVars(x.value)
    (x: RpStackVar) => list1(r)
    (x: RpGlobalVar) => List<RParam>()
    (x: RpObjectField) => rpStackVarUnion(rpGetLiveVars(x.pointer), rpGetLiveVarsOpt(x.index))
    (x: RpArrayElement) => rpStackVarUnion(rpGetLiveVars(x.pointer), rpGetLiveVars(x.index))
    (x: RpFunField) => rpGetLiveVars(x.ffFun)
    (x: RpMakeFun) => rpStackVarUnion(rpGetLiveVars(x.mfCode), rpGetLiveVars(x.mfEnv))
    (o: RParam) => List<RParam>()   # base default: empty set

fun rpGetLiveVarsOpt(o: RParam|None): List<RParam>
  ret match(o)
    (v: RParam) => rpGetLiveVars(v)
    ()          => List<RParam>()

# ── full structural equality (dict-key semantics for the CSE cache) ────────

fun [tail] eqRpNamedValues(a: List<RpNamedValue>, b: List<RpNamedValue>): Bool
  ret match(head<RpNamedValue>(a))
    (fa: RpNamedValue) => match(head<RpNamedValue>(b))
      (fb: RpNamedValue) => fa.name == fb.name && eqRParam(fa.value, fb.value) && eqRpNamedValues(tail<RpNamedValue>(a), tail<RpNamedValue>(b))
      ()                  => false
    () => isEmpty<RpNamedValue>(b)

fun [tail] eqRParamList(a: List<RParam>, b: List<RParam>): Bool
  ret match(head<RParam>(a))
    (xa: RParam) => match(head<RParam>(b))
      (xb: RParam) => eqRParam(xa, xb) && eqRParamList(tail<RParam>(a), tail<RParam>(b))
      ()           => false
    () => isEmpty<RParam>(b)

fun eqRParamOpt(a: RParam|None, b: RParam|None): Bool
  ret match(a)
    (xa: RParam) => match(b)
      (xb: RParam) => eqRParam(xa, xb)
      ()           => false
    () => match(b)
      (xb: RParam) => false
      ()           => true

fun eqStringOpt(a: String|None, b: String|None): Bool
  ret match(a)
    (xa: String) => match(b)
      (xb: String) => xa == xb
      ()           => false
    () => match(b)
      (xb: String) => false
      ()           => true

fun eqRParam(a: RParam, b: RParam): Bool
  ret match(a)
    (x: RpInitArray) => match(b)
      (y: RpInitArray) => eqCgType(x.memberType, y.memberType) && eqRParamList(x.values, y.values)
      (o: RParam) => false
    (x: RpNewStruct) => match(b)
      (y: RpNewStruct) => eqRpNamedValues(x.values, y.values)
      (o: RParam) => false
    (x: RpRuntimeInvoke) => match(b)
      (y: RpRuntimeInvoke) => x.function == y.function && eqRParam(x.parameters, y.parameters) && eqCgType(x.resultType, y.resultType)
      (o: RParam) => false
    (x: RpStructField) => match(b)
      (y: RpStructField) => eqRParam(x.structVal, y.structVal) && x.field == y.field
      (o: RParam) => false
    (x: RpString) => match(b)
      (y: RpString) => x.value == y.value
      (o: RParam) => false
    (x: RpInteger) => match(b)
      (y: RpInteger) => x.value == y.value && x.precision == y.precision
      (o: RParam) => false
    (x: RpFloat) => match(b)
      (y: RpFloat) => x.value == y.value && x.precision == y.precision
      (o: RParam) => false
    (x: RpIntEqConst) => match(b)
      (y: RpIntEqConst) => eqRParam(x.value, y.value) && x.constVal == y.constVal
      (o: RParam) => false
    (x: RpNullPointer) => match(b)
      (y: RpNullPointer) => true
      (o: RParam) => false
    (x: RpStaticObjectRef) => match(b)
      (y: RpStaticObjectRef) => x.name == y.name
      (o: RParam) => false
    (x: RpVtableDiscriminator) => match(b)
      (y: RpVtableDiscriminator) => eqRParam(x.value, y.value)
      (o: RParam) => false
    (x: RpObjVtableEq) => match(b)
      (y: RpObjVtableEq) => eqRParam(x.value, y.value) && eqStringOpt(x.className, y.className) && eqStringOpt(x.externSymbol, y.externSymbol)
      (o: RParam) => false
    (x: RpSyncWrap) => match(b)
      (y: RpSyncWrap) => eqRParam(x.value, y.value) && eqCgType(x.wrapperType, y.wrapperType)
      (o: RParam) => false
    (x: RpZeroOf) => match(b)
      (y: RpZeroOf) => eqCgType(x.valueType, y.valueType)
      (o: RParam) => false
    (x: RpNewStructTyped) => match(b)
      (y: RpNewStructTyped) => eqCgType(x.structType, y.structType) && eqRpNamedValues(x.values, y.values)
      (o: RParam) => false
    (x: RpTagTask) => match(b)
      (y: RpTagTask) => eqRParam(x.task, y.task) && eqCgType(x.targetType, y.targetType)
      (o: RParam) => false
    (x: RpGlobalFunction) => match(b)
      (y: RpGlobalFunction) => x.name == y.name && eqRParamOpt(x.object, y.object) && x.external == y.external
                               && eqStringOpt(x.cSymbol, y.cSymbol) && x.impure == y.impure && x.sync == y.sync
      (o: RParam) => false
    (x: RpVirtualFunction) => match(b)
      (y: RpVirtualFunction) => x.name == y.name && eqRParam(x.object, y.object) && x.fastLookup == y.fastLookup
      (o: RParam) => false
    (x: RpPointerTo) => match(b)
      (y: RpPointerTo) => eqRParam(x.value, y.value)
      (o: RParam) => false
    (x: RpStackVar) => match(b)
      (y: RpStackVar) => eqCgType(x.fieldType, y.fieldType) && x.name == y.name
      (o: RParam) => false
    (x: RpGlobalVar) => match(b)
      (y: RpGlobalVar) => eqCgType(x.fieldType, y.fieldType) && x.name == y.name
      (o: RParam) => false
    (x: RpObjectField) => match(b)
      (y: RpObjectField) => eqCgType(x.fieldType, y.fieldType) && eqRParam(x.pointer, y.pointer) && x.objectName == y.objectName
                            && x.field == y.field && eqRParamOpt(x.index, y.index)
                            # `fresh` is compare=False in Python (provenance, not identity)
      (o: RParam) => false
    (x: RpArrayElement) => match(b)
      (y: RpArrayElement) => eqCgType(x.elementType, y.elementType) && eqRParam(x.pointer, y.pointer) && x.objectName == y.objectName
                             && x.field == y.field && x.lengthField == y.lengthField && eqRParam(x.index, y.index) && x.checked == y.checked
      (o: RParam) => false
    (x: RpFunField) => match(b)
      (y: RpFunField) => eqRParam(x.ffFun, y.ffFun) && x.ffPart == y.ffPart
      (o: RParam) => false
    (x: RpMakeFun) => match(b)
      (y: RpMakeFun) => eqRParam(x.mfCode, y.mfCode) && eqRParam(x.mfEnv, y.mfEnv)
      (o: RParam) => false

# ── to_c ─────────────────────────────────────────────────────────────────────

# Union slotting of closures (param.py FunField/MakeFun to_c, byte-exact).
fun rpToCFunField(x: RpFunField, cache0: List<CgCacheEntry>): (text: String, cache: List<CgCacheEntry>)
  let sub = rpToC(x.ffFun, cache0)
  ret (x.ffPart == "f" ? "((intptr_t)(" + sub.text + ").f)"
                       : "((" + sub.text + ").o)", sub.cache)

fun rpToCMakeFun(x: RpMakeFun, cache0: List<CgCacheEntry>): (text: String, cache: List<CgCacheEntry>)
  let codeC = rpToC(x.mfCode, cache0)
  let envC = rpToC(x.mfEnv, codeC.cache)
  ret ("((fun_t){.f=(void*)(" + codeC.text + "),.o=" + envC.text + "})", envC.cache)

fun rpToC(r: RParam, cache: List<CgCacheEntry>): (text: String, cache: List<CgCacheEntry>)
  ret match(r)
    (x: RpInitArray) => rpToCInitArray(x, cache)
    (x: RpNewStruct) => rpToCNewStruct(x, cache)
    (x: RpRuntimeInvoke) => rpToCRuntimeInvoke(x, cache)
    (x: RpStructField) => rpToCStructField(x, cache)
    (x: RpString) => (cgStrLiteral(x.value), cache)
    (x: RpInteger) => rpToCInteger(x, cache)
    (x: RpFloat) => cgInitialise(CgFloat(x.precision), CgLitFloat(x.value), cache)
    (x: RpIntEqConst) => rpToCIntEqConst(x, cache)
    (x: RpNullPointer) => ("((object_t*)0)", cache)
    (x: RpStaticObjectRef) => ("((object_t*)&" + mangleName(x.name) + "_data)", cache)
    (x: RpVtableDiscriminator) => rpToCVtableDiscriminator(x, cache)
    (x: RpObjVtableEq) => rpToCObjVtableEq(x, cache)
    (x: RpSyncWrap) => rpToCSyncWrap(x, cache)
    (x: RpZeroOf) => rpToCZeroOf(x, cache)
    (x: RpNewStructTyped) => rpToCNewStructTyped(x, cache)
    (x: RpTagTask) => rpToCTagTask(x, cache)
    (x: RpGlobalFunction) => rpToCGlobalFunction(x, cache)
    (x: RpFunField) => rpToCFunField(x, cache)
    (x: RpMakeFun) => rpToCMakeFun(x, cache)
    (x: RpVirtualFunction) => rpToCVirtualFunction(x, cache)
    (x: RpPointerTo) => rpToCPointerTo(x, cache)
    (x: RpStackVar) => (mangleName(x.name), cache)
    (x: RpGlobalVar) => (mangleName(x.name), cache)
    (x: RpObjectField) => rpToCObjectField(x, cache)
    (x: RpArrayElement) => rpToCArrayElement(x, cache)

fun rpToCInitArray(x: RpInitArray, cache0: List<CgCacheEntry>): (text: String, cache: List<CgCacheEntry>)
  let result = fold(x.values, ("", cache0, true), (acc: (text: String, cache: List<CgCacheEntry>, first: Bool), v: RParam) => rpToCInitArrayStep(acc, v))
  ret ("{" + result.text + "}", result.cache)

fun rpToCInitArrayStep(acc: (text: String, cache: List<CgCacheEntry>, first: Bool), v: RParam): (text: String, cache: List<CgCacheEntry>, first: Bool)
  let sub = rpToC(v, acc.cache)
  ret (acc.first ? sub.text : acc.text + ", " + sub.text, sub.cache, false)

fun rpToCNewStruct(x: RpNewStruct, cache0: List<CgCacheEntry>): (text: String, cache: List<CgCacheEntry>)
  let xtype = rpGetType(RpNewStruct(x.values))
  let declared = cgDeclare(xtype, cache0)
  ret atMost(chain(x.values), 2)
    ? rpToCNewStructShort(x.values, declared.text, declared.cache)
    : rpToCNewStructLong(x.values, declared.text, declared.cache)

fun rpToCNewStructShort(values: List<RpNamedValue>, typeName: String, cache0: List<CgCacheEntry>): (text: String, cache: List<CgCacheEntry>)
  let result = fold(values, ("", cache0, true), (acc: (text: String, cache: List<CgCacheEntry>, first: Bool), v: RpNamedValue) => rpToCNewStructShortStep(acc, v))
  ret ("(" + typeName + "){" + result.text + "}", result.cache)

fun rpToCNewStructShortStep(acc: (text: String, cache: List<CgCacheEntry>, first: Bool), v: RpNamedValue): (text: String, cache: List<CgCacheEntry>, first: Bool)
  let sub = rpToC(v.value, acc.cache)
  let piece = "." + mangleName(v.name) + " = " + sub.text
  ret (acc.first ? piece : acc.text + ", " + piece, sub.cache, false)

fun rpToCNewStructLong(values: List<RpNamedValue>, typeName: String, cache0: List<CgCacheEntry>): (text: String, cache: List<CgCacheEntry>)
  let result = fold(values, ("", cache0), (acc: (text: String, cache: List<CgCacheEntry>), v: RpNamedValue) => rpToCNewStructLongStep(acc, v))
  ret ("(" + typeName + "){" + result.text + "\n    }", result.cache)

fun rpToCNewStructLongStep(acc: (text: String, cache: List<CgCacheEntry>), v: RpNamedValue): (text: String, cache: List<CgCacheEntry>)
  let sub = rpToC(v.value, acc.cache)
  ret (acc.text + "\n        ." + mangleName(v.name) + " = " + sub.text + ",", sub.cache)

fun rpToCRuntimeInvoke(x: RpRuntimeInvoke, cache0: List<CgCacheEntry>): (text: String, cache: List<CgCacheEntry>)
  ret match(x.parameters)
    (p: RpNewStruct) => rpToCRuntimeInvokeNewStruct(x.function, p.values, cache0)
    (p: RParam)      => rpToCRuntimeInvokeGeneric(x.function, p, cache0)

fun rpToCRuntimeInvokeNewStruct(function: String, values: List<RpNamedValue>, cache0: List<CgCacheEntry>): (text: String, cache: List<CgCacheEntry>)
  let result = fold(values, ("", cache0, true), (acc: (text: String, cache: List<CgCacheEntry>, first: Bool), v: RpNamedValue) => rpToCArgStep(acc, v.value))
  ret (function + "(" + result.text + ")", result.cache)

fun rpToCArgStep(acc: (text: String, cache: List<CgCacheEntry>, first: Bool), v: RParam): (text: String, cache: List<CgCacheEntry>, first: Bool)
  let sub = rpToC(v, acc.cache)
  ret (acc.first ? sub.text : acc.text + ", " + sub.text, sub.cache, false)

fun rpToCRuntimeInvokeGeneric(function: String, p: RParam, cache0: List<CgCacheEntry>): (text: String, cache: List<CgCacheEntry>)
  let sub = rpToC(p, cache0)
  let ptype = rpGetType(p)
  ret match(cgFieldsOf(ptype))
    (fields: List<CgField>) => (function + "(" + join(map(fields, (f: CgField) => sub.text + "." + f.fieldName), ", ") + ")", sub.cache)
    ()                       => (function + "()", sub.cache)   # unreachable (Python raises ValueError earlier)

fun rpToCStructField(x: RpStructField, cache0: List<CgCacheEntry>): (text: String, cache: List<CgCacheEntry>)
  let sub = rpToC(x.structVal, cache0)
  ret ("(" + sub.text + "." + mangleName(x.field) + ")", sub.cache)

fun rpToCInteger(x: RpInteger, cache: List<CgCacheEntry>): (text: String, cache: List<CgCacheEntry>)
  ret x.precision == 0
    ? (cgBigintLiteral(x.value), cache)
    : cgInitialise(CgInt(x.precision), CgLitInt(x.value), cache)

fun rpToCIntEqConst(x: RpIntEqConst, cache0: List<CgCacheEntry>): (text: String, cache: List<CgCacheEntry>)
  let sub = rpToC(x.value, cache0)
  ret (sub.text + " == " + String(x.constVal), sub.cache)

fun rpToCVtableDiscriminator(x: RpVtableDiscriminator, cache0: List<CgCacheEntry>): (text: String, cache: List<CgCacheEntry>)
  let sub = rpToC(x.value, cache0)
  ret ("(object_get_vtable(" + sub.text + ")->discriminator)", sub.cache)

fun rpToCObjVtableEq(x: RpObjVtableEq, cache0: List<CgCacheEntry>): (text: String, cache: List<CgCacheEntry>)
  let sub = rpToC(x.value, cache0)
  let target = match(x.className)
    (cn: String) => "obj_" + mangleName(cn)
    ()           => "(vtable_t*)&" + orNullOpt(x.externSymbol)
  ret ("object_is_instance(" + sub.text + ", " + target + ")", sub.cache)

fun rpToCSyncWrap(x: RpSyncWrap, cache0: List<CgCacheEntry>): (text: String, cache: List<CgCacheEntry>)
  let valueC = rpToC(x.value, cache0)
  let declared = cgDeclare(x.wrapperType, valueC.cache)
  ret ("((" + declared.text + "){.value=" + valueC.text + ",.task=((object_t*)0)})", declared.cache)

fun rpToCZeroOf(x: RpZeroOf, cache0: List<CgCacheEntry>): (text: String, cache: List<CgCacheEntry>)
  ret match(x.valueType)
    (d: CgDataPointer) => ("((object_t*)0)", cache0)
    (i: CgInt) => ("0", cache0)
    (fp: CgFuncPointer) => ("((fun_t){0})", cache0)
    (o: CgType) => rpToCZeroOfCompound(o, cache0)

fun rpToCZeroOfCompound(vt: CgType, cache0: List<CgCacheEntry>): (text: String, cache: List<CgCacheEntry>)
  let declared = cgDeclare(vt, cache0)
  let init = rpZeroOfInitText(vt)
  ret ("((" + declared.text + ")" + init + ")", declared.cache)

fun rpZeroOfInitText(vt: CgType): String
  ret match(vt)
    (s: CgStruct) => isEmpty<CgField>(s.fields) ? "{}" : "{0}"
    (o: CgType)   => "{0}"

fun rpToCNewStructTyped(x: RpNewStructTyped, cache0: List<CgCacheEntry>): (text: String, cache: List<CgCacheEntry>)
  let declared = cgDeclare(x.structType, cache0)
  ret atMost(chain(x.values), 2)
    ? rpToCNewStructShort(x.values, declared.text, declared.cache)
    : rpToCNewStructLong(x.values, declared.text, declared.cache)

fun rpToCTagTask(x: RpTagTask, cache0: List<CgCacheEntry>): (text: String, cache: List<CgCacheEntry>)
  let taskC = rpToC(x.task, cache0)
  ret match(x.targetType)
    (d: CgDataPointer) => ("((object_t*)((uintptr_t)" + taskC.text + " | PTR_TAG_TASK))", taskC.cache)
    (fp: CgFuncPointer) => ("((fun_t){.f=NULL,.o=(void*)((uintptr_t)" + taskC.text + " | PTR_TAG_TASK)})", taskC.cache)
    (w: CgTaskWrapper) => rpToCTagTaskWrapper(w, taskC.text, taskC.cache)
    (s: CgStruct) => rpToCTagTaskStruct(s.fields, taskC.text, taskC.cache)
    (m: CgImmediateStruct) => rpToCTagTaskStruct(m.fields, taskC.text, taskC.cache)
    (o: CgType) => ("", taskC.cache)   # unreachable (Python raises ValueError)

fun rpToCTagTaskWrapper(w: CgTaskWrapper, taskC: String, cache0: List<CgCacheEntry>): (text: String, cache: List<CgCacheEntry>)
  let innerZero = rpToC(RpZeroOf(w.inner), cache0)
  let declared = cgDeclare(CgTaskWrapper(w.inner), innerZero.cache)
  ret ("((" + declared.text + "){.value=" + innerZero.text + ",.task=" + taskC + "})", declared.cache)

fun rpToCTagTaskStruct(fields: List<CgField>, taskC: String, cache0: List<CgCacheEntry>): (text: String, cache: List<CgCacheEntry>)
  ret match(cgFirstPointerFieldOfFields(fields))
    (fname: String) => rpToCTagTaskStructBody(fields, fname, taskC, cache0)
    ()               => ("", cache0)   # unreachable (Python raises ValueError)

# `cgFirstPointerField` takes a CgType; TagTask already has the field list.
fun cgFirstPointerFieldOfFields(fields: List<CgField>): String|None
  ret cgFirstPointerField(CgStruct(fields))

fun rpToCTagTaskStructBody(fields: List<CgField>, fname: String, taskC: String, cache0: List<CgCacheEntry>): (text: String, cache: List<CgCacheEntry>)
  let declared = cgDeclare(CgStruct(fields), cache0)
  let result = fold(fields, ("", declared.cache, true), (acc: (text: String, cache: List<CgCacheEntry>, first: Bool), f: CgField) => rpToCTagTaskFieldStep(acc, f, fname, taskC))
  ret ("((" + declared.text + "){" + result.text + "})", result.cache)

fun rpToCTagTaskFieldStep(acc: (text: String, cache: List<CgCacheEntry>, first: Bool), f: CgField, fname: String, taskC: String): (text: String, cache: List<CgCacheEntry>, first: Bool)
  ret f.fieldName == fname
    ? rpToCTagTaskFieldStepTagged(acc, f, taskC)
    : rpToCTagTaskFieldStepZero(acc, f)

fun rpToCTagTaskFieldStepTagged(acc: (text: String, cache: List<CgCacheEntry>, first: Bool), f: CgField, taskC: String): (text: String, cache: List<CgCacheEntry>, first: Bool)
  let piece = "." + mangleName(f.fieldName) + " = (object_t*)((uintptr_t)" + taskC + " | PTR_TAG_TASK)"
  ret (acc.first ? piece : acc.text + ", " + piece, acc.cache, false)

fun rpToCTagTaskFieldStepZero(acc: (text: String, cache: List<CgCacheEntry>, first: Bool), f: CgField): (text: String, cache: List<CgCacheEntry>, first: Bool)
  let sub = rpToC(RpZeroOf(f.fieldType), acc.cache)
  let piece = "." + mangleName(f.fieldName) + " = " + sub.text
  ret (acc.first ? piece : acc.text + ", " + piece, sub.cache, false)

fun rpToCGlobalFunction(x: RpGlobalFunction, cache0: List<CgCacheEntry>): (text: String, cache: List<CgCacheEntry>)
  let fRef = match(x.cSymbol)
    (s: String) => s
    ()          => mangleName(x.name)
  ret match(x.object)
    (o: RParam) => rpToCGlobalFunctionWithObject(fRef, o, cache0)
    ()           => ("((fun_t){.f=" + fRef + ",.o=NULL})", cache0)

fun rpToCGlobalFunctionWithObject(fRef: String, o: RParam, cache0: List<CgCacheEntry>): (text: String, cache: List<CgCacheEntry>)
  let sub = rpToC(o, cache0)
  ret ("((fun_t){.f=" + fRef + ",.o=" + sub.text + "})", sub.cache)

fun rpToCVirtualFunction(x: RpVirtualFunction, cache0: List<CgCacheEntry>): (text: String, cache: List<CgCacheEntry>)
  let sub = rpToC(x.object, cache0)
  ret ("(vtable_lookup(" + sub.text + ", __FUNCTION_ID__" + mangleName(x.name) + "))", sub.cache)

fun rpToCPointerTo(x: RpPointerTo, cache0: List<CgCacheEntry>): (text: String, cache: List<CgCacheEntry>)
  let sub = rpToC(x.value, cache0)
  ret ("(object_t*)&" + sub.text, sub.cache)

fun rpToCObjectField(x: RpObjectField, cache0: List<CgCacheEntry>): (text: String, cache: List<CgCacheEntry>)
  let pointerC = rpToC(x.pointer, cache0)
  let base = "((" + mangleName(x.objectName) + "_t*)" + pointerC.text + ")->" + mangleName(x.field)
  ret match(x.index)
    (idx: RParam) => rpToCObjectFieldIndexed(base, idx, pointerC.cache)
    ()             => (base, pointerC.cache)

fun rpToCObjectFieldIndexed(base: String, idx: RParam, cache0: List<CgCacheEntry>): (text: String, cache: List<CgCacheEntry>)
  let sub = rpToC(idx, cache0)
  ret (base + ".a[" + sub.text + "]", sub.cache)

fun rpToCArrayElement(x: RpArrayElement, cache0: List<CgCacheEntry>): (text: String, cache: List<CgCacheEntry>)
  let pointerC = rpToC(x.pointer, cache0)
  let obj = "((" + mangleName(x.objectName) + "_t*)" + pointerC.text + ")"
  let idxC = rpToC(x.index, pointerC.cache)
  let base = obj + "->" + mangleName(x.field) + ".a"
  let declared = cgDeclare(x.elementType, idxC.cache)
  let elemPtr = declared.text + "*"
  ret x.checked
    ? rpToCArrayElementChecked(x, obj, idxC.text, base, elemPtr, declared.cache)
    : ("((" + elemPtr + ")" + base + ")[" + idxC.text + "]", declared.cache)

fun rpToCArrayElementChecked(x: RpArrayElement, obj: String, idx: String, base: String, elemPtr: String, cache: List<CgCacheEntry>): (text: String, cache: List<CgCacheEntry>)
  let length2 = obj + "->" + mangleName(x.lengthField)
  ret ("((" + elemPtr + ")array_bounds_check(" + idx + ", " + length2 + ", " + base + "))[" + idx + "]", cache)

# ── to_c_store — only meaningful for RpStackVar / RpGlobalVar / RpObjectField
# (Python's LParam.to_c_store, overridden by ObjectField). ─────────────────

fun rpToCStore(r: RParam, cache0: List<CgCacheEntry>, value: String): (text: String, cache: List<CgCacheEntry>)
  ret match(r)
    (x: RpObjectField) => rpToCStoreObjectField(x, cache0, value)
    (o: RParam)         => rpToCStoreDefault(r, cache0, value)

fun rpToCStoreDefault(r: RParam, cache0: List<CgCacheEntry>, value: String): (text: String, cache: List<CgCacheEntry>)
  let sub = rpToC(r, cache0)
  ret ("    " + sub.text + " = " + value + ";\n", sub.cache)

fun rpToCStoreObjectField(x: RpObjectField, cache0: List<CgCacheEntry>, value: String): (text: String, cache: List<CgCacheEntry>)
  let pointerC = rpToC(x.pointer, cache0)
  let fieldRefBase = "((" + mangleName(x.objectName) + "_t*)" + pointerC.text + ")->" + mangleName(x.field)
  ret match(x.index)
    (idx: RParam) => rpToCStoreObjectFieldIndexed(x, fieldRefBase, idx, pointerC.cache, value)
    ()             => rpToCStoreObjectFieldFinish(x, fieldRefBase, pointerC.cache, value)

fun rpToCStoreObjectFieldIndexed(x: RpObjectField, fieldRefBase: String, idx: RParam, cache0: List<CgCacheEntry>, value: String): (text: String, cache: List<CgCacheEntry>)
  let idxC = rpToC(idx, cache0)
  ret rpToCStoreObjectFieldFinish(x, fieldRefBase + ".a[" + idxC.text + "]", idxC.cache, value)

fun rpToCStoreObjectFieldFinish(x: RpObjectField, fieldRef: String, cache0: List<CgCacheEntry>, value: String): (text: String, cache: List<CgCacheEntry>)
  ret cgHasPointers(x.fieldType) && !x.fresh
    ? rpToCStoreObjectFieldBarrier(x, fieldRef, cache0, value)
    : ("    " + fieldRef + " = " + value + ";\n", cache0)

fun rpToCStoreObjectFieldBarrier(x: RpObjectField, fieldRef: String, cache0: List<CgCacheEntry>, value: String): (text: String, cache: List<CgCacheEntry>)
  let declared = cgDeclare(x.fieldType, cache0)
  let mask = toPointerMask(x.fieldType, declared.text)
  ret ("    GC_WRITE_BARRIER(" + fieldRef + ", " + mask + ");\n    " + fieldRef + " = " + value + ";\n", declared.cache)

# ── `NewStruct.__add__` (used by lowering passes, not within this file) ────

fun rpNewStructAdd(a: RpNewStruct, b: RpNewStruct): RParam
  ret RpNewStruct(concat<RpNamedValue>(a.values, b.values))

# ── `union_struct` — builds an exhaustive RpNewStructTyped for a union slot
# struct, zero-filling any unspecified fields. ──────────────────────────────

fun rpZeroFor(fieldType: CgType): RParam
  ret match(fieldType)
    (d: CgDataPointer) => RpNullPointer()
    (i: CgInt) => RpInteger(0, i.precision)
    (p: CgIntPtr) => RpInteger(0, 64)
    (f: CgFloat) => RpFloat(0.0, f.precision)
    (o: CgType) => RpNullPointer()   # unreachable (Python raises ValueError)

fun unionStruct(container: CgType, namedValues: List<RpNamedValue>): RParam
  ret match(container)
    (s: CgStruct) => RpNewStructTyped(container, map(s.fields, (f: CgField) => unionStructField(f, namedValues)))
    (o: CgType)   => RpNewStructTyped(container, List<RpNamedValue>())   # unreachable

fun unionStructField(f: CgField, namedValues: List<RpNamedValue>): RpNamedValue
  ret match(rpNamedValuesGet(namedValues, f.fieldName))
    (v: RParam) => RpNamedValue(f.fieldName, v)
    ()          => RpNamedValue(f.fieldName, rpZeroFor(f.fieldType))

fun [tail] rpNamedValuesGet(values: List<RpNamedValue>, name: String): RParam|None
  ret match(head<RpNamedValue>(values))
    (v: RpNamedValue) => v.name == name ? v.value : rpNamedValuesGet(tail<RpNamedValue>(values), name)
    ()                => None
