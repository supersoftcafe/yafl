namespace Bootstrap::Ir

import System

import Bootstrap::Ast

import Bootstrap::Codegen
import Bootstrap::Frontend
import Bootstrap::Lower::Ir
import Bootstrap::StdlibCandidates



# bootstrap/ir.yafl — port of compiler/codegen/ir.py: `Function`, `Object`,
# `Global` — the top-level IR units gen.py assembles into a program, plus the
# Function-local optimisation passes (lower_phis, simplify_control_flow,
# strip_unused_operations, fold_struct_fields, copy_propagate,
# eliminate_common_subexpressions).
#
# NAMING: "Cg"-prefixed (CgFunction/CgObject/CgGlobal) for the same reason as
# typedecl.yafl's CgType family — plain "Function"/"Object"/"Global" are free
# today but this keeps the whole codegen surface visually consistent.
#
# `available: dict[RParam, StackVar]` (the CSE cache) becomes an association
# list `List<AvailEntry>` keyed by `eqRParam` (full structural equality,
# defined in param.yafl) — this is the ONE place in the ported codegen
# substrate that actually needs full RParam structural equality as a map key,
# matching Python's frozen-dataclass `__hash__`/`__eq__`.

class [final] CgFuncSlot(slotVirtualName: String, slotGlobalName: String)

class [final] CgFunction(fnName: String, fnParams: CgType, fnResult: CgType, fnStackVars: CgType,
                          fnOps: List<Op>, fnComment: String, fnForeignSymbol: String|None,
                          fnSync: Bool, fnTail: Bool, fnBypassAsync: Bool, fnAlwaysInline: Bool)

# objIsPinnable: [pinnable] — immutable EXCEPT inside a late pin, which
# publishes into a write-once field. Unlike objIsMutable the object still
# relocates, so its READS must follow forwarding (lower/ir/pinnable_reads);
# a pointer taken before a relocation would otherwise see the pre-write copy.
# Declared LAST with a default so the eight other construction sites — all
# compiler-emitted classes, none of them pinnable — stay untouched.
class [final] CgObject(objName: String, objExtends: List<String>, objFunctions: List<CgFuncSlot>,
                        objFields: CgType, objLengthField: String|None, objComment: String,
                        objIsForeign: Bool, objIsMutable: Bool, objDiscriminator: Int,
                        objIsPinnable: Bool = false)

class [final] CgGlobal(globalName: String, globalType: CgType, globalInit: RParam|None,
                        globalObjectName: String|None, globalLazyInitFunction: String|None,
                        globalLazyInitFlag: String|None)

# ── small shared helpers ─────────────────────────────────────────────────────

fun forceOp(x: Op|None): Op
  ret match(x)
    (o: Op) => o
    ()      => OpAbort("", List<RParam>())   # unreachable: only used at in-bounds indices

fun pyStrOpt(o: String|None): String
  # Mirrors Python's f"{value}" on a str|None: None interpolates as "None".
  ret match(o)
    (s: String) => s
    ()          => "None"

class [final] StrCount(scName: String, scCount: Int)

fun [tail] strCountGet(l: List<StrCount>, name: String): Int
  ret match(head<StrCount>(l))
    (e: StrCount) => e.scName == name ? e.scCount : strCountGet(tail<StrCount>(l), name)
    ()             => 0

# A bump REBUILDS the whole table, so the rebuild goes into a builder; a name
# not already present is appended at the end.
fun strCountIncr(l: List<StrCount>, name: String): List<StrCount>
  ret build<StrCount >(strCountIncrLoop(l, name, false, builder<StrCount >()))

fun [tail] strCountIncrLoop(l: List<StrCount>, name: String, found: Bool,
                            [terminal] acc: ListBuilder<StrCount >): ListBuilder<StrCount >
  ret match(head<StrCount>(l))
    (e: StrCount) => strCountIncrLoop(tail<StrCount>(l), name,
                        found || e.scName == name,
                        push<StrCount >(acc, e.scName == name
                            ? StrCount(e.scName, e.scCount + 1)
                            : e))
    ()             => found ? acc : push<StrCount >(acc, StrCount(name, 1))

# ══════════════════════════════════════════════════════════════════════════
# Function
# ══════════════════════════════════════════════════════════════════════════

fun cgDeclareVars(cache0: List<CgCacheEntry>, sep: String, fields: List<CgField>, end: String): (text: String, cache: List<CgCacheEntry>)
  let result = fold(fields, ("", cache0, true), (acc: (text: String, cache: List<CgCacheEntry>, first: Bool), f: CgField) => cgDeclareVarsStep(acc, f, sep, end))
  ret (result.text, result.cache)

fun cgDeclareVarsStep(acc: (text: String, cache: List<CgCacheEntry>, first: Bool), f: CgField, sep: String, end: String): (text: String, cache: List<CgCacheEntry>, first: Bool)
  let sub = cgDeclare(f.fieldType, acc.cache)
  let piece = sub.text + " " + mangleName(f.fieldName) + end
  ret (acc.first ? piece : acc.text + sep + piece, sub.cache, false)

fun cgFunctionPrototype(f: CgFunction, cache0: List<CgCacheEntry>): (text: String, cache: List<CgCacheEntry>)
  let resultC = cgDeclare(f.fnResult, cache0)
  let paramsC = cgDeclareVars(resultC.cache, ", ", cgFieldsOfOrEmpty(f.fnParams), "")
  ret ("static NOINLINE\n" + resultC.text + " " + mangleName(f.fnName) + "(" + paramsC.text + ")", paramsC.cache)

fun cgFunctionCommentLine(f: CgFunction): String
  ret length(f.fnComment) == 0 ? "" : "// " + f.fnComment + "\n"

fun cgFunctionToCExtern(f: CgFunction, cache0: List<CgCacheEntry>): (text: String, cache: List<CgCacheEntry>)
  let resultC = cgDeclare(f.fnResult, cache0)
  let paramsC = cgDeclareVars(resultC.cache, ", ", cgFieldsOfOrEmpty(f.fnParams), "")
  ret ("extern " + resultC.text + " " + pyStrOpt(f.fnForeignSymbol) + "(" + paramsC.text + ");\n", paramsC.cache)

fun cgFunctionToCPrototype(f: CgFunction, cache0: List<CgCacheEntry>): (text: String, cache: List<CgCacheEntry>)
  let proto = cgFunctionPrototype(f, cache0)
  ret (cgFunctionCommentLine(f) + proto.text + ";\n", proto.cache)

fun cgFunctionToCImplement(f: CgFunction, cache0: List<CgCacheEntry>): (text: String, cache: List<CgCacheEntry>)
  let varsC = cgDeclareVars(cache0, "    ", cgFieldsOfOrEmpty(f.fnStackVars), ";\n")
  let varsSection = length(varsC.text) == 0 ? "" : "    " + varsC.text + "\n"
  let proto = cgFunctionPrototype(f, varsC.cache)
  let opsC = cgOpsToC(f.fnOps, proto.cache)
  ret (cgFunctionCommentLine(f) + proto.text + "\n{\n" + varsSection + opsC.text + "}\n", opsC.cache)

fun cgOpsToC(ops: List<Op>, cache0: List<CgCacheEntry>): (text: String, cache: List<CgCacheEntry>)
  ret fold(ops, ("", cache0), (acc: (text: String, cache: List<CgCacheEntry>), op: Op) => cgOpsToCStep(acc, op))

fun cgOpsToCStep(acc: (text: String, cache: List<CgCacheEntry>), op: Op): (text: String, cache: List<CgCacheEntry>)
  let sub = opToC(op, acc.cache)
  ret (acc.text + sub.text, sub.cache)

fun cgFunctionWith(f: CgFunction, ops: List<Op>, stackVars: CgType): CgFunction
  ret CgFunction(f.fnName, f.fnParams, f.fnResult, stackVars, ops, f.fnComment, f.fnForeignSymbol,
                 f.fnSync, f.fnTail, f.fnBypassAsync, f.fnAlwaysInline)

fun cgFunctionReplaceParams(f: CgFunction, replacer: (:RParam): RParam): CgFunction
  ret cgFunctionWith(f, map(f.fnOps, (op: Op) => opReplaceParams(op, replacer)), f.fnStackVars)

# ── lower_phis ───────────────────────────────────────────────────────────────

class [final] PhiAtEntry(atLabel: String, phiOp: Op)

fun cgCollectPhis(ops: List<Op>): List<PhiAtEntry>
  let result = fold(ops, ("", List<PhiAtEntry>()), (acc: (curLabel: String, phis: List<PhiAtEntry>), op: Op) => cgCollectPhisStep(acc, op))
  ret result.phis

fun cgCollectPhisStep(acc: (curLabel: String, phis: List<PhiAtEntry>), op: Op): (curLabel: String, phis: List<PhiAtEntry>)
  ret match(op)
    (l: OpLabel) => (l.labelName, acc.phis)
    (p: OpPhi) => (acc.curLabel,
                   build<PhiAtEntry >(push<PhiAtEntry >(_pushChain<PhiAtEntry >(builder<PhiAtEntry >(), chain<PhiAtEntry>(acc.phis)), PhiAtEntry(acc.curLabel, op))))
    (o: Op) => (acc.curLabel, acc.phis)

fun phisAtLabel(phis: List<PhiAtEntry>, label: String): List<Op>
  ret map(filter<PhiAtEntry>(phis, (e: PhiAtEntry) => e.atLabel == label), (e: PhiAtEntry) => e.phiOp)

fun phiSourceFor(phi: Op, predLabel: String): RParam
  ret match(phi)
    (p: OpPhi) => phiSourceForSources(p.phiSources, predLabel)
    (o: Op)    => RpNullPointer()   # unreachable

fun [tail] phiSourceForSources(sources: List<OpPhiSource>, predLabel: String): RParam
  ret match(head<OpPhiSource>(sources))
    (s: OpPhiSource) => s.sourceLabel == predLabel ? s.sourceValue : phiSourceForSources(tail<OpPhiSource>(sources), predLabel)
    ()                => RpNullPointer()   # unreachable (Python raises AssertionError)

fun cgPhiToMove(phi: Op, predLabel: String): Op
  ret match(phi)
    (p: OpPhi) => OpMove(p.phiTarget, phiSourceFor(phi, predLabel), false, List<RParam>())
    (o: Op)    => o   # unreachable

fun cgIsTerminatorForPhi(op: Op): Bool
  ret match(op)
    (j: OpJump) => true
    (r: OpReturn) => true
    (rv: OpReturnVoid) => true
    (a: OpAbort) => true
    (o: Op) => false

# The emitted op stream, plus the two facts the walk needs about what it has
# already emitted: the label currently open, and whether the last op falls
# through into the next. `paFall` is MAINTAINED as ops are pushed — deriving it
# meant asking last(out), which walks the entire emitted stream, once per op of
# the function.
class [linear, final] PhiAcc(paCur: String, paOut: ListBuilder<Op >,
                             paFall: Bool)

fun [tail] cgPhiMoves(ps: Chain<Op>, predLabel: String,
                      [terminal] acc: ListBuilder<Op >): ListBuilder<Op >
  ret match(ps)
    (nil: ChainEnd) => acc
    (l: ChainLink)  => cgPhiMoves(l.next, predLabel,
                          push<Op >(acc, cgPhiToMove(l.value, predLabel)))

fun cgLowerPhisJump([terminal] acc: PhiAcc, j: OpJump,
                    phis: List<PhiAtEntry>): PhiAcc
  ret PhiAcc(acc.paCur,
             push<Op >(cgPhiMoves(chain(phisAtLabel(phis, j.jumpName)),
                                  acc.paCur, acc.paOut),
                       OpJump(j.jumpName, j.jumpSavedVars)),
             false)

fun cgLowerPhisLabel([terminal] acc: PhiAcc, l: OpLabel,
                     phis: List<PhiAtEntry>): PhiAcc
  let group = phisAtLabel(phis, l.labelName)
  ret PhiAcc(l.labelName,
             push<Op >(!isEmpty<Op>(group) && acc.paFall
                         ? cgPhiMoves(chain(group), acc.paCur, acc.paOut)
                         : acc.paOut,
                       l),
             true)

fun cgLowerPhisStep([terminal] acc: PhiAcc, op: Op,
                    phis: List<PhiAtEntry>): PhiAcc
  ret match(op)
    (p: OpPhi)     => acc   # already lowered into Moves on predecessor edges
    (j: OpJump)    => cgLowerPhisJump(acc, j, phis)
    # (Python asserts the label is not in phis_at; unenforced here too)
    (ji: OpJumpIf) => PhiAcc(acc.paCur, push<Op >(acc.paOut, op), true)
    (l: OpLabel)   => cgLowerPhisLabel(acc, l, phis)
    (o: Op)        => PhiAcc(acc.paCur, push<Op >(acc.paOut, op),
                             !cgIsTerminatorForPhi(op))

fun cgLowerPhisPass2(ops: List<Op>, phis: List<PhiAtEntry>): List<Op>
  ret build<Op >(cgLowerPhisLoop(chain(ops), phis,
                     PhiAcc("", builder<Op >(), false)).paOut)

fun [tail] cgLowerPhisLoop(ops: Chain<Op>, phis: List<PhiAtEntry>,
                           [terminal] acc: PhiAcc): PhiAcc
  ret match(ops)
    (nil: ChainEnd) => acc
    (l: ChainLink)  => cgLowerPhisLoop(l.next, phis,
                                       cgLowerPhisStep(acc, l.value, phis))

fun cgLowerPhisForEmission(f: CgFunction): List<Op>
  let phis = cgCollectPhis(f.fnOps)
  ret isEmpty<PhiAtEntry>(phis) ? f.fnOps : cgLowerPhisPass2(f.fnOps, phis)

fun cgFunctionLowerPhis(f: CgFunction): CgFunction
  ret cgFunctionWith(f, cgLowerPhisForEmission(f), f.fnStackVars)

# ── simplify_control_flow ────────────────────────────────────────────────────
# (`listAt` is defined once, in typedecl.yafl, and reused here.)

fun isJumpToImmediateLabel(op: Op, nextOp: Op|None): Bool
  ret match(op)
    (j: OpJump) => isLabelNamed(nextOp, j.jumpName)
    (o: Op) => false

fun isJumpIfToImmediateLabel(op: Op, nextOp: Op|None): Bool
  ret match(op)
    (ji: OpJumpIf) => isLabelNamed(nextOp, ji.jumpIfLabel)
    (o: Op) => false

fun isLabelNamed(nextOp: Op|None, name: String): Bool
  ret match(nextOp)
    (n: Op) => isLabelNamedOp(n, name)
    ()       => false

fun isLabelNamedOp(n: Op, name: String): Bool
  ret match(n)
    (l: OpLabel) => l.labelName == name
    (o: Op)       => false

fun isInvertibleJumpIfJumpLabel(op: Op, nextOp: Op|None, next2Op: Op|None): Bool
  ret match(op)
    (ji: OpJumpIf) => ji.jumpIfInvert ? false : isInvertibleJumpIfJumpLabelRest(ji, nextOp, next2Op)
    (o: Op) => false

fun isInvertibleJumpIfJumpLabelRest(ji: OpJumpIf, nextOp: Op|None, next2Op: Op|None): Bool
  ret match(nextOp)
    (n: Op) => isInvertibleJumpIfJumpLabelRestOp(ji, n, next2Op)
    ()       => false

fun isInvertibleJumpIfJumpLabelRestOp(ji: OpJumpIf, n: Op, next2Op: Op|None): Bool
  ret match(n)
    (j: OpJump) => isLabelNamed(next2Op, ji.jumpIfLabel)
    (o: Op) => false

fun cgInvertJumpIf(op: Op, nextOp: Op|None): Op
  ret match(op)
    (ji: OpJumpIf) => cgInvertJumpIfWith(ji, nextOp)
    (o: Op) => op

fun cgInvertJumpIfWith(ji: OpJumpIf, nextOp: Op|None): Op
  ret match(nextOp)
    (n: Op) => cgInvertJumpIfWithOp(ji, n)
    ()       => ji

fun cgInvertJumpIfWithOp(ji: OpJumpIf, n: Op): Op
  ret match(n)
    (j: OpJump) => OpJumpIf(j.jumpName, ji.jumpIfCondition, true, ji.jumpIfSavedVars)
    (o: Op)      => ji

# One O(n) chain walk per pass (the index-based walk re-derived length and
# position per op — quadratic with allocation, detonating on the mega
# functions the -O3 single-caller fold builds).
fun chainHeadOp(c: Chain<Op>): Op|None
  ret match(c)
    (l: ChainLink) => l.value
    (nil: ChainEnd) => None

fun chainTailOp(c: Chain<Op>): Chain<Op>
  ret match(c)
    (l: ChainLink) => l.next
    (nil: ChainEnd) => c

# ONE self-recursive stepper ([tail] accepts only direct self-recursion, so
# the walk and its per-link body cannot be split into a mutual pair).
fun [tail] cgSimplifyOnePass(c: Chain<Op>, [terminal] acc: ListBuilder<Op >,
                             changed: Bool): (ops: List<Op>, changed: Bool)
  ret match(c)
    (nil: ChainEnd) => (build<Op >(acc), changed)
    (l: ChainLink)  =>
      (isJumpToImmediateLabel(l.value, chainHeadOp(l.next))
       || isJumpIfToImmediateLabel(l.value, chainHeadOp(l.next)))
      ? cgSimplifyOnePass(l.next, acc, true)
      : isInvertibleJumpIfJumpLabel(l.value, chainHeadOp(l.next),
                                    chainHeadOp(chainTailOp(l.next)))
        ? cgSimplifyOnePass(chainTailOp(l.next),
                            push<Op >(acc, cgInvertJumpIf(l.value,
                                              chainHeadOp(l.next))),
                            true)
        : cgSimplifyOnePass(l.next, push<Op >(acc, l.value), changed)

fun [tail] cgSimplifyControlFlowFixpoint(ops: List<Op>): List<Op>
  let pass2 = cgSimplifyOnePass(chain(ops), builder<Op >(), false)
  ret pass2.changed ? cgSimplifyControlFlowFixpoint(pass2.ops) : pass2.ops

fun cgCollectReferencedLabelsStep(acc: StrSet, op: Op): StrSet
  ret match(op)
    (j: OpJump) => setAdd(acc, j.jumpName)
    (ji: OpJumpIf) => setAdd(acc, ji.jumpIfLabel)
    (it: OpIfTask) => setAdd(acc, it.taskTarget)
    (sj: OpSwitchJump) => fold(sj.switchCases, acc, (acc2: StrSet, c: OpCase) => setAdd(acc2, c.caseLabel))
    (o: Op) => acc

fun cgCollectReferencedLabels(ops: List<Op>): StrSet
  ret fold(ops, setEmpty(), (acc: StrSet, op: Op) => cgCollectReferencedLabelsStep(acc, op))

fun cgIsUnreferencedLabel(op: Op, referenced: StrSet): Bool
  ret match(op)
    (l: OpLabel) => !setHas(referenced, l.labelName)
    (o: Op)       => false

fun cgRemoveUnreferencedLabels(ops: List<Op>, referenced: StrSet): List<Op>
  ret filter<Op>(ops, (op: Op) => !cgIsUnreferencedLabel(op, referenced))

fun cgFunctionSimplifyControlFlow(f: CgFunction): CgFunction
  let ops1 = cgSimplifyControlFlowFixpoint(f.fnOps)
  let referenced = cgCollectReferencedLabels(ops1)
  let ops2 = cgRemoveUnreferencedLabels(ops1, referenced)
  ret cgFunctionWith(f, ops2, f.fnStackVars)

# ── strip_unused_operations ──────────────────────────────────────────────────

# Dict-indexed reachability (the list-of-pairs label index, per-index list
# walks and O(n) membership were all quadratic-or-worse and cgKeepSeenIndices
# recursed one C frame PER OP — the -O3 mega-function stack overflow).
# Python: labels = {name: index} (LAST duplicate wins, dict semantics);
# traversal order does not affect the seen SET, so the worklist is a stack.

class [final] StripIx(sxOps: Dict<Int, Op>, sxN: Int,
                      sxLabels: Dict<String, Int>)

fun cgStripIndex(ops: List<Op>): StripIx
  let built = fold(ops, (Dict<Int, Op>(), 0, Dict<String, Int>()),
        (acc: (byIx: Dict<Int, Op>, i: Int, labels: Dict<String, Int>), op: Op) =>
          (put(acc.byIx, acc.i, op), acc.i + 1, cgStripLabelPut(acc.labels, op, acc.i)))
  ret StripIx(built.byIx, built.i, built.labels)

fun cgStripLabelPut(labels: Dict<String, Int>, op: Op, i: Int): Dict<String, Int>
  ret match(op)
    (l: OpLabel) => put(labels, l.labelName, i)
    (o: Op)       => labels

fun sxOpAt(ix: StripIx, i: Int): Op
  ret match(get(ix.sxOps, i))
    (op: Op) => op
    ()        => OpReturnVoid(List<RParam>())   # unreachable: 0 <= i < sxN

fun labelIndexLookup(ix: StripIx, name: String): Int
  ret match(get(ix.sxLabels, name))
    (i: Int) => i
    ()        => -1

fun cgSuccessors(ix: StripIx, index: Int): List<Int>
  let op = sxOpAt(ix, index)
  let fallthrough = index + 1 < ix.sxN
    ? prepend<Int>(index + 1, List<Int>())
    : List<Int>()
  ret cgSuccessorsOf(op, ix, fallthrough)

fun cgSuccessorsOf(op: Op, ix: StripIx, fallthrough: List<Int>): List<Int>
  ret match(op)
    (r: OpReturn) => List<Int>()
    (rv: OpReturnVoid) => List<Int>()
    (c: OpCall) => c.callMusttail ? List<Int>() : fallthrough
    (j: OpJump) => prepend<Int>(labelIndexLookup(ix, j.jumpName), List<Int>())
    (ji: OpJumpIf) => prepend<Int>(labelIndexLookup(ix, ji.jumpIfLabel), fallthrough)
    (it: OpIfTask) => prepend<Int>(labelIndexLookup(ix, it.taskTarget), fallthrough)
    (sj: OpSwitchJump) => map(sj.switchCases, (c: OpCase) => labelIndexLookup(ix, c.caseLabel))
    (o: Op) => fallthrough

fun cgAddOneSuccessor(acc: (seen: Dict<Int, Bool>, worklist: Chain<Int>),
                      s: Int): (seen: Dict<Int, Bool>, worklist: Chain<Int>)
  ret get(acc.seen, s) is Bool
    ? acc
    : (put(acc.seen, s, true), chainPrependInt(s, acc.worklist))

fun chainPrependInt(s: Int, c: Chain<Int>): Chain<Int>
  ret ChainLink<Int>(s, c)

fun chainHeadIntOr(c: Chain<Int>, dflt: Int): Int
  ret match(c)
    (l: ChainLink) => l.value
    (nil: ChainEnd) => dflt

fun chainTailInt(c: Chain<Int>): Chain<Int>
  ret match(c)
    (l: ChainLink) => l.next
    (nil: ChainEnd) => c

fun [tail] cgReachableLoop(ix: StripIx, worklist: Chain<Int>,
                           seen: Dict<Int, Bool>): Dict<Int, Bool>
  if worklist is ChainEnd
    ret seen
  let idx = chainHeadIntOr(worklist, 0)
  let added = fold(cgSuccessors(ix, idx), (seen, chainTailInt(worklist)),
        (acc: (seen: Dict<Int, Bool>, worklist: Chain<Int>), s: Int) =>
          cgAddOneSuccessor(acc, s))
  ret cgReachableLoop(ix, added.worklist, added.seen)

fun cgReachable(ix: StripIx): Dict<Int, Bool>
  ret cgReachableLoop(ix, chainPrependInt(0, chain(List<Int>())),
                      put(Dict<Int, Bool>(), 0, true))

fun [tail] cgKeepSeenIndices(ops: Chain<Op>, i: Int, seen: Dict<Int, Bool>,
                             [terminal] acc: ListBuilder<Op >): ListBuilder<Op >
  ret match(ops)
    (nil: ChainEnd) => acc
    (l: ChainLink)  => cgKeepSeenIndices(l.next, i + 1, seen,
        get(seen, i) is Bool ? push<Op >(acc, l.value) : acc)

fun cgFunctionStripUnusedOperations(f: CgFunction): CgFunction
  let ix = cgStripIndex(f.fnOps)
  let seen = cgReachable(ix)
  let newOps = build<Op >(cgKeepSeenIndices(chain(f.fnOps), 0, seen,
                                           builder<Op >()))
  ret cgFunctionWith(f, newOps, f.fnStackVars)

# ── fold_struct_fields ───────────────────────────────────────────────────────

fun [tail] rpFoldStructFieldLookup(values: List<RpNamedValue>, field: String, fallback: RParam): RParam
  ret match(head<RpNamedValue>(values))
    (v: RpNamedValue) => v.name == field ? v.value : rpFoldStructFieldLookup(tail<RpNamedValue>(values), field, fallback)
    ()                  => fallback

fun rpFoldStructFieldStruct(sf: RpStructField, whole: RParam): RParam
  ret match(sf.structVal)
    (ns: RpNewStruct) => rpFoldStructFieldLookup(ns.values, sf.field, whole)
    (nst: RpNewStructTyped) => rpFoldStructFieldLookup(nst.values, sf.field, whole)
    (o: RParam) => whole

fun rpFoldStructField(rparam: RParam): RParam
  ret match(rparam)
    (sf: RpStructField) => rpFoldStructFieldStruct(sf, rparam)
    (o: RParam)          => rparam

fun cgFunctionFoldStructFields(f: CgFunction): CgFunction
  ret cgFunctionReplaceParams(f, rpFoldStructField)

# ── copy_propagate ───────────────────────────────────────────────────────────

# The parameter names are only ever asked "is this one of them", by the
# alias check — so a Set, and the field walk drops its order on the way in.
fun cgParamNames(f: CgFunction): Set<String>
  ret fold(cgFieldsOfOrEmpty(f.fnParams), Set<String>(),
           (acc: Set<String>, fld: CgField) => add<String>(acc, fld.fieldName))

fun cgCPWriteCountsMoveTarget(acc: (writes: List<StrCount>, zeroInit: Set<String>), sv: RpStackVar, source: RParam): (writes: List<StrCount>, zeroInit: Set<String>)
  ret match(source)
    (z: RpZeroOf) => (acc.writes, add<String>(acc.zeroInit, sv.name))
    (o: RParam)   => (strCountIncr(acc.writes, sv.name), acc.zeroInit)

fun cgCPWriteCountsMove(acc: (writes: List<StrCount>, zeroInit: Set<String>), m: OpMove): (writes: List<StrCount>, zeroInit: Set<String>)
  ret match(m.moveTarget)
    (sv: RpStackVar) => cgCPWriteCountsMoveTarget(acc, sv, m.moveSource)
    (o: RParam)       => acc

fun cgCPWriteCountsReq(acc: (writes: List<StrCount>, zeroInit: Set<String>), register: RParam): (writes: List<StrCount>, zeroInit: Set<String>)
  ret match(register)
    (sv: RpStackVar) => (strCountIncr(acc.writes, sv.name), acc.zeroInit)
    (o: RParam)       => acc

fun cgCPWriteCountsOpt(acc: (writes: List<StrCount>, zeroInit: Set<String>), register: RParam|None): (writes: List<StrCount>, zeroInit: Set<String>)
  ret match(register)
    (r: RParam) => cgCPWriteCountsReq(acc, r)
    ()           => acc

fun cgCPWriteCountsStep(acc: (writes: List<StrCount>, zeroInit: Set<String>), op: Op): (writes: List<StrCount>, zeroInit: Set<String>)
  ret match(op)
    (m: OpMove) => cgCPWriteCountsMove(acc, m)
    (c: OpCall) => cgCPWriteCountsOpt(acc, c.callRegister)
    (n: OpNewObject) => cgCPWriteCountsReq(acc, n.newObjRegister)
    (o: Op) => acc

fun cgCollectWrites(ops: List<Op>): (writes: List<StrCount>, zeroInit: Set<String>)
  ret fold(ops, (List<StrCount>(), Set<String>()), (acc: (writes: List<StrCount>, zeroInit: Set<String>), op: Op) => cgCPWriteCountsStep(acc, op))

class [final] AliasEntry(aeVarName: String, aeAliasOf: RParam)

fun cgBuildAliasesCheck(acc: List<AliasEntry>, ta: RpStackVar, sb: RpStackVar, writes: List<StrCount>, zeroInit: Set<String>, gcSafe: Set<String>, paramNames: Set<String>): List<AliasEntry>
  ret strCountGet(writes, ta.name) != 1
    ? acc
    : (strCountGet(writes, sb.name) > 1
      ? acc
      : ((contains<String>(zeroInit, ta.name) && !contains<String>(gcSafe, sb.name) && !contains<String>(paramNames, sb.name))
        ? acc
        # Looked up by target name — the table's order is not observed.
        : prepend<AliasEntry>(AliasEntry(ta.name, sb), acc)))

fun cgBuildAliasesMove(acc: List<AliasEntry>, m: OpMove, writes: List<StrCount>, zeroInit: Set<String>, gcSafe: Set<String>, paramNames: Set<String>): List<AliasEntry>
  ret match(m.moveTarget)
    (ta: RpStackVar) => cgBuildAliasesMoveSource(acc, ta, m.moveSource, writes, zeroInit, gcSafe, paramNames)
    (o: RParam) => acc

fun cgBuildAliasesMoveSource(acc: List<AliasEntry>, ta: RpStackVar, source: RParam, writes: List<StrCount>, zeroInit: Set<String>, gcSafe: Set<String>, paramNames: Set<String>): List<AliasEntry>
  ret match(source)
    (sb: RpStackVar) => cgBuildAliasesCheck(acc, ta, sb, writes, zeroInit, gcSafe, paramNames)
    (o: RParam) => acc

fun cgBuildAliasesStep(acc: List<AliasEntry>, op: Op, writes: List<StrCount>, zeroInit: Set<String>, gcSafe: Set<String>, paramNames: Set<String>): List<AliasEntry>
  ret match(op)
    (m: OpMove) => cgBuildAliasesMove(acc, m, writes, zeroInit, gcSafe, paramNames)
    (o: Op)      => acc

fun cgBuildAliases(ops: List<Op>, writes: List<StrCount>, zeroInit: Set<String>, gcSafe: Set<String>, paramNames: Set<String>): List<AliasEntry>
  ret fold(ops, List<AliasEntry>(), (acc: List<AliasEntry>, op: Op) => cgBuildAliasesStep(acc, op, writes, zeroInit, gcSafe, paramNames))

fun [tail] aliasLookup(aliases: List<AliasEntry>, name: String): RParam|None
  ret match(head<AliasEntry>(aliases))
    (e: AliasEntry) => e.aeVarName == name ? e.aeAliasOf : aliasLookup(tail<AliasEntry>(aliases), name)
    ()               => None

fun resolveAliasStackVar(aliases: List<AliasEntry>, s: RpStackVar, seen: List<String>): RParam
  ret strListMember(seen, s.name) ? s : resolveAliasStackVarNext(aliases, s, seen)

fun resolveAliasStackVarNext(aliases: List<AliasEntry>, s: RpStackVar, seen: List<String>): RParam
  ret match(aliasLookup(aliases, s.name))
    (next: RParam) => resolveAlias(aliases, next, prepend<String>(s.name, seen))
    ()              => s

fun resolveAlias(aliases: List<AliasEntry>, sv: RParam, seen: List<String>): RParam
  ret match(sv)
    (s: RpStackVar) => resolveAliasStackVar(aliases, s, seen)
    (o: RParam)      => sv

fun cgResolvedAliases(aliases: List<AliasEntry>): List<AliasEntry>
  ret map(aliases, (e: AliasEntry) => AliasEntry(e.aeVarName, resolveAlias(aliases, e.aeAliasOf, List<String>())))

fun rpParamName(r: RParam): String
  ret match(r)
    (sv: RpStackVar) => sv.name
    (o: RParam)       => ""   # unreachable: resolveAlias always returns a StackVar

fun cgAliasesToRenames(resolved: List<AliasEntry>): List<RpRename>
  ret map(resolved, (e: AliasEntry) => RpRename(e.aeVarName, rpParamName(e.aeAliasOf)))

fun cgEliminatedNames(aliases: List<AliasEntry>): List<String>
  ret map(aliases, (e: AliasEntry) => e.aeVarName)

fun cgIsEliminatedMove(op: Op, eliminated: List<String>): Bool
  ret match(op)
    (m: OpMove) => cgIsEliminatedMoveTarget(m.moveTarget, eliminated)
    (o: Op) => false

fun cgIsEliminatedMoveTarget(target: RParam, eliminated: List<String>): Bool
  ret match(target)
    (sv: RpStackVar) => strListMember(eliminated, sv.name)
    (o: RParam)       => false

fun cgCopyPropagateFilterStep(op: Op, rest: List<Op>, eliminated: List<String>, renames: List<RpRename>): List<Op>
  ret cgIsEliminatedMove(op, eliminated)
    ? cgCopyPropagateFilterOps(rest, eliminated, renames)
    : prepend<Op>(opRenameVars(op, renames), cgCopyPropagateFilterOps(rest, eliminated, renames))

fun cgCopyPropagateFilterOps(ops: List<Op>, eliminated: List<String>, renames: List<RpRename>): List<Op>
  ret match(head<Op>(ops))
    (op: Op) => cgCopyPropagateFilterStep(op, tail<Op>(ops), eliminated, renames)
    ()        => List<Op>()

fun cgFunctionCopyPropagateApply(f: CgFunction, aliases: List<AliasEntry>): CgFunction
  let resolved = cgResolvedAliases(aliases)
  let renames = cgAliasesToRenames(resolved)
  let eliminated = cgEliminatedNames(aliases)
  let newOps = cgCopyPropagateFilterOps(f.fnOps, eliminated, renames)
  let newStackVars = filter<CgField>(cgFieldsOfOrEmpty(f.fnStackVars), (fld: CgField) => !strListMember(eliminated, fld.fieldName))
  ret cgFunctionWith(f, newOps, CgStruct(newStackVars))

fun cgFunctionCopyPropagate(f: CgFunction): CgFunction
  let paramNames = cgParamNames(f)
  let collected = cgCollectWrites(f.fnOps)
  let gcSafe = union<String>(paramNames, collected.zeroInit)
  let aliases = cgBuildAliases(f.fnOps, collected.writes, collected.zeroInit, gcSafe, paramNames)
  ret isEmpty<AliasEntry>(aliases) ? f : cgFunctionCopyPropagateApply(f, aliases)

# ── eliminate_common_subexpressions ─────────────────────────────────────────

fun cgCSEWriteCountsTarget(acc: List<StrCount>, target: RParam): List<StrCount>
  ret match(target)
    (sv: RpStackVar) => strCountIncr(acc, sv.name)
    (o: RParam)       => acc

fun cgCSEWriteCountsCallRegister(acc: List<StrCount>, register: RParam|None): List<StrCount>
  ret match(register)
    (r: RParam) => cgCSEWriteCountsTarget(acc, r)
    ()           => acc

fun cgCSEWriteCountsStep(acc: List<StrCount>, op: Op): List<StrCount>
  ret match(op)
    (m: OpMove) => cgCSEWriteCountsTarget(acc, m.moveTarget)
    (c: OpCall) => cgCSEWriteCountsCallRegister(acc, c.callRegister)
    (n: OpNewObject) => cgCSEWriteCountsTarget(acc, n.newObjRegister)
    (o: Op) => acc

fun cgCSEWriteCounts(ops: List<Op>): List<StrCount>
  ret fold(ops, List<StrCount>(), (acc: List<StrCount>, op: Op) => cgCSEWriteCountsStep(acc, op))

fun cseIsMultiWriteStackVar(x: RParam, multiWrite: List<String>): Bool
  ret match(x)
    (sv: RpStackVar) => strListMember(multiWrite, sv.name)
    (o: RParam)       => false

fun cseIsEligible(rparam: RParam, multiWrite: List<String>): Bool
  ret match(rparam)
    (sv: RpStackVar) => false
    (gv: RpGlobalVar) => false
    (gf: RpGlobalFunction) => false
    (o: RParam) => !rpTest(rparam, (x: RParam) => cseIsMultiWriteStackVar(x, multiWrite))

class [final] AvailEntry(cseExpr: RParam, cseTarget: RParam)

fun [tail] availableGet(available: List<AvailEntry>, key: RParam): RParam|None
  ret match(head<AvailEntry>(available))
    (e: AvailEntry) => eqRParam(e.cseExpr, key) ? e.cseTarget : availableGet(tail<AvailEntry>(available), key)
    ()               => None

fun cseIsHeapRead(x: RParam): Bool
  ret match(x)
    (sf: RpStructField) => true
    (of: RpObjectField) => true
    (ae: RpArrayElement) => true
    (o: RParam) => false

# The CSE walk's accumulator. newOps is the rewritten op stream — instruction
# order — so it is a builder; appending to it per op made the pass quadratic in
# the function's own size. The other three are lookup tables whose order is not
# observed: renames is applied by name, eliminated is membership-tested, and
# available is searched for a matching expression.
class [linear, final] CseAcc(csRenames: List<RpRename>,
                             csAvailable: List<AvailEntry>,
                             csEliminated: List<String>,
                             csNewOps: ListBuilder<Op >)

fun cgCSEInvalidate(available: List<AvailEntry>): List<AvailEntry>
  ret filter<AvailEntry>(available, (e: AvailEntry) => !rpTest(e.cseExpr, cseIsHeapRead))

fun cgCSEEliminate([terminal] acc: CseAcc, targetVarName: String, aliasTo: RParam): CseAcc
  ret CseAcc(prepend(RpRename(targetVarName, rpParamName(aliasTo)),
                     acc.csRenames),
             acc.csAvailable,
             prepend(targetVarName, acc.csEliminated), acc.csNewOps)

fun cgCSENoEliminate([terminal] acc: CseAcc, m: OpMove, op: Op, eligible: Bool, notMultiWrite: Bool): CseAcc
  let newAvailable = (eligible && notMultiWrite)
    ? prepend(AvailEntry(m.moveSource, m.moveTarget), acc.csAvailable)
    : acc.csAvailable
  ret CseAcc(acc.csRenames, newAvailable, acc.csEliminated,
             push<Op >(acc.csNewOps, op))

fun cgCSEStepMoveStackVar([terminal] acc: CseAcc, m: OpMove, sv: RpStackVar, op: Op, multiWrite: List<String>): CseAcc
  let eligible = cseIsEligible(m.moveSource, multiWrite)
  let notMultiWrite = !strListMember(multiWrite, sv.name)
  let hit = (eligible && notMultiWrite)
    ? availableGet(acc.csAvailable, m.moveSource)
    : None
  ret match(hit)
    (targetOf: RParam) => cgCSEEliminate(acc, sv.name, targetOf)
    ()                   => cgCSENoEliminate(acc, m, op, eligible, notMultiWrite)

fun cgCSEStepMove([terminal] acc: CseAcc, m: OpMove, op: Op, multiWrite: List<String>): CseAcc
  ret match(m.moveTarget)
    (sv: RpStackVar) => cgCSEStepMoveStackVar(acc, m, sv, op, multiWrite)
    (ofield: RpObjectField) => CseAcc(acc.csRenames, cgCSEInvalidate(acc.csAvailable), acc.csEliminated,
                               push<Op >(acc.csNewOps, op))
    (o: RParam) => CseAcc(acc.csRenames, acc.csAvailable, acc.csEliminated,
                   push<Op >(acc.csNewOps, op))

fun cgCSEStep([terminal] acc: CseAcc, op0: Op, multiWrite: List<String>): CseAcc
  let op = opRenameVars(op0, acc.csRenames)
  ret match(op)
    (l: OpLabel) => CseAcc(acc.csRenames, List<AvailEntry>(), acc.csEliminated,
                    push<Op >(acc.csNewOps, op))
    (m: OpMove) => cgCSEStepMove(acc, m, op, multiWrite)
    (c: OpCall) => CseAcc(acc.csRenames, cgCSEInvalidate(acc.csAvailable), acc.csEliminated,
                   push<Op >(acc.csNewOps, op))
    (n: OpNewObject) => CseAcc(acc.csRenames, cgCSEInvalidate(acc.csAvailable), acc.csEliminated,
                        push<Op >(acc.csNewOps, op))
    (o: Op) => CseAcc(acc.csRenames, acc.csAvailable, acc.csEliminated,
               push<Op >(acc.csNewOps, op))

# An explicit walk, not a fold: the accumulator is linear.
fun cgCSEFold(ops: List<Op>, multiWrite: List<String>): CseOut
  ret cseBuild(cgCSELoop(chain(ops), multiWrite,
                         CseAcc(List<RpRename>(), List<AvailEntry>(),
                                List<String>(), builder<Op >())))

fun [tail] cgCSELoop(ops: Chain<Op>, multiWrite: List<String>,
                     [terminal] acc: CseAcc): CseAcc
  ret match(ops)
    (nil: ChainEnd) => acc
    (l: ChainLink)  => cgCSELoop(l.next, multiWrite,
                                 cgCSEStep(acc, l.value, multiWrite))

class [final] CseOut(coEliminated: List<String>, coNewOps: List<Op>)

fun cseBuild(acc: CseAcc): CseOut
  ret CseOut(acc.csEliminated, build<Op >(acc.csNewOps))

fun cgFunctionEliminateCSEApply(f: CgFunction, result: CseOut): CgFunction
  let newStackVars = filter<CgField>(cgFieldsOfOrEmpty(f.fnStackVars),
                         (fld: CgField) => !strListMember(result.coEliminated,
                                                          fld.fieldName))
  ret cgFunctionWith(f, result.coNewOps, CgStruct(newStackVars))

fun cgFunctionEliminateCSE(f: CgFunction): CgFunction
  let writeCounts = cgCSEWriteCounts(f.fnOps)
  let multiWrite = map(filter<StrCount>(writeCounts, (e: StrCount) => e.scCount > 1), (e: StrCount) => e.scName)
  let result = cgCSEFold(f.fnOps, multiWrite)
  ret isEmpty<String>(result.coEliminated)
    ? f
    : cgFunctionEliminateCSEApply(f, result)

# ══════════════════════════════════════════════════════════════════════════
# Object
# ══════════════════════════════════════════════════════════════════════════

fun cgObjectArrayType(o: CgObject): CgType|None
  ret match(last<CgField>(cgFieldsOfOrEmpty(o.objFields)))
    (f: CgField) => cgObjectArrayTypeField(f.fieldType)
    ()            => None

fun cgObjectArrayTypeField(ft: CgType): CgType|None
  ret match(ft)
    (a: CgArray) => a.elemType
    (t2: CgType) => None

fun cgObjectCommentLine(o: CgObject): String
  ret length(o.objComment) == 0 ? "" : "// " + o.objComment + "\n"

fun cgObjectMaskFields(o: CgObject): CgType
  let allFields = cgFieldsOfOrEmpty(o.objFields)
  let withoutFirst = tail<CgField>(allFields)
  ret match(cgObjectArrayType(o))
    (a: CgType) => CgStruct(initOf<CgField>(withoutFirst))
    ()           => CgStruct(withoutFirst)

fun cgObjectGetPointerMask(o: CgObject): String
  ret toPointerMaskWindow(cgObjectMaskFields(o), mangleName(o.objName) + "_t", 0)

fun cgObjectGetPointerMaskWindowCount(o: CgObject): Int
  ret (1 + cgWordsUpperBound(cgObjectMaskFields(o)) + 63) / 64

fun cgObjectGetPointerMaskWindow(o: CgObject, window: Int): String
  ret toPointerMaskWindow(cgObjectMaskFields(o), mangleName(o.objName) + "_t", window)

fun cgObjectGetArrayPointerMaskSome(a: CgType, cache0: List<CgCacheEntry>): (text: String, cache: List<CgCacheEntry>)
  let declared = cgDeclare(a, cache0)
  ret (toPointerMask(a, declared.text), declared.cache)

fun cgObjectGetArrayPointerMask(o: CgObject, cache0: List<CgCacheEntry>): (text: String, cache: List<CgCacheEntry>)
  ret match(cgObjectArrayType(o))
    (a: CgType) => cgObjectGetArrayPointerMaskSome(a, cache0)
    ()           => ("0", cache0)

fun cgLastFieldName(o: CgObject): String
  ret match(last<CgField>(cgFieldsOfOrEmpty(o.objFields)))
    (f: CgField) => f.fieldName
    ()            => ""

fun cgObjectGetObjectSize(o: CgObject): String
  let typeStr = mangleName(o.objName) + "_t"
  ret match(cgObjectArrayType(o))
    (a: CgType) => "offsetof(" + typeStr + ", " + mangleName(cgLastFieldName(o)) + ")"
    ()           => "sizeof(" + typeStr + ")"

fun cgObjectGetArrayElSizeSome(a: CgType, cache0: List<CgCacheEntry>): (text: String, cache: List<CgCacheEntry>)
  let declared = cgDeclare(a, cache0)
  ret ("sizeof(" + declared.text + ")", declared.cache)

fun cgObjectGetArrayElSize(o: CgObject, cache0: List<CgCacheEntry>): (text: String, cache: List<CgCacheEntry>)
  ret match(cgObjectArrayType(o))
    (a: CgType) => cgObjectGetArrayElSizeSome(a, cache0)
    ()           => ("0", cache0)

fun cgObjectGetArrayLengthOffset(o: CgObject): String
  ret match(o.objLengthField)
    (l: String) => "offsetof(" + mangleName(o.objName) + "_t, " + mangleName(l) + ")"
    ()           => "0"

# ══════════════════════════════════════════════════════════════════════════
# Global
# ══════════════════════════════════════════════════════════════════════════

fun cgGlobalToCName(g: CgGlobal): String
  ret mangleName(g.globalName)

fun cgGlobalPrototypePlain(g: CgGlobal, cache0: List<CgCacheEntry>): (text: String, cache: List<CgCacheEntry>)
  let declared = cgDeclare(g.globalType, cache0)
  ret ("static " + declared.text + " " + cgGlobalToCName(g), declared.cache)

fun cgGlobalPrototypeInitArrayField(acc: (text: String, cache: List<CgCacheEntry>), v: RpNamedValue): (text: String, cache: List<CgCacheEntry>)
  let declared = cgDeclare(rpGetType(v.value), acc.cache)
  ret (acc.text + "    " + declared.text + " " + v.name + ";\n", declared.cache)

fun cgGlobalPrototypeInitArrayForm(g: CgGlobal, values: List<RpNamedValue>, cache0: List<CgCacheEntry>): (text: String, cache: List<CgCacheEntry>)
  let result = fold(values, ("", cache0), (acc: (text: String, cache: List<CgCacheEntry>), v: RpNamedValue) => cgGlobalPrototypeInitArrayField(acc, v))
  ret ("static struct {\n" + result.text + "}[1] " + cgGlobalToCName(g), result.cache)

fun cgGlobalPrototypeDataForm(g: CgGlobal, objName: String, cache0: List<CgCacheEntry>): (text: String, cache: List<CgCacheEntry>)
  ret ("static " + mangleName(objName) + "_t " + cgGlobalToCName(g) + "_data;\n"
       + "static object_t* " + cgGlobalToCName(g), cache0)

# Python: `isinstance(self.init.values[-1], p.InitArray)` — but `values[-1]`
# is a (name, value) TUPLE, so the isinstance is ALWAYS False and the
# InitArray prototype/implement forms are dead code (nothing in the compiler
# constructs a Global with an InitArray value either — trim.py only ever
# consumes them). Ported faithfully: always false. The dead branches are kept
# below (cgGlobalPrototypeInitArrayForm / cgGlobalToCImplementInitArrayForm)
# so the port stays line-mappable to the Python; flagged in the port report.
fun cgGlobalPrototypeNewStructLastIsInitArray(lastVal: RpNamedValue): Bool
  ret false

fun cgGlobalPrototypeNewStruct(g: CgGlobal, objName: String, ns: RpNewStruct, cache0: List<CgCacheEntry>): (text: String, cache: List<CgCacheEntry>)
  ret match(last<RpNamedValue>(ns.values))
    (lastVal: RpNamedValue) => cgGlobalPrototypeNewStructLastIsInitArray(lastVal)
      ? cgGlobalPrototypeInitArrayForm(g, ns.values, cache0)
      : cgGlobalPrototypeDataForm(g, objName, cache0)
    ()                        => cgGlobalPrototypeDataForm(g, objName, cache0)

fun cgGlobalPrototypeWithObject(g: CgGlobal, objName: String, init: RParam, cache0: List<CgCacheEntry>): (text: String, cache: List<CgCacheEntry>)
  ret match(init)
    (ns: RpNewStruct) => cgGlobalPrototypeNewStruct(g, objName, ns, cache0)
    (o: RParam)         => ("", cache0)   # unreachable (Python raises ValueError)

fun cgGlobalPrototype(g: CgGlobal, cache0: List<CgCacheEntry>): (text: String, cache: List<CgCacheEntry>)
  ret match(g.globalObjectName)
    (objName: String) => cgGlobalPrototypeMaybeInit(g, objName, cache0)
    ()                  => cgGlobalPrototypePlain(g, cache0)

fun cgGlobalPrototypeMaybeInit(g: CgGlobal, objName: String, cache0: List<CgCacheEntry>): (text: String, cache: List<CgCacheEntry>)
  ret match(g.globalInit)
    (init: RParam) => cgGlobalPrototypeWithObject(g, objName, init, cache0)
    ()              => cgGlobalPrototypePlain(g, cache0)

fun cgGlobalToCPrototype(g: CgGlobal, cache0: List<CgCacheEntry>): (text: String, cache: List<CgCacheEntry>)
  let proto = cgGlobalPrototype(g, cache0)
  ret (proto.text + ";\n", proto.cache)

fun cgGlobalToCImplementPlain(g: CgGlobal, init: RParam, cache0: List<CgCacheEntry>): (text: String, cache: List<CgCacheEntry>)
  let proto = cgGlobalPrototype(g, cache0)
  let initC = rpToC(init, proto.cache)
  ret (proto.text + " = " + initC.text + ";", initC.cache)

fun cgGlobalImplementValueLine(acc: (text: String, cache: List<CgCacheEntry>), v: RParam): (text: String, cache: List<CgCacheEntry>)
  let sub = rpToC(v, acc.cache)
  ret (acc.text + "  , " + sub.text + "\n", sub.cache)

fun cgGlobalToCImplementInitArrayForm(g: CgGlobal, objName: String, values: List<RpNamedValue>, cache0: List<CgCacheEntry>): (text: String, cache: List<CgCacheEntry>)
  let proto = cgGlobalPrototype(g, cache0)
  let result = fold(values, ("", proto.cache), (acc: (text: String, cache: List<CgCacheEntry>), v: RpNamedValue) => cgGlobalImplementValueLine(acc, v.value))
  ret (proto.text + " = {\n    (object_t*)((char*)obj_" + mangleName(objName) + " + VTABLE_TAG_BIT)\n" + result.text + "};\n", result.cache)

fun cgGlobalToCImplementDataForm(g: CgGlobal, objName: String, values: List<RpNamedValue>, cache0: List<CgCacheEntry>): (text: String, cache: List<CgCacheEntry>)
  let dataName = cgGlobalToCName(g) + "_data"
  let result = fold(values, ("    (object_t*)((char*)obj_" + mangleName(objName) + " + VTABLE_TAG_BIT)\n", cache0), (acc: (text: String, cache: List<CgCacheEntry>), v: RpNamedValue) => cgGlobalImplementValueLine(acc, v.value))
  ret ("static " + mangleName(objName) + "_t " + dataName + " = {\n" + result.text + "};\n"
       + "static object_t* " + cgGlobalToCName(g) + " = (object_t*)&" + dataName + ";\n", result.cache)

fun cgGlobalToCImplementNewStruct(g: CgGlobal, objName: String, ns: RpNewStruct, cache0: List<CgCacheEntry>): (text: String, cache: List<CgCacheEntry>)
  ret match(last<RpNamedValue>(ns.values))
    (lastVal: RpNamedValue) => cgGlobalPrototypeNewStructLastIsInitArray(lastVal)
      ? cgGlobalToCImplementInitArrayForm(g, objName, ns.values, cache0)
      : cgGlobalToCImplementDataForm(g, objName, ns.values, cache0)
    ()                        => cgGlobalToCImplementDataForm(g, objName, ns.values, cache0)

fun cgGlobalToCImplementObject(g: CgGlobal, objName: String, init: RParam, cache0: List<CgCacheEntry>): (text: String, cache: List<CgCacheEntry>)
  ret match(init)
    (ns: RpNewStruct) => cgGlobalToCImplementNewStruct(g, objName, ns, cache0)
    (o: RParam)         => ("", cache0)   # unreachable (Python raises ValueError)

fun cgGlobalToCImplementSome(g: CgGlobal, init: RParam, cache0: List<CgCacheEntry>): (text: String, cache: List<CgCacheEntry>)
  ret match(g.globalObjectName)
    (objName: String) => cgGlobalToCImplementObject(g, objName, init, cache0)
    ()                  => cgGlobalToCImplementPlain(g, init, cache0)

fun cgGlobalToCImplement(g: CgGlobal, cache0: List<CgCacheEntry>): (text: String, cache: List<CgCacheEntry>)
  ret match(g.globalInit)
    (init: RParam) => cgGlobalToCImplementSome(g, init, cache0)
    ()              => ("", cache0)
