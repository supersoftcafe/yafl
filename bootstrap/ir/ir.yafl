namespace Bootstrap::Ir

import System
import System::Containers

import Bootstrap::Ast

import Bootstrap::Codegen
import Bootstrap::Frontend
import Bootstrap::Lower::Ir
import Bootstrap::StdlibCandidates



# bootstrap/ir.yafl — port of compiler/codegen/ir.py: `Function`, `Object`,
# `Global` — the top-level IR units gen.py assembles into a program, plus the
# Function-local passes other stages share (lower_phis, strip_unused_operations).
# simplify_control_flow, fold_struct_fields, copy_propagate and
# eliminate_common_subexpressions belong to lower/ir/cleanup.yafl alone.
#
# NAMING: "Cg"-prefixed (CgFunction/CgObject/CgGlobal) for the same reason as
# typedecl.yafl's CgType family — plain "Function"/"Object"/"Global" are free
# today but this keeps the whole codegen surface visually consistent.


class [final] CgFuncSlot(slotVirtualName: String, slotGlobalName: String)

# What the `[inline]` attribute asks of the inliners (codegen/ir.py InlineMode).
# InlineEarly (bare `[inline]`) is a structural hint: the AST inliner takes the
# function at every level regardless of size, so lambdas handed to it (e.g. to
# `?>`) are beta-reduced rather than lifted to closures; the codegen inliner
# treats it as InlineAuto. InlineAlways (`[inline(always)]`) makes the codegen
# inliner inline at every call site regardless of size, at -O3 only, so a chain
# of marked functions fuses into its consumer (pre-async). InlineNever
# (`[inline(never)]`) keeps every call a call, size rule included.
enum InlineMode
  enum InlineAuto()
  enum InlineEarly()
  enum InlineAlways()
  enum InlineNever()

# fnSourceFile/fnSourceLine: --profile descriptors ("" / 0 for synthesised
# functions — their names self-describe). Declared LAST with defaults, the
# objIsPinnable pattern: fresh-construction sites (entrypoint, $async, lazy
# thunks, par callbacks) stay untouched and match Python's fresh Function()
# defaults; every dataclasses.replace-mirroring copy site passes them through.
# fnFuture: [future] — the body runs on a worker, a call answers with a task
# (lower/ir/future_functions.yafl); never inlined. Same pattern.
class [final] CgFunction(fnName: String, fnParams: CgType, fnResult: CgType, fnStackVars: CgType,
                          fnOps: Array<Op>, fnComment: String, fnForeignSymbol: String|None,
                          fnSync: Bool, fnTail: Bool, fnBypassAsync: Bool, fnInline: InlineMode,
                          fnSourceFile: String = "", fnSourceLine: Int = 0,
                          fnFuture: Bool = false)

# objIsPinnable: [pinnable] — immutable EXCEPT inside a late pin, which
# publishes into a write-once field. Unlike objIsMutable the object still
# relocates, so its READS must follow forwarding (lower/ir/pinnable_reads);
# a pointer taken before a relocation would otherwise see the pre-write copy.
# Declared LAST with a default so the eight other construction sites — all
# compiler-emitted classes, none of them pinnable — stay untouched.
# objCapacityField: the Int32 field sizing the storage past the length (a
# [capacity] field), or None — the vtable's array_cap_offset. Defaulted for
# the same reason; every pass that REBUILDS an object passes it on.
class [final] CgObject(objName: String, objExtends: List<String>, objFunctions: List<CgFuncSlot>,
                        objFields: CgType, objLengthField: String|None, objComment: String,
                        objIsForeign: Bool, objIsMutable: Bool, objDiscriminator: Int,
                        objIsPinnable: Bool = false, objCapacityField: String|None = None)

class [final] CgGlobal(globalName: String, globalType: CgType, globalInit: RParam|None,
                        globalObjectName: String|None, globalLazyInitFunction: String|None,
                        globalLazyInitFlag: String|None)

# ── small shared helpers ─────────────────────────────────────────────────────

# The default is unreachable: only used at in-bounds indices.
fun forceOp(x: Op|None): Op => x ?? OpAbort("", Dict())

fun pyStrOpt(o: String|None)
  # Mirrors Python's f"{value}" on a str|None: None interpolates as "None".
  ret match(o)
    (s: String) => s
    ()          => "None"

# ══════════════════════════════════════════════════════════════════════════
# Function
# ══════════════════════════════════════════════════════════════════════════

fun cgDeclareVars(cache0: List<CgCacheEntry>, sep, fields: List<CgField>, end): (text: String, cache: List<CgCacheEntry>)
  let result = fold(fields, ("", cache0, true), (acc, f) => cgDeclareVarsStep(acc, f, sep, end))
  ret (result.text, result.cache)

fun cgDeclareVarsStep(acc: (text: String, cache: List<CgCacheEntry>, first: Bool), f: CgField, sep: String, end): (text: String, cache: List<CgCacheEntry>, first: Bool)
  let sub = cgDeclare(f.fieldType, acc.cache)
  let piece = sub.text + " " + mangleName(f.fieldName) + end
  ret (acc.first ? piece : acc.text + sep + piece, sub.cache, false)

fun cgFunctionPrototype(f: CgFunction, cache0: List<CgCacheEntry>): (text: String, cache: List<CgCacheEntry>)
  let resultC = cgDeclare(f.fnResult, cache0)
  let paramsC = cgDeclareVars(resultC.cache, ", ", cgFieldsOfOrEmpty(f.fnParams), "")
  ret ("NOINLINE\n" + resultC.text + " " + mangleName(f.fnName) + "(" + paramsC.text + ")", paramsC.cache)

fun cgFunctionCommentLine(f: CgFunction)
  ret length(f.fnComment) == 0 ? "" : "// " + f.fnComment + "\n"

fun cgFunctionToCExtern(f: CgFunction, cache0: List<CgCacheEntry>): (text: String, cache: List<CgCacheEntry>)
  let resultC = cgDeclare(f.fnResult, cache0)
  let paramsC = cgDeclareVars(resultC.cache, ", ", cgFieldsOfOrEmpty(f.fnParams), "")
  ret ("extern " + resultC.text + " " + pyStrOpt(f.fnForeignSymbol) + "(" + paramsC.text + ");\n", paramsC.cache)

fun cgFunctionToCPrototype(f: CgFunction, cache0: List<CgCacheEntry>): (text: String, cache: List<CgCacheEntry>)
  let proto = cgFunctionPrototype(f, cache0)
  ret (cgFunctionCommentLine(f) + proto.text + ";\n", proto.cache)

fun cgFunctionToCImplement(f: CgFunction, cache0: List<CgCacheEntry>): (text: String, cache: List<CgCacheEntry>)
  let varsC = cgDeclareVars(cache0, "    ", cgFieldsOfOrEmpty(f.fnStackVars), ";\n")
  let varsSection = length(varsC.text) == 0 ? "" : "    " + varsC.text + "\n"
  let proto = cgFunctionPrototype(f, varsC.cache)
  let opsC = cgOpsToC(f.fnOps, proto.cache)
  ret (cgFunctionCommentLine(f) + proto.text + "\n{\n" + varsSection + opsC.text + "}\n", opsC.cache)

fun cgOpsToC(ops: Array<Op>, cache0: List<CgCacheEntry>): (text: String, cache: List<CgCacheEntry>)
  ret fold(ops, ("", cache0), cgOpsToCStep)

fun cgOpsToCStep(acc: (text: String, cache: List<CgCacheEntry>), op): (text: String, cache: List<CgCacheEntry>)
  let sub = opToC(op, acc.cache)
  ret (acc.text + sub.text, sub.cache)

# ── op sequences ─────────────────────────────────────────────────────────────
# A function's ops are an Array<Op>, built by appending.

fun lastOp(s: Array<Op>): Op|None => size(s) > 0 ? s[size(s) - 1] : None

# arrayOf's one to three values, extended to the four and five that op
# sequences need.
fun arrayOf4<T>(a: T, b: T, c: T, d: T): Array<T> => push<T>(arrayOf<T>(a, b, c), d)

fun arrayOf5<T>(a: T, b: T, c: T, d: T, e: T): Array<T> => pushAll<T>(arrayOf<T>(a, b, c), arrayOf<T>(d, e))

fun cgFunctionWith(f: CgFunction, ops, stackVars)
  ret CgFunction(f.fnName, f.fnParams, f.fnResult, stackVars, ops, f.fnComment, f.fnForeignSymbol,
                 f.fnSync, f.fnTail, f.fnBypassAsync, f.fnInline,
                 f.fnSourceFile, f.fnSourceLine, f.fnFuture)

# ── --profile instrumentation (ir.py instrument_profile) ─────────────────────
# ProfEnter first, ProfLeave before every exit — Return, ReturnVoid, and
# musttail Call (the frame is replaced, so it leaves). Runs AFTER the emission
# cleanup chain, so no optimisation pass ever sees these ops and the pairing
# cannot be broken. Abort is deliberately not bracketed: abort() skips the
# atexit dump, so there is nothing to keep balanced.

fun cgFunctionInstrumentProfile(f: CgFunction, fnId)
  let ops = fold(f.fnOps, push(Array<Op>(), OpProfEnter(fnId, Dict())), cgInstrumentOp)
  ret cgFunctionWith(f, ops, f.fnStackVars)

fun cgInstrumentOp(acc: Array<Op>, op: Op): Array<Op>
  ret push(cgIsProfExit(op) ? push(acc, OpProfLeave(Dict())) : acc, op)

# Leaves the function: a return, or a musttail call (its frame is replaced).
fun cgIsProfExit(op) => match(op)
  (x: OpReturn)            => true
  (x: OpReturnVoid)        => true
  (x: OpCall)              => x.callMusttail
  (x: OpLabel)             => false
  (x: OpMove)              => false
  (x: OpJump)              => false
  (x: OpJumpIf)            => false
  (x: OpIfTask)            => false
  (x: OpAssertNotTask)     => false
  (x: OpSwitchJump)        => false
  (x: OpNewObject)         => false
  (x: OpAwait)             => false
  (x: OpAbort)             => false
  (x: OpPhi)               => false
  (x: OpProfEnter)         => false
  (x: OpProfLeave)         => false

fun cgFunctionReplaceParams(f: CgFunction, replacer)
  ret cgFunctionWith(f, map(f.fnOps, (op) => opReplaceParams(op, replacer)), f.fnStackVars)

# ── lower_phis ───────────────────────────────────────────────────────────────

class [final] PhiAtEntry(atLabel: String, phiOp: Op)

fun cgCollectPhis(ops: Array<Op>)
  let result = fold(ops, ("", List()), cgCollectPhisStep)
  ret result.phis

fun cgCollectPhisStep(acc: (curLabel: String, phis: List<PhiAtEntry>), op): (curLabel: String, phis: List<PhiAtEntry>)
  ret match(op)
    (l: OpLabel) => (l.labelName, acc.phis)
    (p: OpPhi) => (acc.curLabel,
                   append(acc.phis, PhiAtEntry(acc.curLabel, op)))
    (o: Op) => (acc.curLabel, acc.phis)

fun phisAtLabel(phis: List<PhiAtEntry>, label: String)
  ret map(filter(phis, (e) => e.atLabel == label), (e) => e.phiOp)

fun phiSourceFor(phi, predLabel) => match(phi)
  (p: OpPhi) => phiSourceForSources(p.phiSources, predLabel)
  (o: Op)    => RpNullPointer()   # unreachable

fun phiSourceForSources(sources: List<OpPhiSource>, predLabel) => match(firstWhere(sources, (s) => s.sourceLabel == predLabel))
  (s: OpPhiSource) => s.sourceValue
  ()               => RpNullPointer()   # unreachable (Python raises AssertionError)

fun cgPhiToMove(phi, predLabel) => match(phi)
  (p: OpPhi) => OpMove(p.phiTarget, phiSourceFor(phi, predLabel), false, Dict())
  (o: Op)    => o   # unreachable

# The emitted op stream, plus the two facts the walk needs about what it has
# already emitted: the label currently open, and whether the last op falls
# through into the next. `paFall` is MAINTAINED as ops are pushed — deriving it
# meant asking last(out), which walks the entire emitted stream, once per op of
# the function.
class [final] PhiAcc(paCur: String, paOut: Array<Op>, paFall: Bool)

fun cgPhiMoves(ps: List<Op>, predLabel, acc: Array<Op>) =>
  fold(ps, acc, (b, p) => push(b, cgPhiToMove(p, predLabel)))

fun cgLowerPhisJump(acc: PhiAcc, j: OpJump,
                    phis: List<PhiAtEntry>)
  ret PhiAcc(acc.paCur,
             push(cgPhiMoves(phisAtLabel(phis, j.jumpName),
                             acc.paCur, acc.paOut),
                  OpJump(j.jumpName, j.jumpSavedVars)),
             false)

fun cgLowerPhisLabel(acc: PhiAcc, l: OpLabel,
                     phis: List<PhiAtEntry>)
  let group = phisAtLabel(phis, l.labelName)
  ret PhiAcc(l.labelName,
             push(!isEmpty(group) && acc.paFall
                    ? cgPhiMoves(group, acc.paCur, acc.paOut)
                    : acc.paOut,
                  l),
             true)

fun cgLowerPhisStep(acc: PhiAcc, op,
                    phis: List<PhiAtEntry>) => match(op)
  (p: OpPhi)     => acc   # already lowered into Moves on predecessor edges
  (j: OpJump)    => cgLowerPhisJump(acc, j, phis)
  # (Python asserts the label is not in phis_at; unenforced here too)
  (ji: OpJumpIf) => PhiAcc(acc.paCur, push(acc.paOut, op), true)
  (l: OpLabel)   => cgLowerPhisLabel(acc, l, phis)
  (o: Op)        => PhiAcc(acc.paCur, push(acc.paOut, op),
                           opFallsThrough(op))

fun cgLowerPhisPass2(ops: Array<Op>, phis: List<PhiAtEntry>)
  ret fold(ops, PhiAcc("", Array<Op>(), false),
           (acc: PhiAcc, op: Op) => cgLowerPhisStep(acc, op, phis)).paOut

fun cgLowerPhisForEmission(f: CgFunction)
  let phis = cgCollectPhis(f.fnOps)
  ret isEmpty(phis) ? f.fnOps : cgLowerPhisPass2(f.fnOps, phis)

fun cgFunctionLowerPhis(f: CgFunction)
  ret cgFunctionWith(f, cgLowerPhisForEmission(f), f.fnStackVars)

# ── op-stream pull (shared by every lookahead walk) ─────────────────────────

# One O(n) walk per pass. A streamed lookahead cannot peek a neighbouring
# op, so the stream pull maintains a TWO-OP window
# (cur, n1, n2) carried as parameters; the window shifts by one (drop or
# emit cur) or by two (the invertible jumpIf+jump pair consumes both).
# Ok(None)-after-end makes the unconditional refill pulls safe. Shared by
# every op-stream walk that carries a lookahead window (simplify, tail-call
# discovery, block partition, ...).
fun [inline(always)] cgPullOp(st: ArrayStream<Op>): (stream: ArrayStream<Op>, op: Op|None)
  let r = streamNext(st)
  ret match(r.value)
    (ok: Ok<Op | None, Never>)    => (r.stream, ok.value)
    (er: Error<Op | None, Never>) => (r.stream, None)   # unreachable: Never

# ── strip_unused_operations ──────────────────────────────────────────────────

# Dict-indexed reachability (the list-of-pairs label index, per-index list
# walks and O(n) membership were all quadratic-or-worse and cgKeepSeenIndices
# recursed one C frame PER OP — the -O3 mega-function stack overflow).
# Python: labels = {name: index} (LAST duplicate wins, dict semantics);
# traversal order does not affect the seen SET, so the worklist is a stack.

class [final] StripIx(sxOps: Array<Op>, sxN: Int,
                      sxLabels: Dict<String, Int>)

fun cgStripIndex(ops: Array<Op>): StripIx
  let built = fold(ops, (0, Dict()),
        (acc: (i: Int, labels: Dict<String, Int>), op) =>
          (acc.i + 1, cgStripLabelPut(acc.labels, op, acc.i)))
  ret StripIx(ops, built.i, built.labels)

fun cgStripLabelPut(labels, op, i: Int): Dict<String, Int> => match(op)
  (l: OpLabel) => put(labels, l.labelName, i)
  (o: Op)       => labels

# Callers keep 0 <= i < sxN.
fun sxOpAt(ix: StripIx, i: Int): Op => ix.sxOps[i]

fun labelIndexLookup(ix: StripIx, name: String) => match(get(ix.sxLabels, name))
  (i: Int) => i
  ()        => -1

fun cgSuccessors(ix: StripIx, index): List<Int>
  let op = sxOpAt(ix, index)
  let fallthrough = index + 1 < ix.sxN
    ? prepend(index + 1, List())
    : List()
  ret cgSuccessorsOf(op, ix, fallthrough)

fun cgSuccessorsOf(op, ix: StripIx, fallthrough)
  ret concat(map(opBranchTargets(op), (name) => labelIndexLookup(ix, name)),
             opFallsThrough(op) ? fallthrough : List())

fun cgAddOneSuccessor(acc,
                      s: Int): (seen: Dict<Int, Bool>, worklist: List<Int>)
  ret get(acc.seen, s) is Bool
    ? acc
    : (put(acc.seen, s, true), prepend(s, acc.worklist))


fun [tail] cgReachableLoop(ix: StripIx, worklist,
                           seen: Dict<Int, Bool>): Dict<Int, Bool>
  if isEmpty(worklist)
    ret seen
  let idx = head(worklist) ?? 0
  let added = fold(cgSuccessors(ix, idx), (seen, dropOne(worklist)),
        cgAddOneSuccessor)
  ret cgReachableLoop(ix, added.worklist, added.seen)

fun cgReachable(ix: StripIx) => cgReachableLoop(ix, List<Int>(0), put(Dict(), 0, true))

fun [tail] cgKeepSeenIndices(s: Array<Op>, i: Int, seen: Dict<Int, Bool>,
                             acc: Array<Op>): Array<Op>
  ret i < size(s)
    ? cgKeepSeenIndices(s, i + 1, seen, get(seen, i) is Bool ? push(acc, s[i]) : acc)
    : acc

fun cgFunctionStripUnusedOperations(f: CgFunction)
  let ix = cgStripIndex(f.fnOps)
  let seen = cgReachable(ix)
  let newOps = cgKeepSeenIndices(f.fnOps, 0, seen, Array<Op>())
  ret cgWithoutStalePhiSources(cgFunctionWith(f, newOps, f.fnStackVars))

# Drop each Phi source whose block no longer reaches the Phi's block:
# stripping unreachable ops deletes edges, and a Phi must name exactly its
# block's predecessors (lower/ir/ssa_validate.yafl).
fun cgWithoutStalePhiSources(f: CgFunction): CgFunction
  if isEmpty(cgCollectPhis(f.fnOps))
    ret f
  let preds = cgBlockPredecessors(f)
  ret cgFunctionWith(f, cgPrunePhisLoop(f.fnOps, 0, preds, "", Array<Op>()),
                     f.fnStackVars)

fun [tail] cgPrunePhisLoop(s: Array<Op>, i: Int, preds: List<PredEntry>, current: String,
                           acc: Array<Op>): Array<Op>
  ret i < size(s)
    ? cgPrunePhisLoop(s, i + 1, preds, cgPredNextCurrent(s[i], current),
                      push(acc, cgPrunePhi(s[i], predsOf(preds, current))))
    : acc

fun cgPrunePhi(op: Op, live: Set<String>): Op => match(op)
  (ph: OpPhi) => OpPhi(ph.phiTarget, filter(ph.phiSources, (s2) => contains(live, s2.sourceLabel)),
                       ph.phiSavedVars)
  (o: Op)     => op

# For each labelled block: the set of predecessor labels ("" = the implicit
# entry block) reachable via Jump/JumpIf/IfTask/SwitchJump/fall-through.
class [final] PredEntry(peLabel: String, pePreds: Set<String>)

fun cgBlockPredecessors(f: CgFunction): List<PredEntry>
  let p0 = cgPullOp(arrayStream(f.fnOps))
  ret cgPredLoop(p0.op, p0.stream, None, "", List())

fun [tail] cgPredLoop(cur: Op|None, st: ArrayStream<Op>, prev: Op|None, current,
                        acc): List<PredEntry>
  if cur is None
    ret acc
  let op = forceOp(cur)
  let p = cgPullOp(st)
  ret cgPredLoop(p.op, p.stream, op, cgPredNextCurrent(op, current),
                   cgPredStep(op, prev, current, acc))

fun cgPredNextCurrent(op, current) => match(op)
  (lb: OpLabel) => lb.labelName
  (o: Op)       => current

fun cgPredStep(op, prev: Op|None, current, acc: List<PredEntry>)
  ret fold(opBranchTargets(op), cgPredLabelStep(op, prev, current, acc),
           (a, target) => predAdd(a, target, current))

fun cgPredLabelStep(op, prev: Op|None, current, acc: List<PredEntry>) => match(op)
  (lb: OpLabel) => cgPredFallThroughEdge(lb, prev, current, predEnsure(acc, lb.labelName))
  (o: Op)       => acc

# Fall-through edge from the previous block, if control falls out of it.
fun cgPredFallThroughEdge(lb: OpLabel, prev: Op|None, current,
                        acc: List<PredEntry>) => match(prev)
  (p: Op) => opFallsThrough(p) ? predAdd(acc, lb.labelName, current) : acc
  ()       => acc

fun predEnsure(acc: List<PredEntry>, label) => any(acc, (e2) => e2.peLabel == label)
  ? acc
  # A label -> predecessors map, looked up by label; its own order is not
  # observed, and the predecessor lists are membership sets.
  : prepend(PredEntry(label, Set()), acc)

fun predAdd(acc: List<PredEntry>, label, src) => any(acc, (e2) => e2.peLabel == label)
  ? map(acc, (e2) => e2.peLabel == label
               ? PredEntry(label, add(e2.pePreds, src))
               : e2)
  : prepend(PredEntry(label, add(Set(), src)), acc)

fun predsOf(acc: List<PredEntry>, label: String)
  ret match(head(filter(acc, (e2) => e2.peLabel == label)))
    (e2: PredEntry) => e2.pePreds
    ()               => Set()


# ══════════════════════════════════════════════════════════════════════════
# Object
# ══════════════════════════════════════════════════════════════════════════

fun cgObjectArrayType(o: CgObject) => match(head(takeLastOne(cgFieldsOfOrEmpty(o.objFields))))
  (f: CgField) => cgObjectArrayTypeField(f.fieldType)
  ()            => None

fun cgObjectArrayTypeField(ft) => match(ft)
  (a: CgArray) => a.elemType
  (t2: CgType) => None

fun cgObjectCommentLine(o: CgObject) => length(o.objComment) == 0 ? "" : "// " + o.objComment + "\n"

fun cgObjectMaskFields(o: CgObject)
  let allFields = cgFieldsOfOrEmpty(o.objFields)
  let withoutFirst = dropOne(allFields)
  ret match(cgObjectArrayType(o))
    (a: CgType) => CgStruct(dropLastOne(withoutFirst))
    ()           => CgStruct(withoutFirst)

fun cgObjectGetPointerMask(o: CgObject)
  ret toPointerMaskWindow(cgObjectMaskFields(o), mangleName(o.objName) + "_t", 0)

fun cgObjectGetPointerMaskWindowCount(o: CgObject): Int
  ret (1 + cgWordsUpperBound(cgObjectMaskFields(o)) + 63) / 64

fun cgObjectGetPointerMaskWindow(o: CgObject, window: Int)
  ret toPointerMaskWindow(cgObjectMaskFields(o), mangleName(o.objName) + "_t", window)

fun cgObjectGetArrayPointerMaskSome(a, cache0: List<CgCacheEntry>): (text: String, cache: List<CgCacheEntry>)
  let declared = cgDeclare(a, cache0)
  ret (toPointerMask(a, declared.text), declared.cache)

fun cgObjectGetArrayPointerMask(o: CgObject, cache0: List<CgCacheEntry>): (text: String, cache: List<CgCacheEntry>)
  ret match(cgObjectArrayType(o))
    (a: CgType) => cgObjectGetArrayPointerMaskSome(a, cache0)
    ()           => ("0", cache0)

fun cgLastFieldName(o: CgObject) => match(head(takeLastOne(cgFieldsOfOrEmpty(o.objFields))))
  (f: CgField) => f.fieldName
  ()            => ""

fun cgObjectGetObjectSize(o: CgObject)
  let typeStr = mangleName(o.objName) + "_t"
  ret match(cgObjectArrayType(o))
    (a: CgType) => "offsetof(" + typeStr + ", " + mangleName(cgLastFieldName(o)) + ")"
    ()           => "sizeof(" + typeStr + ")"

fun cgObjectGetArrayElSizeSome(a, cache0: List<CgCacheEntry>): (text: String, cache: List<CgCacheEntry>)
  let declared = cgDeclare(a, cache0)
  ret ("sizeof(" + declared.text + ")", declared.cache)

fun cgObjectGetArrayElSize(o: CgObject, cache0: List<CgCacheEntry>): (text: String, cache: List<CgCacheEntry>)
  ret match(cgObjectArrayType(o))
    (a: CgType) => cgObjectGetArrayElSizeSome(a, cache0)
    ()           => ("0", cache0)

fun cgObjectGetArrayLengthOffset(o: CgObject) => match(o.objLengthField)
  (l: String) => "offsetof(" + mangleName(o.objName) + "_t, " + mangleName(l) + ")"
  ()           => "0"

# ══════════════════════════════════════════════════════════════════════════
# Global
# ══════════════════════════════════════════════════════════════════════════

fun cgGlobalToCName(g: CgGlobal) => mangleName(g.globalName)

fun cgGlobalPrototypePlain(g: CgGlobal, cache0: List<CgCacheEntry>, storage: String): (text: String, cache: List<CgCacheEntry>)
  let declared = cgDeclare(g.globalType, cache0)
  ret (storage + declared.text + " " + cgGlobalToCName(g), declared.cache)

fun cgGlobalPrototypeInitArrayField(acc: (text: String, cache: List<CgCacheEntry>), v: RpNamedValue): (text: String, cache: List<CgCacheEntry>)
  let declared = cgDeclare(rpGetType(v.value), acc.cache)
  ret (acc.text + "    " + declared.text + " " + v.name + ";\n", declared.cache)

fun cgGlobalPrototypeInitArrayForm(g: CgGlobal, values: List<RpNamedValue>, cache0: List<CgCacheEntry>, storage: String): (text: String, cache: List<CgCacheEntry>)
  let result = fold(values, ("", cache0), cgGlobalPrototypeInitArrayField)
  ret (storage + "struct {\n" + result.text + "}[1] " + cgGlobalToCName(g), result.cache)

fun cgGlobalPrototypeDataForm(g: CgGlobal, objName, cache0: List<CgCacheEntry>, storage: String): (text: String, cache: List<CgCacheEntry>)
  ret (storage + mangleName(objName) + "_t " + cgGlobalToCName(g) + "_data;\n"
       + storage + "object_t* " + cgGlobalToCName(g), cache0)

# Python: `isinstance(self.init.values[-1], p.InitArray)` — but `values[-1]`
# is a (name, value) TUPLE, so the isinstance is ALWAYS False and the
# InitArray prototype/implement forms are dead code (nothing in the compiler
# constructs a Global with an InitArray value either — trim.py only ever
# consumes them). Ported faithfully: always false. The dead branches are kept
# below (cgGlobalPrototypeInitArrayForm / cgGlobalToCImplementInitArrayForm)
# so the port stays line-mappable to the Python; flagged in the port report.
fun cgGlobalPrototypeNewStructLastIsInitArray(lastVal: RpNamedValue) => false

fun cgGlobalPrototypeNewStruct(g: CgGlobal, objName, ns: RpNewStruct, cache0: List<CgCacheEntry>, storage: String): (text: String, cache: List<CgCacheEntry>)
  ret match(head(takeLastOne(ns.values)))
    (lastVal: RpNamedValue) if cgGlobalPrototypeNewStructLastIsInitArray(lastVal) =>
        cgGlobalPrototypeInitArrayForm(g, ns.values, cache0, storage)
    ()                        => cgGlobalPrototypeDataForm(g, objName, cache0, storage)

fun cgGlobalPrototypeWithObject(g: CgGlobal, objName, init, cache0: List<CgCacheEntry>, storage: String): (text: String, cache: List<CgCacheEntry>)
  ret match(init)
    (ns: RpNewStruct) => cgGlobalPrototypeNewStruct(g, objName, ns, cache0, storage)
    (o: RParam)         => ("", cache0)   # unreachable (Python raises ValueError)

fun cgGlobalPrototype(g: CgGlobal, cache0: List<CgCacheEntry>, storage: String): (text: String, cache: List<CgCacheEntry>)
  ret match(g.globalObjectName)
    (objName: String) => cgGlobalPrototypeMaybeInit(g, objName, cache0, storage)
    ()                  => cgGlobalPrototypePlain(g, cache0, storage)

fun cgGlobalPrototypeMaybeInit(g: CgGlobal, objName, cache0: List<CgCacheEntry>, storage: String): (text: String, cache: List<CgCacheEntry>)
  ret match(g.globalInit)
    (init: RParam) => cgGlobalPrototypeWithObject(g, objName, init, cache0, storage)
    ()              => cgGlobalPrototypePlain(g, cache0, storage)

fun cgGlobalToCPrototype(g: CgGlobal, cache0: List<CgCacheEntry>): (text: String, cache: List<CgCacheEntry>)
  let proto = cgGlobalPrototype(g, cache0, "extern ")
  ret (proto.text + ";\n", proto.cache)

fun cgGlobalToCImplementPlain(g: CgGlobal, init, cache0: List<CgCacheEntry>): (text: String, cache: List<CgCacheEntry>)
  let proto = cgGlobalPrototype(g, cache0, "")
  let initC = rpToC(init, proto.cache)
  ret (proto.text + " = " + initC.text + ";", initC.cache)

fun cgGlobalImplementValueLine(acc: (text: String, cache: List<CgCacheEntry>), v): (text: String, cache: List<CgCacheEntry>)
  let sub = rpToC(v, acc.cache)
  ret (acc.text + "  , " + sub.text + "\n", sub.cache)

fun cgGlobalToCImplementInitArrayForm(g: CgGlobal, objName, values: List<RpNamedValue>, cache0: List<CgCacheEntry>): (text: String, cache: List<CgCacheEntry>)
  let proto = cgGlobalPrototype(g, cache0, "")
  let result = fold(values, ("", proto.cache), (acc, v) => cgGlobalImplementValueLine(acc, v.value))
  ret (proto.text + " = {\n    (object_t*)((char*)obj_" + mangleName(objName) + " + VTABLE_TAG_BIT)\n" + result.text + "};\n", result.cache)

fun cgGlobalToCImplementDataForm(g: CgGlobal, objName, values: List<RpNamedValue>, cache0: List<CgCacheEntry>): (text: String, cache: List<CgCacheEntry>)
  let dataName = cgGlobalToCName(g) + "_data"
  let result = fold(values, ("    (object_t*)((char*)obj_" + mangleName(objName) + " + VTABLE_TAG_BIT)\n", cache0), (acc, v) => cgGlobalImplementValueLine(acc, v.value))
  ret (mangleName(objName) + "_t " + dataName + " = {\n" + result.text + "};\n"
       + "object_t* " + cgGlobalToCName(g) + " = (object_t*)&" + dataName + ";\n", result.cache)

fun cgGlobalToCImplementNewStruct(g: CgGlobal, objName, ns: RpNewStruct, cache0: List<CgCacheEntry>): (text: String, cache: List<CgCacheEntry>)
  ret match(head(takeLastOne(ns.values)))
    (lastVal: RpNamedValue) if cgGlobalPrototypeNewStructLastIsInitArray(lastVal) =>
        cgGlobalToCImplementInitArrayForm(g, objName, ns.values, cache0)
    ()                        => cgGlobalToCImplementDataForm(g, objName, ns.values, cache0)

fun cgGlobalToCImplementObject(g: CgGlobal, objName, init, cache0: List<CgCacheEntry>): (text: String, cache: List<CgCacheEntry>)
  ret match(init)
    (ns: RpNewStruct) => cgGlobalToCImplementNewStruct(g, objName, ns, cache0)
    (o: RParam)         => ("", cache0)   # unreachable (Python raises ValueError)

fun cgGlobalToCImplementSome(g: CgGlobal, init, cache0: List<CgCacheEntry>): (text: String, cache: List<CgCacheEntry>)
  ret match(g.globalObjectName)
    (objName: String) => cgGlobalToCImplementObject(g, objName, init, cache0)
    ()                  => cgGlobalToCImplementPlain(g, init, cache0)

# No initialiser: the data unit still has to DEFINE it (the header only declares).
fun cgGlobalToCImplementUninit(g: CgGlobal, cache0: List<CgCacheEntry>): (text: String, cache: List<CgCacheEntry>)
  let proto = cgGlobalPrototype(g, cache0, "")
  ret (proto.text + ";\n", proto.cache)

fun cgGlobalToCImplement(g: CgGlobal, cache0: List<CgCacheEntry>): (text: String, cache: List<CgCacheEntry>)
  ret match(g.globalInit)
    (init: RParam) => cgGlobalToCImplementSome(g, init, cache0)
    ()              => cgGlobalToCImplementUninit(g, cache0)
