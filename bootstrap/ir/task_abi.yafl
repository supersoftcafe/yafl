# bootstrap/task_abi.yafl — the task ABI, ported from lowering/task_abi.py:
# how functions signal "the result is a task" to callers, at the IR level
# (tagged task values, inspection) and the type level (which return shapes
# need a CgTaskWrapper). Shared by async_lower, tail_trampoline and
# lazy_thunks — one source of truth for the ABI.
namespace Bootstrap::Ir

import System

import Bootstrap::StdlibCandidates
import Bootstrap::Types



# Layout of every task subtype's prefix — must match `task_t` in yafl.h byte
# for byte so a `(task_t*)` cast of any subtype hits each field at the right
# offset.
fun taskFields() => build(
    push(
    push(
    push(
    push(
    push(builder(),
      CgField("type", CgDataPointer())),        # object_t vtable
      CgField("state", CgInt(32))),             # _Atomic(int32_t)
      CgField("thread_id", CgInt(32))),         # originating worker thread index
      CgField("callback", CgFuncPointer(false))),    # fun_t
      CgField("next", CgDataPointer())))        # _Atomic(task_t*) — queue link

# The empty value — YAFL's None. It carries nothing.
fun isUnit(t2) => match(cgFieldsOf(t2))
  (fields: List<CgField>) => isEmpty(fields)
  ()                       => false

# Adjust a function's return type so it can carry the task-pending signal: a
# pointer-shaped type carries the tag in-band; the empty value has nothing to
# carry, so its return is the task pointer alone (NULL when complete);
# anything else wraps in CgTaskWrapper {value, task*}.
fun wrapReturnType(t2) => match(t2)
  (v: CgVoid)         => t2
  (d: CgDataPointer)  => t2
  (fp: CgFuncPointer) => t2
  (st: CgStr)         => t2
  (o: CgType)         => isUnit(t2) ? CgDataPointer() : wrapIfNoPointer(t2)

fun wrapIfNoPointer(t2) => match(cgFirstPointerField(t2))
  (name: String) => t2
  ()              => CgTaskWrapper(t2)

# A completed result `value` in its task-carrying return shape `wrapped`
# (= wrapReturnType of the value's type). A value already in that shape —
# e.g. a hand-built async-pending TagTask — passes through.
fun wrapValue(value, wrapped): RParam
  if eqCgType(rpGetType(value), wrapped)
    ret value
  ret match(wrapped)
    (w: CgTaskWrapper) => RpSyncWrap(value, wrapped)
    (o: CgType)        => isUnit(rpGetType(value)) ? RpNullPointer() : value

# The value of a completed result received in its task-carrying return shape
# (wrapReturnType(valueType)).
fun unwrapValue(received, valueType): RParam
  let wrapped = wrapReturnType(valueType)
  if eqCgType(wrapped, valueType)
    ret received
  ret match(wrapped)
    (w: CgTaskWrapper) => RpStructField(received, "value")
    (o: CgType)        => isUnit(valueType) ? RpZeroOf(valueType) : received   # else unreachable (Python raises ValueError)

# Canonical name of the compiler-generated task subtype carrying
# `resultType`, or None for Void and the empty value (base task_t — there is
# no result to store). Types storing the same C
# value in the result field share one subtype; distinct struct layouts get a
# unique name — sha1 over the same structural signature _ir_mangle hashes
# (taskTypeSig below), byte-identical to Python's task_abi._type_sig.
fun [tail] taskSubtypeName(resultType) => match(resultType)
  (v: CgVoid)          => None
  # DataPointer (bigint, class pointers) — all stored as object_t*;
  # maps to yafllib's pre-declared task_obj_t (yafl.h).
  (d: CgDataPointer)   => "task_obj"
  (fp: CgFuncPointer)  => "task$FuncPointer"
  # A String value, or a union sharing its representation: yafllib's
  # pre-declared task_str_t — the runtime's IO jobs resolve one too.
  (st: CgStr)          => "task_str"
  (i: CgInt)           => "task$Int" + String(i.precision)
  (w: CgTaskWrapper)   => taskSubtypeName(w.inner)
  (o: CgType)          => isUnit(o) ? None : "task$T" + slice(sha1Hex(taskTypeSig(o)), 0, 16)

# The structural signature taskSubtypeName hashes — Python task_abi._type_sig.
fun [tail] taskTypeSig(t2) => match(t2)
  (d: CgDataPointer)  => "ptr"
  (i: CgInt)          => "i" + String(i.precision)
  (fp: CgFuncPointer) => "fun"
  (st: CgStr)         => "str"
  (w: CgTaskWrapper)  => taskTypeSig(w.inner)
  (s2: CgStruct)      => taskSigFields(s2.fields)
  (im: CgImmediateStruct) => taskSigFields(im.fields)
  (f: CgFloat)        => "f" + String(f.precision)
  (o: CgType)         => ""   # unreachable for shapes that can carry a task result

fun taskSigFields(fields: List<CgField>)
  ret join(map(fields, (f2) => f2.fieldName + ":" + taskTypeSig(f2.fieldType)), "|")

# Foreign 'task' Object — its typedef lives in yafl.h; the field list is
# published so subtypes extend it via normal inheritance and ObjectField
# accesses to inherited fields resolve at the correct offsets.
fun makeTaskForeignObject() => CgObject("task", List(), List(),
                                        CgImmediateStruct(taskFields()), None,
                                        "foreign task_t — declared in yafllib/yafl.h",
                                        true, false, 0)

# Task subtypes yafllib declares itself (yafl.h), each allocated by its own
# `<name>_create`.
fun isRuntimeTaskSubtype(name: String) => name == "task_obj" || name == "task_str"

# A task subtype carrying `resultType` in its trailing `result` field.
# The runtime task subtypes are pre-declared in yafllib so they stay foreign;
# other subtypes are compiler-emitted. is_mutable: state/result/next written
# after construction.
fun makeTaskSubtypeObject(subtypeName, resultType)
  ret CgObject(subtypeName, list1("task"), List(),
               # The task_t prefix, then the result field LAST.
               CgImmediateStruct(build(push(builderFrom(taskFields()), CgField("result", resultType)))),
               None, "task subtype for result type " + taskTypeSig(resultType),
               isRuntimeTaskSubtype(subtypeName), true, 0)

# Truthy (Int32) when `resultVar` carries a task signal; `wrappedType` is the
# ALREADY-wrapped return type.
fun isTaskParam(resultVar, wrappedType): RParam => match(wrappedType)
  (d: CgDataPointer)  => RpRuntimeInvoke("PTR_IS_TASK",
                           RpNewStruct(list1(RpNamedValue("p", resultVar))), CgInt(32))
  (fp: CgFuncPointer) => RpRuntimeInvoke("PTR_IS_TASK",
                           RpNewStruct(list1(RpNamedValue("p", RpStructField(resultVar, "o")))), CgInt(32))
  (st: CgStr)         => RpRuntimeInvoke("PTR_IS_TASK",
                           RpNewStruct(list1(RpNamedValue("p", RpStructField(resultVar, "head")))), CgInt(32))
  (w: CgTaskWrapper)  => RpStructField(resultVar, "task")
  (o: CgType)         => isTaskParamStruct(resultVar, o)

fun isTaskParamStruct(resultVar, wrappedType) => match(cgFirstPointerField(wrappedType))
  (name: String) => RpRuntimeInvoke("PTR_IS_TASK",
                      RpNewStruct(list1(RpNamedValue("p", RpStructField(resultVar, name)))), CgInt(32))
  ()              => RpNullPointer()   # unreachable (Python raises ValueError)

# The pointer-to-task (suitable for TASK_UNTAG) from a task-carrying result.
fun taskPtrFrom(resultVar, wrappedType) => match(wrappedType)
  (d: CgDataPointer)  => resultVar
  (fp: CgFuncPointer) => RpStructField(resultVar, "o")
  (st: CgStr)         => RpStructField(resultVar, "head")
  (w: CgTaskWrapper)  => RpStructField(resultVar, "task")
  (o: CgType)         => taskPtrFromStruct(resultVar, o)

fun taskPtrFromStruct(resultVar, wrappedType) => match(cgFirstPointerField(wrappedType))
  (name: String) => RpStructField(resultVar, name)
  ()              => RpNullPointer()   # unreachable (Python raises ValueError)
