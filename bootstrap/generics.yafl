# bootstrap/generics.yafl — monomorphisation, ported from lowering/generics.py
# (part 1: naming, concreteness, instantiation finding, substitution,
# specialisation; the iterative driver and trait resolution follow below).
namespace Bootstrap

import System

# A concrete instantiation: (generic name, type args). Sets of these are kept
# as lists deduplicated by their MANGLED key.
class [final] GRef(grName: String, grArgs: List<Spec>)
class [final] GRefs(gdData: List<GRef>, gdTypes: List<GRef>)

# name$generic$uid1_uid2 — "unknown" for an id-less arg, exactly as Python.
fun mangledName(base: String, args: List<Spec>): String
  ret isEmpty(args) ? base : base + "$generic$" + joinUids(chain(args), "")

fun [tail] joinUids(as2: Chain<Spec>, acc: String): String
  ret match(as2)
    (nil: ChainEnd) => acc
    (l: ChainLink)  => joinUids(l.next,
                                acc == ""
                                  ? uidOrUnknown(l.value)
                                  : acc + "_" + uidOrUnknown(l.value))

fun uidOrUnknown(sp: Spec): String
  ret uid(sp) == "" ? "unknown" : uid(sp)

fun refKey(g2: GRef): String
  ret mangledName(g2.grName, g2.grArgs)

fun addRef(refs: List<GRef>, g2: GRef): List<GRef>
  ret hasRefKey(chain(refs), refKey(g2)) ? refs : append(refs, g2)

fun [tail] hasRefKey(rs: Chain<GRef>, key: String): Bool
  ret match(rs)
    (nil: ChainEnd) => false
    (l: ChainLink)  => refKey(l.value) == key ? true : hasRefKey(l.next, key)

fun [tail] addRefs(refs: List<GRef>, rs: Chain<GRef>): List<GRef>
  ret match(rs)
    (nil: ChainEnd) => refs
    (l: ChainLink)  => addRefs(addRef(refs, l.value), l.next)

# ── concreteness ────────────────────────────────────────────────────────────
# Args are usable for an instantiation only when: no bare placeholder; no
# spec still carrying its OWN type params (its uid ignores them — using it
# names the instantiation after the raw template and collides them all); no
# union holding a placeholder anywhere.

fun isConcreteTypeArgs(args: List<Spec>): Bool
  ret allConcreteArgs(chain(args))

fun [tail] allConcreteArgs(as2: Chain<Spec>): Bool
  ret match(as2)
    (nil: ChainEnd) => true
    (l: ChainLink)  => concreteArg(l.value) ? allConcreteArgs(l.next) : false

fun concreteArg(sp: Spec): Bool
  ret match(sp)
    (g2: SGeneric)     => false
    (e2: SEnum)        => isEmpty(e2.seParams)
    (c: SClass)        => isEmpty(c.scParams)
    (n: SNamed)        => isEmpty(n.snParams)
    (cm: SCombination) => !containsPlaceholder(sp)
    (o: Spec)          => true

fun containsPlaceholder(sp: Spec): Bool
  ret match(sp)
    (g2: SGeneric)     => true
    (cm: SCombination) => anyContainsPlaceholder(chain(cm.scTypes))
    (c: SClass)        => anyContainsPlaceholder(chain(c.scParams))
    (t2: STuple)       => anyEntryPlaceholder(chain(t2.stEntries))
    (e2: SEnum)        => anyContainsPlaceholder(chain(e2.seParams))
    (o: Spec)          => false

fun [tail] anyContainsPlaceholder(ss: Chain<Spec>): Bool
  ret match(ss)
    (nil: ChainEnd) => false
    (l: ChainLink)  => containsPlaceholder(l.value)
      ? true
      : anyContainsPlaceholder(l.next)

fun [tail] anyEntryPlaceholder(es: Chain<SEntry>): Bool
  ret match(es)
    (nil: ChainEnd) => false
    (l: ChainLink)  => match(l.value.seType)
      (ty: Spec) => containsPlaceholder(ty) ? true : anyEntryPlaceholder(l.next)
      ()         => anyEntryPlaceholder(l.next)

# Is `name` used anywhere in `sp` OUTSIDE a union? Union-only params are the
# benign where-bindable gap; outside-union means the interface match should
# have pinned it and where-solving would rescue a bogus match.
fun appearsOutsideUnion(sp: Spec, name: String, inUnion: Bool): Bool
  ret match(sp)
    (g2: SGeneric)     => g2.sgName == name && !inUnion
    (cm: SCombination) => anyOutsideUnion(chain(cm.scTypes), name, true)
    (c: SClass)        => anyOutsideUnion(chain(c.scParams), name, inUnion)
    (t2: STuple)       => anyEntryOutside(chain(t2.stEntries), name, inUnion)
    (e2: SEnum)        => anyOutsideUnion(chain(e2.seParams), name, inUnion)
    (o: Spec)          => false

fun [tail] anyOutsideUnion(ss: Chain<Spec>, name: String, inUnion: Bool): Bool
  ret match(ss)
    (nil: ChainEnd) => false
    (l: ChainLink)  => appearsOutsideUnion(l.value, name, inUnion)
      ? true
      : anyOutsideUnion(l.next, name, inUnion)

fun [tail] anyEntryOutside(es: Chain<SEntry>, name: String,
                           inUnion: Bool): Bool
  ret match(es)
    (nil: ChainEnd) => false
    (l: ChainLink)  => match(l.value.seType)
      (ty: Spec) => appearsOutsideUnion(ty, name, inUnion)
        ? true
        : anyEntryOutside(l.next, name, inUnion)
      ()         => anyEntryOutside(l.next, name, inUnion)

# ── finding concrete instantiations ─────────────────────────────────────────
# A full-tree walk: PeName/PeNewEnum/SEnum/SNamed feed dataRefs, SClass feeds
# typeRefs — only with concrete args.

fun findConcreteInstantiations(statements: List<PStmt>): GRefs
  ret fciStmts(chain(statements), GRefs(List<GRef>(), List<GRef>()))

fun [tail] fciStmts(ss: Chain<PStmt>, acc: GRefs): GRefs
  ret match(ss)
    (nil: ChainEnd) => acc
    (l: ChainLink)  => fciStmts(l.next, fciStmt(l.value, acc))

fun fciStmt(st: PStmt, acc: GRefs): GRefs
  ret match(st)
    (f: PsFun)         => fciExprOpt(f.fBody,
                            fciSpecs(chain(f.fWheres),
                              fciSpecOpt(f.fRet, fciStmt(f.fParams, acc))))
    # A let's wheres are NOT scanned: Python's LetStatement.search_and_replace
    # visits only default_value + declared_type (lets.py:42).
    (l: PsLet)         => fciExprOpt(l.lDefault, fciSpecOpt(l.lType, acc))
    (d: PsDestructure) => fciStmts(chain(d.dTargets),
                            fciExprOpt(d.dDefault, fciSpecOpt(d.dType, acc)))
    (c: PsClass)       => fciStmts(chain(c.cMembers),
                            fciSpecsOpt(c.cAllParents,
                              fciSpecs(chain(c.cWheres),
                                fciSpecs(chain(c.cImplements),
                                  fciStmt(c.cParams, acc)))))
    (e2: PsEnum)       => fciStmts(chain(e2.eVariants),
                            fciSpecOpt(e2.eSpec, fciStmt(e2.eParams, acc)))
    (ta: PsTypealias)  => fciSpecOpt(ta.taType, acc)
    (rt: PsRet)        => fciExpr(rt.retValue, acc)
    (a: PsAction)      => fciExpr(a.action, acc)
    (i: PsIf)          => fciStmts(chain(i.ifFalse),
                            fciStmts(chain(i.ifTrue),
                                     fciExpr(i.ifCond, acc)))
    (o: PStmt)         => acc

fun fciExpr(x: PExpr, acc: GRefs): GRefs
  ret match(x)
    (nm: PeName)   => fciSpecs(chain(nm.refTypeParams),
                               nameRef(nm.refName, nm.refTypeParams, acc))
    (ne: PeNewEnum) => fciSpecs(chain(ne.neTypeParams),
                                nameRef(ne.rootName, ne.neTypeParams, acc))
    (d: PeDot)     => fciExpr(d.base, acc)
    (c: PeCall)    => fciExpr(c.parameter, fciExpr(c.function, acc))
    (tp: PeTuple)  => fciEntries(chain(tp.exprs), acc)
    (te: PeTernary) => fciExpr(te.falseResult,
                        fciExpr(te.trueResult, fciExpr(te.condition, acc)))
    (lm: PeLambda) => fciSpecOpt(lm.lamRet,
                        fciExpr(lm.lamBody, fciStmt(lm.lamParams, acc)))
    (bk: PeBlock)  => fciExpr(bk.blockValue,
                              fciStmts(chain(bk.blockStmts), acc))
    (mt: PeMatch)  => fciArms(chain(mt.arms), fciExpr(mt.subject, acc))
    (op: PeBuiltinOp) => fciExpr(op.opParams, fciSpecOpt(op.opType, acc))
    (nw: PeNew)    => fciExpr(nw.newParam, fciSpecOpt(nw.newType, acc))
    (ar: PeArrayRead) => fciExpr(ar.arrIndex, fciExpr(ar.arrObj, acc))
    (cv: PeConvert) => fciSpecOpt(cv.convTarget, fciExpr(cv.convInner, acc))
    (pl: PeParallel) => fciExpr(pl.parParams, acc)
    (o: PExpr)     => acc

fun nameRef(name: String, args: List<Spec>, acc: GRefs): GRefs
  ret !isEmpty(args) && isConcreteTypeArgs(args)
    ? GRefs(addRef(acc.gdData, GRef(name, args)), acc.gdTypes)
    : acc

fun [tail] fciEntries(es: Chain<PTupEnt>, acc: GRefs): GRefs
  ret match(es)
    (nil: ChainEnd) => acc
    (l: ChainLink)  => fciEntries(l.next, fciExpr(l.value.tupValue, acc))

fun [tail] fciArms(as2: Chain<PArm>, acc: GRefs): GRefs
  ret match(as2)
    (nil: ChainEnd) => acc
    (l: ChainLink)  => fciArms(l.next,
                        fciExprOpt(l.value.armGuard,
                          fciExpr(l.value.armBody,
                                  fciSpecOpt(l.value.armType, acc))))

fun fciExprOpt(x: PExpr|None, acc: GRefs): GRefs
  ret match(x)
    (e2: PExpr) => fciExpr(e2, acc)
    ()          => acc

fun fciSpec(sp: Spec, acc: GRefs): GRefs
  ret match(sp)
    (c: SClass)        => fciSpecs(chain(c.scParams),
                                   !isEmpty(c.scParams)
                                     && isConcreteTypeArgs(c.scParams)
                                     ? GRefs(acc.gdData,
                                             addRef(acc.gdTypes,
                                                    GRef(c.scName, c.scParams)))
                                     : acc)
    (e2: SEnum)        => fciSpecs(chain(e2.seParams),
                                   !isEmpty(e2.seParams)
                                     && isConcreteTypeArgs(e2.seParams)
                                     ? GRefs(addRef(acc.gdData,
                                                    GRef(e2.seRoot,
                                                         e2.seParams)),
                                             acc.gdTypes)
                                     : acc)
    # NamedSpec is a traversal LEAF: its search_and_replace is the base
    # class's (specs.py:636) — the rule fires on the node, but its params are
    # never visited.
    (n: SNamed)        => !isEmpty(n.snParams)
                          && isConcreteTypeArgs(n.snParams)
      ? GRefs(addRef(acc.gdData, GRef(n.snName, n.snParams)), acc.gdTypes)
      : acc
    (cm: SCombination) => fciSpecs(chain(cm.scTypes), acc)
    (t2: STuple)       => fciSpecEntries(chain(t2.stEntries), acc)
    (cl: SCallable)    => fciSpecOpt(cl.scResult, fciSpec(cl.scParams2, acc))
    (af: SArrayField)  => fciSpec(af.safElem, acc)
    (ls: SLazyStub)    => fciSpecOpt(ls.slsTarget, acc)
    (o: Spec)          => acc

fun [tail] fciSpecs(ss: Chain<Spec>, acc: GRefs): GRefs
  ret match(ss)
    (nil: ChainEnd) => acc
    (l: ChainLink)  => fciSpecs(l.next, fciSpec(l.value, acc))

fun [tail] fciSpecEntries(es: Chain<SEntry>, acc: GRefs): GRefs
  ret match(es)
    (nil: ChainEnd) => acc
    (l: ChainLink)  => fciSpecEntries(l.next,
                                      fciSpecOpt(l.value.seType,
                                        fciExprOpt(l.value.seDefault, acc)))

fun fciSpecOpt(sp: Spec|None, acc: GRefs): GRefs
  ret match(sp)
    (s2: Spec) => fciSpec(s2, acc)
    ()         => acc

fun fciSpecsOpt(ss: List<Spec>|None, acc: GRefs): GRefs
  ret match(ss)
    (l: List<Spec>) => fciSpecs(chain(l), acc)
    ()              => acc

# ── substitution ────────────────────────────────────────────────────────────
# Placeholders substitute by SPEC-scope name first, then by BARE name (strip
# @hash) — an enum's own T-scope hash differs from the function's, but both
# come from one source identifier, so the bare match is correct within a
# single specialisation. EnumSpec substitution walks all_fields with a
# visited-set cycle guard (search_and_replace deliberately skips them) AND
# its own params; a NamedSpec-with-params inside all_fields inline-redirects
# to its mangled name once concrete.

class [final] GSub(gsExact: List<Binding>, gsBare: List<Binding>)

fun gsubOf(gens: List<PGen>, args: List<Spec>): GSub
  ret gsubLoop(chain(gens), chain(args), GSub(List<Binding>(),
                                              List<Binding>()))

fun [tail] gsubLoop(gs: Chain<PGen>, as2: Chain<Spec>, acc: GSub): GSub
  ret match(gs)
    (nil: ChainEnd) => acc
    (g2: ChainLink) => match(as2)
      (nil2: ChainEnd) => acc
      (a: ChainLink)   => gsubLoop(g2.next, a.next,
          GSub(append(acc.gsExact, Binding(g2.value.genName, a.value)),
               append(acc.gsBare, Binding(bareGenName(g2.value.genName),
                                          a.value))))

fun bareGenName(name: String): String
  let at = findByte(name, '@', 0)
  ret at < 0 ? name : slice(name, 0, at)

fun resolveGp(name: String, sub: GSub): Spec|None
  ret match(bindingOf(sub.gsExact, name))
    (b: Spec) => b
    ()        => bindingOf(sub.gsBare, bareGenName(name))

fun gsubSpec(sp: Spec, sub: GSub, visited: List<String>): Spec
  ret match(sp)
    (g2: SGeneric)     => match(resolveGp(g2.sgName, sub))
      (b: Spec) => b
      ()        => sp
    # EnumSpec: params visited generally (search_and_replace), THEN the
    # callback runs _substitute_enum on the node — params again via the
    # in-field rules plus the cycle-guarded all_fields walk.
    (e2: SEnum)        => gsubEnumNode(e2, gsubList(e2.seParams, sub,
                                                    visited),
                                       sub, List<String>())
    (c: SClass)        => SClass(c.scName, gsubList(c.scParams, sub, visited),
                                 c.scLine)
    # NamedSpec is a traversal LEAF (base-class search_and_replace), and the
    # substitute callback has no NamedSpec rule — params stay untouched here.
    # The in-field walk below is the ONLY place NamedSpec params substitute.
    (n: SNamed)        => sp
    (cm: SCombination) => canonUnion(SCombination(gsubList(cm.scTypes, sub,
                                                           visited),
                                                  cm.scmLine))
    (t2: STuple)       => STuple(gsubEntries(chain(t2.stEntries), sub,
                                             visited, List<SEntry>()),
                                 t2.stLine)
    (cl: SCallable)    => SCallable(gsubSpec(cl.scParams2, sub, visited),
                                    gsubOpt(cl.scResult, sub, visited),
                                    cl.sclLine)
    (af: SArrayField)  => SArrayField(gsubSpec(af.safElem, sub, visited),
                                      af.safLenField, af.safLine)
    (ls: SLazyStub)    => SLazyStub(gsubOpt(ls.slsTarget, sub, visited),
                                    ls.slsLine)
    (b: SBuiltin)      => sp

# _substitute_enum: substitute the given params via the in-field rules, then
# walk all_fields with cycle detection (walk_all_fields — fields untouched
# when this root is already on the path).
fun gsubEnumNode(e2: SEnum, params0: List<Spec>, sub: GSub,
                 visited: List<String>): Spec
  let params2 = gsubInFieldList(params0, sub, visited)
  if contains2(visited, e2.seRoot)
    ret SEnum(e2.seRoot, e2.seValidLeaves, e2.seAllLeaves, params2,
              e2.seLine, e2.seAllFields, e2.seComplex)
  let v2 = append(visited, e2.seRoot)
  ret SEnum(e2.seRoot, e2.seValidLeaves, e2.seAllLeaves, params2, e2.seLine,
            gsubFields(chain(e2.seAllFields), sub, v2, List<SField>()),
            e2.seComplex)

fun [tail] gsubFields(fs: Chain<SField>, sub: GSub, visited: List<String>,
                      acc: List<SField>): List<SField>
  ret match(fs)
    (nil: ChainEnd) => acc
    (l: ChainLink)  => gsubFields(l.next, sub, visited,
        append(acc, SField(l.value.sfName,
                           gsubInField(l.value.sfType, sub, visited))))

# _substitute_in_field: EXACTLY three rules — a placeholder resolves, a
# NamedSpec with params substitutes them (inline-redirecting when they became
# concrete), a nested enum recurses. EVERYTHING else (class specs, unions,
# tuples...) is left untouched inside all_fields.
fun gsubInField(ft: Spec, sub: GSub, visited: List<String>): Spec
  ret match(ft)
    (g2: SGeneric) => match(resolveGp(g2.sgName, sub))
      (b: Spec) => b
      ()        => ft
    (n: SNamed)    => isEmpty(n.snParams)
      ? ft
      : gsubNamedInField(n, sub, visited)
    (e2: SEnum)    => gsubEnumNode(e2, e2.seParams, sub, visited)
    (o: Spec)      => ft

# Python gates on `any(n is not o)`: an unchanged NamedSpec is returned as-is
# — in particular the inline redirect does NOT fire on already-concrete
# params that this substitution didn't touch.
fun gsubNamedInField(n: SNamed, sub: GSub, visited: List<String>): Spec
  let newTp = gsubInFieldList(n.snParams, sub, visited)
  if eqSpecs(newTp, n.snParams)
    ret n
  ret isConcreteTypeArgs(newTp)
    ? SNamed(mangledName(n.snName, newTp), List<Spec>(), n.snLine)
    : SNamed(n.snName, newTp, n.snLine)

fun gsubInFieldList(ts: List<Spec>, sub: GSub,
                    visited: List<String>): List<Spec>
  ret gsubInFieldLoop(chain(ts), sub, visited, List<Spec>())

fun [tail] gsubInFieldLoop(ts: Chain<Spec>, sub: GSub, visited: List<String>,
                           acc: List<Spec>): List<Spec>
  ret match(ts)
    (nil: ChainEnd) => acc
    (l: ChainLink)  => gsubInFieldLoop(l.next, sub, visited,
                                       append(acc, gsubInField(l.value, sub,
                                                               visited)))

fun gsubList(ts: List<Spec>, sub: GSub, visited: List<String>): List<Spec>
  ret gsubListLoop(chain(ts), sub, visited, List<Spec>())

fun [tail] gsubListLoop(ts: Chain<Spec>, sub: GSub, visited: List<String>,
                        acc: List<Spec>): List<Spec>
  ret match(ts)
    (nil: ChainEnd) => acc
    (l: ChainLink)  => gsubListLoop(l.next, sub, visited,
                                    append(acc, gsubSpec(l.value, sub,
                                                         visited)))

fun gsubOpt(sp: Spec|None, sub: GSub, visited: List<String>): Spec|None
  ret match(sp)
    (s2: Spec) => gsubSpec(s2, sub, visited)
    ()         => None

fun [tail] gsubEntries(es: Chain<SEntry>, sub: GSub, visited: List<String>,
                       acc: List<SEntry>): List<SEntry>
  ret match(es)
    (nil: ChainEnd) => acc
    (l: ChainLink)  => gsubEntries(l.next, sub, visited,
        append(acc, SEntry(l.value.seName,
                           gsubOpt(l.value.seType, sub, visited),
                           gsubExprOpt(l.value.seDefault, sub, visited))))

# The tree substitution: every spec position rewritten; expressions recurse.
fun gsubStmt(st: PStmt, sub: GSub): PStmt
  ret match(st)
    (f: PsFun)  => PsFun(f.fName, f.fAttrs, f.fGens,
                         gsubStmt(f.fParams, sub),
                         gsubExprOpt(f.fBody, sub, List<String>()),
                         gsubOpt(f.fRet, sub, List<String>()),
                         gsubList(f.fWheres, sub, List<String>()),
                         f.psfLine, f.fRetInferred, f.fNested, f.fImports)
    # Wheres untouched: LetStatement.search_and_replace visits only
    # default_value + declared_type (lets.py:42).
    (l: PsLet)  => PsLet(l.lName, l.lAttrs, l.lGens,
                         gsubOpt(l.lType, sub, List<String>()),
                         gsubExprOpt(l.lDefault, sub, List<String>()),
                         l.lArrayLen, l.lWheres,
                         l.pslLine, l.lTypeInferred, l.lImports)
    (d: PsDestructure) => PsDestructure(d.dName, d.dAttrs,
                                        gsubOpt(d.dType, sub, List<String>()),
                                        gsubStmts(chain(d.dTargets), sub,
                                                  List<PStmt>()),
                                        gsubExprOpt(d.dDefault, sub,
                                                    List<String>()),
                                        d.psdLine, d.dTypeInferred)
    # Slot TYPES untouched: ClassStatement.search_and_replace never visits
    # _all_slots (classdef.py:140-145) — only renameSpecialized touches slots
    # (names + provides), as Python's __create_specialized_version does.
    (c: PsClass) => PsClass(c.cName, c.cAttrs, c.cGens,
                            gsubStmt(c.cParams, sub),
                            gsubList(c.cImplements, sub, List<String>()),
                            gsubList(c.cWheres, sub, List<String>()),
                            gsubStmts(chain(c.cMembers), sub, List<PStmt>()),
                            c.cIsInterface, c.pscLine,
                            gsubSpecsOpt(c.cAllParents, sub),
                            c.cAllSlots, c.cImports)
    (e2: PsEnum) => PsEnum(e2.eName, e2.eGens, gsubStmt(e2.eParams, sub),
                           gsubStmts(chain(e2.eVariants), sub, List<PStmt>()),
                           e2.eHasParams, e2.pseLine, e2.eRootName,
                           gsubOpt(e2.eSpec, sub, List<String>()), e2.eImports)
    # Wheres untouched: TypeAliasStatement.search_and_replace visits only
    # `type` (types.py:34).
    (ta: PsTypealias) => PsTypealias(ta.taName, ta.taAttrs, ta.taGens,
                                     gsubSpec(ta.taType, sub, List<String>()),
                                     ta.taWheres, ta.pstLine, ta.taImports)
    (rt: PsRet)  => PsRet(gsubExpr(rt.retValue, sub, List<String>()),
                          rt.psrLine)
    (a: PsAction) => PsAction(gsubExpr(a.action, sub, List<String>()),
                              a.psaLine)
    (i: PsIf)    => PsIf(gsubExpr(i.ifCond, sub, List<String>()),
                         gsubStmts(chain(i.ifTrue), sub, List<PStmt>()),
                         gsubStmts(chain(i.ifFalse), sub, List<PStmt>()),
                         i.psifLine)
    (o: PStmt)   => st

fun [tail] gsubStmts(ss: Chain<PStmt>, sub: GSub,
                     acc: List<PStmt>): List<PStmt>
  ret match(ss)
    (nil: ChainEnd) => acc
    (l: ChainLink)  => gsubStmts(l.next, sub, append(acc, gsubStmt(l.value,
                                                                   sub)))

fun gsubSpecsOpt(ss: List<Spec>|None, sub: GSub): List<Spec>|None
  ret match(ss)
    (l: List<Spec>) => gsubList(l, sub, List<String>())
    ()              => None

fun gsubExpr(x: PExpr, sub: GSub, visited: List<String>): PExpr
  ret match(x)
    (nm: PeName)   => PeName(nm.refName, gsubList(nm.refTypeParams, sub,
                                                  visited),
                             nm.penLine,
                             gsubOpt(nm.penTrait, sub, visited))
    (d: PeDot)     => PeDot(gsubExpr(d.base, sub, visited), d.member,
                            d.pedLine)
    (c: PeCall)    => PeCall(gsubExpr(c.function, sub, visited),
                             gsubExpr(c.parameter, sub, visited), c.pecLine)
    (tp: PeTuple)  => PeTuple(gsubTupEnts(chain(tp.exprs), sub, visited,
                                          List<PTupEnt>()),
                              tp.petLine)
    (te: PeTernary) => PeTernary(gsubExpr(te.condition, sub, visited),
                                 gsubExpr(te.trueResult, sub, visited),
                                 gsubExpr(te.falseResult, sub, visited),
                                 te.pety)
    (lm: PeLambda) => PeLambda(gsubStmt(lm.lamParams, sub),
                               gsubExpr(lm.lamBody, sub, visited), lm.pelLine,
                               gsubOpt(lm.lamRet, sub, visited))
    (bk: PeBlock)  => PeBlock(gsubStmts(chain(bk.blockStmts), sub,
                                        List<PStmt>()),
                              gsubExpr(bk.blockValue, sub, visited),
                              bk.blockTag, bk.pebkLine)
    (mt: PeMatch)  => PeMatch(gsubExpr(mt.subject, sub, visited),
                              gsubArms(chain(mt.arms), sub, visited,
                                       List<PArm>()),
                              mt.pemLine)
    (op: PeBuiltinOp) => PeBuiltinOp(gsubSpec(op.opType, sub, visited),
                                     op.opName,
                                     gsubExpr(op.opParams, sub, visited),
                                     op.peboLine)
    (nw: PeNew)    => PeNew(gsubSpec(nw.newType, sub, visited),
                            gsubExpr(nw.newParam, sub, visited), nw.penwLine)
    (ne: PeNewEnum) => PeNewEnum(ne.rootName, ne.leafName, ne.fieldArgs,
                                 gsubList(ne.neTypeParams, sub, visited),
                                 ne.penewLine)
    (ar: PeArrayRead) => PeArrayRead(gsubExpr(ar.arrObj, sub, visited),
                                     gsubExpr(ar.arrIndex, sub, visited),
                                     ar.pearLine)
    (cv: PeConvert) => PeConvert(gsubExpr(cv.convInner, sub, visited),
                                 gsubSpec(cv.convTarget, sub, visited),
                                 cv.pecvLine)
    (pl: PeParallel) => PeParallel(gsubExpr(pl.parParams, sub, visited),
                                   pl.pepLine)
    (o: PExpr)     => x

fun gsubExprOpt(x: PExpr|None, sub: GSub, visited: List<String>): PExpr|None
  ret match(x)
    (e2: PExpr) => gsubExpr(e2, sub, visited)
    ()          => None

fun [tail] gsubTupEnts(es: Chain<PTupEnt>, sub: GSub, visited: List<String>,
                       acc: List<PTupEnt>): List<PTupEnt>
  ret match(es)
    (nil: ChainEnd) => acc
    (l: ChainLink)  => gsubTupEnts(l.next, sub, visited,
        append(acc, PTupEnt(l.value.tupName, l.value.tupSpread,
                            gsubExpr(l.value.tupValue, sub, visited))))

fun [tail] gsubArms(as2: Chain<PArm>, sub: GSub, visited: List<String>,
                    acc: List<PArm>): List<PArm>
  ret match(as2)
    (nil: ChainEnd) => acc
    (l: ChainLink)  => gsubArms(l.next, sub, visited,
        append(acc, PArm(l.value.armName,
                         gsubOpt(l.value.armType, sub, visited),
                         gsubExpr(l.value.armBody, sub, visited),
                         gsubLits(chain(l.value.armLiterals), sub, visited,
                                  List<PLit>()),
                         gsubExprOpt(l.value.armGuard, sub, visited),
                         l.value.parmLine)))

fun [tail] gsubLits(ls: Chain<PLit>, sub: GSub, visited: List<String>,
                    acc: List<PLit>): List<PLit>
  ret match(ls)
    (nil: ChainEnd) => acc
    (l: ChainLink)  => gsubLits(l.next, sub, visited, append(acc, l.value))

# ── specialisation ──────────────────────────────────────────────────────────
# Substitute, rename to the mangled name, clear the gens. A CLASS also renames
# its own concrete methods (and slot table) with an @type-sig suffix — two
# instantiations would otherwise emit colliding C symbols; '@' keeps
# name_matches compatibility for member lookup.

fun createSpecializedVersion(st: PStmt, args: List<Spec>): PStmt
  let gens = stmtGens(st)
  if isEmpty(gens) || isEmpty(args)
    ret st
  let sub = gsubOf(gens, args)
  let newName = mangledName(stmtName(st), args)
  ret renameSpecialized(gsubStmt(st, sub), newName, args)

fun renameSpecialized(st: PStmt, newName: String, args: List<Spec>): PStmt
  ret match(st)
    (f: PsFun)  => PsFun(newName, f.fAttrs, List<PGen>(), f.fParams, f.fBody,
                         f.fRet, f.fWheres, f.psfLine, f.fRetInferred,
                         f.fNested, f.fImports)
    (l: PsLet)  => PsLet(newName, l.lAttrs, List<PGen>(), l.lType, l.lDefault,
                         l.lArrayLen, l.lWheres, l.pslLine, l.lTypeInferred,
                         l.lImports)
    (c: PsClass) => specializedClass(c, newName, args)
    (e2: PsEnum) => PsEnum(newName, List<PGen>(), e2.eParams, e2.eVariants,
                           e2.eHasParams, e2.pseLine, e2.eRootName, e2.eSpec,
                           e2.eImports)
    (ta: PsTypealias) => PsTypealias(newName, ta.taAttrs, List<PGen>(),
                                     ta.taType, ta.taWheres, ta.pstLine,
                                     ta.taImports)
    (o: PStmt)  => st

fun specializedClass(c: PsClass, newName: String, args: List<Spec>): PStmt
  let sig = joinUids(chain(args), "")
  let rn = methodRenames(chain(c.cMembers), sig, List<Binding2>())
  ret PsClass(newName, c.cAttrs, List<PGen>(), c.cParams, c.cImplements,
              c.cWheres,
              renameMembers(chain(c.cMembers), rn, List<PStmt>()),
              c.cIsInterface, c.pscLine, c.cAllParents,
              renameSlots(c.cAllSlots, rn), c.cImports)

class [final] Binding2(b2From: String, b2To: String)

fun [tail] methodRenames(ms: Chain<PStmt>, sig: String,
                         acc: List<Binding2>): List<Binding2>
  ret match(ms)
    (nil: ChainEnd) => acc
    (l: ChainLink)  => match(l.value)
      (f: PsFun) => match(f.fBody)
        (b: PExpr) => methodRenames(l.next, sig,
                                    append(acc, Binding2(f.fName,
                                                         f.fName + "@" + sig)))
        ()         => methodRenames(l.next, sig, acc)
      (o: PStmt) => methodRenames(l.next, sig, acc)

fun renamedTo(rn: List<Binding2>, name: String): String
  ret rnLoop(chain(rn), name)

fun [tail] rnLoop(rs: Chain<Binding2>, name: String): String
  ret match(rs)
    (nil: ChainEnd) => name
    (l: ChainLink)  => l.value.b2From == name ? l.value.b2To : rnLoop(l.next,
                                                                     name)

fun [tail] renameMembers(ms: Chain<PStmt>, rn: List<Binding2>,
                         acc: List<PStmt>): List<PStmt>
  ret match(ms)
    (nil: ChainEnd) => acc
    (l: ChainLink)  => match(l.value)
      (f: PsFun) => renameMembers(l.next, rn,
          append(acc, renamedTo(rn, f.fName) == f.fName
                        ? l.value
                        : PsFun(renamedTo(rn, f.fName), f.fAttrs, f.fGens,
                                f.fParams, f.fBody, f.fRet, f.fWheres,
                                f.psfLine, f.fRetInferred, f.fNested,
                                f.fImports)))
      (o: PStmt) => renameMembers(l.next, rn, append(acc, l.value))

fun renameSlots(ss: List<Slot>|None, rn: List<Binding2>): List<Slot>|None
  ret match(ss)
    (l: List<Slot>) => isEmpty(rn) ? ss : renameSlotList(chain(l), rn,
                                                         List<Slot>())
    ()              => None

fun [tail] renameSlotList(ss: Chain<Slot>, rn: List<Binding2>,
                          acc: List<Slot>): List<Slot>
  ret match(ss)
    (nil: ChainEnd) => acc
    (l: ChainLink)  => renameSlotList(l.next, rn,
        append(acc, Slot(renamedTo(rn, l.value.slotName), l.value.slotType,
                         renameProvides(chain(l.value.slotProvides), rn,
                                        List<String>()))))

fun [tail] renameProvides(ps: Chain<String>, rn: List<Binding2>,
                          acc: List<String>): List<String>
  ret match(ps)
    (nil: ChainEnd) => acc
    (l: ChainLink)  => renameProvides(l.next, rn,
                                      addNameOnce(acc, renamedTo(rn, l.value)))

# ── creating specialized statements ─────────────────────────────────────────
# All refs SORTED by (name, arg-uids); dedup key is (mangled name, statement
# KIND) — a class and its synthesised constructor share a name and BOTH must
# specialise.

fun createSpecializedStatements(statements: List<PStmt>,
                                refs: GRefs): List<PStmt>
  let allRefs = sortRefs(concat(refs.gdData, refs.gdTypes))
  ret cssLoop(chain(statements), allRefs,
              existingKeys(chain(statements), List<String>()), List<PStmt>())

fun stmtKind(st: PStmt): String
  ret match(st)
    (f: PsFun)   => "fun"
    (l: PsLet)   => "let"
    (d: PsDestructure) => "destructure"
    (c: PsClass) => "class"
    (e2: PsEnum) => "enum"
    (ta: PsTypealias) => "typealias"
    (o: PStmt)   => "other"

fun [tail] existingKeys(ss: Chain<PStmt>, acc: List<String>): List<String>
  ret match(ss)
    (nil: ChainEnd) => acc
    (l: ChainLink)  => existingKeys(l.next,
                                    append(acc, stmtName(l.value) + "\t"
                                                + stmtKind(l.value)))

fun sortRefs(refs: List<GRef>): List<GRef>
  ret srLoop(chain(refs), List<GRef>())

fun [tail] srLoop(rs: Chain<GRef>, acc: List<GRef>): List<GRef>
  ret match(rs)
    (nil: ChainEnd) => acc
    (l: ChainLink)  => srLoop(l.next, insertRef(chain(acc), l.value,
                                                List<GRef>()))

fun [tail] insertRef(as2: Chain<GRef>, x: GRef, acc: List<GRef>): List<GRef>
  ret match(as2)
    (nil: ChainEnd) => append(acc, x)
    (l: ChainLink)  => refLess(x, l.value)
      ? concat(append(acc, x), List<GRef>(as2))
      : insertRef(l.next, x, append(acc, l.value))

fun refLess(a: GRef, b: GRef): Bool
  ret a.grName != b.grName ? a.grName < b.grName
                           : joinUids(chain(a.grArgs), "")
                             < joinUids(chain(b.grArgs), "")

class [final] CssState(csOut: List<PStmt>, csKeys: List<String>)

fun [tail] cssLoop(ss: Chain<PStmt>, allRefs: List<GRef>,
                   keys: List<String>, acc: List<PStmt>): List<PStmt>
  ret match(ss)
    (nil: ChainEnd) => acc
    (l: ChainLink)  => isEmpty(stmtGens(l.value))
      ? cssLoop(l.next, allRefs, keys, acc)
      : cssForStmt(chain(allRefs), l.value, keys, acc)
        |> (st2) => cssLoop(l.next, allRefs, st2.csKeys, st2.csOut)

fun [tail] cssForStmt(rs: Chain<GRef>, st: PStmt, keys: List<String>,
                      acc: List<PStmt>): CssState
  ret match(rs)
    (nil: ChainEnd) => CssState(acc, keys)
    (l: ChainLink)  => l.value.grName != stmtName(st)
      ? cssForStmt(l.next, st, keys, acc)
      : cssOne(l.value, st, keys, acc)
        |> (st2) => cssForStmt(l.next, st, st2.csKeys, st2.csOut)

fun cssOne(ref: GRef, st: PStmt, keys: List<String>,
           acc: List<PStmt>): CssState
  let key = mangledName(ref.grName, ref.grArgs) + "\t" + stmtKind(st)
  if contains2(keys, key)
    ret CssState(acc, keys)
  let sp = createSpecializedVersion(st, ref.grArgs)
  let sp2 = match(sp)
    (e2: PsEnum) => layoutEnum(e2)      # rebuild _enum_spec post-substitution
    (o: PStmt)   => sp
  ret CssState(append(acc, sp2), append(keys, key))

# ── the redirect ────────────────────────────────────────────────────────────
# Five node kinds carry type params; each redirects to the mangled name and
# clears them — the EnumSpec also mangles its LEAF names.

fun replaceConcreteReferences(statements: List<PStmt>,
                              refs: GRefs): List<PStmt>
  ret rcrStmts(chain(statements), refs, List<PStmt>())

fun [tail] rcrStmts(ss: Chain<PStmt>, refs: GRefs,
                    acc: List<PStmt>): List<PStmt>
  ret match(ss)
    (nil: ChainEnd) => acc
    (l: ChainLink)  => rcrStmts(l.next, refs, append(acc, rcrStmt(l.value,
                                                                  refs)))

fun inRefs(refs: List<GRef>, name: String, args: List<Spec>): Bool
  ret !isEmpty(args) && isConcreteTypeArgs(args)
      && hasRefKey(chain(refs), mangledName(name, args))
      && hasExactRef(chain(refs), name, args)

fun [tail] hasExactRef(rs: Chain<GRef>, name: String, args: List<Spec>): Bool
  ret match(rs)
    (nil: ChainEnd) => false
    (l: ChainLink)  => l.value.grName == name
                       && refKey(l.value) == mangledName(name, args)
      ? true
      : hasExactRef(l.next, name, args)

fun rcrSpec(sp: Spec, refs: GRefs): Spec
  ret match(sp)
    (c: SClass)        => inRefs(refs.gdTypes, c.scName, c.scParams)
      ? SClass(mangledName(c.scName, c.scParams), List<Spec>(), c.scLine)
      : SClass(c.scName, rcrSpecs(c.scParams, refs), c.scLine)
    # all_fields is COPIED, not redirected — EnumSpec.search_and_replace never
    # visits it; __refresh_enum_spec_all_fields syncs the copies later.
    (e2: SEnum)        => inRefs(refs.gdData, e2.seRoot, e2.seParams)
      ? SEnum(mangledName(e2.seRoot, e2.seParams),
              mangleLeaves(e2.seValidLeaves, e2.seParams),
              mangleLeaves(e2.seAllLeaves, e2.seParams),
              List<Spec>(), e2.seLine, e2.seAllFields, e2.seComplex)
      : SEnum(e2.seRoot, e2.seValidLeaves, e2.seAllLeaves,
              rcrSpecs(e2.seParams, refs), e2.seLine, e2.seAllFields,
              e2.seComplex)
    # NamedSpec is a traversal LEAF (base-class search_and_replace): redirect
    # applies to the node itself; its params are never visited.
    (n: SNamed)        => inRefs(refs.gdData, n.snName, n.snParams)
      ? SNamed(mangledName(n.snName, n.snParams), List<Spec>(), n.snLine)
      : sp
    (cm: SCombination) => canonUnion(SCombination(rcrSpecs(cm.scTypes, refs),
                                                  cm.scmLine))
    (t2: STuple)       => STuple(rcrEntries(chain(t2.stEntries), refs,
                                            List<SEntry>()),
                                 t2.stLine)
    (cl: SCallable)    => SCallable(rcrSpec(cl.scParams2, refs),
                                    rcrSpecOpt(cl.scResult, refs),
                                    cl.sclLine)
    (af: SArrayField)  => SArrayField(rcrSpec(af.safElem, refs),
                                      af.safLenField, af.safLine)
    (ls: SLazyStub)    => SLazyStub(rcrSpecOpt(ls.slsTarget, refs),
                                    ls.slsLine)
    (o: Spec)          => sp

fun mangleLeaves(leaves: List<String>, args: List<Spec>): List<String>
  ret mlLoop(chain(leaves), args, List<String>())

fun [tail] mlLoop(ls: Chain<String>, args: List<Spec>,
                  acc: List<String>): List<String>
  ret match(ls)
    (nil: ChainEnd) => acc
    (l: ChainLink)  => mlLoop(l.next, args,
                              append(acc, mangledName(l.value, args)))

fun rcrSpecs(ss: List<Spec>, refs: GRefs): List<Spec>
  ret rcrSpecLoop(chain(ss), refs, List<Spec>())

fun [tail] rcrSpecLoop(ss: Chain<Spec>, refs: GRefs,
                       acc: List<Spec>): List<Spec>
  ret match(ss)
    (nil: ChainEnd) => acc
    (l: ChainLink)  => rcrSpecLoop(l.next, refs, append(acc,
                                                        rcrSpec(l.value,
                                                                refs)))

fun rcrSpecOpt(sp: Spec|None, refs: GRefs): Spec|None
  ret match(sp)
    (s2: Spec) => rcrSpec(s2, refs)
    ()         => None

fun [tail] rcrEntries(es: Chain<SEntry>, refs: GRefs,
                      acc: List<SEntry>): List<SEntry>
  ret match(es)
    (nil: ChainEnd) => acc
    (l: ChainLink)  => rcrEntries(l.next, refs,
        append(acc, SEntry(l.value.seName, rcrSpecOpt(l.value.seType, refs),
                           rcrExprOpt(l.value.seDefault, refs))))

fun rcrStmt(st: PStmt, refs: GRefs): PStmt
  ret match(st)
    (f: PsFun)  => PsFun(f.fName, f.fAttrs, f.fGens, rcrStmt(f.fParams, refs),
                         rcrExprOpt(f.fBody, refs), rcrSpecOpt(f.fRet, refs),
                         rcrSpecs(f.fWheres, refs), f.psfLine, f.fRetInferred,
                         f.fNested, f.fImports)
    # Wheres NOT redirected (LetStatement.search_and_replace skips them);
    # __generic_instance_refs re-inflates mangled forms instead.
    (l: PsLet)  => PsLet(l.lName, l.lAttrs, l.lGens, rcrSpecOpt(l.lType, refs),
                         rcrExprOpt(l.lDefault, refs), l.lArrayLen,
                         l.lWheres, l.pslLine, l.lTypeInferred,
                         l.lImports)
    (d: PsDestructure) => PsDestructure(d.dName, d.dAttrs,
                                        rcrSpecOpt(d.dType, refs),
                                        rcrStmts(chain(d.dTargets), refs,
                                                 List<PStmt>()),
                                        rcrExprOpt(d.dDefault, refs),
                                        d.psdLine, d.dTypeInferred)
    # Slots NOT redirected (ClassStatement.search_and_replace never visits
    # _all_slots).
    (c: PsClass) => PsClass(c.cName, c.cAttrs, c.cGens,
                            rcrStmt(c.cParams, refs),
                            rcrSpecs(c.cImplements, refs),
                            rcrSpecs(c.cWheres, refs),
                            rcrStmts(chain(c.cMembers), refs, List<PStmt>()),
                            c.cIsInterface, c.pscLine,
                            rcrSpecsOpt(c.cAllParents, refs),
                            c.cAllSlots, c.cImports)
    (e2: PsEnum) => PsEnum(e2.eName, e2.eGens, rcrStmt(e2.eParams, refs),
                           rcrStmts(chain(e2.eVariants), refs, List<PStmt>()),
                           e2.eHasParams, e2.pseLine, e2.eRootName,
                           rcrSpecOpt(e2.eSpec, refs), e2.eImports)
    # Wheres NOT redirected (TypeAliasStatement.search_and_replace visits
    # only `type`).
    (ta: PsTypealias) => PsTypealias(ta.taName, ta.taAttrs, ta.taGens,
                                     rcrSpec(ta.taType, refs),
                                     ta.taWheres, ta.pstLine,
                                     ta.taImports)
    (rt: PsRet)  => PsRet(rcrExpr(rt.retValue, refs), rt.psrLine)
    (a: PsAction) => PsAction(rcrExpr(a.action, refs), a.psaLine)
    (i: PsIf)    => PsIf(rcrExpr(i.ifCond, refs),
                         rcrStmts(chain(i.ifTrue), refs, List<PStmt>()),
                         rcrStmts(chain(i.ifFalse), refs, List<PStmt>()),
                         i.psifLine)
    (o: PStmt)   => st

fun rcrSpecsOpt(ss: List<Spec>|None, refs: GRefs): List<Spec>|None
  ret match(ss)
    (l: List<Spec>) => rcrSpecs(l, refs)
    ()              => None

fun rcrExpr(x: PExpr, refs: GRefs): PExpr
  ret match(x)
    (nm: PeName)   => inRefs(refs.gdData, nm.refName, nm.refTypeParams)
      ? PeName(mangledName(nm.refName, nm.refTypeParams), List<Spec>(),
               nm.penLine, nm.penTrait)
      : PeName(nm.refName, rcrSpecs(nm.refTypeParams, refs), nm.penLine,
               nm.penTrait)
    (ne: PeNewEnum) => inRefs(refs.gdData, ne.rootName, ne.neTypeParams)
      ? PeNewEnum(mangledName(ne.rootName, ne.neTypeParams),
                  mangledName(ne.leafName, ne.neTypeParams), ne.fieldArgs,
                  List<Spec>(), ne.penewLine)
      : PeNewEnum(ne.rootName, ne.leafName, ne.fieldArgs,
                  rcrSpecs(ne.neTypeParams, refs), ne.penewLine)
    (d: PeDot)     => PeDot(rcrExpr(d.base, refs), d.member, d.pedLine)
    (c: PeCall)    => PeCall(rcrExpr(c.function, refs),
                             rcrExpr(c.parameter, refs), c.pecLine)
    (tp: PeTuple)  => PeTuple(rcrTupEnts(chain(tp.exprs), refs,
                                         List<PTupEnt>()),
                              tp.petLine)
    (te: PeTernary) => PeTernary(rcrExpr(te.condition, refs),
                                 rcrExpr(te.trueResult, refs),
                                 rcrExpr(te.falseResult, refs), te.pety)
    (lm: PeLambda) => PeLambda(rcrStmt(lm.lamParams, refs),
                               rcrExpr(lm.lamBody, refs), lm.pelLine,
                               rcrSpecOpt(lm.lamRet, refs))
    (bk: PeBlock)  => PeBlock(rcrStmts(chain(bk.blockStmts), refs,
                                       List<PStmt>()),
                              rcrExpr(bk.blockValue, refs), bk.blockTag,
                              bk.pebkLine)
    (mt: PeMatch)  => PeMatch(rcrExpr(mt.subject, refs),
                              rcrArms(chain(mt.arms), refs, List<PArm>()),
                              mt.pemLine)
    (op: PeBuiltinOp) => PeBuiltinOp(rcrSpec(op.opType, refs), op.opName,
                                     rcrExpr(op.opParams, refs), op.peboLine)
    (nw: PeNew)    => PeNew(rcrSpec(nw.newType, refs),
                            rcrExpr(nw.newParam, refs), nw.penwLine)
    (ar: PeArrayRead) => PeArrayRead(rcrExpr(ar.arrObj, refs),
                                     rcrExpr(ar.arrIndex, refs), ar.pearLine)
    (cv: PeConvert) => PeConvert(rcrExpr(cv.convInner, refs),
                                 rcrSpec(cv.convTarget, refs), cv.pecvLine)
    (pl: PeParallel) => PeParallel(rcrExpr(pl.parParams, refs), pl.pepLine)
    (o: PExpr)     => x

fun rcrExprOpt(x: PExpr|None, refs: GRefs): PExpr|None
  ret match(x)
    (e2: PExpr) => rcrExpr(e2, refs)
    ()          => None

fun [tail] rcrTupEnts(es: Chain<PTupEnt>, refs: GRefs,
                      acc: List<PTupEnt>): List<PTupEnt>
  ret match(es)
    (nil: ChainEnd) => acc
    (l: ChainLink)  => rcrTupEnts(l.next, refs,
        append(acc, PTupEnt(l.value.tupName, l.value.tupSpread,
                            rcrExpr(l.value.tupValue, refs))))

fun [tail] rcrArms(as2: Chain<PArm>, refs: GRefs,
                   acc: List<PArm>): List<PArm>
  ret match(as2)
    (nil: ChainEnd) => acc
    (l: ChainLink)  => rcrArms(l.next, refs,
        append(acc, PArm(l.value.armName,
                         rcrSpecOpt(l.value.armType, refs),
                         rcrExpr(l.value.armBody, refs),
                         l.value.armLiterals,
                         rcrExprOpt(l.value.armGuard, refs),
                         l.value.parmLine)))

# ── prune + finalize ────────────────────────────────────────────────────────

fun pruneUnusedGenerics(statements: List<PStmt>): List<PStmt>
  ret pugLoop(chain(statements), List<PStmt>())

fun [tail] pugLoop(ss: Chain<PStmt>, acc: List<PStmt>): List<PStmt>
  ret match(ss)
    (nil: ChainEnd) => acc
    (l: ChainLink)  => isEmpty(stmtGens(l.value))
      ? pugLoop(l.next, append(acc, l.value))
      : pugLoop(l.next, acc)

# Rebuild _enum_spec for specialized (or non-generic) ROOT enums every round.
fun finalizeSpecializedEnumSpecs(statements: List<PStmt>,
                                 specialized: List<String>): List<PStmt>
  ret fseLoop(chain(statements), specialized, List<PStmt>())

fun [tail] fseLoop(ss: Chain<PStmt>, specialized: List<String>,
                   acc: List<PStmt>): List<PStmt>
  ret match(ss)
    (nil: ChainEnd) => acc
    (l: ChainLink)  => match(l.value)
      (e2: PsEnum) => isRootEnum(e2)
                      && (contains2(specialized, e2.eName)
                          || isEmpty(e2.eGens))
        ? fseLoop(l.next, specialized, append(acc, layoutEnum(e2)))
        : fseLoop(l.next, specialized, append(acc, l.value))
      (o: PStmt)   => fseLoop(l.next, specialized, append(acc, l.value))

fun isRootEnum(e2: PsEnum): Bool
  ret match(e2.eRootName)
    (rn: String) => rn == e2.eName
    ()           => false

# ── constraint discharge for generic trait instances ────────────────────────

# Generic [trait] lets, each paired with the trait PATTERN it implements
# (the witness class's parent, remapped class→let placeholders).
class [final] GProvider(gpLet: PsLet, gpPattern: SClass)

fun genericInstanceProviders(statements: List<PStmt>,
                             r: Resolver): List<GProvider>
  ret gipLoop(chain(statements), r, List<GProvider>())

fun [tail] gipLoop(ss: Chain<PStmt>, r: Resolver,
                   acc: List<GProvider>): List<GProvider>
  ret match(ss)
    (nil: ChainEnd) => acc
    (l: ChainLink)  => match(l.value)
      (let2: PsLet) => !isEmpty(let2.lGens) && hasAttr(let2.lAttrs, "trait")
        ? gipLoop(l.next, r, providerPatterns(let2, r, acc))
        : gipLoop(l.next, r, acc)
      (o: PStmt)    => gipLoop(l.next, r, acc)

fun providerPatterns(let2: PsLet, r: Resolver,
                     acc: List<GProvider>): List<GProvider>
  ret match(let2.lType)
    (dt: Spec) => match(dt)
      (dc: SClass) => match(soleItem(findType(r, dc.scName)))
        (f: Found) => match(f.fStmt)
          (cls: PsClass) => match(cls.cAllParents)
            (ps: List<Spec>) => patternLoop(chain(ps),
                                            paramMapping(cls.cGens,
                                                         dc.scParams),
                                            let2, acc)
            ()               => acc
          (o: PStmt)     => acc
        ()         => acc
      (o2: Spec)   => acc
    ()         => acc

fun [tail] patternLoop(ps: Chain<Spec>, remap: List<Binding>, let2: PsLet,
                       acc: List<GProvider>): List<GProvider>
  ret match(ps)
    (nil: ChainEnd) => acc
    (l: ChainLink)  => match(l.value)
      (pc: SClass) => match(substitute(l.value, remap))
        (sub: SClass) => patternLoop(l.next, remap, let2,
                                     append(acc, GProvider(let2, sub)))
        (o: Spec)     => patternLoop(l.next, remap, let2, acc)
      (o2: Spec)   => patternLoop(l.next, remap, let2, acc)

# Every concrete trait constraint in any `where` clause anywhere in the tree
# (top-level and nested method wheres alike) — Python walks with
# search_and_replace, so this fold visits every statement and expression.
fun collectConcreteConstraints(statements: List<PStmt>,
                               acc: List<Spec>): List<Spec>
  ret cccStmts(chain(statements), acc)

fun [tail] cccStmts(ss: Chain<PStmt>, acc: List<Spec>): List<Spec>
  ret match(ss)
    (nil: ChainEnd) => acc
    (l: ChainLink)  => cccStmts(l.next, cccStmt(l.value, acc))

fun cccStmt(st: PStmt, acc: List<Spec>): List<Spec>
  ret match(st)
    (f: PsFun)   => cccWheres(chain(f.fWheres),
                              cccExprOpt(f.fBody,
                                         cccStmt(f.fParams, acc)))
    (l: PsLet)   => cccWheres(chain(l.lWheres),
                              cccExprOpt(l.lDefault, acc))
    (d: PsDestructure) => cccStmts(chain(d.dTargets),
                                   cccExprOpt(d.dDefault, acc))
    (c: PsClass) => cccWheres(chain(c.cWheres),
                              cccStmts(chain(c.cMembers),
                                       cccStmt(c.cParams, acc)))
    (e2: PsEnum) => cccStmts(chain(e2.eVariants), cccStmt(e2.eParams, acc))
    (ta: PsTypealias) => cccWheres(chain(ta.taWheres), acc)
    (rt: PsRet)  => cccExpr(rt.retValue, acc)
    (a: PsAction) => cccExpr(a.action, acc)
    (i: PsIf)    => cccStmts(chain(i.ifFalse),
                             cccStmts(chain(i.ifTrue),
                                      cccExpr(i.ifCond, acc)))
    (o: PStmt)   => acc

fun cccExpr(x: PExpr, acc: List<Spec>): List<Spec>
  ret match(x)
    (d: PeDot)     => cccExpr(d.base, acc)
    (c: PeCall)    => cccExpr(c.parameter, cccExpr(c.function, acc))
    (tp: PeTuple)  => cccTupEnts(chain(tp.exprs), acc)
    (te: PeTernary) => cccExpr(te.falseResult,
                               cccExpr(te.trueResult,
                                       cccExpr(te.condition, acc)))
    (lm: PeLambda) => cccExpr(lm.lamBody, cccStmt(lm.lamParams, acc))
    (bk: PeBlock)  => cccExpr(bk.blockValue,
                              cccStmts(chain(bk.blockStmts), acc))
    (mt: PeMatch)  => cccArms(chain(mt.arms), cccExpr(mt.subject, acc))
    (op: PeBuiltinOp) => cccExpr(op.opParams, acc)
    (nw: PeNew)    => cccExpr(nw.newParam, acc)
    (ar: PeArrayRead) => cccExpr(ar.arrIndex, cccExpr(ar.arrObj, acc))
    (cv: PeConvert) => cccExpr(cv.convInner, acc)
    (pl: PeParallel) => cccExpr(pl.parParams, acc)
    (o: PExpr)     => acc

fun cccExprOpt(x: PExpr|None, acc: List<Spec>): List<Spec>
  ret match(x)
    (e2: PExpr) => cccExpr(e2, acc)
    ()          => acc

fun [tail] cccTupEnts(es: Chain<PTupEnt>, acc: List<Spec>): List<Spec>
  ret match(es)
    (nil: ChainEnd) => acc
    (l: ChainLink)  => cccTupEnts(l.next, cccExpr(l.value.tupValue, acc))

fun [tail] cccArms(as2: Chain<PArm>, acc: List<Spec>): List<Spec>
  ret match(as2)
    (nil: ChainEnd) => acc
    (l: ChainLink)  => cccArms(l.next,
                               cccExprOpt(l.value.armGuard,
                                          cccExpr(l.value.armBody, acc)))

fun [tail] cccWheres(ws: Chain<Spec>, acc: List<Spec>): List<Spec>
  ret match(ws)
    (nil: ChainEnd) => acc
    (l: ChainLink)  => match(l.value)
      (wc: SClass) => isConcrete(wc)
        ? cccWheres(l.next, addSpecOnce(acc, l.value))
        : cccWheres(l.next, acc)
      (o: Spec)    => cccWheres(l.next, acc)

# monoMap is the seen-refs list itself, keyed by refKey on lookup. Python
# builds {mangled → (base, args)} from refs with non-empty args; an empty-args
# ref's key ends "$generic$unknown", which never names a specialisation, so no
# explicit filter is needed here.
fun [tail] monoLookup(rs: Chain<GRef>, mangled: String): GRef|None
  ret match(rs)
    (nil: ChainEnd) => None
    (l: ChainLink)  => refKey(l.value) == mangled ? l.value
                                                  : monoLookup(l.next, mangled)

# Undo mangling structurally: Wrap$generic$Leaf → Wrap<Leaf>, recursively.
fun specFromMangled(sp: Spec, mono: List<GRef>): Spec
  ret match(sp)
    (c: SClass) => isEmpty(c.scParams)
      ? sfmBare(c, mono)
      : SClass(c.scName, sfmList(chain(c.scParams), mono, List<Spec>()),
               c.scLine)
    (o: Spec)   => sp

fun sfmBare(c: SClass, mono: List<GRef>): Spec
  ret match(monoLookup(chain(mono), c.scName))
    (g2: GRef) => SClass(g2.grName,
                         sfmList(chain(g2.grArgs), mono, List<Spec>()),
                         c.scLine)
    ()         => c

fun [tail] sfmList(ss: Chain<Spec>, mono: List<GRef>,
                   acc: List<Spec>): List<Spec>
  ret match(ss)
    (nil: ChainEnd) => acc
    (l: ChainLink)  => sfmList(l.next, mono,
                               append(acc, specFromMangled(l.value, mono)))

# Inverse: structural Wrap<Leaf,Int> → bare Wrap$generic$Leaf_Int.
fun mangledFromSpec(sp: Spec): Spec
  ret match(sp)
    (c: SClass) => isEmpty(c.scParams)
      ? sp
      : SClass(mangledName(c.scName,
                           mfsList(chain(c.scParams), List<Spec>())),
               List<Spec>(), c.scLine)
    (o: Spec)   => sp

fun [tail] mfsList(ss: Chain<Spec>, acc: List<Spec>): List<Spec>
  ret match(ss)
    (nil: ChainEnd) => acc
    (l: ChainLink)  => mfsList(l.next, append(acc, mangledFromSpec(l.value)))

# The concrete interfaces implemented by NON-generic [trait] instances.
fun concreteInstanceInterfaces(statements: List<PStmt>,
                               r: Resolver): List<Spec>
  ret ciiLoop(chain(statements), r, List<Spec>())

fun [tail] ciiLoop(ss: Chain<PStmt>, r: Resolver,
                   acc: List<Spec>): List<Spec>
  ret match(ss)
    (nil: ChainEnd) => acc
    (l: ChainLink)  => match(l.value)
      (let2: PsLet) => isEmpty(let2.lGens) && hasAttr(let2.lAttrs, "trait")
        ? ciiLoop(l.next, r, instanceIfaces(let2, r, acc))
        : ciiLoop(l.next, r, acc)
      (o: PStmt)    => ciiLoop(l.next, r, acc)

fun instanceIfaces(let2: PsLet, r: Resolver, acc: List<Spec>): List<Spec>
  ret match(let2.lType)
    (dt: Spec) => match(dt)
      (dc: SClass) => match(soleItem(findType(r, dc.scName)))
        (f: Found) => match(f.fStmt)
          (cls: PsClass) => match(cls.cAllParents)
            (ps: List<Spec>) => ifaceLoop(chain(ps),
                                          paramMapping(cls.cGens,
                                                       dc.scParams),
                                          acc)
            ()               => acc
          (o: PStmt)     => acc
        ()         => acc
      (o2: Spec)   => acc
    ()         => acc

fun [tail] ifaceLoop(ps: Chain<Spec>, remap: List<Binding>,
                     acc: List<Spec>): List<Spec>
  ret match(ps)
    (nil: ChainEnd) => acc
    (l: ChainLink)  => match(l.value)
      (pc: SClass) => match(substitute(l.value, remap))
        (sub: SClass) => isConcrete(sub)
          ? ifaceLoop(l.next, remap, append<Spec>(acc, sub))
          : ifaceLoop(l.next, remap, acc)
        (o: Spec)     => ifaceLoop(l.next, remap, acc)
      (o2: Spec)   => ifaceLoop(l.next, remap, acc)

# Mono-time where-discharge: strict positional bind_from_constraint_match
# against re-inflated concrete instance interfaces.
fun bindWhereParams(let2: PsLet, mapping: List<Binding>,
                    instanceIfaces2: List<Spec>,
                    mono: List<GRef>): List<Binding>
  ret bwpWheres(chain(let2.lWheres), let2, mapping, instanceIfaces2, mono)

fun [tail] bwpWheres(ws: Chain<Spec>, let2: PsLet, mapping: List<Binding>,
                     ifaces: List<Spec>, mono: List<GRef>): List<Binding>
  let targets = unboundGens(chain(let2.lGens), mapping, List<String>())
  if isEmpty(targets)
    ret mapping
  ret match(ws)
    (nil: ChainEnd) => mapping
    (l: ChainLink)  => bwpWheres(l.next, let2,
                                 bwpOne(l.value, mapping, targets, ifaces,
                                        mono),
                                 ifaces, mono)

fun [tail] unboundGens(gs: Chain<PGen>, mapping: List<Binding>,
                       acc: List<String>): List<String>
  ret match(gs)
    (nil: ChainEnd) => acc
    (l: ChainLink)  => match(bindingOf(mapping, l.value.genName))
      (b: Spec) => unboundGens(l.next, mapping, acc)
      ()        => unboundGens(l.next, mapping,
                               append(acc, l.value.genName))

fun bwpOne(wc: Spec, mapping: List<Binding>, targets: List<String>,
           ifaces: List<Spec>, mono: List<GRef>): List<Binding>
  ret match(substitute(wc, mapping))
    (sub: SClass) => bwpIfaces(chain(ifaces), sub, mapping, targets, mono)
    (o: Spec)     => mapping

fun [tail] bwpIfaces(is2: Chain<Spec>, sub: SClass, mapping: List<Binding>,
                     targets: List<String>, mono: List<GRef>): List<Binding>
  ret match(is2)
    (nil: ChainEnd) => mapping
    (l: ChainLink)  => match(specFromMangled(l.value, mono))
      (iface: SClass) => match(bindFromConstraintMatch(sub, iface, targets))
        (b: List<Binding>) => concat(mapping, b)
        ()                 => bwpIfaces(l.next, sub, mapping, targets, mono)
      (o: Spec)       => bwpIfaces(l.next, sub, mapping, targets, mono)

# Witness-let instantiations needed to satisfy the constraints via the
# generic providers.
fun genericInstanceRefs(providers: List<GProvider>, constraints: List<Spec>,
                        monoRefs: List<GRef>,
                        ifaces: List<Spec>): List<GRef>
  ret girProviders(chain(providers), constraints, monoRefs, ifaces,
                   List<GRef>())

fun [tail] girProviders(ps: Chain<GProvider>, constraints: List<Spec>,
                        mono: List<GRef>, ifaces: List<Spec>,
                        acc: List<GRef>): List<GRef>
  ret match(ps)
    (nil: ChainEnd) => acc
    (l: ChainLink)  => girProviders(l.next, constraints, mono, ifaces,
                                    girConstraints(chain(constraints),
                                                   l.value, mono, ifaces,
                                                   acc))

fun [tail] girConstraints(cs: Chain<Spec>, p: GProvider, mono: List<GRef>,
                          ifaces: List<Spec>, acc: List<GRef>): List<GRef>
  ret match(cs)
    (nil: ChainEnd) => acc
    (l: ChainLink)  => match(l.value)
      (con: SClass) => p.gpPattern.scName == con.scName
        ? girConstraints(l.next, p, mono, ifaces,
                         girOne(p, con, mono, ifaces, acc))
        : girConstraints(l.next, p, mono, ifaces, acc)
      (o: Spec)     => girConstraints(l.next, p, mono, ifaces, acc)

fun girOne(p: GProvider, con: SClass, mono: List<GRef>, ifaces: List<Spec>,
           acc: List<GRef>): List<GRef>
  let letGens = p.gpLet.lGens
  let names = genNames(chain(letGens), List<String>())
  ret match(specFromMangled(con, mono))
    (inflated: SClass) => match(unifyGeneric(p.gpPattern, inflated, names,
                                             List<Binding>()))
      (m: UMap)  => girBound(p, letGens, names, m.uBindings, ifaces, mono,
                             acc)
      (f: UFail) => acc
    (o: Spec)          => acc

fun girBound(p: GProvider, letGens: List<PGen>, names: List<String>,
             mapping0: List<Binding>, ifaces: List<Spec>, mono: List<GRef>,
             acc: List<GRef>): List<GRef>
  let unbound = unboundGens(chain(letGens), mapping0, List<String>())
  let mapping = !isEmpty(unbound) && !isEmpty(mapping0)
                && allUnionOnly(chain(unbound), p.gpPattern)
    ? bindWhereParams(p.gpLet, mapping0, ifaces, mono)
    : mapping0
  if !isEmpty(unboundGens(chain(letGens), mapping, List<String>()))
    ret acc
  let args = mangledArgs(chain(letGens), mapping, List<Spec>())
  ret isConcreteTypeArgs(args)
    ? addRef(acc, GRef(p.gpLet.lName, args))
    : acc

fun [tail] allUnionOnly(ns: Chain<String>, pattern: SClass): Bool
  ret match(ns)
    (nil: ChainEnd) => true
    (l: ChainLink)  => appearsOutsideUnion(pattern, l.value, false)
      ? false
      : allUnionOnly(l.next, pattern)

fun [tail] mangledArgs(gs: Chain<PGen>, mapping: List<Binding>,
                       acc: List<Spec>): List<Spec>
  ret match(gs)
    (nil: ChainEnd) => acc
    (l: ChainLink)  => match(bindingOf(mapping, l.value.genName))
      (b: Spec) => mangledArgs(l.next, mapping,
                               append(acc, mangledFromSpec(b)))
      ()        => mangledArgs(l.next, mapping, acc)

# ── the iterative driver ─────────────────────────────────────────────────────
# Python: __convert_generics_iterative. Round bound 64: legitimate transitive
# instantiation chains stabilise in a handful of rounds; a loop still minting
# new instantiations after that is deepening without bound (mutual polymorphic
# recursion — the direct case is caught structurally by the offender counts).

class [final] GIter(giStmts: List<PStmt>, giErrs: List<PErr>)

fun [tail] addRefsAll(rs: Chain<GRef>, acc: List<GRef>): List<GRef>
  ret match(rs)
    (nil: ChainEnd) => acc
    (l: ChainLink)  => addRefsAll(l.next, addRef(acc, l.value))

fun [tail] addSpecsAll(ss: Chain<Spec>, acc: List<Spec>): List<Spec>
  ret match(ss)
    (nil: ChainEnd) => acc
    (l: ChainLink)  => addSpecsAll(l.next, addSpecOnce(acc, l.value))

fun [tail] addNamesAll(ns: Chain<String>, acc: List<String>): List<String>
  ret match(ns)
    (nil: ChainEnd) => acc
    (l: ChainLink)  => contains2(acc, l.value)
      ? addNamesAll(l.next, acc)
      : addNamesAll(l.next, append(acc, l.value))

fun convertGenericsIterative(statements: List<PStmt>): GIter
  ret monoRound(statements, 0, List<String>(), List<Spec>(), List<GRef>())

fun [tail] monoRound(statements: List<PStmt>, round2: Int,
                     allSpecEnums: List<String>, seenCons: List<Spec>,
                     seenMono: List<GRef>): GIter
  if round2 >= 64                                # _MAX_MONO_ROUNDS
    ret monoErrors(statements, seenMono)
  # Step 1: find all concrete instantiations.
  let found = findConcreteInstantiations(statements)
  let seenMono2 = addRefsAll(chain(found.gdTypes),
                             addRefsAll(chain(found.gdData), seenMono))
  # Step 1b: generic trait instances are selected by constraint discharge, not
  # by an explicit type-param reference. Discharge the constraints seen so far
  # against the generic instances, seeding witness-let refs.
  let r = RRoot(buildStatements(statements))
  let seenCons2 = addSpecsAll(chain(collectConcreteConstraints(statements,
                                                               List<Spec>())),
                              seenCons)
  let dataRefs = addRefsAll(
      chain(genericInstanceRefs(genericInstanceProviders(statements, r),
                                seenCons2, seenMono2,
                                concreteInstanceInterfaces(statements, r))),
      found.gdData)
  if isEmpty(dataRefs) && isEmpty(found.gdTypes)
    ret GIter(pruneUnusedGenerics(statements), List<PErr>())
  # Step 2: create specialized versions for matching NamedStatements.
  let specialized = createSpecializedStatements(statements,
                                                GRefs(dataRefs, found.gdTypes))
  # Step 2b: newly-created specialized statements may carry extra concrete
  # refs that arose from substitution — include them, but only when their
  # specialized target already exists (created in a prior iteration).
  let refs = isEmpty(specialized)
    ? GRefs(dataRefs, found.gdTypes)
    : withExtraRefs(GRefs(dataRefs, found.gdTypes), specialized, statements)
  # Step 3: redirect over ALL statements, including the new ones — a
  # specialized statement from the PREVIOUS iteration may carry un-redirected
  # refs that only became concrete after substitution.
  let redirected = replaceConcreteReferences(concat(statements, specialized),
                                             refs)
  # Step 4: rebuild _enum_spec for EVERY known specialized enum, not just this
  # iteration's — cross-enum field references update as redirects land.
  let allSpecEnums2 = addNamesAll(chain(enumNamesOf(chain(specialized))),
                                  allSpecEnums)
  let finalized = isEmpty(allSpecEnums2)
    ? redirected
    : finalizeSpecializedEnumSpecs(redirected, allSpecEnums2)
  if isEmpty(specialized)
    ret GIter(pruneUnusedGenerics(finalized), List<PErr>())
  ret monoRound(finalized, round2 + 1, allSpecEnums2, seenCons2, seenMono2)

fun withExtraRefs(refs: GRefs, specialized: List<PStmt>,
                  statements: List<PStmt>): GRefs
  let extra = findConcreteInstantiations(specialized)
  let existing = allStmtNames(chain(statements), List<String>())
  ret GRefs(addRefsAll(chain(existingOnly(chain(extra.gdData), existing,
                                          List<GRef>())),
                       refs.gdData),
            addRefsAll(chain(existingOnly(chain(extra.gdTypes), existing,
                                          List<GRef>())),
                       refs.gdTypes))

fun [tail] existingOnly(rs: Chain<GRef>, existing: List<String>,
                        acc: List<GRef>): List<GRef>
  ret match(rs)
    (nil: ChainEnd) => acc
    (l: ChainLink)  => contains2(existing, refKey(l.value))
      ? existingOnly(l.next, existing, append(acc, l.value))
      : existingOnly(l.next, existing, acc)

fun [tail] allStmtNames(ss: Chain<PStmt>, acc: List<String>): List<String>
  ret match(ss)
    (nil: ChainEnd) => acc
    (l: ChainLink)  => allStmtNames(l.next, append(acc, stmtName(l.value)))

fun enumNamesOf(ss: Chain<PStmt>): List<String>
  ret enumNamesLoop(ss, List<String>())

fun [tail] enumNamesLoop(ss: Chain<PStmt>, acc: List<String>): List<String>
  ret match(ss)
    (nil: ChainEnd) => acc
    (l: ChainLink)  => match(l.value)
      (e2: PsEnum) => enumNamesLoop(l.next, append(acc, e2.eName))
      (o: PStmt)   => enumNamesLoop(l.next, acc)

# Loop exhausted: blame the generics with runaway per-name instantiation
# counts, at their declarations; else one generic message.
fun monoErrors(statements: List<PStmt>, seenMono: List<GRef>): GIter
  let offenders = sortNamesAsc(chain(offenderNames(seenMono)), List<String>())
  ret isEmpty(offenders)
    ? GIter(statements, append(List<PErr>(), PErr(PLine("$generics", 1, 1),
        "generic instantiation did not stabilise after 64 rounds — likely polymorphic recursion through mutually recursive generics; recursive calls must use the functions' own type parameters")))
    : GIter(statements, offenderErrs(chain(offenders), statements, seenMono,
                                     List<PErr>()))

fun offenderNames(seenMono: List<GRef>): List<String>
  ret offNamesLoop(chain(seenMono), seenMono, List<String>())

fun [tail] offNamesLoop(rs: Chain<GRef>, all: List<GRef>,
                        acc: List<String>): List<String>
  ret match(rs)
    (nil: ChainEnd) => acc
    (l: ChainLink)  => contains2(acc, l.value.grName)
                       || countRefsFor(chain(all), l.value.grName, 0) < 32
      ? offNamesLoop(l.next, all, acc)          # _MAX_MONO_ROUNDS // 2
      : offNamesLoop(l.next, all, append(acc, l.value.grName))

fun [tail] countRefsFor(rs: Chain<GRef>, name: String, n: Int): Int
  ret match(rs)
    (nil: ChainEnd) => n
    (l: ChainLink)  => countRefsFor(l.next, name,
                                    l.value.grName == name ? n + 1 : n)

fun [tail] sortNamesAsc(ns: Chain<String>, acc: List<String>): List<String>
  ret match(ns)
    (nil: ChainEnd) => acc
    (l: ChainLink)  => sortNamesAsc(l.next,
                                    insertNameAsc(chain(acc), l.value,
                                                  List<String>()))

fun [tail] insertNameAsc(ns: Chain<String>, v: String,
                         acc: List<String>): List<String>
  ret match(ns)
    (nil: ChainEnd) => append(acc, v)
    (l: ChainLink)  => v < l.value
      ? concat(append(acc, v), List<String>(ns))
      : insertNameAsc(l.next, v, append(acc, l.value))

fun [tail] offenderErrs(ns: Chain<String>, statements: List<PStmt>,
                        seenMono: List<GRef>, acc: List<PErr>): List<PErr>
  ret match(ns)
    (nil: ChainEnd) => acc
    (l: ChainLink)  => offenderErrs(l.next, statements, seenMono,
        append(acc, PErr(offenderLine(chain(statements), l.value),
                         offenderMsg(l.value,
                                     countRefsFor(chain(seenMono), l.value,
                                                  0)))))

fun offenderMsg(name: String, count: Int): String
  ret "polymorphic recursion: `" + bareOfUnique(name) + "` is instantiated at ever-deeper type arguments (" + show(count) + " distinct instantiations without stabilising) — a recursive call must use the function's own type parameters, not a compound of them (e.g. Wrap<T>)"

# Python's by_name dict: later statements with the same name overwrite, so the
# LAST match wins.
fun offenderLine(ss: Chain<PStmt>, name: String): PLine
  ret offLineLoop(ss, name, PLine("$generics", 1, 1))

fun [tail] offLineLoop(ss: Chain<PStmt>, name: String, best: PLine): PLine
  ret match(ss)
    (nil: ChainEnd) => best
    (l: ChainLink)  => stmtName(l.value) == name
      ? offLineLoop(l.next, name, stmtLine(l.value))
      : offLineLoop(l.next, name, best)

# ── trait-reference resolution ───────────────────────────────────────────────
# Python: __resolve_trait_references. After monomorphisation, a TRAIT-scope
# function reference is rewritten as DotExpression(provider, method) on the
# concrete [trait] instance whose witness class implements the required trait,
# so codegen sees a normal method call.

fun resolveTraitReferences(statements: List<PStmt>): List<PStmt>
  let r = RRoot(buildStatements(statements))
  ret rtrStmts(chain(statements), r, traitLets(r), List<PStmt>())

fun [tail] rtrStmts(ss: Chain<PStmt>, r: Resolver, traits: List<PStmt>,
                    acc: List<PStmt>): List<PStmt>
  ret match(ss)
    (nil: ChainEnd) => acc
    (l: ChainLink)  => rtrStmts(l.next, r, traits,
                                append(acc, rtrStmt(l.value, r, traits)))

fun rtrStmt(st: PStmt, r: Resolver, traits: List<PStmt>): PStmt
  ret match(st)
    (f: PsFun)  => PsFun(f.fName, f.fAttrs, f.fGens,
                         rtrStmt(f.fParams, r, traits),
                         rtrExprOpt(f.fBody, r, traits), f.fRet, f.fWheres,
                         f.psfLine, f.fRetInferred, f.fNested, f.fImports)
    (l: PsLet)  => PsLet(l.lName, l.lAttrs, l.lGens, l.lType,
                         rtrExprOpt(l.lDefault, r, traits), l.lArrayLen,
                         l.lWheres, l.pslLine, l.lTypeInferred, l.lImports)
    (d: PsDestructure) => PsDestructure(d.dName, d.dAttrs, d.dType,
                                        rtrStmts(chain(d.dTargets), r, traits,
                                                 List<PStmt>()),
                                        rtrExprOpt(d.dDefault, r, traits),
                                        d.psdLine, d.dTypeInferred)
    (c: PsClass) => PsClass(c.cName, c.cAttrs, c.cGens,
                            rtrStmt(c.cParams, r, traits), c.cImplements,
                            c.cWheres,
                            rtrStmts(chain(c.cMembers), r, traits,
                                     List<PStmt>()),
                            c.cIsInterface, c.pscLine, c.cAllParents,
                            c.cAllSlots, c.cImports)
    (e2: PsEnum) => PsEnum(e2.eName, e2.eGens, rtrStmt(e2.eParams, r, traits),
                           rtrStmts(chain(e2.eVariants), r, traits,
                                    List<PStmt>()),
                           e2.eHasParams, e2.pseLine, e2.eRootName, e2.eSpec,
                           e2.eImports)
    (rt: PsRet)  => PsRet(rtrExpr(rt.retValue, r, traits), rt.psrLine)
    (a: PsAction) => PsAction(rtrExpr(a.action, r, traits), a.psaLine)
    (i: PsIf)    => PsIf(rtrExpr(i.ifCond, r, traits),
                         rtrStmts(chain(i.ifTrue), r, traits, List<PStmt>()),
                         rtrStmts(chain(i.ifFalse), r, traits, List<PStmt>()),
                         i.psifLine)
    (o: PStmt)   => st

fun rtrExprOpt(x: PExpr|None, r: Resolver, traits: List<PStmt>): PExpr|None
  ret match(x)
    (e2: PExpr) => rtrExpr(e2, r, traits)
    ()          => None

fun rtrExpr(x: PExpr, r: Resolver, traits: List<PStmt>): PExpr
  ret match(x)
    (nm: PeName)   => redirectName(nm, r, traits)
    (d: PeDot)     => PeDot(rtrExpr(d.base, r, traits), d.member, d.pedLine)
    (c: PeCall)    => PeCall(rtrExpr(c.function, r, traits),
                             rtrExpr(c.parameter, r, traits), c.pecLine)
    (tp: PeTuple)  => PeTuple(rtrTupEnts(chain(tp.exprs), r, traits,
                                         List<PTupEnt>()),
                              tp.petLine)
    (te: PeTernary) => PeTernary(rtrExpr(te.condition, r, traits),
                                 rtrExpr(te.trueResult, r, traits),
                                 rtrExpr(te.falseResult, r, traits), te.pety)
    (lm: PeLambda) => PeLambda(rtrStmt(lm.lamParams, r, traits),
                               rtrExpr(lm.lamBody, r, traits), lm.pelLine,
                               lm.lamRet)
    (bk: PeBlock)  => PeBlock(rtrStmts(chain(bk.blockStmts), r, traits,
                                       List<PStmt>()),
                              rtrExpr(bk.blockValue, r, traits), bk.blockTag,
                              bk.pebkLine)
    (mt: PeMatch)  => PeMatch(rtrExpr(mt.subject, r, traits),
                              rtrArms(chain(mt.arms), r, traits,
                                      List<PArm>()),
                              mt.pemLine)
    (op: PeBuiltinOp) => PeBuiltinOp(op.opType, op.opName,
                                     rtrExpr(op.opParams, r, traits),
                                     op.peboLine)
    (nw: PeNew)    => PeNew(nw.newType, rtrExpr(nw.newParam, r, traits),
                            nw.penwLine)
    (ar: PeArrayRead) => PeArrayRead(rtrExpr(ar.arrObj, r, traits),
                                     rtrExpr(ar.arrIndex, r, traits),
                                     ar.pearLine)
    (cv: PeConvert) => PeConvert(rtrExpr(cv.convInner, r, traits),
                                 cv.convTarget, cv.pecvLine)
    (pl: PeParallel) => PeParallel(rtrExpr(pl.parParams, r, traits),
                                   pl.pepLine)
    (o: PExpr)     => x

fun [tail] rtrTupEnts(es: Chain<PTupEnt>, r: Resolver, traits: List<PStmt>,
                      acc: List<PTupEnt>): List<PTupEnt>
  ret match(es)
    (nil: ChainEnd) => acc
    (l: ChainLink)  => rtrTupEnts(l.next, r, traits,
        append(acc, PTupEnt(l.value.tupName, l.value.tupSpread,
                            rtrExpr(l.value.tupValue, r, traits))))

fun [tail] rtrArms(as2: Chain<PArm>, r: Resolver, traits: List<PStmt>,
                   acc: List<PArm>): List<PArm>
  ret match(as2)
    (nil: ChainEnd) => acc
    (l: ChainLink)  => rtrArms(l.next, r, traits,
        append(acc, PArm(l.value.armName, l.value.armType,
                         rtrExpr(l.value.armBody, r, traits),
                         l.value.armLiterals,
                         rtrExprOpt(l.value.armGuard, r, traits),
                         l.value.parmLine)))

# Redirect one name: use the trait_scope recorded during compilation if
# available, otherwise derive it from a TRAIT-scoped find.
fun redirectName(nm: PeName, r: Resolver, traits: List<PStmt>): PExpr
  ret match(traitSpecFor(nm, r))
    (ts: SClass) => redirectWith(nm, ts, r, traits)
    ()           => nm

fun traitSpecFor(nm: PeName, r: Resolver): SClass|None
  ret match(nm.penTrait)
    (sp: Spec) => match(sp)
      (c: SClass) => c
      (o: Spec)   => None
    ()         => derivedTraitScope(nm, r)

fun derivedTraitScope(nm: PeName, r: Resolver): SClass|None
  ret match(soleItem(findData(r, nm.refName)))
    (f: Found) => match(f.fScope)
      (t2: ScTrait) => match(f.fTraitScope)
        (sp: Spec) => match(sp)
          (c: SClass) => c
          (o: Spec)   => None
        ()         => None
      (o2: RScope)  => None
    ()         => None

fun redirectWith(nm: PeName, ts: SClass, r: Resolver,
                 traits: List<PStmt>): PExpr
  ret match(soleLetOf(traitProviders(chain(traits), ts, r, List<PsLet>())))
    (provider: PsLet) => redirectVia(nm, ts, provider, r)
    ()                => nm

fun [tail] traitProviders(ls: Chain<PStmt>, ts: SClass, r: Resolver,
                          acc: List<PsLet>): List<PsLet>
  ret match(ls)
    (nil: ChainEnd) => acc
    (l: ChainLink)  => match(l.value)
      (let2: PsLet) => implementsTrait(let2, ts, r)
        ? traitProviders(l.next, ts, r, append(acc, let2))
        : traitProviders(l.next, ts, r, acc)
      (o: PStmt)    => traitProviders(l.next, ts, r, acc)

fun implementsTrait(tr: PsLet, ts: SClass, r: Resolver): Bool
  ret match(tr.lType)
    (dt: Spec) => match(dt)
      (dc: SClass) => match(soleItem(findType(r, dc.scName)))
        (f: Found) => match(f.fStmt)
          (cls: PsClass) => match(cls.cAllParents)
            (ps: List<Spec>) => anyParentMatches(chain(ps), ts)
            ()               => false
          (o: PStmt)     => false
        ()         => false
      (o2: Spec)   => false
    ()         => false

fun [tail] anyParentMatches(ps: Chain<Spec>, ts: SClass): Bool
  ret match(ps)
    (nil: ChainEnd) => false
    (l: ChainLink)  => match(l.value)
      (pc: SClass) => pc.scName == ts.scName
                      && (isEmpty(ts.scParams)
                          || eqSpecs(pc.scParams, ts.scParams))
        ? true
        : anyParentMatches(l.next, ts)
      (o: Spec)    => anyParentMatches(l.next, ts)

fun soleLetOf(ls: List<PsLet>): PsLet|None
  ret match(chain(ls))
    (l: ChainLink)  => match(l.next)
      (nil: ChainEnd) => l.value
      (m: ChainLink)  => None
    (nil2: ChainEnd) => None

fun soleFoundOf(fs: List<Found>): Found|None
  ret match(chain(fs))
    (l: ChainLink)  => match(l.next)
      (nil: ChainEnd) => l.value
      (m: ChainLink)  => None
    (nil2: ChainEnd) => None

fun redirectVia(nm: PeName, ts: SClass, provider: PsLet,
                r: Resolver): PExpr
  ret match(provider.lType)
    (pt: Spec) => match(pt)
      (pc: SClass) => match(soleItem(findType(r, pc.scName)))
        (f: Found) => match(f.fStmt)
          (cls: PsClass) => redirectMethod(nm, ts, provider, cls, r)
          (o: PStmt)     => nm
        ()         => nm
      (o2: Spec)   => nm
    ()         => nm

fun redirectMethod(nm: PeName, ts: SClass, provider: PsLet, cls: PsClass,
                   r: Resolver): PExpr
  let mds0 = classFindData(cls, r, simpleName(nm.refName))
  if isEmpty(mds0)
    ret nm
  let many = match(soleFoundOf(mds0))
    (one: Found) => false
    ()           => true
  let mds = many ? disambiguateMethods(mds0, nm, ts, r) : mds0
  ret match(soleFoundOf(mds))
    (md: Found) => PeDot(PeName(provider.lName, List<Spec>(), nm.penLine,
                                None),
                         md.fName, nm.penLine)
    ()          => nm

# Multiple overloads — disambiguate by comparing the concrete type of the
# interface method (looked up by exact hash) against the class methods.
fun disambiguateMethods(mds: List<Found>, nm: PeName, ts: SClass,
                        r: Resolver): List<Found>
  ret match(soleItem(findType(r, ts.scName)))
    (f: Found) => match(f.fStmt)
      (icls: PsClass) => disambiguateVia(mds, nm, ts, icls, r)
      (o: PStmt)      => mds
    ()         => mds

fun disambiguateVia(mds: List<Found>, nm: PeName, ts: SClass, icls: PsClass,
                    r: Resolver): List<Found>
  ret match(soleFoundOf(classFindData(icls, r, nm.refName)))
    (imd: Found) => match(imd.fStmt)
      (ifn: PsFun) => disambiguateByType(mds, ts, icls, ifn, r)
      (o: PStmt)   => mds
    ()           => mds

fun disambiguateByType(mds: List<Found>, ts: SClass, icls: PsClass,
                       ifn: PsFun, r: Resolver): List<Found>
  let ifaceType0 = funType(ifn)
  let ifaceType = !isEmpty(icls.cGens) && !isEmpty(ts.scParams)
    ? substitute(ifaceType0, paramMapping(icls.cGens, ts.scParams))
    : ifaceType0
  let matching = matchingByType(chain(mds), ifaceType, r, List<Found>())
  let single = match(soleFoundOf(matching))
    (one: Found) => true
    ()           => false
  ret single ? matching : mds

fun [tail] matchingByType(ms: Chain<Found>, ifaceType: Spec, r: Resolver,
                          acc: List<Found>): List<Found>
  ret match(ms)
    (nil: ChainEnd) => acc
    (l: ChainLink)  => triTrue(assignableEq(r, ifaceType,
                                            stmtType(l.value.fStmt)))
      ? matchingByType(l.next, ifaceType, r, append(acc, l.value))
      : matchingByType(l.next, ifaceType, r, acc)

# ── refresh embedded EnumSpec.all_fields ─────────────────────────────────────
# Python: __refresh_enum_spec_all_fields. Sync every embedded copy to the
# canonical _enum_spec. Python detects staleness by tuple IDENTITY (eq
# excludes all_fields); the port compares CONTENT one level deep — each pass
# propagates one extra level through the canonical dependency graph, exactly
# as Python's identity walk does, capped at 16 passes.

class [final] Canon(cnRoots: List<String>, cnSpecs: List<SEnum>)
class [final] CanonPass(cpCanon: Canon, cpChanged: Bool)
class [final] FieldsFix(ffFields: List<SField>, ffChanged: Bool)

fun refreshEnumSpecAllFields(statements: List<PStmt>): List<PStmt>
  let canon0 = collectCanonical(chain(statements),
                                Canon(List<String>(), List<SEnum>()))
  if isEmpty(canon0.cnRoots)
    ret statements
  let canon = canonFix(canon0, 0)
  ret rfrStmts(chain(statements), canon, List<PStmt>())

# Root enums only (skip nested variant stmts); first spec per root wins.
fun [tail] collectCanonical(ss: Chain<PStmt>, acc: Canon): Canon
  ret match(ss)
    (nil: ChainEnd) => acc
    (l: ChainLink)  => match(l.value)
      (e2: PsEnum) => isRootEnum(e2)
        ? collectCanonical(l.next, canonAdd(acc, e2))
        : collectCanonical(l.next, acc)
      (o: PStmt)   => collectCanonical(l.next, acc)

fun canonAdd(acc: Canon, e2: PsEnum): Canon
  ret match(e2.eSpec)
    (sp: Spec) => match(sp)
      (es: SEnum) => contains2(acc.cnRoots, es.seRoot)
        ? acc
        : Canon(append(acc.cnRoots, es.seRoot),
                append(acc.cnSpecs, es))
      (o: Spec)   => acc
    ()         => acc

fun canonLookup(c: Canon, root: String): SEnum|None
  ret canonLookLoop(chain(c.cnRoots), chain(c.cnSpecs), root)

fun [tail] canonLookLoop(ns: Chain<String>, sps: Chain<SEnum>,
                         root: String): SEnum|None
  ret match(ns)
    (nil: ChainEnd) => None
    (n: ChainLink)  => match(sps)
      (nil2: ChainEnd) => None
      (s2: ChainLink)  => n.value == root
        ? s2.value
        : canonLookLoop(n.next, s2.next, root)

fun [tail] canonFix(c: Canon, iter: Int): Canon
  if iter >= 16                                  # _MAX_REFRESH_ITERS
    ret c
  let p = canonPass(c)
  if !p.cpChanged
    ret p.cpCanon
  ret canonFix(p.cpCanon, iter + 1)

fun canonPass(c: Canon): CanonPass
  ret canonPassLoop(chain(c.cnRoots), chain(c.cnSpecs), c,
                    Canon(List<String>(), List<SEnum>()), false)

fun [tail] canonPassLoop(ns: Chain<String>, sps: Chain<SEnum>, orig: Canon,
                         acc: Canon, changed: Bool): CanonPass
  ret match(ns)
    (nil: ChainEnd) => CanonPass(acc, changed)
    (n: ChainLink)  => match(sps)
      (nil2: ChainEnd) => CanonPass(acc, changed)
      (s2: ChainLink)  => fixFieldsLoop(chain(s2.value.seAllFields), orig,
                                        List<SField>(), false)
        |> (ff) => canonPassLoop(n.next, s2.next, orig,
                                 Canon(append(acc.cnRoots, n.value),
                                       append(acc.cnSpecs,
                                              ff.ffChanged
                                                ? canonRebuilt(s2.value,
                                                               ff.ffFields)
                                                : s2.value)),
                                 changed || ff.ffChanged)

fun [tail] fixFieldsLoop(fs: Chain<SField>, orig: Canon, acc: List<SField>,
                         ch: Bool): FieldsFix
  ret match(fs)
    (nil: ChainEnd) => FieldsFix(acc, ch)
    (l: ChainLink)  => match(l.value.sfType)
      (fe: SEnum) => match(canonLookup(orig, fe.seRoot))
        (spec: SEnum) => fieldsStale(fe, spec)
          ? fixFieldsLoop(l.next, orig,
                          append(acc, SField(l.value.sfName,
                                             refreshedEnum(fe, spec))),
                          true)
          : fixFieldsLoop(l.next, orig, append(acc, l.value), ch)
        ()            => fixFieldsLoop(l.next, orig, append(acc, l.value), ch)
      (o: Spec)   => fixFieldsLoop(l.next, orig, append(acc, l.value), ch)

fun fieldsStale(fe: SEnum, spec: SEnum): Bool
  ret !sfieldListEq(chain(fe.seAllFields), chain(spec.seAllFields))
      || !eqStrs(fe.seAllLeaves, spec.seAllLeaves)

fun [tail] sfieldListEq(a: Chain<SField>, b: Chain<SField>): Bool
  ret match(a)
    (nil: ChainEnd) => match(b)
      (nil2: ChainEnd) => true
      (m: ChainLink)   => false
    (l: ChainLink)  => match(b)
      (nil3: ChainEnd) => false
      (m2: ChainLink)  => (l.value.sfName == m2.value.sfName
                           && eqSpec(l.value.sfType, m2.value.sfType))
        ? sfieldListEq(l.next, m2.next)
        : false

fun refreshedEnum(fe: SEnum, spec: SEnum): Spec
  ret SEnum(fe.seRoot, fe.seValidLeaves, spec.seAllLeaves, fe.seParams,
            fe.seLine, spec.seAllFields, fe.seComplex)

# The enum constructor returns the ROOT type; narrow back to SEnum.
fun canonRebuilt(v: SEnum, fields: List<SField>): SEnum
  ret match(SEnum(v.seRoot, v.seValidLeaves, v.seAllLeaves, v.seParams,
                  v.seLine, fields, v.seComplex))
    (e2: SEnum) => e2
    (o: Spec)   => v

fun [tail] rfrStmts(ss: Chain<PStmt>, c: Canon,
                    acc: List<PStmt>): List<PStmt>
  ret match(ss)
    (nil: ChainEnd) => acc
    (l: ChainLink)  => rfrStmts(l.next, c, append(acc, rfrStmt(l.value, c)))

fun rfrStmt(st: PStmt, c: Canon): PStmt
  ret match(st)
    (f: PsFun)  => PsFun(f.fName, f.fAttrs, f.fGens, rfrStmt(f.fParams, c),
                         rfrExprOpt(f.fBody, c), rfrSpecOpt(f.fRet, c),
                         rfrSpecList(f.fWheres, c), f.psfLine,
                         f.fRetInferred, f.fNested, f.fImports)
    (l: PsLet)  => PsLet(l.lName, l.lAttrs, l.lGens, rfrSpecOpt(l.lType, c),
                         rfrExprOpt(l.lDefault, c), l.lArrayLen, l.lWheres,
                         l.pslLine, l.lTypeInferred, l.lImports)
    (d: PsDestructure) => PsDestructure(d.dName, d.dAttrs,
                                        rfrSpecOpt(d.dType, c),
                                        rfrStmts(chain(d.dTargets), c,
                                                 List<PStmt>()),
                                        rfrExprOpt(d.dDefault, c),
                                        d.psdLine, d.dTypeInferred)
    (cl: PsClass) => PsClass(cl.cName, cl.cAttrs, cl.cGens,
                             rfrStmt(cl.cParams, c),
                             rfrSpecList(cl.cImplements, c),
                             rfrSpecList(cl.cWheres, c),
                             rfrStmts(chain(cl.cMembers), c, List<PStmt>()),
                             cl.cIsInterface, cl.pscLine,
                             rfrSpecsOpt(cl.cAllParents, c),
                             cl.cAllSlots, cl.cImports)
    (e2: PsEnum) => PsEnum(e2.eName, e2.eGens, rfrStmt(e2.eParams, c),
                           rfrStmts(chain(e2.eVariants), c, List<PStmt>()),
                           e2.eHasParams, e2.pseLine, e2.eRootName,
                           rfrSpecOpt(e2.eSpec, c), e2.eImports)
    (ta: PsTypealias) => PsTypealias(ta.taName, ta.taAttrs, ta.taGens,
                                     rfrSpec(ta.taType, c), ta.taWheres,
                                     ta.pstLine, ta.taImports)
    (rt: PsRet)  => PsRet(rfrExpr(rt.retValue, c), rt.psrLine)
    (a: PsAction) => PsAction(rfrExpr(a.action, c), a.psaLine)
    (i: PsIf)    => PsIf(rfrExpr(i.ifCond, c),
                         rfrStmts(chain(i.ifTrue), c, List<PStmt>()),
                         rfrStmts(chain(i.ifFalse), c, List<PStmt>()),
                         i.psifLine)
    (o: PStmt)   => st

fun rfrExprOpt(x: PExpr|None, c: Canon): PExpr|None
  ret match(x)
    (e2: PExpr) => rfrExpr(e2, c)
    ()          => None

fun rfrExpr(x: PExpr, c: Canon): PExpr
  ret match(x)
    (nm: PeName)   => PeName(nm.refName, rfrSpecList(nm.refTypeParams, c),
                             nm.penLine, rfrSpecOpt(nm.penTrait, c))
    (d: PeDot)     => PeDot(rfrExpr(d.base, c), d.member, d.pedLine)
    (cc: PeCall)   => PeCall(rfrExpr(cc.function, c),
                             rfrExpr(cc.parameter, c), cc.pecLine)
    (tp: PeTuple)  => PeTuple(rfrTupEnts(chain(tp.exprs), c,
                                         List<PTupEnt>()),
                              tp.petLine)
    (te: PeTernary) => PeTernary(rfrExpr(te.condition, c),
                                 rfrExpr(te.trueResult, c),
                                 rfrExpr(te.falseResult, c), te.pety)
    (lm: PeLambda) => PeLambda(rfrStmt(lm.lamParams, c),
                               rfrExpr(lm.lamBody, c), lm.pelLine,
                               rfrSpecOpt(lm.lamRet, c))
    (bk: PeBlock)  => PeBlock(rfrStmts(chain(bk.blockStmts), c,
                                       List<PStmt>()),
                              rfrExpr(bk.blockValue, c), bk.blockTag,
                              bk.pebkLine)
    (mt: PeMatch)  => PeMatch(rfrExpr(mt.subject, c),
                              rfrArms(chain(mt.arms), c, List<PArm>()),
                              mt.pemLine)
    (op: PeBuiltinOp) => PeBuiltinOp(rfrSpec(op.opType, c), op.opName,
                                     rfrExpr(op.opParams, c), op.peboLine)
    (nw: PeNew)    => PeNew(rfrSpec(nw.newType, c), rfrExpr(nw.newParam, c),
                            nw.penwLine)
    (ne: PeNewEnum) => PeNewEnum(ne.rootName, ne.leafName, ne.fieldArgs,
                                 rfrSpecList(ne.neTypeParams, c),
                                 ne.penewLine)
    (ar: PeArrayRead) => PeArrayRead(rfrExpr(ar.arrObj, c),
                                     rfrExpr(ar.arrIndex, c), ar.pearLine)
    (cv: PeConvert) => PeConvert(rfrExpr(cv.convInner, c),
                                 rfrSpec(cv.convTarget, c), cv.pecvLine)
    (pl: PeParallel) => PeParallel(rfrExpr(pl.parParams, c), pl.pepLine)
    (o: PExpr)     => x

fun [tail] rfrTupEnts(es: Chain<PTupEnt>, c: Canon,
                      acc: List<PTupEnt>): List<PTupEnt>
  ret match(es)
    (nil: ChainEnd) => acc
    (l: ChainLink)  => rfrTupEnts(l.next, c,
        append(acc, PTupEnt(l.value.tupName, l.value.tupSpread,
                            rfrExpr(l.value.tupValue, c))))

fun [tail] rfrArms(as2: Chain<PArm>, c: Canon, acc: List<PArm>): List<PArm>
  ret match(as2)
    (nil: ChainEnd) => acc
    (l: ChainLink)  => rfrArms(l.next, c,
        append(acc, PArm(l.value.armName, rfrSpecOpt(l.value.armType, c),
                         rfrExpr(l.value.armBody, c), l.value.armLiterals,
                         rfrExprOpt(l.value.armGuard, c), l.value.parmLine)))

fun rfrSpecOpt(sp: Spec|None, c: Canon): Spec|None
  ret match(sp)
    (s2: Spec) => rfrSpec(s2, c)
    ()         => None

fun rfrSpecsOpt(ss: List<Spec>|None, c: Canon): List<Spec>|None
  ret match(ss)
    (l: List<Spec>) => rfrSpecList(l, c)
    ()              => None

fun rfrSpecList(ts: List<Spec>, c: Canon): List<Spec>
  ret rfrSpecLoop(chain(ts), c, List<Spec>())

fun [tail] rfrSpecLoop(ts: Chain<Spec>, c: Canon,
                       acc: List<Spec>): List<Spec>
  ret match(ts)
    (nil: ChainEnd) => acc
    (l: ChainLink)  => rfrSpecLoop(l.next, c, append(acc, rfrSpec(l.value,
                                                                  c)))

# Children first, canonical refresh at the SEnum node itself. Never recurse
# into seAllFields — EnumSpec.search_and_replace deliberately skips them.
fun rfrSpec(sp: Spec, c: Canon): Spec
  ret match(sp)
    (e2: SEnum)        => rfrEnum(e2, c)
    (cl: SClass)       => SClass(cl.scName, rfrSpecList(cl.scParams, c),
                                 cl.scLine)
    (n: SNamed)        => sp   # traversal LEAF: params never visited
    (cm: SCombination) => SCombination(rfrSpecList(cm.scTypes, c),
                                       cm.scmLine)
    (t2: STuple)       => STuple(rfrEntries(chain(t2.stEntries), c,
                                            List<SEntry>()),
                                 t2.stLine)
    (cb: SCallable)    => SCallable(rfrSpec(cb.scParams2, c),
                                    rfrSpecOpt(cb.scResult, c), cb.sclLine)
    (af: SArrayField)  => SArrayField(rfrSpec(af.safElem, c),
                                      af.safLenField, af.safLine)
    (ls: SLazyStub)    => SLazyStub(rfrSpecOpt(ls.slsTarget, c), ls.slsLine)
    (o: Spec)          => sp

fun [tail] rfrEntries(es: Chain<SEntry>, c: Canon,
                      acc: List<SEntry>): List<SEntry>
  ret match(es)
    (nil: ChainEnd) => acc
    (l: ChainLink)  => rfrEntries(l.next, c,
        append(acc, SEntry(l.value.seName,
                           rfrSpecOpt(l.value.seType, c),
                           l.value.seDefault)))

fun rfrEnum(e2: SEnum, c: Canon): Spec
  let rebuilt = SEnum(e2.seRoot, e2.seValidLeaves, e2.seAllLeaves,
                      rfrSpecList(e2.seParams, c), e2.seLine, e2.seAllFields,
                      e2.seComplex)
  ret match(rebuilt)
    (re: SEnum) => match(canonLookup(c, re.seRoot))
      (spec: SEnum) => fieldsStale(re, spec)
        ? refreshedEnum(re, spec)
        : rebuilt
      ()            => rebuilt
    (o: Spec)   => rebuilt

# ── unresolved-generic-call guard ────────────────────────────────────────────
# Python: report_unresolved_generic_calls. A reference from NON-generic code
# to a still-generic function means call-site inference could not ground its
# type arguments — report at the use site instead of crashing in codegen.

fun reportUnresolvedGenericCalls(statements: List<PStmt>): List<PErr>
  let r = RRoot(buildStatements(statements))
  ret rugTop(chain(statements), r, List<PErr>())

fun [tail] rugTop(ss: Chain<PStmt>, r: Resolver,
                  acc: List<PErr>): List<PErr>
  ret match(ss)
    (nil: ChainEnd) => acc
    (l: ChainLink)  => isEmpty(stmtGens(l.value))
      ? rugTop(l.next, r, rugStmt(l.value, r, acc))
      : rugTop(l.next, r, acc)   # a surviving generic template's body is
                                 # legitimately generic

fun [tail] rugStmts(ss: Chain<PStmt>, r: Resolver,
                    acc: List<PErr>): List<PErr>
  ret match(ss)
    (nil: ChainEnd) => acc
    (l: ChainLink)  => rugStmts(l.next, r, rugStmt(l.value, r, acc))

fun rugStmt(st: PStmt, r: Resolver, acc: List<PErr>): List<PErr>
  ret match(st)
    (f: PsFun)   => rugExprOpt(f.fBody, r, rugStmt(f.fParams, r, acc))
    (l: PsLet)   => rugExprOpt(l.lDefault, r, acc)
    (d: PsDestructure) => rugStmts(chain(d.dTargets), r,
                                   rugExprOpt(d.dDefault, r, acc))
    (c: PsClass) => rugStmts(chain(c.cMembers), r, rugStmt(c.cParams, r, acc))
    (e2: PsEnum) => rugStmts(chain(e2.eVariants), r,
                             rugStmt(e2.eParams, r, acc))
    (rt: PsRet)  => rugExpr(rt.retValue, r, acc)
    (a: PsAction) => rugExpr(a.action, r, acc)
    (i: PsIf)    => rugStmts(chain(i.ifFalse), r,
                             rugStmts(chain(i.ifTrue), r,
                                      rugExpr(i.ifCond, r, acc)))
    (o: PStmt)   => acc

fun rugExprOpt(x: PExpr|None, r: Resolver, acc: List<PErr>): List<PErr>
  ret match(x)
    (e2: PExpr) => rugExpr(e2, r, acc)
    ()          => acc

fun rugExpr(x: PExpr, r: Resolver, acc: List<PErr>): List<PErr>
  ret match(x)
    (nm: PeName)   => rugName(nm, r, acc)
    (d: PeDot)     => rugExpr(d.base, r, acc)
    (cc: PeCall)   => rugExpr(cc.parameter, r, rugExpr(cc.function, r, acc))
    (tp: PeTuple)  => rugTupEnts(chain(tp.exprs), r, acc)
    (te: PeTernary) => rugExpr(te.falseResult, r,
                               rugExpr(te.trueResult, r,
                                       rugExpr(te.condition, r, acc)))
    (lm: PeLambda) => rugExpr(lm.lamBody, r, rugStmt(lm.lamParams, r, acc))
    (bk: PeBlock)  => rugExpr(bk.blockValue, r,
                              rugStmts(chain(bk.blockStmts), r, acc))
    (mt: PeMatch)  => rugArms(chain(mt.arms), r, rugExpr(mt.subject, r, acc))
    (op: PeBuiltinOp) => rugExpr(op.opParams, r, acc)
    (nw: PeNew)    => rugExpr(nw.newParam, r, acc)
    (ar: PeArrayRead) => rugExpr(ar.arrIndex, r, rugExpr(ar.arrObj, r, acc))
    (cv: PeConvert) => rugExpr(cv.convInner, r, acc)
    (pl: PeParallel) => rugExpr(pl.parParams, r, acc)
    (o: PExpr)     => acc

fun [tail] rugTupEnts(es: Chain<PTupEnt>, r: Resolver,
                      acc: List<PErr>): List<PErr>
  ret match(es)
    (nil: ChainEnd) => acc
    (l: ChainLink)  => rugTupEnts(l.next, r,
                                  rugExpr(l.value.tupValue, r, acc))

fun [tail] rugArms(as2: Chain<PArm>, r: Resolver,
                   acc: List<PErr>): List<PErr>
  ret match(as2)
    (nil: ChainEnd) => acc
    (l: ChainLink)  => rugArms(l.next, r,
                               rugExprOpt(l.value.armGuard, r,
                                          rugExpr(l.value.armBody, r, acc)))

fun rugName(nm: PeName, r: Resolver, acc: List<PErr>): List<PErr>
  ret rugUnresolved(nm, r)
    ? append(acc, PErr(nm.penLine, rugMsg(bareOfUnique(nm.refName))))
    : acc

fun rugMsg(name: String): String
  ret "cannot infer the type arguments of generic function `" + name + "` here — write them explicitly: " + name + "<...>(...)"

fun rugUnresolved(nm: PeName, r: Resolver): Bool
  let bag = findData(r, nm.refName)
  ret match(soleItem(bag))
    (f: Found) => match(f.fStmt)
      # The template survived pruning: the use is fine only when it carries a
      # full, ground set of type arguments.
      (fn: PsFun) => !isEmpty(fn.fGens)
                     && (chainLength(chain(nm.refTypeParams))
                           != chainLength(chain(fn.fGens))
                         || anyFreePlaceholders(chain(nm.refTypeParams), r))
      (o: PStmt)  => false
    # Dangling: the name WAS resolved (it carries the @-hash) but its generic
    # template has been pruned, and the use still holds unbound placeholders.
    ()         => isEmpty(bag.bItems)
                  && findByte(nm.refName, '@', 0) >= 0
                  && !isEmpty(nm.refTypeParams)
                  && anyFreePlaceholders(chain(nm.refTypeParams), r)

fun [tail] anyFreePlaceholders(ts: Chain<Spec>, r: Resolver): Bool
  ret match(ts)
    (nil: ChainEnd) => false
    (l: ChainLink)  => hasFreePlaceholders(l.value, r)
      ? true
      : anyFreePlaceholders(l.next, r)

# ── entry point ──────────────────────────────────────────────────────────────
# Python: convert_generic_to_concrete. On errors the ORIGINAL statements come
# back with them; otherwise iterate → refresh → resolve traits.

fun convertGenericToConcrete(statements: List<PStmt>): GIter
  let it = convertGenericsIterative(statements)
  if !isEmpty(it.giErrs)
    ret GIter(statements, it.giErrs)
  ret GIter(resolveTraitReferences(refreshEnumSpecAllFields(it.giStmts)),
            List<PErr>())
