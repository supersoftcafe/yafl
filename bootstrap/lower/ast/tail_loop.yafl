# bootstrap/tail_loop.yafl — lowering/tail_loop.py: `[tail]` self-recursion →
# loop lowering.
#
# For a [tail]-marked function whose every self-call is in tail position, wrap
# the body in a PeLoop and rewrite each tail self-call into a PeRecur, then
# strip the [tail] attribute. A [tail] function that is not self-recursive, or
# has a self-call in a non-tail position, is a hard error. A self-call inside
# a lambda is a normal recursive call, not a tail call — both the counter and
# the rewriter skip lambda subtrees, so they always agree.
namespace Bootstrap::Lower::Ast

import System
import System::Containers

import Bootstrap::Ast
import Bootstrap::Parse
import Bootstrap::Resolve
import Bootstrap::Types



class [final] TlOut(tlStmts: List<PStmt>, tlErrs: Set<PErr>)
class [final] TlStmt(tsStmt: PStmt, tsErrs: Set<PErr>)
class [final] TlRw(rwExpr: PExpr, rwN: Int)

fun lowerTailLoops(statements: List<PStmt>) => tlLoop(statements, List(), Set())

# Program order out; the errors are a set, so they ride alongside untouched.
fun tlLoop(ss: List<PStmt>, acc, errs) =>
  fold(ss, TlOut(acc, errs), tlStep)

fun tlStep(o: TlOut, st: PStmt) => tlTransform(st)
  |> (out) => TlOut(append(o.tlStmts, out.tsStmt), union(o.tlErrs, out.tsErrs))

# Recurse into nested functions and class methods first (bottom-up), so a
# [tail] function nested inside another is lowered too.
fun tlTransform(st) => match(st)
  (f: PsFun)   => tlAfterNested(tlNested(f))
  (c: PsClass) => tlMembers(c.cMembers, List(),
                            Set())
    |> (out) => TlStmt(PsClass(c.cName, c.cAttrs, c.cGens, c.cParams,
                               c.cImplements, c.cWheres, out.tlStmts,
                               c.cIsInterface, c.pscLine, c.cAllParents,
                               c.cAllSlots, c.cImports),
                       out.tlErrs)
  (o: PStmt)   => TlStmt(st, Set())

fun tlMembers(ss: List<PStmt>, acc, errs) =>
  fold(ss, TlOut(acc, errs), tlStep)

fun tlAfterNested(out) => match(out.tsStmt)
  (f2: PsFun) => hasAttr(f2.fAttrs, "tail")
    ? tlLowerFun(f2, out.tsErrs)
    : out
  (o: PStmt)  => out

fun tlNested(f: PsFun) => match(f.fBody)
  (bk: PeBlock) => tlMembers(bk.blockStmts, List(),
                             Set())
    |> (out) => TlStmt(PsFun(f.fName, f.fAttrs, f.fGens, f.fParams,
                             PeBlock(out.tlStmts, bk.blockValue,
                                     bk.blockTag, bk.pebkLine),
                             f.fRet, f.fWheres, f.psfLine,
                             f.fRetInferred, f.fNested, f.fImports, f.fGlobal),
                       out.tlErrs)
  ()            => TlStmt(f, Set())

fun tlLowerFun(f, errs0) => match(f.fBody)
  (body: PExpr) => tlLowerBody(f, body, errs0)
  ()            => TlStmt(f, errs0)

fun tlLowerBody(f, body, errs0): TlStmt
  let total = tlCountSelf(body, f.fName, 0)
  let rw2 = tlRewriteTail(body, f.fName, 0)
  if total == 0
    ret TlStmt(f, add(errs0, PErr(f.psfLine,
        "[tail] requires direct self-recursion, but this function never calls itself directly (mutual recursion between functions is not supported)")))
  if rw2.rwN != total
    ret TlStmt(f, add(errs0, PErr(f.psfLine,
        "[tail] function has a call to itself in a non-tail position; [tail] requires every self-call to be in tail position")))
  let bodyLine = exprLine(body)
  let loop = PeLoop(rw2.rwExpr, tlParams(f), bodyLine)
  # Wrap in a block: later passes gate on the body being a block.
  let block = PeBlock(List(), loop, "", bodyLine)
  ret TlStmt(PsFun(f.fName, tlStripTail(f.fAttrs, List()),
                   f.fGens, f.fParams, block, f.fRet, f.fWheres, f.psfLine,
                   f.fRetInferred, f.fNested, f.fImports, f.fGlobal),
             errs0)

# The loop-carried params: NamedExpression references at the FUNCTION's line.
fun tlParams(f: PsFun) => match(f.fParams)
  (d: PsDestructure) => tlParamRefs(d.dTargets, f.psfLine,
                                         List())
  (o: PStmt)         => List()

fun tlParamRefs(ts: List<PStmt>, lr, acc: List<PExpr>) =>
  concat(acc, map(ts, (t) => PeName(stmtName(t), List(), lr, None)))

fun tlStripTail(as2: List<PAttr>, acc: List<PAttr>) => concat(acc, filter(as2, (a) => a.attrName != "tail"))

fun tlIsSelfCall(x, fName) => match(x)
  (c: PeCall) => tlIsSelfRef(c.function, fName)
  (o2: PExpr) => false

# A member's reference to itself is `this.<name>`: convergence rewrites every
# MEMBER-scoped name that way, so a `[tail]` method's self-call never arrives as
# a bare name and would otherwise look like no self-call at all — the "requires
# direct self-recursion" error, on a function that plainly does recurse. The
# shape only arises for the enclosing class's own member: `this` names the
# receiver of the method being rewritten, so `this.<its own name>` is that
# method.
fun tlIsSelfRef(f, fName) => match(f)
  (nm: PeName) => nm.refName == fName
  (d: PeDot)   => d.member == fName && tlIsThis(d.base)
  (o: PExpr)   => false

fun tlIsThis(x) => match(x)
  (nm: PeName) => nm.refName == "this"
  (o: PExpr)   => false

# ── the self-call counter ────────────────────────────────────────────────────
# Python blanks every lambda to a leaf, then counts self-calls with a full
# search_and_replace walk; a fold that skips lambda subtrees counts the same.

fun tlCountSelf(x, fName, n): Int
  let n2 = tlIsSelfCall(x, fName) ? n + 1 : n
  ret match(x)
    (d: PeDot)     => tlCountSelf(d.base, fName, n2)
    (c: PeCall)    => tlCountSelf(c.parameter, fName,
                                  tlCountSelf(c.function, fName, n2))
    (qq: PeCoalesce)   => tlCountSelf(qq.qqFallback, fName,
                                  tlCountSelf(qq.qqSubject, fName, n2))
    (wx: PeWith)   => tlCountSelf(wx.withRepls, fName,
                                  tlCountSelf(wx.withSubject, fName, n2))
    (tp: PeTuple)  => tlCountEnts(tp.exprs, fName, n2)
    (te: PeTernary) => tlCountSelf(te.falseResult, fName,
                         tlCountSelf(te.trueResult, fName,
                           tlCountSelf(te.condition, fName, n2)))
    (lm: PeLambda) => n2                 # lambda subtree skipped (blanked)
    (bk: PeBlock)  => tlCountSelf(bk.blockValue, fName,
                                  tlCountStmts(bk.blockStmts, fName,
                                               n2))
    (mt: PeMatch)  => tlCountArms(mt.arms, fName,
                                  tlCountSelf(mt.subject, fName, n2))
    (op: PeBuiltinOp) => tlCountSelf(op.opParams, fName, n2)
    (ps: PePinSet) => tlCountSelf(ps.psValue, fName,
                        tlCountSelf(ps.psTarget, fName,
                          tlCountSelf(ps.psSubject, fName, n2)))
    (nw: PeNew)    => tlCountSelf(nw.newParam, fName, n2)
    (ar: PeArrayRead) => tlCountSelf(ar.arrIndex, fName,
                                     tlCountSelf(ar.arrObj, fName, n2))
    (cv: PeConvert) => tlCountSelf(cv.convInner, fName, n2)
    (ne: PeNewEnum) => fold(ne.fieldArgs, n2, (a2, fa) =>
                            tlCountSelf(fa.faValue, fName, a2))
    (o: PeLiteral) => n2
    (o: PeLowered) => n2
    (o: PeName) => n2

fun tlCountEnts(es: List<PTupEnt>, fName, n): Int =>
  fold(es, n, (k, e) => tlCountSelf(e.tupValue, fName, k))

fun tlCountArms(as2: List<PArm>, fName, n): Int =>
  fold(as2, n, (k, a) => tlCountOpt(a.armGuard, fName, tlCountSelf(a.armBody, fName, k)))

fun tlCountOpt(x: PExpr|None, fName, n) => match(x)
  (e2: PExpr) => tlCountSelf(e2, fName, n)
  ()          => n

fun tlCountStmts(ss: List<PStmt>, fName: String, n) =>
  fold(ss, n, (k, s) => tlCountStmt(s, fName, k))

fun tlCountStmt(st, fName, n): Int => match(st)
  (f: PsFun)   => tlCountOpt(f.fBody, fName,
                             tlCountStmt(f.fParams, fName, n))
  (l: PsLet)   => tlCountOpt(l.lDefault, fName, n)
  (d: PsDestructure) => tlCountStmts(d.dTargets, fName,
                                     tlCountOpt(d.dDefault, fName, n))
  (rt: PsRet)  => tlCountSelf(rt.retValue, fName, n)
  (a: PsAction) => tlCountSelf(a.action, fName, n)
  (fa: PsFieldAssign) => tlCountSelf(fa.faValue, fName, tlCountSelf(fa.faTarget, fName, n))
  (i: PsIf)    => tlCountStmts(i.ifFalse, fName,
                               tlCountStmts(i.ifTrue, fName,
                                            tlCountSelf(i.ifCond, fName,
                                                        n)))
  (o: PStmt)   => n

fun tlCountStmt2(st, fName, n) => tlCountStmt(st, fName, n)

# ── the tail rewriter ────────────────────────────────────────────────────────
# Ordinals are assigned in rewrite order (statements before the block value,
# true branch before false, arms in order) — the same order Python's mutable
# counter produces.

fun tlRewriteTail(x, fName, n)
  if tlIsSelfCall(x, fName)
    ret tlToRecur(x, n)
  ret match(x)
    (bk: PeBlock)  => tlStmtTails(bk.blockStmts, fName, n,
                                  List())
      |> (so) => (so, tlRewriteTail(bk.blockValue, fName, so.soN))
      |> (so, vo) => TlRw(PeBlock(so.soStmts, vo.rwExpr, bk.blockTag,
                                  bk.pebkLine),
                          vo.rwN)
    (te: PeTernary) => tlRewriteTail(te.trueResult, fName, n)
      |> (t2) => (t2, tlRewriteTail(te.falseResult, fName, t2.rwN))
      |> (t2, f2) => TlRw(PeTernary(te.condition, t2.rwExpr, f2.rwExpr,
                                    te.pety),
                          f2.rwN)
    (mt: PeMatch)  => tlArmTails(mt.arms, fName, n, List())
      |> (ao) => TlRw(with mt(arms = ao.aoArms), ao.aoN)
    (o: PExpr)     => TlRw(x, n)   # non-tail-bearing: a base-case value

fun tlToRecur(x, n) => match(x)
  (c: PeCall) => match(c.parameter)
    (tp: PeTuple) => TlRw(PeRecur(tlEntValues(tp.exprs,
                                              List()),
                                  n, c.pecLine),
                          n + 1)
    (o: PExpr)    => TlRw(x, n)
  (o2: PExpr) => TlRw(x, n)

fun tlEntValues(es: List<PTupEnt>, acc): List<PExpr> => concat(acc, map(es, (e) => e.tupValue))

class [final] TlSo(soStmts: List<PStmt>, soN: Int)
class [final] TlAo(aoArms: List<PArm>, aoN: Int)

# Early returns in tail position: every `ret expr` inside — including inside
# `if` branches, which are scopes, not blocks — is a tail exit. Other
# statement kinds run BEFORE the block's result and are left alone.
# (Not [tail]: the PsIf arm recurses into both branches.)
fun tlStmtTails(ss: List<PStmt>, fName, n, acc) =>
  fold(ss, TlSo(acc, n), (so, st) => tlStmtTail(so, st, fName))

fun tlStmtTail(so: TlSo, st: PStmt, fName: String): TlSo => match(st)
  (rt: PsRet) => tlRewriteTail(rt.retValue, fName, so.soN)
    |> (vo) => TlSo(append(so.soStmts, PsRet(vo.rwExpr, rt.psrLine)), vo.rwN)
  (i: PsIf)   => tlStmtTails(i.ifTrue, fName, so.soN, List())
    |> (to) => (to, tlStmtTails(i.ifFalse, fName, to.soN, List()))
    |> (to, fo) => TlSo(append(so.soStmts, PsIf(i.ifCond, to.soStmts, fo.soStmts, i.psifLine)), fo.soN)
  (o: PStmt)  => TlSo(append(so.soStmts, st), so.soN)

fun tlArmTails(as2: List<PArm>, fName, n, acc) =>
  fold(as2, TlAo(acc, n), (ao, a) => tlRewriteTail(a.armBody, fName, ao.aoN)
    |> (bo) => TlAo(append(ao.aoArms, with a(armBody = bo.rwExpr)), bo.rwN))
