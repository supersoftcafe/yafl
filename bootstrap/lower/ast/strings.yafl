# bootstrap/strings.yafl — lowering/strings.py: hoist every string literal to
# a global `let $strings::string@N`, replacing each use with a reference.
# Sorted before numbering, so the per-string index is deterministic.
namespace Bootstrap::Lower::Ast

import System
import System::Containers

import Bootstrap::Ast
import Bootstrap::StdlibCandidates



fun fixGlobalStrings(statements): List<PStmt>
  let values = sort(foldStmts(statements,
                                    gsIdNames,
                                    gsCollect,
                                    List()))
  if isEmpty(values)
    ret statements
  let globals2 = gsGlobals(values, 0, List())
  ret concat(globals2,
             rwStmts(statements, rwOnExpr((x) => gsReplace(x,
                                                           values))))

fun gsIdNames(acc, st: PStmt): List<String> => acc

fun gsCollect(acc, x) => match(x)
  # First-seen order: gsGlobals numbers these by index, so the order is
  # part of the generated global names. `acc` is read by the dedup.
  (s2: PeStr) => contains2(acc, s2.strValue)
    ? acc
    : append(acc, s2.strValue)
  (o: PExpr)  => acc

# The index travels in the accumulator beside the statements.
fun gsGlobals(vs: List<String>, index: Int, acc: List<PStmt>)
  ret fold(vs, (out = acc, i = index),
           (st, v) =>
             (out = append(st.out, gsGlobal(v, st.i)), i = st.i + 1)).out

fun gsGlobal(v: String, index: Int): PStmt
  ret PsLet("$strings::string@" + String(index),
            List(), List(),
            SBuiltin("str", PLine("$strings", index + 1, 1)),
            PeStr(v, PLine("$strings", index + 1, 1)),
            "", List(), PLine("$strings", index + 1, 1),
            false, List<PStmt>())

fun gsReplace(x, values: List<String>) => match(x)
  (s2: PeStr) => PeName("$strings::string@"
                          + String(gsIndexOf(values, s2.strValue,
                                             0)),
                        List(),
                        PLine("$strings",
                              gsIndexOf(values, s2.strValue, 0) + 1,
                              1),
                        None)
  (o: PExpr)  => None

fun gsIndexOf(vs: List<String>, v: String, i) => match(findIndex(vs, (x) => x == v))
  (k: Int) => i + k
  ()       => -1
