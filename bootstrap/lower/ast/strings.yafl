# bootstrap/strings.yafl — lowering/strings.py: hoist every string literal to
# a global `let $strings::string@N`, replacing each use with a reference.
# Sorted before numbering, so the per-string index is deterministic.
namespace Bootstrap::Lower::Ast

import System

import Bootstrap::Ast
import Bootstrap::StdlibCandidates



fun fixGlobalStrings(statements): List<PStmt>
  let values = sort(foldStmts(statements,
                                    gsIdNames,
                                    gsCollect,
                                    List()))
  if isEmpty(values)
    ret statements
  let globals2 = gsGlobals(chain(values), 0, List())
  ret concat(globals2,
             rwStmts(statements, rwOnExpr((x) => gsReplace(x,
                                                           values))))

fun gsIdNames(acc, st: PStmt): List<String>
  ret acc

fun gsCollect(acc, x): List<String>
  ret match(x)
    # First-seen order: gsGlobals numbers these by index, so the order is
    # part of the generated global names. `acc` is read by the dedup.
    (s2: PeStr) => contains2(acc, s2.strValue)
      ? acc
      : build(push(builderFrom(acc), s2.strValue))
    (o: PExpr)  => acc

fun gsGlobals(vs, index: Int,
                     acc: List<PStmt>): List<PStmt>
  ret build(gsGlobalsB(vs, index, builderFrom(acc)))

fun [tail] gsGlobalsB(vs: Chain<String>, index: Int,
                     [terminal] acc: ListBuilder<PStmt>): ListBuilder<PStmt>
  ret match(vs)
    (nil: ChainEnd) => acc
    (l: ChainLink)  => gsGlobalsB(l.next, index + 1,
        push(acc, PsLet("$strings::string@" + String(index),
                  List(), List(),
                  SBuiltin("str", PLine("$strings", index + 1, 1)),
                  PeStr(l.value, PLine("$strings", index + 1, 1)),
                  "", List(), PLine("$strings", index + 1, 1),
                  false, List<PStmt>())))

fun gsReplace(x, values: List<String>): PExpr|None
  ret match(x)
    (s2: PeStr) => PeName("$strings::string@"
                            + String(gsIndexOf(chain(values), s2.strValue,
                                               0)),
                          List(),
                          PLine("$strings",
                                gsIndexOf(chain(values), s2.strValue, 0) + 1,
                                1),
                          None)
    (o: PExpr)  => None

fun [tail] gsIndexOf(vs: Chain<String>, v: String, i: Int): Int
  ret match(vs)
    (nil: ChainEnd) => -1
    (l: ChainLink)  => l.value == v ? i : gsIndexOf(l.next, v, i + 1)
