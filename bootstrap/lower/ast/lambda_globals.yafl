# bootstrap/lambda_globals.yafl — ported from lowering/lambda_globals.py.
# A global `let` whose value is a lambda IS a function: captureless (globals
# see no locals), fully typed by convergence — repackage it as a plain fun so
# it compiles with none of the closure or lazy-init machinery.
namespace Bootstrap::Lower::Ast

import System

import Bootstrap::Ast



fun lowerLambdaGlobals(statements: List<PStmt>): List<PStmt>
  ret llgLoop(chain(statements), List<PStmt>())

fun llgLoop(ss: Chain<PStmt>, acc: List<PStmt>): List<PStmt>
  ret build<PStmt >(llgLoopB(ss, _pushChain<PStmt >(builder<PStmt >(), chain<PStmt >(acc))))

fun [tail] llgLoopB(ss: Chain<PStmt>, [terminal] acc: ListBuilder<PStmt >): ListBuilder<PStmt >
  ret match(ss)
    (nil: ChainEnd) => acc
    (l: ChainLink)  => llgLoopB(l.next, push<PStmt >(acc, llgOne(l.value)))

fun llgOne(st: PStmt): PStmt
  ret match(st)
    (l: PsLet) => match(l.lDefault)
      (d: PExpr) => match(d)
        (lm: PeLambda) => globalFunOf(l, lm)
        (o: PExpr)     => st
      ()         => st
    (o: PStmt) => st

# The lambda's return_type is the whole (params): result CallableSpec; the
# function wants just the result.
fun globalFunOf(l: PsLet, lm: PeLambda): PStmt
  ret PsFun(l.lName, l.lAttrs, l.lGens, lm.lamParams, lm.lamBody,
            lambdaRetResult(lm), l.lWheres, l.pslLine, false, false,
            l.lImports)

fun lambdaRetResult(lm: PeLambda): Spec|None
  ret match(lm.lamRet)
    (rt: Spec) => match(rt)
      (cl: SCallable) => cl.scResult
      (o: Spec)       => None
    ()         => None
