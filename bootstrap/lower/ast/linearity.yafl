# bootstrap/linearity.yafl — linear-type checking, ported from
# lowering/linearity.py: every linear value is consumed exactly once on every
# execution path. Sound, intentionally incomplete — the conservative
# rejections are the same ones, with the same messages.
#
# An OBLIGATION is (root binding, field path to a linear leaf) — keyed here as
# "root" or "root/f1/f2". The counter mirrors Python's Counter semantics:
# addition keeps positive counts; a merge compares counts per obligation and
# reports per-branch inconsistency.
namespace Bootstrap::Lower::Ast

import System

import Bootstrap::Ast
import Bootstrap::Frontend
import Bootstrap::Parse
import Bootstrap::Resolve
import Bootstrap::Types



# The counter carries its key list (Dict has no key enumeration): addition
# unions keys and keeps POSITIVE sums only — Python Counter semantics.
# Just the counts. The key list beside them was exactly keys(lcCounts), kept
# only to iterate — and its order is never observed: the walks over it either
# sum counts or raise errors, which the driver prints sorted.
class [final] LinCnt(lcCounts: Dict<String, Int>)

fun lcKeys(c: LinCnt) => sort(keys(c.lcCounts))
class [final] LinOut(loCnt: LinCnt, loErrs: Set<PErr>)
# The env likewise: binding names (insertion order — discharge order matches
# Python's dict iteration) plus their types.
class [final] LinEnv(leTypes: Dict<String, Spec>)

fun leNames(env: LinEnv) => sort(keys(env.leTypes))

fun emptyCnt() => LinCnt(Dict())

fun linZero(errs): LinOut => LinOut(emptyCnt(), errs)

fun emptyEnv() => LinEnv(Dict())

fun envPut(env: LinEnv, name, ty) => LinEnv(put(env.leTypes, name, ty))

fun envType(env: LinEnv, name: String) => get(env.leTypes, name)

fun envHas(env: LinEnv, name: String) => contains(env.leTypes, name)

fun cntAdd(a, b: LinCnt) => addKeys2(lcKeys(b), b.lcCounts, a)

fun [tail] addKeys2(ks: List<String>, bc: Dict<String, Int>,
                    acc) => isEmpty(ks)
  ? acc
  : addKeys2(tail(ks), bc,
                              cntBump(acc, first(ks),
                                      countOf(bc, first(ks))))

fun cntBump(c, key, by)
  let now = countOf(c.lcCounts, key) + by
  ret now <= 0 ? c : LinCnt(put(c.lcCounts, key, now))

fun cntDrop(c: LinCnt, key) => LinCnt(remove(c.lcCounts, key))

# Per-branch merge: counts must AGREE per obligation; result is c1 unless
# empty (Python: `c1 if c1 else c2`).
fun cntMerge(c1, c2, lr, acc): LinOut
  let errs = mergeErrs(addNamesOnce(lcKeys(c1), lcKeys(c2)),
                       c1, c2, lr, acc)
  ret LinOut(isEmpty(c1.lcCounts) ? c2 : c1, errs)


fun [tail] mergeErrs(ks: List<String>, c1: LinCnt, c2: LinCnt, lr,
                     acc: Set<PErr>) => isEmpty(ks)
  ? acc
  : countOf(c1.lcCounts, first(ks))
                     == countOf(c2.lcCounts, first(ks))
    ? mergeErrs(tail(ks), c1, c2, lr, acc)
    : mergeErrs(tail(ks), c1, c2, lr,
                add(acc, PErr(lr, "linear value '" + rootOf(first(ks))
                                     + "' is used inconsistently across branches")))

fun rootOf(key)
  let ix = findByte(key, '/', 0)
  ret ix < 0 ? key : slice(key, 0, ix)

# ── entry point ─────────────────────────────────────────────────────────────

fun checkLinearity(statements: List<PStmt>, r): Set<PErr>
  ret checkInstantiations(statements, r,
                          linToplevels(statements, r, noErrs()))

fun [tail] linToplevels(ss: List<PStmt>, r,
                        acc: Set<PErr>) => isEmpty(ss)
  ? acc
  : linToplevels(tail(ss), r, linToplevel(first(ss), r, acc))

fun [tail] linInstMembers(ms: List<PStmt>, r,
                          acc: Set<PErr>) => isEmpty(ms)
  ? acc
  : match(first(ms))
    (f: PsFun) => linInstMembers(tail(ms), r, linFunction(f, None, r, acc))
    (o: PStmt) => linInstMembers(tail(ms), r, acc)

fun linToplevel(st, r, acc): Set<PErr> => match(st)
  (f: PsFun)   => linFunction(f, None, r, acc)
  (c: PsClass) => linClass(c, r, acc)
  # A first-class instance's members are ordinary functions.
  (ti: PsTraitInstance) => linInstMembers(ti.tiMembers, r, acc)
  (e2: PsEnum) => linEnum(e2, r, acc)
  (l: PsLet)   => carriesLinearity(l.lType, r)
    ? add(acc, PErr(l.pslLine, "linear value not allowed in a global let"))
    : acc
  (o: PStmt)   => acc

# ── linearity of types ──────────────────────────────────────────────────────
# leaves(spec): the field paths from a value to its linear leaves. "" is the
# whole-value leaf.

fun linLeaves(sp: Spec|None, r) => match(sp)
  (s2: Spec) => leavesOf(s2, r, List())
  ()         => List()

fun leavesOf(sp, r, seen: List<String>) => match(sp)
  (g2: SGeneric)     => g2.sgLinear
    ? prepend("", List())
    : List()
  (c: SClass)        => classLeaves(c, r, seen)
  (t2: STuple)       => tupleLeaves(t2.stEntries, r, seen,
                                    List())
  (cm: SCombination) => anyMemberLinear(cm.scTypes, r, seen)
    ? prepend("", List())
    : List()
  (o: Spec)          => List()

fun classLeaves(c: SClass, r, seen: List<String>)
  if !isLinearClassSpec(c, r)
    ret List()
  if contains2(seen, c.scName)
    ret prepend("", List())          # recursive linear type: one leaf
  ret match(soleItem(findType(r, c.scName)))
    (f: Found) => match(f.fStmt)
      # `seen` is the recursion guard — a membership set.
      (cs: PsClass) => classFieldLeaves(cs, c, r, prepend(c.scName, seen))
      (o: PStmt)    => prepend("", List())
    ()         => prepend("", List())

fun classFieldLeaves(cs: PsClass, c: SClass, r,
                     seen: List<String>)
  let mapping = paramMapping(cs.cGens, c.scParams)
  let out = fieldLeaves(classFields(cs), mapping, r, seen,
                        List())
  # A linear class with no linear fields is itself the leaf.
  ret isEmpty(out) ? prepend("", List()) : out

fun [tail] fieldLeaves(fs: List<PStmt>, mapping: List<Binding>, r,
                       seen: List<String>, acc: List<String>) => isEmpty(fs)
  ? acc
  : match(first(fs))
    (let2: PsLet) => match(let2.lType)
      (ft: Spec) => fieldLeaves(tail(fs), mapping, r, seen,
                                prefixLeaves(let2.lName,
                                             leavesOf(substitute(ft, mapping),
                                                      r, seen),
                                             acc))
      ()         => fieldLeaves(tail(fs), mapping, r, seen, acc)
    (o: PStmt)    => fieldLeaves(tail(fs), mapping, r, seen, acc)

fun [tail] tupleLeaves(es: List<SEntry>, r, seen: List<String>,
                       acc): List<String> => isEmpty(es)
  ? acc
  : first(es).seName == ""
    ? tupleLeaves(tail(es), r, seen, acc)
    : match(first(es).seType)
      (ty: Spec) => tupleLeaves(tail(es), r, seen,
                                prefixLeaves(first(es).seName,
                                             leavesOf(ty, r, seen), acc))
      ()         => tupleLeaves(tail(es), r, seen, acc)

fun prefixLeaves(name, subs: List<String>,
                 acc): List<String> => leafPrefixLoop(subs, name, acc)

fun [tail] leafPrefixLoop(ss: List<String>, name,
                      acc: List<String>) => isEmpty(ss)
  ? acc
  : leafPrefixLoop(tail(ss), name,
                                addNameOnce(acc,
                                            first(ss) == ""
                                              ? name
                                              : name + "/" + first(ss)))

fun [tail] anyMemberLinear(ms: List<Spec>, r,
                           seen: List<String>) => isEmpty(ms)
  ? false
  : isEmpty(leavesOf(first(ms), r, seen))
    ? anyMemberLinear(tail(ms), r, seen)
    : true

fun carriesLinearity(sp: Spec|None, r) => !isEmpty(linLeaves(sp, r))

fun isLinearClassSpec(c: SClass, r) => match(soleItem(findType(r, c.scName)))
  (f: Found) => match(f.fStmt)
    (cs: PsClass) => hasAttr(cs.cAttrs, "linear")
    (o: PStmt)    => false
  ()         => false

# ── structural (conservative) rejections ────────────────────────────────────
# Linear types may not appear where the flow analysis cannot trace them: as a
# generic argument of a NON-linear class. Inside a union is allowed.

fun checkTypePosition(sp: Spec|None, lr, r,
                      acc): Set<PErr> => match(sp)
  (s2: Spec) => typePosition(s2, lr, r, acc)
  ()         => acc

fun typePosition(sp, lr, r,
                 acc): Set<PErr> => match(sp)
  (cm: SCombination) => positionList(cm.scTypes, lr, r, acc)
  (c: SClass)        => isLinearClassSpec(c, r)
    ? acc
    : classArgPositions(c.scParams, lr, r, acc)
  (t2: STuple)       => entryPositions(t2.stEntries, lr, r, acc)
  (cl: SCallable)    => checkTypePosition(cl.scResult, lr, r,
                                          typePosition(cl.scParams2, lr, r,
                                                       acc))
  (o: Spec)          => acc

fun [tail] positionList(ms: List<Spec>, lr, r,
                        acc: Set<PErr>) => isEmpty(ms)
  ? acc
  : positionList(tail(ms), lr, r,
                                  typePosition(first(ms), lr, r, acc))

fun [tail] classArgPositions(as2: List<Spec>, lr, r,
                             acc: Set<PErr>) => isEmpty(as2)
  ? acc
  : classArgPositions(tail(as2), lr, r,
      typePosition(first(as2), lr, r,
                   carriesLinearity(first(as2), r)
                     ? add(acc, PErr(lr,
                         "linear type not allowed as a generic type argument"))
                     : acc))

fun [tail] entryPositions(es: List<SEntry>, lr, r,
                          acc): Set<PErr> => isEmpty(es)
  ? acc
  : entryPositions(tail(es), lr, r,
                                    checkTypePosition(first(es).seType, lr, r,
                                                      acc))

# ── declarations ────────────────────────────────────────────────────────────

fun linEnum(e2: PsEnum, r, acc): Set<PErr>
  ret enumFieldLin(collectDataFields(e2), e2.pseLine, r, acc)

fun [tail] enumFieldLin(fs: List<SField>, lr, r,
                        acc): Set<PErr> => isEmpty(fs)
  ? acc
  : enumFieldLin(tail(fs), lr, r,
      checkTypePosition(first(fs).sfType, lr, r,
                        carriesLinearity(first(fs).sfType, r)
                          ? add(acc, PErr(lr,
                              "a linear value may not be stored in an enum"))
                          : acc))

fun linClass(c: PsClass, r, acc): Set<PErr>
  let isLin = hasAttr(c.cAttrs, "linear")
  let acc2 = classFieldLin(classFields(c), c, isLin, r, acc)
  let thisTy = isLin ? classThis(c) : None
  ret classMethodLin(c.cMembers, thisTy, r, acc2)

fun classThis(c: PsClass) => thisType(c)

fun [tail] classFieldLin(fs: List<PStmt>, c: PsClass, isLin,
                         r, acc: Set<PErr>) => isEmpty(fs)
  ? acc
  : match(first(fs))
    (let2: PsLet) => classFieldLin(tail(fs), c, isLin, r,
        checkTypePosition(let2.lType, let2.pslLine, r,
                          !isLin && carriesLinearity(let2.lType, r)
                            ? add(acc, PErr(c.pscLine,
                                "a class with a linear field must be declared [linear]"))
                            : acc))
    (o: PStmt)    => classFieldLin(tail(fs), c, isLin, r, acc)

fun [tail] classMethodLin(ms: List<PStmt>, thisTy: Spec|None, r,
                          acc: Set<PErr>) => isEmpty(ms)
  ? acc
  : match(first(ms))
    (f: PsFun) => classMethodLin(tail(ms), thisTy, r,
                                 linFunction(f, thisTy, r, acc))
    (o: PStmt) => classMethodLin(tail(ms), thisTy, r, acc)

# ── functions ───────────────────────────────────────────────────────────────

fun linFunction(f: PsFun, thisTy: Spec|None, r0,
                acc): Set<PErr>
  let params = flattenParams(f.fParams)
  let acc2 = checkTypePosition(f.fRet, f.psfLine, r0,
                               paramPositions(params, r0, acc))
  if hasAttr(f.fAttrs, "foreign")
    ret anyLinearSignature(params, f.fRet, r0)
      ? add(acc2, PErr(f.psfLine,
                          "[foreign] functions may not name a linear type"))
      : acc2
  ret match(f.fBody)
    (b: PExpr) => linBody(f, b, params, thisTy, r0, acc2)
    ()         => acc2

fun [tail] paramPositions(ps: List<PStmt>, r,
                          acc: Set<PErr>) => isEmpty(ps)
  ? acc
  : match(first(ps))
    (let2: PsLet) => paramPositions(tail(ps), r,
                                    checkTypePosition(let2.lType,
                                                      let2.pslLine, r, acc))
    (o: PStmt)    => paramPositions(tail(ps), r, acc)

fun [tail] anyLinearSignature(ps: List<PStmt>, retTy: Spec|None,
                              r) => isEmpty(ps)
  ? carriesLinearity(retTy, r)
  : match(first(ps))
    (let2: PsLet) => carriesLinearity(let2.lType, r)
      ? true
      : anyLinearSignature(tail(ps), retTy, r)
    (o: PStmt)    => anyLinearSignature(tail(ps), retTy, r)

# env: {binding → type} for every linear obligation in scope. `[terminal]` on
# the method opts out `this`; on a parameter, that parameter.
fun linBody(f: PsFun, b, params: List<PStmt>, thisTy: Spec|None,
            r0, acc)
  let env0 = match(thisTy)
    (tt: Spec) => hasAttr(f.fAttrs, "terminal")
      ? emptyEnv()
      : envPut(emptyEnv(), "this", tt)
    ()         => emptyEnv()
  let env = paramEnv(params, r0, env0)
  let bodyR = localScope(params, genScope(f.fGens, f.fWheres, r0))
  ret analyzeScope(b, env, f.psfLine, bodyR, r0, acc)

fun [tail] paramEnv(ps: List<PStmt>, r, env) => isEmpty(ps)
  ? env
  : match(first(ps))
    (let2: PsLet) => linearParam(let2, r)
      ? paramEnv(tail(ps), r, putEnv(env, let2))
      : paramEnv(tail(ps), r, env)
    (o: PStmt)    => paramEnv(tail(ps), r, env)

fun putEnv(env, let2: PsLet) => match(let2.lType)
  (ty: Spec) => envPut(env, let2.lName, ty)
  ()         => env

fun linearParam(let2: PsLet, r)
  ret carriesLinearity(let2.lType, r) && !hasAttr(let2.lAttrs, "terminal")

# Check a function/lambda body: every linear binding discharged once.
fun analyzeScope(b, env, lr,
                 bodyR, r, acc)
  let out = linCount(b, env, bodyR, acc)
  ret dischargeEnv(leNames(env), env, out.loCnt.lcCounts, lr, r, true,
                   out.loErrs)

fun [tail] dischargeEnv(ns: List<String>, env: LinEnv,
                        counts: Dict<String, Int>, lr, r,
                        isParam, acc: Set<PErr>) => isEmpty(ns)
  ? acc
  : dischargeEnv(tail(ns), env, counts, lr, r, isParam,
      discharge(first(ns), linLeaves(envType(env, first(ns)), r), counts, lr,
                isParam, acc))

# Each obligation consumed exactly once. `isParam` adds the hint.
fun discharge(name, leaves: List<String>, counts: Dict<String, Int>,
              lr, isParam: Bool, acc): Set<PErr>
  ret dischargeLoop(leaves, name, counts, lr, isParam, acc)

fun [tail] dischargeLoop(ls: List<String>, name,
                         counts: Dict<String, Int>, lr, isParam,
                         acc: Set<PErr>): Set<PErr> => isEmpty(ls)
  ? acc
  : dischargeLoop(tail(ls), name, counts, lr, isParam,
                                   dischargeOne2(oblKey(name, first(ls)),
                                                 name, counts, lr, isParam,
                                                 acc))

fun dischargeOne2(key: String, name, counts: Dict<String, Int>,
                  lr, isParam, acc): Set<PErr>
  let n = countOf(counts, key)
  if n > 1
    ret add(acc, PErr(lr, "linear value '" + name + "' is used "
                             + String(n) + " times; must be used once"))
  if n == 0
    ret add(acc, PErr(lr, "linear value '" + name
                             + "' is never used; it must be consumed once"
                             + (isParam
                                ? " (mark the parameter if this is its terminus)"
                                : "")))
  ret acc

fun oblKey(name, leaf) => leaf == "" ? name : name + "/" + leaf

fun countOf(counts: Dict<String, Int>, key: String) => match(get(counts, key))
  (n: Int) => n
  ()       => 0



# ── the count flow analysis ─────────────────────────────────────────────────
# Per-execution-path consumption of the env's obligations by an expression.

fun [tail] linCount(x, env, r, acc): LinOut => match(x)
  (nm: PeName)   => LinOut(countPath(x, env, r), acc)
  (d: PeDot)     => LinOut(countPath(x, env, r), acc)
  (c: PeCall)    => countCall(c, env, r, acc)
  (tp: PeTuple)  => countEntries(tp.exprs, env, r, linZero(acc))
  (nw: PeNew)    => linCount(nw.newParam, env, r, acc)
  (qq: PeCoalesce) => linPair(qq.qqSubject, qq.qqFallback, env, r, acc)
  (ar: PeArrayRead) => linPair(ar.arrObj, ar.arrIndex, env, r, acc)
  (ne: PeNewEnum) => linFieldArgs(ne.fieldArgs, env, r, acc)
  (op: PeBuiltinOp) => linCount(op.opParams, env, r, acc)
  (cv: PeConvert) => linCount(cv.convInner, env, r, acc)
  (wx: PeWith)   => linPair(wx.withSubject, wx.withRepls, env, r, acc)
  (te: PeTernary) => countTernary(te, env, r, acc)
  (mt: PeMatch)  => countMatch(mt, env, r, acc)
  (bk: PeBlock)  => countBlock(bk, env, r, acc)
  (lm: PeLambda) => countLambda(lm, env, r, acc)
  (pl: PeParallel) => countParallel(pl, env, r, acc)
  (o: PeLiteral) => linZero(acc)       # literals carry no linear value
  (o: PeLowered) => linZero(acc)       # literals carry no linear value

# A method call `recv.method(args)` passes `recv` as `this`: count the
# RECEIVER itself (counting the method-access dot would read as a borrow).
fun countCall(c: PeCall, env, r, acc) => match(c.function)
  (d: PeDot) => linPair(d.base, c.parameter, env, r, acc)
  (o: PExpr) => linPair(c.function, c.parameter, env, r, acc)

fun linPair(a, b, env, r,
            acc)
  let o1 = linCount(a, env, r, acc)
  let o2 = linCount(b, env, r, o1.loErrs)
  ret LinOut(cntAdd(o1.loCnt, o2.loCnt), o2.loErrs)

# Field-arg value expressions count like any other reads (Python counts the
# NamedExpressions inside field_args). Not [tail]: the counts sum on the way
# back up; fieldArgs lists are tiny.
fun linFieldArgs(fas: List<PFieldArg>, env, r,
                 acc): LinOut => isEmpty(fas)
  ? linZero(acc)
  : linFaStep(fas, env, r, acc)

fun linFaStep(l: List<PFieldArg>, env, r,
              acc)
  let o1 = linCount(first(l).faValue, env, r, acc)
  let o2 = linFieldArgs(tail(l), env, r, o1.loErrs)
  ret LinOut(cntAdd(o1.loCnt, o2.loCnt), o2.loErrs)

fun [tail] countEntries(es: List<PTupEnt>, env, r,
                        acc): LinOut => isEmpty(es)
  ? acc
  : linCount(first(es).tupValue, env, r, acc.loErrs)
    |> (o) => countEntries(tail(es), env, r,
                           LinOut(cntAdd(acc.loCnt, o.loCnt), o.loErrs))

fun countTernary(te: PeTernary, env, r,
                 acc)
  let cond = linCount(te.condition, env, r, acc)
  let tb = linCount(te.trueResult, env, r, cond.loErrs)
  let fb = linCount(te.falseResult, env, r, tb.loErrs)
  let merged = cntMerge(tb.loCnt, fb.loCnt, te.pety, fb.loErrs)
  ret LinOut(cntAdd(cond.loCnt, merged.loCnt), merged.loErrs)

# Match: subject + per-arm counts. An arm binder with a LINEAR type joins the
# env for its body, is discharged per arm, then popped so it doesn't leak
# into the merge; arm counts pairwise-merge.
fun countMatch(mt: PeMatch, env, r,
               acc): LinOut
  let subj = linCount(mt.subject, env, r, acc)
  ret armCounts(mt.arms, env, r,
                LinOut(subj.loCnt, subj.loErrs), true, emptyCnt(),
                mt.pemLine)

fun [tail] armCounts(as2: List<PArm>, env, r, subj: LinOut,
                     isFirst, merged, lr) => isEmpty(as2)
  ? LinOut(cntAdd(subj.loCnt, merged), subj.loErrs)
  : oneArmCount(first(as2), env, r, subj.loErrs)
    |> (o) => isFirst
      ? armCounts(tail(as2), env, r, LinOut(subj.loCnt, o.loErrs), false,
                  o.loCnt, lr)
      : cntMerge(merged, o.loCnt, lr, o.loErrs)
        |> (m) => armCounts(tail(as2), env, r, LinOut(subj.loCnt, m.loErrs),
                            false, m.loCnt, lr)

fun oneArmCount(a: PArm, env, r, acc)
  let bound = armBindsLinear(a, r)
  let armEnv = bound ? envPut(env, a.armName, armTypeOf(a)) : env
  let armR = a.armName != "" && a.armName != "_"
    ? bindingScope(a, a.armType, r)
    : r
  let o = linCount(a.armBody, armEnv, armR, acc)
  if !bound
    ret o
  let errs = discharge(a.armName, linLeaves(a.armType, r), o.loCnt.lcCounts,
                       a.parmLine, false, o.loErrs)
  ret LinOut(popObligations(linLeaves(a.armType, r), a.armName,
                            o.loCnt),
             errs)

fun armBindsLinear(a: PArm, r)
  ret a.armName != "" && a.armName != "_" && carriesLinearity(a.armType, r)

fun armTypeOf(a: PArm) => match(a.armType)
  (t2: Spec) => t2
  ()         => STuple(List(), a.parmLine)   # unreachable when bound

fun [tail] popObligations(ls: List<String>, name,
                          c: LinCnt) => isEmpty(ls)
  ? c
  : popObligations(tail(ls), name,
                                    cntDrop(c, oblKey(name, first(ls))))

# ── blocks and statement lists ──────────────────────────────────────────────
# A scope's lets are discharged before returning; statements run in sequence
# until an `if` whose branch early-returns — the continuation folds into the
# falling-through branches and merges, never charged to a returned path.

class [final] ScopeOut(soCnt: LinCnt, soErrs: Set<PErr>,
                       soBindings: List<PStmt>)

fun countBlock(bk: PeBlock, env, r0,
               acc): LinOut => countStmtList(bk.blockStmts, bk.blockValue, env,
                                             blockScope(bk.blockStmts, r0), r0, acc)

fun countStmtList(stmts: List<PStmt>, trailing: PExpr|None, env,
                  r, r0, acc): LinOut
  let out = countSuffix(stmts, 0, env, r, r0, trailing, List(), acc)
  ret dischargeLocals(out.soBindings, r0,
                      LinOut(out.soCnt, out.soErrs))

fun [tail] dischargeLocals(bs: List<PStmt>, r, o: LinOut) => isEmpty(bs)
  ? o
  : match(first(bs))
    (let2: PsLet) => dischargeLocals(tail(bs), r,
        LinOut(popObligations(linLeaves(let2.lType, r), let2.lName,
                              o.loCnt),
               discharge(let2.lName, linLeaves(let2.lType, r),
                         o.loCnt.lcCounts, let2.pslLine, false, o.loErrs)))
    (o2: PStmt)   => dischargeLocals(tail(bs), r, o)

fun blockTerminates(stmts: List<PStmt>) => match(last(stmts))
  (st: PStmt) => match(st)
    (rt: PsRet) => true
    (i: PsIf)   => blockTerminates(i.ifTrue) && blockTerminates(i.ifFalse)
    (o: PStmt)  => false
  ()          => false

fun countSuffix(stmts: List<PStmt>, i, env, r,
                r0, trailing: PExpr|None, bindings,
                acc) => match(nthOf(stmts, i))
  (st: PStmt) => suffixStmt(st, stmts, i, env, r, r0, trailing, bindings,
                            acc)
  ()          => match(trailing)
    (tv: PExpr) => linCount(tv, env, r, acc)
      |> (o) => ScopeOut(o.loCnt, o.loErrs, bindings)
    ()          => ScopeOut(emptyCnt(), acc, bindings)

fun suffixStmt(st, stmts: List<PStmt>, i, env,
               r, r0, trailing: PExpr|None,
               bindings, acc) => match(st)
  (f: PsFun) => suffixFun(f, stmts, i, env, r, r0, trailing, bindings, acc)
  (d: PsDestructure) => suffixDestructure(d, stmts, i, env, r, r0, trailing,
                                          bindings, acc)
  (let2: PsLet) => suffixLet(let2, stmts, i, env, r, r0, trailing, bindings,
                             acc)
  (rt: PsRet) => linCount(rt.retValue, env, r, acc)
    |> (o) => ScopeOut(o.loCnt, o.loErrs, bindings)
  (a: PsAction) => suffixAction(a, stmts, i, env, r, r0, trailing, bindings,
                                acc)
  (i2: PsIf) => suffixIf(i2, stmts, i, env, r, r0, trailing, bindings, acc)
  (c: PsClass) => countSuffix(stmts, i + 1, env, r, r0, trailing, bindings,
                              linToplevel(st, r0, acc))
  (e2: PsEnum) => countSuffix(stmts, i + 1, env, r, r0, trailing, bindings,
                              linToplevel(st, r0, acc))
  (o: PStmt) => countSuffix(stmts, i + 1, env, r, r0, trailing, bindings,
                            acc)

# A nested function is its own scope; it may not capture an enclosing linear
# binding.
fun suffixFun(f: PsFun, stmts: List<PStmt>, i, env, r,
              r0, trailing: PExpr|None, bindings,
              acc): ScopeOut
  let acc2 = match(f.fBody)
    (b: PExpr) => checkCapture(b, env, f.psfLine, r0, acc)
    ()         => acc
  ret countSuffix(stmts, i + 1, env, r, r0, trailing, bindings,
                  linFunction(f, None, r0, acc2))

fun suffixDestructure(d: PsDestructure, stmts: List<PStmt>, i,
                      env, r, r0,
                      trailing: PExpr|None, bindings,
                      acc)
  let o = match(d.dDefault)
    (x: PExpr) => linCount(x, env, r, acc)
    ()         => linZero(acc)
  let grown = growEnv(d.dTargets, r0, env, bindings)
  ret countSuffix(stmts, i + 1, grown.geEnv, r, r0, trailing,
                  grown.geBindings, o.loErrs)
    |> (rest) => ScopeOut(cntAdd(o.loCnt, rest.soCnt), rest.soErrs,
                          rest.soBindings)

class [final] GrownEnv(geEnv: LinEnv, geBindings: List<PStmt>)

fun [tail] growEnv(ts: List<PStmt>, r, env,
                   bindings) => isEmpty(ts)
  ? GrownEnv(env, bindings)
  : match(first(ts))
    (let2: PsLet) => carriesLinearity(let2.lType, r)
      # Bindings keep declaration order: the drops they own are emitted in
      # it at scope exit.
      ? growEnv(tail(ts), r, putEnv(env, let2),
                append(bindings, first(ts)))
      : growEnv(tail(ts), r, env, bindings)
    (o: PStmt)    => growEnv(tail(ts), r, env, bindings)

fun suffixLet(let2, stmts: List<PStmt>, i, env,
              r, r0, trailing: PExpr|None,
              bindings, acc: Set<PErr>)
  let acc2 = lazyLinearErrs(let2, env, r0, acc)
  let o = match(let2.lDefault)
    (x: PExpr) => linCount(x, env, r, acc2)
    ()         => linZero(acc2)
  let isLin = carriesLinearity(let2.lType, r0)
  ret countSuffix(stmts, i + 1, isLin ? putEnv(env, let2) : env, r, r0,
                  trailing,
                  isLin ? append(bindings, narrowLet(let2))
                        : bindings,
                  o.loErrs)
    |> (rest) => ScopeOut(cntAdd(o.loCnt, rest.soCnt), rest.soErrs,
                          rest.soBindings)

fun narrowLet(let2): PStmt => let2

# `[lazy]` may not hold or capture a linear value; `[future]` with a linear
# PAYLOAD is the sound exception (claim protocol), otherwise the same capture
# rule applies.
fun lazyLinearErrs(let2: PsLet, env: LinEnv, r,
                   acc: Set<PErr>)
  let deferred = hasAttr(let2.lAttrs, "lazy") || hasAttr(let2.lAttrs, "future")
  if !deferred
    ret acc
  let payloadLinear = carriesLinearity(let2.lType, r)
  let acc2 = payloadLinear && !hasAttr(let2.lAttrs, "future")
    ? add(acc, PErr(let2.pslLine,
                       "[lazy] let '" + let2.lName + "' may not hold a "
                       + "linear value — the stub memoises across "
                       + "forces, so multiple reads would yield "
                       + "the same linear instance"))
    : acc
  ret match(let2.lDefault)
    (x: PExpr) => hasAttr(let2.lAttrs, "future") && payloadLinear
      ? acc2
      : checkCapture(x, env, let2.pslLine, r, acc2)
    ()         => acc2

# A statement-expression may consume a linear binding; a FRESH linear value
# produced and dropped here leaks.
fun suffixAction(a: PsAction, stmts: List<PStmt>, i, env,
                 r, r0, trailing: PExpr|None,
                 bindings, acc)
  let o = linCount(a.action, env, r, acc)
  let acc2 = exprIsLinear(a.action, r, r0)
    ? add(o.loErrs, PErr(a.psaLine,
                            "linear value is discarded; bind it and consume it"))
    : o.loErrs
  ret countSuffix(stmts, i + 1, env, r, r0, trailing, bindings, acc2)
    |> (rest) => ScopeOut(cntAdd(o.loCnt, rest.soCnt), rest.soErrs,
                          rest.soBindings)

fun exprIsLinear(x, r, r0) => carriesLinearity(exprType(x, r), r0)

# The condition runs unconditionally; the branches are alternative paths; the
# continuation joins only the branches that fall through.
fun suffixIf(i2: PsIf, stmts: List<PStmt>, i, env, r,
             r0, trailing: PExpr|None, bindings,
             acc): ScopeOut
  let cond = linCount(i2.ifCond, env, r, acc)
  let tb = countStmtList(i2.ifTrue, None, env, blockScope(i2.ifTrue, r), r0,
                         cond.loErrs)
  let fb = countStmtList(i2.ifFalse, None, env, blockScope(i2.ifFalse, r), r0,
                         tb.loErrs)
  let cont = countStmtList(drop(stmts, i + 1), trailing, env, r, r0,
                           fb.loErrs)
  let tPath = blockTerminates(i2.ifTrue) ? tb.loCnt
                                         : cntAdd(tb.loCnt, cont.loCnt)
  let fPath = blockTerminates(i2.ifFalse) ? fb.loCnt
                                          : cntAdd(fb.loCnt, cont.loCnt)
  let merged = cntMerge(tPath, fPath, i2.psifLine, cont.loErrs)
  ret ScopeOut(cntAdd(cond.loCnt, merged.loCnt), merged.loErrs, bindings)

# ── paths, lambdas, captures ────────────────────────────────────────────────

# A path-expr moves every leaf that has the path as a prefix; a path running
# past a leaf into a non-linear field moves nothing.
fun countPath(x, env: LinEnv, r) => match(resolvePathRoot(x, List()))
  (rp: RootPath) => envHas(env, rp.rpRoot)
    ? pathCounts(linLeaves(envType(env, rp.rpRoot), r), rp,
                 emptyCnt())
    : emptyCnt()
  ()             => emptyCnt()

class [final] RootPath(rpRoot: String, rpPath: String)

fun [tail] resolvePathRoot(x, fields) => match(x)
  (d: PeDot)   => resolvePathRoot(d.base, prepend(d.member, fields))
  (nm: PeName) => RootPath(nm.refName, join(fields, "/"))
  (o: PExpr)   => None

fun [tail] pathCounts(ls: List<String>, rp: RootPath, c) => isEmpty(ls)
  ? c
  : isPathPrefix(rp.rpPath, first(ls))
    ? pathCounts(tail(ls), rp, cntBump(c, oblKey(rp.rpRoot, first(ls)), 1))
    : pathCounts(tail(ls), rp, c)

fun isPathPrefix(prefix, full) => prefix == "" || prefix == full || startsWith(full, prefix + "/")

# A lambda contributes NOTHING to the enclosing count: it may run zero or
# many times, so it may not capture an enclosing linear binding, and its own
# linear params are its own scope's obligations.
fun countLambda(lm: PeLambda, env: LinEnv, r,
                acc): LinOut
  let acc2 = checkCapture(lm.lamBody, env, lm.pelLine, r, acc)
  ret linZero(checkLambdaScope(lm, r, acc2))

fun checkLambdaScope(lm: PeLambda, r, acc)
  let params = flattenParams(lm.lamParams)
  let env = paramEnv(params, r, emptyEnv())
  ret analyzeScope(lm.lamBody, env, lm.pelLine,
                   localScope(params, r), r, acc)

fun countParallel(pl: PeParallel, env, r,
                  acc): LinOut
  let acc2 = checkCapture(pl.parParams, env, pl.pepLine, r, acc)
  let o = linCount(pl.parParams, env, r, acc2)
  ret linZero(o.loErrs)

# A blind name scan — sound because bindings carry path-unique names.
fun checkCapture(b, env: LinEnv, lr, r: Resolver,
                 acc): Set<PErr> => captureErrs(sort(capturedIn(b, env)), lr, acc)

fun capturedIn(b, env: LinEnv): List<String> => capturedLoop(referencedNames(b, List()), env,
                                                             List())

fun [tail] capturedLoop(ns: List<String>, env: LinEnv,
                        acc: List<String>) => isEmpty(ns)
  ? acc
  : envHas(env, first(ns))
    ? capturedLoop(tail(ns), env, addNameOnce(acc, first(ns)))
    : capturedLoop(tail(ns), env, acc)


fun [tail] captureErrs(ns: List<String>, lr,
                       acc: Set<PErr>) => isEmpty(ns)
  ? acc
  : captureErrs(tail(ns), lr,
      add(acc, PErr(lr, "linear value '" + first(ns)
                           + "' captured by a nested function or lambda")))

# ── generic instantiation kind check ────────────────────────────────────────
# A linear type argument may only bind a [linear] type parameter.

fun checkInstantiations(statements: List<PStmt>, r,
                        acc): Set<PErr> => instStmts(statements, r, acc)

fun [tail] instStmts(ss: List<PStmt>, r,
                     acc: Set<PErr>) => isEmpty(ss)
  ? acc
  : instStmts(tail(ss), r, instStmt(first(ss), r, acc))

fun instStmt(st, r, acc): Set<PErr> => match(st)
  (f: PsFun)         => instExprOpt(f.fBody, r,
                          instSpecsIn(f.fWheres, r,
                            instSpecOpt(f.fRet, r, instStmt(f.fParams, r,
                                                            acc))))
  (l: PsLet)         => instExprOpt(l.lDefault, r,
                                    instSpecOpt(l.lType, r, acc))
  (d: PsDestructure) => instStmts(d.dTargets, r,
                          instExprOpt(d.dDefault, r,
                                      instSpecOpt(d.dType, r, acc)))
  (c: PsClass)       => instStmts(c.cMembers, r,
                          instSpecsIn(c.cImplements, r,
                                      instStmt(c.cParams, r, acc)))
  (e2: PsEnum)       => instStmts(e2.eVariants, r,
                                  instStmt(e2.eParams, r, acc))
  (ta: PsTypealias)  => instSpecOpt(ta.taType, r, acc)
  (rt: PsRet)        => instExpr(rt.retValue, r, acc)
  (a: PsAction)      => instExpr(a.action, r, acc)
  (i: PsIf)          => instStmts(i.ifFalse, r,
                          instStmts(i.ifTrue, r,
                                    instExpr(i.ifCond, r, acc)))
  (o: PStmt)         => acc

fun instExpr(x, r, acc): Set<PErr> => match(x)
  (nm: PeName)   => isEmpty(nm.refTypeParams)
    ? acc
    : instCheck(nm.refName, nm.refTypeParams, nm.penLine, false, r, acc)
  (d: PeDot)     => instExpr(d.base, r, acc)
  (c: PeCall)    => instExpr(c.parameter, r, instExpr(c.function, r, acc))
  (tp: PeTuple)  => instEntries(tp.exprs, r, acc)
  (te: PeTernary) => instExpr(te.falseResult, r,
                      instExpr(te.trueResult, r,
                               instExpr(te.condition, r, acc)))
  (lm: PeLambda) => instExpr(lm.lamBody, r, instStmt(lm.lamParams, r, acc))
  (bk: PeBlock)  => instExpr(bk.blockValue, r,
                             instStmts(bk.blockStmts, r, acc))
  (mt: PeMatch)  => instArms(mt.arms, r, instExpr(mt.subject, r, acc))
  (op: PeBuiltinOp) => instExpr(op.opParams, r, acc)
  (nw: PeNew)    => instExpr(nw.newParam, r, instSpecOpt(nw.newType, r, acc))
  (qq: PeCoalesce) => instExpr(qq.qqFallback, r, instExpr(qq.qqSubject, r, acc))
  (ar: PeArrayRead) => instExpr(ar.arrIndex, r, instExpr(ar.arrObj, r, acc))
  (cv: PeConvert) => instExpr(cv.convInner, r,
                              instSpecOpt(cv.convTarget, r, acc))
  (wx: PeWith)   => instExpr(wx.withRepls, r,
                             instExpr(wx.withSubject, r, acc))
  (pl: PeParallel) => instExpr(pl.parParams, r, acc)
  (o: PeLiteral) => acc
  (o: PeLowered) => acc
  (o: PeNewEnum) => acc

fun [tail] instEntries(es: List<PTupEnt>, r,
                       acc): Set<PErr> => isEmpty(es)
  ? acc
  : instEntries(tail(es), r,
                                 instExpr(first(es).tupValue, r, acc))

fun [tail] instArms(as2: List<PArm>, r,
                    acc): Set<PErr> => isEmpty(as2)
  ? acc
  : instArms(tail(as2), r,
                      instExprOpt(first(as2).armGuard, r,
                        instExpr(first(as2).armBody, r,
                                 instSpecOpt(first(as2).armType, r, acc))))

fun instExprOpt(x: PExpr|None, r, acc): Set<PErr> => match(x)
  (e2: PExpr) => instExpr(e2, r, acc)
  ()          => acc

fun instSpecOpt(sp: Spec|None, r, acc): Set<PErr> => match(sp)
  (s2: Spec) => instSpec(s2, r, acc)
  ()         => acc

fun instSpec(sp, r, acc): Set<PErr> => match(sp)
  (c: SClass) => instSpecsIn(c.scParams, r,
                             isEmpty(c.scParams)
                               ? acc
                               : instCheck(c.scName, c.scParams, c.scLine,
                                           true, r, acc))
  (e2: SEnum) => instSpecsIn(e2.seParams, r,
                             isEmpty(e2.seParams)
                               ? acc
                               : instCheck(e2.seRoot, e2.seParams,
                                           e2.seLine, true, r, acc))
  (cm: SCombination) => instSpecsIn(cm.scTypes, r, acc)
  (t2: STuple)       => instSpecEntries(t2.stEntries, r, acc)
  (cl: SCallable)    => instSpecOpt(cl.scResult, r,
                                    instSpec(cl.scParams2, r, acc))
  (o: Spec)          => acc

fun [tail] instSpecsIn(ss: List<Spec>, r,
                       acc: Set<PErr>) => isEmpty(ss)
  ? acc
  : instSpecsIn(tail(ss), r, instSpec(first(ss), r, acc))

fun [tail] instSpecEntries(es: List<SEntry>, r,
                           acc): Set<PErr> => isEmpty(es)
  ? acc
  : instSpecEntries(tail(es), r,
                                     instSpecOpt(first(es).seType, r, acc))

fun instCheck(name, args: List<Spec>, lr, isType,
              r, acc): Set<PErr>
  let found = isType ? findType(r, name) : findData(r, name)
  ret match(soleItem(found))
    (f: Found) => instArgs(stmtGens(f.fStmt), args, lr, r, acc)
    ()         => acc

fun [tail] instArgs(gs: List<PGen>, as2: List<Spec>, lr, r,
                    acc: Set<PErr>) => isEmpty(gs)
  ? acc
  : isEmpty(as2)
    ? acc
    : instArgs(tail(gs), tail(as2), lr, r,
        carriesLinearity(first(as2), r) && !hasAttr(first(gs).genAttrs, "linear")
          ? add(acc, PErr(lr,
              "linear type cannot be passed to an unrestricted type parameter"))
          : acc)
