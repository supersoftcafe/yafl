# bootstrap/linearity.yafl — linear-type checking, ported from
# lowering/linearity.py: every linear value is consumed exactly once on every
# execution path. Sound, intentionally incomplete — the conservative
# rejections are the same ones, with the same messages.
#
# An OBLIGATION is (root binding, field path to a linear leaf) — keyed here as
# "root" or "root/f1/f2". The counter mirrors Python's Counter semantics:
# addition keeps positive counts; a merge compares counts per obligation and
# reports per-branch inconsistency.
namespace Bootstrap::Lower::Ast

import System

import Bootstrap::Ast
import Bootstrap::Frontend
import Bootstrap::Parse
import Bootstrap::Resolve
import Bootstrap::Types



# The counter carries its key list (Dict has no key enumeration): addition
# unions keys and keeps POSITIVE sums only — Python Counter semantics.
class [final] LinCnt(lcKeys: List<String>, lcCounts: Dict<String, Int>)
class [final] LinOut(loCnt: LinCnt, loErrs: List<PErr>)
# The env likewise: binding names (insertion order — discharge order matches
# Python's dict iteration) plus their types.
class [final] LinEnv(leNames: List<String>, leTypes: Dict<String, Spec>)

fun emptyCnt(): LinCnt
  ret LinCnt(List<String>(), Dict<String, Int>())

fun linZero(errs: List<PErr>): LinOut
  ret LinOut(emptyCnt(), errs)

fun emptyEnv(): LinEnv
  ret LinEnv(List<String>(), Dict<String, Spec>())

fun envPut(env: LinEnv, name: String, ty: Spec): LinEnv
  ret LinEnv(contains2(env.leNames, name) ? env.leNames
                                          : append(env.leNames, name),
             put(env.leTypes, name, ty))

fun envType(env: LinEnv, name: String): Spec|None
  ret get(env.leTypes, name)

fun envHas(env: LinEnv, name: String): Bool
  ret contains(env.leTypes, name)

fun cntAdd(a: LinCnt, b: LinCnt): LinCnt
  ret addKeys2(chain(b.lcKeys), b.lcCounts, a)

fun [tail] addKeys2(ks: Chain<String>, bc: Dict<String, Int>,
                    acc: LinCnt): LinCnt
  ret match(ks)
    (nil: ChainEnd) => acc
    (l: ChainLink)  => addKeys2(l.next, bc,
                                cntBump(acc, l.value,
                                        countOf(bc, l.value)))

fun cntBump(c: LinCnt, key: String, by: Int): LinCnt
  let now = countOf(c.lcCounts, key) + by
  ret now <= 0
    ? c
    : LinCnt(contains2(c.lcKeys, key) ? c.lcKeys : append(c.lcKeys, key),
             put(c.lcCounts, key, now))

fun cntDrop(c: LinCnt, key: String): LinCnt
  ret LinCnt(dropName(chain(c.lcKeys), key, List<String>()),
             remove(c.lcCounts, key))

fun [tail] dropName(ks: Chain<String>, key: String,
                    acc: List<String>): List<String>
  ret match(ks)
    (nil: ChainEnd) => acc
    (l: ChainLink)  => l.value == key
      ? dropName(l.next, key, acc)
      : dropName(l.next, key, append(acc, l.value))

# Per-branch merge: counts must AGREE per obligation; result is c1 unless
# empty (Python: `c1 if c1 else c2`).
fun cntMerge(c1: LinCnt, c2: LinCnt, lr: PLine, acc: List<PErr>): LinOut
  let errs = mergeErrs(chain(addNamesOnce(c1.lcKeys, chain(c2.lcKeys))),
                       c1, c2, lr, acc)
  ret LinOut(isEmpty(c1.lcKeys) ? c2 : c1, errs)

fun [tail] mergeErrs(ks: Chain<String>, c1: LinCnt, c2: LinCnt, lr: PLine,
                     acc: List<PErr>): List<PErr>
  ret match(ks)
    (nil: ChainEnd) => acc
    (l: ChainLink)  => countOf(c1.lcCounts, l.value)
                       == countOf(c2.lcCounts, l.value)
      ? mergeErrs(l.next, c1, c2, lr, acc)
      : mergeErrs(l.next, c1, c2, lr,
                  append(acc, PErr(lr, "linear value '" + rootOf(l.value)
                                       + "' is used inconsistently across branches")))

fun rootOf(key: String): String
  let ix = findByte(key, '/', 0)
  ret ix < 0 ? key : slice(key, 0, ix)

# ── entry point ─────────────────────────────────────────────────────────────

fun checkLinearity(statements: List<PStmt>, r: Resolver): List<PErr>
  ret checkInstantiations(statements, r,
                          linToplevels(chain(statements), r, noErrs()))

fun [tail] linToplevels(ss: Chain<PStmt>, r: Resolver,
                        acc: List<PErr>): List<PErr>
  ret match(ss)
    (nil: ChainEnd) => acc
    (l: ChainLink)  => linToplevels(l.next, r, linToplevel(l.value, r, acc))

fun [tail] linInstMembers(ms: Chain<PStmt>, r: Resolver,
                          acc: List<PErr>): List<PErr>
  ret match(ms)
    (nil: ChainEnd) => acc
    (l: ChainLink)  => match(l.value)
      (f: PsFun) => linInstMembers(l.next, r, linFunction(f, None, r, acc))
      (o: PStmt) => linInstMembers(l.next, r, acc)

fun linToplevel(st: PStmt, r: Resolver, acc: List<PErr>): List<PErr>
  ret match(st)
    (f: PsFun)   => linFunction(f, None, r, acc)
    (c: PsClass) => linClass(c, r, acc)
    # A first-class instance's members are ordinary functions.
    (ti: PsTraitInstance) => linInstMembers(chain(ti.tiMembers), r, acc)
    (e2: PsEnum) => linEnum(e2, r, acc)
    (l: PsLet)   => carriesLinearity(l.lType, r)
      ? append(acc, PErr(l.pslLine, "linear value not allowed in a global let"))
      : acc
    (o: PStmt)   => acc

# ── linearity of types ──────────────────────────────────────────────────────
# leaves(spec): the field paths from a value to its linear leaves. "" is the
# whole-value leaf.

fun linLeaves(sp: Spec|None, r: Resolver): List<String>
  ret match(sp)
    (s2: Spec) => leavesOf(s2, r, List<String>())
    ()         => List<String>()

fun leavesOf(sp: Spec, r: Resolver, seen: List<String>): List<String>
  ret match(sp)
    (g2: SGeneric)     => g2.sgLinear
      ? append(List<String>(), "")
      : List<String>()
    (c: SClass)        => classLeaves(c, r, seen)
    (t2: STuple)       => tupleLeaves(chain(t2.stEntries), r, seen,
                                      List<String>())
    (cm: SCombination) => anyMemberLinear(chain(cm.scTypes), r, seen)
      ? append(List<String>(), "")
      : List<String>()
    (o: Spec)          => List<String>()

fun classLeaves(c: SClass, r: Resolver, seen: List<String>): List<String>
  if !isLinearClassSpec(c, r)
    ret List<String>()
  if contains2(seen, c.scName)
    ret append(List<String>(), "")          # recursive linear type: one leaf
  ret match(soleItem(findType(r, c.scName)))
    (f: Found) => match(f.fStmt)
      (cs: PsClass) => classFieldLeaves(cs, c, r, append(seen, c.scName))
      (o: PStmt)    => append(List<String>(), "")
    ()         => append(List<String>(), "")

fun classFieldLeaves(cs: PsClass, c: SClass, r: Resolver,
                     seen: List<String>): List<String>
  let mapping = paramMapping(cs.cGens, c.scParams)
  let out = fieldLeaves(chain(classFields(cs)), mapping, r, seen,
                        List<String>())
  # A linear class with no linear fields is itself the leaf.
  ret isEmpty(out) ? append(List<String>(), "") : out

fun [tail] fieldLeaves(fs: Chain<PStmt>, mapping: List<Binding>, r: Resolver,
                       seen: List<String>, acc: List<String>): List<String>
  ret match(fs)
    (nil: ChainEnd) => acc
    (l: ChainLink)  => match(l.value)
      (let2: PsLet) => match(let2.lType)
        (ft: Spec) => fieldLeaves(l.next, mapping, r, seen,
                                  prefixLeaves(let2.lName,
                                               leavesOf(substitute(ft, mapping),
                                                        r, seen),
                                               acc))
        ()         => fieldLeaves(l.next, mapping, r, seen, acc)
      (o: PStmt)    => fieldLeaves(l.next, mapping, r, seen, acc)

fun [tail] tupleLeaves(es: Chain<SEntry>, r: Resolver, seen: List<String>,
                       acc: List<String>): List<String>
  ret match(es)
    (nil: ChainEnd) => acc
    (l: ChainLink)  => l.value.seName == ""
      ? tupleLeaves(l.next, r, seen, acc)
      : match(l.value.seType)
        (ty: Spec) => tupleLeaves(l.next, r, seen,
                                  prefixLeaves(l.value.seName,
                                               leavesOf(ty, r, seen), acc))
        ()         => tupleLeaves(l.next, r, seen, acc)

fun prefixLeaves(name: String, subs: List<String>,
                 acc: List<String>): List<String>
  ret leafPrefixLoop(chain(subs), name, acc)

fun [tail] leafPrefixLoop(ss: Chain<String>, name: String,
                      acc: List<String>): List<String>
  ret match(ss)
    (nil: ChainEnd) => acc
    (l: ChainLink)  => leafPrefixLoop(l.next, name,
                                  addNameOnce(acc,
                                              l.value == ""
                                                ? name
                                                : name + "/" + l.value))

fun [tail] anyMemberLinear(ms: Chain<Spec>, r: Resolver,
                           seen: List<String>): Bool
  ret match(ms)
    (nil: ChainEnd) => false
    (l: ChainLink)  => isEmpty(leavesOf(l.value, r, seen))
      ? anyMemberLinear(l.next, r, seen)
      : true

fun carriesLinearity(sp: Spec|None, r: Resolver): Bool
  ret !isEmpty(linLeaves(sp, r))

fun isLinearClassSpec(c: SClass, r: Resolver): Bool
  ret match(soleItem(findType(r, c.scName)))
    (f: Found) => match(f.fStmt)
      (cs: PsClass) => hasAttr(cs.cAttrs, "linear")
      (o: PStmt)    => false
    ()         => false

# ── structural (conservative) rejections ────────────────────────────────────
# Linear types may not appear where the flow analysis cannot trace them: as a
# generic argument of a NON-linear class. Inside a union is allowed.

fun checkTypePosition(sp: Spec|None, lr: PLine, r: Resolver,
                      acc: List<PErr>): List<PErr>
  ret match(sp)
    (s2: Spec) => typePosition(s2, lr, r, acc)
    ()         => acc

fun typePosition(sp: Spec, lr: PLine, r: Resolver,
                 acc: List<PErr>): List<PErr>
  ret match(sp)
    (cm: SCombination) => positionList(chain(cm.scTypes), lr, r, acc)
    (c: SClass)        => isLinearClassSpec(c, r)
      ? acc
      : classArgPositions(chain(c.scParams), lr, r, acc)
    (t2: STuple)       => entryPositions(chain(t2.stEntries), lr, r, acc)
    (cl: SCallable)    => checkTypePosition(cl.scResult, lr, r,
                                            typePosition(cl.scParams2, lr, r,
                                                         acc))
    (o: Spec)          => acc

fun [tail] positionList(ms: Chain<Spec>, lr: PLine, r: Resolver,
                        acc: List<PErr>): List<PErr>
  ret match(ms)
    (nil: ChainEnd) => acc
    (l: ChainLink)  => positionList(l.next, lr, r,
                                    typePosition(l.value, lr, r, acc))

fun [tail] classArgPositions(as2: Chain<Spec>, lr: PLine, r: Resolver,
                             acc: List<PErr>): List<PErr>
  ret match(as2)
    (nil: ChainEnd) => acc
    (l: ChainLink)  => classArgPositions(l.next, lr, r,
        typePosition(l.value, lr, r,
                     carriesLinearity(l.value, r)
                       ? append(acc, PErr(lr,
                           "linear type not allowed as a generic type argument"))
                       : acc))

fun [tail] entryPositions(es: Chain<SEntry>, lr: PLine, r: Resolver,
                          acc: List<PErr>): List<PErr>
  ret match(es)
    (nil: ChainEnd) => acc
    (l: ChainLink)  => entryPositions(l.next, lr, r,
                                      checkTypePosition(l.value.seType, lr, r,
                                                        acc))

# ── declarations ────────────────────────────────────────────────────────────

fun linEnum(e2: PsEnum, r: Resolver, acc: List<PErr>): List<PErr>
  ret enumFieldLin(chain(collectDataFields(e2)), e2.pseLine, r, acc)

fun [tail] enumFieldLin(fs: Chain<SField>, lr: PLine, r: Resolver,
                        acc: List<PErr>): List<PErr>
  ret match(fs)
    (nil: ChainEnd) => acc
    (l: ChainLink)  => enumFieldLin(l.next, lr, r,
        checkTypePosition(l.value.sfType, lr, r,
                          carriesLinearity(l.value.sfType, r)
                            ? append(acc, PErr(lr,
                                "a linear value may not be stored in an enum"))
                            : acc))

fun linClass(c: PsClass, r: Resolver, acc: List<PErr>): List<PErr>
  let isLin = hasAttr(c.cAttrs, "linear")
  let acc2 = classFieldLin(chain(classFields(c)), c, isLin, r, acc)
  let thisTy = isLin ? classThis(c) : None
  ret classMethodLin(chain(c.cMembers), thisTy, r, acc2)

fun classThis(c: PsClass): Spec|None
  ret thisType(c)

fun [tail] classFieldLin(fs: Chain<PStmt>, c: PsClass, isLin: Bool,
                         r: Resolver, acc: List<PErr>): List<PErr>
  ret match(fs)
    (nil: ChainEnd) => acc
    (l: ChainLink)  => match(l.value)
      (let2: PsLet) => classFieldLin(l.next, c, isLin, r,
          checkTypePosition(let2.lType, let2.pslLine, r,
                            !isLin && carriesLinearity(let2.lType, r)
                              ? append(acc, PErr(c.pscLine,
                                  "a class with a linear field must be declared [linear]"))
                              : acc))
      (o: PStmt)    => classFieldLin(l.next, c, isLin, r, acc)

fun [tail] classMethodLin(ms: Chain<PStmt>, thisTy: Spec|None, r: Resolver,
                          acc: List<PErr>): List<PErr>
  ret match(ms)
    (nil: ChainEnd) => acc
    (l: ChainLink)  => match(l.value)
      (f: PsFun) => classMethodLin(l.next, thisTy, r,
                                   linFunction(f, thisTy, r, acc))
      (o: PStmt) => classMethodLin(l.next, thisTy, r, acc)

# ── functions ───────────────────────────────────────────────────────────────

fun linFunction(f: PsFun, thisTy: Spec|None, r0: Resolver,
                acc: List<PErr>): List<PErr>
  let params = flattenParams(f.fParams)
  let acc2 = checkTypePosition(f.fRet, f.psfLine, r0,
                               paramPositions(chain(params), r0, acc))
  if hasAttr(f.fAttrs, "foreign")
    ret anyLinearSignature(chain(params), f.fRet, r0)
      ? append(acc2, PErr(f.psfLine,
                          "[foreign] functions may not name a linear type"))
      : acc2
  ret match(f.fBody)
    (b: PExpr) => linBody(f, b, params, thisTy, r0, acc2)
    ()         => acc2

fun [tail] paramPositions(ps: Chain<PStmt>, r: Resolver,
                          acc: List<PErr>): List<PErr>
  ret match(ps)
    (nil: ChainEnd) => acc
    (l: ChainLink)  => match(l.value)
      (let2: PsLet) => paramPositions(l.next, r,
                                      checkTypePosition(let2.lType,
                                                        let2.pslLine, r, acc))
      (o: PStmt)    => paramPositions(l.next, r, acc)

fun [tail] anyLinearSignature(ps: Chain<PStmt>, retTy: Spec|None,
                              r: Resolver): Bool
  ret match(ps)
    (nil: ChainEnd) => carriesLinearity(retTy, r)
    (l: ChainLink)  => match(l.value)
      (let2: PsLet) => carriesLinearity(let2.lType, r)
        ? true
        : anyLinearSignature(l.next, retTy, r)
      (o: PStmt)    => anyLinearSignature(l.next, retTy, r)

# env: {binding → type} for every linear obligation in scope. `[terminal]` on
# the method opts out `this`; on a parameter, that parameter.
fun linBody(f: PsFun, b: PExpr, params: List<PStmt>, thisTy: Spec|None,
            r0: Resolver, acc: List<PErr>): List<PErr>
  let env0 = match(thisTy)
    (tt: Spec) => hasAttr(f.fAttrs, "terminal")
      ? emptyEnv()
      : envPut(emptyEnv(), "this", tt)
    ()         => emptyEnv()
  let env = paramEnv(chain(params), r0, env0)
  let bodyR = localScope(params, genScope(f.fGens, r0))
  ret analyzeScope(b, env, f.psfLine, bodyR, r0, acc)

fun [tail] paramEnv(ps: Chain<PStmt>, r: Resolver, env: LinEnv): LinEnv
  ret match(ps)
    (nil: ChainEnd) => env
    (l: ChainLink)  => match(l.value)
      (let2: PsLet) => linearParam(let2, r)
        ? paramEnv(l.next, r, putEnv(env, let2))
        : paramEnv(l.next, r, env)
      (o: PStmt)    => paramEnv(l.next, r, env)

fun putEnv(env: LinEnv, let2: PsLet): LinEnv
  ret match(let2.lType)
    (ty: Spec) => envPut(env, let2.lName, ty)
    ()         => env

fun linearParam(let2: PsLet, r: Resolver): Bool
  ret carriesLinearity(let2.lType, r) && !hasAttr(let2.lAttrs, "terminal")

# Check a function/lambda body: every linear binding discharged once.
fun analyzeScope(b: PExpr, env: LinEnv, lr: PLine,
                 bodyR: Resolver, r: Resolver, acc: List<PErr>): List<PErr>
  let out = linCount(b, env, bodyR, acc)
  ret dischargeEnv(chain(env.leNames), env, out.loCnt.lcCounts, lr, r, true,
                   out.loErrs)

fun [tail] dischargeEnv(ns: Chain<String>, env: LinEnv,
                        counts: Dict<String, Int>, lr: PLine, r: Resolver,
                        isParam: Bool, acc: List<PErr>): List<PErr>
  ret match(ns)
    (nil: ChainEnd) => acc
    (l: ChainLink)  => dischargeEnv(l.next, env, counts, lr, r, isParam,
        discharge(l.value, linLeaves(envType(env, l.value), r), counts, lr,
                  isParam, acc))

# Each obligation consumed exactly once. `isParam` adds the [terminal] hint.
fun discharge(name: String, leaves: List<String>, counts: Dict<String, Int>,
              lr: PLine, isParam: Bool, acc: List<PErr>): List<PErr>
  ret dischargeLoop(chain(leaves), name, counts, lr, isParam, acc)

fun [tail] dischargeLoop(ls: Chain<String>, name: String,
                         counts: Dict<String, Int>, lr: PLine, isParam: Bool,
                         acc: List<PErr>): List<PErr>
  ret match(ls)
    (nil: ChainEnd) => acc
    (l: ChainLink)  => dischargeLoop(l.next, name, counts, lr, isParam,
                                     dischargeOne2(oblKey(name, l.value),
                                                   name, counts, lr, isParam,
                                                   acc))

fun dischargeOne2(key: String, name: String, counts: Dict<String, Int>,
                  lr: PLine, isParam: Bool, acc: List<PErr>): List<PErr>
  let n = countOf(counts, key)
  if n > 1
    ret append(acc, PErr(lr, "linear value '" + name + "' is used "
                             + String(n) + " times; must be used once"))
  if n == 0
    ret append(acc, PErr(lr, "linear value '" + name
                             + "' is never used; it must be consumed once"
                             + (isParam
                                ? " (mark the parameter [terminal] if this is its terminus)"
                                : "")))
  ret acc

fun oblKey(name: String, leaf: String): String
  ret leaf == "" ? name : name + "/" + leaf

fun countOf(counts: Dict<String, Int>, key: String): Int
  ret match(get(counts, key))
    (n: Int) => n
    ()       => 0



# ── the count flow analysis ─────────────────────────────────────────────────
# Per-execution-path consumption of the env's obligations by an expression.

fun [tail] linCount(x: PExpr, env: LinEnv, r: Resolver, acc: List<PErr>): LinOut
  ret match(x)
    (nm: PeName)   => LinOut(countPath(x, env, r), acc)
    (d: PeDot)     => LinOut(countPath(x, env, r), acc)
    (c: PeCall)    => countCall(c, env, r, acc)
    (tp: PeTuple)  => countEntries(chain(tp.exprs), env, r, linZero(acc))
    (nw: PeNew)    => linCount(nw.newParam, env, r, acc)
    (ar: PeArrayRead) => linPair(ar.arrObj, ar.arrIndex, env, r, acc)
    (ne: PeNewEnum) => linFieldArgs(chain(ne.fieldArgs), env, r, acc)
    (op: PeBuiltinOp) => linCount(op.opParams, env, r, acc)
    (cv: PeConvert) => linCount(cv.convInner, env, r, acc)
    (te: PeTernary) => countTernary(te, env, r, acc)
    (mt: PeMatch)  => countMatch(mt, env, r, acc)
    (bk: PeBlock)  => countBlock(bk, env, r, acc)
    (lm: PeLambda) => countLambda(lm, env, r, acc)
    (pl: PeParallel) => countParallel(pl, env, r, acc)
    (o: PExpr)     => linZero(acc)       # literals carry no linear value

# A method call `recv.method(args)` passes `recv` as `this`: count the
# RECEIVER itself (counting the method-access dot would read as a borrow).
fun countCall(c: PeCall, env: LinEnv, r: Resolver, acc: List<PErr>): LinOut
  ret match(c.function)
    (d: PeDot) => linPair(d.base, c.parameter, env, r, acc)
    (o: PExpr) => linPair(c.function, c.parameter, env, r, acc)

fun linPair(a: PExpr, b: PExpr, env: LinEnv, r: Resolver,
            acc: List<PErr>): LinOut
  let o1 = linCount(a, env, r, acc)
  let o2 = linCount(b, env, r, o1.loErrs)
  ret LinOut(cntAdd(o1.loCnt, o2.loCnt), o2.loErrs)

# Field-arg value expressions count like any other reads (Python counts the
# NamedExpressions inside field_args). Not [tail]: the counts sum on the way
# back up; fieldArgs lists are tiny.
fun linFieldArgs(fas: Chain<PFieldArg>, env: LinEnv, r: Resolver,
                 acc: List<PErr>): LinOut
  ret match(fas)
    (nil: ChainEnd) => linZero(acc)
    (l: ChainLink)  => linFaStep(l, env, r, acc)

fun linFaStep(l: ChainLink<PFieldArg>, env: LinEnv, r: Resolver,
              acc: List<PErr>): LinOut
  let o1 = linCount(l.value.faValue, env, r, acc)
  let o2 = linFieldArgs(l.next, env, r, o1.loErrs)
  ret LinOut(cntAdd(o1.loCnt, o2.loCnt), o2.loErrs)

fun [tail] countEntries(es: Chain<PTupEnt>, env: LinEnv, r: Resolver,
                        acc: LinOut): LinOut
  ret match(es)
    (nil: ChainEnd) => acc
    (l: ChainLink)  => linCount(l.value.tupValue, env, r, acc.loErrs)
      |> (o) => countEntries(l.next, env, r,
                             LinOut(cntAdd(acc.loCnt, o.loCnt), o.loErrs))

fun countTernary(te: PeTernary, env: LinEnv, r: Resolver,
                 acc: List<PErr>): LinOut
  let cond = linCount(te.condition, env, r, acc)
  let tb = linCount(te.trueResult, env, r, cond.loErrs)
  let fb = linCount(te.falseResult, env, r, tb.loErrs)
  let merged = cntMerge(tb.loCnt, fb.loCnt, te.pety, fb.loErrs)
  ret LinOut(cntAdd(cond.loCnt, merged.loCnt), merged.loErrs)

# Match: subject + per-arm counts. An arm binder with a LINEAR type joins the
# env for its body, is discharged per arm, then popped so it doesn't leak
# into the merge; arm counts pairwise-merge.
fun countMatch(mt: PeMatch, env: LinEnv, r: Resolver,
               acc: List<PErr>): LinOut
  let subj = linCount(mt.subject, env, r, acc)
  ret armCounts(chain(mt.arms), env, r,
                LinOut(subj.loCnt, subj.loErrs), true, emptyCnt(),
                mt.pemLine)

fun [tail] armCounts(as2: Chain<PArm>, env: LinEnv, r: Resolver, subj: LinOut,
                     first: Bool, merged: LinCnt, lr: PLine): LinOut
  ret match(as2)
    (nil: ChainEnd) => LinOut(cntAdd(subj.loCnt, merged), subj.loErrs)
    (l: ChainLink)  => oneArmCount(l.value, env, r, subj.loErrs)
      |> (o) => first
        ? armCounts(l.next, env, r, LinOut(subj.loCnt, o.loErrs), false,
                    o.loCnt, lr)
        : cntMerge(merged, o.loCnt, lr, o.loErrs)
          |> (m) => armCounts(l.next, env, r, LinOut(subj.loCnt, m.loErrs),
                              false, m.loCnt, lr)

fun oneArmCount(a: PArm, env: LinEnv, r: Resolver, acc: List<PErr>): LinOut
  let bound = armBindsLinear(a, r)
  let armEnv = bound ? envPut(env, a.armName, armTypeOf(a)) : env
  let armR = a.armName != "" && a.armName != "_"
    ? bindingScope(a, a.armType, r)
    : r
  let o = linCount(a.armBody, armEnv, armR, acc)
  if !bound
    ret o
  let errs = discharge(a.armName, linLeaves(a.armType, r), o.loCnt.lcCounts,
                       a.parmLine, false, o.loErrs)
  ret LinOut(popObligations(chain(linLeaves(a.armType, r)), a.armName,
                            o.loCnt),
             errs)

fun armBindsLinear(a: PArm, r: Resolver): Bool
  ret a.armName != "" && a.armName != "_" && carriesLinearity(a.armType, r)

fun armTypeOf(a: PArm): Spec
  ret match(a.armType)
    (t2: Spec) => t2
    ()         => STuple(List<SEntry>(), a.parmLine)   # unreachable when bound

fun [tail] popObligations(ls: Chain<String>, name: String,
                          c: LinCnt): LinCnt
  ret match(ls)
    (nil: ChainEnd) => c
    (l: ChainLink)  => popObligations(l.next, name,
                                      cntDrop(c, oblKey(name, l.value)))

# ── blocks and statement lists ──────────────────────────────────────────────
# A scope's lets are discharged before returning; statements run in sequence
# until an `if` whose branch early-returns — the continuation folds into the
# falling-through branches and merges, never charged to a returned path.

class [final] ScopeOut(soCnt: LinCnt, soErrs: List<PErr>,
                       soBindings: List<PStmt>)

fun countBlock(bk: PeBlock, env: LinEnv, r0: Resolver,
               acc: List<PErr>): LinOut
  ret countStmtList(bk.blockStmts, bk.blockValue, env,
                    blockScope(bk.blockStmts, r0), r0, acc)

fun countStmtList(stmts: List<PStmt>, trailing: PExpr|None, env: LinEnv,
                  r: Resolver, r0: Resolver, acc: List<PErr>): LinOut
  let out = countSuffix(stmts, 0, env, r, r0, trailing, List<PStmt>(), acc)
  ret dischargeLocals(chain(out.soBindings), r0,
                      LinOut(out.soCnt, out.soErrs))

fun [tail] dischargeLocals(bs: Chain<PStmt>, r: Resolver, o: LinOut): LinOut
  ret match(bs)
    (nil: ChainEnd) => o
    (l: ChainLink)  => match(l.value)
      (let2: PsLet) => dischargeLocals(l.next, r,
          LinOut(popObligations(chain(linLeaves(let2.lType, r)), let2.lName,
                                o.loCnt),
                 discharge(let2.lName, linLeaves(let2.lType, r),
                           o.loCnt.lcCounts, let2.pslLine, false, o.loErrs)))
      (o2: PStmt)   => dischargeLocals(l.next, r, o)

fun blockTerminates(stmts: List<PStmt>): Bool
  ret match(last(stmts))
    (st: PStmt) => match(st)
      (rt: PsRet) => true
      (i: PsIf)   => blockTerminates(i.ifTrue) && blockTerminates(i.ifFalse)
      (o: PStmt)  => false
    ()          => false

fun countSuffix(stmts: List<PStmt>, i: Int, env: LinEnv, r: Resolver,
                r0: Resolver, trailing: PExpr|None, bindings: List<PStmt>,
                acc: List<PErr>): ScopeOut
  ret match(nthOf(stmts, i))
    (st: PStmt) => suffixStmt(st, stmts, i, env, r, r0, trailing, bindings,
                              acc)
    ()          => match(trailing)
      (tv: PExpr) => linCount(tv, env, r, acc)
        |> (o) => ScopeOut(o.loCnt, o.loErrs, bindings)
      ()          => ScopeOut(emptyCnt(), acc, bindings)

fun suffixStmt(st: PStmt, stmts: List<PStmt>, i: Int, env: LinEnv,
               r: Resolver, r0: Resolver, trailing: PExpr|None,
               bindings: List<PStmt>, acc: List<PErr>): ScopeOut
  ret match(st)
    (f: PsFun) => suffixFun(f, stmts, i, env, r, r0, trailing, bindings, acc)
    (d: PsDestructure) => suffixDestructure(d, stmts, i, env, r, r0, trailing,
                                            bindings, acc)
    (let2: PsLet) => suffixLet(let2, stmts, i, env, r, r0, trailing, bindings,
                               acc)
    (rt: PsRet) => linCount(rt.retValue, env, r, acc)
      |> (o) => ScopeOut(o.loCnt, o.loErrs, bindings)
    (a: PsAction) => suffixAction(a, stmts, i, env, r, r0, trailing, bindings,
                                  acc)
    (i2: PsIf) => suffixIf(i2, stmts, i, env, r, r0, trailing, bindings, acc)
    (c: PsClass) => countSuffix(stmts, i + 1, env, r, r0, trailing, bindings,
                                linToplevel(st, r0, acc))
    (e2: PsEnum) => countSuffix(stmts, i + 1, env, r, r0, trailing, bindings,
                                linToplevel(st, r0, acc))
    (o: PStmt) => countSuffix(stmts, i + 1, env, r, r0, trailing, bindings,
                              acc)

# A nested function is its own scope; it may not capture an enclosing linear
# binding.
fun suffixFun(f: PsFun, stmts: List<PStmt>, i: Int, env: LinEnv, r: Resolver,
              r0: Resolver, trailing: PExpr|None, bindings: List<PStmt>,
              acc: List<PErr>): ScopeOut
  let acc2 = match(f.fBody)
    (b: PExpr) => checkCapture(b, env, f.psfLine, r0, acc)
    ()         => acc
  ret countSuffix(stmts, i + 1, env, r, r0, trailing, bindings,
                  linFunction(f, None, r0, acc2))

fun suffixDestructure(d: PsDestructure, stmts: List<PStmt>, i: Int,
                      env: LinEnv, r: Resolver, r0: Resolver,
                      trailing: PExpr|None, bindings: List<PStmt>,
                      acc: List<PErr>): ScopeOut
  let o = match(d.dDefault)
    (x: PExpr) => linCount(x, env, r, acc)
    ()         => linZero(acc)
  let grown = growEnv(chain(d.dTargets), r0, env, bindings)
  ret countSuffix(stmts, i + 1, grown.geEnv, r, r0, trailing,
                  grown.geBindings, o.loErrs)
    |> (rest) => ScopeOut(cntAdd(o.loCnt, rest.soCnt), rest.soErrs,
                          rest.soBindings)

class [final] GrownEnv(geEnv: LinEnv, geBindings: List<PStmt>)

fun [tail] growEnv(ts: Chain<PStmt>, r: Resolver, env: LinEnv,
                   bindings: List<PStmt>): GrownEnv
  ret match(ts)
    (nil: ChainEnd) => GrownEnv(env, bindings)
    (l: ChainLink)  => match(l.value)
      (let2: PsLet) => carriesLinearity(let2.lType, r)
        ? growEnv(l.next, r, putEnv(env, let2), append(bindings, l.value))
        : growEnv(l.next, r, env, bindings)
      (o: PStmt)    => growEnv(l.next, r, env, bindings)

fun suffixLet(let2: PsLet, stmts: List<PStmt>, i: Int, env: LinEnv,
              r: Resolver, r0: Resolver, trailing: PExpr|None,
              bindings: List<PStmt>, acc: List<PErr>): ScopeOut
  let acc2 = lazyLinearErrs(let2, env, r0, acc)
  let o = match(let2.lDefault)
    (x: PExpr) => linCount(x, env, r, acc2)
    ()         => linZero(acc2)
  let isLin = carriesLinearity(let2.lType, r0)
  ret countSuffix(stmts, i + 1, isLin ? putEnv(env, let2) : env, r, r0,
                  trailing,
                  isLin ? append(bindings, narrowLet(let2)) : bindings,
                  o.loErrs)
    |> (rest) => ScopeOut(cntAdd(o.loCnt, rest.soCnt), rest.soErrs,
                          rest.soBindings)

fun narrowLet(let2: PsLet): PStmt
  ret let2

# `[lazy]` may not hold or capture a linear value; `[future]` with a linear
# PAYLOAD is the sound exception (claim protocol), otherwise the same capture
# rule applies.
fun lazyLinearErrs(let2: PsLet, env: LinEnv, r: Resolver,
                   acc: List<PErr>): List<PErr>
  let deferred = hasAttr(let2.lAttrs, "lazy") || hasAttr(let2.lAttrs, "future")
  if !deferred
    ret acc
  let payloadLinear = carriesLinearity(let2.lType, r)
  let acc2 = payloadLinear && !hasAttr(let2.lAttrs, "future")
    ? append(acc, PErr(let2.pslLine,
                       "[lazy] let '" + let2.lName + "' may not hold a "
                       + "linear value — the stub memoises across "
                       + "forces, so multiple reads would yield "
                       + "the same linear instance"))
    : acc
  ret match(let2.lDefault)
    (x: PExpr) => hasAttr(let2.lAttrs, "future") && payloadLinear
      ? acc2
      : checkCapture(x, env, let2.pslLine, r, acc2)
    ()         => acc2

# A statement-expression may consume a linear binding; a FRESH linear value
# produced and dropped here leaks.
fun suffixAction(a: PsAction, stmts: List<PStmt>, i: Int, env: LinEnv,
                 r: Resolver, r0: Resolver, trailing: PExpr|None,
                 bindings: List<PStmt>, acc: List<PErr>): ScopeOut
  let o = linCount(a.action, env, r, acc)
  let acc2 = exprIsLinear(a.action, r, r0)
    ? append(o.loErrs, PErr(a.psaLine,
                            "linear value is discarded; bind it and consume it"))
    : o.loErrs
  ret countSuffix(stmts, i + 1, env, r, r0, trailing, bindings, acc2)
    |> (rest) => ScopeOut(cntAdd(o.loCnt, rest.soCnt), rest.soErrs,
                          rest.soBindings)

fun exprIsLinear(x: PExpr, r: Resolver, r0: Resolver): Bool
  ret carriesLinearity(exprType(x, r), r0)

# The condition runs unconditionally; the branches are alternative paths; the
# continuation joins only the branches that fall through.
fun suffixIf(i2: PsIf, stmts: List<PStmt>, i: Int, env: LinEnv, r: Resolver,
             r0: Resolver, trailing: PExpr|None, bindings: List<PStmt>,
             acc: List<PErr>): ScopeOut
  let cond = linCount(i2.ifCond, env, r, acc)
  let tb = countStmtList(i2.ifTrue, None, env, blockScope(i2.ifTrue, r), r0,
                         cond.loErrs)
  let fb = countStmtList(i2.ifFalse, None, env, blockScope(i2.ifFalse, r), r0,
                         tb.loErrs)
  let cont = countStmtList(drop(stmts, i + 1), trailing, env, r, r0,
                           fb.loErrs)
  let tPath = blockTerminates(i2.ifTrue) ? tb.loCnt
                                         : cntAdd(tb.loCnt, cont.loCnt)
  let fPath = blockTerminates(i2.ifFalse) ? fb.loCnt
                                          : cntAdd(fb.loCnt, cont.loCnt)
  let merged = cntMerge(tPath, fPath, i2.psifLine, cont.loErrs)
  ret ScopeOut(cntAdd(cond.loCnt, merged.loCnt), merged.loErrs, bindings)

# ── paths, lambdas, captures ────────────────────────────────────────────────

# A path-expr moves every leaf that has the path as a prefix; a path running
# past a leaf into a non-linear field moves nothing.
fun countPath(x: PExpr, env: LinEnv, r: Resolver): LinCnt
  ret match(resolvePathRoot(x, List<String>()))
    (rp: RootPath) => envHas(env, rp.rpRoot)
      ? pathCounts(chain(linLeaves(envType(env, rp.rpRoot), r)), rp,
                   emptyCnt())
      : emptyCnt()
    ()             => emptyCnt()

class [final] RootPath(rpRoot: String, rpPath: String)

fun [tail] resolvePathRoot(x: PExpr, fields: List<String>): RootPath|None
  ret match(x)
    (d: PeDot)   => resolvePathRoot(d.base, prepend(d.member, fields))
    (nm: PeName) => RootPath(nm.refName, join(fields, "/"))
    (o: PExpr)   => None

fun [tail] pathCounts(ls: Chain<String>, rp: RootPath, c: LinCnt): LinCnt
  ret match(ls)
    (nil: ChainEnd) => c
    (l: ChainLink)  => isPathPrefix(rp.rpPath, l.value)
      ? pathCounts(l.next, rp, cntBump(c, oblKey(rp.rpRoot, l.value), 1))
      : pathCounts(l.next, rp, c)

fun isPathPrefix(prefix: String, full: String): Bool
  ret prefix == "" || prefix == full || startsWith(full, prefix + "/")

# A lambda contributes NOTHING to the enclosing count: it may run zero or
# many times, so it may not capture an enclosing linear binding, and its own
# linear params are its own scope's obligations.
fun countLambda(lm: PeLambda, env: LinEnv, r: Resolver,
                acc: List<PErr>): LinOut
  let acc2 = checkCapture(lm.lamBody, env, lm.pelLine, r, acc)
  ret linZero(checkLambdaScope(lm, r, acc2))

fun checkLambdaScope(lm: PeLambda, r: Resolver, acc: List<PErr>): List<PErr>
  let params = flattenParams(lm.lamParams)
  let env = paramEnv(chain(params), r, emptyEnv())
  ret analyzeScope(lm.lamBody, env, lm.pelLine,
                   localScope(params, r), r, acc)

fun countParallel(pl: PeParallel, env: LinEnv, r: Resolver,
                  acc: List<PErr>): LinOut
  let acc2 = checkCapture(pl.parParams, env, pl.pepLine, r, acc)
  let o = linCount(pl.parParams, env, r, acc2)
  ret linZero(o.loErrs)

# A blind name scan — sound because bindings carry path-unique names.
fun checkCapture(b: PExpr, env: LinEnv, lr: PLine, r: Resolver,
                 acc: List<PErr>): List<PErr>
  ret captureErrs(chain(sort(capturedIn(b, env))), lr, acc)

fun capturedIn(b: PExpr, env: LinEnv): List<String>
  ret capturedLoop(chain(referencedNames(b, List<String>())), env,
                   List<String>())

fun [tail] capturedLoop(ns: Chain<String>, env: LinEnv,
                        acc: List<String>): List<String>
  ret match(ns)
    (nil: ChainEnd) => acc
    (l: ChainLink)  => envHas(env, l.value)
      ? capturedLoop(l.next, env, addNameOnce(acc, l.value))
      : capturedLoop(l.next, env, acc)

fun [tail] captureErrs(ns: Chain<String>, lr: PLine,
                       acc: List<PErr>): List<PErr>
  ret match(ns)
    (nil: ChainEnd) => acc
    (l: ChainLink)  => captureErrs(l.next, lr,
        append(acc, PErr(lr, "linear value '" + l.value
                             + "' captured by a nested function or lambda")))

# ── generic instantiation kind check ────────────────────────────────────────
# A linear type argument may only bind a [linear] type parameter.

fun checkInstantiations(statements: List<PStmt>, r: Resolver,
                        acc: List<PErr>): List<PErr>
  ret instStmts(chain(statements), r, acc)

fun [tail] instStmts(ss: Chain<PStmt>, r: Resolver,
                     acc: List<PErr>): List<PErr>
  ret match(ss)
    (nil: ChainEnd) => acc
    (l: ChainLink)  => instStmts(l.next, r, instStmt(l.value, r, acc))

fun instStmt(st: PStmt, r: Resolver, acc: List<PErr>): List<PErr>
  ret match(st)
    (f: PsFun)         => instExprOpt(f.fBody, r,
                            instSpecsIn(chain(f.fWheres), r,
                              instSpecOpt(f.fRet, r, instStmt(f.fParams, r,
                                                              acc))))
    (l: PsLet)         => instExprOpt(l.lDefault, r,
                                      instSpecOpt(l.lType, r, acc))
    (d: PsDestructure) => instStmts(chain(d.dTargets), r,
                            instExprOpt(d.dDefault, r,
                                        instSpecOpt(d.dType, r, acc)))
    (c: PsClass)       => instStmts(chain(c.cMembers), r,
                            instSpecsIn(chain(c.cImplements), r,
                                        instStmt(c.cParams, r, acc)))
    (e2: PsEnum)       => instStmts(chain(e2.eVariants), r,
                                    instStmt(e2.eParams, r, acc))
    (ta: PsTypealias)  => instSpecOpt(ta.taType, r, acc)
    (rt: PsRet)        => instExpr(rt.retValue, r, acc)
    (a: PsAction)      => instExpr(a.action, r, acc)
    (i: PsIf)          => instStmts(chain(i.ifFalse), r,
                            instStmts(chain(i.ifTrue), r,
                                      instExpr(i.ifCond, r, acc)))
    (o: PStmt)         => acc

fun instExpr(x: PExpr, r: Resolver, acc: List<PErr>): List<PErr>
  ret match(x)
    (nm: PeName)   => isEmpty(nm.refTypeParams)
      ? acc
      : instCheck(nm.refName, nm.refTypeParams, nm.penLine, false, r, acc)
    (d: PeDot)     => instExpr(d.base, r, acc)
    (c: PeCall)    => instExpr(c.parameter, r, instExpr(c.function, r, acc))
    (tp: PeTuple)  => instEntries(chain(tp.exprs), r, acc)
    (te: PeTernary) => instExpr(te.falseResult, r,
                        instExpr(te.trueResult, r,
                                 instExpr(te.condition, r, acc)))
    (lm: PeLambda) => instExpr(lm.lamBody, r, instStmt(lm.lamParams, r, acc))
    (bk: PeBlock)  => instExpr(bk.blockValue, r,
                               instStmts(chain(bk.blockStmts), r, acc))
    (mt: PeMatch)  => instArms(chain(mt.arms), r, instExpr(mt.subject, r, acc))
    (op: PeBuiltinOp) => instExpr(op.opParams, r, acc)
    (nw: PeNew)    => instExpr(nw.newParam, r, instSpecOpt(nw.newType, r, acc))
    (ar: PeArrayRead) => instExpr(ar.arrIndex, r, instExpr(ar.arrObj, r, acc))
    (cv: PeConvert) => instExpr(cv.convInner, r,
                                instSpecOpt(cv.convTarget, r, acc))
    (pl: PeParallel) => instExpr(pl.parParams, r, acc)
    (o: PExpr)     => acc

fun [tail] instEntries(es: Chain<PTupEnt>, r: Resolver,
                       acc: List<PErr>): List<PErr>
  ret match(es)
    (nil: ChainEnd) => acc
    (l: ChainLink)  => instEntries(l.next, r,
                                   instExpr(l.value.tupValue, r, acc))

fun [tail] instArms(as2: Chain<PArm>, r: Resolver,
                    acc: List<PErr>): List<PErr>
  ret match(as2)
    (nil: ChainEnd) => acc
    (l: ChainLink)  => instArms(l.next, r,
                        instExprOpt(l.value.armGuard, r,
                          instExpr(l.value.armBody, r,
                                   instSpecOpt(l.value.armType, r, acc))))

fun instExprOpt(x: PExpr|None, r: Resolver, acc: List<PErr>): List<PErr>
  ret match(x)
    (e2: PExpr) => instExpr(e2, r, acc)
    ()          => acc

fun instSpecOpt(sp: Spec|None, r: Resolver, acc: List<PErr>): List<PErr>
  ret match(sp)
    (s2: Spec) => instSpec(s2, r, acc)
    ()         => acc

fun instSpec(sp: Spec, r: Resolver, acc: List<PErr>): List<PErr>
  ret match(sp)
    (c: SClass) => instSpecsIn(chain(c.scParams), r,
                               isEmpty(c.scParams)
                                 ? acc
                                 : instCheck(c.scName, c.scParams, c.scLine,
                                             true, r, acc))
    (e2: SEnum) => instSpecsIn(chain(e2.seParams), r,
                               isEmpty(e2.seParams)
                                 ? acc
                                 : instCheck(e2.seRoot, e2.seParams,
                                             e2.seLine, true, r, acc))
    (cm: SCombination) => instSpecsIn(chain(cm.scTypes), r, acc)
    (t2: STuple)       => instSpecEntries(chain(t2.stEntries), r, acc)
    (cl: SCallable)    => instSpecOpt(cl.scResult, r,
                                      instSpec(cl.scParams2, r, acc))
    (o: Spec)          => acc

fun [tail] instSpecsIn(ss: Chain<Spec>, r: Resolver,
                       acc: List<PErr>): List<PErr>
  ret match(ss)
    (nil: ChainEnd) => acc
    (l: ChainLink)  => instSpecsIn(l.next, r, instSpec(l.value, r, acc))

fun [tail] instSpecEntries(es: Chain<SEntry>, r: Resolver,
                           acc: List<PErr>): List<PErr>
  ret match(es)
    (nil: ChainEnd) => acc
    (l: ChainLink)  => instSpecEntries(l.next, r,
                                       instSpecOpt(l.value.seType, r, acc))

fun instCheck(name: String, args: List<Spec>, lr: PLine, isType: Bool,
              r: Resolver, acc: List<PErr>): List<PErr>
  let found = isType ? findType(r, name) : findData(r, name)
  ret match(soleItem(found))
    (f: Found) => instArgs(chain(stmtGens(f.fStmt)), chain(args), lr, r, acc)
    ()         => acc

fun [tail] instArgs(gs: Chain<PGen>, as2: Chain<Spec>, lr: PLine, r: Resolver,
                    acc: List<PErr>): List<PErr>
  ret match(gs)
    (nil: ChainEnd) => acc
    (g2: ChainLink) => match(as2)
      (nil2: ChainEnd) => acc
      (a: ChainLink)   => instArgs(g2.next, a.next, lr, r,
          carriesLinearity(a.value, r) && !hasAttr(g2.value.genAttrs, "linear")
            ? append(acc, PErr(lr,
                "linear type cannot be passed to an unrestricted type parameter"))
            : acc)
