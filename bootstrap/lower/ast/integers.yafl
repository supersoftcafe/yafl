# bootstrap/integers.yafl — lowering/integers.py: hoist every BIGINT literal
# (precision 0; sized literals stay) to a global `let $integers::integer@pN`
# (`@nN` for negatives), replacing each use with a reference. Sorted before
# numbering (parity with the determinism-fixed Python), so the $integers
# line refs are stable.
namespace Bootstrap::Lower::Ast

import System
import System::Containers

import Bootstrap::Ast



fun fixGlobalIntegers(statements): List<PStmt>
  let values = sort(foldStmts(statements, giIdInts, giCollect,
                              Set()))
  if isEmpty(values)
    ret statements
  let globals2 = giGlobals(values, 0, List())
  ret concat(globals2,
             rwStmts(statements, rwOnExpr((x) => giReplace(x,
                                                           values))))

fun giIdInts(acc, st: PStmt): Set<Int> => acc

# The distinct literal values, as a SET: the walk deduped by scanning what it
# had already collected, and the caller then ordered them with a hand-written
# INSERTION SORT — each value walking the sorted prefix and rebuilding it. A
# Set does the dedup, and the stdlib sort does the ordering.
fun giCollect(acc, x): Set<Int> => match(x)
  (i: PeInt) => i.precision == 0 ? add(acc, i.value) : acc
  (o: PExpr) => acc

fun giName(v) => v < 0 ? "$integers::integer@n" + String(0 - v)
          : "$integers::integer@p" + String(v)

# The index travels in the accumulator beside the statements.
fun giGlobals(vs: List<Int>, index: Int, acc: List<PStmt>): List<PStmt>
  ret fold(vs, (out = acc, i = index),
           (st, v) =>
             (out = append(st.out, giGlobal(v, st.i)), i = st.i + 1)).out

fun giGlobal(v: Int, index: Int): PStmt
  ret PsLet(giName(v), List(), List(),
            SBuiltin("bigint", PLine("$integers", index + 1, 1)),
            PeInt(v, 0, PLine("$integers", index + 1, 1)),
            "", List(),
            PLine("$integers", index + 1, 1), false,
            List<PStmt>())

fun giReplace(x, values: List<Int>) => match(x)
  (i: PeInt) => i.precision == 0
    ? PeName(giName(i.value), List(),
             PLine("$integers", giIndexOf(values, i.value, 0) + 1,
                   1),
             None)
    : None
  (o: PExpr) => None

fun giIndexOf(vs: List<Int>, v: Int, i) => match(findIndex(vs, (x) => x == v))
  (k: Int) => i + k
  ()       => -1
