# bootstrap/integers.yafl — lowering/integers.py: hoist every BIGINT literal
# (precision 0; sized literals stay) to a global `let $integers::integer@pN`
# (`@nN` for negatives), replacing each use with a reference. Sorted before
# numbering (parity with the determinism-fixed Python), so the $integers
# line refs are stable.
namespace Bootstrap::Lower::Ast

import System

import Bootstrap::Ast



fun fixGlobalIntegers(statements: List<PStmt>): List<PStmt>
  let values = sort<Int>(foldStmts<Set<Int> >(statements, giIdInts, giCollect,
                                              Set<Int>()))
  if isEmpty(values)
    ret statements
  let globals2 = giGlobals(chain(values), 0, List<PStmt>())
  ret concat(globals2,
             rwStmts(statements, rwOnExpr((x: PExpr) => giReplace(x,
                                                                  values))))

fun giIdInts(acc: Set<Int>, st: PStmt): Set<Int>
  ret acc

# The distinct literal values, as a SET: the walk deduped by scanning what it
# had already collected, and the caller then ordered them with a hand-written
# INSERTION SORT — each value walking the sorted prefix and rebuilding it. A
# Set does the dedup, and the stdlib sort does the ordering.
fun giCollect(acc: Set<Int>, x: PExpr): Set<Int>
  ret match(x)
    (i: PeInt) => i.precision == 0 ? add<Int>(acc, i.value) : acc
    (o: PExpr) => acc

fun giName(v: Int): String
  ret v < 0 ? "$integers::integer@n" + String(0 - v)
            : "$integers::integer@p" + String(v)

fun giGlobals(vs: Chain<Int>, index: Int,
                     acc: List<PStmt>): List<PStmt>
  ret build<PStmt >(giGlobalsB(vs, index, _pushChain<PStmt >(builder<PStmt >(), chain<PStmt >(acc))))

fun [tail] giGlobalsB(vs: Chain<Int>, index: Int,
                     [terminal] acc: ListBuilder<PStmt >): ListBuilder<PStmt >
  ret match(vs)
    (nil: ChainEnd) => acc
    (l: ChainLink)  => giGlobalsB(l.next, index + 1,
        push<PStmt >(acc, PsLet(giName(l.value), List<PAttr>(), List<PGen>(),
                          SBuiltin("bigint",
                                   PLine("$integers", index + 1, 1)),
                          PeInt(l.value, 0,
                                PLine("$integers", index + 1, 1)),
                          "", List<Spec>(),
                          PLine("$integers", index + 1, 1), false,
                          List<PStmt>())))

fun giReplace(x: PExpr, values: List<Int>): PExpr|None
  ret match(x)
    (i: PeInt) => i.precision == 0
      ? PeName(giName(i.value), List<Spec>(),
               PLine("$integers", giIndexOf(chain(values), i.value, 0) + 1,
                     1),
               None)
      : None
    (o: PExpr) => None

fun [tail] giIndexOf(vs: Chain<Int>, v: Int, i: Int): Int
  ret match(vs)
    (nil: ChainEnd) => -1
    (l: ChainLink)  => l.value == v ? i : giIndexOf(l.next, v, i + 1)
