# bootstrap/lower_instances.yafl — lower PsTraitInstance to witness class +
# `[trait]` record let, ported from lowering/instances.py. Runs AFTER every
# user-facing phase (diagnostics/linearity spoke of the instance), BEFORE
# monomorphisation; the caller re-converges so the new statements resolve.
namespace Bootstrap::Lower::Ast

import System

import Bootstrap::Ast
import Bootstrap::Codegen
import Bootstrap::Parse
import Bootstrap::Resolve
import Bootstrap::StdlibCandidates



class [final] LiOut(liStmts: List<PStmt>, liChanged: Bool)

fun lowerTraitInstances(statements: List<PStmt>): LiOut
  ret liLoop(chain(statements), builder<PStmt>(), false)

fun [tail] liLoop(ss: Chain<PStmt>, acc: ListBuilder<PStmt>,
                  changed: Bool): LiOut
  ret match(ss)
    (nil: ChainEnd) => LiOut(build(acc), changed)
    (l: ChainLink)  => match(l.value)
      (ti: PsTraitInstance) => liLoop(l.next, liLower(ti, acc), true)
      (o: PStmt)            => liLoop(l.next, push(acc, l.value), changed)

fun liLower(ti: PsTraitInstance, acc: ListBuilder<PStmt>): ListBuilder<PStmt>
  let lr = ti.pstiLine
  let tag = hash6(lr.plFile, lr.plLine, lr.plCol)
  let ns = namespacePart(ti.tiName)
  let prefix = ns == "" ? "" : ns + "::"
  let wbare = "_Instance$" + tag
  let witness = PsClass(prefix + wbare + "@" + tag, List<PAttr>(), ti.tiGens,
                        funParamsStmt(List<PStmt>(), lr),
                        prepend(ti.tiPattern, List<Spec>()), ti.tiWheres,
                        ti.tiMembers, false, lr, None, None, ti.tiImports)
  let ownArgs = liOwnArgs(chain(ti.tiGens), lr, builder<Spec>())
  let value = PeCall(PeName(wbare, ownArgs, lr),
                     PeTuple(List<PTupEnt>(), lr), lr)
  let attrs = ti.tiAmbient
    ? build<PAttr>(push<PAttr>(push<PAttr>(builder<PAttr>(), PAttr("trait", None)), PAttr("ambient", None)))
    : prepend(PAttr("trait", None), List<PAttr>())
  let record = PsLet(prefix + "_instance$" + tag + "@" + tag, attrs,
                     ti.tiGens, SNamed(wbare, ownArgs, lr), value, "",
                     ti.tiWheres, lr, false, ti.tiImports)
  ret push<PStmt>(push<PStmt>(push<PStmt>(acc, witness),
                              classConstructorOf(witness)),
                  record)

fun [tail] liOwnArgs(gs: Chain<PGen>, lr: PLine,
                     acc: ListBuilder<Spec>): List<Spec>
  ret match(gs)
    (nil: ChainEnd) => build(acc)
    (l: ChainLink)  => liOwnArgs(l.next, lr,
                                 push(acc, SNamed(bareOfUnique(l.value.genName),
                                                  List<Spec>(), lr)))
