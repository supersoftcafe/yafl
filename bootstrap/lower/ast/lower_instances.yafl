# bootstrap/lower_instances.yafl — lower PsTraitInstance to witness class +
# `[trait]` record let, ported from lowering/instances.py. Runs AFTER every
# user-facing phase (diagnostics/linearity spoke of the instance), BEFORE
# monomorphisation; the caller re-converges so the new statements resolve.
namespace Bootstrap::Lower::Ast

import System
import System::Containers

import Bootstrap::Ast
import Bootstrap::Codegen
import Bootstrap::Parse
import Bootstrap::Resolve
import Bootstrap::StdlibCandidates



class [final] LiOut(liStmts: List<PStmt>, liChanged: Bool)

fun lowerTraitInstances(statements: List<PStmt>) => liLoop(statements, List(), false)

fun liLoop(ss: List<PStmt>, acc, changed) =>
  fold(ss, LiOut(acc, changed), liOne)

fun liOne(o: LiOut, st: PStmt): LiOut => match(st)
  (ti: PsTraitInstance) => LiOut(liLower(ti, o.liStmts), true)
  (p: PStmt)            => LiOut(append(o.liStmts, st), o.liChanged)

fun liLower(ti: PsTraitInstance, acc: List<PStmt>)
  let lr = ti.pstiLine
  let tag = hash6(lr.plFile, lr.plLine, lr.plCol)
  let ns = namespacePart(ti.tiName)
  let prefix = ns == "" ? "" : ns + "::"
  let wbare = "_Instance$" + tag
  let witness = PsClass(prefix + wbare + "@" + tag, List(), ti.tiGens,
                        funParamsStmt(List(), lr),
                        prepend(ti.tiPattern, List()), ti.tiWheres,
                        ti.tiMembers, false, lr, None, None, ti.tiImports)
  let ownArgs = liOwnArgs(ti.tiGens, lr, List())
  let value = PeCall(PeName(wbare, ownArgs, lr), PeTuple(List(), lr), lr)
  let attrs = ti.tiAmbient
    ? append(append(List(), PAttr("trait", None)), PAttr("ambient", None))
    : prepend(PAttr("trait", None), List())
  let record = PsLet(prefix + "_instance$" + tag + "@" + tag, attrs,
                     ti.tiGens, SNamed(wbare, ownArgs, lr), value, "",
                     ti.tiWheres, lr, false, ti.tiImports)
  ret append(append(append(acc, witness), classConstructorOf(witness)), record)

fun liOwnArgs(gs: List<PGen>, lr, acc: List<Spec>) =>
  concat(acc, map(gs, (g) => SNamed(bareOfUnique(g.genName), List(), lr)))
