# bootstrap/complex_enums.yafl — lowering/complex_enums.py: detect complex
# (recursive) enums and mark them.
#
# An enum is "complex" when its all_fields graph contains a cycle through its
# root_name — directly or via mutual recursion. Recursive enums must lower to
# heap-allocated objects so the compiled struct has finite size. Exactly one
# enum per cycle is marked; the breaker is chosen by: System:: enums first,
# then self-loops, then fewest all_fields entries, then root_name. Class
# boundaries break cycles (a class field is already a heap pointer), so the
# reachability walk stops at SClass.
namespace Bootstrap::Lower::Ast

import System

import Bootstrap::Ast
# Codegen: the per-leaf threshold analysis reuses collectLeafFieldSets /
# filterDeclaredFields / asEnumVariant / enumIsRootStmt (Python's twins live
# in pyast.typespec, which complex_enums.py imports the same way).
import Bootstrap::Codegen
import Bootstrap::Frontend
import Bootstrap::Parse
import Bootstrap::Resolve
import Bootstrap::StdlibCandidates
import Bootstrap::Types



# ── canonical roots + name map ───────────────────────────────────────────────
# Just Dicts. The parallel lists beside them existed to preserve INSERTION
# ORDER, because the suffix fallback used to take the first map hit — but
# RULING A replaced that with "collect every match and error if more than one
# survives", so insertion order no longer decides anything. The walks that
# need an order take the keys SORTED.
class [final] ERoots(erIndex: Dict<String, SEnum>)
class [final] NameMap(nmIndex: Dict<String, String>)

fun erNames(r: ERoots): List<String>
  ret sort<String>(keys<String, SEnum>(r.erIndex))

fun nmNames(m: NameMap): List<String>
  ret sort<String>(keys<String, String>(m.nmIndex))

fun ceCollectRoots(statements: List<PStmt>): ERoots
  ret ceRootsLoop(chain(statements),
                  ERoots(Dict<String, SEnum>()))

fun [tail] ceRootsLoop(ss: Chain<PStmt>, acc: ERoots): ERoots
  ret match(ss)
    (nil: ChainEnd) => acc
    (l: ChainLink)  => match(l.value)
      (e2: PsEnum) => ceRootsLoop(l.next, ceRootAdd(acc, e2))
      (o: PStmt)   => ceRootsLoop(l.next, acc)

fun ceRootAdd(acc: ERoots, e2: PsEnum): ERoots
  ret match(e2.eSpec)
    (sp: Spec) => match(sp)
      # FIRST declaration of a root wins.
      (es: SEnum) => contains<String, SEnum>(acc.erIndex, es.seRoot)
        ? acc
        : ERoots(put(acc.erIndex, es.seRoot, es))
      (o: Spec)   => acc
    ()         => acc

fun ceRootSpecOf(roots: ERoots, root: String): SEnum|None
  ret get(roots.erIndex, root)

# Every name form of an enum root maps to its canonical root_name: the
# no-hash namespaced form and the bare name (Name@hash itself is NOT a key —
# NamedSpec.name typically lacks the hash). First form wins (setdefault).
fun ceNameMap(roots: ERoots): NameMap
  ret ceMapLoop(chain(erNames(roots)), NameMap(Dict<String, String>()))

fun [tail] ceMapLoop(ns: Chain<String>, acc: NameMap): NameMap
  ret match(ns)
    (nil: ChainEnd) => acc
    (l: ChainLink)  => ceMapLoop(l.next,
                                 ceMapAdd(ceMapAdd(acc, simpleName(l.value),
                                                   l.value),
                                          bareOfUnique(l.value), l.value))

fun ceMapAdd(acc: NameMap, key: String, root: String): NameMap
  ret get(acc.nmIndex, key) is None
    ? NameMap(put(acc.nmIndex, key, root))
    : acc

# Direct hit first (dict get), then the suffix fallback: "Foo::Bar" matches
# "AnyNs::Foo::Bar" in either direction. EVERY match is collected and the
# answer stands only if exactly one survives (RULING A), so the order the
# keys are walked in cannot affect it.
fun ceLookup2(map: NameMap, name: String): String|None
  ret match(get(map.nmIndex, name))
    (hit: String) => hit
    ()            => singleOrNone<String>(ceSuffixMatches(chain(nmNames(map)),
                                                          map, name,
                                                          Set<String>()))

# EVERY candidate, not just the first. Stopping at the first made the answer
# depend on NameMap INSERTION ORDER: two roots that both suffix-match resolved
# to whichever was inserted earlier, and that choice decides which enum breaks
# a cycle — i.e. which enum gets BOXED, which reaches the emitted C. The two
# compilers agreed only because they insert in the same order; neither was
# deciding anything. A Set collects the distinct matches, so singleOrNone above
# yields the answer only when it is UNAMBIGUOUS, and ceAmbiguous below reports
# the rest (USER RULING).
fun [tail] ceSuffixMatches(ks: Chain<String>, map: NameMap, name: String,
                           acc: Set<String>): Set<String>
  ret match(ks)
    (nil: ChainEnd) => acc
    (k: ChainLink)  => ceSuffixMatches(k.next, map, name,
        endsWith(k.value, "::" + name) || endsWith(name, "::" + k.value)
          ? add<String>(acc, ceRootFor(map, k.value))
          : acc)

fun ceRootFor(map: NameMap, key: String): String
  ret match(get(map.nmIndex, key))
    (r: String) => r
    ()          => key

# ── reachability ─────────────────────────────────────────────────────────────
# Collect every enum root directly referenced in a spec, stopping at SEnum
# (no all_fields descent — the SCC pass computes the transitive closure) and
# at SClass (the class boundary IS the indirection). No SArrayField descent —
# Python has no case for it.

# The reached roots are a SET — the walk deduped by scanning what it had
# already collected, and the one consumer sorts them into the edge list.
fun ceReachOpt(sp: Spec|None, out: Set<String >,
               map: NameMap): Set<String >
  ret match(sp)
    (s2: Spec) => ceReach(s2, out, map)
    ()         => out

fun ceReach(sp: Spec, out: Set<String >, map: NameMap): Set<String >
  ret match(sp)
    # `add` is idempotent, so the "already reached" test went with the Set.
    (e2: SEnum)        => add<String>(out, e2.seRoot)
    (t2: STuple)       => ceReachEntries(chain(t2.stEntries), out, map)
    (cm: SCombination) => ceReachList(chain(cm.scTypes), out, map)
    (cl: SCallable)    => ceReachOpt(cl.scResult,
                                     ceReach(cl.scParams2, out, map), map)
    (n: SNamed)        => match(ceLookup2(map, n.snName))
      (root: String) => add<String>(out, root)
      ()             => out
    (o: Spec)          => out

fun [tail] ceReachEntries(es: Chain<SEntry>, out: Set<String >,
                          map: NameMap): Set<String >
  ret match(es)
    (nil: ChainEnd) => out
    (l: ChainLink)  => ceReachEntries(l.next,
                                      ceReachOpt(l.value.seType, out, map),
                                      map)

fun [tail] ceReachList(ss: Chain<Spec>, out: Set<String >,
                       map: NameMap): Set<String >
  ret match(ss)
    (nil: ChainEnd) => out
    (l: ChainLink)  => ceReachList(l.next, ceReach(l.value, out, map), map)

# The directed graph between root names: each name to the names it reaches.
#
# A Dict, not two parallel lists. Every consumer asks this graph exactly one
# question — "what are v's children?" — and the parallel-list shape answered it
# by walking both chains in lockstep, an O(V) scan. Tarjan's DFS asks it once
# per node visit, so the SCC pass was quadratic in the number of roots; the
# breaker search re-asks it inside its own loop, so that was worse. Nothing
# about the graph is ordered: the node order Tarjan needs is imposed by sorting
# the keys where it is needed, not carried around in the representation.
class [final] EEdges(eeMap: Dict<String, List<String>>)

# The nodes, in a deterministic order. Sorted, because the SCC decomposition
# has to visit roots in the same order the Python compiler does.
fun eeNodes(work: EEdges): List<String>
  ret sort<String>(keys<String, List<String>>(work.eeMap))

fun ceEdges(roots: ERoots, map: NameMap,
            fieldsOf: (:String): List<SField>): EEdges
  ret ceEdgeLoop(chain(erNames(roots)), roots, map, fieldsOf,
                 EEdges(Dict<String, List<String>>()))

fun [tail] ceEdgeLoop(ns: Chain<String>, roots: ERoots, map: NameMap,
                      fieldsOf: (:String): List<SField>,
                      acc: EEdges): EEdges
  ret match(ns)
    (nil: ChainEnd) => acc
    (n: ChainLink)  => ceEdgeLoop(n.next, roots, map, fieldsOf,
        EEdges(put<String, List<String>>(acc.eeMap, n.value,
                   sort<String>(ceFieldsReach(chain(fieldsOf(n.value)),
                                              Set<String>(), map)))))

fun [tail] ceFieldsReach(fs: Chain<SField>, out: Set<String >,
                         map: NameMap): Set<String >
  ret match(fs)
    (nil: ChainEnd) => out
    (l: ChainLink)  => ceFieldsReach(l.next,
                                     ceReach(l.value.sfType, out, map), map)

fun ceChildrenOf(work: EEdges, v: String): List<String>
  ret match(get<String, List<String>>(work.eeMap, v))
    (cs: List<String>) => cs
    ()                 => List<String>()

# ── Tarjan's SCC algorithm ───────────────────────────────────────────────────
# Deterministic: roots and neighbours visited in sorted order, like Python.

class [final] Tj(tjIndex: Dict<String, Int>, tjLow: Dict<String, Int>,
                 tjStack: List<String>, tjOn: Set<String >,
                 tjSccs: List<List<String>>, tjN: Int)

fun ceSccs(work: EEdges): List<List<String>>
  let order = eeNodes(work)
  ret tjRoots(chain(order), work,
              Tj(Dict<String, Int>(), Dict<String, Int>(), List<String>(),
                 Set<String >(), List<List<String>>(), 0)).tjSccs

fun [tail] tjRoots(ns: Chain<String>, work: EEdges, st: Tj): Tj
  ret match(ns)
    (nil: ChainEnd) => st
    (l: ChainLink)  => match(get(st.tjIndex, l.value))
      (i: Int) => tjRoots(l.next, work, st)
      ()       => tjRoots(l.next, work, tjVisit(l.value, work, st))

fun tjVisit(v: String, work: EEdges, st0: Tj): Tj
  let st1 = Tj(put(st0.tjIndex, v, st0.tjN), put(st0.tjLow, v, st0.tjN),
               prepend(v, st0.tjStack), add<String>(st0.tjOn, v),
               st0.tjSccs, st0.tjN + 1)
  let st2 = tjNeighbours(chain(sort<String>(ceChildrenOf(work, v))),
                         v, work, st1)
  ret tjIndexOf(st2, v) == tjLowOf(st2, v) ? tjPop(st2, v) : st2

fun [tail] tjNeighbours(ws: Chain<String>, v: String, work: EEdges,
                        st: Tj): Tj
  ret match(ws)
    (nil: ChainEnd) => st
    (l: ChainLink)  => match(get(st.tjIndex, l.value))
      (i: Int) => contains<String >(st.tjOn, l.value)
        ? tjNeighbours(l.next, v, work,
                       tjSetLow(st, v, minInt(tjLowOf(st, v), i)))
        : tjNeighbours(l.next, v, work, st)
      ()       => tjVisit(l.value, work, st)
        |> (st2) => tjNeighbours(l.next, v, work,
                                 tjSetLow(st2, v,
                                          minInt(tjLowOf(st2, v),
                                                 tjLowOf(st2, l.value))))

fun tjIndexOf(st: Tj, v: String): Int
  ret match(get(st.tjIndex, v))
    (i: Int) => i
    ()       => -1

fun tjLowOf(st: Tj, v: String): Int
  ret match(get(st.tjLow, v))
    (i: Int) => i
    ()       => -1

fun tjSetLow(st: Tj, v: String, x: Int): Tj
  ret Tj(st.tjIndex, put(st.tjLow, v, x), st.tjStack, st.tjOn, st.tjSccs,
         st.tjN)

fun minInt(a: Int, b: Int): Int
  ret a < b ? a : b

# Pop the stack down to v inclusive — that prefix is one SCC. Python pops ONE
# AT A TIME, appending, so its member list runs [latest-discovered … v]. The
# order is observable (hoisted-statement order in ast_inline's SCC hoisting),
# so it must match exactly.
#
# The stack is stored NEWEST-FIRST, which is that order already: the SCC is
# just the prefix, and what remains is the suffix. Storing it oldest-first
# meant taking the tail and REVERSING it to get the same answer — the last
# list reversal in the port, deleted by choosing the representation that
# matches how the value is consumed.
# Remove an SCC's members from the on-stack set.
fun [tail] tjOnDrop(ns: Chain<String>, acc: Set<String >): Set<String >
  ret match(ns)
    (nil: ChainEnd) => acc
    (l: ChainLink)  => tjOnDrop(l.next, remove<String >(acc, l.value))

fun tjPop(st: Tj, v: String): Tj
  let at = tjFirstIndex(chain(st.tjStack), v, 0)
  let scc = take(st.tjStack, at + 1)
  # tjOn is a membership set, so the SCC's members are simply removed from it.
  # The SCC list keeps its order: Tarjan emits SCCs in a deterministic order
  # (sorted roots, sorted neighbours) and the breaker search consumes them in
  # that order, removing nodes as it goes.
  ret Tj(st.tjIndex, st.tjLow, drop(st.tjStack, at + 1),
         # A named walk, not `fold`: fold is overloaded over List and Set with
         # the same shape (container, init, fn), so a fold whose container is
         # a List and whose accumulator is a Set can match either overload.
         tjOnDrop(chain(scc), st.tjOn),
         build<List<String> >(push<List<String> >(
             _pushChain<List<String> >(builder<List<String> >(),
                 chain<List<String> >(st.tjSccs)),
             scc)),
         st.tjN)

# The stack is newest-first, so the MOST RECENT v is the FIRST match.
fun [tail] tjFirstIndex(ss: Chain<String>, v: String, at: Int): Int
  ret match(ss)
    (nil: ChainEnd) => at
    (l: ChainLink)  => l.value == v ? at : tjFirstIndex(l.next, v, at + 1)

fun tjRemoveAll(ss: Chain<String>, gone: List<String>,
                       acc: List<String>): List<String>
  ret build<String >(tjRemoveAllB(ss, gone, _pushChain<String >(builder<String >(), chain<String >(acc))))

fun [tail] tjRemoveAllB(ss: Chain<String>, gone: List<String>,
                       [terminal] acc: ListBuilder<String >): ListBuilder<String >
  ret match(ss)
    (nil: ChainEnd) => acc
    (l: ChainLink)  => contains2(gone, l.value)
      ? tjRemoveAllB(l.next, gone, acc)
      : tjRemoveAllB(l.next, gone, push<String >(acc, l.value))

# ── cycle breakers ───────────────────────────────────────────────────────────
# Iterate until no cycles remain; per round, every cyclic SCC contributes its
# minimum by (not System::, not self-loop, fewest all_fields, name) — the
# self-loop test reads the CURRENT work graph, updated as breakers are
# removed within the round, exactly like Python.

fun cePickBreakers(edges: EEdges, roots: ERoots,
                   fieldsOf: (:String): List<SField>): List<String>
  ret cePickLoop(edges, roots, fieldsOf, List<String>())

fun [tail] cePickLoop(work: EEdges, roots: ERoots,
                      fieldsOf: (:String): List<SField>,
                      acc: List<String>): List<String>
  let cyclic = ceCyclicSccs(chain(ceSccs(work)), work, List<List<String>>())
  if isEmpty(cyclic)
    ret acc
  ret ceBreakSccs(chain(cyclic), work, roots, fieldsOf, acc)
    |> (out) => cePickLoop(out.pbWork, roots, fieldsOf, out.pbChosen)

fun ceCyclicSccs(ss: Chain<List<String>>, work: EEdges,
                        acc: List<List<String>>): List<List<String>>
  ret build<List<String> >(ceCyclicSccsB(ss, work, _pushChain<List<String> >(builder<List<String> >(), chain<List<String> >(acc))))

fun [tail] ceCyclicSccsB(ss: Chain<List<String>>, work: EEdges,
                        [terminal] acc: ListBuilder<List<String> >): ListBuilder<List<String> >
  ret match(ss)
    (nil: ChainEnd) => acc
    (l: ChainLink)  => ceIsCyclic(l.value, work)
      ? ceCyclicSccsB(l.next, work, push<List<String> >(acc, l.value))
      : ceCyclicSccsB(l.next, work, acc)

fun ceIsCyclic(scc: List<String>, work: EEdges): Bool
  if !isEmpty(drop(scc, 1))
    ret true
  ret ceAnySelfLoop(chain(scc), work)

fun [tail] ceAnySelfLoop(ss: Chain<String>, work: EEdges): Bool
  ret match(ss)
    (nil: ChainEnd) => false
    (l: ChainLink)  => contains2(ceChildrenOf(work, l.value), l.value)
      ? true
      : ceAnySelfLoop(l.next, work)

class [final] PickOut(pbWork: EEdges, pbChosen: List<String>)

fun [tail] ceBreakSccs(ss: Chain<List<String>>, work: EEdges, roots: ERoots,
                       fieldsOf: (:String): List<SField>,
                       acc: List<String>): PickOut
  ret match(ss)
    (nil: ChainEnd) => PickOut(work, acc)
    (l: ChainLink)  => ceMinBy(chain(l.value), work, roots, fieldsOf, "")
      # The chosen breakers are a set of names to mark — order not observed.
      |> (chosen) => ceBreakSccs(l.next, ceRemoveNode(work, chosen), roots,
                                 fieldsOf, prepend(chosen, acc))

fun [tail] ceMinBy(ss: Chain<String>, work: EEdges, roots: ERoots,
                   fieldsOf: (:String): List<SField>,
                   best: String): String
  ret match(ss)
    (nil: ChainEnd) => best
    (l: ChainLink)  => best == "" || ceKeyLess(l.value, best, work, roots,
                                               fieldsOf)
      ? ceMinBy(l.next, work, roots, fieldsOf, l.value)
      : ceMinBy(l.next, work, roots, fieldsOf, best)

# The sort key tuple (not System::, not self-loop, len(all_fields), name),
# compared lexicographically.
fun ceKeyLess(a: String, b: String, work: EEdges, roots: ERoots,
              fieldsOf: (:String): List<SField>): Bool
  let aSys = ceIsSystem(a)
  let bSys = ceIsSystem(b)
  if aSys != bSys
    ret aSys                              # System:: sorts FIRST (False < True)
  let aSelf = contains2(ceChildrenOf(work, a), a)
  let bSelf = contains2(ceChildrenOf(work, b), b)
  if aSelf != bSelf
    ret aSelf
  let aFields = fieldsOf(a)
  let bFields = fieldsOf(b)
  if !sameLen(chain(aFields), chain(bFields))
    ret shorterThan(chain(aFields), chain(bFields))
  ret a < b

fun ceIsSystem(name: String): Bool
  ret startsWith(simpleName(name), "System::")

# Drop the node AND every edge into it. The node itself goes with `remove`; the
# incoming edges still have to be swept out of the remaining child lists, which
# is a walk of the whole graph either way.
fun ceRemoveNode(work: EEdges, v: String): EEdges
  ret ceRemoveLoop(chain(eeNodes(work)), work, v, EEdges(Dict<String, List<String>>()))

fun [tail] ceRemoveLoop(ns: Chain<String>, work: EEdges, v: String,
                        acc: EEdges): EEdges
  ret match(ns)
    (nil: ChainEnd) => acc
    (n: ChainLink)  => n.value == v
      ? ceRemoveLoop(n.next, work, v, acc)
      : ceRemoveLoop(n.next, work, v,
                     EEdges(put<String, List<String>>(acc.eeMap, n.value,
                                tjRemoveAll(chain(ceChildrenOf(work, n.value)),
                                            prepend(v, List<String>()),
                                            List<String>()))))

# ── the rewrite ──────────────────────────────────────────────────────────────
# Every EnumSpec anywhere: is_complex set by membership, and NamedSpec
# children of all_fields resolved to their target EnumSpec (with the flag).
# Pruned generic EnumSpecs (not in roots) are marked complex so generate()
# never expands their placeholder fields.

# With all_fields DERIVED (never stored), every nested spec position lives
# in a statement and is visited DIRECTLY by the walk — the old resolve
# machinery (recursion, visited sets, the CeKey memo) chased the stored-copy
# graph and dies with it. Python's collapse is the mirror. The fields
# provider (enumFieldsProvider — THE System::memoize parity site now) serves
# the graph builders.
# IDENTITY. is_complex is DERIVED (identity vs state): every reader queries
# the breaker analysis through its resolver (rrComplex, built by
# rootResolver) — there are no stamps to apply and no stale copies to
# repair. The pipeline slot is kept for wiring stability.
# The slot now earns its place: it VALIDATES the enum-name resolution the
# breaker analysis depends on. The breaker computation itself is a lazy,
# cached resolver query with nowhere to report, so the same walk runs here
# purely to surface ambiguities (USER RULING: an ambiguous suffix match is an
# error, not first-insertion-wins). Message text is VERBATIM with Python's.
fun markComplexEnums(statements: List<PStmt>): (stmts: List<PStmt>, errs: Set<PErr>)
  let roots = ceCollectRoots(statements)
  ret (stmts = statements,
       errs = isEmpty(roots.erIndex)
         ? Set<PErr>()
         : ceAmbiguities(chain(erNames(roots)), ceNameMap(roots),
                         enumFieldsProvider(statements), Set<PErr>()))

fun [tail] ceAmbiguities(ns: Chain<String>, map: NameMap,
                         fieldsOf: (:String): List<SField>,
                         acc: Set<PErr>): Set<PErr>
  ret match(ns)
    (nil: ChainEnd) => acc
    (n: ChainLink)  => ceAmbiguities(n.next, map, fieldsOf,
                                     ceFieldAmbig(chain(fieldsOf(n.value)),
                                                  map, acc))

fun [tail] ceFieldAmbig(fs: Chain<SField>, map: NameMap,
                        acc: Set<PErr>): Set<PErr>
  ret match(fs)
    (nil: ChainEnd) => acc
    (l: ChainLink)  => ceFieldAmbig(l.next, map,
                                    ceSpecAmbig(l.value.sfType, map, acc))

# Only a NAMED spec can be ambiguous; the structural cases just descend.
fun ceSpecAmbig(sp: Spec, map: NameMap, acc: Set<PErr>): Set<PErr>
  ret match(sp)
    (n: SNamed)        => get(map.nmIndex, n.snName) is None
      ? ceReportAmbig(n, ceSuffixMatches(chain(nmNames(map)), map, n.snName,
                                         Set<String>()), acc)
      : acc
    (t2: STuple)       => ceEntryAmbig(chain(t2.stEntries), map, acc)
    (cm: SCombination) => ceListAmbig(chain(cm.scTypes), map, acc)
    (cl: SCallable)    => ceSpecAmbig(cl.scParams2, map, acc)
    (o: Spec)          => acc

fun ceReportAmbig(n: SNamed, ms: Set<String>, acc: Set<PErr>): Set<PErr>
  ret isMoreThanOne<String>(ms)
    ? add(acc, PErr(n.snLine,
        "ambiguous enum reference '" + n.snName + "' — matches "
          + join(sort<String>(ms), ", ") + "; qualify it"))
    : acc

fun [tail] ceEntryAmbig(es: Chain<SEntry>, map: NameMap,
                        acc: Set<PErr>): Set<PErr>
  ret match(es)
    (nil: ChainEnd) => acc
    (l: ChainLink)  => ceEntryAmbig(l.next, map,
                                    ceSpecAmbigOpt(l.value.seType, map, acc))

# Optional-spec variant, mirroring ceReachOpt: a match cannot be spelled
# inline as a call argument.
fun ceSpecAmbigOpt(sp: Spec|None, map: NameMap, acc: Set<PErr>): Set<PErr>
  ret match(sp)
    (s2: Spec) => ceSpecAmbig(s2, map, acc)
    ()         => acc

fun [tail] ceListAmbig(ss: Chain<Spec>, map: NameMap,
                       acc: Set<PErr>): Set<PErr>
  ret match(ss)
    (nil: ChainEnd) => acc
    (l: ChainLink)  => ceListAmbig(l.next, map, ceSpecAmbig(l.value, map, acc))

# The breaker set — WHICH enum roots must lower complex — as a pure function
# of the statements (mirror of Python's compute_breakers): collect roots,
# build the reachability graph over DERIVED fields, pick one breaker per
# cycle.
# The root resolver, carrying the DERIVED is_complex query: the breaker
# analysis computes lazily once per resolver from its own statements — the
# same lifetime as every per-pass cache. Mirror of Python
# ResolverRoot.is_complex_root. The breaker list is small; membership is a
# linear scan.
fun rootResolver(statements: List<PStmt>,
                 suggest: Dict<String, Spec>|None = None): Resolver
  let [lazy] breakers: List<String> = computeBreakers(statements)
  let st = buildStatements(statements)
  ret RRoot((root: String) => contains2(breakers, root),
            st, suggest, None, 0,
            enumFieldsTable(statements), None,
            mergedMembersTable(st))

# Every root enum's derived fields, once per pass (the stAmbient pattern —
# resolver-path readers asked ~938k times per self-compile otherwise).
fun enumFieldsTable(statements: List<PStmt>): Dict<String, List<SField>>
  ret eftLoop(chain(statements), Dict<String, List<SField> >())

fun [tail] eftLoop(ss: Chain<PStmt>,
                   acc: Dict<String, List<SField> >): Dict<String, List<SField> >
  ret match(ss)
    (nil: ChainEnd) => acc
    (l: ChainLink)  => match(l.value)
      (e: PsEnum) => efIsRoot(e)
        ? eftLoop(l.next, put(acc, e.eName, deriveAllFields(e)))
        : eftLoop(l.next, acc)
      (o: PStmt)  => eftLoop(l.next, acc)

fun computeBreakers(statements: List<PStmt>): List<String>
  let roots = ceCollectRoots(statements)
  if isEmpty(roots.erIndex)
    ret List<String>()
  let fieldsOf = enumFieldsProvider(statements)
  let map = ceNameMap(roots)
  ret cePickBreakers(ceEdges(roots, map, fieldsOf), roots, fieldsOf)

# ══════════════════════════════════════════════════════════════════════════
# Per-leaf value-struct threshold (the enum-encoding principle; Python
# compute_boxed_leaves). A variant whose payload exceeds maxValueStructWords
# words is a heap object EVERYWHERE it appears: one pointer slot in its
# enum's pool, payload in the same per-leaf Object a complex enum would use.
# The decision is a property of the variant TYPE, so widening between unions
# holding it is always a straight slot copy.
#
# Widths are TRUE layout widths, mirrored from _flatten_primitives and the
# slot merge via per-primitive-class counters: a leaf payload SUMS its
# fields' primitives; a pool (or a tagged combination) takes per-class
# MAXIMA over its variants — greedy same-type slot reuse yields exactly
# that — plus a one-byte tag. Collapsed pointer unions (all members one
# tagged pointer word, mutually distinguishable) count one word, via a
# spec-level mirror of _pointer_word_kind / _union_collapses_to_pointer.
# Classes are kept apart exactly where the layout keeps slots apart
# (ptr, code, i64, f64, i32, f32, i16, i8). Tags count one byte: the global
# discriminator maximum fits i8 today; outgrowing it lags the estimate a
# byte per nesting — noise against a 64-byte threshold, layout unaffected.
#
# Children decide before parents (the value-containment graph is acyclic
# once breakers are removed; an on-stack root answers as a pointer,
# defensively). Roots with interior-node fields keep all leaves inline:
# inherited fields are read positionally across sibling carriers, which
# requires one shared representation. Recursion depths are bounded by
# program shape, so these loops carry no [tail] markers.
# ══════════════════════════════════════════════════════════════════════════

let maxValueStructWords: Int = 8
let maxValueStructBytes: Int = maxValueStructWords * 8

class [final] BoxCtx(bxBreakers: List<String>, bxStmts: Dict<String, PsEnum>,
                     bxMap: NameMap, bxForeign: Dict<String, Bool>)
class [final] BxPrims(bpPtr: Int, bpCode: Int, bpI64: Int, bpF64: Int,
                      bpI32: Int, bpF32: Int, bpI16: Int, bpI8: Int)
class [final] BoxState(bsMemo: Dict<String, BxPrims>, bsBoxed: Dict<String, Bool>)
class [final] BxOut(bxP: BxPrims, bxSt: BoxState)

fun bxZero(): BxPrims
  ret BxPrims(0, 0, 0, 0, 0, 0, 0, 0)

fun bxPtrOne(): BxPrims
  ret BxPrims(1, 0, 0, 0, 0, 0, 0, 0)

# fun_t: env pointer + code word.
fun bxFunPrims(): BxPrims
  ret BxPrims(1, 1, 0, 0, 0, 0, 0, 0)

fun bxAddTag(a: BxPrims): BxPrims
  ret BxPrims(a.bpPtr, a.bpCode, a.bpI64, a.bpF64, a.bpI32, a.bpF32,
              a.bpI16, a.bpI8 + 1)

fun bxAdd(a: BxPrims, b: BxPrims): BxPrims
  ret BxPrims(a.bpPtr + b.bpPtr, a.bpCode + b.bpCode, a.bpI64 + b.bpI64,
              a.bpF64 + b.bpF64, a.bpI32 + b.bpI32, a.bpF32 + b.bpF32,
              a.bpI16 + b.bpI16, a.bpI8 + b.bpI8)

fun bxMaxI(a: Int, b: Int): Int
  ret a > b ? a : b

fun bxMax(a: BxPrims, b: BxPrims): BxPrims
  ret BxPrims(bxMaxI(a.bpPtr, b.bpPtr), bxMaxI(a.bpCode, b.bpCode),
              bxMaxI(a.bpI64, b.bpI64), bxMaxI(a.bpF64, b.bpF64),
              bxMaxI(a.bpI32, b.bpI32), bxMaxI(a.bpF32, b.bpF32),
              bxMaxI(a.bpI16, b.bpI16), bxMaxI(a.bpI8, b.bpI8))

fun bxBytes(a: BxPrims): Int
  ret 8 * (a.bpPtr + a.bpCode + a.bpI64 + a.bpF64) + 4 * (a.bpI32 + a.bpF32)
    + 2 * a.bpI16 + a.bpI8

fun bxBuiltinPrims(name: String): BxPrims
  ret name == "int64" ? BxPrims(0, 0, 1, 0, 0, 0, 0, 0)
    : name == "float64" ? BxPrims(0, 0, 0, 1, 0, 0, 0, 0)
    : name == "int32" ? BxPrims(0, 0, 0, 0, 1, 0, 0, 0)
    : name == "float32" ? BxPrims(0, 0, 0, 0, 0, 1, 0, 0)
    : name == "int16" ? BxPrims(0, 0, 0, 0, 0, 0, 1, 0)
    : name == "int8" || name == "bool" ? BxPrims(0, 0, 0, 0, 0, 0, 0, 1)
    : bxPtrOne()   # bigint, str, unknown

fun computeBoxedLeaves(statements: List<PStmt>,
                       breakers: List<String>): Dict<String, Bool>
  let roots = ceCollectRoots(statements)
  let ctx = BoxCtx(breakers, bxRootStmts(statements), ceNameMap(roots),
                   bxForeignClasses(statements))
  let final = fold(sort<String>(keys<String, PsEnum>(ctx.bxStmts)),
                   BoxState(Dict<String, BxPrims>(), Dict<String, Bool>()),
                   (st: BoxState, root: String) =>
                     bxEnumValuePrims(ctx, root, List<String>(), st).bxSt)
  ret final.bsBoxed

# Root STATEMENTS by root name (first declaration wins): collectLeafFieldSets
# needs the PsEnum, not just its spec.
fun bxRootStmts(statements: List<PStmt>): Dict<String, PsEnum>
  ret bxRootStmtsLoop(chain(statements), Dict<String, PsEnum>())

fun [tail] bxRootStmtsLoop(ss: Chain<PStmt>,
                           acc: Dict<String, PsEnum>): Dict<String, PsEnum>
  ret match(ss)
    (nil: ChainEnd) => acc
    (l: ChainLink)  => match(l.value)
      (e2: PsEnum) => bxRootStmtsLoop(l.next, bxRootStmtAdd(acc, e2))
      (o: PStmt)   => bxRootStmtsLoop(l.next, acc)

fun bxRootStmtAdd(acc: Dict<String, PsEnum>, e2: PsEnum): Dict<String, PsEnum>
  ret match(asEnumVariant(e2.eSpec))
    (sp: SEnum) => enumIsRootStmt(e2) && !contains<String, PsEnum>(acc, sp.seRoot)
      ? put(acc, sp.seRoot, e2)
      : acc
    ()           => acc

# The [foreign] classes by canonical name (ClassSpec.name matches).
fun bxForeignClasses(statements: List<PStmt>): Dict<String, Bool>
  ret bxForeignLoop(chain(statements), Dict<String, Bool>())

fun [tail] bxForeignLoop(ss: Chain<PStmt>,
                         acc: Dict<String, Bool>): Dict<String, Bool>
  ret match(ss)
    (nil: ChainEnd) => acc
    (l: ChainLink)  => match(l.value)
      (c: PsClass) => hasAttr(c.cAttrs, "foreign")
        ? bxForeignLoop(l.next, put(acc, c.cName, true))
        : bxForeignLoop(l.next, acc)
      (o: PStmt)   => bxForeignLoop(l.next, acc)

# True when any non-leaf node of the variant tree declares fields.
fun bxHasInteriorFields(e2: PsEnum): Bool
  ret isEmpty(e2.eVariants)
    ? false
    : !isEmpty(filterDeclaredFields(chain(flattenParams(e2.eParams)), List<PStmt>()))
      || bxAnyInteriorVariant(chain(e2.eVariants))

fun [tail] bxAnyInteriorVariant(vs: Chain<PStmt>): Bool
  ret match(vs)
    (nil: ChainEnd) => false
    (l: ChainLink)  => match(l.value)
      (v: PsEnum) => bxHasInteriorFields(v) ? true : bxAnyInteriorVariant(l.next)
      (o: PStmt)  => bxAnyInteriorVariant(l.next)

# ── the pointer-word mirror (union_repr._pointer_word_kind at spec level) ──
# "" when the member is not representable as one tagged pointer word.

fun bxPointerKind(ctx: BoxCtx, sp: Spec|None): String
  ret match(sp)
    (s2: Spec) => bxPointerKindOn(ctx, s2)
    ()          => ""

fun bxPointerKindOn(ctx: BoxCtx, sp: Spec): String
  ret match(sp)
    (t2: STuple)  => isEmpty(t2.stEntries) ? "unit" : bxNewtypeKind(ctx, t2.stEntries)
    (b: SBuiltin) => b.sbName == "bigint" ? "int"
                   : b.sbName == "str" ? "str"
                   : ""
    (cl: SClass)  => contains<String, Bool>(ctx.bxForeign, cl.scName)
      ? "foreign"
      : "class:" + cl.scName
    (e2: SEnum)   => contains2(ctx.bxBreakers, e2.seRoot) ? "enum:" + e2.seRoot : ""
    (n: SNamed)   => match(get(ctx.bxMap.nmIndex, n.snName))
      (root: String) => contains2(ctx.bxBreakers, root) ? "enum:" + root : ""
      ()             => ""
    (o: Spec)     => ""

# A single-field tuple is a newtype wrapper: peel to the inner kind.
fun bxNewtypeKind(ctx: BoxCtx, entries: List<SEntry>): String
  ret isEmpty(tail(entries))
    ? match(head(entries))
        (e2: SEntry) => bxPointerKind(ctx, e2.seType)
        ()            => ""
    : ""

class [final] BxKindTally(ktUnits: Int, ktForeign: Int, ktNonUnit: Int,
                          ktDup: Bool, ktSeen: Set<String>)

# Mirror of _union_collapses_to_pointer: every member a pointer word, at
# least one non-unit, at most one unit and one foreign, testable kinds
# mutually distinct.
fun bxCollapses(ctx: BoxCtx, members: List<Spec>): Bool
  let kinds = map(members, (m: Spec) => bxPointerKindOn(ctx, m))
  if contains2(kinds, "")
    ret false
  let t2 = fold(kinds, BxKindTally(0, 0, 0, false, Set<String>()), bxKindStep)
  ret t2.ktNonUnit > 0 && t2.ktUnits <= 1 && t2.ktForeign <= 1 && !t2.ktDup

fun bxKindStep(t2: BxKindTally, k: String): BxKindTally
  ret k == "unit"
    ? BxKindTally(t2.ktUnits + 1, t2.ktForeign, t2.ktNonUnit, t2.ktDup, t2.ktSeen)
    : k == "foreign"
      ? BxKindTally(t2.ktUnits, t2.ktForeign + 1, t2.ktNonUnit + 1, t2.ktDup, t2.ktSeen)
      : BxKindTally(t2.ktUnits, t2.ktForeign, t2.ktNonUnit + 1,
                    t2.ktDup || contains<String>(t2.ktSeen, k),
                    add<String>(t2.ktSeen, k))

# ── widths ─────────────────────────────────────────────────────────────────

fun bxSpecPrims(ctx: BoxCtx, sp: Spec|None, stack: List<String>,
                st: BoxState): BxOut
  ret match(sp)
    (s2: Spec) => bxSpecPrimsOn(ctx, s2, stack, st)
    ()          => BxOut(bxPtrOne(), st)

fun bxSpecPrimsOn(ctx: BoxCtx, sp: Spec, stack: List<String>,
                  st: BoxState): BxOut
  ret match(sp)
    (b: SBuiltin)      => BxOut(bxBuiltinPrims(b.sbName), st)
    (cl: SCallable)    => BxOut(bxFunPrims(), st)
    (t2: STuple)       => bxEntriesPrims(ctx, chain(t2.stEntries), stack, st, bxZero())
    (cm: SCombination) => bxCollapses(ctx, cm.scTypes)
      ? BxOut(bxPtrOne(), st)
      : bxCombPrims(ctx, chain(cm.scTypes), stack, st, bxZero())
    (e2: SEnum)        => bxEnumValuePrims(ctx, e2.seRoot, stack, st)
    # Direct name-map hit only (no suffix fallback), as Python.
    (n: SNamed)        => match(get(ctx.bxMap.nmIndex, n.snName))
      (root: String) => bxEnumValuePrims(ctx, root, stack, st)
      ()             => BxOut(bxPtrOne(), st)
    (o: Spec)          => BxOut(bxPtrOne(), st)   # classes, placeholders

fun bxEntriesPrims(ctx: BoxCtx, es: Chain<SEntry>, stack: List<String>,
                   st: BoxState, acc: BxPrims): BxOut
  ret match(es)
    (nil: ChainEnd) => BxOut(acc, st)
    (l: ChainLink)  => bxEntriesStep(ctx, l, stack, st, acc)

fun bxEntriesStep(ctx: BoxCtx, l: ChainLink<SEntry>, stack: List<String>,
                  st: BoxState, acc: BxPrims): BxOut
  let o = bxSpecPrims(ctx, l.value.seType, stack, st)
  ret bxEntriesPrims(ctx, l.next, stack, o.bxSt, bxAdd(acc, o.bxP))

# Tagged combination: per-class maxima over the members, plus a byte tag.
fun bxCombPrims(ctx: BoxCtx, ss: Chain<Spec>, stack: List<String>,
                st: BoxState, acc: BxPrims): BxOut
  ret match(ss)
    (nil: ChainEnd) => BxOut(bxAddTag(acc), st)
    (l: ChainLink)  => bxCombStep(ctx, l, stack, st, acc)

fun bxCombStep(ctx: BoxCtx, l: ChainLink<Spec>, stack: List<String>,
               st: BoxState, acc: BxPrims): BxOut
  let o = bxSpecPrimsOn(ctx, l.value, stack, st)
  ret bxCombPrims(ctx, l.next, stack, o.bxSt, bxMax(acc, o.bxP))

fun bxEnumValuePrims(ctx: BoxCtx, root: String, stack: List<String>,
                     st: BoxState): BxOut
  if contains2(ctx.bxBreakers, root) || contains2(stack, root)
    ret BxOut(bxPtrOne(), st)   # heap pointer: complex, or defensive on-stack
  ret match(get(st.bsMemo, root))
    (p: BxPrims) => BxOut(p, st)
    ()            => bxComputeRoot(ctx, root, stack, st)

fun bxComputeRoot(ctx: BoxCtx, root: String, stack: List<String>,
                  st: BoxState): BxOut
  ret match(get(ctx.bxStmts, root))
    (e2: PsEnum) => match(asEnumVariant(e2.eSpec))
      (sp: SEnum) => bxRootPool(ctx, root, e2, sp, stack, st)
      ()           => BxOut(bxPtrOne(), st)   # unreachable: keyed by SEnum
    ()            => BxOut(bxPtrOne(), st)    # no root statement: a pointer

fun bxRootPool(ctx: BoxCtx, root: String, e2: PsEnum, sp: SEnum,
               stack: List<String>, st: BoxState): BxOut
  let out = bxLeafLoop(ctx, root, chain(sp.seAllLeaves),
                       chain(collectLeafFieldSets(e2, List<PStmt>())),
                       !bxHasInteriorFields(e2), concat(stack, list1(root)),
                       st, bxZero())
  ret BxOut(out.bxP,
            BoxState(put(out.bxSt.bsMemo, root, out.bxP), out.bxSt.bsBoxed))

fun bxLeafLoop(ctx: BoxCtx, root: String, names: Chain<String>,
               sets: Chain<List<PStmt>>, boxable: Bool, stack: List<String>,
               st: BoxState, pool: BxPrims): BxOut
  ret match(names)
    (nil: ChainEnd) => BxOut(bxAddTag(pool), st)   # widest variant + tag
    (l: ChainLink)  => match(sets)
      (nil2: ChainEnd) => BxOut(bxAddTag(pool), st)   # unreachable: zip 1:1
      (s2: ChainLink)  => bxLeafStep(ctx, root, l, s2, boxable, stack, st, pool)

fun bxLeafStep(ctx: BoxCtx, root: String, l: ChainLink<String>,
               s2: ChainLink<List<PStmt>>, boxable: Bool, stack: List<String>,
               st: BoxState, pool: BxPrims): BxOut
  let o = bxFieldsPrims(ctx, chain(s2.value), stack, st, bxZero())
  if bxBytes(o.bxP) > maxValueStructBytes && boxable
    ret bxLeafLoop(ctx, root, l.next, s2.next, boxable, stack,
                   BoxState(o.bxSt.bsMemo,
                            put(o.bxSt.bsBoxed, boxedLeafKey(root, l.value), true)),
                   bxMax(pool, bxPtrOne()))
  ret bxLeafLoop(ctx, root, l.next, s2.next, boxable, stack, o.bxSt,
                 bxMax(pool, o.bxP))

fun bxFieldsPrims(ctx: BoxCtx, fs: Chain<PStmt>, stack: List<String>,
                  st: BoxState, acc: BxPrims): BxOut
  ret match(fs)
    (nil: ChainEnd) => BxOut(acc, st)
    (l: ChainLink)  => match(l.value)
      (let2: PsLet) => bxFieldLet(ctx, let2, l.next, stack, st, acc)
      (o: PStmt)    => bxFieldsPrims(ctx, l.next, stack, st, acc)

fun bxFieldLet(ctx: BoxCtx, let2: PsLet, rest: Chain<PStmt>,
               stack: List<String>, st: BoxState, acc: BxPrims): BxOut
  let o = bxSpecPrims(ctx, let2.lType, stack, st)
  ret bxFieldsPrims(ctx, rest, stack, o.bxSt, bxAdd(acc, o.bxP))
