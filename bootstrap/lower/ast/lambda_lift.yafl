# bootstrap/lambda_lift.yafl — lowering/lambda_lift.py: nested functions that
# capture only to be CALLED lose the closure — the captures become
# parameters, threaded at every call site.
#
# An SCC of sibling functions lifts as a unit. Conditions (all conservative):
# every capture is a PARAMETER of the enclosing function; no captured
# parameter is [linear]; every reference to every member is the callee of a
# call (total name references == call-position references). Runs BEFORE
# tail_loop: self-calls must still be calls.
namespace Bootstrap::Lower::Ast

import System
import System::Containers

import Bootstrap::Ast
import Bootstrap::Frontend
import Bootstrap::Parse
import Bootstrap::Resolve
import Bootstrap::StdlibCandidates



fun liftCapturedCalls(statements: List<PStmt>) => llTop(statements, List())

fun llTop(ss: List<PStmt>, acc: List<PStmt>) =>
  fold(ss, acc, llTopStep)

fun llTopStep(a: List<PStmt>, x: PStmt) => match(x)
  (f: PsFun) => append(a, liftInFunction(f))
  (c: PsClass) => append(a, llInClass(c))
  (o: PStmt) => append(a, x)

# A class member is a function with a receiver; a nested helper inside one
# threads captured PARAMETERS exactly as it would inside a free function.
# `this` is not a parameter, so it is never threaded here — it stays implicit,
# and the hoist makes the helper a sibling member to keep it so.
fun llInClass(c): PStmt => hoClassDeclaresNested(c)
  ? with c(cMembers = llMembers(c.cMembers, List()))
  : c

fun llMembers(ss: List<PStmt>, acc: List<PStmt>) =>
  fold(ss, acc, llMembersStep)

fun llMembersStep(a: List<PStmt>, x: PStmt) => match(x)
  (f: PsFun) => append(a, liftInFunction(f))
  (o: PStmt) => append(a, x)

# Lift what qualifies inside f's own body (deepest nesting first: a nested
# function's own helpers lift before it is itself considered).
fun liftInFunction(f) => match(f.fBody)
  (bk: PeBlock) => llInBlock(f, bk)
  ()            => f

fun llInBlock(f0: PsFun, bk0: PeBlock)
  let bodyStmts = llDeepFirst(bk0.blockStmts, List())
  let rebuilt = PsFun(f0.fName, f0.fAttrs, f0.fGens, f0.fParams,
                      PeBlock(bodyStmts, bk0.blockValue, bk0.blockTag,
                              bk0.pebkLine),
                      f0.fRet, f0.fWheres, f0.psfLine, f0.fRetInferred,
                      f0.fNested, f0.fImports, f0.fGlobal)
  let nested = hoNestedFns2(bodyStmts, List())
  if isEmpty(nested)
    ret rebuilt
  ret llAnalyse(rebuilt, nested)

fun llDeepFirst(ss: List<PStmt>, acc: List<PStmt>) =>
  fold(ss, acc, llDeepFirstStep)

fun llDeepFirstStep(a: List<PStmt>, x: PStmt) => match(x)
  (nf: PsFun) => append(a, liftInFunction(nf))
  (o: PStmt) => append(a, x)

# ALL nested fns count here (Python gates on FunctionStatement only, not on
# block-bodied ones like the hoist does).
fun hoNestedFns2(ss: List<PStmt>, acc: List<PsFun>) =>
  fold(ss, acc, hoNestedFns2Step)

fun hoNestedFns2Step(a: List<PsFun>, x: PStmt) => match(x)
  (nf: PsFun) => append(a, nf)
  (o: PStmt) => a

class [final] LiftCtx(lcNames: List<String>, lcExtras: List<List<String>>)

fun llAnalyse(f, nested: List<PsFun>)
  let paramLets = flattenParams(f.fParams)
  let paramNames = allStmtNames(paramLets, List())
  let siblingNames = hoFnNames(nested, List())
  let captures = llCapturesOf(nested, siblingNames, paramNames,
                              List())
  let callEdges = hoCallEdges(nested, siblingNames,
                              EEdges(Dict()))
  let sccs = aiSccs(siblingNames, callEdges)
  let solved = llSolve(sccs, f, nested, siblingNames, captures,
                       callEdges, paramLets,
                       LlSolved(List(), List(),
                                List()))
  let ctx = llLiftSets(sccs, solved, siblingNames,
                       LiftCtx(List(), List()))
  if isEmpty(ctx.lcNames)
    ret f
  ret llRewrite(f, ctx, paramLets)

# The free references that name an enclosing parameter — a set intersection,
# and the Python compiler holds it as one. Sorted on the way out only because
# the slot it lands in is a List: the order carries no meaning, since every
# consumer unions these together and llLiftSets sorts the result before it
# reaches generated code.
fun llCapturesOf(fs: List<PsFun>, siblingNames: List<String>,
                 paramNames: List<String>,
                 acc: List<List<String>>) =>
  concat(acc, map(fs, (f) => sort(filter(freeRefs(f, siblingNames), (n) => contains(paramNames, n)))))

# Per-SCC solve, in reverse-topo order: the threaded set is the members'
# captures plus whatever already-solved callee SCCs thread; liftability
# fails when a callee SCC failed, when a member's name travels as a value,
# or when any threaded capture is [linear].
class [final] LlSolved(lsSccs: List<List<String>>, lsLiftable: List<Bool>,
                       lsThreaded: List<List<String>>)

fun llSolve(ss: List<List<String>>,
            f: PsFun,
            nested: List<PsFun>,
            siblingNames: List<String>,
            captures: List<List<String>>,
            edges: EEdges,
            paramLets: List<PStmt>,
            acc: LlSolved) =>
  fold(ss, acc, (a, x) => llSolveOne(x, f, nested, siblingNames, captures, edges, paramLets, a))

fun llSolveOne(scc, f: PsFun, nested: List<PsFun>,
               siblingNames: List<String>, captures: List<List<String>>,
               edges: EEdges, paramLets: List<PStmt>,
               acc: LlSolved)
  let want0 = llWant(scc, scc, siblingNames, captures, edges, acc,
                     List())
  let ok0 = llCalleesOk(scc, scc, edges, acc)
            && llRefsOk(scc, f)
  let ok = ok0 && !llAnyLinear(want0, paramLets)
  # Three POSITIONALLY paired lists — one entry per SCC, looked up by index.
  ret LlSolved(append(acc.lsSccs, scc),
               append(acc.lsLiftable, ok),
               append(acc.lsThreaded, want0))

fun llWant(ns: List<String>,
           own: List<String>,
           siblingNames: List<String>,
           captures: List<List<String>>,
           edges: EEdges,
           acc: LlSolved,
           out: List<String>) =>
  fold(ns, out, (a, x) => llCalleeWants(ceChildrenOf(edges,
                                                             x),
                                          own, acc,
                                          addNamesAll(
                                            llCapturesFor(siblingNames, captures, x),
                                            a)))

fun llCalleeWants(cs: List<String>, own: List<String>, acc: LlSolved, out: List<String>) =>
  fold(cs, out, (a, x) => contains(own, x) ? a : addNamesAll(llThreadedFor(acc, x), a))

# The entry of `vs` paired with the first entry of `ks` satisfying `p`.
fun llPairedWith<K, V>(ks: List<K>, vs: List<V>, p: (:K): Bool): V|None => match(findIndex(ks, p))
  (i: Int) => head(drop(vs, i))
  ()       => None

fun llCapturesFor(siblingNames: List<String>,
                  captures: List<List<String>>,
                  name: String) => llParallelGet(siblingNames, captures, name)

fun llParallelGet(ns: List<String>, vs: List<List<String>>,
                  name: String) => llPairedWith(ns, vs, (n) => n == name) ?? List()

fun llThreadedFor(acc: LlSolved, name: String) => llPairedWith(acc.lsSccs, acc.lsThreaded, (s) => contains(s, name)) ?? List()

fun llCalleesOk(ns: List<String>, own: List<String>, edges: EEdges, acc: LlSolved) =>
  all(ns, (x) => !(llCalleeBad(ceChildrenOf(edges, x), own, acc)))

fun llCalleeBad(cs: List<String>, own: List<String>, acc: LlSolved) =>
  any(cs, (x) => !contains(own, x) && llWasUnliftable(acc.lsSccs, acc.lsLiftable, x))

fun llWasUnliftable(ss: List<List<String>>, ls: List<Bool>,
                    name: String) => match(llPairedWith(ss, ls, (s) => contains(s, name)))
  (liftable: Bool) => !liftable
  ()               => false

# Total name references must equal call-position references for every member.
fun llRefsOk(ns: List<String>, f: PsFun): Bool => all(ns, (x) => !(llTotalRefs(f, x) != llCallRefs(f, x)))

fun llTotalRefs(f: PsFun, name: String): Int => llCount(f, (x) => llIsName(x, name))

fun llCallRefs(f: PsFun, name: String): Int => llCount(f, (x) => llIsCallOf(x, name))

# __reference_counts: the expressions under the body that `hit` holds for —
# lambda subtrees included, like Python.
fun llCount(f: PsFun, hit: (:PExpr): Bool): Int => match(f.fBody)
  (b: PExpr) => walkExpr(b, emptyResolverGlobal, 0,
                         Walk<Int>((n, _r, x) => (s = hit(x) ? n + 1 : n, r = None),
                                   wkNoStmt<Int>, wkNoSpec<Int>)).s
  ()         => 0

fun llAnyLinear(ns: List<String>, paramLets: List<PStmt>) => any(ns, (x) => llParamLinear(paramLets, x))

fun llParamLinear(ps: List<PStmt>, name) => any(ps, (x) => llParamLinearStep(x, name))

fun llParamLinearStep(x: PStmt, name) => match(x)
  (let2: PsLet) => let2.lName == name && hasAttr(let2.lAttrs, "linear")
  (o: PStmt) => false

# The lift sets: liftable SCCs with a non-empty threaded set, each member
# mapped to the SORTED captures.
fun llLiftSets(ss: List<List<String>>,
               solved: LlSolved,
               siblingNames: List<String>,
               acc: LiftCtx) =>
  fold(ss, acc, (a, x) => llLiftScc(x, x, solved, a))

fun llLiftScc(ns: List<String>, scc: List<String>, solved: LlSolved, acc: LiftCtx)
  let threaded = llThreadedFor(solved, llFirstOf(scc))
  let liftable = !llWasUnliftable(solved.lsSccs, solved.lsLiftable, llFirstOf(scc))
  if !liftable || isEmpty(threaded)
    ret acc
  ret fold(ns, acc, (a, n) => LiftCtx(append(a.lcNames, n), append(a.lcExtras, sort(threaded))))

fun llFirstOf(scc: List<String>) => head(scc) ?? ""

fun llIsName(x: PExpr, name: String): Bool => match(x)
  (nm: PeName) => nm.refName == name
  (o: PExpr)   => false

fun llIsCallOf(x: PExpr, name: String): Bool => match(x)
  (c: PeCall) => llIsName(c.function, name)
  (o: PExpr)  => false

# ── the rewrite ──────────────────────────────────────────────────────────────
# Calls to a lifted member gain the captured names as extra unnamed args (at
# the CALL's line); the member itself gains copies of the captured param lets.

fun llExtrasFor(ctx: LiftCtx, name: String)
  ret llParallelGet(ctx.lcNames, ctx.lcExtras, name)

fun llCallArgs(p) => match(p)
  (tp: PeTuple)   => tp.exprs
  (ng: PeNothing) => List()
  (o: PExpr)      => prepend(PTupEnt("", false, p), List())

# rewrite: one callback per kind over the whole function. A call to a lifted
# member gains the captured names as extra args; the member gains the copies.
fun llRewrite(f: PsFun, ctx: LiftCtx, paramLets: List<PStmt>): PStmt =>
  walkStmt(f, emptyResolverGlobal, false,
           Walk<Bool>((s, _r, x) => (s = s, r = llCallExpr(x, ctx)),
                      (s, _r, st) => (s = s, r = llFnStmt(st, ctx, paramLets)),
                      wkNoSpec<Bool>)).x

fun llFnStmt(st: PStmt, ctx: LiftCtx, paramLets: List<PStmt>): PStmt|None => match(st)
  (f: PsFun) => isEmpty(llExtrasFor(ctx, f.fName))
    ? None
    : llWithParams(f, llExtrasFor(ctx, f.fName), paramLets)
  (o: PStmt) => None

fun llWithParams(st, extras: List<String>,
                 paramLets: List<PStmt>) => match(st)
  (f: PsFun) => match(f.fParams)
    (d: PsDestructure) => PsFun(f.fName, f.fAttrs, f.fGens,
        PsDestructure(d.dName, d.dAttrs, d.dType,
                      concat(d.dTargets,
                             llParamCopies(extras, paramLets,
                                           List())),
                      d.dDefault, d.psdLine, d.dTypeInferred),
        f.fBody, f.fRet, f.fWheres, f.psfLine, f.fRetInferred, f.fNested,
        f.fImports, f.fGlobal)
    (o: PStmt)         => f
  (o2: PStmt) => st

fun llParamCopies(ns: List<String>, paramLets: List<PStmt>, acc: List<PStmt>) =>
  fold(ns, acc, (a, x) => llParamCopiesStep(a, x, paramLets))

fun llParamCopiesStep(a: List<PStmt>, x: String, paramLets: List<PStmt>) => match(llParamByName(paramLets, x))
  (p: PStmt) => append(a, p)
  () => a

fun llParamByName(ps: List<PStmt>, name) => firstWhere(ps, (x) => stmtName(x) == name)

fun llCallExpr(x: PExpr, ctx: LiftCtx): PExpr|None => match(x)
  (c: PeCall) => match(c.function)
    (nm: PeName) => isEmpty(llExtrasFor(ctx, nm.refName))
      ? None
      : with c(parameter = PeTuple(concat(llCallArgs(c.parameter),
                                          llExtraEnts(llExtrasFor(ctx, nm.refName), c.pecLine, List())),
                                   c.pecLine))
    (o: PExpr)   => None
  (o: PExpr) => None

fun llExtraEnts(ns: List<String>, lr, acc: List<PTupEnt>) =>
  fold(ns, acc, (a, x) => append(a, PTupEnt("", false, PeName(x, List(), lr, None))))
