# bootstrap/lambda_lift.yafl — lowering/lambda_lift.py: nested functions that
# capture only to be CALLED lose the closure — the captures become
# parameters, threaded at every call site.
#
# An SCC of sibling functions lifts as a unit. Conditions (all conservative):
# every capture is a PARAMETER of the enclosing function; no captured
# parameter is [linear]; every reference to every member is the callee of a
# call (total name references == call-position references). Runs BEFORE
# tail_loop: self-calls must still be calls.
namespace Bootstrap::Lower::Ast

import System

import Bootstrap::Ast
import Bootstrap::Frontend
import Bootstrap::Parse
import Bootstrap::Resolve
import Bootstrap::StdlibCandidates



fun liftCapturedCalls(statements: List<PStmt>) => llTop(statements, List())

fun llTop(ss, acc: List<PStmt>): List<PStmt> => build(llTopB(ss, acc))

fun [tail] llTopB(ss: List<PStmt>, [terminal] acc: List<PStmt>) => isEmpty(ss)
  ? acc
  : match(first(ss))
    (f: PsFun)   => llTopB(tail(ss), push(acc, liftInFunction(f)))
    (c: PsClass) => llTopB(tail(ss), push(acc, llInClass(c)))
    (o: PStmt)   => llTopB(tail(ss), push(acc, first(ss)))

# A class member is a function with a receiver; a nested helper inside one
# threads captured PARAMETERS exactly as it would inside a free function.
# `this` is not a parameter, so it is never threaded here — it stays implicit,
# and the hoist makes the helper a sibling member to keep it so.
fun llInClass(c): PStmt => hoClassDeclaresNested(c)
  ? with c(cMembers = llMembers(c.cMembers, List()))
  : c

fun llMembers(ss, acc: List<PStmt>): List<PStmt> => build(llMembersB(ss, acc))

fun [tail] llMembersB(ss: List<PStmt>, [terminal] acc: List<PStmt>) => isEmpty(ss)
  ? acc
  : match(first(ss))
    (f: PsFun) => llMembersB(tail(ss), push(acc, liftInFunction(f)))
    (o: PStmt) => llMembersB(tail(ss), push(acc, first(ss)))

# Lift what qualifies inside f's own body (deepest nesting first: a nested
# function's own helpers lift before it is itself considered).
fun liftInFunction(f) => match(f.fBody)
  (b: PExpr) => match(b)
    (bk: PeBlock) => llInBlock(f, bk)
    (o: PExpr)    => f
  ()         => f

fun llInBlock(f0: PsFun, bk0: PeBlock)
  let bodyStmts = llDeepFirst(bk0.blockStmts, List())
  let rebuilt = PsFun(f0.fName, f0.fAttrs, f0.fGens, f0.fParams,
                      PeBlock(bodyStmts, bk0.blockValue, bk0.blockTag,
                              bk0.pebkLine),
                      f0.fRet, f0.fWheres, f0.psfLine, f0.fRetInferred,
                      f0.fNested, f0.fImports)
  let nested = hoNestedFns2(bodyStmts, List())
  if isEmpty(nested)
    ret rebuilt
  ret llAnalyse(rebuilt, nested)

fun llDeepFirst(ss, acc: List<PStmt>): List<PStmt> => build(llDeepFirstB(ss, acc))

fun [tail] llDeepFirstB(ss: List<PStmt>, [terminal] acc: List<PStmt>) => isEmpty(ss)
  ? acc
  : match(first(ss))
    (nf: PsFun) => llDeepFirstB(tail(ss), push(acc, liftInFunction(nf)))
    (o: PStmt)  => llDeepFirstB(tail(ss), push(acc, first(ss)))

# ALL nested fns count here (Python gates on FunctionStatement only, not on
# block-bodied ones like the hoist does).
fun hoNestedFns2(ss, acc: List<PsFun>): List<PsFun> => build(hoNestedFns2B(ss, acc))

fun [tail] hoNestedFns2B(ss: List<PStmt>, [terminal] acc: List<PsFun>) => isEmpty(ss)
  ? acc
  : match(first(ss))
    (nf: PsFun) => hoNestedFns2B(tail(ss), push(acc, nf))
    (o: PStmt)  => hoNestedFns2B(tail(ss), acc)

class [final] LiftCtx(lcNames: List<String>, lcExtras: List<List<String>>)

fun llAnalyse(f, nested: List<PsFun>)
  let paramLets = flattenParams(f.fParams)
  let paramNames = allStmtNames(paramLets, List())
  let siblingNames = hoFnNames(nested, List())
  let captures = llCapturesOf(nested, siblingNames, paramNames,
                              List())
  let callEdges = hoCallEdges(nested, siblingNames,
                              EEdges(Dict()))
  let sccs = aiSccs(siblingNames, callEdges)
  let solved = llSolve(sccs, f, nested, siblingNames, captures,
                       callEdges, paramLets,
                       LlSolved(List(), List(),
                                List()))
  let ctx = llLiftSets(sccs, solved, siblingNames,
                       LiftCtx(List(), List()))
  if isEmpty(ctx.lcNames)
    ret f
  ret llStmt(f, ctx, paramLets)

fun llCapturesOf(fs, siblingNames: List<String>,
                        paramNames: List<String>,
                        acc: List<List<String>>)
  ret build(llCapturesOfB(fs, siblingNames, paramNames, acc))

fun [tail] llCapturesOfB(fs: List<PsFun>, siblingNames: List<String>,
                        paramNames: List<String>,
                        [terminal] acc: List<List<String>>) => isEmpty(fs)
  ? acc
  : llCapturesOfB(tail(fs), siblingNames, paramNames,
      push(acc,
          sort(filter(freeRefs(first(fs), siblingNames),
                      (n) => contains2(paramNames,
                                       n)))))

# Per-SCC solve, in reverse-topo order: the threaded set is the members'
# captures plus whatever already-solved callee SCCs thread; liftability
# fails when a callee SCC failed, when a member's name travels as a value,
# or when any threaded capture is [linear].
class [final] LlSolved(lsSccs: List<List<String>>, lsLiftable: List<Bool>,
                       lsThreaded: List<List<String>>)

fun [tail] llSolve(ss: List<List<String>>, f: PsFun, nested: List<PsFun>,
                   siblingNames: List<String>, captures: List<List<String>>,
                   edges: EEdges, paramLets: List<PStmt>,
                   acc: LlSolved) => isEmpty(ss)
  ? acc
  : llSolve(tail(ss), f, nested, siblingNames, captures,
                             edges, paramLets,
                             llSolveOne(first(ss), f, nested, siblingNames,
                                        captures, edges, paramLets, acc))

fun llSolveOne(scc, f: PsFun, nested: List<PsFun>,
               siblingNames: List<String>, captures: List<List<String>>,
               edges: EEdges, paramLets: List<PStmt>,
               acc: LlSolved)
  let want0 = llWant(scc, scc, siblingNames, captures, edges, acc,
                     List())
  let ok0 = llCalleesOk(scc, scc, edges, acc)
            && llRefsOk(scc, f)
  let ok = ok0 && !llAnyLinear(want0, paramLets)
  # Three POSITIONALLY paired lists — one entry per SCC, looked up by index.
  ret LlSolved(build(push(acc.lsSccs, scc)),
               build(push(acc.lsLiftable, ok)),
               build(push(acc.lsThreaded, want0)))

fun [tail] llWant(ns: List<String>, own: List<String>,
                  siblingNames: List<String>, captures: List<List<String>>,
                  edges: EEdges, acc: LlSolved,
                  out: List<String>) => isEmpty(ns)
  ? out
  : llWant(tail(ns), own, siblingNames, captures, edges,
                            acc,
                            llCalleeWants((ceChildrenOf(edges,
                                                             first(ns))),
                                          own, acc,
                                          addNamesAll(
                                            (llCapturesFor(
                                              siblingNames, captures,
                                              first(ns))),
                                            out)))

fun [tail] llCalleeWants(cs: List<String>, own: List<String>, acc: LlSolved,
                         out: List<String>) => isEmpty(cs)
  ? out
  : contains2(own, first(cs))
    ? llCalleeWants(tail(cs), own, acc, out)
    : llCalleeWants(tail(cs), own, acc,
                    addNamesAll((llThreadedFor(acc, first(cs))), out))

fun llCapturesFor(siblingNames: List<String>,
                  captures: List<List<String>>,
                  name: String) => llParallelGet(siblingNames, captures, name)

fun [tail] llParallelGet(ns: List<String>, vs: List<List<String>>,
                         name: String) => isEmpty(ns)
  ? List()
  : isEmpty(vs)
    ? List()
    : first(ns) == name
      ? first(vs)
      : llParallelGet(tail(ns), tail(vs), name)

fun llThreadedFor(acc: LlSolved, name: String)
  ret llThreadLoop(acc.lsSccs, acc.lsThreaded, name)

fun [tail] llThreadLoop(ss: List<List<String>>, ts: List<List<String>>,
                        name: String) => isEmpty(ss)
  ? List()
  : isEmpty(ts)
    ? List()
    : contains2(first(ss), name)
      ? first(ts)
      : llThreadLoop(tail(ss), tail(ts), name)

fun [tail] llCalleesOk(ns: List<String>, own: List<String>, edges: EEdges,
                       acc: LlSolved) => isEmpty(ns)
  ? true
  : llCalleeBad((ceChildrenOf(edges, first(ns))), own,
                                 acc)
    ? false
    : llCalleesOk(tail(ns), own, edges, acc)

fun [tail] llCalleeBad(cs: List<String>, own: List<String>,
                       acc: LlSolved) => isEmpty(cs)
  ? false
  : !contains2(own, first(cs))
                     && llWasUnliftable(acc.lsSccs,
                                        acc.lsLiftable, first(cs))
    ? true
    : llCalleeBad(tail(cs), own, acc)

fun [tail] llWasUnliftable(ss: List<List<String>>, ls: List<Bool>,
                           name: String) => isEmpty(ss)
  ? false
  : isEmpty(ls)
    ? false
    : contains2(first(ss), name)
      ? !first(ls)
      : llWasUnliftable(tail(ss), tail(ls), name)

# Total name references must equal call-position references for every member.
fun [tail] llRefsOk(ns: List<String>, f: PsFun): Bool => isEmpty(ns)
  ? true
  : llTotalRefs(f, first(ns)) != llCallRefs(f, first(ns))
    ? false
    : llRefsOk(tail(ns), f)

fun llTotalRefs(f: PsFun, name) => match(f.fBody)
  (b: PExpr) => llCountNames(b, name, 0)
  ()         => 0

fun llCallRefs(f: PsFun, name) => match(f.fBody)
  (b: PExpr) => llCountCalls(b, name, 0)
  ()         => 0

fun [tail] llAnyLinear(ns: List<String>, paramLets: List<PStmt>) => isEmpty(ns)
  ? false
  : llParamLinear(paramLets, first(ns))
    ? true
    : llAnyLinear(tail(ns), paramLets)

fun [tail] llParamLinear(ps: List<PStmt>, name) => isEmpty(ps)
  ? false
  : match(first(ps))
    (let2: PsLet) => let2.lName == name && hasAttr(let2.lAttrs, "linear")
      ? true
      : llParamLinear(tail(ps), name)
    (o: PStmt)    => llParamLinear(tail(ps), name)

# The lift sets: liftable SCCs with a non-empty threaded set, each member
# mapped to the SORTED captures.
fun [tail] llLiftSets(ss: List<List<String>>, solved: LlSolved,
                      siblingNames: List<String>, acc: LiftCtx) => isEmpty(ss)
  ? acc
  : llLiftSets(tail(ss), solved, siblingNames,
                                llLiftScc(first(ss), first(ss), solved,
                                          acc))

fun [tail] llLiftScc(ns: List<String>, scc: List<String>, solved: LlSolved,
                     acc: LiftCtx)
  let threaded = llThreadedFor(solved, llFirstOf(scc))
  let liftable = !llWasUnliftable(solved.lsSccs,
                                  solved.lsLiftable, llFirstOf(scc))
  if !liftable || isEmpty(threaded)
    ret acc
  ret isEmpty(ns)
    ? acc
    : llLiftScc(tail(ns), scc, solved,
        LiftCtx(build(push(acc.lcNames, first(ns))),
                build(push(acc.lcExtras, sort(threaded)))))

fun llFirstOf(scc: List<String>) => isEmpty(scc)
  ? ""
  : first(scc)

# ── the reference counters (lambda subtrees ARE visited, like Python) ───────

fun llCountNames(x, name, n)
  let n2 = llIsName(x, name) ? n + 1 : n
  ret llFold(x, name, n2, false)

fun llCountCalls(x, name, n)
  let n2 = llIsCallOf(x, name) ? n + 1 : n
  ret llFold(x, name, n2, true)

fun llIsName(x, name) => match(x)
  (nm: PeName) => nm.refName == name
  (o: PExpr)   => false

fun llIsCallOf(x, name) => match(x)
  (c: PeCall) => llIsName(c.function, name)
  (o: PExpr)  => false

fun llFold(x, name, n, calls: Bool): Int => match(x)
  (d: PeDot)     => llCountOne(d.base, name, n, calls)
  (c: PeCall)    => llCountOne(c.parameter, name,
                               llCountOne(c.function, name, n, calls),
                               calls)
  (qq: PeCoalesce)   => llCountOne(qq.qqFallback, name,
                               llCountOne(qq.qqSubject, name, n, calls),
                               calls)
  (wx: PeWith)   => llCountOne(wx.withRepls, name,
                               llCountOne(wx.withSubject, name, n, calls),
                               calls)
  (tp: PeTuple)  => llFoldEnts(tp.exprs, name, n, calls)
  (te: PeTernary) => llCountOne(te.falseResult, name,
                       llCountOne(te.trueResult, name,
                         llCountOne(te.condition, name, n, calls), calls),
                       calls)
  (lm: PeLambda) => llCountOne(lm.lamBody, name,
                               llFoldStmt(lm.lamParams, name, n, calls),
                               calls)
  (bk: PeBlock)  => llCountOne(bk.blockValue, name,
                               llFoldStmts(bk.blockStmts, name, n,
                                           calls),
                               calls)
  (mt: PeMatch)  => llFoldArms(mt.arms, name,
                               llCountOne(mt.subject, name, n, calls),
                               calls)
  (op: PeBuiltinOp) => llCountOne(op.opParams, name, n, calls)
  (nw: PeNew)    => llCountOne(nw.newParam, name, n, calls)
  (ar: PeArrayRead) => llCountOne(ar.arrIndex, name,
                                  llCountOne(ar.arrObj, name, n, calls),
                                  calls)
  (cv: PeConvert) => llCountOne(cv.convInner, name, n, calls)
  (pl: PeParallel) => llCountOne(pl.parParams, name, n, calls)
  (lp: PeLoop)   => llCountOne(lp.loopBody, name,
                               llFoldExprs(lp.loopParams, name, n,
                                           calls),
                               calls)
  (rc: PeRecur)  => llFoldExprs(rc.recArgs, name, n, calls)
  (ne: PeNewEnum) => fold(ne.fieldArgs, n, (a2, fa) =>
                          llCountOne(fa.faValue, name, a2, calls))
  (o: PeLiteral) => n
  (o: PeLazy) => n
  (o: PeName) => n

fun llCountOne(x, name, n, calls) => calls ? llCountCalls(x, name, n) : llCountNames(x, name, n)

fun [tail] llFoldExprs(es: List<PExpr>, name: String, n,
                       calls) => isEmpty(es)
  ? n
  : llFoldExprs(tail(es), name,
                                 llCountOne(first(es), name, n, calls),
                                 calls)

fun [tail] llFoldEnts(es: List<PTupEnt>, name, n,
                      calls: Bool): Int => isEmpty(es)
  ? n
  : llFoldEnts(tail(es), name,
                                llCountOne(first(es).tupValue, name, n,
                                           calls),
                                calls)

fun [tail] llFoldArms(as2: List<PArm>, name, n,
                      calls: Bool): Int => isEmpty(as2)
  ? n
  : llFoldArms(tail(as2), name,
      llFoldOpt(first(as2).armGuard, name,
                llCountOne(first(as2).armBody, name, n, calls), calls),
      calls)

fun llFoldOpt(x: PExpr|None, name, n, calls) => match(x)
  (e2: PExpr) => llCountOne(e2, name, n, calls)
  ()          => n

fun [tail] llFoldStmts(ss: List<PStmt>, name: String, n,
                       calls) => isEmpty(ss)
  ? n
  : llFoldStmts(tail(ss), name,
                                 llFoldStmt(first(ss), name, n, calls),
                                 calls)

fun llFoldStmt(st, name, n, calls: Bool): Int => match(st)
  (f: PsFun)   => llFoldOpt(f.fBody, name,
                            llFoldStmt(f.fParams, name, n, calls), calls)
  (l: PsLet)   => llFoldOpt(l.lDefault, name, n, calls)
  (d: PsDestructure) => llFoldStmts(d.dTargets, name,
                                    llFoldOpt(d.dDefault, name, n, calls),
                                    calls)
  (rt: PsRet)  => llCountOne(rt.retValue, name, n, calls)
  (a: PsAction) => llCountOne(a.action, name, n, calls)
  (i: PsIf)    => llFoldStmts(i.ifFalse, name,
                              llFoldStmts(i.ifTrue, name,
                                          llCountOne(i.ifCond, name, n,
                                                     calls),
                                          calls),
                              calls)
  (o: PStmt)   => n

# ── the rewrite ──────────────────────────────────────────────────────────────
# Calls to a lifted member gain the captured names as extra unnamed args (at
# the CALL's line); the member itself gains copies of the captured param lets.

fun llExtrasFor(ctx: LiftCtx, name: String)
  ret llParallelGet(ctx.lcNames, ctx.lcExtras, name)

fun llCallArgs(p) => match(p)
  (tp: PeTuple)   => tp.exprs
  (ng: PeNothing) => List()
  (o: PExpr)      => prepend(PTupEnt("", false, p), List())

fun llStmt(st, ctx: LiftCtx, paramLets: List<PStmt>) => match(st)
  (f: PsFun)  => llFnStmt(f, ctx, paramLets)
  (l: PsLet)  => PsLet(l.lName, l.lAttrs, l.lGens, l.lType,
                       llExprOpt(l.lDefault, ctx, paramLets), l.lArrayLen,
                       l.lWheres, l.pslLine, l.lTypeInferred, l.lImports)
  (d: PsDestructure) => PsDestructure(d.dName, d.dAttrs, d.dType,
                                      llStmts(d.dTargets, ctx,
                                              paramLets, List()),
                                      llExprOpt(d.dDefault, ctx,
                                                paramLets),
                                      d.psdLine, d.dTypeInferred)
  (rt: PsRet)  => PsRet(llExpr(rt.retValue, ctx, paramLets), rt.psrLine)
  (a: PsAction) => PsAction(llExpr(a.action, ctx, paramLets), a.psaLine)
  (i: PsIf)    => PsIf(llExpr(i.ifCond, ctx, paramLets),
                       llStmts(i.ifTrue, ctx, paramLets,
                               List()),
                       llStmts(i.ifFalse, ctx, paramLets,
                               List()),
                       i.psifLine)
  (o: PStmt)   => st

fun llFnStmt(f: PsFun, ctx: LiftCtx, paramLets: List<PStmt>)
  let rebuilt = PsFun(f.fName, f.fAttrs, f.fGens,
                      llStmt(f.fParams, ctx, paramLets),
                      llExprOpt(f.fBody, ctx, paramLets), f.fRet, f.fWheres,
                      f.psfLine, f.fRetInferred, f.fNested, f.fImports)
  let extras = llExtrasFor(ctx, f.fName)
  if isEmpty(extras)
    ret rebuilt
  ret llWithParams(rebuilt, extras, paramLets)

fun llWithParams(st, extras: List<String>,
                 paramLets: List<PStmt>) => match(st)
  (f: PsFun) => match(f.fParams)
    (d: PsDestructure) => PsFun(f.fName, f.fAttrs, f.fGens,
        PsDestructure(d.dName, d.dAttrs, d.dType,
                      concat(d.dTargets,
                             llParamCopies(extras, paramLets,
                                           List())),
                      d.dDefault, d.psdLine, d.dTypeInferred),
        f.fBody, f.fRet, f.fWheres, f.psfLine, f.fRetInferred, f.fNested,
        f.fImports)
    (o: PStmt)         => f
  (o2: PStmt) => st

fun llParamCopies(ns, paramLets: List<PStmt>,
                         acc: List<PStmt>) => build(llParamCopiesB(ns, paramLets, acc))

fun [tail] llParamCopiesB(ns: List<String>, paramLets: List<PStmt>,
                         [terminal] acc: List<PStmt>) => isEmpty(ns)
  ? acc
  : match(llParamByName(paramLets, first(ns)))
    (p: PStmt) => llParamCopiesB(tail(ns), paramLets, push(acc, p))
    ()         => llParamCopiesB(tail(ns), paramLets, acc)

fun [tail] llParamByName(ps: List<PStmt>, name) => isEmpty(ps)
  ? None
  : stmtName(first(ps)) == name
    ? first(ps)
    : llParamByName(tail(ps), name)

fun llStmts(ss, ctx: LiftCtx, paramLets: List<PStmt>,
                   acc: List<PStmt>) => build(llStmtsB(ss, ctx, paramLets, acc))

fun [tail] llStmtsB(ss: List<PStmt>, ctx: LiftCtx, paramLets: List<PStmt>,
                   [terminal] acc: List<PStmt>) => isEmpty(ss)
  ? acc
  : llStmtsB(tail(ss), ctx, paramLets,
                             push(acc, llStmt(first(ss), ctx, paramLets)))

fun llExprOpt(x: PExpr|None, ctx: LiftCtx, paramLets: List<PStmt>) => match(x)
  (e2: PExpr) => llExpr(e2, ctx, paramLets)
  ()          => None

fun llExpr(x, ctx: LiftCtx, paramLets: List<PStmt>) => match(x)
  (c: PeCall)    => llCallExpr(c, ctx, paramLets)
  (d: PeDot)     => PeDot(llExpr(d.base, ctx, paramLets), d.member,
                          d.pedLine)
  (tp: PeTuple)  => PeTuple(llEnts(tp.exprs, ctx, paramLets,
                                   List()),
                            tp.petLine)
  (te: PeTernary) => PeTernary(llExpr(te.condition, ctx, paramLets),
                               llExpr(te.trueResult, ctx, paramLets),
                               llExpr(te.falseResult, ctx, paramLets),
                               te.pety)
  (lm: PeLambda) => PeLambda(llStmt(lm.lamParams, ctx, paramLets),
                             llExpr(lm.lamBody, ctx, paramLets),
                             lm.pelLine, lm.lamRet)
  (bk: PeBlock)  => PeBlock(llStmts(bk.blockStmts, ctx, paramLets,
                                    List()),
                            llExpr(bk.blockValue, ctx, paramLets),
                            bk.blockTag, bk.pebkLine)
  (mt: PeMatch) => with mt(subject = llExpr(mt.subject, ctx, paramLets),
                    arms    = llArms(mt.arms, ctx, paramLets,
                                   List()))
  (op: PeBuiltinOp) => PeBuiltinOp(op.opType, op.opName,
                                   llExpr(op.opParams, ctx, paramLets),
                                   op.peboLine)
  (nw: PeNew)    => PeNew(nw.newType, llExpr(nw.newParam, ctx, paramLets),
                          nw.penwLine)
  (qq: PeCoalesce) => PeCoalesce(llExpr(qq.qqSubject, ctx, paramLets),
                                   llExpr(qq.qqFallback, ctx, paramLets),
                                   qq.peqqLine)
  (ar: PeArrayRead) => PeArrayRead(llExpr(ar.arrObj, ctx, paramLets),
                                   llExpr(ar.arrIndex, ctx, paramLets),
                                   ar.pearLine)
  (cv: PeConvert) => PeConvert(llExpr(cv.convInner, ctx, paramLets),
                               cv.convTarget, cv.pecvLine)
  (wx: PeWith)   => PeWith(llExpr(wx.withSubject, ctx, paramLets),
                           llExpr(wx.withRepls, ctx, paramLets),
                           wx.pewLine)
  (pl: PeParallel) => PeParallel(llExpr(pl.parParams, ctx, paramLets),
                                 pl.pepLine)
  (lp: PeLoop)   => PeLoop(llExpr(lp.loopBody, ctx, paramLets),
                           lp.loopParams, lp.pelpLine)
  (rc: PeRecur)  => PeRecur(llExprs(rc.recArgs, ctx, paramLets,
                                    List()),
                            rc.recIndex, rc.percLine)
  (ne: PeNewEnum) => PeNewEnum(ne.rootName, ne.leafName,
                               map(ne.fieldArgs, (fa) =>
                                 PFieldArg(fa.faName, llExpr(fa.faValue, ctx, paramLets))),
                               ne.neTypeParams, ne.penewLine)
  (o: PeLiteral) => x
  (o: PeLazy) => x
  (o: PeName) => x

fun llCallExpr(c: PeCall, ctx: LiftCtx, paramLets: List<PStmt>)
  let rebuilt = PeCall(llExpr(c.function, ctx, paramLets),
                       llExpr(c.parameter, ctx, paramLets), c.pecLine)
  ret match(rebuilt.function)
    (nm: PeName) => isEmpty(llExtrasFor(ctx, nm.refName))
      ? rebuilt
      : PeCall(rebuilt.function,
               PeTuple(concat(llCallArgs(rebuilt.parameter),
                              llExtraEnts((llExtrasFor(ctx,
                                                            nm.refName)),
                                          rebuilt.pecLine, List())),
                       rebuilt.pecLine),
               rebuilt.pecLine)
    (o: PExpr)   => rebuilt

fun llExtraEnts(ns, lr,
                       acc: List<PTupEnt>): List<PTupEnt>
  ret build(llExtraEntsB(ns, lr, acc))

fun [tail] llExtraEntsB(ns: List<String>, lr,
                       [terminal] acc: List<PTupEnt>) => isEmpty(ns)
  ? acc
  : llExtraEntsB(tail(ns), lr,
      push(acc, PTupEnt("", false,
                PeName(first(ns), List(), lr, None))))

fun llExprs(es, ctx: LiftCtx, paramLets: List<PStmt>,
                   acc: List<PExpr>) => build(llExprsB(es, ctx, paramLets, acc))

fun [tail] llExprsB(es: List<PExpr>, ctx: LiftCtx, paramLets: List<PStmt>,
                   [terminal] acc: List<PExpr>) => isEmpty(es)
  ? acc
  : llExprsB(tail(es), ctx, paramLets,
                             push(acc, llExpr(first(es), ctx, paramLets)))

fun llEnts(es: List<PTupEnt>, ctx: LiftCtx, paramLets: List<PStmt>,
                  acc: List<PTupEnt>) => build(llEntsB(es, ctx, paramLets, acc))

fun [tail] llEntsB(es: List<PTupEnt>, ctx: LiftCtx, paramLets: List<PStmt>,
                  [terminal] acc): List<PTupEnt> => isEmpty(es)
  ? acc
  : llEntsB(tail(es), ctx, paramLets,
      push(acc, PTupEnt(first(es).tupName, first(es).tupSpread,
                llExpr(first(es).tupValue, ctx, paramLets))))

fun llArms(as2, ctx: LiftCtx, paramLets: List<PStmt>,
                  acc: List<PArm>) => build(llArmsB(as2, ctx, paramLets, acc))

fun [tail] llArmsB(as2: List<PArm>, ctx: LiftCtx, paramLets: List<PStmt>,
                  [terminal] acc: List<PArm>) => isEmpty(as2)
  ? acc
  : llArmsB(tail(as2), ctx, paramLets,
      push(acc, with first(as2)(armBody = llExpr(first(as2).armBody, ctx, paramLets), armGuard = llExprOpt(first(as2).armGuard, ctx, paramLets))))
