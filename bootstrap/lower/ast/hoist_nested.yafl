# bootstrap/hoist_nested.yafl — lowering/hoist_nested.py: hoist nested
# FunctionStatements out of function bodies — its own pipeline stage, run
# BEFORE tail_loop (a declaration carried inside a LoopExpression would be
# invisible to every later body scan). The machinery lives in
# ast_inline.yafl, exactly as Python's lives in lowering/ast_inline.py.
namespace Bootstrap::Lower::Ast

import System

import Bootstrap::Ast



fun hoistNestedFunctions(statements: List<PStmt>): List<PStmt>
  ret hoistNestedFnsToLambdas(statements)
