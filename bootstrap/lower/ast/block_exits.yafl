# bootstrap/block_exits.yafl — lowering/block_exits.py: stamp every block with
# a unique '@'-bearing tag and every return with a per-walk ordinal, late —
# after every pass that creates or copies blocks — so each block instance
# (inlined copies included) owns its exit labels. Lowering-time ordinals,
# PYTHONHASHSEED-independent. Two counters over one deterministic walk ==
# two independent single-counter walks in the same traversal order.
namespace Bootstrap::Lower::Ast

import System
import System::Containers

import Bootstrap::Ast
import Bootstrap::Resolve



# Numbering reads no types, so the walk starts from the empty root.
fun assignBlockExits(statements: List<PStmt>): List<PStmt>
  let blocks = walkStmts(statements, emptyResolverGlobal, 0,
                         Walk<Int>((n, _sc, x) => beBlockCb(n, x), wkNoStmt<Int>, wkNoSpec<Int>)).x
  ret walkStmts(blocks, emptyResolverGlobal, 0,
                Walk<Int>(wkNoExpr<Int>, (n, _sc, st) => beRetCb(n, st), wkNoSpec<Int>)).x

fun beBlockCb(n: Int, x: PExpr): (s: Int, r: PExpr|None) => match(x)
  (bk: PeBlock) => (s = n + 1, r = with bk(blockTag = "blk@" + String(n)))
  (o: PExpr)    => (s = n, r = None)

fun beRetCb(n: Int, st: PStmt): (s: Int, r: PStmt|None) => match(st)
  (rt: PsRet) => (s = n + 1, r = with rt(retIndex = n))
  (o: PStmt)  => (s = n, r = None)
