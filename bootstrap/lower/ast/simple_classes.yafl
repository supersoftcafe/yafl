# bootstrap/simple_classes.yafl — lowering/simple_classes.py: lower "simple"
# classes to flat structs + free functions.
#
# A class qualifies as simple if it: is not an interface, has no inheritance,
# has at most 4 fields (none a trailing variable-length array), is not used
# as a base class by anyone, is not self-recursive (directly or through
# other candidates), has no method reference used standalone (every
# DotExpression naming one of its methods is immediately called), and does
# not collide with another union member once flattened.
#
# Qualifying classes are replaced throughout the AST:
#   ClassSpec(name)                          -> TupleSpec(fields)
#   NewExpression(TupleSpec, params)         -> params
#   CallExpression(NamedExpression(cls), a)  -> a           (ctor -> flat tuple)
#   b.method(args)                           -> ClassName__method(b, args)
#
# Each method is lifted to a top-level PsFun whose first parameter is
# "$this: TupleSpec(fields)". The PsClass itself is dropped.
namespace Bootstrap::Lower::Ast

import System

import Bootstrap::Ast
import Bootstrap::Frontend
import Bootstrap::Parse
import Bootstrap::Resolve



# ── candidate / spec bookkeeping (parallel lists — Dict has no keys()) ──────

# Lists carry ITERATION ORDER; the Dict carries LOOKUP (user ruling
# 2026-07-22: port Python dicts as Dict for lookups — lists only where
# the code iterates the map as a list). scCandsAdd/scSpecsAdd keep both
# in step; add-if-absent preserves the old first-hit-wins lookup.
class [final] ScCands(scNames: List<String>, scClasses: List<PsClass>,
                      scIndex: Dict<String, PsClass>)
class [final] ScSpecs(ssNames: List<String>, ssSpecs: List<Spec>,
                      ssIndex: Dict<String, Spec>)
class [final] ScFiltered(sfCands: ScCands, sfSpecs: ScSpecs)

# ── generic name -> Int lookup/bump (shared by method-ref and uid counts) ───

fun scCountOf(names: List<String>, vals: List<Int>, name: String): Int
  ret scCountLoop(chain(names), chain(vals), name)

fun [tail] scCountLoop(ns: Chain<String>, vs: Chain<Int>, name: String): Int
  ret match(ns)
    (nil: ChainEnd) => 0
    (n: ChainLink)  => match(vs)
      (nil2: ChainEnd) => 0
      (v: ChainLink)   => n.value == name ? v.value : scCountLoop(n.next, v.next, name)

fun scBumpAt(ns: Chain<String>, vs: Chain<Int>, name: String,
                    acc: List<Int>): List<Int>
  ret build<Int >(scBumpAtB(ns, vs, name, _pushChain<Int >(builder<Int >(), chain<Int >(acc))))

fun [tail] scBumpAtB(ns: Chain<String>, vs: Chain<Int>, name: String,
                    [terminal] acc: ListBuilder<Int >): ListBuilder<Int >
  ret match(ns)
    (nil: ChainEnd) => acc
    (n: ChainLink)  => match(vs)
      (nil2: ChainEnd) => acc
      (v: ChainLink)   => scBumpAtB(n.next, v.next, name,
                                   push<Int >(acc, n.value == name ? v.value + 1 : v.value))

# ── generic candidate/spec filtering by predicate on name ───────────────────

fun scKeepCandsWhere(cands: ScCands, pred: (:String): Bool): ScCands
  ret scKcLoop(chain(cands.scNames), chain(cands.scClasses), pred,
               scCandsEmpty())

fun [tail] scKcLoop(ns: Chain<String>, cs: Chain<PsClass>, pred: (:String): Bool,
                    acc: ScCands): ScCands
  ret match(ns)
    (nil: ChainEnd) => acc
    (n: ChainLink)  => match(cs)
      (nil2: ChainEnd) => acc
      (c: ChainLink)   => pred(n.value)
        ? scKcLoop(n.next, c.next, pred,
                   scCandsAdd(acc, n.value, c.value))
        : scKcLoop(n.next, c.next, pred, acc)

fun scKeepSpecsWhere(specs: ScSpecs, pred: (:String): Bool): ScSpecs
  ret scKsLoop(chain(specs.ssNames), chain(specs.ssSpecs), pred,
               scSpecsEmpty())

fun [tail] scKsLoop(ns: Chain<String>, sps: Chain<Spec>, pred: (:String): Bool,
                    acc: ScSpecs): ScSpecs
  ret match(ns)
    (nil: ChainEnd) => acc
    (n: ChainLink)  => match(sps)
      (nil2: ChainEnd) => acc
      (s2: ChainLink)  => pred(n.value)
        ? scKsLoop(n.next, s2.next, pred,
                   scSpecsAdd(acc, n.value, s2.value))
        : scKsLoop(n.next, s2.next, pred, acc)

fun scCandsEmpty(): ScCands
  ret ScCands(List<String>(), List<PsClass>(), Dict<String, PsClass>())

fun scSpecsEmpty(): ScSpecs
  ret ScSpecs(List<String>(), List<Spec>(), Dict<String, Spec>())

fun scCandsAdd(acc: ScCands, name: String, cls: PsClass): ScCands
  ret ScCands(append(acc.scNames, name), append(acc.scClasses, cls),
              get(acc.scIndex, name) is None
                ? put(acc.scIndex, name, cls)
                : acc.scIndex)

fun scSpecsAdd(acc: ScSpecs, name: String, spec: Spec): ScSpecs
  ret ScSpecs(append(acc.ssNames, name), append(acc.ssSpecs, spec),
              get(acc.ssIndex, name) is None
                ? put(acc.ssIndex, name, spec)
                : acc.ssIndex)

fun scLookupSpec(specs: ScSpecs, name: String): Spec|None
  ret get(specs.ssIndex, name)

fun scClassFor(cands: ScCands, name: String): PsClass|None
  ret get(cands.scIndex, name)

fun scMethodNames(cls: PsClass): List<String>
  ret scMnLoop(chain(cls.cMembers), List<String>())

fun scMnLoop(ms: Chain<PStmt>, acc: List<String>): List<String>
  ret build<String >(scMnLoopB(ms, _pushChain<String >(builder<String >(), chain<String >(acc))))

fun [tail] scMnLoopB(ms: Chain<PStmt>, [terminal] acc: ListBuilder<String >): ListBuilder<String >
  ret match(ms)
    (nil: ChainEnd) => acc
    (l: ChainLink)  => match(l.value)
      (f: PsFun) => scMnLoopB(l.next, push<String >(acc, f.fName))
      (o: PStmt) => scMnLoopB(l.next, acc)

fun scHasMethod(cands: ScCands, clsName: String, methodName: String): Bool
  ret match(scClassFor(cands, clsName))
    (cls: PsClass) => contains2(scMethodNames(cls), methodName)
    ()             => false

# ── 1. isSimpleClass ─────────────────────────────────────────────────────────

fun scIsSimple(cls: PsClass, baseNames: List<String>): Bool
  if cls.cIsInterface
    ret false
  if hasAttr(cls.cAttrs, "foreign")
    ret false
  # Classes that are published into after construction need a real object with
  # a stable identity to write through; flattening one to an unboxed struct
  # would leave nothing to publish to. [mutable] says so by being writable at
  # any time; [pinnable] says so for an object that is immutable except inside
  # a late pin, which is a heap object for the same reason — the pin lives in
  # its vtable word, and a value struct has none.
  if hasAttr(cls.cAttrs, "mutable") || hasAttr(cls.cAttrs, "pinnable")
    ret false
  if !isEmpty(cls.cImplements)
    ret false
  if contains2(baseNames, cls.cName)
    ret false
  let fields = flattenParams(cls.cParams)
  if atLeast(chain(fields), 5)
    ret false
  ret !scHasArrayField(chain(fields))

fun [tail] scHasArrayField(fs: Chain<PStmt>): Bool
  ret match(fs)
    (nil: ChainEnd) => false
    (l: ChainLink)  => match(l.value)
      (let2: PsLet) => match(arrayElem(let2.lType))
        (el: Spec) => true
        ()         => scHasArrayField(l.next)
      (o: PStmt)    => scHasArrayField(l.next)

# ── 2. findSimpleClasses ─────────────────────────────────────────────────────

fun scAllClasses(statements: List<PStmt>): ScCands
  ret scAcLoop(chain(statements), scCandsEmpty())

fun [tail] scAcLoop(ss: Chain<PStmt>, acc: ScCands): ScCands
  ret match(ss)
    (nil: ChainEnd) => acc
    (l: ChainLink)  => match(l.value)
      (c: PsClass) => scAcLoop(l.next,
                               scCandsAdd(acc, c.cName, c))
      (o: PStmt)   => scAcLoop(l.next, acc)

fun scBaseClassNames(all2: ScCands): List<String>
  ret scBcnLoop(chain(all2.scClasses), List<String>())

fun [tail] scBcnLoop(cs: Chain<PsClass>, acc: List<String>): List<String>
  ret match(cs)
    (nil: ChainEnd) => acc
    (l: ChainLink)  => scBcnLoop(l.next, scBcnParents(l.value.cAllParents, acc))

fun scBcnParents(parents: List<Spec>|None, acc: List<String>): List<String>
  ret match(parents)
    (ps: List<Spec>) => scBcnList(chain(ps), acc)
    ()               => acc

fun [tail] scBcnList(ps: Chain<Spec>, acc: List<String>): List<String>
  ret match(ps)
    (nil: ChainEnd) => acc
    (l: ChainLink)  => match(l.value)
      (c: SClass) => scBcnList(l.next, addNameOnce(acc, c.scName))
      (o: Spec)   => scBcnList(l.next, acc)

fun [tail] scFilterSimple(ns: Chain<String>, cs: Chain<PsClass>, baseNames: List<String>,
                          acc: ScCands): ScCands
  ret match(ns)
    (nil: ChainEnd) => acc
    (n: ChainLink)  => match(cs)
      (nil2: ChainEnd) => acc
      (c: ChainLink)   => scIsSimple(c.value, baseNames)
        ? scFilterSimple(n.next, c.next, baseNames,
                         scCandsAdd(acc, n.value, c.value))
        : scFilterSimple(n.next, c.next, baseNames, acc)

fun scFindSimpleClasses(statements: List<PStmt>): ScCands
  let all2 = scAllClasses(statements)
  let baseNames = scBaseClassNames(all2)
  let simple = scFilterSimple(chain(all2.scNames), chain(all2.scClasses), baseNames,
                              scCandsEmpty())
  ret scPruneRecursive(simple)

# ── 3. pruneRecursive (reuses EEdges / aiReachesSelf from complex_enums.yafl
#      and ast_inline.yafl) ──────────────────────────────────────────────────

fun scCollectRefs(sp: Spec, candNames: List<String>, acc: List<String>): List<String>
  ret match(sp)
    (c: SClass)        => scAddIfCand(c.scName, candNames, scRefList(chain(c.scParams), candNames, acc))
    (n: SNamed)        => scAddIfCand(n.snName, candNames, scRefList(chain(n.snParams), candNames, acc))
    (e2: SEnum)        => scRefList(chain(e2.seParams), candNames, acc)
    (cm: SCombination) => scRefList(chain(cm.scTypes), candNames, acc)
    (cl: SCallable)    => scRefOpt(cl.scResult, candNames, scCollectRefs(cl.scParams2, candNames, acc))
    (t2: STuple)       => scRefEntries(chain(t2.stEntries), candNames, acc)
    (af: SArrayField)  => scCollectRefs(af.safElem, candNames, acc)
    (ls: SLazyStub)    => scRefOpt(ls.slsTarget, candNames, acc)
    (o: Spec)          => acc

fun [tail] scRefList(ts: Chain<Spec>, candNames: List<String>, acc: List<String>): List<String>
  ret match(ts)
    (nil: ChainEnd) => acc
    (l: ChainLink)  => scRefList(l.next, candNames, scCollectRefs(l.value, candNames, acc))

fun scRefOpt(sp: Spec|None, candNames: List<String>, acc: List<String>): List<String>
  ret match(sp)
    (s2: Spec) => scCollectRefs(s2, candNames, acc)
    ()         => acc

fun [tail] scRefEntries(es: Chain<SEntry>, candNames: List<String>, acc: List<String>): List<String>
  ret match(es)
    (nil: ChainEnd) => acc
    (l: ChainLink)  => scRefEntries(l.next, candNames, scRefOpt(l.value.seType, candNames, acc))

fun scAddIfCand(name: String, candNames: List<String>, acc: List<String>): List<String>
  ret contains2(candNames, name) ? addNameOnce(acc, name) : acc

fun scReferencedNames(cls: PsClass, candNames: List<String>): List<String>
  ret scRefFields(chain(flattenParams(cls.cParams)), candNames, List<String>())

fun [tail] scRefFields(fs: Chain<PStmt>, candNames: List<String>, acc: List<String>): List<String>
  ret match(fs)
    (nil: ChainEnd) => acc
    (l: ChainLink)  => match(l.value)
      (let2: PsLet) => match(let2.lType)
        (ty: Spec) => scRefFields(l.next, candNames, scCollectRefs(ty, candNames, acc))
        ()         => scRefFields(l.next, candNames, acc)
      (o: PStmt)    => scRefFields(l.next, candNames, acc)

fun scBuildEdges(cands: ScCands): EEdges
  ret scBeLoop(chain(cands.scNames), chain(cands.scClasses), cands.scNames,
               EEdges(List<String>(), List<List<String>>()))

fun [tail] scBeLoop(ns: Chain<String>, cs: Chain<PsClass>, candNames: List<String>,
                    acc: EEdges): EEdges
  ret match(ns)
    (nil: ChainEnd) => acc
    (n: ChainLink)  => match(cs)
      (nil2: ChainEnd) => acc
      (c: ChainLink)   => scBeLoop(n.next, c.next, candNames,
          EEdges(append(acc.eeNames, n.value),
                 append(acc.eeChildren, scReferencedNames(c.value, candNames))))

fun scPruneRecursive(cands: ScCands): ScCands
  let edges = scBuildEdges(cands)
  ret scPruneLoop(chain(cands.scNames), chain(cands.scClasses), edges,
                  scCandsEmpty())

fun [tail] scPruneLoop(ns: Chain<String>, cs: Chain<PsClass>, edges: EEdges,
                       acc: ScCands): ScCands
  ret match(ns)
    (nil: ChainEnd) => acc
    (n: ChainLink)  => match(cs)
      (nil2: ChainEnd) => acc
      (c: ChainLink)   => aiReachesSelf(n.value, edges)
        ? scPruneLoop(n.next, c.next, edges, acc)
        : scPruneLoop(n.next, c.next, edges,
                     scCandsAdd(acc, n.value, c.value))

# ── 4. buildTupleSpecs ───────────────────────────────────────────────────────

fun scTupleSpecOf(cls: PsClass): Spec
  ret STuple(scEntriesOf(chain(flattenParams(cls.cParams)), List<SEntry>()), cls.pscLine)

fun scEntriesOf(fs: Chain<PStmt>, acc: List<SEntry>): List<SEntry>
  ret build<SEntry >(scEntriesOfB(fs, _pushChain<SEntry >(builder<SEntry >(), chain<SEntry >(acc))))

fun [tail] scEntriesOfB(fs: Chain<PStmt>, [terminal] acc: ListBuilder<SEntry >): ListBuilder<SEntry >
  ret match(fs)
    (nil: ChainEnd) => acc
    (l: ChainLink)  => match(l.value)
      (let2: PsLet) => scEntriesOfB(l.next, push<SEntry >(acc, SEntry(let2.lName, let2.lType, None)))
      (o: PStmt)    => scEntriesOfB(l.next, acc)

fun scBuildTupleSpecs(cands: ScCands): ScSpecs
  ret scBtsLoop(chain(cands.scNames), chain(cands.scClasses), scSpecsEmpty())

fun [tail] scBtsLoop(ns: Chain<String>, cs: Chain<PsClass>, acc: ScSpecs): ScSpecs
  ret match(ns)
    (nil: ChainEnd) => acc
    (n: ChainLink)  => match(cs)
      (nil2: ChainEnd) => acc
      (c: ChainLink)   => scBtsLoop(n.next, c.next,
          scSpecsAdd(acc, n.value, scTupleSpecOf(c.value)))

# ── 5. lowerNestedFieldTypes fixpoint ────────────────────────────────────────
# `specsFixed` is the ORIGINAL, never-mutated map the rule substitutes from
# (mirrors Python's closure over the untouched `simple_tuple_specs`); `specs`
# is the working copy re-derived to a fixpoint each round.

class [final] ScLnftOut(lrSpecs: ScSpecs, lrChanged: Bool)

fun scLnftRule(sp: Spec, cands: List<String>, specsFixed: ScSpecs): Spec|None
  ret match(sp)
    (c: SClass) => contains2(cands, c.scName) ? scLookupSpec(specsFixed, c.scName) : None
    (o: Spec)   => None

fun scLnftStep(nrest: Chain<String>, srest: Chain<Spec>, cands: List<String>,
              specsFixed: ScSpecs, acc: ScSpecs, changed: Bool, name: String,
              spec: Spec): ScLnftOut
  let newSpec = rwSpec(spec, rwOnSpec((sp: Spec) => scLnftRule(sp, cands, specsFixed)))
  ret eqSpec(newSpec, spec)
    ? scLnftRound(nrest, srest, cands, specsFixed,
                 scSpecsAdd(acc, name, spec), changed)
    : scLnftRound(nrest, srest, cands, specsFixed,
                 scSpecsAdd(acc, name, newSpec), true)

fun scLnftRound(ns: Chain<String>, sps: Chain<Spec>, cands: List<String>,
                specsFixed: ScSpecs, acc: ScSpecs, changed: Bool): ScLnftOut
  ret match(ns)
    (nil: ChainEnd) => ScLnftOut(acc, changed)
    (n: ChainLink)  => match(sps)
      (nil2: ChainEnd) => ScLnftOut(acc, changed)
      (s2: ChainLink)  => scLnftStep(n.next, s2.next, cands, specsFixed, acc, changed,
                                    n.value, s2.value)

fun [tail] scLnftFix(cands: List<String>, specsFixed: ScSpecs, specs: ScSpecs): ScSpecs
  let out = scLnftRound(chain(specs.ssNames), chain(specs.ssSpecs), cands, specsFixed,
                        scSpecsEmpty(), false)
  ret out.lrChanged ? scLnftFix(cands, specsFixed, out.lrSpecs) : out.lrSpecs

fun scLowerNestedFieldTypes(cands: List<String>, specs0: ScSpecs): ScSpecs
  ret scLnftFix(cands, specs0, specs0)

# ── 6. excludeStandaloneMethodRefs ───────────────────────────────────────────

class [final] ScCounts(cnNames: List<String>, cnAll: List<Int>, cnCalled: List<Int>)

fun scEmptyCounts(): ScCounts
  ret ScCounts(List<String>(), List<Int>(), List<Int>())

fun scBumpAll(cc: ScCounts, name: String): ScCounts
  ret contains2(cc.cnNames, name)
    ? ScCounts(cc.cnNames, scBumpAt(chain(cc.cnNames), chain(cc.cnAll), name, List<Int>()),
               cc.cnCalled)
    : ScCounts(append(cc.cnNames, name), append(cc.cnAll, 1), append(cc.cnCalled, 0))

fun scBumpCalled(cc: ScCounts, name: String): ScCounts
  ret contains2(cc.cnNames, name)
    ? ScCounts(cc.cnNames, cc.cnAll,
               scBumpAt(chain(cc.cnNames), chain(cc.cnCalled), name, List<Int>()))
    : ScCounts(append(cc.cnNames, name), append(cc.cnAll, 0), append(cc.cnCalled, 1))

fun scCountAll(cc: ScCounts, name: String): Int
  ret scCountOf(cc.cnNames, cc.cnAll, name)

fun scCountCalled(cc: ScCounts, name: String): Int
  ret scCountOf(cc.cnNames, cc.cnCalled, name)

fun scClassNameOf(base: PExpr, cands: ScCands, r: Resolver): String|None
  ret match(exprType(base, r))
    (bt: Spec) => match(bt)
      (cs2: SClass) => contains2(cands.scNames, cs2.scName) ? cs2.scName : None
      (o: Spec)     => None
    ()         => None

fun scDotHit(acc: ScCounts, d: PeDot, cands: ScCands, r: Resolver): ScCounts
  ret match(scClassNameOf(d.base, cands, r))
    (clsName: String) => scHasMethod(cands, clsName, d.member) ? scBumpAll(acc, clsName) : acc
    ()                => acc

fun scCalledHit(acc: ScCounts, d: PeDot, cands: ScCands, r: Resolver): ScCounts
  ret match(scClassNameOf(d.base, cands, r))
    (clsName: String) => scHasMethod(cands, clsName, d.member) ? scBumpCalled(acc, clsName) : acc
    ()                => acc

# NOTE: a called dot bumps BOTH counters — foldExpr fires fx on the PeCall
# node (bumping "called"), then separately descends into its PeDot child
# (bumping "all"), exactly mirroring Python's search_and_replace traversal.
fun scDotFold(acc: ScCounts, x: PExpr, cands: ScCands, r: Resolver): ScCounts
  ret match(x)
    (d: PeDot)  => scDotHit(acc, d, cands, r)
    (c: PeCall) => match(c.function)
      (d2: PeDot) => scCalledHit(acc, d2, cands, r)
      (o: PExpr)  => acc
    (o: PExpr)  => acc

fun scExcludeStandalone(cands: ScCands, specs: ScSpecs, statements: List<PStmt>,
                        r: Resolver): ScFiltered
  let counts = foldStmts<ScCounts>(statements, foldNoStmt<ScCounts>,
      (acc: ScCounts, x: PExpr) => scDotFold(acc, x, cands, r), scEmptyCounts())
  ret ScFiltered(
      scKeepCandsWhere(cands, (n: String) => scCountAll(counts, n) <= scCountCalled(counts, n)),
      scKeepSpecsWhere(specs, (n: String) => scCountAll(counts, n) <= scCountCalled(counts, n)))

# ── 7. excludeUnionCollisions ────────────────────────────────────────────────
# Collecting every SCombination anywhere in the statement tree needs its own
# small stmt/expr/spec fold — the SAME visit law as rwStmtKids/rwExprKids/
# rwSpecKids (see rewrite.yafl's header comment), restricted to accumulation.

fun [tail] scCuEntries(es: Chain<SEntry>, acc: List<Spec>): List<Spec>
  ret match(es)
    (nil: ChainEnd) => acc
    (l: ChainLink)  => scCuEntries(l.next, scCuSpecOpt(l.value.seType, acc))

fun scCuSpec(sp: Spec, acc: List<Spec>): List<Spec>
  let acc2 = match(sp)
    (cm: SCombination) => append(acc, sp)
    (o: Spec)          => acc
  ret match(sp)
    (e2: SEnum)         => scCuSpecs(chain(e2.seParams), acc2)
    (cl: SClass)        => scCuSpecs(chain(cl.scParams), acc2)
    (n: SNamed)         => acc2
    (cm2: SCombination) => scCuSpecs(chain(cm2.scTypes), acc2)
    (t2: STuple)        => scCuEntries(chain(t2.stEntries), acc2)
    (cb: SCallable)     => scCuSpecOpt(cb.scResult, scCuSpec(cb.scParams2, acc2))
    (af: SArrayField)   => scCuSpec(af.safElem, acc2)
    (ls: SLazyStub)     => scCuSpecOpt(ls.slsTarget, acc2)
    (o2: Spec)          => acc2

fun scCuSpecOpt(sp: Spec|None, acc: List<Spec>): List<Spec>
  ret match(sp)
    (s2: Spec) => scCuSpec(s2, acc)
    ()         => acc

fun scCuSpecsOpt(ss: List<Spec>|None, acc: List<Spec>): List<Spec>
  ret match(ss)
    (l: List<Spec>) => scCuSpecs(chain(l), acc)
    ()              => acc

fun [tail] scCuSpecs(ss: Chain<Spec>, acc: List<Spec>): List<Spec>
  ret match(ss)
    (nil: ChainEnd) => acc
    (l: ChainLink)  => scCuSpecs(l.next, scCuSpec(l.value, acc))

fun [tail] scCuTupEnts(es: Chain<PTupEnt>, acc: List<Spec>): List<Spec>
  ret match(es)
    (nil: ChainEnd) => acc
    (l: ChainLink)  => scCuTupEnts(l.next, scCuExpr(l.value.tupValue, acc))

fun [tail] scCuLits(ls: Chain<PLit>, acc: List<Spec>): List<Spec>
  ret match(ls)
    (nil: ChainEnd) => acc
    (l: ChainLink)  => match(l.value)
      (le: PlExpr)  => scCuLits(l.next, scCuExpr(le.litExpr, acc))
      (lr: PlRange) => scCuLits(l.next, scCuExpr(lr.rangeHi, scCuExpr(lr.rangeLo, acc)))

fun [tail] scCuArms(as2: Chain<PArm>, acc: List<Spec>): List<Spec>
  ret match(as2)
    (nil: ChainEnd) => acc
    (l: ChainLink)  => scCuArms(l.next,
        scCuExprOpt(l.value.armGuard,
          scCuLits(chain(l.value.armLiterals),
            scCuExpr(l.value.armBody, scCuSpecOpt(l.value.armType, acc)))))

fun [tail] scCuExprs(es: Chain<PExpr>, acc: List<Spec>): List<Spec>
  ret match(es)
    (nil: ChainEnd) => acc
    (l: ChainLink)  => scCuExprs(l.next, scCuExpr(l.value, acc))

fun scCuExprOpt(x: PExpr|None, acc: List<Spec>): List<Spec>
  ret match(x)
    (e2: PExpr) => scCuExpr(e2, acc)
    ()          => acc

fun scCuExpr(x: PExpr, acc: List<Spec>): List<Spec>
  ret match(x)
    (nm: PeName)      => scCuSpecOpt(nm.penTrait, scCuSpecs(chain(nm.refTypeParams), acc))
    (d: PeDot)        => scCuExpr(d.base, acc)
    (c: PeCall)       => scCuExpr(c.parameter, scCuExpr(c.function, acc))
    (tp: PeTuple)     => scCuTupEnts(chain(tp.exprs), acc)
    (te: PeTernary)   => scCuExpr(te.falseResult, scCuExpr(te.trueResult,
                                  scCuExpr(te.condition, acc)))
    (lm: PeLambda)    => scCuSpecOpt(lm.lamRet, scCuExpr(lm.lamBody, scCuStmt(lm.lamParams, acc)))
    (bk: PeBlock)     => scCuExpr(bk.blockValue, scCuStmts(chain(bk.blockStmts), acc))
    (mt: PeMatch)     => scCuArms(chain(mt.arms), scCuExpr(mt.subject, acc))
    (op: PeBuiltinOp) => scCuExpr(op.opParams, scCuSpec(op.opType, acc))
    (nw: PeNew)       => scCuExpr(nw.newParam, scCuSpec(nw.newType, acc))
    (ne: PeNewEnum)   => scCuSpecs(chain(ne.neTypeParams),
                                   fold(ne.fieldArgs, acc, (a2: List<Spec>, fa: PFieldArg) =>
                                     scCuExpr(fa.faValue, a2)))
    (ar: PeArrayRead) => scCuExpr(ar.arrIndex, scCuExpr(ar.arrObj, acc))
    (cv: PeConvert)   => scCuSpec(cv.convTarget, scCuExpr(cv.convInner, acc))
    (wx: PeWith)      => scCuExpr(wx.withRepls, scCuExpr(wx.withSubject, acc))
    (pl: PeParallel)  => scCuExpr(pl.parParams, acc)
    (lp: PeLoop)      => scCuExpr(lp.loopBody, scCuExprs(chain(lp.loopParams), acc))
    (rc: PeRecur)     => scCuExprs(chain(rc.recArgs), acc)
    (lz: PeLazy)      => scCuSpec(lz.lzTarget, acc)
    (o: PExpr)        => acc

fun scCuStmt(st: PStmt, acc: List<Spec>): List<Spec>
  ret match(st)
    (f: PsFun)  => scCuSpecs(chain(f.fWheres),
                     scCuSpecOpt(f.fRet, scCuExprOpt(f.fBody, scCuStmt(f.fParams, acc))))
    (l: PsLet)  => scCuExprOpt(l.lDefault, scCuSpecOpt(l.lType, acc))
    (d: PsDestructure) => scCuExprOpt(d.dDefault,
                            scCuStmts(chain(d.dTargets), scCuSpecOpt(d.dType, acc)))
    (c: PsClass) => scCuSpecsOpt(c.cAllParents,
                      scCuStmts(chain(c.cMembers),
                        scCuSpecs(chain(c.cWheres),
                          scCuSpecs(chain(c.cImplements), scCuStmt(c.cParams, acc)))))
    (e2: PsEnum) => scCuSpecOpt(e2.eSpec,
                      scCuStmts(chain(e2.eVariants), scCuStmt(e2.eParams, acc)))
    (ta: PsTypealias) => scCuSpec(ta.taType, acc)
    (rt: PsRet)  => scCuExpr(rt.retValue, acc)
    (a: PsAction) => scCuExpr(a.action, acc)
    (i: PsIf)    => scCuStmts(chain(i.ifFalse), scCuStmts(chain(i.ifTrue), scCuExpr(i.ifCond, acc)))
    (o: PStmt)   => acc

fun [tail] scCuStmts(ss: Chain<PStmt>, acc: List<Spec>): List<Spec>
  ret match(ss)
    (nil: ChainEnd) => acc
    (l: ChainLink)  => scCuStmts(l.next, scCuStmt(l.value, acc))

fun scCollectUnions(statements: List<PStmt>): List<Spec>
  ret scCuStmts(chain(statements), List<Spec>())

# Map each union's repr_members() to (name, uid) pairs — name is "" ("None")
# for a non-candidate member; uid is "" for an ungrounded spec.

class [final] ScMapped(mnNames: List<String>, mnUids: List<String>)

fun scUidOrEmpty(specs: ScSpecs, name: String): String
  ret match(scLookupSpec(specs, name))
    (sp: Spec) => uid(sp)
    ()         => ""

fun scMapOne(m: Spec, cands: ScCands, specs: ScSpecs, acc: ScMapped): ScMapped
  ret match(m)
    (c: SClass) => contains2(cands.scNames, c.scName)
      ? ScMapped(append(acc.mnNames, c.scName), append(acc.mnUids, scUidOrEmpty(specs, c.scName)))
      : ScMapped(append(acc.mnNames, ""), append(acc.mnUids, uid(m)))
    (n: SNamed) => contains2(cands.scNames, n.snName)
      ? ScMapped(append(acc.mnNames, n.snName), append(acc.mnUids, scUidOrEmpty(specs, n.snName)))
      : ScMapped(append(acc.mnNames, ""), append(acc.mnUids, uid(m)))
    (o: Spec)   => ScMapped(append(acc.mnNames, ""), append(acc.mnUids, uid(m)))

fun [tail] scMapMembers(ms: Chain<Spec>, cands: ScCands, specs: ScSpecs,
                        acc: ScMapped): ScMapped
  ret match(ms)
    (nil: ChainEnd) => acc
    (l: ChainLink)  => scMapMembers(l.next, cands, specs, scMapOne(l.value, cands, specs, acc))

class [final] ScUidCounts(ucUids: List<String>, ucCounts: List<Int>)

fun scBumpUid(acc: ScUidCounts, u: String): ScUidCounts
  ret contains2(acc.ucUids, u)
    ? ScUidCounts(acc.ucUids, scBumpAt(chain(acc.ucUids), chain(acc.ucCounts), u, List<Int>()))
    : ScUidCounts(append(acc.ucUids, u), append(acc.ucCounts, 1))

fun [tail] scCountUids(us: Chain<String>, acc: ScUidCounts): ScUidCounts
  ret match(us)
    (nil: ChainEnd) => acc
    (l: ChainLink)  => l.value == "" ? scCountUids(l.next, acc)
                                     : scCountUids(l.next, scBumpUid(acc, l.value))

fun [tail] scCollectColliding(ns: Chain<String>, us: Chain<String>, counts: ScUidCounts,
                              acc: List<String>): List<String>
  ret match(ns)
    (nil: ChainEnd) => acc
    (n: ChainLink)  => match(us)
      (nil2: ChainEnd) => acc
      (u: ChainLink)   => (n.value != "" && u.value != ""
                           && scCountOf(counts.ucUids, counts.ucCounts, u.value) > 1)
        ? scCollectColliding(n.next, u.next, counts, addNameOnce(acc, n.value))
        : scCollectColliding(n.next, u.next, counts, acc)

fun scCollideUnion(cm: SCombination, cands: ScCands, specs: ScSpecs, acc: List<String>): List<String>
  let mapped = scMapMembers(chain(reprMembers(cm)), cands, specs, ScMapped(List<String>(), List<String>()))
  let counts = scCountUids(chain(mapped.mnUids), ScUidCounts(List<String>(), List<Int>()))
  ret scCollectColliding(chain(mapped.mnNames), chain(mapped.mnUids), counts, acc)

fun scCollideOne(sp: Spec, cands: ScCands, specs: ScSpecs, acc: List<String>): List<String>
  ret match(sp)
    (cm: SCombination) => scCollideUnion(cm, cands, specs, acc)
    (o: Spec)           => acc

fun [tail] scCollidingNames(us: Chain<Spec>, cands: ScCands, specs: ScSpecs,
                            acc: List<String>): List<String>
  ret match(us)
    (nil: ChainEnd) => acc
    (l: ChainLink)  => scCollidingNames(l.next, cands, specs, scCollideOne(l.value, cands, specs, acc))

fun [tail] scExcludeUnions(unions: List<Spec>, cands: ScCands, specs: ScSpecs): ScFiltered
  let colliding = scCollidingNames(chain(unions), cands, specs, List<String>())
  if isEmpty(colliding)
    ret ScFiltered(cands, specs)
  let newCands = scKeepCandsWhere(cands, (n: String) => !contains2(colliding, n))
  let newSpecs = scLowerNestedFieldTypes(newCands.scNames, scBuildTupleSpecs(newCands))
  ret scExcludeUnions(unions, newCands, newSpecs)

# ── 8. tupleIdToClass ────────────────────────────────────────────────────────

fun scTupleIdToClass(specs: ScSpecs): Dict<String, String>
  ret scT2cLoop(chain(specs.ssNames), chain(specs.ssSpecs), Dict<String, String>())

fun [tail] scT2cLoop(ns: Chain<String>, sps: Chain<Spec>,
                     acc: Dict<String, String>): Dict<String, String>
  ret match(ns)
    (nil: ChainEnd) => acc
    (n: ChainLink)  => match(sps)
      (nil2: ChainEnd) => acc
      (s2: ChainLink)  => scT2cLoop(n.next, s2.next,
                                    uid(s2.value) == ""
                                      ? acc
                                      : put(acc, uid(s2.value), n.value))

fun scClassForUid(t2c: Dict<String, String>, u: String): String|None
  ret u == "" ? None : get(t2c, u)

# ── 9. liftMethod ────────────────────────────────────────────────────────────

fun scRenameThisCb(x: PExpr): PExpr|None
  ret match(x)
    (nm: PeName) => nm.refName == "this" ? PeName("$this", nm.refTypeParams, nm.penLine, nm.penTrait)
                                         : None
    (o: PExpr)   => None

fun scRenameBody(body: PExpr|None): PExpr|None
  ret match(body)
    (b: PExpr) => rwExpr(b, rwOnExpr(scRenameThisCb))
    ()         => None

fun scThisLet(tupleSpec: Spec, lr: PLine): PStmt
  ret PsLet("$this", List<PAttr>(), List<PGen>(), tupleSpec, None, "",
            List<Spec>(), lr, false, List<PStmt>())

fun scPrependThis(params: PStmt, tupleSpec: Spec, lr: PLine): PStmt
  ret match(params)
    (d: PsDestructure) => PsDestructure(d.dName, d.dAttrs, d.dType,
        concat(prepend(scThisLet(tupleSpec, lr), List<PStmt>()), d.dTargets),
        d.dDefault, d.psdLine, d.dTypeInferred)
    (o: PStmt) => o

fun scLiftMethod(clsName: String, tupleSpec: Spec, method: PsFun): PStmt
  ret PsFun(clsName + "__" + method.fName, method.fAttrs, method.fGens,
            scPrependThis(method.fParams, tupleSpec, method.psfLine),
            scRenameBody(method.fBody), method.fRet, method.fWheres, method.psfLine,
            method.fRetInferred, method.fNested, method.fImports)

fun scLiftMembers(ms: Chain<PStmt>, clsName: String, tupleSpec: Spec,
                         acc: List<PStmt>): List<PStmt>
  ret build<PStmt >(scLiftMembersB(ms, clsName, tupleSpec, _pushChain<PStmt >(builder<PStmt >(), chain<PStmt >(acc))))

fun [tail] scLiftMembersB(ms: Chain<PStmt>, clsName: String, tupleSpec: Spec,
                         [terminal] acc: ListBuilder<PStmt >): ListBuilder<PStmt >
  ret match(ms)
    (nil: ChainEnd) => acc
    (l: ChainLink)  => match(l.value)
      (f: PsFun) => scLiftMembersB(l.next, clsName, tupleSpec,
                                  push<PStmt >(acc, scLiftMethod(clsName, tupleSpec, f)))
      (o: PStmt) => scLiftMembersB(l.next, clsName, tupleSpec, acc)

fun scLiftClassMethods(clsName: String, cls: PsClass, specs: ScSpecs, acc: List<PStmt>): List<PStmt>
  ret match(scLookupSpec(specs, clsName))
    (tupleSpec: Spec) => scLiftMembers(chain(cls.cMembers), clsName, tupleSpec, acc)
    ()                => acc

fun [tail] scLiftAllLoop(ns: Chain<String>, cs: Chain<PsClass>, specs: ScSpecs,
                         acc: List<PStmt>): List<PStmt>
  ret match(ns)
    (nil: ChainEnd) => acc
    (n: ChainLink)  => match(cs)
      (nil2: ChainEnd) => acc
      (c: ChainLink)   => scLiftAllLoop(n.next, c.next, specs,
                                        scLiftClassMethods(n.value, c.value, specs, acc))

fun scLiftAll(cands: ScCands, specs: ScSpecs): List<PStmt>
  ret scLiftAllLoop(chain(cands.scNames), chain(cands.scClasses), specs, List<PStmt>())

# ── 10. nameTupleEntries ─────────────────────────────────────────────────────

# Co-walk the spec entries alongside the supplied ones — the positional
# pairing is the structure itself, never an index bound.
fun scNteLoop(es: Chain<PTupEnt>, ses: Chain<SEntry>,
                     acc: List<PTupEnt>): List<PTupEnt>
  ret build<PTupEnt >(scNteLoopB(es, ses, _pushChain<PTupEnt >(builder<PTupEnt >(), chain<PTupEnt >(acc))))

fun [tail] scNteLoopB(es: Chain<PTupEnt>, ses: Chain<SEntry>,
                     [terminal] acc: ListBuilder<PTupEnt >): ListBuilder<PTupEnt >
  ret match(es)
    (nil: ChainEnd) => acc
    (l: ChainLink)  => match(ses)
      (sl: ChainLink)  => scNteLoopB(l.next, sl.next,
          push<PTupEnt >(acc, l.value.tupName == ""
            ? PTupEnt(sl.value.seName, l.value.tupSpread, l.value.tupValue)
            : l.value))
      (nil2: ChainEnd) => scNteLoopB(l.next, ses, push<PTupEnt >(acc, l.value))

fun scNameTupleEntries(param: PExpr, spec: Spec): PExpr
  ret match(param)
    (tp: PeTuple) => match(spec)
      (t2: STuple) => PeTuple(scNteLoop(chain(tp.exprs), chain(t2.stEntries), List<PTupEnt>()), tp.petLine)
      (o: Spec)    => param
    (o: PExpr)    => param

# ── 11. the main replace callback ────────────────────────────────────────────

fun scFlattenOne(sp: Spec, cands: ScCands, specs: ScSpecs): Spec|None
  ret match(sp)
    (c: SClass) => contains2(cands.scNames, c.scName) ? scLookupSpec(specs, c.scName) : None
    (o: Spec)   => None

fun scMainSpecOne(sp: Spec, cands: ScCands, specs: ScSpecs): Spec|None
  ret match(sp)
    (c: SClass) => contains2(cands.scNames, c.scName) ? scLookupSpec(specs, c.scName) : None
    # SEnum: nothing to do — fields are DERIVED from statements, and every
    # nested spec position in a statement is visited directly by this walk.
    (o: Spec)   => None

fun scReplaceNew(nw: PeNew): PExpr|None
  ret match(nw.newType)
    (t2: STuple) => scNameTupleEntries(nw.newParam, nw.newType)
    (o: Spec)    => None

fun scReplaceCtorCall(c: PeCall, nm: PeName, cands: ScCands, specs: ScSpecs): PExpr|None
  ret contains2(cands.scNames, nm.refName) ? scCtorReplacement(c, nm, specs) : None

fun scCtorReplacement(c: PeCall, nm: PeName, specs: ScSpecs): PExpr|None
  ret match(scLookupSpec(specs, nm.refName))
    (sp: Spec) => scNameTupleEntries(c.parameter, sp)
    ()         => None

fun scClassNameForDotBase(base: PExpr, cands: ScCands, t2c: Dict<String, String>,
                          r: Resolver): String|None
  ret match(exprType(base, r))
    (bt: Spec) => match(bt)
      (cs2: SClass) => contains2(cands.scNames, cs2.scName) ? cs2.scName : None
      (t2: STuple)  => scClassForUid(t2c, uid(t2))
      (o: Spec)     => None
    ()         => None

fun scMakeLiftedCall(c: PeCall, d: PeDot, clsName: String): PExpr
  let lr = c.pecLine
  let args = match(c.parameter)
    (tp: PeTuple) => tp.exprs
    (o: PExpr)    => List<PTupEnt>()
  let newArgs = PeTuple(concat(prepend(PTupEnt("", false, d.base), List<PTupEnt>()), args), lr)
  ret PeCall(PeName(clsName + "__" + d.member, List<Spec>(), lr), newArgs, lr)

fun scBuildMethodCall(c: PeCall, d: PeDot, clsName: String, cands: ScCands): PExpr|None
  ret match(scClassFor(cands, clsName))
    (cls: PsClass) => contains2(scMethodNames(cls), d.member) ? scMakeLiftedCall(c, d, clsName) : None
    ()             => None

fun scReplaceMethodCall(c: PeCall, d: PeDot, cands: ScCands,
                        t2c: Dict<String, String>, r: Resolver): PExpr|None
  ret match(scClassNameForDotBase(d.base, cands, t2c, r))
    (clsName: String) => scBuildMethodCall(c, d, clsName, cands)
    ()                => None

fun scReplaceCall(c: PeCall, cands: ScCands, specs: ScSpecs, t2c: Dict<String, String>,
                  r: Resolver): PExpr|None
  ret match(c.function)
    (nm: PeName) => scReplaceCtorCall(c, nm, cands, specs)
    (d: PeDot)   => scReplaceMethodCall(c, d, cands, t2c, r)
    (o: PExpr)   => None

fun scReplaceExpr(x: PExpr, cands: ScCands, specs: ScSpecs, t2c: Dict<String, String>,
                  r: Resolver): PExpr|None
  ret match(x)
    (nw: PeNew) => scReplaceNew(nw)
    (c: PeCall) => scReplaceCall(c, cands, specs, t2c, r)
    (o: PExpr)  => None

fun scReplaceFn(cands: ScCands, specs: ScSpecs, t2c: Dict<String, String>, r: Resolver): Rw
  ret Rw((x: PExpr) => scReplaceExpr(x, cands, specs, t2c, r),
         (sp: Spec) => scMainSpecOne(sp, cands, specs),
         rwNoStmt)

# ── 13. the driver ───────────────────────────────────────────────────────────

fun scRewriteTop(ss: Chain<PStmt>, cands: ScCands, w: Rw, acc: List<PStmt>): List<PStmt>
  ret build<PStmt >(scRewriteTopB(ss, cands, w, _pushChain<PStmt >(builder<PStmt >(), chain<PStmt >(acc))))

fun [tail] scRewriteTopB(ss: Chain<PStmt>, cands: ScCands, w: Rw, [terminal] acc: ListBuilder<PStmt >): ListBuilder<PStmt >
  ret match(ss)
    (nil: ChainEnd) => acc
    (l: ChainLink)  => scIsDroppedClass(l.value, cands)
      ? scRewriteTopB(l.next, cands, w, acc)
      : scRewriteTopB(l.next, cands, w, push<PStmt >(acc, rwStmt(l.value, w)))

fun scIsDroppedClass(st: PStmt, cands: ScCands): Bool
  ret match(st)
    (c: PsClass) => contains2(cands.scNames, c.cName)
    (o: PStmt)   => false

fun scRewriteLifted(ls: Chain<PStmt>, w: Rw, acc: List<PStmt>): List<PStmt>
  ret build<PStmt >(scRewriteLiftedB(ls, w, _pushChain<PStmt >(builder<PStmt >(), chain<PStmt >(acc))))

fun [tail] scRewriteLiftedB(ls: Chain<PStmt>, w: Rw, [terminal] acc: ListBuilder<PStmt >): ListBuilder<PStmt >
  ret match(ls)
    (nil: ChainEnd) => acc
    (l: ChainLink)  => scRewriteLiftedB(l.next, w, push<PStmt >(acc, rwStmt(l.value, w)))

fun lowerSimpleClasses(statements: List<PStmt>): List<PStmt>
  let r = rootResolver(statements)
  let cands0 = scFindSimpleClasses(statements)
  if isEmpty(cands0.scNames)
    ret statements
  let specs0 = scLowerNestedFieldTypes(cands0.scNames, scBuildTupleSpecs(cands0))
  let filtered1 = scExcludeStandalone(cands0, specs0, statements, r)
  if isEmpty(filtered1.sfCands.scNames)
    ret statements
  let unions = scCollectUnions(statements)
  let filtered2 = scExcludeUnions(unions, filtered1.sfCands, filtered1.sfSpecs)
  if isEmpty(filtered2.sfCands.scNames)
    ret statements
  let cands = filtered2.sfCands
  let specs = filtered2.sfSpecs
  let t2c = scTupleIdToClass(specs)
  let liftedPre = scLiftAll(cands, specs)
  let rewriteResolver = rootResolver(concat(statements, liftedPre))
  # Resolver-THREADED rewrite (scT*): Python's callback sees the resolver in
  # effect at each node — a receiver that is a param or local must resolve.
  let ctx = ScCtx(cands, specs, t2c)
  let newStatements0 = scTTop(chain(statements), cands, ctx, rewriteResolver,
                              List<PStmt>())
  let liftedFinal = scTStmts(liftedPre, ctx, rewriteResolver)
  let newStatements = newStatements0
  ret concat(newStatements, liftedFinal)

# ── resolver-threaded rewrite drive ──────────────────────────────────────────
# Python's search_and_replace hands the callback the resolver in effect at
# each node (params/lets in scope); the method-call rewrite reads the
# receiver's type through it. Scope constructors mirror lambdas.yafl's scan:
# fun body = localScope(params, nested ? r : RTraits(wheres, r)); class
# members = RClassBody; block = blockScope; if-branches = localScope(branch);
# lambda body = localScope(params); arm body/guard = bindingScope. The spec
# rule is scope-free and applied per the visit-set law. (Third threaded
# walker in the tree — consolidate into rewrite.yafl during the migration.)

class [final] ScCtx(sxCands: ScCands, sxSpecs: ScSpecs,
                    sxT2c: Dict<String, String>)

fun scTSpec(sp: Spec, c: ScCtx): Spec
  ret rwSpec(sp, rwOnSpec((s2: Spec) => scMainSpecOne(s2, c.sxCands,
                                                      c.sxSpecs)))

fun scTSpecOpt(sp: Spec|None, c: ScCtx): Spec|None
  ret match(sp)
    (s2: Spec) => scTSpec(s2, c)
    ()         => None

fun scTSpecs(ts: List<Spec>, c: ScCtx): List<Spec>
  ret scTSpecLoop(chain(ts), c, List<Spec>())

fun scTSpecLoop(ts: Chain<Spec>, c: ScCtx, acc: List<Spec>): List<Spec>
  ret build<Spec >(scTSpecLoopB(ts, c, _pushChain<Spec >(builder<Spec >(), chain<Spec >(acc))))

fun [tail] scTSpecLoopB(ts: Chain<Spec>, c: ScCtx, [terminal] acc: ListBuilder<Spec >): ListBuilder<Spec >
  ret match(ts)
    (nil: ChainEnd) => acc
    (l: ChainLink)  => scTSpecLoopB(l.next, c, push<Spec >(acc, scTSpec(l.value,
                                                                  c)))

fun scTSpecsOpt(ss: List<Spec>|None, c: ScCtx): List<Spec>|None
  ret match(ss)
    (l: List<Spec>) => scTSpecs(l, c)
    ()              => None

fun scTStmts(ss: List<PStmt>, c: ScCtx, r: Resolver): List<PStmt>
  ret scTStmtLoop(chain(ss), c, r, List<PStmt>())

fun scTStmtLoop(ss: Chain<PStmt>, c: ScCtx, r: Resolver,
                       acc: List<PStmt>): List<PStmt>
  ret build<PStmt >(scTStmtLoopB(ss, c, r, _pushChain<PStmt >(builder<PStmt >(), chain<PStmt >(acc))))

fun [tail] scTStmtLoopB(ss: Chain<PStmt>, c: ScCtx, r: Resolver,
                       [terminal] acc: ListBuilder<PStmt >): ListBuilder<PStmt >
  ret match(ss)
    (nil: ChainEnd) => acc
    (l: ChainLink)  => scTStmtLoopB(l.next, c, r,
                                   push<PStmt >(acc, scTStmt(l.value, c, r)))

fun scTStmt(st: PStmt, c: ScCtx, r: Resolver): PStmt
  ret match(st)
    (f: PsFun)  => PsFun(f.fName, f.fAttrs, f.fGens, scTStmt(f.fParams, c, r),
                         scTExprOpt(f.fBody, c, clFunBodyResolver(f, r)),
                         scTSpecOpt(f.fRet, c), scTSpecs(f.fWheres, c),
                         f.psfLine, f.fRetInferred, f.fNested, f.fImports)
    (l: PsLet)  => PsLet(l.lName, l.lAttrs, l.lGens, scTSpecOpt(l.lType, c),
                         scTExprOpt(l.lDefault, c, r), l.lArrayLen,
                         l.lWheres, l.pslLine, l.lTypeInferred, l.lImports)
    (d: PsDestructure) => PsDestructure(d.dName, d.dAttrs,
                                        scTSpecOpt(d.dType, c),
                                        scTStmts(d.dTargets, c, r),
                                        scTExprOpt(d.dDefault, c, r),
                                        d.psdLine, d.dTypeInferred)
    (cl: PsClass) => PsClass(cl.cName, cl.cAttrs, cl.cGens,
                             scTStmt(cl.cParams, c, r),
                             scTSpecs(cl.cImplements, c),
                             scTSpecs(cl.cWheres, c),
                             scTStmts(cl.cMembers, c, RClassBody(cl, r)),
                             cl.cIsInterface, cl.pscLine,
                             scTSpecsOpt(cl.cAllParents, c), cl.cAllSlots,
                             cl.cImports)
    (e2: PsEnum) => PsEnum(e2.eName, e2.eAttrs, e2.eGens, scTStmt(e2.eParams, c, r),
                           scTStmts(e2.eVariants, c, r), e2.eHasParams,
                           e2.pseLine, e2.eRootName,
                           scTSpecOpt(e2.eSpec, c), e2.eImports)
    (ta: PsTypealias) => PsTypealias(ta.taName, ta.taAttrs, ta.taGens,
                                     scTSpec(ta.taType, c), ta.taWheres,
                                     ta.pstLine, ta.taImports)
    (rt: PsRet)  => PsRet(scTExpr(rt.retValue, c, r), rt.psrLine)
    (a: PsAction) => PsAction(scTExpr(a.action, c, r), a.psaLine)
    (i: PsIf)    => PsIf(scTExpr(i.ifCond, c, r),
                         scTStmts(i.ifTrue, c, localScope(i.ifTrue, r)),
                         scTStmts(i.ifFalse, c, localScope(i.ifFalse, r)),
                         i.psifLine)
    (o: PStmt)   => st

fun scTExprOpt(x: PExpr|None, c: ScCtx, r: Resolver): PExpr|None
  ret match(x)
    (e2: PExpr) => scTExpr(e2, c, r)
    ()          => None

fun scTExpr(x: PExpr, c: ScCtx, r: Resolver): PExpr
  let rebuilt = scTKids(x, c, r)
  ret match(scReplaceExpr(rebuilt, c.sxCands, c.sxSpecs, c.sxT2c, r))
    (rep: PExpr) => rep
    ()           => rebuilt

fun scTKids(x: PExpr, c: ScCtx, r: Resolver): PExpr
  ret match(x)
    (nm: PeName)   => PeName(nm.refName, scTSpecs(nm.refTypeParams, c),
                             nm.penLine, scTTrait(nm.penTrait, c))
    (d: PeDot)     => PeDot(scTExpr(d.base, c, r), d.member, d.pedLine)
    (cc: PeCall)   => PeCall(scTExpr(cc.function, c, r),
                             scTExpr(cc.parameter, c, r), cc.pecLine)
    (tp: PeTuple)  => PeTuple(scTEnts(chain(tp.exprs), c, r,
                                      List<PTupEnt>()),
                              tp.petLine)
    (te: PeTernary) => PeTernary(scTExpr(te.condition, c, r),
                                 scTExpr(te.trueResult, c, r),
                                 scTExpr(te.falseResult, c, r), te.pety)
    (lm: PeLambda) => PeLambda(scTStmt(lm.lamParams, c, r),
                               scTExpr(lm.lamBody, c,
                                       localScope(flattenParams(lm.lamParams),
                                                  r)),
                               lm.pelLine, scTSpecOpt(lm.lamRet, c))
    (bk: PeBlock)  => scTBlock(bk, c, blockScope(bk.blockStmts, r))
    (mt: PeMatch)  => PeMatch(scTExpr(mt.subject, c, r),
                              scTArms(chain(mt.arms), c, r, List<PArm>()),
                              mt.pemLine)
    (op: PeBuiltinOp) => PeBuiltinOp(scTSpec(op.opType, c), op.opName,
                                     scTExpr(op.opParams, c, r), op.peboLine)
    (nw: PeNew)    => PeNew(scTSpec(nw.newType, c),
                            scTExpr(nw.newParam, c, r), nw.penwLine)
    (ne: PeNewEnum) => PeNewEnum(ne.rootName, ne.leafName,
                                 map(ne.fieldArgs, (fa: PFieldArg) =>
                                   PFieldArg(fa.faName, scTExpr(fa.faValue, c, r))),
                                 scTSpecs(ne.neTypeParams, c), ne.penewLine)
    (ar: PeArrayRead) => PeArrayRead(scTExpr(ar.arrObj, c, r),
                                     scTExpr(ar.arrIndex, c, r), ar.pearLine)
    (cv: PeConvert) => PeConvert(scTExpr(cv.convInner, c, r),
                                 scTSpec(cv.convTarget, c), cv.pecvLine)
    (wx: PeWith)   => PeWith(scTExpr(wx.withSubject, c, r),
                             scTExpr(wx.withRepls, c, r), wx.pewLine)
    (pl: PeParallel) => PeParallel(scTExpr(pl.parParams, c, r), pl.pepLine)
    (lp: PeLoop)   => PeLoop(scTExpr(lp.loopBody, c, r),
                             scTExprs(chain(lp.loopParams), c, r,
                                      List<PExpr>()),
                             lp.pelpLine)
    (rc: PeRecur)  => PeRecur(scTExprs(chain(rc.recArgs), c, r,
                                       List<PExpr>()),
                              rc.recIndex, rc.percLine)
    (lz: PeLazy)   => PeLazy(lz.stubName, scTSpec(lz.lzTarget, c),
                             lz.lzCaptured, lz.lzStubOnly, lz.pelzLine)
    (o: PExpr)     => x

fun scTTrait(sp: Spec|None, c: ScCtx): Spec|None
  ret match(sp)
    (s2: Spec) => match(scTSpec(s2, c))
      (cs2: SClass) => cs2
      (o: Spec)     => None
    ()         => None

fun scTBlock(bk: PeBlock, c: ScCtx, blockR: Resolver): PExpr
  ret PeBlock(scTStmts(bk.blockStmts, c, blockR),
              scTExpr(bk.blockValue, c, blockR), bk.blockTag, bk.pebkLine)

fun scTExprs(es: Chain<PExpr>, c: ScCtx, r: Resolver,
                    acc: List<PExpr>): List<PExpr>
  ret build<PExpr >(scTExprsB(es, c, r, _pushChain<PExpr >(builder<PExpr >(), chain<PExpr >(acc))))

fun [tail] scTExprsB(es: Chain<PExpr>, c: ScCtx, r: Resolver,
                    [terminal] acc: ListBuilder<PExpr >): ListBuilder<PExpr >
  ret match(es)
    (nil: ChainEnd) => acc
    (l: ChainLink)  => scTExprsB(l.next, c, r,
                                push<PExpr >(acc, scTExpr(l.value, c, r)))

fun scTEnts(es: Chain<PTupEnt>, c: ScCtx, r: Resolver,
                   acc: List<PTupEnt>): List<PTupEnt>
  ret build<PTupEnt >(scTEntsB(es, c, r, _pushChain<PTupEnt >(builder<PTupEnt >(), chain<PTupEnt >(acc))))

fun [tail] scTEntsB(es: Chain<PTupEnt>, c: ScCtx, r: Resolver,
                   [terminal] acc: ListBuilder<PTupEnt >): ListBuilder<PTupEnt >
  ret match(es)
    (nil: ChainEnd) => acc
    (l: ChainLink)  => scTEntsB(l.next, c, r,
        push<PTupEnt >(acc, PTupEnt(l.value.tupName, l.value.tupSpread,
                            scTExpr(l.value.tupValue, c, r))))

fun scTArms(as2: Chain<PArm>, c: ScCtx, r: Resolver,
                   acc: List<PArm>): List<PArm>
  ret build<PArm >(scTArmsB(as2, c, r, _pushChain<PArm >(builder<PArm >(), chain<PArm >(acc))))

fun [tail] scTArmsB(as2: Chain<PArm>, c: ScCtx, r: Resolver,
                   [terminal] acc: ListBuilder<PArm >): ListBuilder<PArm >
  ret match(as2)
    (nil: ChainEnd) => acc
    (l: ChainLink)  => scTArmsB(l.next, c, r,
        push<PArm >(acc, scTArmOne(l.value, c, r)))

fun scTArmOne(a: PArm, c: ScCtx, r: Resolver): PArm
  let bodyR = bindingScope(a, a.armType, r)
  ret PArm(a.armName, scTSpecOpt(a.armType, c),
           scTExpr(a.armBody, c, bodyR),
           scTLits(chain(a.armLiterals), c, r, List<PLit>()),
           scTExprOpt(a.armGuard, c, bodyR), a.parmLine)

fun scTLits(ls: Chain<PLit>, c: ScCtx, r: Resolver,
                   acc: List<PLit>): List<PLit>
  ret build<PLit >(scTLitsB(ls, c, r, _pushChain<PLit >(builder<PLit >(), chain<PLit >(acc))))

fun [tail] scTLitsB(ls: Chain<PLit>, c: ScCtx, r: Resolver,
                   [terminal] acc: ListBuilder<PLit >): ListBuilder<PLit >
  ret match(ls)
    (nil: ChainEnd) => acc
    (l: ChainLink)  => match(l.value)
      (le: PlExpr)  => scTLitsB(l.next, c, r,
                               push<PLit >(acc, PlExpr(scTExpr(le.litExpr, c,
                                                          r))))
      (lr2: PlRange) => scTLitsB(l.next, c, r,
          push<PLit >(acc, PlRange(scTExpr(lr2.rangeLo, c, r),
                              scTExpr(lr2.rangeHi, c, r), lr2.plrLine)))

fun scTTop(ss: Chain<PStmt>, cands: ScCands, c: ScCtx, r: Resolver,
                  acc: List<PStmt>): List<PStmt>
  ret build<PStmt >(scTTopB(ss, cands, c, r, _pushChain<PStmt >(builder<PStmt >(), chain<PStmt >(acc))))

fun [tail] scTTopB(ss: Chain<PStmt>, cands: ScCands, c: ScCtx, r: Resolver,
                  [terminal] acc: ListBuilder<PStmt >): ListBuilder<PStmt >
  ret match(ss)
    (nil: ChainEnd) => acc
    (l: ChainLink)  => scIsDroppedClass(l.value, cands)
      ? scTTopB(l.next, cands, c, r, acc)
      : scTTopB(l.next, cands, c, r, push<PStmt >(acc, scTStmt(l.value, c, r)))
