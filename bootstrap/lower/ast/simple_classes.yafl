# bootstrap/simple_classes.yafl — lowering/simple_classes.py: lower "simple"
# classes to flat structs + free functions.
#
# A class qualifies as simple if it: is not an interface, has no inheritance,
# has at most 4 fields (none a trailing variable-length array), is not used
# as a base class by anyone, is not self-recursive (directly or through
# other candidates), has no method reference used standalone (every
# DotExpression naming one of its methods is immediately called), and does
# not collide with another union member once flattened.
#
# Qualifying classes are replaced throughout the AST:
#   ClassSpec(name)                          -> TupleSpec(fields)
#   NewExpression(TupleSpec, params)         -> params
#   CallExpression(NamedExpression(cls), a)  -> a           (ctor -> flat tuple)
#   b.method(args)                           -> ClassName__method(b, args)
#
# Each method is lifted to a top-level PsFun whose first parameter is
# "$this: TupleSpec(fields)". The PsClass itself is dropped.
namespace Bootstrap::Lower::Ast

import System

import Bootstrap::Ast
import Bootstrap::Frontend
import Bootstrap::Parse
import Bootstrap::Resolve



# ── candidate / spec bookkeeping (parallel lists — Dict has no keys()) ──────

# Lists carry ITERATION ORDER; the Dict carries LOOKUP (user ruling
# 2026-07-22: port Python dicts as Dict for lookups — lists only where
# the code iterates the map as a list). scCandsAdd/scSpecsAdd keep both
# in step; add-if-absent preserves the old first-hit-wins lookup.
# Candidate class name -> its declaration, and candidate name -> its tuple
# spec. Just the Dicts: the two parallel Lists beside each existed only to be
# iterated, and cost an append per candidate to build an order that is not
# meaningful (USER RULING: declaration order in YAFL is largely irrelevant).
# The walks that do need an order take the names SORTED.
class [final] ScCands(scIndex: Dict<String, PsClass>)
class [final] ScSpecs(ssIndex: Dict<String, Spec>)

fun scNames(c: ScCands) => sort(keys(c.scIndex))

# The candidate classes in sorted-name order. A name that is not in the map
# contributes nothing — it cannot happen, since the names come from the map's
# own keys, but saying so beats inventing a placeholder class.
fun scClassesOf(c: ScCands)
  ret (scClassesLoop(scNames(c), c,
                          List()))

fun [tail] scClassesLoop(ns: List<String>, c: ScCands,
                         acc: List<PsClass>) => isEmpty(ns)
  ? acc
  : match(get(c.scIndex, first(ns)))
    (cls: PsClass) => scClassesLoop(tail(ns), c, append(acc, cls))
    ()             => scClassesLoop(tail(ns), c, acc)

fun scBeEdge(acc, from2: ScCands, name,
             candNames: List<String>) => match(get(from2.scIndex, name))
  (cls: PsClass) => EEdges(put(acc.eeMap, name,
                               scReferencedNames(cls, candNames)))
  ()             => acc

fun scBtsOne(acc, from2: ScCands, name) => match(get(from2.scIndex, name))
  (cls: PsClass) => scSpecsAdd(acc, name, scTupleSpecOf(cls))
  ()             => acc

fun scLiftOne(name, from2: ScCands, specs: ScSpecs,
              acc): List<PStmt> => match(get(from2.scIndex, name))
  (cls: PsClass) => scLiftClassMethods(name, cls, specs, acc)
  ()             => acc

fun scHasCand(c: ScCands, name: String) => contains(c.scIndex, name)

fun ssNames(s2: ScSpecs) => sort(keys(s2.ssIndex))
class [final] ScFiltered(sfCands: ScCands, sfSpecs: ScSpecs)

# ── generic name -> Int lookup/bump (shared by method-ref and uid counts) ───

fun [tail] scCountLoop(ns: List<String>, vs: List<Int>, name: String) => isEmpty(ns)
  ? 0
  : isEmpty(vs)
    ? 0
    : first(ns) == name ? first(vs) : scCountLoop(tail(ns), tail(vs), name)

# ── generic candidate/spec filtering by predicate on name ───────────────────

fun scKeepCandsWhere(cands: ScCands, pred: (:String): Bool)
  ret scKcLoop(scNames(cands), cands, pred, scCandsEmpty())

fun [tail] scKcLoop(ns: List<String>, from2: ScCands, pred: (:String): Bool,
                    acc) => isEmpty(ns)
  ? acc
  : pred(first(ns))
    ? scKcLoop(tail(ns), from2, pred,
               scCandsAddOpt(acc, first(ns), get(from2.scIndex, first(ns))))
    : scKcLoop(tail(ns), from2, pred, acc)

fun scCandsAddOpt(acc, name, cls: PsClass|None) => match(cls)
  (c: PsClass) => scCandsAdd(acc, name, c)
  ()           => acc

fun scKeepSpecsWhere(specs: ScSpecs, pred: (:String): Bool)
  ret scKsLoop(ssNames(specs), specs, pred, scSpecsEmpty())

fun [tail] scKsLoop(ns: List<String>, from2: ScSpecs, pred: (:String): Bool,
                    acc) => isEmpty(ns)
  ? acc
  : pred(first(ns))
    ? scKsLoop(tail(ns), from2, pred,
               scSpecsAddOpt(acc, first(ns), get(from2.ssIndex, first(ns))))
    : scKsLoop(tail(ns), from2, pred, acc)

fun scSpecsAddOpt(acc, name, sp: Spec|None) => match(sp)
  (s3: Spec) => scSpecsAdd(acc, name, s3)
  ()         => acc

fun scCandsEmpty() => ScCands(Dict())

fun scSpecsEmpty() => ScSpecs(Dict())

# FIRST declaration of a name wins, as the index did before.
fun scCandsAdd(acc: ScCands, name, cls)
  ret ScCands(get(acc.scIndex, name) is None
                ? put(acc.scIndex, name, cls)
                : acc.scIndex)

fun scSpecsAdd(acc: ScSpecs, name, spec)
  ret ScSpecs(get(acc.ssIndex, name) is None
                ? put(acc.ssIndex, name, spec)
                : acc.ssIndex)

fun scLookupSpec(specs: ScSpecs, name: String) => get(specs.ssIndex, name)

fun scClassFor(cands: ScCands, name: String) => get(cands.scIndex, name)

fun scMethodNames(cls: PsClass) => scMnLoop(cls.cMembers, List())

fun scMnLoop(ms, acc: List<String>): List<String> => (scMnLoopB(ms, acc))

fun [tail] scMnLoopB(ms: List<PStmt>, acc: List<String>) => isEmpty(ms)
  ? acc
  : match(first(ms))
    (f: PsFun) => scMnLoopB(tail(ms), append(acc, f.fName))
    (o: PStmt) => scMnLoopB(tail(ms), acc)

fun scHasMethod(cands: ScCands, clsName: String, methodName: String)
  ret match(scClassFor(cands, clsName))
    (cls: PsClass) => contains2(scMethodNames(cls), methodName)
    ()             => false

# ── 1. isSimpleClass ─────────────────────────────────────────────────────────

fun scIsSimple(cls: PsClass, baseNames: List<String>)
  if cls.cIsInterface
    ret false
  if hasAttr(cls.cAttrs, "foreign")
    ret false
  # Classes that are published into after construction need a real object with
  # a stable identity to write through; flattening one to an unboxed struct
  # would leave nothing to publish to. [mutable] says so by being writable at
  # any time; [pinnable] says so for an object that is immutable except inside
  # a late pin, which is a heap object for the same reason — the pin lives in
  # its vtable word, and a value struct has none.
  if hasAttr(cls.cAttrs, "mutable") || hasAttr(cls.cAttrs, "pinnable")
    ret false
  if !isEmpty(cls.cImplements)
    ret false
  if contains2(baseNames, cls.cName)
    ret false
  let fields = flattenParams(cls.cParams)
  if atLeast(fields, 5)
    ret false
  ret !scHasArrayField(fields)

fun [tail] scHasArrayField(fs: List<PStmt>) => isEmpty(fs)
  ? false
  : match(first(fs))
    (let2: PsLet) => match(arrayElem(let2.lType))
      (el: Spec) => true
      ()         => scHasArrayField(tail(fs))
    (o: PStmt)    => scHasArrayField(tail(fs))

# ── 2. findSimpleClasses ─────────────────────────────────────────────────────

fun scAllClasses(statements: List<PStmt>) => scAcLoop(statements, scCandsEmpty())

fun [tail] scAcLoop(ss: List<PStmt>, acc: ScCands) => isEmpty(ss)
  ? acc
  : match(first(ss))
    (c: PsClass) => scAcLoop(tail(ss),
                             scCandsAdd(acc, c.cName, c))
    (o: PStmt)   => scAcLoop(tail(ss), acc)

fun scBaseClassNames(all2: ScCands) => scBcnLoop(scClassesOf(all2), List())

fun [tail] scBcnLoop(cs: List<PsClass>, acc): List<String> => isEmpty(cs)
  ? acc
  : scBcnLoop(tail(cs), scBcnParents(first(cs).cAllParents, acc))

fun scBcnParents(parents: List<Spec>|None, acc): List<String> => match(parents)
  (ps: List<Spec>) => scBcnList(ps, acc)
  ()               => acc

fun [tail] scBcnList(ps: List<Spec>, acc: List<String>) => isEmpty(ps)
  ? acc
  : match(first(ps))
    (c: SClass) => scBcnList(tail(ps), addNameOnce(acc, c.scName))
    (o: Spec)   => scBcnList(tail(ps), acc)

fun [tail] scFilterSimple(ns: List<String>, from2: ScCands,
                          baseNames: List<String>, acc: ScCands) => isEmpty(ns)
  ? acc
  : match(get(from2.scIndex, first(ns)))
    (cls: PsClass) => scIsSimple(cls, baseNames)
      ? scFilterSimple(tail(ns), from2, baseNames,
                       scCandsAdd(acc, first(ns), cls))
      : scFilterSimple(tail(ns), from2, baseNames, acc)
    ()             => scFilterSimple(tail(ns), from2, baseNames, acc)

fun scFindSimpleClasses(statements: List<PStmt>)
  let all2 = scAllClasses(statements)
  let baseNames = scBaseClassNames(all2)
  let simple = scFilterSimple(scNames(all2), all2, baseNames,
                              scCandsEmpty())
  ret scPruneRecursive(simple)

# ── 3. pruneRecursive (reuses EEdges / aiReachesSelf from complex_enums.yafl
#      and ast_inline.yafl) ──────────────────────────────────────────────────

fun scCollectRefs(sp, candNames: List<String>, acc): List<String> => match(sp)
  (c: SClass)        => scAddIfCand(c.scName, candNames, scRefList(c.scParams, candNames, acc))
  (n: SNamed)        => scAddIfCand(n.snName, candNames, scRefList(n.snParams, candNames, acc))
  (e2: SEnum)        => scRefList(e2.seParams, candNames, acc)
  (cm: SCombination) => scRefList(cm.scTypes, candNames, acc)
  (cl: SCallable)    => scRefOpt(cl.scResult, candNames, scCollectRefs(cl.scParams2, candNames, acc))
  (t2: STuple)       => scRefEntries(t2.stEntries, candNames, acc)
  (af: SArrayField)  => scCollectRefs(af.safElem, candNames, acc)
  (ls: SLazyStub)    => scRefOpt(ls.slsTarget, candNames, acc)
  (o: Spec)          => acc

fun [tail] scRefList(ts: List<Spec>, candNames: List<String>, acc: List<String>) => isEmpty(ts)
  ? acc
  : scRefList(tail(ts), candNames, scCollectRefs(first(ts), candNames, acc))

fun scRefOpt(sp: Spec|None, candNames: List<String>, acc): List<String> => match(sp)
  (s2: Spec) => scCollectRefs(s2, candNames, acc)
  ()         => acc

fun [tail] scRefEntries(es: List<SEntry>, candNames: List<String>, acc): List<String> => isEmpty(es)
  ? acc
  : scRefEntries(tail(es), candNames, scRefOpt(first(es).seType, candNames, acc))

fun scAddIfCand(name: String, candNames: List<String>, acc): List<String>
  ret contains2(candNames, name) ? addNameOnce(acc, name) : acc

fun scReferencedNames(cls: PsClass, candNames: List<String>)
  ret scRefFields(flattenParams(cls.cParams), candNames, List())

fun [tail] scRefFields(fs: List<PStmt>, candNames: List<String>, acc: List<String>) => isEmpty(fs)
  ? acc
  : match(first(fs))
    (let2: PsLet) => match(let2.lType)
      (ty: Spec) => scRefFields(tail(fs), candNames, scCollectRefs(ty, candNames, acc))
      ()         => scRefFields(tail(fs), candNames, acc)
    (o: PStmt)    => scRefFields(tail(fs), candNames, acc)

fun scBuildEdges(cands: ScCands) => scBeLoop(scNames(cands), cands, scNames(cands),
                                             EEdges(Dict()))

fun [tail] scBeLoop(ns: List<String>, from2: ScCands, candNames: List<String>,
                    acc) => isEmpty(ns)
  ? acc
  : scBeLoop(tail(ns), from2, candNames,
                         scBeEdge(acc, from2, first(ns), candNames))

fun scPruneRecursive(cands: ScCands)
  let edges = scBuildEdges(cands)
  ret scPruneLoop(scNames(cands), cands, edges,
                  scCandsEmpty())

fun [tail] scPruneLoop(ns: List<String>, from2: ScCands, edges: EEdges,
                       acc) => isEmpty(ns)
  ? acc
  : aiReachesSelf(first(ns), edges)
    ? scPruneLoop(tail(ns), from2, edges, acc)
    : scPruneLoop(tail(ns), from2, edges,
                  scCandsAddOpt(acc, first(ns),
                                get(from2.scIndex, first(ns))))

# ── 4. buildTupleSpecs ───────────────────────────────────────────────────────

fun scTupleSpecOf(cls: PsClass)
  ret STuple(scEntriesOf(flattenParams(cls.cParams), List()), cls.pscLine)

fun scEntriesOf(fs, acc: List<SEntry>): List<SEntry> => (scEntriesOfB(fs, acc))

fun [tail] scEntriesOfB(fs: List<PStmt>, acc: List<SEntry>) => isEmpty(fs)
  ? acc
  : match(first(fs))
    (let2: PsLet) => scEntriesOfB(tail(fs), append(acc, SEntry(let2.lName, let2.lType, None)))
    (o: PStmt)    => scEntriesOfB(tail(fs), acc)

fun scBuildTupleSpecs(cands: ScCands) => scBtsLoop(scNames(cands), cands, scSpecsEmpty())

fun [tail] scBtsLoop(ns: List<String>, from2: ScCands, acc) => isEmpty(ns)
  ? acc
  : scBtsLoop(tail(ns), from2,
                         scBtsOne(acc, from2, first(ns)))

# ── 5. lowerNestedFieldTypes fixpoint ────────────────────────────────────────
# `specsFixed` is the ORIGINAL, never-mutated map the rule substitutes from
# (mirrors Python's closure over the untouched `simple_tuple_specs`); `specs`
# is the working copy re-derived to a fixpoint each round.

class [final] ScLnftOut(lrSpecs: ScSpecs, lrChanged: Bool)

fun scLnftRule(sp, cands: List<String>, specsFixed: ScSpecs) => match(sp)
  (c: SClass) => contains2(cands, c.scName) ? scLookupSpec(specsFixed, c.scName) : None
  (o: Spec)   => None

fun scLnftStep(nrest, from2: ScSpecs, cands: List<String>,
              specsFixed: ScSpecs, acc: ScSpecs, changed, name,
              spec)
  let newSpec = rwSpec(spec, rwOnSpec((sp) => scLnftRule(sp, cands, specsFixed)))
  ret eqSpec(newSpec, spec)
    ? scLnftRound(nrest, from2, cands, specsFixed,
                 scSpecsAdd(acc, name, spec), changed)
    : scLnftRound(nrest, from2, cands, specsFixed,
                 scSpecsAdd(acc, name, newSpec), true)

fun scLnftRound(ns: List<String>, from2: ScSpecs, cands: List<String>,
                specsFixed: ScSpecs, acc, changed) => isEmpty(ns)
  ? ScLnftOut(acc, changed)
  : match(get(from2.ssIndex, first(ns)))
    (sp: Spec) => scLnftStep(tail(ns), from2, cands, specsFixed, acc, changed,
                             first(ns), sp)
    ()         => scLnftRound(tail(ns), from2, cands, specsFixed, acc,
                              changed)

fun [tail] scLnftFix(cands: List<String>, specsFixed: ScSpecs, specs: ScSpecs)
  let out = scLnftRound(ssNames(specs), specs, cands, specsFixed,
                        scSpecsEmpty(), false)
  ret out.lrChanged ? scLnftFix(cands, specsFixed, out.lrSpecs) : out.lrSpecs

fun scLowerNestedFieldTypes(cands: List<String>, specs0: ScSpecs)
  ret scLnftFix(cands, specs0, specs0)

# ── 6. excludeStandaloneMethodRefs ───────────────────────────────────────────

# Two counter tables keyed by class name. Dicts: bumping one entry used to
# REBUILD the whole counter list to change a single number, once per reference
# to a candidate class anywhere in the program, and finding a count was a
# second lockstep walk of the names beside it. A name that has never been seen
# counts zero, which is what the separate first-sighting branch encoded.
class [final] ScCounts(cnAll: Dict<String, Int>, cnCalled: Dict<String, Int>)

fun scEmptyCounts() => ScCounts(Dict(), Dict())

fun scCountOf(d: Dict<String, Int>, name: String) => match(get(d, name))
  (n: Int) => n
  ()       => 0

fun scBumpAll(cc: ScCounts, name) => ScCounts(put(cc.cnAll, name, scCountOf(cc.cnAll, name) + 1),
                                              cc.cnCalled)

fun scBumpCalled(cc: ScCounts, name)
  ret ScCounts(cc.cnAll,
               put(cc.cnCalled, name,
                   scCountOf(cc.cnCalled, name) + 1))

fun scCountAll(cc: ScCounts, name: String) => scCountOf(cc.cnAll, name)

fun scCountCalled(cc: ScCounts, name: String) => scCountOf(cc.cnCalled, name)

fun scClassNameOf(base, cands: ScCands, r) => match(exprType(base, r))
  (bt: Spec) => match(bt)
    (cs2: SClass) => scHasCand(cands, cs2.scName) ? cs2.scName : None
    (o: Spec)     => None
  ()         => None

fun scDotHit(acc, d: PeDot, cands: ScCands, r) => match(scClassNameOf(d.base, cands, r))
  (clsName: String) => scHasMethod(cands, clsName, d.member) ? scBumpAll(acc, clsName) : acc
  ()                => acc

fun scCalledHit(acc, d: PeDot, cands: ScCands, r) => match(scClassNameOf(d.base, cands, r))
  (clsName: String) => scHasMethod(cands, clsName, d.member) ? scBumpCalled(acc, clsName) : acc
  ()                => acc

# NOTE: a called dot bumps BOTH counters — the fold fires fx on the PeCall
# node (bumping "called"), then separately descends into its PeDot child
# (bumping "all"), exactly mirroring Python's search_and_replace traversal.
# Each receiver is typed with the resolver of its own scope: a receiver that
# is a local types as nothing against the global resolver, and an escaping
# reference through it would go uncounted.
fun scDotFold(acc, x, cands: ScCands, r) => match(x)
  (d: PeDot)  => scDotHit(acc, d, cands, r)
  (c: PeCall) => match(c.function)
    (d2: PeDot) => scCalledHit(acc, d2, cands, r)
    (o: PExpr)  => acc
  (o: PExpr)  => acc

fun scExcludeStandalone(cands: ScCands, specs: ScSpecs, statements: List<PStmt>,
                        r): ScFiltered
  let counts = foldExprsScoped(statements, r, (acc, x, xr) => scDotFold(acc, x, cands, xr),
                               scEmptyCounts())
  ret ScFiltered(
      scKeepCandsWhere(cands, (n) => scCountAll(counts, n) <= scCountCalled(counts, n)),
      scKeepSpecsWhere(specs, (n) => scCountAll(counts, n) <= scCountCalled(counts, n)))

# ── 7. excludeUnionCollisions ────────────────────────────────────────────────
# Collecting every SCombination anywhere in the statement tree needs its own
# small stmt/expr/spec fold — the SAME visit law as rwStmtKids/rwExprKids/
# rwSpecKids (see rewrite.yafl's header comment), restricted to accumulation.

fun [tail] scCuEntries(es: List<SEntry>, acc) => isEmpty(es)
  ? acc
  : scCuEntries(tail(es), scCuSpecOpt(first(es).seType, acc))

# On the FRONT: the unions collected here are walked once, each checked for
# name collisions independently of the others, and the names that come out are
# only ever tested for membership — no step can see the order.
fun scCuSpec(sp, acc)
  let acc2 = match(sp)
    (cm: SCombination) => prepend(sp, acc)
    (o: Spec)          => acc
  ret match(sp)
    (e2: SEnum)         => scCuSpecs(e2.seParams, acc2)
    (cl: SClass)        => scCuSpecs(cl.scParams, acc2)
    (n: SNamed)         => acc2
    (cm2: SCombination) => scCuSpecs(cm2.scTypes, acc2)
    (t2: STuple)        => scCuEntries(t2.stEntries, acc2)
    (cb: SCallable)     => scCuSpecOpt(cb.scResult, scCuSpec(cb.scParams2, acc2))
    (af: SArrayField)   => scCuSpec(af.safElem, acc2)
    (ls: SLazyStub)     => scCuSpecOpt(ls.slsTarget, acc2)
    (o2: Spec)          => acc2

fun scCuSpecOpt(sp: Spec|None, acc) => match(sp)
  (s2: Spec) => scCuSpec(s2, acc)
  ()         => acc

fun scCuSpecsOpt(ss: List<Spec>|None, acc) => match(ss)
  (l: List<Spec>) => scCuSpecs(l, acc)
  ()              => acc

fun [tail] scCuSpecs(ss: List<Spec>, acc) => isEmpty(ss)
  ? acc
  : scCuSpecs(tail(ss), scCuSpec(first(ss), acc))

fun [tail] scCuTupEnts(es: List<PTupEnt>, acc) => isEmpty(es)
  ? acc
  : scCuTupEnts(tail(es), scCuExpr(first(es).tupValue, acc))

fun [tail] scCuLits(ls: List<PLit>, acc) => isEmpty(ls)
  ? acc
  : match(first(ls))
    (le: PlExpr)  => scCuLits(tail(ls), scCuExpr(le.litExpr, acc))
    (lr: PlRange) => scCuLits(tail(ls), scCuExpr(lr.rangeHi, scCuExpr(lr.rangeLo, acc)))

fun [tail] scCuArms(as2: List<PArm>, acc) => isEmpty(as2)
  ? acc
  : scCuArms(tail(as2),
      scCuExprOpt(first(as2).armGuard,
        scCuLits(first(as2).armLiterals,
          scCuExpr(first(as2).armBody, scCuSpecOpt(first(as2).armType, acc)))))

fun [tail] scCuExprs(es: List<PExpr>, acc) => isEmpty(es)
  ? acc
  : scCuExprs(tail(es), scCuExpr(first(es), acc))

fun scCuExprOpt(x: PExpr|None, acc) => match(x)
  (e2: PExpr) => scCuExpr(e2, acc)
  ()          => acc

fun scCuExpr(x, acc) => match(x)
  (nm: PeName)      => scCuSpecOpt(nm.penTrait, scCuSpecs(nm.refTypeParams, acc))
  (d: PeDot)        => scCuExpr(d.base, acc)
  (c: PeCall)       => scCuExpr(c.parameter, scCuExpr(c.function, acc))
  (tp: PeTuple)     => scCuTupEnts(tp.exprs, acc)
  (te: PeTernary)   => scCuExpr(te.falseResult, scCuExpr(te.trueResult,
                                scCuExpr(te.condition, acc)))
  (lm: PeLambda)    => scCuSpecOpt(lm.lamRet, scCuExpr(lm.lamBody, scCuStmt(lm.lamParams, acc)))
  (bk: PeBlock)     => scCuExpr(bk.blockValue, scCuStmts(bk.blockStmts, acc))
  (mt: PeMatch)     => scCuArms(mt.arms, scCuExpr(mt.subject, acc))
  (op: PeBuiltinOp) => scCuExpr(op.opParams, scCuSpec(op.opType, acc))
  (nw: PeNew)       => scCuExpr(nw.newParam, scCuSpec(nw.newType, acc))
  (ne: PeNewEnum)   => scCuSpecs(ne.neTypeParams,
                                 fold(ne.fieldArgs, acc, (a2, fa) =>
                                   scCuExpr(fa.faValue, a2)))
  (qq: PeCoalesce) => scCuExpr(qq.qqFallback, scCuExpr(qq.qqSubject, acc))
  (ar: PeArrayRead) => scCuExpr(ar.arrIndex, scCuExpr(ar.arrObj, acc))
  (cv: PeConvert)   => scCuSpec(cv.convTarget, scCuExpr(cv.convInner, acc))
  (wx: PeWith)      => scCuExpr(wx.withRepls, scCuExpr(wx.withSubject, acc))
  (pl: PeParallel)  => scCuExpr(pl.parParams, acc)
  (lp: PeLoop)      => scCuExpr(lp.loopBody, scCuExprs(lp.loopParams, acc))
  (rc: PeRecur)     => scCuExprs(rc.recArgs, acc)
  (lz: PeLazy)      => scCuSpec(lz.lzTarget, acc)
  (o: PeLiteral) => acc

fun scCuStmt(st, acc) => match(st)
  (f: PsFun)  => scCuSpecs(f.fWheres,
                   scCuSpecOpt(f.fRet, scCuExprOpt(f.fBody, scCuStmt(f.fParams, acc))))
  (l: PsLet)  => scCuExprOpt(l.lDefault, scCuSpecOpt(l.lType, acc))
  (d: PsDestructure) => scCuExprOpt(d.dDefault,
                          scCuStmts(d.dTargets, scCuSpecOpt(d.dType, acc)))
  (c: PsClass) => scCuSpecsOpt(c.cAllParents,
                    scCuStmts(c.cMembers,
                      scCuSpecs(c.cWheres,
                        scCuSpecs(c.cImplements, scCuStmt(c.cParams, acc)))))
  (e2: PsEnum) => scCuSpecOpt(e2.eSpec,
                    scCuStmts(e2.eVariants, scCuStmt(e2.eParams, acc)))
  (ta: PsTypealias) => scCuSpec(ta.taType, acc)
  (rt: PsRet)  => scCuExpr(rt.retValue, acc)
  (a: PsAction) => scCuExpr(a.action, acc)
  (i: PsIf)    => scCuStmts(i.ifFalse, scCuStmts(i.ifTrue, scCuExpr(i.ifCond, acc)))
  (o: PStmt)   => acc

fun [tail] scCuStmts(ss: List<PStmt>, acc) => isEmpty(ss)
  ? acc
  : scCuStmts(tail(ss), scCuStmt(first(ss), acc))

fun scCollectUnions(statements: List<PStmt>) => scCuStmts(statements, List())

# Map each union's repr_members() to (name, uid) pairs — name is "" ("None")
# for a non-candidate member; uid is "" for an ungrounded spec.

# One entry per union member, POSITIONALLY paired: name (empty when the member
# is not a candidate) beside the uid it maps to. scCollectColliding walks the
# two in lockstep, so both are built in member order.
class [final] ScMapped(mnNames: List<String>,
                               mnUids: List<String>)

class [final] ScMappedOut(moNames: List<String>, moUids: List<String>)

fun scMappedBuild(m: ScMapped) => ScMappedOut(m.mnNames, m.mnUids)

fun scUidOrEmpty(specs: ScSpecs, name: String) => match(scLookupSpec(specs, name))
  (sp: Spec) => uid(sp)
  ()         => ""

fun scMapOne(m, cands: ScCands, specs: ScSpecs,
             acc: ScMapped) => match(m)
  (c: SClass) => scHasCand(cands, c.scName)
    ? ScMapped(append(acc.mnNames, c.scName),
               append(acc.mnUids, scUidOrEmpty(specs, c.scName)))
    : ScMapped(append(acc.mnNames, ""),
               append(acc.mnUids, uid(m)))
  (n: SNamed) => scHasCand(cands, n.snName)
    ? ScMapped(append(acc.mnNames, n.snName),
               append(acc.mnUids, scUidOrEmpty(specs, n.snName)))
    : ScMapped(append(acc.mnNames, ""),
               append(acc.mnUids, uid(m)))
  (o: Spec)   => ScMapped(append(acc.mnNames, ""),
                          append(acc.mnUids, uid(m)))

fun [tail] scMapMembers(ms: List<Spec>, cands: ScCands, specs: ScSpecs,
                        acc: ScMapped) => isEmpty(ms)
  ? acc
  : scMapMembers(tail(ms), cands, specs, scMapOne(first(ms), cands, specs, acc))

# How many members share each uid. Same shape as ScCounts, same reason.
class [final] ScUidCounts(ucCounts: Dict<String, Int>)

fun scBumpUid(acc: ScUidCounts, u)
  ret ScUidCounts(put(acc.ucCounts, u,
                      scCountOf(acc.ucCounts, u) + 1))

fun [tail] scCountUids(us: List<String>, acc: ScUidCounts) => isEmpty(us)
  ? acc
  : first(us) == "" ? scCountUids(tail(us), acc)
                                   : scCountUids(tail(us), scBumpUid(acc, first(us)))

fun [tail] scCollectColliding(ns: List<String>, us: List<String>, counts: ScUidCounts,
                              acc: List<String>) => isEmpty(ns)
  ? acc
  : isEmpty(us)
    ? acc
    : (first(ns) != "" && first(us) != ""
                         && scCountOf(counts.ucCounts, first(us)) > 1)
      ? scCollectColliding(tail(ns), tail(us), counts, addNameOnce(acc, first(ns)))
      : scCollectColliding(tail(ns), tail(us), counts, acc)

fun scCollideUnion(cm: SCombination, cands: ScCands, specs: ScSpecs, acc): List<String>
  let mapped = scMappedBuild(scMapMembers(reprMembers(cm), cands, specs,
                                 ScMapped(List(),
                                          List())))
  let counts = scCountUids(mapped.moUids, ScUidCounts(Dict()))
  ret scCollectColliding(mapped.moNames, mapped.moUids, counts,
                         acc)

fun scCollideOne(sp, cands: ScCands, specs: ScSpecs, acc): List<String> => match(sp)
  (cm: SCombination) => scCollideUnion(cm, cands, specs, acc)
  (o: Spec)           => acc

fun [tail] scCollidingNames(us: List<Spec>, cands: ScCands, specs: ScSpecs,
                            acc: List<String>) => isEmpty(us)
  ? acc
  : scCollidingNames(tail(us), cands, specs, scCollideOne(first(us), cands, specs, acc))

fun [tail] scExcludeUnions(unions: List<Spec>, cands, specs): ScFiltered
  let colliding = scCollidingNames(unions, cands, specs, List())
  if isEmpty(colliding)
    ret ScFiltered(cands, specs)
  let newCands = scKeepCandsWhere(cands, (n) => !contains2(colliding, n))
  let newSpecs = scLowerNestedFieldTypes(scNames(newCands), scBuildTupleSpecs(newCands))
  ret scExcludeUnions(unions, newCands, newSpecs)

# ── 8. tupleIdToClass ────────────────────────────────────────────────────────

fun scTupleIdToClass(specs: ScSpecs) => scT2cLoop(ssNames(specs), specs, Dict())

fun [tail] scT2cLoop(ns: List<String>, from2: ScSpecs,
                     acc: Dict<String, String>) => isEmpty(ns)
  ? acc
  : scT2cLoop(tail(ns), from2,
                        scT2cPut(acc, first(ns), get(from2.ssIndex, first(ns))))

fun scT2cPut(acc, name: String,
             sp: Spec|None) => match(sp)
  (s2: Spec) => uid(s2) == "" ? acc : put(acc, uid(s2), name)
  ()         => acc

fun scClassForUid(t2c: Dict<String, String>, u) => u == "" ? None : get(t2c, u)

# ── 8b. methodOwners ─────────────────────────────────────────────────────────
# Method name -> the simple class that declares it. Names are unique: each is
# minted as `name@<hash6>` from its own source position, so two classes spelling
# a method the same way still hold distinct names. A name that somehow IS shared
# is dropped rather than guessed at.

class [final] ScOwners(soMap: Dict<String, String>, soShared: List<String>)

fun scMethodOwners(cands: ScCands)
  ret scOwnersDrop(scOwnLoop(scNames(cands), cands,
                             ScOwners(Dict(), List())))

fun scOwnersDrop(o: ScOwners) => fold(o.soShared, o.soMap,
                                     (d, n) => remove(d, n))

fun [tail] scOwnLoop(ns: List<String>, cands: ScCands,
                     acc) => isEmpty(ns)
  ? acc
  : match(scClassFor(cands, first(ns)))
    (cls: PsClass) => scOwnLoop(tail(ns), cands,
                          scOwnMembers(scMethodNames(cls), first(ns), acc))
    ()             => scOwnLoop(tail(ns), cands, acc)

fun [tail] scOwnMembers(ms: List<String>, clsName,
                        acc) => isEmpty(ms)
  ? acc
  : scOwnMembers(tail(ms), clsName, scOwnOne(first(ms), clsName, acc))

fun scOwnOne(name, clsName, acc) => match(get(acc.soMap, name))
  (prev: String) => prev == clsName
    ? acc
    : ScOwners(acc.soMap, prepend(name, acc.soShared))
  ()             => ScOwners(put(acc.soMap, name, clsName), acc.soShared)

# ── 9. liftMethod ────────────────────────────────────────────────────────────

fun scRenameThisCb(x): PExpr|None => match(x)
  (nm: PeName) => nm.refName == "this" ? PeName("$this", nm.refTypeParams, nm.penLine, nm.penTrait)
                                       : None
  (o: PExpr)   => None

fun scRenameBody(body: PExpr|None): PExpr|None => match(body)
  (b: PExpr) => rwExpr(b, rwOnExpr(scRenameThisCb))
  ()         => None

fun scThisLet(tupleSpec, lr) => PsLet("$this", List(), List(), tupleSpec, None, "",
                                      List(), lr, false, List<PStmt>())

fun scPrependThis(params, tupleSpec, lr) => match(params)
  (d: PsDestructure) => PsDestructure(d.dName, d.dAttrs, d.dType,
      concat(prepend(scThisLet(tupleSpec, lr), List()), d.dTargets),
      d.dDefault, d.psdLine, d.dTypeInferred)
  (o: PStmt) => o

fun scLiftMethod(clsName, tupleSpec, method: PsFun)
  ret PsFun(clsName + "__" + method.fName, method.fAttrs, method.fGens,
            scPrependThis(method.fParams, tupleSpec, method.psfLine),
            scRenameBody(method.fBody), method.fRet, method.fWheres, method.psfLine,
            method.fRetInferred, method.fNested, method.fImports)

fun scLiftMembers(ms, clsName, tupleSpec,
                         acc: List<PStmt>): List<PStmt>
  ret (scLiftMembersB(ms, clsName, tupleSpec, acc))

fun [tail] scLiftMembersB(ms: List<PStmt>, clsName, tupleSpec,
                         acc: List<PStmt>) => isEmpty(ms)
  ? acc
  : match(first(ms))
    (f: PsFun) => scLiftMembersB(tail(ms), clsName, tupleSpec,
                                append(acc, scLiftMethod(clsName, tupleSpec, f)))
    (o: PStmt) => scLiftMembersB(tail(ms), clsName, tupleSpec, acc)

fun scLiftClassMethods(clsName, cls: PsClass, specs: ScSpecs, acc): List<PStmt>
  ret match(scLookupSpec(specs, clsName))
    (tupleSpec: Spec) => scLiftMembers(cls.cMembers, clsName, tupleSpec, acc)
    ()                => acc

fun [tail] scLiftAllLoop(ns: List<String>, from2: ScCands, specs: ScSpecs,
                         acc: List<PStmt>) => isEmpty(ns)
  ? acc
  : scLiftAllLoop(tail(ns), from2, specs,
                         scLiftOne(first(ns), from2, specs, acc))

# The lifted methods are EMITTED in this order, so it must match Python's
# `simple_classes.items()` — declaration order, as __find_simple_classes walked
# the statement list. Sorting the names instead put a later class's methods
# first whenever source and alphabetical order disagreed, which the two
# AST-comparison gates read straight out. Taken from the statement list because
# that is what defines it; no second copy to fall out of step.
fun scLiftAll(statements: List<PStmt>, cands: ScCands,
              specs: ScSpecs) => scLiftAllLoop(scDeclOrder(statements, cands), cands, specs,
                                               List())

# Candidate class names in declaration order.
fun scDeclOrder(statements: List<PStmt>, cands: ScCands)
  ret (scDeclOrderB(statements, cands, List()))

fun [tail] scDeclOrderB(ss: List<PStmt>, cands: ScCands,
                        acc: List<String>) => isEmpty(ss)
  ? acc
  : match(first(ss))
    (c: PsClass) => scHasCand(cands, c.cName)
      ? scDeclOrderB(tail(ss), cands, append(acc, c.cName))
      : scDeclOrderB(tail(ss), cands, acc)
    (o: PStmt)   => scDeclOrderB(tail(ss), cands, acc)

# ── 10. nameTupleEntries ─────────────────────────────────────────────────────

# Co-walk the spec entries alongside the supplied ones — the positional
# pairing is the structure itself, never an index bound.
fun scNteLoop(es, ses,
                     acc: List<PTupEnt>): List<PTupEnt>
  ret (scNteLoopB(es, ses, acc))

fun [tail] scNteLoopB(es: List<PTupEnt>, ses: List<SEntry>,
                     acc: List<PTupEnt>) => isEmpty(es)
  ? acc
  : isEmpty(ses)
    ? scNteLoopB(tail(es), ses, append(acc, first(es)))
    : scNteLoopB(tail(es), tail(ses),
        append(acc, first(es).tupName == ""
          ? PTupEnt(first(ses).seName, first(es).tupSpread, first(es).tupValue)
          : first(es)))

fun scNameTupleEntries(param, spec) => match(param)
  (tp: PeTuple) => match(spec)
    (t2: STuple) => PeTuple(scNteLoop(tp.exprs, t2.stEntries, List()), tp.petLine)
    (o: Spec)    => param
  (o: PExpr)    => param

# ── 11. the main replace callback ────────────────────────────────────────────

fun scFlattenOne(sp, cands: ScCands, specs: ScSpecs) => match(sp)
  (c: SClass) => scHasCand(cands, c.scName) ? scLookupSpec(specs, c.scName) : None
  (o: Spec)   => None

fun scMainSpecOne(sp, cands: ScCands, specs: ScSpecs): Spec|None => match(sp)
  (c: SClass) => scHasCand(cands, c.scName) ? scLookupSpec(specs, c.scName) : None
  # SEnum: nothing to do — fields are DERIVED from statements, and every
  # nested spec position in a statement is visited directly by this walk.
  (o: Spec)   => None

fun scReplaceNew(nw: PeNew) => match(nw.newType)
  (t2: STuple) => scNameTupleEntries(nw.newParam, nw.newType)
  (o: Spec)    => None

fun scReplaceCtorCall(c: PeCall, nm: PeName, cands: ScCands, specs: ScSpecs)
  ret scHasCand(cands, nm.refName) ? scCtorReplacement(c, nm, specs) : None

fun scCtorReplacement(c: PeCall, nm: PeName, specs: ScSpecs)
  ret match(scLookupSpec(specs, nm.refName))
    (sp: Spec) => scNameTupleEntries(c.parameter, sp)
    ()         => None

fun scClassNameForDotBase(base, member: String, cands: ScCands,
                          t2c: Dict<String, String>,
                          owners: Dict<String, String>,
                          r) => match(exprType(base, r))
  (bt: Spec) => match(bt)
    (cs2: SClass) => scHasCand(cands, cs2.scName) ? cs2.scName : None
    # The receiver is already flattened, so recover its class from the
    # METHOD, not the shape: a tuple's unique id is built from field TYPES
    # alone, so `Alpha(a: Int)` and `Beta(b: Int)` share one and the shape map
    # holds only whichever came last. The shape map still answers if a method
    # name is somehow shared.
    (t2: STuple)  => match(get(owners, member))
      (n: String) => n
      ()          => scClassForUid(t2c, uid(t2))
    (o: Spec)     => None
  ()         => None

fun scMakeLiftedCall(c: PeCall, d: PeDot, clsName)
  let lr = c.pecLine
  let args = match(c.parameter)
    (tp: PeTuple) => tp.exprs
    (o: PExpr)    => List()
  let newArgs = PeTuple(concat(prepend(PTupEnt("", false, d.base), List()), args), lr)
  ret PeCall(PeName(clsName + "__" + d.member, List(), lr), newArgs, lr)

fun scBuildMethodCall(c: PeCall, d: PeDot, clsName, cands: ScCands)
  ret match(scClassFor(cands, clsName))
    (cls: PsClass) => contains2(scMethodNames(cls), d.member) ? scMakeLiftedCall(c, d, clsName) : None
    ()             => None

fun scReplaceMethodCall(c: PeCall, d: PeDot, cands: ScCands,
                        t2c: Dict<String, String>,
                        owners: Dict<String, String>, r)
  ret match(scClassNameForDotBase(d.base, d.member, cands, t2c, owners, r))
    (clsName: String) => scBuildMethodCall(c, d, clsName, cands)
    ()                => None

fun scReplaceCall(c: PeCall, cands: ScCands, specs: ScSpecs, t2c: Dict<String, String>,
                  owners: Dict<String, String>, r) => match(c.function)
  (nm: PeName) => scReplaceCtorCall(c, nm, cands, specs)
  (d: PeDot)   => scReplaceMethodCall(c, d, cands, t2c, owners, r)
  (o: PExpr)   => None

fun scReplaceExpr(x, cands: ScCands, specs: ScSpecs, t2c: Dict<String, String>,
                  owners: Dict<String, String>, r): PExpr|None => match(x)
  (nw: PeNew) => scReplaceNew(nw)
  (c: PeCall) => scReplaceCall(c, cands, specs, t2c, owners, r)
  (o: PExpr)  => None

fun scReplaceFn(cands: ScCands, specs: ScSpecs, t2c: Dict<String, String>,
                owners: Dict<String, String>, r): Rw
  ret Rw((x) => scReplaceExpr(x, cands, specs, t2c, owners, r),
         (sp) => scMainSpecOne(sp, cands, specs),
         rwNoStmt)

# ── 13. the driver ───────────────────────────────────────────────────────────

fun scRewriteTop(ss, cands: ScCands, w: Rw, acc: List<PStmt>): List<PStmt>
  ret (scRewriteTopB(ss, cands, w, acc))

fun [tail] scRewriteTopB(ss: List<PStmt>, cands: ScCands, w: Rw, acc: List<PStmt>)
  ret isEmpty(ss)
    ? acc
    : scIsDroppedClass(first(ss), cands)
      ? scRewriteTopB(tail(ss), cands, w, acc)
      : scRewriteTopB(tail(ss), cands, w, append(acc, rwStmt(first(ss), w)))

fun scIsDroppedClass(st, cands: ScCands) => match(st)
  (c: PsClass) => scHasCand(cands, c.cName)
  (o: PStmt)   => false

fun scRewriteLifted(ls, w: Rw, acc: List<PStmt>): List<PStmt>
  ret (scRewriteLiftedB(ls, w, acc))

fun [tail] scRewriteLiftedB(ls: List<PStmt>, w: Rw, acc: List<PStmt>)
  ret isEmpty(ls)
    ? acc
    : scRewriteLiftedB(tail(ls), w, append(acc, rwStmt(first(ls), w)))

fun lowerSimpleClasses(statements): List<PStmt>
  let r = rootResolver(statements)
  let cands0 = scFindSimpleClasses(statements)
  if isEmpty(cands0.scIndex)
    ret statements
  let specs0 = scLowerNestedFieldTypes(scNames(cands0), scBuildTupleSpecs(cands0))
  let filtered1 = scExcludeStandalone(cands0, specs0, statements, r)
  if isEmpty(filtered1.sfCands.scIndex)
    ret statements
  let unions = scCollectUnions(statements)
  let filtered2 = scExcludeUnions(unions, filtered1.sfCands, filtered1.sfSpecs)
  if isEmpty(filtered2.sfCands.scIndex)
    ret statements
  let cands = filtered2.sfCands
  let specs = filtered2.sfSpecs
  let t2c = scTupleIdToClass(specs)
  let owners = scMethodOwners(cands)
  let liftedPre = scLiftAll(statements, cands, specs)
  let rewriteResolver = rootResolver(concat(statements, liftedPre))
  # Resolver-THREADED rewrite (scT*): Python's callback sees the resolver in
  # effect at each node — a receiver that is a param or local must resolve.
  let ctx = ScCtx(cands, specs, t2c, owners)
  let newStatements0 = scTTop(statements, cands, ctx, rewriteResolver,
                              List())
  let liftedFinal = scTStmts(liftedPre, ctx, rewriteResolver)
  let newStatements = newStatements0
  ret concat(newStatements, liftedFinal)

# ── resolver-threaded rewrite drive ──────────────────────────────────────────
# Python's search_and_replace hands the callback the resolver in effect at
# each node (params/lets in scope); the method-call rewrite reads the
# receiver's type through it. Scope constructors mirror lambdas.yafl's scan:
# fun body = localScope(params, nested ? r : RTraits(wheres, r)); class
# members = RClassBody; block = blockScope; if-branches = localScope(branch);
# lambda body = localScope(params); arm body/guard = bindingScope. The spec
# rule is scope-free and applied per the visit-set law. (Third threaded
# walker in the tree — consolidate into rewrite.yafl during the migration.)

class [final] ScCtx(sxCands: ScCands, sxSpecs: ScSpecs,
                    sxT2c: Dict<String, String>,
                    sxOwners: Dict<String, String>)

fun scTSpec(sp, c: ScCtx) => rwSpec(sp, rwOnSpec((s2) => scMainSpecOne(s2, c.sxCands,
                                                                       c.sxSpecs)))

fun scTSpecOpt(sp: Spec|None, c: ScCtx): Spec|None => match(sp)
  (s2: Spec) => scTSpec(s2, c)
  ()         => None

fun scTSpecs(ts: List<Spec>, c: ScCtx) => scTSpecLoop(ts, c, List())

fun scTSpecLoop(ts, c: ScCtx, acc: List<Spec>): List<Spec>
  ret (scTSpecLoopB(ts, c, acc))

fun [tail] scTSpecLoopB(ts: List<Spec>, c: ScCtx, acc: List<Spec>) => isEmpty(ts)
  ? acc
  : scTSpecLoopB(tail(ts), c, append(acc, scTSpec(first(ts),
                                                         c)))

fun scTSpecsOpt(ss: List<Spec>|None, c: ScCtx) => match(ss)
  (l: List<Spec>) => scTSpecs(l, c)
  ()              => None

fun scTStmts(ss: List<PStmt>, c: ScCtx, r): List<PStmt> => scTStmtLoop(ss, c, r, List())

fun scTStmtLoop(ss, c: ScCtx, r,
                       acc: List<PStmt>) => (scTStmtLoopB(ss, c, r, acc))

fun [tail] scTStmtLoopB(ss: List<PStmt>, c: ScCtx, r,
                       acc: List<PStmt>) => isEmpty(ss)
  ? acc
  : scTStmtLoopB(tail(ss), c, r,
                                 append(acc, scTStmt(first(ss), c, r)))

fun scTStmt(st, c: ScCtx, r): PStmt => match(st)
  (f: PsFun)  => PsFun(f.fName, f.fAttrs, f.fGens, scTStmt(f.fParams, c, r),
                       scTExprOpt(f.fBody, c, clFunBodyResolver(f, r)),
                       scTSpecOpt(f.fRet, c), scTSpecs(f.fWheres, c),
                       f.psfLine, f.fRetInferred, f.fNested, f.fImports)
  (l: PsLet)  => PsLet(l.lName, l.lAttrs, l.lGens, scTSpecOpt(l.lType, c),
                       scTExprOpt(l.lDefault, c, r), l.lArrayLen,
                       l.lWheres, l.pslLine, l.lTypeInferred, l.lImports)
  (d: PsDestructure) => PsDestructure(d.dName, d.dAttrs,
                                      scTSpecOpt(d.dType, c),
                                      scTStmts(d.dTargets, c, r),
                                      scTExprOpt(d.dDefault, c, r),
                                      d.psdLine, d.dTypeInferred)
  (cl: PsClass) => PsClass(cl.cName, cl.cAttrs, cl.cGens,
                           scTStmt(cl.cParams, c, r),
                           scTSpecs(cl.cImplements, c),
                           scTSpecs(cl.cWheres, c),
                           scTStmts(cl.cMembers, c, RClassBody(cl, r)),
                           cl.cIsInterface, cl.pscLine,
                           scTSpecsOpt(cl.cAllParents, c), cl.cAllSlots,
                           cl.cImports)
  (e2: PsEnum) => PsEnum(e2.eName, e2.eAttrs, e2.eGens, scTStmt(e2.eParams, c, r),
                         scTStmts(e2.eVariants, c, r), e2.eHasParams,
                         e2.pseLine, e2.eRootName,
                         scTSpecOpt(e2.eSpec, c), e2.eImports)
  (ta: PsTypealias) => PsTypealias(ta.taName, ta.taAttrs, ta.taGens,
                                   scTSpec(ta.taType, c), ta.taWheres,
                                   ta.pstLine, ta.taImports)
  (rt: PsRet)  => PsRet(scTExpr(rt.retValue, c, r), rt.psrLine)
  (a: PsAction) => PsAction(scTExpr(a.action, c, r), a.psaLine)
  (i: PsIf)    => PsIf(scTExpr(i.ifCond, c, r),
                       scTStmts(i.ifTrue, c, localScope(i.ifTrue, r)),
                       scTStmts(i.ifFalse, c, localScope(i.ifFalse, r)),
                       i.psifLine)
  (o: PStmt)   => st

fun scTExprOpt(x: PExpr|None, c: ScCtx, r): PExpr|None => match(x)
  (e2: PExpr) => scTExpr(e2, c, r)
  ()          => None

fun scTExpr(x, c: ScCtx, r): PExpr
  let rebuilt = scTKids(x, c, r)
  ret match(scReplaceExpr(rebuilt, c.sxCands, c.sxSpecs, c.sxT2c, c.sxOwners, r))
    (rep: PExpr) => rep
    ()           => rebuilt

fun scTKids(x, c: ScCtx, r): PExpr => match(x)
  (nm: PeName)   => PeName(nm.refName, scTSpecs(nm.refTypeParams, c),
                           nm.penLine, scTTrait(nm.penTrait, c))
  (d: PeDot)     => PeDot(scTExpr(d.base, c, r), d.member, d.pedLine)
  (cc: PeCall)   => PeCall(scTExpr(cc.function, c, r),
                           scTExpr(cc.parameter, c, r), cc.pecLine)
  (tp: PeTuple)  => PeTuple(scTEnts(tp.exprs, c, r,
                                    List()),
                            tp.petLine)
  (te: PeTernary) => PeTernary(scTExpr(te.condition, c, r),
                               scTExpr(te.trueResult, c, r),
                               scTExpr(te.falseResult, c, r), te.pety)
  (lm: PeLambda) => PeLambda(scTStmt(lm.lamParams, c, r),
                             scTExpr(lm.lamBody, c,
                                     localScope(flattenParams(lm.lamParams),
                                                r)),
                             lm.pelLine, scTSpecOpt(lm.lamRet, c))
  (bk: PeBlock)  => scTBlock(bk, c, blockScope(bk.blockStmts, r))
  (mt: PeMatch) => with mt(subject = scTExpr(mt.subject, c, r),
                    arms    = scTArms(mt.arms, c, r, List()))
  (op: PeBuiltinOp) => PeBuiltinOp(scTSpec(op.opType, c), op.opName,
                                   scTExpr(op.opParams, c, r), op.peboLine)
  (nw: PeNew)    => PeNew(scTSpec(nw.newType, c),
                          scTExpr(nw.newParam, c, r), nw.penwLine)
  (ne: PeNewEnum) => PeNewEnum(ne.rootName, ne.leafName,
                               map(ne.fieldArgs, (fa) =>
                                 PFieldArg(fa.faName, scTExpr(fa.faValue, c, r))),
                               scTSpecs(ne.neTypeParams, c), ne.penewLine)
  (qq: PeCoalesce) => PeCoalesce(scTExpr(qq.qqSubject, c, r),
                                   scTExpr(qq.qqFallback, c, r), qq.peqqLine)
  (ar: PeArrayRead) => PeArrayRead(scTExpr(ar.arrObj, c, r),
                                   scTExpr(ar.arrIndex, c, r), ar.pearLine)
  (cv: PeConvert) => PeConvert(scTExpr(cv.convInner, c, r),
                               scTSpec(cv.convTarget, c), cv.pecvLine)
  (wx: PeWith)   => PeWith(scTExpr(wx.withSubject, c, r),
                           scTExpr(wx.withRepls, c, r), wx.pewLine)
  (pl: PeParallel) => PeParallel(scTExpr(pl.parParams, c, r), pl.pepLine)
  (lp: PeLoop)   => PeLoop(scTExpr(lp.loopBody, c, r),
                           scTExprs(lp.loopParams, c, r,
                                    List()),
                           lp.pelpLine)
  (rc: PeRecur)  => PeRecur(scTExprs(rc.recArgs, c, r,
                                     List()),
                            rc.recIndex, rc.percLine)
  (lz: PeLazy)   => PeLazy(lz.stubName, scTSpec(lz.lzTarget, c),
                           lz.lzCaptured, lz.lzStubOnly, lz.pelzLine)
  (o: PeLiteral) => x

fun scTTrait(sp: Spec|None, c: ScCtx) => match(sp)
  (s2: Spec) => match(scTSpec(s2, c))
    (cs2: SClass) => cs2
    (o: Spec)     => None
  ()         => None

fun scTBlock(bk: PeBlock, c: ScCtx, blockR): PExpr
  ret PeBlock(scTStmts(bk.blockStmts, c, blockR),
              scTExpr(bk.blockValue, c, blockR), bk.blockTag, bk.pebkLine)

fun scTExprs(es, c: ScCtx, r,
                    acc: List<PExpr>) => (scTExprsB(es, c, r, acc))

fun [tail] scTExprsB(es: List<PExpr>, c: ScCtx, r,
                    acc: List<PExpr>) => isEmpty(es)
  ? acc
  : scTExprsB(tail(es), c, r,
                              append(acc, scTExpr(first(es), c, r)))

fun scTEnts(es: List<PTupEnt>, c: ScCtx, r,
                   acc: List<PTupEnt>) => (scTEntsB(es, c, r, acc))

fun [tail] scTEntsB(es: List<PTupEnt>, c: ScCtx, r,
                   acc): List<PTupEnt> => isEmpty(es)
  ? acc
  : scTEntsB(tail(es), c, r,
      append(acc, PTupEnt(first(es).tupName, first(es).tupSpread,
                scTExpr(first(es).tupValue, c, r))))

fun scTArms(as2, c: ScCtx, r,
                   acc: List<PArm>) => (scTArmsB(as2, c, r, acc))

fun [tail] scTArmsB(as2: List<PArm>, c: ScCtx, r,
                   acc: List<PArm>) => isEmpty(as2)
  ? acc
  : scTArmsB(tail(as2), c, r,
      append(acc, scTArmOne(first(as2), c, r)))

fun scTArmOne(a: PArm, c: ScCtx, r): PArm
  let bodyR = bindingScope(a, a.armType, r)
  ret with a(armType = scTSpecOpt(a.armType, c), armBody = scTExpr(a.armBody, c, bodyR), armLiterals = scTLits(a.armLiterals, c, r, List()), armGuard = scTExprOpt(a.armGuard, c, bodyR))

fun scTLits(ls, c: ScCtx, r,
                   acc: List<PLit>): List<PLit> => (scTLitsB(ls, c, r, acc))

fun [tail] scTLitsB(ls: List<PLit>, c: ScCtx, r,
                   acc: List<PLit>) => isEmpty(ls)
  ? acc
  : match(first(ls))
    (le: PlExpr)  => scTLitsB(tail(ls), c, r,
                             append(acc, PlExpr(scTExpr(le.litExpr, c,
                                                 r))))
    (lr2: PlRange) => scTLitsB(tail(ls), c, r,
        append(acc, PlRange(scTExpr(lr2.rangeLo, c, r),
                     scTExpr(lr2.rangeHi, c, r), lr2.plrLine)))

fun scTTop(ss, cands: ScCands, c: ScCtx, r,
                  acc: List<PStmt>): List<PStmt>
  ret (scTTopB(ss, cands, c, r, acc))

fun [tail] scTTopB(ss: List<PStmt>, cands: ScCands, c: ScCtx, r,
                  acc: List<PStmt>) => isEmpty(ss)
  ? acc
  : scIsDroppedClass(first(ss), cands)
    ? scTTopB(tail(ss), cands, c, r, acc)
    : scTTopB(tail(ss), cands, c, r, append(acc, scTStmt(first(ss), c, r)))
