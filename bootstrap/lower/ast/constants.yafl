# bootstrap/constants.yafl — lowering/constants.py: constant inlining.
#
# A `let [const] NAME = literal` is a name → literal alias: every reference
# is replaced by a fresh copy of the literal (re-stamped with the USE SITE's
# line so errors point there), then the declaration itself is dropped. The
# later literal-hoisting passes deduplicate the copies.
#
# Python drives this through the generic search_and_replace walker, which
# descends into type specs too — TupleEntrySpec.search_and_replace rewrites
# each entry's DEFAULT expression (specs.py:957), so a const name stored as a
# parameter default inside a Convert target is inlined like any other use.
# The port therefore rides the shared Rw walker (rewrite.yafl), whose
# rwEntries mirrors that spec descent.
namespace Bootstrap::Lower::Ast

import System

import Bootstrap::Ast
import Bootstrap::Resolve



# Const name -> its literal value. A Dict: both readers ask about ONE name —
# "is this a const" and "what is its value" — and the two parallel lists were
# walked in lockstep to answer the second.
class [final] IcConsts(icMap: Dict<String, PExpr>)

fun inlineConstants(statements: List<PStmt>): List<PStmt>
  let consts = icCollect(chain(statements),
                         IcConsts(Dict<String, PExpr>()))
  if isEmpty(consts.icMap)
    ret statements
  ret rwStmts(icDropDecls(chain(statements), consts, List<PStmt>()),
              Rw((x: PExpr) => icReplace(x, consts), rwNoSpec, rwNoStmt))

fun [tail] icCollect(ss: Chain<PStmt>, acc: IcConsts): IcConsts
  ret match(ss)
    (nil: ChainEnd) => acc
    (l: ChainLink)  => match(l.value)
      (let2: PsLet) => hasAttr(let2.lAttrs, "const")
        ? icCollectLet(let2, acc)
          |> (acc2) => icCollect(l.next, acc2)
        : icCollect(l.next, acc)
      (o: PStmt)    => icCollect(l.next, acc)

fun icCollectLet(let2: PsLet, acc: IcConsts): IcConsts
  ret match(let2.lDefault)
    (v: PExpr) => icIsLiteral(v)
      # FIRST declaration of a name wins, as the head-first walk did.
      ? (contains<String, PExpr>(acc.icMap, let2.lName)
           ? acc
           : IcConsts(put<String, PExpr>(acc.icMap, let2.lName, v)))
      : acc
    ()         => acc

fun icIsLiteral(x: PExpr): Bool
  ret match(x)
    (i: PeInt)   => true
    (f: PeFloat) => true
    (s2: PeStr)  => true
    (b: PeBool)  => true
    (o: PExpr)   => false

# The literal, re-stamped with the reference's line.
fun icRestamp(v: PExpr, line: PLine): PExpr
  ret match(v)
    (i: PeInt)   => PeInt(i.value, i.precision, line)
    (f: PeFloat) => PeFloat(f.floatText, f.fPrecision, line)
    (s2: PeStr)  => PeStr(s2.strValue, line)
    (b: PeBool)  => PeBool(b.boolValue, line)
    (o: PExpr)   => v

# Top level: const declarations are DROPPED — they live only as inlined uses.
fun icDropDecls(ss: Chain<PStmt>, c: IcConsts,
                       acc: List<PStmt>): List<PStmt>
  ret build<PStmt >(icDropDeclsB(ss, c, _pushChain<PStmt >(builder<PStmt >(), chain<PStmt >(acc))))

fun [tail] icDropDeclsB(ss: Chain<PStmt>, c: IcConsts,
                       [terminal] acc: ListBuilder<PStmt >): ListBuilder<PStmt >
  ret match(ss)
    (nil: ChainEnd) => acc
    (l: ChainLink)  => match(l.value)
      (let2: PsLet) => contains<String, PExpr>(c.icMap, let2.lName)
        ? icDropDeclsB(l.next, c, acc)
        : icDropDeclsB(l.next, c, push<PStmt >(acc, l.value))
      (o: PStmt)    => icDropDeclsB(l.next, c, push<PStmt >(acc, l.value))

# The walker callback: a bare name that aliases a const becomes the literal.
fun icReplace(x: PExpr, c: IcConsts): PExpr|None
  ret match(x)
    (nm: PeName) => match(get<String, PExpr>(c.icMap, nm.refName))
      (v: PExpr) => icRestamp(v, nm.penLine)
      ()         => None
    (o: PExpr)   => None
