# bootstrap/lower/ast/derive_eq.yafl — lowering/derive_eq.py: derived enum
# equality. Every qualifying top-level, non-generic enum with no user
# BasicEquality instance gains
#
#     instance [ambient] System::BasicEquality<E>
#       fun `==`(left: E, right: E): Bool     — ref_eq shortcut, then
#                                               variant-wise field compare
#       fun hashOf(value: E): Int32           — peek/store cache around a
#                                               variant-wise mix
#
# directly after the enum — emitted by the enum's own compile, inside the
# fixpoint (compileEnum asks derivesEquality). The internals are
# representation-aware at codegen, so nothing forces boxing. A user instance
# suppresses derivation.
#
# One question decides everything: does equality already EXIST for a type —
# does some instance, in whatever form it now has, cover it (its `where`
# clauses met, so a tuple has equality when its members do)? An enum for
# which it does never derives (idempotence); an enum derives only when it does
# for every member. COINDUCTIVE: candidates are assumed to have equality,
# shrunk to a fixpoint. Equality arrives TRANSITIVELY: an instance of
# BasicMath<Int> provides BasicEquality<Int> through the interface closure.
# Anything no instance covers — unions, function types, generic
# instantiations — blocks; `Spec` never derives because PLine has no
# instance, so eqSpec keeps sole ownership of spec equality.
#
# Synthesis is IDENTICAL to Python's, name for name and binder for binder
# (per-arm indexed binders: match lowering makes one variable per binder name,
# and a shared name across arms violates SSA), so dumps and C stay
# byte-comparable.
namespace Bootstrap::Lower::Ast

import System

import Bootstrap::Ast
import Bootstrap::Parse
import Bootstrap::Resolve
import Bootstrap::StdlibCandidates
import Bootstrap::Types


class [final] DeLeaves(dlNames: List<String>, dlSets: List<List<PStmt>>)

# The top-level enums that derive equality in this pass's program. A
# whole-program fact — rootResolver memoises it per pass, and each enum's own
# compile emits its instance. IDEMPOTENT: an enum that already has equality —
# a written instance, a derived one, either lowered or monomorphised — never
# derives. The same question decides every member: equality must exist for
# it (deHasEquality), or it is a candidate itself (coinductive). Empty while
# the answer is incomplete — an instance or witness not yet resolved may be
# the one that already covers an enum — and in a program that does not
# declare System::BasicEquality (compiled without the stdlib).
fun derivableEnums(statements, r): List<String>
  if isEmpty(findType(r, "System::BasicEquality").bItems)
    ret List()
  ret match(deProviders(statements, r, List()))
    (ps: List<DeProvider>) => deDerivable(statements, ps, r)
    ()                     => List()

fun deDerivable(statements, ps: List<DeProvider>, r)
  let cands = deCandidates(statements, ps, r,
                           DeCands(List(),
                                   List()))
  ret deFixpoint(cands.names, cands.leaves, ps, r)

# The synthesised BasicEquality<e> instance for a derivable enum.
fun derivedInstance(e: PsEnum) => match(deLeaves(e, List()))
  (dl: DeLeaves) => deSynthesise(e, dl)
  ()             => deSynthesise(e, DeLeaves(List(), List()))

# ── where equality comes from ────────────────────────────────────────────────

# One source of BasicEquality: the type it covers, as a pattern over the
# instance's own type params, with the `where` constraints a binding must
# meet — or, once monomorphised, the covered type's unique id (dpId: the
# `$generic$` suffix of the witness's interface, by construction; "" else).
class [final] DeProvider(dpParams: List<String>, dpCovers: Spec|None,
                         dpId: String, dpWheres: List<Spec>)

# Every source of equality in the program, in whatever form it now has — or
# None while one of them has not resolved enough to read.
fun [tail] deProviders(ss: List<PStmt>, r,
                       acc: List<DeProvider>): List<DeProvider>|None => isEmpty(ss)
  ? acc
  : match(deProvidersOf(first(ss), r, acc))
    (a: List<DeProvider>) => deProviders(tail(ss), r, a)
    ()                    => None

# First-class instances (generic ones with their `where` clauses), and
# lowered ones: a `[trait]` let whose witness CLASS implements the interface
# (monomorphised, its parents carry mangled names).
fun deProvidersOf(st, r, acc: List<DeProvider>): List<DeProvider>|None => match(st)
  (ti: PsTraitInstance) => deAdd(ti.tiPattern, genNames(ti.tiGens, List()),
                                 ti.tiWheres, r, acc)
  (let2: PsLet) => hasAttr(let2.lAttrs, "trait") && isEmpty(let2.lGens)
    ? deAddWitness(let2, r, acc)
    : acc
  (o: PStmt) => acc

fun deAddWitness(let2: PsLet, r, acc: List<DeProvider>): List<DeProvider>|None => match(let2.lType)
  (dt: Spec) => match(dt)
    (dc: SClass) => match(soleItem(findType(r, dc.scName)))
      (f: Found) => match(f.fStmt)
        (cls: PsClass) => match(cls.cAllParents)
          (ps: List<Spec>) => deAddAll(ps, r, acc)
          ()               => None
        (o: PStmt)     => acc
      ()         => acc
    (o2: Spec)   => None
  ()         => None

fun [tail] deAddAll(ps: List<Spec>, r,
                    acc: List<DeProvider>): List<DeProvider>|None => isEmpty(ps)
  ? acc
  : match(deAdd(first(ps), List(), List(), r, acc))
    (a: List<DeProvider>) => deAddAll(tail(ps), r, a)
    ()                    => None

# Record `iface` if it provides equality; None when it cannot be read yet.
fun deAdd(iface, params: List<String>, wheres: List<Spec>, r,
          acc: List<DeProvider>): List<DeProvider>|None => match(iface)
  (c: SClass) => match(deReachesEquality(c.scName, r))
    (b: Bool) => b ? deProvided(c, params, wheres, acc) : acc
    ()        => None
  (o: Spec)   => None

fun deProvided(c: SClass, params: List<String>, wheres: List<Spec>,
               acc: List<DeProvider>) => match(head(c.scParams))
  (arg: Spec) => prepend(DeProvider(params, arg, "", wheres), acc)
  ()          => deMonoProvided(c, acc)

fun deMonoProvided(c: SClass, acc: List<DeProvider>)
  let g2 = indexOf(c.scName, "$generic$", 0)
  ret g2 < 0
    ? acc
    : prepend(DeProvider(List(), None, slice(c.scName, g2 + 9, length(c.scName)),
                         List()), acc)

# Equality arrives TRANSITIVELY: the interface's cAllParents is the closure.
# None while that closure has not resolved.
fun deReachesEquality(name, r): Bool|None
  if deBaseName(name) == "System::BasicEquality"
    ret true
  ret match(soleItem(findType(r, name)))
    (f: Found) => match(f.fStmt)
      (cls: PsClass) => match(cls.cAllParents)
        (ps: List<Spec>) => deAnyEquality(ps)
        ()               => None
      (o: PStmt)     => false
    ()         => false

fun [tail] deAnyEquality(ps: List<Spec>) => isEmpty(ps)
  ? false
  : match(first(ps))
    (c: SClass) => deBaseName(c.scName) == "System::BasicEquality"
      ? true
      : deAnyEquality(tail(ps))
    (o: Spec)   => deAnyEquality(tail(ps))

fun deBaseName(name)
  let g2 = indexOf(name, "$generic$", 0)
  ret simpleName(g2 < 0 ? name : slice(name, 0, g2))

# Does equality exist for `sp`? Some provider covers it — binding the
# provider's own params makes its pattern `sp` (compared by unique id, so
# enum views stay one type) and every `where` holds for the binding — or it
# is a candidate enum, assumed to while the fixpoint runs.
fun deHasEquality(sp, ok: List<String>, ps: List<DeProvider>, r): Bool
  if deAssumed(sp, ok)
    ret true
  let u = uid(sp)
  ret u != "" && any(ps, (p) => deCovers(p, sp, u, ok, ps, r))

fun deAssumed(sp, ok: List<String>) => match(sp)
  (e2: SEnum) => contains2(ok, e2.seRoot)
  (o: Spec)   => false

fun deCovers(p: DeProvider, sp, u, ok: List<String>, ps: List<DeProvider>, r) => match(p.dpCovers)
  (pat: Spec) => match(patternBinding(pat, sp, p.dpParams, r))
    (m: List<Binding>) => uid(substitute(pat, m)) == u
                          && all(p.dpWheres, (w) => deWhereHolds(w, m, ok, ps, r))
    ()                 => false
  ()          => p.dpId == u

fun deWhereHolds(w, bindings: List<Binding>, ok: List<String>,
                 ps: List<DeProvider>, r) => match(w)
  (c: SClass) => deBaseName(c.scName) == "System::BasicEquality"
                 && exactly(c.scParams, 1)
                 && deBoundHasEquality(head(c.scParams), bindings, ok, ps, r)
  (o: Spec)   => false

fun deBoundHasEquality(arg: Spec|None, bindings: List<Binding>, ok: List<String>,
                       ps: List<DeProvider>, r) => match(arg)
  (a: Spec) => deHasEquality(substitute(a, bindings), ok, ps, r)
  ()        => false

# ── candidates and their leaves ──────────────────────────────────────────────

# The candidate enums and their leaves, positionally paired. Both are built:
# the consumers walk them in lockstep.
class [linear, final] DeCands(dcNames: List<String>,
                              dcLeaves: List<DeLeaves>)

fun [tail] deCandidates(ss: List<PStmt>, ps: List<DeProvider>, r,
                        [terminal] acc: DeCands): (names: List<String>, leaves: List<DeLeaves>)
  ret isEmpty(ss)
    ? (build(acc.dcNames),
                        build(acc.dcLeaves))
    : match(first(ss))
      # Generic enums never derive — nor, after monomorphisation, their
      # instantiations (no type params left, still not a source enum).
      (e2: PsEnum) => isEmpty(e2.eGens) && !contains(e2.eName, "$generic$")
                      && deLacksEquality(e2, ps, r)
        ? match(deLeaves(e2, List()))
          (dl: DeLeaves) => isEmpty(dl.dlNames)
            ? deCandidates(tail(ss), ps, r, acc)
            : deCandidates(tail(ss), ps, r,
                           DeCands(push(acc.dcNames, e2.eName),
                                   push(acc.dcLeaves, dl)))
          ()             => deCandidates(tail(ss), ps, r, acc)
        : deCandidates(tail(ss), ps, r, acc)
      (o: PStmt)   => deCandidates(tail(ss), ps, r, acc)

fun deLacksEquality(e2: PsEnum, ps: List<DeProvider>, r) => match(e2.eSpec)
  (sp: Spec) => !deHasEquality(sp, List(), ps, r)
  ()         => false

# (leaf unique name, all fields root-down) per constructible leaf, in
# declaration order. None when any variant is uninhabited.
fun deLeaves(e: PsEnum, inherited: List<PStmt>): DeLeaves|None
  let own = concat(inherited, flattenParams(e.eParams))
  if isEmpty(e.eVariants)
    ret e.eHasParams
      ? DeLeaves(list1(e.eName), list1(own))
      : None
  ret deLeafLoop(e.eVariants, own,
                 DeLeaves(List(), List()))

fun [tail] deLeafLoop(vs: List<PStmt>, own: List<PStmt>,
                      acc: DeLeaves): DeLeaves|None => isEmpty(vs)
  ? acc
  : match(first(vs))
    (v: PsEnum) => match(deLeaves(v, own))
      (dl: DeLeaves) => deLeafLoop(tail(vs), own,
                                   DeLeaves(concat(acc.dlNames, dl.dlNames),
                                            concat(acc.dlSets, dl.dlSets)))
      ()             => None
    (o: PStmt)  => deLeafLoop(tail(vs), own, acc)

# ── the coinductive fixpoint ─────────────────────────────────────────────────

fun deFixpoint(names: List<String>, leaves: List<DeLeaves>,
               ps: List<DeProvider>, r)
  let ok2 = deSurvivors(names, leaves, names, ps, r, List())
  ret sameLen(ok2, names)
    ? ok2
    : deFixpoint2(ok2, names, leaves, ps, r)

fun [tail] deFixpoint2(ok: List<String>, names: List<String>,
                       leaves: List<DeLeaves>, ps: List<DeProvider>, r)
  let ok2 = deSurvivors(names, leaves, ok, ps, r, List())
  ret sameLen(ok2, ok)
    ? ok2
    : deFixpoint2(ok2, names, leaves, ps, r)

fun deSurvivors(ns, ls, ok: List<String>, ps: List<DeProvider>, r,
                acc: List<String>): List<String>
  ret build(deSurvivorsB(ns, ls, ok, ps, r, acc))

fun [tail] deSurvivorsB(ns: List<String>, ls: List<DeLeaves>,
                        ok: List<String>, ps: List<DeProvider>, r,
                        [terminal] acc: List<String>) => isEmpty(ns)
  ? acc
  : isEmpty(ls)
    ? acc
    : !contains2(ok, first(ns))
      ? deSurvivorsB(tail(ns), tail(ls), ok, ps, r, acc)
      : deAllFieldsHave(first(ls).dlSets, ok, ps, r)
        ? deSurvivorsB(tail(ns), tail(ls), ok, ps, r, push(acc, first(ns)))
        : deSurvivorsB(tail(ns), tail(ls), ok, ps, r, acc)

fun [tail] deAllFieldsHave(sets: List<List<PStmt>>, ok: List<String>,
                           ps: List<DeProvider>, r) => isEmpty(sets)
  ? true
  : deFieldsHave(first(sets), ok, ps, r)
    ? deAllFieldsHave(tail(sets), ok, ps, r)
    : false

fun [tail] deFieldsHave(fs: List<PStmt>, ok: List<String>,
                        ps: List<DeProvider>, r) => isEmpty(fs)
  ? true
  : match(first(fs))
    (p: PsLet) => match(p.lType)
      (sp: Spec) => deHasEquality(sp, ok, ps, r) ? deFieldsHave(tail(fs), ok, ps, r)
                                                 : false
      ()         => false
    (o: PStmt) => false

# ── synthesis ────────────────────────────────────────────────────────────────

fun deSynthesise(e2: PsEnum, dl: DeLeaves)
  let lr = e2.pseLine
  let ns = deNamespaceOf(e2.eName)
  let iname = ns == "" ? "instance$eq" + deTag(lr) : ns + "::instance$eq" + deTag(lr)
  let pattern = SNamed("System::BasicEquality",
                       list1(SNamed(e2.eName, List(), lr)), lr)
  ret PsTraitInstance(iname, List(), true, List(), pattern,
                      List(),
                      list2(deEqMember(e2, dl), deHashMember(e2, dl)),
                      lr, e2.eImports)

fun deTag(lr: PLine) => hash6(lr.plFile, lr.plLine, lr.plCol)

fun deNamespaceOf(name)
  let s2 = simpleName(name)
  let ix = lastIndexOf2(s2, "::")
  ret ix < 0 ? "" : slice(s2, 0, ix)

fun lastIndexOf2(s2, needle) => deLastIx(s2, needle, 0, -1)

fun [tail] deLastIx(s2, needle, from, best): Int
  let ix = indexOf(s2, needle, from)
  ret ix < 0 ? best : deLastIx(s2, needle, ix + 1, ix)

fun deRef(name, lr) => PeName(name, List(), lr)

fun deOp(rtype, name, args, lr)
  ret PeBuiltinOp(SBuiltin(rtype, lr), PeStr(name, lr), PeTuple(args, lr), lr)

fun deEnt(x) => PTupEnt("", false, x)

fun deCall2(fn, a, b, lr) => PeCall(deRef(fn, lr), PeTuple(list2(deEnt(a), deEnt(b)), lr), lr)

fun deCall1(fn, a, lr) => PeCall(deRef(fn, lr), PeTuple(list1(deEnt(a)), lr), lr)

fun deParam(name, typeName, lr) => PsLet(hashName(name, lr), List(), List(),
                                         SNamed(typeName, List(), lr), None, "", List(), lr)

fun deEqMember(e2: PsEnum, dl: DeLeaves)
  let lr = e2.pseLine
  let arms = deEqArms(dl.dlNames, dl.dlSets, 0,
                      atLeast(dl.dlNames, 2), e2, List())
  let body = PeBlock(List(),
                     PeTernary(deOp("bool", "yafl_ref_eq",
                                    list2(deEnt(deRef("left", lr)), deEnt(deRef("right", lr))), lr),
                               PeBool(true, lr),
                               PeMatch(deRef("left", lr), arms, lr, List()), lr),
                     "", lr)
  ret PsFun(hashName("`==`", lr), List(), List(),
            funParamsStmt(list2(deParam("left", e2.eName, lr), deParam("right", e2.eName, lr)), lr),
            body, SBuiltin("bool", lr), List(), lr)

fun deEqArms(ns, sets, i,
                    many: Bool, e2: PsEnum, acc: List<PArm>): List<PArm>
  ret build(deEqArmsB(ns, sets, i, many, e2, acc))

fun [tail] deEqArmsB(ns: List<String>, sets: List<List<PStmt>>, i,
                    many, e2: PsEnum, [terminal] acc: List<PArm>) => isEmpty(ns)
  ? acc
  : isEmpty(sets)
    ? acc
    : deEqArmsB(tail(ns), tail(sets), i + 1, many, e2,
                                 push(acc, deEqArm(first(ns), first(sets), i,
                                              many, e2)))

fun deEqArm(leafName, fields: List<PStmt>, i: Int, many,
            e2: PsEnum)
  let lr = e2.pseLine
  let xn = "x" + String(i)
  let yn = "y" + String(i)
  let cmp = deFieldsCmp(fields, xn, yn, None, lr)
  let innerArms = many
    ? list2(PArm(hashName(yn, lr), SNamed(leafName, List(), lr),
                        cmp, List(), None, lr, List()), PArm(hashName("o" + String(i), lr),
                  SNamed(e2.eName, List(), lr),
                  PeBool(false, lr), List(), None, lr, List()))
    : list1(PArm(hashName(yn, lr), SNamed(leafName, List(), lr),
                 cmp, List(), None, lr, List()))
  ret PArm(hashName(xn, lr), SNamed(leafName, List(), lr),
           PeMatch(deRef("right", lr), innerArms, lr, List()),
           List(), None, lr, List())

fun [tail] deFieldsCmp(fs: List<PStmt>, xn, yn,
                       acc: PExpr|None, lr) => isEmpty(fs)
  ? match(acc)
    (a: PExpr) => a
    ()         => PeBool(true, lr)
  : match(first(fs))
    (p: PsLet) => deFieldsCmp(tail(fs), xn, yn,
                              deAnd(acc,
                                    deCall2("`==`",
                                            PeDot(deRef(xn, lr),
                                                  bareName(p.lName), lr),
                                            PeDot(deRef(yn, lr),
                                                  bareName(p.lName), lr),
                                            lr),
                                    lr),
                              lr)
    (o: PStmt) => deFieldsCmp(tail(fs), xn, yn, acc, lr)

fun deAnd(acc: PExpr|None, one, lr) => match(acc)
  (a: PExpr) => PeTernary(a, one, PeBool(false, lr), lr)
  ()         => one

fun deHashMember(e2: PsEnum, dl: DeLeaves)
  let lr = e2.pseLine
  let arms = deHashArms(dl.dlNames, dl.dlSets, 0, e2,
                        List())
  let cacheLet = PsLet(hashName("$dhc", lr), List(), List(),
                       SBuiltin("int32", lr),
                       deOp("int32", "yafl_hash_peek",
                            list1(deEnt(deRef("value", lr))), lr),
                       "", List(), lr)
  let body = PeBlock(list1(cacheLet),
                     PeTernary(deOp("bool", "int32_test_eq",
                                    list2(deEnt(deRef("$dhc", lr)), deEnt(PeInt(0, 32, lr))), lr),
                               deOp("int32", "yafl_hash_store",
                                    list2(deEnt(deRef("value", lr)), deEnt(PeMatch(deRef("value", lr),
                                                         arms, lr, List()))), lr),
                               deRef("$dhc", lr), lr),
                     "", lr)
  ret PsFun(hashName("hashOf", lr), List(), List(),
            funParamsStmt(list1(deParam("value", e2.eName, lr)), lr),
            body, SBuiltin("int32", lr), List(), lr)

fun deHashArms(ns, sets, i,
                      e2: PsEnum, acc: List<PArm>): List<PArm>
  ret build(deHashArmsB(ns, sets, i, e2, acc))

fun [tail] deHashArmsB(ns: List<String>, sets: List<List<PStmt>>, i,
                      e2: PsEnum, [terminal] acc: List<PArm>) => isEmpty(ns)
  ? acc
  : isEmpty(sets)
    ? acc
    : deHashArmsB(tail(ns), tail(sets), i + 1, e2,
                                   push(acc, deHashArm(first(ns), first(sets),
                                                  i, e2)))

fun deHashArm(leafName, fields: List<PStmt>, i,
              e2: PsEnum)
  let lr = e2.pseLine
  let xn = "h" + String(i)
  let acc0 = PeInt(i, 32, lr)
  ret PArm(hashName(xn, lr), SNamed(leafName, List(), lr),
           deHashFold(fields, xn, acc0, lr),
           List(), None, lr, List())

fun [tail] deHashFold(fs: List<PStmt>, xn, acc,
                      lr) => isEmpty(fs)
  ? acc
  : match(first(fs))
    (p: PsLet) => deHashFold(tail(fs), xn,
                             deMix(acc,
                                   deCall1("hashOf",
                                           PeDot(deRef(xn, lr),
                                                 bareName(p.lName), lr),
                                           lr),
                                   lr),
                             lr)
    (o: PStmt) => deHashFold(tail(fs), xn, acc, lr)

fun deMix(acc, h, lr) => deOp("int32", "int32_and",
                              list2(deEnt(deOp("int32", "int32_add",
                                                      list2(deEnt(deOp("int32", "int32_mul",
                                                                              list2(deEnt(acc), deEnt(PeInt(31, 32, lr))),
                                                                              lr)), deEnt(h)),
                                                      lr)), deEnt(PeInt(2147483647, 32, lr))),
                              lr)
