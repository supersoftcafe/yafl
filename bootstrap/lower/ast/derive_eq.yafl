# bootstrap/lower/ast/derive_eq.yafl — lowering/derive_eq.py: derived enum
# equality. Every qualifying top-level, non-generic enum with no user
# BasicEquality instance gains
#
#     instance [ambient] System::BasicEquality<E>
#       fun `==`(left: E, right: E): Bool     — ref_eq shortcut, then
#                                               variant-wise field compare
#       fun hashOf(value: E): Int32           — peek/store cache around a
#                                               variant-wise mix
#
# directly after the enum — emitted by the enum's own compile, inside the
# fixpoint (compileEnum asks derivesEquality). The internals are
# representation-aware at codegen, so nothing forces boxing. A user instance
# suppresses derivation.
#
# One question decides everything: does a type have equality — would the
# calls the synthesised members make on a value of it, `==` and `hashOf`,
# resolve? They are looked up as a written call is, in the enum's own scope:
# the ordinary overload resolution, which finds Payload's `==` for two Pay1s
# as it would for `hPay == hPay2`. A generic instance the lookup reaches needs
# its `where` clauses met, and a `where` is exact, so a tuple has equality
# when its members have instances of their own. An enum with equality never
# derives (idempotence); an enum derives only when every member has it.
# COINDUCTIVE: candidates are assumed to have equality, shrunk to a fixpoint.
# Anything without — a union, a function type — blocks; `Spec` never
# derives because PLine has no `==`, so eqSpec keeps sole ownership of spec
# equality.
#
# Synthesis is IDENTICAL to Python's, name for name and binder for binder
# (per-arm indexed binders: match lowering makes one variable per binder name,
# and a shared name across arms violates SSA), so dumps and C stay
# byte-comparable.
namespace Bootstrap::Lower::Ast

import System
import System::Containers

import Bootstrap::Ast
import Bootstrap::Parse
import Bootstrap::Resolve
import Bootstrap::StdlibCandidates
import Bootstrap::Types


class [final] DeLeaves(dlNames: List<String>, dlSets: List<List<PStmt>>)

# The top-level enums that derive equality in this pass's program. A
# whole-program fact — rootResolver memoises it per pass, and each enum's own
# compile emits its instance. IDEMPOTENT: an enum that already has equality —
# a written instance, a derived one, either lowered or monomorphised — never
# derives. The same question decides every member: its `==` and `hashOf`
# resolve (deHasEquality), or it is a candidate itself (coinductive). Empty
# while the answer is incomplete — an instance not yet resolved may be the one
# that already covers an enum; an enum or a candidate's field still a name may
# change every answer — and in a program that does not declare
# System::BasicEquality (compiled without the stdlib).
fun derivableEnums(statements, r): List<String>
  if isEmpty(findType(r, "System::BasicEquality").bItems)
    ret List()
  ret match(deProviders(statements, r, List()))
    (ps: List<DeProvider>) => deDerivable(statements, ps, r)
    ()                     => List()

# An enum, or a candidate's field, whose type is still a name is an input not
# known yet: the answer waits for it, as it waits for the providers. Decided
# without it, `enum Host(hPay: Pay1)` was judged while Pay1 was a name,
# Payload derived alone, and Host never did (#136).
fun deDerivable(statements: List<PStmt>, ps: List<DeProvider>, r: Resolver): List<String>
  if any(statements, deUntypedEnum)
    ret List()
  let start = DeWork(DeCands(List(), List()), Dict<String, DeFinds>(), Dict<String, DeUse>())
  ret match(foldSome(statements, start, (w, st) => deCandidate(w, st, ps, r)))
    (w: DeWork) => deFixpoint(w.dwCands.dcNames, w.dwCands.dcMembers, ps, r)
    ()          => List()

fun deUntypedEnum(st: PStmt): Bool => match(st)
  (e2: PsEnum) => isEmpty(e2.eGens) && !contains(e2.eName, "$generic$") && deNoSpec(e2.eSpec)
  (o: PStmt)   => false

fun deNoSpec(sp: Spec|None): Bool => match(sp)
  (s2: Spec) => false
  ()         => true

fun deLeavesUnresolved(dl: DeLeaves): Bool => any(dl.dlSets, (fs) => any(fs, deFieldUnresolved))

fun deFieldUnresolved(f: PStmt): Bool => match(f)
  (l: PsLet) => match(l.lType)
    (sp: Spec) => containsNamedSpec(sp)
    ()         => true
  (o: PStmt) => false

# The synthesised BasicEquality<e> instance for a derivable enum.
fun derivedInstance(e: PsEnum) => match(deLeaves(e, List()))
  (dl: DeLeaves) => deSynthesise(e, dl)
  ()             => deSynthesise(e, DeLeaves(List(), List()))

# ── where equality comes from ────────────────────────────────────────────────

# One source of BasicEquality: the type it covers, as a pattern over the
# instance's own type params, with the `where` constraints a binding must
# meet — or, once monomorphised, the covered type's unique id (dpId: the
# `$generic$` suffix of the witness's interface, by construction; "" else).
class [final] DeProvider(dpParams: List<String>, dpCovers: Spec|None,
                         dpId: String, dpWheres: List<Spec>)

# Every source of equality in the program, in whatever form it now has — or
# None while one of them has not resolved enough to read.
fun deProviders(ss: List<PStmt>, r, acc: List<DeProvider>): List<DeProvider>|None =>
  foldSome(ss, acc, (a, st) => deProvidersOf(st, r, a))

# First-class instances (generic ones with their `where` clauses), and
# lowered ones: a `[trait]` let whose witness CLASS implements the interface
# (monomorphised, its parents carry mangled names).
fun deProvidersOf(st, r, acc: List<DeProvider>): List<DeProvider>|None => match(st)
  (ti: PsTraitInstance) => deAdd(ti.tiPattern, genNames(ti.tiGens, List()),
                                 ti.tiWheres, r, acc)
  (let2: PsLet) => hasAttr(let2.lAttrs, "trait") && isEmpty(let2.lGens)
    ? deAddWitness(let2, r, acc)
    : acc
  (o: PStmt) => acc

fun deAddWitness(let2: PsLet, r, acc: List<DeProvider>): List<DeProvider>|None => match(let2.lType)
  (dc: SClass) => match(soleItem(findType(r, dc.scName)))
    (f: Found) => match(f.fStmt)
      (cls: PsClass) => match(cls.cAllParents)
        (ps: List<Spec>) => deAddAll(ps, r, acc)
        ()               => None
      (o: PStmt)     => acc
    ()         => acc
  ()           => None

fun deAddAll(ps: List<Spec>, r, acc: List<DeProvider>): List<DeProvider>|None =>
  foldSome(ps, acc, (a, p) => deAdd(p, List(), List(), r, a))

# Record `iface` if it provides equality; None when it cannot be read yet.
fun deAdd(iface, params: List<String>, wheres: List<Spec>, r,
          acc: List<DeProvider>): List<DeProvider>|None => match(iface)
  (c: SClass) => match(deReachesEquality(c.scName, r))
    (b: Bool) => b ? deProvidedIfKnown(c, params, wheres, acc) : acc
    ()        => None
  (o: Spec)   => None

# The type it covers, or a `where` it needs, still a name: which type it
# provides for is not known yet. Read as covering nothing, a written
# `BasicEquality<Payload>` let Payload derive a second instance beside it
# (#136: a program converged above a settled stdlib met its own instance
# while the argument was a name).
fun deProvidedIfKnown(c: SClass, params: List<String>, wheres: List<Spec>,
                      acc: List<DeProvider>): List<DeProvider>|None
  if containsNamedSpec(c) || any(wheres, containsNamedSpec)
    ret None
  ret deProvided(c, params, wheres, acc)

fun deProvided(c: SClass, params: List<String>, wheres: List<Spec>,
               acc: List<DeProvider>) => match(head(c.scParams))
  (arg: Spec) => prepend(DeProvider(params, arg, "", wheres), acc)
  ()          => deMonoProvided(c, acc)

fun deMonoProvided(c: SClass, acc: List<DeProvider>)
  let g2 = indexOf(c.scName, "$generic$", 0)
  ret g2 < 0
    ? acc
    : prepend(DeProvider(List(), None, slice(c.scName, g2 + 9, length(c.scName)),
                         List()), acc)

# Equality arrives TRANSITIVELY: the interface's cAllParents is the closure.
# None while that closure has not resolved.
fun deReachesEquality(name, r): Bool|None
  if deBaseName(name) == "System::BasicEquality"
    ret true
  ret match(soleItem(findType(r, name)))
    (f: Found) => match(f.fStmt)
      (cls: PsClass) => match(cls.cAllParents)
        (ps: List<Spec>) => deAnyEquality(ps)
        ()               => None
      (o: PStmt)     => false
    ()         => false

fun deAnyEquality(ps: List<Spec>) => any(ps, deAnyEqualityStep)

fun deAnyEqualityStep(x: Spec) => match(x)
  (c: SClass) => deBaseName(c.scName) == "System::BasicEquality"
  (o: Spec) => false

fun deBaseName(name)
  let g2 = indexOf(name, "$generic$", 0)
  ret simpleName(g2 < 0 ? name : slice(name, 0, g2))

# Does `sp` have equality? The calls a derived instance makes on it resolve,
# and every generic instance they reach has what its `where` asks for; or it
# is an enum deriving in this pass, assumed to while the fixpoint runs: its
# instance, once it exists, takes any value of it.
fun deHasEquality(sp: Spec|None, use: DeUse, ok: List<String>, ps: List<DeProvider>,
                  r: Resolver): Bool =>
  match(sp)
    (s2: Spec) => deAssumed(s2, ok)
                  || (use.duFits && all(use.duNeeds, (n) => deInstanceExists(n, ok, ps, r)))
    ()         => false

fun deAssumed(sp: Spec, ok: List<String>) => match(sp)
  (e2: SEnum) => contains(ok, e2.seRoot)
  (o: Spec)   => false

# Is there an instance for exactly `sp`, as `where BasicEquality<sp>` asks?
# Some provider covers it — binding the provider's own params makes its
# pattern `sp`, compared by unique id — and every `where` holds for the
# binding; or it is an enum deriving in this pass, assumed to while the
# fixpoint runs. A `where` is exact: a level of an enum is not its root.
fun deInstanceExists(sp: Spec, ok: List<String>, ps: List<DeProvider>, r: Resolver): Bool
  if deAssumedExactly(sp, ok)
    ret true
  let u = uid(sp)
  ret u != "" && any(ps, (p) => deCovers(p, sp, u, ok, ps, r))

fun deAssumedExactly(sp: Spec, ok: List<String>) => match(sp)
  (e2: SEnum) => isEmpty(e2.sePath) && contains(ok, e2.seRoot)
  (o: Spec)   => false

fun deCovers(p: DeProvider, sp, u, ok: List<String>, ps: List<DeProvider>, r) => match(p.dpCovers)
  (pat: Spec) => match(patternBinding(pat, sp, p.dpParams, r))
    (m: List<Binding>) => uid(substitute(pat, m)) == u
                          && all(p.dpWheres, (w) => deWhereHolds(w, m, ok, ps, r))
    ()                 => false
  ()          => p.dpId == u

fun deWhereHolds(w, bindings: List<Binding>, ok: List<String>,
                 ps: List<DeProvider>, r) => match(w)
  (c: SClass) => deBaseName(c.scName) == "System::BasicEquality"
                 && exactly(c.scParams, 1)
                 && deBoundHasInstance(head(c.scParams), bindings, ok, ps, r)
  (o: Spec)   => false

fun deBoundHasInstance(arg: Spec|None, bindings: List<Binding>, ok: List<String>,
                       ps: List<DeProvider>, r) => match(arg)
  (a: Spec) => deInstanceExists(substitute(a, bindings), ok, ps, r)
  ()        => false

# ── candidates and their leaves ──────────────────────────────────────────────

# The candidate enums and their members (each field's type, and what the
# derived instance's calls on it resolve to), positionally paired: the
# fixpoint walks them in lockstep.
class [final] DeCands(dcNames: List<String>, dcMembers: List<List<DeMember>>)

class [final] DeMember(dmSpec: Spec|None, dmUse: DeUse)

# The candidates so far, and the lookups made, once per scope and type: every
# candidate's fields are asked about on every round of the fixpoint, and most
# share a type.
class [final] DeWork(dwCands: DeCands, dwFinds: Dict<String, DeFinds>,
                     dwUses: Dict<String, DeUse>)

class [final] DeWorkUse(wuWork: DeWork, wuUse: DeUse)

class [final] DeMembers(dmsWork: DeWork, dmsList: List<DeMember>)

fun deCandidate(w: DeWork, st: PStmt, ps: List<DeProvider>, r: Resolver): DeWork|None => match(st)
  # Generic enums never derive — nor, after monomorphisation, their
  # instantiations (no type params left, still not a source enum).
  (e2: PsEnum) => isEmpty(e2.eGens) && !contains(e2.eName, "$generic$")
    ? deRoot(w, e2, ps, r)
    : w
  (o: PStmt)   => w

# Already has equality: an instance for exactly it, in whatever form it now
# has — written, derived, or lowered to a witness, which no call finds by
# name — or its own `==` and `hashOf` resolve without one. Derivation fills a
# gap, never competes.
fun deRoot(w: DeWork, e2: PsEnum, ps: List<DeProvider>, r: Resolver): DeWork|None => match(e2.eSpec)
  (sp: Spec) => deInstanceExists(sp, List(), ps, r) ? w : deRootLookup(w, e2, sp, ps, r)
  ()         => None

fun deRootLookup(w: DeWork, e2: PsEnum, sp: Spec, ps: List<DeProvider>,
                 r: Resolver): DeWork|None =>
  match(deUseOf(w, e2, sp, r))
    (wu: DeWorkUse) => deHasEquality(sp, wu.wuUse, List(), ps, r)
      ? wu.wuWork
      : deRootLeaves(wu.wuWork, e2, r)
    ()              => None

fun deRootLeaves(w: DeWork, e2: PsEnum, r: Resolver): DeWork|None => match(deLeaves(e2, List()))
  (dl: DeLeaves) => isEmpty(dl.dlNames) ? w : deRootMembers(w, e2, dl, r)
  ()             => w

fun deRootMembers(w: DeWork, e2: PsEnum, dl: DeLeaves, r: Resolver): DeWork|None
  if deLeavesUnresolved(dl)
    ret None
  let fields = fold(dl.dlSets, List<PStmt>(), (acc, fs) => concat(acc, fs))
  ret match(foldSome(fields, DeMembers(w, List()), (m, f) => deMemberStep(m, e2, f, r)))
    (m: DeMembers) => DeWork(DeCands(append(m.dmsWork.dwCands.dcNames, e2.eName),
                                     append(m.dmsWork.dwCands.dcMembers, m.dmsList)),
                             m.dmsWork.dwFinds, m.dmsWork.dwUses)
    ()             => None

fun deMemberStep(m: DeMembers, e2: PsEnum, f: PStmt, r: Resolver): DeMembers|None => match(f)
  (l: PsLet) => match(l.lType)
    (sp: Spec) => match(deUseOf(m.dmsWork, e2, sp, r))
      (wu: DeWorkUse) => DeMembers(wu.wuWork, append(m.dmsList, DeMember(sp, wu.wuUse)))
      ()              => None
    ()         => None
  (o: PStmt) => DeMembers(m.dmsWork, append(m.dmsList, DeMember(None, DeUse(false, List()))))

# ── the lookup ───────────────────────────────────────────────────────────────

# What the calls a derived instance makes on a value of one type resolve to:
# duFits when its `==` and its `hashOf` each resolve to one candidate that
# takes it, and the types a generic instance among them then needs an
# instance for, exactly — its `where`.
class [final] DeUse(duFits: Bool, duNeeds: List<Spec>)

# The enum's scope, with every `==` and `hashOf` it can see.
class [final] DeFinds(dfScope: Resolver, dfEq: List<Found>, dfHash: List<Found>)

fun deUseOf(w: DeWork, e2: PsEnum, sp: Spec, r: Resolver): DeWorkUse|None
  let key = deScopeKey(e2)
  let memo = key + "|" + uid(sp)
  ret match(uid(sp) == "" ? None : get(w.dwUses, memo))
    (known: DeUse) => DeWorkUse(w, known)
    ()             => deUseFresh(w, e2, key, memo, sp, r)

fun deUseFresh(w: DeWork, e2: PsEnum, key: String, memo: String, sp: Spec,
               r: Resolver): DeWorkUse|None =>
  match(deFindsOf(w, e2, key, r))
    (f: DeFinds) => deRemember(DeWork(w.dwCands, put(w.dwFinds, key, f), w.dwUses),
                               memo, sp, deUse(f, sp, e2.pseLine))
    ()           => None

fun deRemember(w: DeWork, memo: String, sp: Spec, use: DeUse): DeWorkUse =>
  DeWorkUse(uid(sp) == "" ? w : DeWork(w.dwCands, w.dwFinds, put(w.dwUses, memo, use)), use)

fun deFindsOf(w: DeWork, e2: PsEnum, key: String, r: Resolver): DeFinds|None => match(get(w.dwFinds, key))
  (f: DeFinds) => f
  ()           => deFinds(traitScope(List(), scopeResolver(e2, r)))

fun deScopeKey(e2: PsEnum): String => join(sort(stmtScopes(e2)), ",") + "|" + ownNamespace(e2.eName)

# `scope` with every `==` and `hashOf` it can see — or None while that search
# is incomplete, or a candidate's type is still a name: one not known yet may
# be the one a call would take.
fun deFinds(scope: Resolver): DeFinds|None
  let eq = findData(scope, "`==`")
  let hash = findData(scope, "hashOf")
  ret deSettled(eq) && deSettled(hash) ? DeFinds(scope, eq.bItems, hash.bItems) : None

fun deSettled(f: Findings) => f.bComplete && all(f.bItems, deKnownSignature)

fun deKnownSignature(x: Found): Bool => match(candidateSignature(x))
  (sig: Spec) => !containsNamedSpec(sig)
  ()          => false

# What the synthesised members' own calls on a value of type `sp` —
# `left.f == right.f` for a Bool, `hashOf(value.f)` for an Int32 — resolve to
# in the enum's scope: the ordinary overload resolution a written call gets.
# A generic instance is taken only when the call binds its parameters.
fun deUse(f: DeFinds, sp: Spec, lr: PLine): DeUse
  let one = SEntry("", sp, None)
  let eq = deCall(f.dfScope, f.dfEq, SCallable(STuple(list2(one, one), lr), SBuiltin("bool", lr), lr))
  let hash = deCall(f.dfScope, f.dfHash, SCallable(STuple(list1(one), lr), SBuiltin("int32", lr), lr))
  ret match(eq)
    (a: List<Spec>) => match(hash)
      (b: List<Spec>) => DeUse(true, concat(a, b))
      ()              => DeUse(false, List())
    ()              => DeUse(false, List())

# One call: what the sole candidate that takes it needs — nothing, or the
# type a generic instance's `where` then asks about — or None when no
# candidate, or more than one, does.
fun deCall(scope: Resolver, cands: List<Found>, want: Spec): List<Spec>|None =>
  match(soleOf(resolveOverloads(scope, want, cands)))
    (x: Found) => deTaken(scope, x, want)
    ()         => None

fun deTaken(scope: Resolver, x: Found, want: Spec): List<Spec>|None => match(x.fInstanceParams)
  (own: List<String>) => isEmpty(own) ? deAccepts(scope, x, want) : deSolved(scope, x, own, want)
  ()                  => deAccepts(scope, x, want)

fun deSolved(scope: Resolver, x: Found, own: List<String>, want: Spec): List<Spec>|None =>
  match(solveInstanceScope(x, own, want, scope))
    (c: SClass) => exactly(c.scParams, 1) ? c.scParams : None
    (o: Spec)   => None
    ()          => None

fun deAccepts(scope: Resolver, x: Found, want: Spec): List<Spec>|None => match(candidateSignature(x))
  (sig: Spec) => match(assignableEq(scope, want, sig))
    (b: Bool) => b ? List<Spec>() : None
    ()        => None
  ()          => None

# (leaf unique name, all fields root-down) per constructible leaf, in
# declaration order. None when any variant is uninhabited.
fun deLeaves(e: PsEnum, inherited: List<PStmt>): DeLeaves|None
  let own = concat(inherited, flattenParams(e.eParams))
  if isEmpty(e.eVariants)
    ret e.eHasParams
      ? DeLeaves(list1(e.eName), list1(own))
      : None
  ret deLeafLoop(e.eVariants, own,
                 DeLeaves(List(), List()))

fun deLeafLoop(vs: List<PStmt>, own: List<PStmt>, acc: DeLeaves): DeLeaves|None =>
  foldSome(vs, acc, (a, v) => deLeafStep(a, v, own))

fun deLeafStep(acc: DeLeaves, st: PStmt, own: List<PStmt>): DeLeaves|None => match(st)
  (v: PsEnum) => match(deLeaves(v, own))
    (dl: DeLeaves) => DeLeaves(concat(acc.dlNames, dl.dlNames), concat(acc.dlSets, dl.dlSets))
    ()             => None
  (o: PStmt)  => acc

# ── the coinductive fixpoint ─────────────────────────────────────────────────

fun deFixpoint(names: List<String>, members: List<List<DeMember>>,
               ps: List<DeProvider>, r: Resolver)
  let ok2 = deSurvivors(names, members, names, ps, r, List())
  ret sameLen(ok2, names)
    ? ok2
    : deFixpoint2(ok2, names, members, ps, r)

fun [tail] deFixpoint2(ok: List<String>, names: List<String>,
                       members: List<List<DeMember>>, ps: List<DeProvider>, r: Resolver)
  let ok2 = deSurvivors(names, members, ok, ps, r, List())
  ret sameLen(ok2, ok)
    ? ok2
    : deFixpoint2(ok2, names, members, ps, r)

fun deSurvivors(ns: List<String>, ms: List<List<DeMember>>, ok: List<String>,
                ps: List<DeProvider>, r: Resolver, acc: List<String>): List<String> =>
  zipFold(ns, ms, acc,
          (a, x, m) => contains(ok, x) && all(m, (d) => deHasEquality(d.dmSpec, d.dmUse, ok, ps, r))
            ? append(a, x)
            : a)

# ── synthesis ────────────────────────────────────────────────────────────────

fun deSynthesise(e2: PsEnum, dl: DeLeaves)
  let lr = e2.pseLine
  let ns = deNamespaceOf(e2.eName)
  let iname = ns == "" ? "instance$eq" + deTag(lr) : ns + "::instance$eq" + deTag(lr)
  let pattern = SNamed("System::BasicEquality",
                       list1(SNamed(e2.eName, List(), lr)), lr)
  ret PsTraitInstance(iname, List(), true, List(), pattern,
                      List(),
                      list2(deEqMember(e2, dl), deHashMember(e2, dl)),
                      lr, e2.eImports)

fun deTag(lr: PLine) => hash6(lr.plFile, lr.plLine, lr.plCol)

fun deNamespaceOf(name)
  let s2 = simpleName(name)
  let ix = lastIndexOf2(s2, "::")
  ret ix < 0 ? "" : slice(s2, 0, ix)

fun lastIndexOf2(s2, needle) => deLastIx(s2, needle, 0, -1)

fun [tail] deLastIx(s2, needle, from, best): Int
  let ix = indexOf(s2, needle, from)
  ret ix < 0 ? best : deLastIx(s2, needle, ix + 1, ix)

fun deRef(name, lr) => PeName(name, List(), lr)

fun deOp(rtype, name, args, lr)
  ret PeBuiltinOp(SBuiltin(rtype, lr), PeStr(name, lr), PeTuple(args, lr), lr)

fun deEnt(x) => PTupEnt("", false, x)

fun deCall2(fn, a, b, lr) => PeCall(deRef(fn, lr), PeTuple(list2(deEnt(a), deEnt(b)), lr), lr, None)

fun deCall1(fn, a, lr) => PeCall(deRef(fn, lr), PeTuple(list1(deEnt(a)), lr), lr, None)

fun deParam(name, typeName, lr) => PsLet(hashName(name, lr), List(), List(),
                                         SNamed(typeName, List(), lr), None, "", List(), lr)

fun deEqMember(e2: PsEnum, dl: DeLeaves)
  let lr = e2.pseLine
  let arms = deEqArms(dl.dlNames, dl.dlSets, 0,
                      sizeAtLeast(dl.dlNames, 2), e2, List())
  let body = PeBlock(List(),
                     PeTernary(deOp("bool", "yafl_ref_eq",
                                    list2(deEnt(deRef("left", lr)), deEnt(deRef("right", lr))), lr),
                               PeBool(true, lr),
                               PeMatch(deRef("left", lr), arms, lr, List()), lr),
                     "", lr)
  ret PsFun(hashName("`==`", lr), List(), List(),
            funParamsStmt(list2(deParam("left", e2.eName, lr), deParam("right", e2.eName, lr)), lr),
            body, SBuiltin("bool", lr), List(), lr)

fun deEqArms(ns: List<String>, sets: List<List<PStmt>>, i: Int,
             many: Bool, e2: PsEnum, acc: List<PArm>): List<PArm> =>
  zipFold(ns, sets, (i = i, acc = acc),
          (st, n, set) => (i = st.i + 1, acc = append(st.acc, deEqArm(n, set, st.i, many, e2)))).acc

fun deEqArm(leafName, fields: List<PStmt>, i: Int, many,
            e2: PsEnum)
  let lr = e2.pseLine
  let xn = "x" + String(i)
  let yn = "y" + String(i)
  let cmp = deFieldsCmp(fields, xn, yn, None, lr)
  let innerArms = many
    ? list2(PArm(hashName(yn, lr), SNamed(leafName, List(), lr),
                        cmp, List(), None, lr, List()), PArm(hashName("o" + String(i), lr),
                  SNamed(e2.eName, List(), lr),
                  PeBool(false, lr), List(), None, lr, List()))
    : list1(PArm(hashName(yn, lr), SNamed(leafName, List(), lr),
                 cmp, List(), None, lr, List()))
  ret PArm(hashName(xn, lr), SNamed(leafName, List(), lr),
           PeMatch(deRef("right", lr), innerArms, lr, List()),
           List(), None, lr, List())

fun deFieldsCmp(fs: List<PStmt>, xn, yn, acc: PExpr|None, lr) =>
  fold(fs, acc, (a2, x) => deFieldsCmpStep(a2, x, xn, yn, lr))
    |> (v) => v ?? PeBool(true, lr)

fun deFieldsCmpStep(a2: PExpr|None, x: PStmt, xn, yn, lr) => match(x)
  (p: PsLet) => deAnd(a2,
    deCall2("`==`",
            PeDot(deRef(xn, lr), bareName(p.lName), lr),
            PeDot(deRef(yn, lr), bareName(p.lName), lr),
            lr),
    lr)
  (o: PStmt) => a2

fun deAnd(acc: PExpr|None, one, lr) => match(acc)
  (a: PExpr) => PeTernary(a, one, PeBool(false, lr), lr)
  ()         => one

fun deHashMember(e2: PsEnum, dl: DeLeaves)
  let lr = e2.pseLine
  let arms = deHashArms(dl.dlNames, dl.dlSets, 0, e2,
                        List())
  let cacheLet = PsLet(hashName("$dhc", lr), List(), List(),
                       SBuiltin("int32", lr),
                       deOp("int32", "yafl_hash_peek",
                            list1(deEnt(deRef("value", lr))), lr),
                       "", List(), lr)
  let body = PeBlock(list1(cacheLet),
                     PeTernary(deOp("bool", "int32_test_eq",
                                    list2(deEnt(deRef("$dhc", lr)), deEnt(PeInt(0, 32, lr))), lr),
                               deOp("int32", "yafl_hash_store",
                                    list2(deEnt(deRef("value", lr)), deEnt(PeMatch(deRef("value", lr),
                                                         arms, lr, List()))), lr),
                               deRef("$dhc", lr), lr),
                     "", lr)
  ret PsFun(hashName("hashOf", lr), List(), List(),
            funParamsStmt(list1(deParam("value", e2.eName, lr)), lr),
            body, SBuiltin("int32", lr), List(), lr)

fun deHashArms(ns: List<String>, sets: List<List<PStmt>>, i: Int,
               e2: PsEnum, acc: List<PArm>): List<PArm> =>
  zipFold(ns, sets, (i = i, acc = acc),
          (st, n, set) => (i = st.i + 1, acc = append(st.acc, deHashArm(n, set, st.i, e2)))).acc

fun deHashArm(leafName, fields: List<PStmt>, i,
              e2: PsEnum)
  let lr = e2.pseLine
  let xn = "h" + String(i)
  let acc0 = PeInt(i, 32, lr)
  ret PArm(hashName(xn, lr), SNamed(leafName, List(), lr),
           deHashFold(fields, xn, acc0, lr),
           List(), None, lr, List())

fun deHashFold(fs: List<PStmt>, xn, acc, lr) =>
  fold(fs, acc, (a, x) => deHashFoldStep(a, x, xn, lr))

fun deHashFoldStep(a: PExpr, x: PStmt, xn, lr) => match(x)
  (p: PsLet) => deMix(a, deCall1("hashOf", PeDot(deRef(xn, lr), bareName(p.lName), lr), lr), lr)
  (o: PStmt) => a

fun deMix(acc, h, lr) => deOp("int32", "int32_and",
                              list2(deEnt(deOp("int32", "int32_add",
                                                      list2(deEnt(deOp("int32", "int32_mul",
                                                                              list2(deEnt(acc), deEnt(PeInt(31, 32, lr))),
                                                                              lr)), deEnt(h)),
                                                      lr)), deEnt(PeInt(2147483647, 32, lr))),
                              lr)
