# bootstrap/ast_inline.yafl — lowering/ast_inline.py's SHARED MACHINERY: free
# references, Tarjan SCCs over sibling-call graphs, and the nested-function
# hoist (closure-vs-global strategy). The INLINER half of ast_inline.py is a
# later stage; hoist_nested.yafl and lambda_lift.yafl are the pipeline entry
# points that consume these cores.
namespace Bootstrap::Lower::Ast

import System

import Bootstrap::Ast
import Bootstrap::Frontend
import Bootstrap::Parse
import Bootstrap::Resolve
import Bootstrap::StdlibCandidates
import Bootstrap::Types



# ── free references ──────────────────────────────────────────────────────────
# Names referenced in fn's body that are not fn's own params/lets/nested-fns
# or alsoExclude. Python returns a set; the port returns an ENCOUNTER-ordered
# deduped list — consumers that need a canonical order sort it, exactly as the
# (determinism-fixed) Python now does.

# A Set of names, not a list: the two consumers are set operations —
# coAddCaps sorts it before use, hoIntersect intersects it — so the order the
# walk happened to meet them in is not observable.
fun freeRefs(f: PsFun, alsoExclude: List<String>): Set<String >
  let own = frOwnNames(f, alsoExclude)
  ret match(f.fBody)
    (b: PExpr) => match(b)
      (bk: PeBlock) => frExpr(b, own, Set<String >())
      (o: PExpr)    => Set<String >()
    ()         => Set<String >()

fun frOwnNames(f: PsFun, alsoExclude: List<String>): List<String>
  let params = allStmtNames(chain(flattenParams(f.fParams)), alsoExclude)
  ret match(f.fBody)
    (b: PExpr) => match(b)
      (bk: PeBlock) => frBlockNames(chain(bk.blockStmts), params)
      (o: PExpr)    => params
    ()         => params

fun frBlockNames(ss: Chain<PStmt>, acc: List<String>): List<String>
  ret build<String >(frBlockNamesB(ss, _pushChain<String >(builder<String >(), chain<String >(acc))))

fun [tail] frBlockNamesB(ss: Chain<PStmt>, [terminal] acc: ListBuilder<String >): ListBuilder<String >
  ret match(ss)
    (nil: ChainEnd) => acc
    (l: ChainLink)  => match(l.value)
      (let2: PsLet) => frBlockNamesB(l.next, push<String >(acc, let2.lName))
      (f: PsFun)    => frBlockNamesB(l.next, push<String >(acc, f.fName))
      (o: PStmt)    => frBlockNamesB(l.next, acc)

# The free-reference accumulator is a SET: both consumers of freeRefs are set
# operations (coAddCaps sorts it, hoIntersect intersects it), so there is no
# order to keep. `add` is idempotent, so the "already present" test goes with
# it — the O(n) scan per name becomes one O(log n) insert.
fun frAdd(acc: Set<String >, exclude: List<String>, name: String): Set<String >
  ret contains2(exclude, name) ? acc : add<String >(acc, name)

fun frExpr(x: PExpr, exclude: List<String>, acc: Set<String >): Set<String >
  ret match(x)
    (nm: PeName)   => frAdd(acc, exclude, nm.refName)
    (d: PeDot)     => frExpr(d.base, exclude, acc)
    (c: PeCall)    => frExpr(c.parameter, exclude,
                             frExpr(c.function, exclude, acc))
    (tp: PeTuple)  => frEnts(chain(tp.exprs), exclude, acc)
    (te: PeTernary) => frExpr(te.falseResult, exclude,
                        frExpr(te.trueResult, exclude,
                          frExpr(te.condition, exclude, acc)))
    (lm: PeLambda) => frExpr(lm.lamBody, exclude,
                             frStmt(lm.lamParams, exclude, acc))
    (bk: PeBlock)  => frExpr(bk.blockValue, exclude,
                             frStmts(chain(bk.blockStmts), exclude, acc))
    (mt: PeMatch)  => frArms(chain(mt.arms), exclude,
                             frExpr(mt.subject, exclude, acc))
    (op: PeBuiltinOp) => frExpr(op.opParams, exclude, acc)
    (nw: PeNew)    => frExpr(nw.newParam, exclude, acc)
    (qq: PeCoalesce) => frExpr(qq.qqFallback, exclude,
                                frExpr(qq.qqSubject, exclude, acc))
    (ar: PeArrayRead) => frExpr(ar.arrIndex, exclude,
                                frExpr(ar.arrObj, exclude, acc))
    (cv: PeConvert) => frExpr(cv.convInner, exclude, acc)
    (wx: PeWith)   => frExpr(wx.withRepls, exclude,
                             frExpr(wx.withSubject, exclude, acc))
    (pl: PeParallel) => frExpr(pl.parParams, exclude, acc)
    (lp: PeLoop)   => frExpr(lp.loopBody, exclude,
                             frExprs(chain(lp.loopParams), exclude, acc))
    (rc: PeRecur)  => frExprs(chain(rc.recArgs), exclude, acc)
    (ne: PeNewEnum) => fold(ne.fieldArgs, acc, (a2: Set<String >, fa: PFieldArg) =>
                            frExpr(fa.faValue, exclude, a2))
    (o: PExpr)     => acc

fun [tail] frExprs(es: Chain<PExpr>, exclude: List<String>,
                   acc: Set<String >): Set<String >
  ret match(es)
    (nil: ChainEnd) => acc
    (l: ChainLink)  => frExprs(l.next, exclude,
                               frExpr(l.value, exclude, acc))

fun [tail] frEnts(es: Chain<PTupEnt>, exclude: List<String>,
                  acc: Set<String >): Set<String >
  ret match(es)
    (nil: ChainEnd) => acc
    (l: ChainLink)  => frEnts(l.next, exclude,
                              frExpr(l.value.tupValue, exclude, acc))

fun [tail] frArms(as2: Chain<PArm>, exclude: List<String>,
                  acc: Set<String >): Set<String >
  ret match(as2)
    (nil: ChainEnd) => acc
    (l: ChainLink)  => frArms(l.next, exclude,
        frOpt(l.value.armGuard, exclude,
              frExpr(l.value.armBody, exclude, acc)))

fun frOpt(x: PExpr|None, exclude: List<String>,
          acc: Set<String >): Set<String >
  ret match(x)
    (e2: PExpr) => frExpr(e2, exclude, acc)
    ()          => acc

fun [tail] frStmts(ss: Chain<PStmt>, exclude: List<String>,
                   acc: Set<String >): Set<String >
  ret match(ss)
    (nil: ChainEnd) => acc
    (l: ChainLink)  => frStmts(l.next, exclude,
                               frStmt(l.value, exclude, acc))

fun frStmt(st: PStmt, exclude: List<String>, acc: Set<String >): Set<String >
  ret match(st)
    (f: PsFun)   => frOpt(f.fBody, exclude, frStmt(f.fParams, exclude, acc))
    (l: PsLet)   => frOpt(l.lDefault, exclude, acc)
    (d: PsDestructure) => frStmts(chain(d.dTargets), exclude,
                                  frOpt(d.dDefault, exclude, acc))
    (rt: PsRet)  => frExpr(rt.retValue, exclude, acc)
    (a: PsAction) => frExpr(a.action, exclude, acc)
    (i: PsIf)    => frStmts(chain(i.ifFalse), exclude,
                            frStmts(chain(i.ifTrue), exclude,
                                    frExpr(i.ifCond, exclude, acc)))
    (o: PStmt)   => acc

# ── Tarjan over the sibling-call graph ───────────────────────────────────────
# Node INPUT order preserved (no sort — the input is declaration order);
# neighbours sorted, matching the determinism-fixed Python. SCCs come out in
# reverse topological order (callees before callers). Reuses the Tj machinery
# from complex_enums.yafl.

fun aiSccs(nodes: List<String>, work: EEdges): List<List<String>>
  ret tjRoots(chain(nodes), work,
              Tj(Dict<String, Int>(), Dict<String, Int>(), List<String>(),
                 Set<String >(), List<List<String>>(), 0)).tjSccs

# The '$generic$…' tail of a specialised parent's name, or "".
fun specializationSuffix(name: String): String
  ret match(chain(split(name, "$generic$")))
    (l: ChainLink)  => match(l.next)
      (nil: ChainEnd) => ""
      (m: ChainLink)  => "$generic$" + join(List<String>(m), "$generic$")
    (nil2: ChainEnd) => ""

# ── nested-fn → let(lambda) ──────────────────────────────────────────────────
# Only for a capturing function: lambdas.py lifts it with closure capture.

fun toLetLambda(f: PsFun): PStmt
  let callableType = funType(f)
  ret match(f.fBody)
    (b: PExpr) => PsLet(f.fName, List<PAttr>(), List<PGen>(), callableType,
                        PeLambda(f.fParams, b, f.psfLine, callableType),
                        "", List<Spec>(), f.psfLine, false, f.fImports)
    ()         => f

# ── outer var types ──────────────────────────────────────────────────────────
# name → declared type for fn's params and top-level lets (fields of a
# synthesised closure class).

# A name -> type map, held as a Dict rather than two parallel Lists. Lookup was
# a linear walk of both chains in lockstep; it is now O(log n) and the pairing
# cannot drift. The CAPTURE order that coClassParam turns into generated class
# fields is recovered by sorting the names — which reproduces it exactly,
# because captures are collected from sort<String>(freeRefs(...)) already.
class [final] OuterTypes(otMap: Dict<String, Spec>)

fun gatherOuterVarTypes(f: PsFun): OuterTypes
  let fromParams = otAdd(chain(flattenParams(f.fParams)),
                         OuterTypes(Dict<String, Spec>()))
  ret match(f.fBody)
    (b: PExpr) => match(b)
      (bk: PeBlock) => otAdd(chain(bk.blockStmts), fromParams)
      (o: PExpr)    => fromParams
    ()         => fromParams

fun [tail] otAdd(ss: Chain<PStmt>, acc: OuterTypes): OuterTypes
  ret match(ss)
    (nil: ChainEnd) => acc
    (l: ChainLink)  => match(l.value)
      (let2: PsLet) => match(let2.lType)
        # FIRST binding of a name wins, not the last. The old shape appended to
        # a chain that was searched head-first, so the earliest entry answered
        # the lookup; parameters are gathered before body lets, so a body let
        # that shadows a parameter must NOT displace it. A plain `put` would
        # silently reverse that.
        (sp: Spec) => otAdd(l.next, contains<String, Spec>(acc.otMap, let2.lName)
                            ? acc
                            : OuterTypes(put<String, Spec>(acc.otMap,
                                                           let2.lName, sp)))
        ()         => otAdd(l.next, acc)
      (o: PStmt)    => otAdd(l.next, acc)

# ── this-redirect for coalesced class methods ────────────────────────────────
# NamedExpression(name) → this.<target[name]> for any name in the map.

# A Dict, not two parallel Lists. The only thing anyone ever asks it is "what
# does this name redirect to", and it is asked once per name node of every
# rewritten body — the parallel-list version answered that by walking both
# chains in lockstep, so rewriting a body cost the size of the map times the
# size of the body. It also could not fall out of step, which two lists
# appended to independently can.
class [final] ThisMap(tmMap: Dict<String, String>)

fun tmLookup(m: ThisMap, name: String): String|None
  ret get<String, String>(m.tmMap, name)

fun rcmExpr(x: PExpr, m: ThisMap): PExpr
  ret match(x)
    (nm: PeName)   => match(tmLookup(m, nm.refName))
      (target: String) => PeDot(PeName("this", List<Spec>(), nm.penLine,
                                       None),
                                target, nm.penLine)
      ()               => x
    (d: PeDot)     => PeDot(rcmExpr(d.base, m), d.member, d.pedLine)
    (c: PeCall)    => PeCall(rcmExpr(c.function, m), rcmExpr(c.parameter, m),
                             c.pecLine)
    (tp: PeTuple)  => PeTuple(rcmEnts(chain(tp.exprs), m, List<PTupEnt>()),
                              tp.petLine)
    (te: PeTernary) => PeTernary(rcmExpr(te.condition, m),
                                 rcmExpr(te.trueResult, m),
                                 rcmExpr(te.falseResult, m), te.pety)
    (lm: PeLambda) => PeLambda(rcmStmt(lm.lamParams, m),
                               rcmExpr(lm.lamBody, m), lm.pelLine, lm.lamRet)
    (bk: PeBlock)  => PeBlock(rcmStmts(chain(bk.blockStmts), m,
                                       List<PStmt>()),
                              rcmExpr(bk.blockValue, m), bk.blockTag,
                              bk.pebkLine)
    (mt: PeMatch)  => PeMatch(rcmExpr(mt.subject, m),
                              rcmArms(chain(mt.arms), m, List<PArm>()),
                              mt.pemLine)
    (op: PeBuiltinOp) => PeBuiltinOp(op.opType, op.opName,
                                     rcmExpr(op.opParams, m), op.peboLine)
    (nw: PeNew)    => PeNew(nw.newType, rcmExpr(nw.newParam, m), nw.penwLine)
    (qq: PeCoalesce) => PeCoalesce(rcmExpr(qq.qqSubject, m),
                                     rcmExpr(qq.qqFallback, m), qq.peqqLine)
    (ar: PeArrayRead) => PeArrayRead(rcmExpr(ar.arrObj, m),
                                     rcmExpr(ar.arrIndex, m), ar.pearLine)
    (cv: PeConvert) => PeConvert(rcmExpr(cv.convInner, m), cv.convTarget,
                                 cv.pecvLine)
    (wx: PeWith)   => PeWith(rcmExpr(wx.withSubject, m),
                             rcmExpr(wx.withRepls, m), wx.pewLine)
    (pl: PeParallel) => PeParallel(rcmExpr(pl.parParams, m), pl.pepLine)
    (lp: PeLoop)   => PeLoop(rcmExpr(lp.loopBody, m),
                             rcmExprs(chain(lp.loopParams), m,
                                      List<PExpr>()),
                             lp.pelpLine)
    (rc: PeRecur)  => PeRecur(rcmExprs(chain(rc.recArgs), m, List<PExpr>()),
                              rc.recIndex, rc.percLine)
    (ne: PeNewEnum) => PeNewEnum(ne.rootName, ne.leafName,
                                 map(ne.fieldArgs, (fa: PFieldArg) =>
                                   PFieldArg(fa.faName, rcmExpr(fa.faValue, m))),
                                 ne.neTypeParams, ne.penewLine)
    (o: PExpr)     => x

fun rcmExprs(es: Chain<PExpr>, m: ThisMap,
                    acc: List<PExpr>): List<PExpr>
  ret build<PExpr >(rcmExprsB(es, m, _pushChain<PExpr >(builder<PExpr >(), chain<PExpr >(acc))))

fun [tail] rcmExprsB(es: Chain<PExpr>, m: ThisMap,
                    [terminal] acc: ListBuilder<PExpr >): ListBuilder<PExpr >
  ret match(es)
    (nil: ChainEnd) => acc
    (l: ChainLink)  => rcmExprsB(l.next, m, push<PExpr >(acc, rcmExpr(l.value, m)))

fun rcmEnts(es: Chain<PTupEnt>, m: ThisMap,
                   acc: List<PTupEnt>): List<PTupEnt>
  ret build<PTupEnt >(rcmEntsB(es, m, _pushChain<PTupEnt >(builder<PTupEnt >(), chain<PTupEnt >(acc))))

fun [tail] rcmEntsB(es: Chain<PTupEnt>, m: ThisMap,
                   [terminal] acc: ListBuilder<PTupEnt >): ListBuilder<PTupEnt >
  ret match(es)
    (nil: ChainEnd) => acc
    (l: ChainLink)  => rcmEntsB(l.next, m,
        push<PTupEnt >(acc, PTupEnt(l.value.tupName, l.value.tupSpread,
                            rcmExpr(l.value.tupValue, m))))

fun rcmArms(as2: Chain<PArm>, m: ThisMap, acc: List<PArm>): List<PArm>
  ret build<PArm >(rcmArmsB(as2, m, _pushChain<PArm >(builder<PArm >(), chain<PArm >(acc))))

fun [tail] rcmArmsB(as2: Chain<PArm>, m: ThisMap, [terminal] acc: ListBuilder<PArm >): ListBuilder<PArm >
  ret match(as2)
    (nil: ChainEnd) => acc
    (l: ChainLink)  => rcmArmsB(l.next, m,
        push<PArm >(acc, PArm(l.value.armName, l.value.armType,
                         rcmExpr(l.value.armBody, m), l.value.armLiterals,
                         rcmOpt(l.value.armGuard, m), l.value.parmLine)))

fun rcmOpt(x: PExpr|None, m: ThisMap): PExpr|None
  ret match(x)
    (e2: PExpr) => rcmExpr(e2, m)
    ()          => None

fun rcmStmts(ss: Chain<PStmt>, m: ThisMap,
                    acc: List<PStmt>): List<PStmt>
  ret build<PStmt >(rcmStmtsB(ss, m, _pushChain<PStmt >(builder<PStmt >(), chain<PStmt >(acc))))

fun [tail] rcmStmtsB(ss: Chain<PStmt>, m: ThisMap,
                    [terminal] acc: ListBuilder<PStmt >): ListBuilder<PStmt >
  ret match(ss)
    (nil: ChainEnd) => acc
    (l: ChainLink)  => rcmStmtsB(l.next, m, push<PStmt >(acc, rcmStmt(l.value, m)))

fun rcmStmt(st: PStmt, m: ThisMap): PStmt
  ret match(st)
    (f: PsFun)  => PsFun(f.fName, f.fAttrs, f.fGens, rcmStmt(f.fParams, m),
                         rcmOpt(f.fBody, m), f.fRet, f.fWheres, f.psfLine,
                         f.fRetInferred, f.fNested, f.fImports)
    (l: PsLet)  => PsLet(l.lName, l.lAttrs, l.lGens, l.lType,
                         rcmOpt(l.lDefault, m), l.lArrayLen, l.lWheres,
                         l.pslLine, l.lTypeInferred, l.lImports)
    (d: PsDestructure) => PsDestructure(d.dName, d.dAttrs, d.dType,
                                        rcmStmts(chain(d.dTargets), m,
                                                 List<PStmt>()),
                                        rcmOpt(d.dDefault, m), d.psdLine,
                                        d.dTypeInferred)
    (rt: PsRet)  => PsRet(rcmExpr(rt.retValue, m), rt.psrLine)
    (a: PsAction) => PsAction(rcmExpr(a.action, m), a.psaLine)
    (i: PsIf)    => PsIf(rcmExpr(i.ifCond, m),
                         rcmStmts(chain(i.ifTrue), m, List<PStmt>()),
                         rcmStmts(chain(i.ifFalse), m, List<PStmt>()),
                         i.psifLine)
    (o: PStmt)   => st

# ── coalesce a mutually-recursive capturing SCC into one class ──────────────

class [final] Coalesced(coClass: PStmt, coLets: List<PStmt>)

fun coalesceMutualScc(sccFns: List<PsFun>, outer: OuterTypes,
                      siblingNames: List<String>,
                      specSuffix: String): Coalesced
  let lr = coFirstLine(sccFns)
  let caps = coUnionCaptures(chain(sccFns), outer, siblingNames,
                             OuterTypes(Dict<String, Spec>()))
  # Sorted once and shared by the three walks below: the class fields, the
  # constructor arguments, and the this-map's identity entries all have to
  # agree, and they agree because they are the same list.
  let capNames = coCapNames(caps)
  let renames = coRenames(chain(sccFns), lr, specSuffix,
                          ThisMap(Dict<String, String>()))
  # Captured names redirect to themselves; method names redirect to their
  # class-unique targets. The capture entries are put in LAST so that they win
  # a collision, which is what the old shape did by placing them first in a
  # chain searched from the head.
  let thisMap = ThisMap(fold<String, Dict<String, String> >(capNames,
                            renames.tmMap,
                            (d: Dict<String, String>, n: String) =>
                              put<String, String>(d, n, n)))
  let methods = coMethods(chain(sccFns), renames, thisMap, List<PStmt>())
  let clsName = "$mutual::class@" + hash6(lr.plFile, lr.plLine, lr.plCol)
                + specSuffix
  let cls = PsClass(clsName, prepend(PAttr("final", PeInt(1, 32, lr)),
                                     List<PAttr>()),
                    List<PGen>(), coClassParam(caps, lr), List<Spec>(),
                    List<Spec>(), methods, false, lr, List<Spec>(),
                    List<Slot>(), List<PStmt>())
  let sharedName = "$mutual::shared@" + hash6(lr.plFile, lr.plLine, lr.plCol)
                   + specSuffix
  let clsType = SClass(clsName, List<Spec>(), lr)
  let sharedLet = PsLet(sharedName, List<PAttr>(), List<PGen>(), clsType,
                        PeNew(clsType,
                              PeTuple(coCaptureArgs(chain(capNames), lr,
                                                    List<PTupEnt>()),
                                      lr),
                              lr),
                        "", List<Spec>(), lr, false, List<PStmt>())
  ret Coalesced(cls, coMethodLets(chain(sccFns), renames, sharedName, lr,
                                  prepend(sharedLet, List<PStmt>())))

fun coFirstLine(sccFns: List<PsFun>): PLine
  ret match(chain(sccFns))
    (l: ChainLink)  => l.value.psfLine
    (nil: ChainEnd) => PLine("$mutual", 1, 1)

# Union captures: every outer var referenced by any member of the SCC.
#
# The capture ORDER reaches generated code — it is the field order of the
# shared class and the argument order of its construction — so it must be
# stable, but it need not be the visit order. It is taken as SORTED BY NAME at
# the point of use (coCapNames), which makes the generated class a function of
# WHICH names are captured rather than of the order the members happened to be
# walked in. The old shape was "sorted per member, first encounter wins across
# members", which needed a per-member sort AND a dedupe scan to get a
# deterministic answer; one sort at the end is both. The Python compiler makes
# the same change, so the two stay byte-identical.
fun [tail] coUnionCaptures(fs: Chain<PsFun>, outer: OuterTypes,
                           siblingNames: List<String>,
                           acc: OuterTypes): OuterTypes
  ret match(fs)
    (nil: ChainEnd) => acc
    (l: ChainLink)  => coUnionCaptures(l.next, outer, siblingNames,
        coAddCaps(freeRefs(l.value, siblingNames), outer, acc))

# A REDUCTION over an unordered Set, which is the one thing a Set fold may be
# used for: every name is resolved against the SAME `outer` map, so two members
# capturing one name contribute an identical entry and the order in which they
# arrive cannot change the result. The "already captured" test that guarded the
# old append is gone with it — `put` of an equal entry is idempotent.
fun coAddCaps(ns: Set<String >, outer: OuterTypes, acc: OuterTypes): OuterTypes
  ret fold<String, OuterTypes>(ns, acc,
          (a: OuterTypes, n: String) => coAddCap(a, n, outer))

# A name that resolves to no outer type is not a capture — it is a reference to
# something that is not in scope out here, and it is dropped, exactly as the
# old lookup-then-append did by never appending.
fun coAddCap(acc: OuterTypes, n: String, outer: OuterTypes): OuterTypes
  ret match(get<String, Spec>(outer.otMap, n))
    (sp: Spec) => OuterTypes(put<String, Spec>(acc.otMap, n, sp))
    ()         => acc

# The captured names in their canonical order. Every consumer that walks the
# captures — class fields, constructor arguments, parameter lets — goes through
# this, so they cannot disagree.
fun coCapNames(caps: OuterTypes): List<String>
  ret sort<String>(keys<String, Spec>(caps.otMap))

fun [tail] coRenames(fs: Chain<PsFun>, lr: PLine, specSuffix: String,
                     acc: ThisMap): ThisMap
  ret match(fs)
    (nil: ChainEnd) => acc
    # A later member with the same name (an overload) overwrites the earlier
    # entry, where the chain lookup would have kept the first — same answer
    # either way, because the target is a pure function of the name.
    (l: ChainLink)  => coRenames(l.next, lr, specSuffix,
        ThisMap(put<String, String>(acc.tmMap, l.value.fName,
                    "$mut::" + l.value.fName + "@"
                    + hash6(lr.plFile, lr.plLine, lr.plCol) + specSuffix)))

fun coMethods(fs: Chain<PsFun>, renames: ThisMap, thisMap: ThisMap,
                     acc: List<PStmt>): List<PStmt>
  ret build<PStmt >(coMethodsB(fs, renames, thisMap, _pushChain<PStmt >(builder<PStmt >(), chain<PStmt >(acc))))

fun [tail] coMethodsB(fs: Chain<PsFun>, renames: ThisMap, thisMap: ThisMap,
                     [terminal] acc: ListBuilder<PStmt >): ListBuilder<PStmt >
  ret match(fs)
    (nil: ChainEnd) => acc
    (l: ChainLink)  => coMethodsB(l.next, renames, thisMap,
                                 push<PStmt >(acc, coMethod(l.value, renames,
                                                      thisMap)))

fun coMethod(f: PsFun, renames: ThisMap, thisMap: ThisMap): PStmt
  let newName = match(tmLookup(renames, f.fName))
    (n: String) => n
    ()          => f.fName
  ret PsFun(newName, f.fAttrs, f.fGens, f.fParams,
            rcmOpt(f.fBody, thisMap), f.fRet, f.fWheres, f.psfLine,
            f.fRetInferred, f.fNested, f.fImports)

fun coClassParam(caps: OuterTypes, lr: PLine): PStmt
  let ns = coCapNames(caps)
  ret PsDestructure("_", List<PAttr>(),
                    STuple(coEntries(chain(ns), caps, List<SEntry>()), lr),
                    coParamLets(chain(ns), caps, lr, List<PStmt>()),
                    None, lr, false)

# The name chain drives the walk and the type comes from the map, so the two
# cannot fall out of step — which the old pair of chains walked in lockstep
# could, silently, by ending at different lengths. Names come from the map's
# own keys, so the None arm is unreachable; it is there to make the match total.
fun coEntries(ns: Chain<String>, caps: OuterTypes,
                     acc: List<SEntry>): List<SEntry>
  ret build<SEntry >(coEntriesB(ns, caps, _pushChain<SEntry >(builder<SEntry >(), chain<SEntry >(acc))))

fun [tail] coEntriesB(ns: Chain<String>, caps: OuterTypes,
                     [terminal] acc: ListBuilder<SEntry >): ListBuilder<SEntry >
  ret match(ns)
    (nil: ChainEnd) => acc
    (n: ChainLink)  => match(get<String, Spec>(caps.otMap, n.value))
      (sp: Spec) => coEntriesB(n.next, caps,
                               push<SEntry >(acc, SEntry(n.value, sp, None)))
      ()         => coEntriesB(n.next, caps, acc)

fun coParamLets(ns: Chain<String>, caps: OuterTypes, lr: PLine,
                       acc: List<PStmt>): List<PStmt>
  ret build<PStmt >(coParamLetsB(ns, caps, lr, _pushChain<PStmt >(builder<PStmt >(), chain<PStmt >(acc))))

fun [tail] coParamLetsB(ns: Chain<String>, caps: OuterTypes, lr: PLine,
                       [terminal] acc: ListBuilder<PStmt >): ListBuilder<PStmt >
  ret match(ns)
    (nil: ChainEnd) => acc
    (n: ChainLink)  => match(get<String, Spec>(caps.otMap, n.value))
      (sp: Spec) => coParamLetsB(n.next, caps, lr,
          push<PStmt >(acc, PsLet(n.value, List<PAttr>(), List<PGen>(), sp,
                            None, "", List<Spec>(), lr, false,
                            List<PStmt>())))
      ()         => coParamLetsB(n.next, caps, lr, acc)

fun coCaptureArgs(ns: Chain<String>, lr: PLine,
                         acc: List<PTupEnt>): List<PTupEnt>
  ret build<PTupEnt >(coCaptureArgsB(ns, lr, _pushChain<PTupEnt >(builder<PTupEnt >(), chain<PTupEnt >(acc))))

fun [tail] coCaptureArgsB(ns: Chain<String>, lr: PLine,
                         [terminal] acc: ListBuilder<PTupEnt >): ListBuilder<PTupEnt >
  ret match(ns)
    (nil: ChainEnd) => acc
    (l: ChainLink)  => coCaptureArgsB(l.next, lr,
        push<PTupEnt >(acc, PTupEnt(l.value, false,
                            PeName(l.value, List<Spec>(), lr, None))))

# One shared instance, then one let per method exposing it under the
# original nested-fn name.
fun coMethodLets(fs: Chain<PsFun>, renames: ThisMap,
                        sharedName: String, lr: PLine,
                        acc: List<PStmt>): List<PStmt>
  ret build<PStmt >(coMethodLetsB(fs, renames, sharedName, lr, _pushChain<PStmt >(builder<PStmt >(), chain<PStmt >(acc))))

fun [tail] coMethodLetsB(fs: Chain<PsFun>, renames: ThisMap,
                        sharedName: String, lr: PLine,
                        [terminal] acc: ListBuilder<PStmt >): ListBuilder<PStmt >
  ret match(fs)
    (nil: ChainEnd) => acc
    (l: ChainLink)  => coMethodLetsB(l.next, renames, sharedName, lr,
        push<PStmt >(acc, PsLet(l.value.fName, List<PAttr>(), List<PGen>(),
                          funType(l.value),
                          PeDot(PeName(sharedName, List<Spec>(), lr, None),
                                coRenameOf(renames, l.value.fName), lr),
                          "", List<Spec>(), lr, false, List<PStmt>())))

fun coRenameOf(renames: ThisMap, name: String): String
  ret match(tmLookup(renames, name))
    (n: String) => n
    ()          => name

# ── the hoist ────────────────────────────────────────────────────────────────

class [final] Hoisted(hoBody: List<PStmt>, hoRenames: ThisMap,
                      hoOut: List<PStmt>)

fun hoistFromBody(f: PsFun): Hoisted
  ret match(f.fBody)
    (b: PExpr) => match(b)
      (bk: PeBlock) => hoistFromBlock(f, bk)
      (o: PExpr)    => Hoisted(List<PStmt>(),
                               ThisMap(Dict<String, String>()),
                               List<PStmt>())
    ()         => Hoisted(List<PStmt>(),
                          ThisMap(Dict<String, String>()),
                          List<PStmt>())

fun hoistFromBlock(f: PsFun, bk: PeBlock): Hoisted
  let outerVars = frBlockNames(chain(bk.blockStmts),
                               allStmtNames(chain(flattenParams(f.fParams)),
                                            List<String>()))
  let nested = hoNestedFns(chain(bk.blockStmts), List<PsFun>())
  if isEmpty(nested)
    ret Hoisted(bk.blockStmts, ThisMap(Dict<String, String>()),
                List<PStmt>())
  let siblingNames = hoFnNames(chain(nested), List<String>())
  let specSuffix = specializationSuffix(f.fName)
  let callEdges = hoCallEdges(chain(nested), siblingNames,
                              EEdges(Dict<String, List<String>>()))
  let directCaptures = hoDirectCaptures(chain(nested), siblingNames,
                                        hoOuterOnly(outerVars, siblingNames),
                                        List<String>())
  let sccs = aiSccs(siblingNames, callEdges)
  let needsClosure = hoNeedsClosure(chain(sccs), sccs, callEdges,
                                    directCaptures, Set<String >())
  let outerTypes = gatherOuterVarTypes(f)
  ret hoBuild(hoWalkBody(chain(bk.blockStmts), f, sccs, needsClosure,
                         callEdges, nested, outerTypes, siblingNames,
                         specSuffix, Set<String >(), HoAcc(builder<PStmt >(), ThisMap(Dict<String, String>()), builder<PStmt >())))

# `outer_var_names` excludes nothing in Python (params | lets, funs separate);
# the frBlockNames above also collected nested FN names — drop those.
fun hoOuterOnly(names: List<String>, siblingNames: List<String>): List<String>
  ret tjRemoveAll(chain(names), siblingNames, List<String>())

fun hoNestedFns(ss: Chain<PStmt>, acc: List<PsFun>): List<PsFun>
  ret build<PsFun >(hoNestedFnsB(ss, _pushChain<PsFun >(builder<PsFun >(), chain<PsFun >(acc))))

fun [tail] hoNestedFnsB(ss: Chain<PStmt>, [terminal] acc: ListBuilder<PsFun >): ListBuilder<PsFun >
  ret match(ss)
    (nil: ChainEnd) => acc
    (l: ChainLink)  => match(l.value)
      (f: PsFun) => hoHasBlockBody(f)
        ? hoNestedFnsB(l.next, push<PsFun >(acc, f))
        : hoNestedFnsB(l.next, acc)
      (o: PStmt) => hoNestedFnsB(l.next, acc)

fun hoHasBlockBody(f: PsFun): Bool
  ret match(f.fBody)
    (b: PExpr) => match(b)
      (bk: PeBlock) => true
      (o: PExpr)    => false
    ()         => false

fun hoFnNames(fs: Chain<PsFun>, acc: List<String>): List<String>
  ret build<String >(hoFnNamesB(fs, _pushChain<String >(builder<String >(), chain<String >(acc))))

fun [tail] hoFnNamesB(fs: Chain<PsFun>, [terminal] acc: ListBuilder<String >): ListBuilder<String >
  ret match(fs)
    (nil: ChainEnd) => acc
    (l: ChainLink)  => hoFnNamesB(l.next, push<String >(acc, l.value.fName))

fun [tail] hoCallEdges(fs: Chain<PsFun>, siblingNames: List<String>,
                       acc: EEdges): EEdges
  ret match(fs)
    (nil: ChainEnd) => acc
    (l: ChainLink)  => hoCallEdges(l.next, siblingNames,
        EEdges(put<String, List<String>>(acc.eeMap, l.value.fName,
                   hoIntersect(chain(sort<String>(freeRefs(l.value,
                                                           List<String>()))),
                               siblingNames, List<String>()))))

fun hoIntersect(ns: Chain<String>, keep: List<String>,
                       acc: List<String>): List<String>
  ret build<String >(hoIntersectB(ns, keep, _pushChain<String >(builder<String >(), chain<String >(acc))))

fun [tail] hoIntersectB(ns: Chain<String>, keep: List<String>,
                       [terminal] acc: ListBuilder<String >): ListBuilder<String >
  ret match(ns)
    (nil: ChainEnd) => acc
    (l: ChainLink)  => contains2(keep, l.value)
      ? hoIntersectB(l.next, keep, push<String >(acc, l.value))
      : hoIntersectB(l.next, keep, acc)

fun hoDirectCaptures(fs: Chain<PsFun>, siblingNames: List<String>,
                            outerVars: List<String>,
                            acc: List<String>): List<String>
  ret build<String >(hoDirectCapturesB(fs, siblingNames, outerVars, _pushChain<String >(builder<String >(), chain<String >(acc))))

fun [tail] hoDirectCapturesB(fs: Chain<PsFun>, siblingNames: List<String>,
                            outerVars: List<String>,
                            [terminal] acc: ListBuilder<String >): ListBuilder<String >
  ret match(fs)
    (nil: ChainEnd) => acc
    # Does this function reference ANY outer var? That is a question about
    # membership, not about order — so it is asked of the set directly rather
    # than by materialising the intersection and measuring it.
    (l: ChainLink)  => any<String>(freeRefs(l.value, siblingNames),
                                   (n: String) => contains2(outerVars, n))
      ? hoDirectCapturesB(l.next, siblingNames, outerVars,
                          push<String >(acc, l.value.fName))
      : hoDirectCapturesB(l.next, siblingNames, outerVars, acc)

# Reverse-topo order (callees first): one pass settles closure-need
# propagation along sibling-call edges.
#
# The accumulator is a SET OF NAMES, not a list of SCCs. Every reader — here
# and at hoSccIsNeedy — asks it the same single question, "does some settled
# SCC contain this name", and answering that from a list of lists meant a scan
# of every name settled so far, nested inside the per-callee loop which is
# itself nested inside the per-member loop. The SCC grouping was never read
# back, so it is not stored.
fun [tail] hoNeedsClosure(ss: Chain<List<String>>, all: List<List<String>>,
                          edges: EEdges, directCaptures: List<String>,
                          done: Set<String >): Set<String >
  ret match(ss)
    (nil: ChainEnd) => done
    (l: ChainLink)  => hoSccNeeds(l.value, edges, directCaptures, done)
      ? hoNeedsClosure(l.next, all, edges, directCaptures,
                       fold<String, Set<String > >(l.value, done,
                           (s: Set<String >, n: String) => add<String >(s, n)))
      : hoNeedsClosure(l.next, all, edges, directCaptures, done)

# done = the names of the closure-needing SCCs settled so far (callees precede
# callers).
fun hoSccNeeds(scc: List<String>, edges: EEdges, directCaptures: List<String>,
               done: Set<String >): Bool
  if hoAnyIn(chain(scc), directCaptures)
    ret true
  ret hoCallsInto(chain(scc), scc, edges, done)

fun [tail] hoAnyIn(ns: Chain<String>, set2: List<String>): Bool
  ret match(ns)
    (nil: ChainEnd) => false
    (l: ChainLink)  => contains2(set2, l.value)
      ? true
      : hoAnyIn(l.next, set2)

fun [tail] hoCallsInto(ns: Chain<String>, own: List<String>, edges: EEdges,
                       done: Set<String >): Bool
  ret match(ns)
    (nil: ChainEnd) => false
    (l: ChainLink)  => hoCalleeNeedy(chain(ceChildrenOf(edges, l.value)),
                                     own, done)
      ? true
      : hoCallsInto(l.next, own, edges, done)

fun [tail] hoCalleeNeedy(cs: Chain<String>, own: List<String>,
                         done: Set<String >): Bool
  ret match(cs)
    (nil: ChainEnd) => false
    (l: ChainLink)  => !contains2(own, l.value)
                       && contains<String >(done, l.value)
      ? true
      : hoCalleeNeedy(l.next, own, done)

fun [tail] hoSccOf(ss: Chain<List<String>>, name: String): List<String>
  ret match(ss)
    (nil: ChainEnd) => List<String>()
    (l: ChainLink)  => contains2(l.value, name)
      ? l.value
      : hoSccOf(l.next, name)

# Walk the body in declaration order; a whole SCC is handled at its first
# member's position.
#
# The accumulator carries BUILDERS. Both of its lists are ordered — the
# rewritten body is program order, and the statements hoisted out of it are
# emitted in the order they were produced — so each step adds at the tail. That
# is what makes the class [linear,final]: a ListBuilder's O(1) push is sound
# only because linearity proves nothing else holds a reference to the cell it
# mutates, and holding one in a field makes the holder linear too.
#
# The visible consequence is that `acc` must be consumed exactly ONCE on every
# path. There is no longer a `keep` value prepared before the branch and
# discarded by the branches that do not want it — hoKeep builds it where it is
# used instead.
class [linear, final] HoAcc(haBody: ListBuilder<PStmt >, haRenames: ThisMap,
                            haOut: ListBuilder<PStmt >)

# Out of the builders and into the plain result, once the walk is over. The
# result is read many times by the caller, which a linear value could not be.
fun hoBuild(acc: HoAcc): Hoisted
  ret Hoisted(build<PStmt >(acc.haBody), acc.haRenames,
              build<PStmt >(acc.haOut))

class [linear, final] HoStep(wsProcessed: Set<String >, wsAcc: HoAcc)

fun [tail] hoWalkBody(ss: Chain<PStmt>, f: PsFun, sccs: List<List<String>>,
                      needy: Set<String >, edges: EEdges,
                      nested: List<PsFun>, outerTypes: OuterTypes,
                      siblingNames: List<String>, specSuffix: String,
                      processed: Set<String >,
                      [terminal] acc: HoAcc): HoAcc
  ret match(ss)
    (nil: ChainEnd) => acc
    (l: ChainLink)  => hoStep(l.value, f, sccs, needy, nested, outerTypes,
                              siblingNames, specSuffix, processed, acc)
      |> (st2) => hoWalkBody(l.next, f, sccs, needy, edges, nested,
                             outerTypes, siblingNames, specSuffix,
                             st2.wsProcessed, st2.wsAcc)

fun hoStep(st: PStmt, f: PsFun, sccs: List<List<String>>,
           needy: Set<String >, nested: List<PsFun>,
           outerTypes: OuterTypes, siblingNames: List<String>,
           specSuffix: String, processed: Set<String >,
           acc: HoAcc): HoStep
  ret match(st)
    (fn: PsFun) => hoStepFn(fn, f, sccs, needy, nested, outerTypes,
                            siblingNames, specSuffix, processed, acc)
    (o: PStmt)  => hoKeep(st, processed, acc)

# This statement stays where it is: push it to the body and move on.
fun hoKeep(st: PStmt, processed: Set<String >, acc: HoAcc): HoStep
  ret HoStep(processed,
             HoAcc(push<PStmt >(acc.haBody, st), acc.haRenames, acc.haOut))

fun hoStepFn(fn: PsFun, f: PsFun, sccs: List<List<String>>,
             needy: Set<String >, nested: List<PsFun>,
             outerTypes: OuterTypes, siblingNames: List<String>,
             specSuffix: String, processed: Set<String >,
             acc: HoAcc): HoStep
  if !hoHasBlockBody(fn) || !contains2(siblingNames, fn.fName)
    ret hoKeep(fn, processed, acc)
  # `processed` answers one question — has this SCC already been handled at an
  # earlier member's position — so it is a set of names, and the SCC's members
  # are folded into it rather than concatenated onto a list that is then
  # scanned linearly on every subsequent statement.
  if contains<String >(processed, fn.fName)
    ret HoStep(processed, acc)
  let scc = hoSccOf(chain(sccs), fn.fName)
  ret HoStep(fold<String, Set<String > >(scc, processed,
                 (s: Set<String >, n: String) => add<String >(s, n)),
             hoScc(scc, f, needy, nested, outerTypes, siblingNames,
                   specSuffix, acc))

fun hoScc(scc: List<String>, f: PsFun, needy: Set<String >,
          nested: List<PsFun>, outerTypes: OuterTypes,
          siblingNames: List<String>, specSuffix: String,
          acc: HoAcc): HoAcc
  let members = hoMembersOf(chain(scc), nested, List<PsFun>())
  if !hoSccIsNeedy(scc, needy)
    ret hoGlobals(chain(members), f, specSuffix, acc)
  ret match(chain(members))
    (l: ChainLink) => match(l.next)
      (nil: ChainEnd) => HoAcc(push<PStmt >(acc.haBody, toLetLambda(l.value)),
                               acc.haRenames, acc.haOut)
      (m: ChainLink)  => hoCoalesce(members, outerTypes, siblingNames,
                                    specSuffix, acc)
    (nil2: ChainEnd) => acc

# A mutually recursive group: the shared class is hoisted out, and the per-
# method lets take the group's place in the body, in the order the coalescer
# produced them.
fun hoCoalesce(members: List<PsFun>, outerTypes: OuterTypes,
               siblingNames: List<String>, specSuffix: String,
               acc: HoAcc): HoAcc
  let co = coalesceMutualScc(members, outerTypes, siblingNames, specSuffix)
  ret HoAcc(_pushChain<PStmt >(acc.haBody, chain<PStmt >(co.coLets)),
            acc.haRenames,
            push<PStmt >(acc.haOut, co.coClass))

# Every member of an SCC shares its neediness, so one member answers for all.
fun hoSccIsNeedy(scc: List<String>, needy: Set<String >): Bool
  ret match(chain(scc))
    (l: ChainLink)  => contains<String >(needy, l.value)
    (nil: ChainEnd) => false

fun hoMembersOf(ns: Chain<String>, nested: List<PsFun>,
                       acc: List<PsFun>): List<PsFun>
  ret build<PsFun >(hoMembersOfB(ns, nested, _pushChain<PsFun >(builder<PsFun >(), chain<PsFun >(acc))))

fun [tail] hoMembersOfB(ns: Chain<String>, nested: List<PsFun>,
                       [terminal] acc: ListBuilder<PsFun >): ListBuilder<PsFun >
  ret match(ns)
    (nil: ChainEnd) => acc
    (l: ChainLink)  => match(hoFnByName(chain(nested), l.value))
      (f: PsFun) => hoMembersOfB(l.next, nested, push<PsFun >(acc, f))
      ()         => hoMembersOfB(l.next, nested, acc)

fun [tail] hoFnByName(fs: Chain<PsFun>, name: String): PsFun|None
  ret match(fs)
    (nil: ChainEnd) => None
    (l: ChainLink)  => l.value.fName == name
      ? l.value
      : hoFnByName(l.next, name)

# Direct hoist to global: the member loses is_nested, takes the owner's
# wheres, and — for a generic specialisation host — the spec suffix.
fun [tail] hoGlobals(fs: Chain<PsFun>, f: PsFun, specSuffix: String,
                     [terminal] acc: HoAcc): HoAcc
  ret match(fs)
    (nil: ChainEnd) => acc
    (l: ChainLink)  => hoGlobals(l.next, f, specSuffix,
                                 hoGlobalOne(l.value, f, specSuffix, acc))

# Moving to top level: is_nested drops, the owner's wheres become explicit
# (an inner function has none of its own); a specialisation host's suffix is
# appended to prevent cross-instantiation collisions.
fun hoGlobalOne(member0: PsFun, f: PsFun, specSuffix: String,
                acc: HoAcc): HoAcc
  if specSuffix != "" && !endsWith(member0.fName, specSuffix)
    ret HoAcc(acc.haBody,
              ThisMap(put<String, String>(acc.haRenames.tmMap, member0.fName,
                                          member0.fName + specSuffix)),
              push<PStmt >(acc.haOut,
                     PsFun(member0.fName + specSuffix, member0.fAttrs,
                           member0.fGens, member0.fParams, member0.fBody,
                           member0.fRet, f.fWheres, member0.psfLine,
                           member0.fRetInferred, false,
                           member0.fImports)))
  ret HoAcc(acc.haBody, acc.haRenames,
            push<PStmt >(acc.haOut,
                   PsFun(member0.fName, member0.fAttrs, member0.fGens,
                         member0.fParams, member0.fBody, member0.fRet,
                         f.fWheres, member0.psfLine,
                         member0.fRetInferred, false,
                         member0.fImports)))

# ── the recursive driver ─────────────────────────────────────────────────────
# Applied recursively so nested-inside-nested functions are hoisted too.

fun hoistNestedFnsToLambdas(statements: List<PStmt>): List<PStmt>
  let out = hoDrive(chain(statements), List<PStmt>(), List<PStmt>())
  ret out

# `acc` is the rewritten statement list in program order, so it is built at the
# tail. `extra` stays a plain List: the base case asks whether it is empty, and
# a builder cannot be read — only pushed to and, once, built.
fun hoDrive(ss: Chain<PStmt>, acc: List<PStmt>,
            extra: List<PStmt>): List<PStmt>
  ret build<PStmt >(hoDriveB(ss, _pushChain<PStmt >(builder<PStmt >(),
                                                    chain<PStmt >(acc)),
                             extra))

fun [tail] hoDriveB(ss: Chain<PStmt>, [terminal] acc: ListBuilder<PStmt >,
                    extra: List<PStmt>): ListBuilder<PStmt >
  ret match(ss)
    (nil: ChainEnd) => isEmpty(extra)
      ? acc
      : _pushChain<PStmt >(acc, chain<PStmt >(hoistNestedFnsToLambdas(extra)))
    # The per-fn step returns a VALUE and the loop stays [tail] (the pipe
    # beta-reduces before tail_loop, so the self-call is direct) — the old
    # hoDriveFn mutual hop left TWO C frames per function statement on the
    # stack, overflowing 8MB at self-host scale.
    (l: ChainLink)  => match(l.value)
      (f: PsFun) => hoHasBlockBody(f)
        ? hoDriveFnStep(f) |> (st: PStmt, outs: List<PStmt>) =>
            hoDriveB(l.next, push<PStmt >(acc, st), concat(extra, outs))
        : hoDriveB(l.next, push<PStmt >(acc, l.value), extra)
      (o: PStmt) => hoDriveB(l.next, push<PStmt >(acc, l.value), extra)

fun hoDriveFnStep(f: PsFun): (stmt: PStmt, outs: List<PStmt>)
  let ho = hoistFromBody(f)
  let renamed = isEmpty(ho.hoRenames.tmMap)
    ? ho
    : Hoisted(rnmStmts(chain(ho.hoBody), ho.hoRenames, List<PStmt>()),
              ho.hoRenames,
              rnmStmts(chain(ho.hoOut), ho.hoRenames, List<PStmt>()))
  let newBody = hoRebuiltBody(f, renamed)
  ret (hoWithBody(f, newBody), renamed.hoOut)

fun hoRebuiltBody(f: PsFun, ho: Hoisted): PExpr
  ret match(f.fBody)
    (b: PExpr) => match(b)
      (bk: PeBlock) => PeBlock(ho.hoBody,
                               isEmpty(ho.hoRenames.tmMap)
                                 ? bk.blockValue
                                 : rnmExpr(bk.blockValue, ho.hoRenames),
                               bk.blockTag, bk.pebkLine)
      (o: PExpr)    => b
    ()         => PeNothing(f.psfLine)

fun hoWithBody(f: PsFun, body: PExpr): PStmt
  ret PsFun(f.fName, f.fAttrs, f.fGens, f.fParams, body, f.fRet, f.fWheres,
            f.psfLine, f.fRetInferred, f.fNested, f.fImports)

# ── rename application ───────────────────────────────────────────────────────

fun rnmStmts(ss: Chain<PStmt>, m: ThisMap,
                    acc: List<PStmt>): List<PStmt>
  ret build<PStmt >(rnmStmtsB(ss, m, _pushChain<PStmt >(builder<PStmt >(), chain<PStmt >(acc))))

fun [tail] rnmStmtsB(ss: Chain<PStmt>, m: ThisMap,
                    [terminal] acc: ListBuilder<PStmt >): ListBuilder<PStmt >
  ret match(ss)
    (nil: ChainEnd) => acc
    (l: ChainLink)  => rnmStmtsB(l.next, m, push<PStmt >(acc, rnmStmt(l.value, m)))

fun rnmStmt(st: PStmt, m: ThisMap): PStmt
  ret match(st)
    (f: PsFun)  => PsFun(f.fName, f.fAttrs, f.fGens, rnmStmt(f.fParams, m),
                         rnmOpt(f.fBody, m), f.fRet, f.fWheres, f.psfLine,
                         f.fRetInferred, f.fNested, f.fImports)
    (l: PsLet)  => PsLet(l.lName, l.lAttrs, l.lGens, l.lType,
                         rnmOpt(l.lDefault, m), l.lArrayLen, l.lWheres,
                         l.pslLine, l.lTypeInferred, l.lImports)
    (d: PsDestructure) => PsDestructure(d.dName, d.dAttrs, d.dType,
                                        rnmStmts(chain(d.dTargets), m,
                                                 List<PStmt>()),
                                        rnmOpt(d.dDefault, m), d.psdLine,
                                        d.dTypeInferred)
    (rt: PsRet)  => PsRet(rnmExpr(rt.retValue, m), rt.psrLine)
    (a: PsAction) => PsAction(rnmExpr(a.action, m), a.psaLine)
    (i: PsIf)    => PsIf(rnmExpr(i.ifCond, m),
                         rnmStmts(chain(i.ifTrue), m, List<PStmt>()),
                         rnmStmts(chain(i.ifFalse), m, List<PStmt>()),
                         i.psifLine)
    (o: PStmt)   => st

fun rnmOpt(x: PExpr|None, m: ThisMap): PExpr|None
  ret match(x)
    (e2: PExpr) => rnmExpr(e2, m)
    ()          => None

fun rnmExpr(x: PExpr, m: ThisMap): PExpr
  ret match(x)
    (nm: PeName)   => match(tmLookup(m, nm.refName))
      (target: String) => PeName(target, nm.refTypeParams, nm.penLine,
                                 nm.penTrait)
      ()               => x
    (d: PeDot)     => PeDot(rnmExpr(d.base, m), d.member, d.pedLine)
    (c: PeCall)    => PeCall(rnmExpr(c.function, m), rnmExpr(c.parameter, m),
                             c.pecLine)
    (tp: PeTuple)  => PeTuple(rnmEnts(chain(tp.exprs), m, List<PTupEnt>()),
                              tp.petLine)
    (te: PeTernary) => PeTernary(rnmExpr(te.condition, m),
                                 rnmExpr(te.trueResult, m),
                                 rnmExpr(te.falseResult, m), te.pety)
    (lm: PeLambda) => PeLambda(rnmStmt(lm.lamParams, m),
                               rnmExpr(lm.lamBody, m), lm.pelLine, lm.lamRet)
    (bk: PeBlock)  => PeBlock(rnmStmts(chain(bk.blockStmts), m,
                                       List<PStmt>()),
                              rnmExpr(bk.blockValue, m), bk.blockTag,
                              bk.pebkLine)
    (mt: PeMatch)  => PeMatch(rnmExpr(mt.subject, m),
                              rnmArms(chain(mt.arms), m, List<PArm>()),
                              mt.pemLine)
    (op: PeBuiltinOp) => PeBuiltinOp(op.opType, op.opName,
                                     rnmExpr(op.opParams, m), op.peboLine)
    (nw: PeNew)    => PeNew(nw.newType, rnmExpr(nw.newParam, m), nw.penwLine)
    (qq: PeCoalesce) => PeCoalesce(rnmExpr(qq.qqSubject, m),
                                     rnmExpr(qq.qqFallback, m), qq.peqqLine)
    (ar: PeArrayRead) => PeArrayRead(rnmExpr(ar.arrObj, m),
                                     rnmExpr(ar.arrIndex, m), ar.pearLine)
    (cv: PeConvert) => PeConvert(rnmExpr(cv.convInner, m), cv.convTarget,
                                 cv.pecvLine)
    (wx: PeWith)   => PeWith(rnmExpr(wx.withSubject, m),
                             rnmExpr(wx.withRepls, m), wx.pewLine)
    (pl: PeParallel) => PeParallel(rnmExpr(pl.parParams, m), pl.pepLine)
    (lp: PeLoop)   => PeLoop(rnmExpr(lp.loopBody, m),
                             rnmExprs(chain(lp.loopParams), m,
                                      List<PExpr>()),
                             lp.pelpLine)
    (rc: PeRecur)  => PeRecur(rnmExprs(chain(rc.recArgs), m, List<PExpr>()),
                              rc.recIndex, rc.percLine)
    (ne: PeNewEnum) => PeNewEnum(ne.rootName, ne.leafName,
                                 map(ne.fieldArgs, (fa: PFieldArg) =>
                                   PFieldArg(fa.faName, rnmExpr(fa.faValue, m))),
                                 ne.neTypeParams, ne.penewLine)
    (o: PExpr)     => x

fun rnmExprs(es: Chain<PExpr>, m: ThisMap,
                    acc: List<PExpr>): List<PExpr>
  ret build<PExpr >(rnmExprsB(es, m, _pushChain<PExpr >(builder<PExpr >(), chain<PExpr >(acc))))

fun [tail] rnmExprsB(es: Chain<PExpr>, m: ThisMap,
                    [terminal] acc: ListBuilder<PExpr >): ListBuilder<PExpr >
  ret match(es)
    (nil: ChainEnd) => acc
    (l: ChainLink)  => rnmExprsB(l.next, m, push<PExpr >(acc, rnmExpr(l.value, m)))

fun rnmEnts(es: Chain<PTupEnt>, m: ThisMap,
                   acc: List<PTupEnt>): List<PTupEnt>
  ret build<PTupEnt >(rnmEntsB(es, m, _pushChain<PTupEnt >(builder<PTupEnt >(), chain<PTupEnt >(acc))))

fun [tail] rnmEntsB(es: Chain<PTupEnt>, m: ThisMap,
                   [terminal] acc: ListBuilder<PTupEnt >): ListBuilder<PTupEnt >
  ret match(es)
    (nil: ChainEnd) => acc
    (l: ChainLink)  => rnmEntsB(l.next, m,
        push<PTupEnt >(acc, PTupEnt(l.value.tupName, l.value.tupSpread,
                            rnmExpr(l.value.tupValue, m))))

fun rnmArms(as2: Chain<PArm>, m: ThisMap, acc: List<PArm>): List<PArm>
  ret build<PArm >(rnmArmsB(as2, m, _pushChain<PArm >(builder<PArm >(), chain<PArm >(acc))))

fun [tail] rnmArmsB(as2: Chain<PArm>, m: ThisMap, [terminal] acc: ListBuilder<PArm >): ListBuilder<PArm >
  ret match(as2)
    (nil: ChainEnd) => acc
    (l: ChainLink)  => rnmArmsB(l.next, m,
        push<PArm >(acc, PArm(l.value.armName, l.value.armType,
                         rnmExpr(l.value.armBody, m), l.value.armLiterals,
                         rnmOpt(l.value.armGuard, m), l.value.parmLine)))

# ═════════════════════════════════════════════════════════════════════════════
# The INLINER half (ast_inline.py:55-663): function inlining at statement
# positions + lambda beta-reduction, run to fixpoint (≤10 rounds) before
# lambda lifting. Uses rewrite.yafl: pure rewrites and folds for the
# stateless pieces, the RwN counter-threading twins where fresh suffixes are
# minted mid-traversal — the $inlN names must match Python's exactly.
# ═════════════════════════════════════════════════════════════════════════════

# ── small folds ──────────────────────────────────────────────────────────────
# Node count = Expression + Statement instances (match arms and tuple entries
# are rw.rebuild nodes — Python's callback never fires on them).

fun aiCountStmt(n: Int, st: PStmt): Int
  ret n + 1

fun aiCountExpr(n: Int, x: PExpr): Int
  ret n + 1

fun aiNodeCount(x: PExpr): Int
  ret foldExpr<Int>(x, aiCountStmt, aiCountExpr, 0)

# The names of the functions called anywhere in these statements. A SET: its
# one consumer intersects it against the candidate names to build call-graph
# edges, and the graph is walked in sorted order. The "have I seen this name"
# test that used to guard the append is gone — `add` is idempotent.
fun aiCalledNames(stmts: List<PStmt>): Set<String >
  ret foldStmts<Set<String > >(stmts, aiIdCalledName, aiCalledCb,
                               Set<String >())

fun aiIdCalledName(acc: Set<String >, st: PStmt): Set<String >
  ret acc

fun aiIdStmtNames(acc: List<String>, st: PStmt): List<String>
  ret acc

fun aiCalledCb(acc: Set<String >, x: PExpr): Set<String >
  ret match(x)
    (c: PeCall) => match(c.function)
      (nm: PeName) => add<String >(acc, nm.refName)
      (o: PExpr)   => acc
    (o2: PExpr) => acc

fun aiRefCountStmt(st: PStmt, name: String): Int
  ret foldStmt<Int>(st, aiCountNone, (n: Int, x: PExpr) =>
                      aiRefCb(n, x, name), 0)

fun aiCountNone(n: Int, st: PStmt): Int
  ret n

fun aiRefCb(n: Int, x: PExpr, name: String): Int
  ret match(x)
    (nm: PeName) => nm.refName == name ? n + 1 : n
    (o: PExpr)   => n

# ── name substitution + alpha renaming ───────────────────────────────────────

# Name → replacement expression, consulted once per name node of every inlined
# body. A Dict for the same reason as ThisMap: this is a lookup, and walking a
# pair of chains to answer it made substitution cost the size of the map times
# the size of the body.
class [final] SubMap(smMap: Dict<String, PExpr>)

fun aiSubLookup(m: SubMap, name: String): PExpr|None
  ret get<String, PExpr>(m.smMap, name)

fun aiSubstituteStmts(ss: List<PStmt>, m: SubMap): List<PStmt>
  ret rwStmts(ss, rwOnExpr((x: PExpr) => aiSubCb(x, m)))

fun aiSubstituteExpr(x: PExpr, m: SubMap): PExpr
  ret rwExpr(x, rwOnExpr((x2: PExpr) => aiSubCb(x2, m)))

fun aiSubCb(x: PExpr, m: SubMap): PExpr|None
  ret match(x)
    (nm: PeName) => aiSubLookup(m, nm.refName)
    (o: PExpr)   => None

# Rename all match-arm pattern variables by appending suffix, so a pattern
# name is never captured across inline sites. Port arm-name note: '_' parses
# to "" — both mean "no binder".
fun aiArmNamesStmts(ss: List<PStmt>): List<String>
  ret foldStmts<List<String>>(ss, aiIdStmtNames, aiArmNameCb,
                              List<String>())

fun aiArmNamesExpr(x: PExpr): List<String>
  ret foldExpr<List<String>>(x, aiIdStmtNames, aiArmNameCb, List<String>())

fun aiArmNameCb(acc: List<String>, x: PExpr): List<String>
  ret match(x)
    (mt: PeMatch) => aiArmNameLoop(chain(mt.arms), acc)
    (o: PExpr)    => acc

# Set answers "seen this name" in O(log n) where scanning the accumulator was
# O(n) per element; the builder keeps the order the Set does not.
fun aiArmNameLoop(as2: Chain<PArm>, acc: List<String>): List<String>
  ret build<String >(aiArmNameLoopB(as2,
                                    _pushChain<String >(builder<String >(),
                                                        chain<String >(acc)),
                                    _chainToSet<String >(chain<String >(acc),
                                                         Set<String >())))

fun [tail] aiArmNameLoopB(as2: Chain<PArm>, [terminal] out: ListBuilder<String >,
                          seen: Set<String >): ListBuilder<String >
  ret match(as2)
    (nil: ChainEnd) => out
    (l: ChainLink)  => l.value.armName != "" && l.value.armName != "_"
                       && !contains<String >(seen, l.value.armName)
      ? aiArmNameLoopB(l.next, push<String >(out, l.value.armName),
                       add<String >(seen, l.value.armName))
      : aiArmNameLoopB(l.next, out, seen)

fun aiRenameArmsStmts(ss: List<PStmt>, suffix: String): List<PStmt>
  let bound = aiArmNamesStmts(ss)
  if isEmpty(bound)
    ret ss
  ret rwStmts(ss, rwOnExpr((x: PExpr) => aiArmRenCb(x, bound, suffix)))

fun aiRenameArmsExpr(x: PExpr, suffix: String): PExpr
  let bound = aiArmNamesExpr(x)
  if isEmpty(bound)
    ret x
  ret rwExpr(x, rwOnExpr((x2: PExpr) => aiArmRenCb(x2, bound, suffix)))

fun aiArmRenCb(x: PExpr, bound: List<String>, suffix: String): PExpr|None
  ret match(x)
    (nm: PeName)  => contains2(bound, nm.refName)
      ? PeName(nm.refName + suffix, nm.refTypeParams, nm.penLine,
               nm.penTrait)
      : None
    (mt: PeMatch) => PeMatch(mt.subject,
                             aiArmRenLoop(chain(mt.arms), bound, suffix,
                                          List<PArm>()),
                             mt.pemLine)
    (o: PExpr)    => None

fun aiArmRenLoop(as2: Chain<PArm>, bound: List<String>,
                        suffix: String, acc: List<PArm>): List<PArm>
  ret build<PArm >(aiArmRenLoopB(as2, bound, suffix, _pushChain<PArm >(builder<PArm >(), chain<PArm >(acc))))

fun [tail] aiArmRenLoopB(as2: Chain<PArm>, bound: List<String>,
                        suffix: String, [terminal] acc: ListBuilder<PArm >): ListBuilder<PArm >
  ret match(as2)
    (nil: ChainEnd) => acc
    (l: ChainLink)  => aiArmRenLoopB(l.next, bound, suffix,
        push<PArm >(acc, contains2(bound, l.value.armName)
          ? PArm(l.value.armName + suffix, l.value.armType, l.value.armBody,
                 l.value.armLiterals, l.value.armGuard, l.value.parmLine)
          : l.value))

# Rename every let bound at the TOP of `stmts` (binding sites at any depth
# with a matching name rename too, exactly like Python's walker).
class [final] Renamed(rnStmts: List<PStmt>, rnMap: ThisMap)

fun aiRenameLetVars(ss: List<PStmt>, suffix: String): Renamed
  let m = aiTopLets(chain(ss), suffix, ThisMap(Dict<String, String>()))
  if isEmpty(m.tmMap)
    ret Renamed(ss, m)
  ret Renamed(rwStmts(ss, Rw((x: PExpr) => aiLetRenExpr(x, m), rwNoSpec,
                             (st: PStmt) => aiLetRenStmt(st, m))),
              m)

fun [tail] aiTopLets(ss: Chain<PStmt>, suffix: String, acc: ThisMap): ThisMap
  ret match(ss)
    (nil: ChainEnd) => acc
    (l: ChainLink)  => match(l.value)
      (let2: PsLet) => aiTopLets(l.next, suffix,
                                 ThisMap(put<String, String>(acc.tmMap,
                                             let2.lName,
                                             let2.lName + suffix)))
      (o: PStmt)    => aiTopLets(l.next, suffix, acc)

fun aiLetRenExpr(x: PExpr, m: ThisMap): PExpr|None
  ret match(x)
    (nm: PeName) => match(tmLookup(m, nm.refName))
      (t2: String) => PeName(t2, nm.refTypeParams, nm.penLine, nm.penTrait)
      ()           => None
    (o: PExpr)   => None

fun aiLetRenStmt(st: PStmt, m: ThisMap): PStmt|None
  ret match(st)
    (let2: PsLet) => match(tmLookup(m, let2.lName))
      (t2: String) => PsLet(t2, let2.lAttrs, let2.lGens, let2.lType,
                            let2.lDefault, let2.lArrayLen, let2.lWheres,
                            let2.pslLine, let2.lTypeInferred, let2.lImports)
      ()           => None
    (o: PStmt)    => None

# ── cheapness + inlinability + the catalog ───────────────────────────────────

fun [tail] aiIsCheap(x: PExpr): Bool
  ret match(x)
    (nm: PeName)   => true
    (i: PeInt)     => true
    (s2: PeStr)    => true
    (ng: PeNothing) => true
    (d: PeDot)     => aiIsCheap(d.base)
    (o: PExpr)     => false

let aiSizeThreshold = 10

fun aiIsInlinable(f: PsFun, classMembers: List<String>): Bool
  if contains2(classMembers, f.fName) || hasAttr(f.fAttrs, "foreign")
     || !hoHasBlockBody(f) || !isEmpty(f.fGens)
    ret false
  if hasAttr(f.fAttrs, "inline")
    ret aiBareInline(chain(f.fAttrs))
  ret aiBodyCount(f) < aiSizeThreshold

# Bare `[inline]` (no argument) only — `[inline(always)]` is the codegen
# inliner's, gated by -O3.
fun [tail] aiBareInline(as2: Chain<PAttr>): Bool
  ret match(as2)
    (nil: ChainEnd) => false
    (l: ChainLink)  => l.value.attrName == "inline"
      ? aiAttrHasNoValue(l.value)
      : aiBareInline(l.next)

fun aiAttrHasNoValue(a: PAttr): Bool
  ret match(a.attrValue)
    (v: PExpr) => false
    ()         => true

fun aiBodyCount(f: PsFun): Int
  ret match(f.fBody)
    (b: PExpr) => aiNodeCount(b)
    ()         => 0

fun aiClassMemberNames(statements: List<PStmt>): List<String>
  ret aiCmnLoop(chain(statements), List<String>())

fun [tail] aiCmnLoop(ss: Chain<PStmt>, acc: List<String>): List<String>
  ret match(ss)
    (nil: ChainEnd) => acc
    (l: ChainLink)  => match(l.value)
      (c: PsClass) => aiCmnLoop(l.next, hoFnNames2(chain(c.cMembers), acc))
      (o: PStmt)   => aiCmnLoop(l.next, acc)

fun hoFnNames2(ss: Chain<PStmt>, acc: List<String>): List<String>
  ret build<String >(hoFnNames2B(ss, _pushChain<String >(builder<String >(), chain<String >(acc))))

fun [tail] hoFnNames2B(ss: Chain<PStmt>, [terminal] acc: ListBuilder<String >): ListBuilder<String >
  ret match(ss)
    (nil: ChainEnd) => acc
    (l: ChainLink)  => match(l.value)
      (f: PsFun) => hoFnNames2B(l.next, push<String >(acc, f.fName))
      (o: PStmt) => hoFnNames2B(l.next, acc)

# Map of inlinable name → PsFun; functions on a call-graph cycle (incl.
# self-recursion) are pruned.
#
# Just the Dict — this mirrors Python's `catalog: dict[str, FunctionStatement]`
# exactly, and Python never observes that dict's ORDER: it is indexed by name,
# tested for membership, and tested for emptiness, nothing more. The port used
# to carry two parallel lists beside the Dict purely to iterate, which cost an
# append per candidate to build an order nobody read. The two places that do
# walk the catalogue take its names sorted, which is deterministic and is all
# either of them needs.
class [final] Catalog(caMap: Dict<String, PsFun>)

fun caNames(c: Catalog): List<String>
  ret sort<String>(keys<String, PsFun>(c.caMap))

# The callees of one catalogue entry that are themselves catalogue entries —
# the call-graph edges out of it. A name that is not in the map has no edges;
# it cannot happen here, since the names come from the map's own keys, but
# saying so costs nothing and beats inventing a placeholder function.
fun aiCatCallees(cat: Catalog, name: String,
                 candNames: List<String>): List<String>
  ret match(get<String, PsFun>(cat.caMap, name))
    (f: PsFun) => sort<String>(filter<String>(aiCalledNames(aiBodyStmts(f)),
                                   (n: String) => contains2(candNames, n)))
    ()         => List<String>()

fun aiCatKeep(acc: Catalog, cat: Catalog, name: String): Catalog
  ret match(get<String, PsFun>(cat.caMap, name))
    (f: PsFun) => Catalog(put<String, PsFun>(acc.caMap, name, f))
    ()         => acc

fun aiBuildCatalog(statements: List<PStmt>): Catalog
  let classMembers = aiClassMemberNames(statements)
  let cands = aiCandidates(chain(statements), classMembers, Catalog(Dict<String, PsFun>()))
  let names = caNames(cands)
  let edges = aiCatEdges(chain(names), cands, names, EEdges(Dict<String, List<String>>()))
  ret aiPruneCycles(chain(names), cands, edges, Catalog(Dict<String, PsFun>()))

fun [tail] aiCandidates(ss: Chain<PStmt>, classMembers: List<String>,
                        acc: Catalog): Catalog
  ret match(ss)
    (nil: ChainEnd) => acc
    (l: ChainLink)  => match(l.value)
      (f: PsFun) => aiIsInlinable(f, classMembers)
        ? aiCandidates(l.next, classMembers,
                       Catalog(put<String, PsFun>(acc.caMap, f.fName, f)))
        : aiCandidates(l.next, classMembers, acc)
      (o: PStmt) => aiCandidates(l.next, classMembers, acc)

fun [tail] aiCatEdges(ns: Chain<String>, cat: Catalog,
                      candNames: List<String>, acc: EEdges): EEdges
  ret match(ns)
    (nil: ChainEnd) => acc
    (l: ChainLink)  => aiCatEdges(l.next, cat, candNames,
        EEdges(put<String, List<String>>(acc.eeMap, l.value,
                   aiCatCallees(cat, l.value, candNames))))

fun aiBodyStmts(f: PsFun): List<PStmt>
  ret match(f.fBody)
    (b: PExpr) => match(b)
      (bk: PeBlock) => bk.blockStmts
      (o: PExpr)    => List<PStmt>()
    ()         => List<PStmt>()

fun [tail] aiPruneCycles(ns: Chain<String>, cat: Catalog, edges: EEdges,
                         acc: Catalog): Catalog
  ret match(ns)
    (nil: ChainEnd) => acc
    (n: ChainLink)  => aiReachesSelf(n.value, edges)
      ? aiPruneCycles(n.next, cat, edges, acc)
      : aiPruneCycles(n.next, cat, edges, aiCatKeep(acc, cat, n.value))

fun aiReachesSelf(start: String, edges: EEdges): Bool
  ret aiDfs(ceChildrenOf(edges, start), start, edges, List<String>())

# The stack's top is its FRONT. Python pops from the END (`stack.pop()`), and
# mirroring that literally cost two O(n) reversals per step — one to reach the
# last element, another to put the remainder back — making a reachability walk
# quadratic. Only the ANSWER is observable here (does `start` reach itself),
# and reachability is a set property: visiting the graph in a different order
# finds the same cycle or the same absence of one. `seen` is read solely by
# contains2, so its order is not observable either.
fun [tail] aiDfs(stack: List<String>, start: String, edges: EEdges,
                 seen: List<String>): Bool
  ret match(chain(stack))
    (nil: ChainEnd) => false
    (l: ChainLink)  => l.value == start
      ? true
      : contains2(seen, l.value)
        ? aiDfs(List<String>(l.next), start, edges, seen)
        : aiDfs(concat(ceChildrenOf(edges, l.value),
                       List<String>(l.next)),
                start, edges, prepend(l.value, seen))

fun aiCatLookup(c: Catalog, name: String): PsFun|None
  ret get<String, PsFun>(c.caMap, name)

# ── fresh suffixes ───────────────────────────────────────────────────────────
# Python's module counter, reset by inline_ast: $inl1, $inl2, ... minted in
# operation order across the whole fixpoint — threaded here as an Int.

class [final] Fresh(frN: Int, frSuffix: String)

fun aiFresh(n: Int): Fresh
  ret Fresh(n + 1, "$inl" + String(n + 1))

# ── statement-position function inlining ─────────────────────────────────────

class [final] InlOut(ioN: Int, ioStmts: List<PStmt>, ioValue: PExpr)

fun aiInlineFunctionCall(c: PeCall, target: PsFun, lineRef: PLine,
                         n: Int): InlOut|None
  ret match(target.fBody)
    (b: PExpr) => match(b)
      (bk: PeBlock) => match(c.parameter)
        (tp: PeTuple) => aiInlineCall2(tp, target, bk, lineRef, n)
        (o: PExpr)    => None
      (o2: PExpr)   => None
    ()         => None

fun aiInlineCall2(tp: PeTuple, target: PsFun, bk: PeBlock, lineRef: PLine,
                  n: Int): InlOut|None
  let params = flattenParams(target.fParams)
  let args = tlEntValues(chain(tp.exprs), List<PExpr>())
  if !sameLen(chain(args), chain(params))
    ret None
  let fresh = aiFresh(n)
  # Clone body statements with renamed lets AND match arm patterns; the value
  # gets the same treatment.
  let renamed = aiRenameLetVars(bk.blockStmts, fresh.frSuffix)
  let bodyStmts0 = aiRenameArmsStmts(renamed.rnStmts, fresh.frSuffix)
  let letSubst = aiRenameAsSubst(renamed.rnMap, lineRef)
  let subbedValue = isEmpty(renamed.rnMap.tmMap)
    ? bk.blockValue
    : aiSubstituteExpr(bk.blockValue, letSubst)
  let bodyValue0 = aiRenameArmsExpr(subbedValue, fresh.frSuffix)
  # Param → argument prologue + substitution map.
  let prologue = aiParamPrologue(chain(params), chain(args), lineRef,
                                 fresh.frSuffix, List<PStmt>())
  let paramSubst = aiParamSubst(chain(params), lineRef, fresh.frSuffix,
                                SubMap(Dict<String, PExpr>()))
  ret InlOut(fresh.frN,
             concat(prologue, aiSubstituteStmts(bodyStmts0, paramSubst)),
             aiSubstituteExpr(bodyValue0, paramSubst))

# One map into another: every renamed name becomes a substitution to a
# reference to its new name. A fold over the source map's keys, unordered —
# the result is itself keyed by those names, so no order of insertion can
# change it.
fun aiRenameAsSubst(m: ThisMap, lineRef: PLine): SubMap
  ret SubMap(fold<String, Dict<String, PExpr> >(keys<String, String>(m.tmMap),
                 Dict<String, PExpr>(),
                 (d: Dict<String, PExpr>, n: String) =>
                   put<String, PExpr>(d, n,
                       PeName(aiRasTarget(m, n), List<Spec>(), lineRef, None))))

fun aiRasTarget(m: ThisMap, n: String): String
  ret match(tmLookup(m, n))
    (t2: String) => t2
    ()           => n

fun aiParamPrologue(ps: Chain<PStmt>, as2: Chain<PExpr>,
                           lineRef: PLine, suffix: String,
                           acc: List<PStmt>): List<PStmt>
  ret build<PStmt >(aiParamPrologueB(ps, as2, lineRef, suffix, _pushChain<PStmt >(builder<PStmt >(), chain<PStmt >(acc))))

fun [tail] aiParamPrologueB(ps: Chain<PStmt>, as2: Chain<PExpr>,
                           lineRef: PLine, suffix: String,
                           [terminal] acc: ListBuilder<PStmt >): ListBuilder<PStmt >
  ret match(ps)
    (nil: ChainEnd) => acc
    (p: ChainLink)  => match(as2)
      (nil2: ChainEnd) => acc
      (a: ChainLink)   => aiParamPrologueB(p.next, a.next, lineRef, suffix,
          push<PStmt >(acc, PsLet(stmtName(p.value) + suffix, List<PAttr>(),
                            List<PGen>(), aiLetTypeOf(p.value), a.value,
                            "", List<Spec>(), lineRef, false,
                            List<PStmt>())))

fun aiLetTypeOf(st: PStmt): Spec|None
  ret match(st)
    (l: PsLet) => l.lType
    (o: PStmt) => None

fun [tail] aiParamSubst(ps: Chain<PStmt>, lineRef: PLine, suffix: String,
                        acc: SubMap): SubMap
  ret match(ps)
    (nil: ChainEnd) => acc
    # A later parameter with a repeated name overwrites the earlier entry
    # where the chain lookup kept the first — the substitution target is a
    # pure function of the name, so both give the same answer.
    (p: ChainLink)  => aiParamSubst(p.next, lineRef, suffix,
        SubMap(put<String, PExpr>(acc.smMap, stmtName(p.value),
                   PeName(stmtName(p.value) + suffix, List<Spec>(), lineRef,
                          None))))

# Inline when stmt's top-level expression is a direct call to a catalog
# function (not the function being rewritten). A deferred-init let ([lazy]/
# [future]) is skipped: lifting the call's args into outer lets would move
# references before the let's textual position.
class [final] TisOut(tiN: Int, tiStmts: List<PStmt>)

fun aiTryInlineAtStmt(st: PStmt, catalog: Catalog, selfName: String,
                      n: Int): TisOut|None
  ret match(st)
    (rt: PsRet)   => aiTis2(rt.retValue, st, catalog, selfName, n, 0)
    (let2: PsLet) => aiTisLet(let2, catalog, selfName, n)
    (a: PsAction) => aiTis2(a.action, st, catalog, selfName, n, 2)
    (o: PStmt)    => None

fun aiTisLet(let2: PsLet, catalog: Catalog, selfName: String,
             n: Int): TisOut|None
  if hasAttr(let2.lAttrs, "lazy") || hasAttr(let2.lAttrs, "future")
    ret None
  ret match(let2.lDefault)
    (dv: PExpr) => aiTis2(dv, let2, catalog, selfName, n, 1)
    ()          => None

# kindSel: 0 = ret, 1 = let default, 2 = action — how to re-wrap.
fun aiTis2(x: PExpr, st: PStmt, catalog: Catalog, selfName: String, n: Int,
           kindSel: Int): TisOut|None
  ret match(x)
    (c: PeCall) => match(c.function)
      (nm: PeName) => nm.refName == selfName
        ? None
        : aiTis3(c, nm.refName, st, catalog, n, kindSel)
      (o: PExpr)   => None
    (o2: PExpr) => None

fun aiTis3(c: PeCall, targetName: String, st: PStmt, catalog: Catalog,
           n: Int, kindSel: Int): TisOut|None
  ret match(aiCatLookup(catalog, targetName))
    (target: PsFun) => match(aiInlineFunctionCall(c, target, stmtLine(st),
                                                  n))
      (io: InlOut) => TisOut(io.ioN,
                             prepend(aiWrap(st, kindSel,
                                            isEmpty(io.ioStmts)
                                              ? io.ioValue
                                              : PeBlock(io.ioStmts,
                                                        io.ioValue, "",
                                                        stmtLine(st))),
                                     List<PStmt>()))
      ()           => None
    ()              => None

fun aiWrap(st: PStmt, kindSel: Int, x: PExpr): PStmt
  ret match(st)
    (rt: PsRet)   => PsRet(x, rt.psrLine)
    (let2: PsLet) => PsLet(let2.lName, let2.lAttrs, let2.lGens, let2.lType,
                           x, let2.lArrayLen, let2.lWheres, let2.pslLine,
                           let2.lTypeInferred, let2.lImports)
    (a: PsAction) => PsAction(x, a.psaLine)
    (o: PStmt)    => st

# ── expression-position inlining (let-bound alpha-renamed body) ─────────────

class [final] IlbOut(ilN: Int, ilExpr: PExpr)

fun aiInlineLetBound(body: PExpr, params: List<PStmt>, args: List<PExpr>,
                     returnType: Spec|None, r: Resolver|None,
                     n: Int): IlbOut|None
  if !sameLen(chain(params), chain(args))
    ret None
  let fresh = aiFresh(n)
  # Every name the body binds — params plus every let at ANY depth.
  # The names bound inside this body — a SET: both readers ask only whether a
  # name is in it, and the "already collected" test that guarded the append
  # goes with it, since add is idempotent.
  let bound = foldExpr<Set<String > >(body, aiBoundCb, aiIdExprNames,
                                      Set<String >(allStmtNames(chain(params),
                                                       List<String>())))
  let renamed0 = rwExpr(body, Rw((x: PExpr) => aiBoundRenExpr(x, bound,
                                                              fresh.frSuffix),
                                 rwNoSpec,
                                 (st: PStmt) => aiBoundRenStmt(st, bound,
                                                               fresh.frSuffix)))
  let renamed = aiRenameArmsExpr(renamed0, fresh.frSuffix)
  ret aiIlb2(renamed, params, args, returnType, r, fresh)

fun aiIdExprNames(acc: Set<String >, x: PExpr): Set<String >
  ret acc

fun aiBoundCb(acc: Set<String >, st: PStmt): Set<String >
  ret match(st)
    (l: PsLet) => add<String >(acc, l.lName)
    (o: PStmt) => acc

fun aiBoundRenExpr(x: PExpr, bound: Set<String >,
                   suffix: String): PExpr|None
  ret match(x)
    (nm: PeName) => contains<String >(bound, nm.refName)
      ? PeName(nm.refName + suffix, nm.refTypeParams, nm.penLine,
               nm.penTrait)
      : None
    (o: PExpr)   => None

fun aiBoundRenStmt(st: PStmt, bound: Set<String >,
                   suffix: String): PStmt|None
  ret match(st)
    (l: PsLet) => contains<String >(bound, l.lName)
      ? PsLet(l.lName + suffix, l.lAttrs, l.lGens, l.lType, l.lDefault,
              l.lArrayLen, l.lWheres, l.pslLine, l.lTypeInferred,
              l.lImports)
      : None
    (o: PStmt) => None

fun aiIlb2(renamed: PExpr, params: List<PStmt>, args: List<PExpr>,
           returnType: Spec|None, r: Resolver|None,
           fresh: Fresh): IlbOut|None
  let prologue = aiIlbPrologue(chain(params), chain(args), r,
                               fresh.frSuffix, List<PStmt>())
  ret match(prologue)
    (pl: List<PStmt>) => aiIlb3(renamed, pl, returnType, fresh)
    ()                => None

fun aiIlb3(renamed: PExpr, prologue: List<PStmt>, returnType: Spec|None,
           fresh: Fresh): IlbOut
  let assembled = match(renamed)
    (bk: PeBlock) => aiIlbAssemble(concat(prologue, bk.blockStmts),
                                   bk.blockValue, bk.pebkLine)
    (o: PExpr)    => aiIlbAssemble(prologue, renamed, exprLine(renamed))
  ret match(returnType)
    (rt: Spec) => match(rt)
      (cm: SCombination) => IlbOut(fresh.frN,
                                   PeConvert(assembled, cm,
                                             exprLine(assembled)))
      (o2: Spec)         => IlbOut(fresh.frN, assembled)
    ()         => IlbOut(fresh.frN, assembled)

fun aiIlbAssemble(stmts: List<PStmt>, value: PExpr, lr: PLine): PExpr
  ret isEmpty(stmts) ? value : PeBlock(stmts, value, "", lr)

# The binding let takes the parameter's declared type; when the parameter is
# untyped fall back to the ARGUMENT's type — and give up (None) when neither
# is known.
# The lets come out in parameter order and bind in that order, so this is an
# ordered build. The whole prologue is abandoned when a parameter's type cannot
# be settled, which drops the part-built list on the floor — hence the build
# happens only on the way out of the successful case.
fun aiIlbPrologue(ps: Chain<PStmt>, as2: Chain<PExpr>,
                  r: Resolver|None, suffix: String,
                  acc: List<PStmt>): List<PStmt>|None
  ret match(aiIlbPrologueB(ps, as2, r, suffix,
                           _pushChain<PStmt >(builder<PStmt >(),
                                              chain<PStmt >(acc))))
    (b: ListBuilder<PStmt >) => build<PStmt >(b)
    ()                       => None

fun [tail] aiIlbPrologueB(ps: Chain<PStmt>, as2: Chain<PExpr>,
                          r: Resolver|None, suffix: String,
                          [terminal] acc: ListBuilder<PStmt >): ListBuilder<PStmt >|None
  ret match(ps)
    (nil: ChainEnd) => acc
    (p: ChainLink)  => match(as2)
      (nil2: ChainEnd) => acc
      (a: ChainLink)   => match(aiBindType(p.value, a.value, r))
        (bt: Spec) => aiIlbPrologueB(p.next, a.next, r, suffix,
            push<PStmt >(acc, PsLet(stmtName(p.value) + suffix, List<PAttr>(),
                                    List<PGen>(), bt, a.value, "",
                                    List<Spec>(), exprLine(a.value), false,
                                    None)))
        ()         => None

fun aiBindType(param: PStmt, arg: PExpr, r: Resolver|None): Spec|None
  ret match(aiLetTypeOf(param))
    (t2: Spec) => t2
    ()         => match(r)
      (r2: Resolver) => exprType(arg, r2)
      ()             => None

# ── lambda beta-reduction ────────────────────────────────────────────────────
# IIFE and let-bound single-use lambdas inline via aiInlineLetBound; a lambda
# taking a callable/tuple/union parameter is left alone (the recursive
# combinators — unbounded inlining would not terminate), and every argument
# must be cheap.

fun aiBetaReduceLambda(lam: PeLambda, args: List<PExpr>, n: Int): IlbOut|None
  let params = flattenParams(lam.lamParams)
  if !sameLen(chain(params), chain(args))
    ret None
  if aiAnyHigherOrder(chain(params)) || aiAnyExpensive(chain(args))
    ret None
  ret aiInlineLetBound(lam.lamBody, params, args, aiLamResult(lam), None, n)

fun [tail] aiAnyHigherOrder(ps: Chain<PStmt>): Bool
  ret match(ps)
    (nil: ChainEnd) => false
    (l: ChainLink)  => aiIsHigherOrder(aiLetTypeOf(l.value))
      ? true
      : aiAnyHigherOrder(l.next)

fun aiIsHigherOrder(t2: Spec|None): Bool
  ret match(t2)
    (sp: Spec) => match(sp)
      (cm: SCombination) => true
      (tp: STuple)       => true
      (cl: SCallable)    => true
      (o: Spec)          => false
    ()         => false

fun [tail] aiAnyExpensive(as2: Chain<PExpr>): Bool
  ret match(as2)
    (nil: ChainEnd) => false
    (l: ChainLink)  => aiIsCheap(l.value) ? aiAnyExpensive(l.next) : true

fun aiLamResult(lam: PeLambda): Spec|None
  ret match(lam.lamRet)
    (rt: Spec) => match(rt)
      (cl: SCallable) => cl.scResult
      (o: Spec)       => None
    ()         => None

fun aiExprInlineFunction(target: PsFun, args: List<PExpr>, r: Resolver|None,
                         n: Int): IlbOut|None
  ret match(target.fBody)
    (b: PExpr) => match(b)
      (bk: PeBlock) => aiInlineLetBound(b, flattenParams(target.fParams),
                                        args, target.fRet, r, n)
      (o: PExpr)    => None
    ()         => None

# ── beta-reduction over a statement sequence ─────────────────────────────────
# The single-use scan sees only THIS sequence; nested blocks re-reduce against
# their own statements inside the callback (bottom-up, like Python).

# Just the Dict. It answered every lookup already, and the two lists beside it
# were an append per single: sgNames duplicated the Dict's own key membership
# for the dead-lambda test, and sgLams was written on every insert and never
# read by anyone.
class [final] Singles(sgMap: Dict<String, PExpr>)

fun aiBetaReduceExpressions(stmts: List<PStmt>, catalog: Catalog,
                            r: Resolver|None, n: Int): RwNSs
  let singles = aiSingles(chain(stmts), stmts, 0, Singles(Dict<String, PExpr>()))
  let out = rwnStmts(stmts, RwN((n2: Int, x: PExpr) =>
                                  aiBetaCb(n2, x, singles, catalog, r),
                                rwnNoStmt),
                     n)
  ret RwNSs(out.rnssN, aiDropDeadLams(out.rnssStmts, singles))

# let f = <lambda> used EXACTLY once across the remaining statements.
fun [tail] aiSingles(ss: Chain<PStmt>, all: List<PStmt>, i: Int,
                     acc: Singles): Singles
  ret match(ss)
    (nil: ChainEnd) => acc
    (l: ChainLink)  => aiSingles(l.next, all, i + 1,
                                 aiSingleAdd(l.value, all, i, acc))

fun aiSingleAdd(st: PStmt, all: List<PStmt>, i: Int, acc: Singles): Singles
  ret match(st)
    (let2: PsLet) => match(let2.lDefault)
      (dv: PExpr) => match(dv)
        (lam: PeLambda) => aiUsesAfter(chain(drop(all, i + 1)), let2.lName,
                                       0) == 1
          ? Singles(put<String, PExpr>(acc.sgMap, let2.lName, dv))
          : acc
        (o: PExpr)      => acc
      ()          => acc
    (o2: PStmt)   => acc

fun [tail] aiUsesAfter(ss: Chain<PStmt>, name: String, n: Int): Int
  ret match(ss)
    (nil: ChainEnd) => n
    (l: ChainLink)  => aiUsesAfter(l.next, name,
                                   n + aiRefCountStmt(l.value, name))

fun aiSingleLam(singles: Singles, name: String): PeLambda|None
  ret match(get<String, PExpr>(singles.sgMap, name))
    (x: PExpr) => match(x)
      (lam: PeLambda) => lam
      (o: PExpr)      => None
    ()         => None

# The bottom-up callback: nested block re-reduction, IIFE, let-bound
# single-use lambda, catalog function at expression position — first hit
# wins, exactly Python's order.

# Arms must all carry the SAME declared tuple type — a bare `(n, None)`
# literal would union-join with the typed results and make boxing ambiguous.
fun aiNoRep(n: Int): (n2: Int, rep: PExpr|None)
  ret (n, None)

fun aiRep(n: Int, x: PExpr): (n2: Int, rep: PExpr|None)
  ret (n, x)

fun aiBetaCb(n: Int, x: PExpr, singles: Singles, catalog: Catalog,
             r: Resolver|None): (n2: Int, rep: PExpr|None)
  ret match(x)
    (bk: PeBlock) => aiBetaBlock(bk, catalog, r, n)
    (c: PeCall)   => aiBetaCall(c, singles, catalog, r, n)
    (o: PExpr)    => aiNoRep(n)

# A block flattened to statements: its value becomes a trailing `ret`, so the
# whole body can be walked as a statement list and the value read back off the
# end afterwards. Both of the passes that rewrite bodies start here.
fun aiBlockAsStmts(bk: PeBlock): List<PStmt>
  ret build<PStmt >(push<PStmt >(
          _pushChain<PStmt >(builder<PStmt >(), chain<PStmt >(bk.blockStmts)),
          PsRet(bk.blockValue, exprLine(bk.blockValue))))

fun aiBetaBlock(bk: PeBlock, catalog: Catalog, r: Resolver|None,
                n: Int): (n2: Int, rep: PExpr|None)
  let inner = aiBlockAsStmts(bk)
  let out = aiBetaReduceExpressions(inner, catalog, r, n)
  ret match(last(out.rnssStmts))
    (lastStmt: PStmt) => match(lastStmt)
      (rt: PsRet) => aiRep(out.rnssN,
                           PeBlock(initOf(out.rnssStmts),
                                   rt.retValue, bk.blockTag, bk.pebkLine))
      (o: PStmt)  => aiNoRep(out.rnssN)
    ()                => aiNoRep(out.rnssN)

fun aiBetaCall(c: PeCall, singles: Singles, catalog: Catalog,
               r: Resolver|None, n: Int): (n2: Int, rep: PExpr|None)
  ret match(c.function)
    (lam: PeLambda) => match(c.parameter)
      (tp: PeTuple) => aiBetaApply(aiBetaReduceLambda(lam,
                                     tlEntValues(chain(tp.exprs),
                                                 List<PExpr>()),
                                     n),
                                   n)
      (o: PExpr)    => aiNoRep(n)
    (nm: PeName)    => match(c.parameter)
      (tp: PeTuple) => aiBetaNamed(nm.refName,
                                   tlEntValues(chain(tp.exprs),
                                               List<PExpr>()),
                                   singles, catalog, r, n)
      (o2: PExpr)   => aiNoRep(n)
    (o3: PExpr)     => aiNoRep(n)

fun aiBetaApply(out: IlbOut|None, n: Int): (n2: Int, rep: PExpr|None)
  ret match(out)
    (io: IlbOut) => aiRep(io.ilN, io.ilExpr)
    ()           => aiNoRep(n)

fun aiBetaNamed(name: String, args: List<PExpr>, singles: Singles,
                catalog: Catalog, r: Resolver|None,
                n: Int): (n2: Int, rep: PExpr|None)
  let viaLam = match(aiSingleLam(singles, name))
    (lam: PeLambda) => aiBetaApply(aiBetaReduceLambda(lam, args, n), n)
    ()              => aiNoRep(n)
  ret match(viaLam.rep)
    (rep: PExpr) => viaLam
    ()           => match(aiCatLookup(catalog, name))
      (target: PsFun) => aiBetaApply(aiExprInlineFunction(target, args, r,
                                                          viaLam.n2),
                                     viaLam.n2)
      ()              => viaLam

# Drop lambda lets whose single use was inlined away (no remaining refs in
# any OTHER statement of the sequence).
fun aiDropDeadLams(ss: List<PStmt>, singles: Singles): List<PStmt>
  ret aiDdlLoop(chain(ss), ss, 0, singles, List<PStmt>())

fun aiDdlLoop(cs: Chain<PStmt>, all: List<PStmt>, i: Int,
                     singles: Singles, acc: List<PStmt>): List<PStmt>
  ret build<PStmt >(aiDdlLoopB(cs, all, i, singles, _pushChain<PStmt >(builder<PStmt >(), chain<PStmt >(acc))))

fun [tail] aiDdlLoopB(cs: Chain<PStmt>, all: List<PStmt>, i: Int,
                     singles: Singles, [terminal] acc: ListBuilder<PStmt >): ListBuilder<PStmt >
  ret match(cs)
    (nil: ChainEnd) => acc
    (l: ChainLink)  => aiDdlDead(l.value, all, i, singles)
      ? aiDdlLoopB(l.next, all, i + 1, singles, acc)
      : aiDdlLoopB(l.next, all, i + 1, singles, push<PStmt >(acc, l.value))

fun aiDdlDead(st: PStmt, all: List<PStmt>, i: Int, singles: Singles): Bool
  ret match(st)
    (let2: PsLet) => contains<String, PExpr>(singles.sgMap, let2.lName)
                     && aiRefsExceptAt(chain(all), let2.lName, i, 0, 0) == 0
    (o: PStmt)    => false

fun [tail] aiRefsExceptAt(ss: Chain<PStmt>, name: String, skip: Int, i: Int,
                          n: Int): Int
  ret match(ss)
    (nil: ChainEnd) => n
    (l: ChainLink)  => aiRefsExceptAt(l.next, name, skip, i + 1,
                                      i == skip
                                        ? n
                                        : n + aiRefCountStmt(l.value, name))

# ── block-value flattening ───────────────────────────────────────────────────
# Merge value-of-block chains INCLUDING through a Convert (a union-returning
# ctor inlined at a `ret` wraps its block in the union conversion) — the
# same rule as the parity-fixed Python _flatten_block_values.

fun aiFlattenBlockValues(statements: List<PStmt>): List<PStmt>
  ret rwStmts(statements, rwOnExpr(aiFlattenCb))

fun aiFlattenCb(x: PExpr): PExpr|None
  ret match(x)
    (bk: PeBlock) => aiFlattenLoop(bk, bk.blockStmts, bk.blockValue, false)
    (o: PExpr)    => None

fun [tail] aiFlattenLoop(bk: PeBlock, merged: List<PStmt>, value: PExpr,
                  changed: Bool): PExpr|None
  ret match(value)
    (ib: PeBlock)   => aiFlattenLoop(bk, concat(merged, ib.blockStmts),
                                     ib.blockValue, true)
    (cv: PeConvert) => match(cv.convInner)
      (ib2: PeBlock) => aiFlattenLoop(bk, concat(merged, ib2.blockStmts),
                                      PeConvert(ib2.blockValue,
                                                cv.convTarget, cv.pecvLine),
                                      true)
      (o: PExpr)     => changed ? PeBlock(merged, value, bk.blockTag,
                                          bk.pebkLine)
                                : None
    (o2: PExpr)     => changed ? PeBlock(merged, value, bk.blockTag,
                                         bk.pebkLine)
                               : None

# ── per-function rewrite + the fixpoint driver ───────────────────────────────

class [final] RfOut(rfN: Int, rfStmt: PStmt, rfChanged: Bool)

fun aiRewriteFunction(f: PsFun, catalog: Catalog, r: Resolver|None,
                      n: Int): RfOut
  ret match(f.fBody)
    (b: PExpr) => match(b)
      (bk: PeBlock) => aiRwf2(f, bk, catalog, r, n)
      (o: PExpr)    => RfOut(n, f, false)
    ()         => RfOut(n, f, false)

fun aiRwf2(f: PsFun, bk: PeBlock, catalog: Catalog, r: Resolver|None,
           n: Int): RfOut
  let stmts0 = aiBlockAsStmts(bk)
  # Pass 1: statement-level function inlining.
  let p1 = aiPass1b(chain(stmts0), catalog, f.fName, n, List<PStmt>(), 0)
  # Pass 2: beta-reduction + expression-position inlining.
  let p2 = aiBetaReduceExpressions(p1.tiStmts, catalog, r, p1.tiN)
  let changed = aiPass1Changed(p1) || !eqStmts(p2.rnssStmts, p1.tiStmts)
  if !changed
    ret RfOut(p2.rnssN, f, false)
  ret match(last(p2.rnssStmts))
    (lastStmt: PStmt) => match(lastStmt)
      (rt: PsRet) => RfOut(p2.rnssN,
                           PsFun(f.fName, f.fAttrs, f.fGens, f.fParams,
                                 PeBlock(initOf(p2.rnssStmts),
                                         rt.retValue, bk.blockTag,
                                         bk.pebkLine),
                                 f.fRet, f.fWheres, f.psfLine,
                                 f.fRetInferred, f.fNested, f.fImports),
                           true)
      (o: PStmt)  => RfOut(p2.rnssN, f, false)
    ()                => RfOut(p2.rnssN, f, false)

# Pass-1 threads (stmts, n, changed) — tiStmts reuses TisOut's list plus a
# changed marker carried via the count of replacements.
class [final] P1Out(tiN: Int, tiStmts: List<PStmt>, tiHits: Int)

fun aiPass1Changed(p: P1Out): Bool
  ret p.tiHits != 0

# Program order: a statement either stays or is replaced by the statements its
# inlined call expanded to, and the result is the new body. Built at the tail,
# with the inlined group pushed as a chain.
fun aiPass1b(ss: Chain<PStmt>, catalog: Catalog, selfName: String,
             n: Int, acc: List<PStmt>, hits: Int): P1Out
  ret aiPass1c(ss, catalog, selfName, n,
               _pushChain<PStmt >(builder<PStmt >(), chain<PStmt >(acc)), hits)
    |> (out) => P1Out(out.tiN, build<PStmt >(out.tiStmts), out.tiHits)

class [linear, final] P1Acc(tiN: Int, tiStmts: ListBuilder<PStmt >,
                            tiHits: Int)

fun [tail] aiPass1c(ss: Chain<PStmt>, catalog: Catalog, selfName: String,
                    n: Int, [terminal] acc: ListBuilder<PStmt >,
                    hits: Int): P1Acc
  ret match(ss)
    (nil: ChainEnd) => P1Acc(n, acc, hits)
    (l: ChainLink)  => match(aiTryInlineAtStmt(l.value, catalog, selfName,
                                               n))
      (t2: TisOut) => aiPass1c(l.next, catalog, selfName, t2.tiN,
                               _pushChain<PStmt >(acc, chain<PStmt >(t2.tiStmts)),
                               hits + 1)
      ()           => aiPass1c(l.next, catalog, selfName, n,
                               push<PStmt >(acc, l.value), hits)

# The fixpoint: counter reset per entry; catalog rebuilt per round; stop when
# nothing is inlinable or a round changes nothing; then flatten.
fun inlineAst(statements: List<PStmt>): List<PStmt>
  ret aiRounds(statements, 0, 0)

fun [tail] aiRounds(current: List<PStmt>, round2: Int, n: Int): List<PStmt>
  if round2 >= 10                       # _MAX_ITERATIONS
    ret aiFlattenBlockValues(current)
  let catalog = aiBuildCatalog(current)
  if isEmpty(catalog.caMap)
    ret aiFlattenBlockValues(current)
  let r = rootResolver(current)
  let out = aiRound(chain(current), catalog, r, n, List<PStmt>(), false)
  if !out.arChanged
    ret aiFlattenBlockValues(out.arStmts)
  ret aiRounds(out.arStmts, round2 + 1, out.arN)

class [final] ArOut(arN: Int, arStmts: List<PStmt>, arChanged: Bool)

class [linear, final] ArAcc(araN: Int, araStmts: ListBuilder<PStmt >,
                            araChanged: Bool)

# One round over the whole program: every statement comes out, in order, either
# rewritten or as it was.
fun aiRound(ss: Chain<PStmt>, catalog: Catalog, r: Resolver, n: Int,
            acc: List<PStmt>, changed: Bool): ArOut
  ret aiRoundB(ss, catalog, r, n,
               _pushChain<PStmt >(builder<PStmt >(), chain<PStmt >(acc)),
               changed)
    |> (out) => ArOut(out.araN, build<PStmt >(out.araStmts), out.araChanged)

fun [tail] aiRoundB(ss: Chain<PStmt>, catalog: Catalog, r: Resolver, n: Int,
                    [terminal] acc: ListBuilder<PStmt >,
                    changed: Bool): ArAcc
  ret match(ss)
    (nil: ChainEnd) => ArAcc(n, acc, changed)
    (l: ChainLink)  => match(l.value)
      (f: PsFun) => aiRewriteFunction(f, catalog, r, n)
        |> (out) => aiRoundB(l.next, catalog, r, out.rfN,
                             push<PStmt >(acc, out.rfStmt),
                             changed || out.rfChanged)
      (o: PStmt) => aiRoundB(l.next, catalog, r, n, push<PStmt >(acc, l.value),
                             changed)
