# bootstrap/generics.yafl — monomorphisation, ported from lowering/generics.py
# (part 1: naming, concreteness, instantiation finding, substitution,
# specialisation; the iterative driver and trait resolution follow below).
namespace Bootstrap::Lower::Ast

import System
import System::Containers

import Bootstrap::Ast
import Bootstrap::Codegen
import Bootstrap::Frontend
import Bootstrap::Parse
import Bootstrap::Resolve
import Bootstrap::StdlibCandidates
import Bootstrap::Types



# A concrete instantiation: (generic name, type args). Kept as lists (the
# ordered carrier) deduplicated BY IDENTITY — grIds is the request's identity
# key, the argument TypeIds, computed once at construction exactly as Python
# builds its dict key once per add.
class [final] GRef(grName: String, grArgs: List<Spec>, grIds: List<TypeId>)
class [final] GRefs(gdData: List<GRef>, gdTypes: List<GRef>)

fun mkGRef(name, args) => GRef(name, args, spellList(args))

# name$generic$uid1_uid2 — "unknown" for an id-less arg, exactly as Python.
fun mangledName(base, args: List<Spec>)
  ret isEmpty(args) ? base : base + "$generic$" + joinUids(args, "")

fun joinUids(as2: List<Spec>, acc) =>
  fold(as2, acc, (a, x) => a == "" ? uidOrUnknown(x) : a + "_" + uidOrUnknown(x))

fun uidOrUnknown(sp) => uid(sp) == "" ? "unknown" : uid(sp)

fun refKey(g2: GRef) => mangledName(g2.grName, g2.grArgs)

# Dedupe BY IDENTITY, not by mangled key: two requests are the same request
# iff name and argument TypeIds agree (Python's dict keyed by (name, ids)).
# Id-less "unknown" mangled-key collisions stay distinct when their argument
# identities differ — the redirect must match whichever spelling a node
# carries. Creation stays single per mangled name via existingKeys.
# First one in wins, as Python's setdefault.
# On the FRONT: every consumer of this collection runs it through sortRefs
# first (createSpecializedStatements), so the order it is gathered in is never
# read. The dedup still keeps the first STRUCTURE seen, which is what decides
# membership — a later equal ref is dropped either way round.
fun addRef(refs, g2: GRef): List<GRef> => hasRefStruct(refs, g2) ? refs : prepend(g2, refs)

fun hasRefStruct(rs: List<GRef>, g2: GRef) =>
  any(rs, (x) => (x.grName == g2.grName && eqTypeIds(x.grIds, g2.grIds)))

fun addRefs(refs: List<GRef>, rs: List<GRef>) =>
  fold(rs, refs, addRef)

# ── concreteness ────────────────────────────────────────────────────────────
# Args are usable for an instantiation only when: no bare placeholder; no
# spec still carrying its OWN type params (its uid ignores them — using it
# names the instantiation after the raw template and collides them all); no
# union holding a placeholder anywhere.

fun isConcreteTypeArgs(args: List<Spec>) => allConcreteArgs(args)

fun allConcreteArgs(as2: List<Spec>) => all(as2, concreteArg)

# ANY COMPOSITE argument holding a placeholder is NOT concrete — specialising
# it produces a `…_unknown` instantiation. The bare-placeholder case below
# misses it (the arg is the composite, not the placeholder itself).
#
# This was originally a union-only check (`E | JsonParseError` while E is
# abstract). A TUPLE behaves identically: the pattern of
# `instance <A,B> BasicEquality<(:A,:B)>` mangled to
# `BasicEquality$generic$unknown`, so no concrete demand could ever unify
# against it and the instance was silently never selected — the whole reason a
# tuple could not be a Dict key.
fun concreteArg(sp) => match(sp)
  (g2: SGeneric)     => false
  (o: Spec)          => !awaitsRedirect(sp) && !containsPlaceholder(sp)

# A generic reference still carrying its type arguments, at ANY depth — one
# whose own specialisation has not been redirected yet. Naming an
# instantiation after it spells the argument as it is NOW; once the nested
# reference is redirected the same argument spells differently, the
# instantiation is made again under the new spelling, and each copy's
# self-calls name the other (a [tail] function then finds no self-call at
# all). Nested positions count exactly as the top one does:
# `(String, Dict<String, List<Int>>)` waits for `List<Int>` and then `Dict<…>`
# to land, as a bare `Dict<String, List<Int>>` always has.
fun awaitsRedirect(sp: Spec): Bool => match(sp)
  (e2: SEnum)        => !isEmpty(e2.seParams)
  (c: SClass)        => !isEmpty(c.scParams)
  (n: SNamed)        => !isEmpty(n.snParams)
  (cm: SCombination) => any(cm.scTypes, awaitsRedirect)
  (t2: STuple)       => any(t2.stEntries, entryAwaitsRedirect)
  (cl: SCallable)    => awaitsRedirect(cl.scParams2) || resultAwaitsRedirect(cl.scResult)
  (o: Spec)          => false

fun entryAwaitsRedirect(x: SEntry): Bool => match(x.seType)
  (ty: Spec) => awaitsRedirect(ty)
  ()         => false

fun resultAwaitsRedirect(r: Spec|None): Bool => match(r)
  (ty: Spec) => awaitsRedirect(ty)
  ()         => false

fun containsPlaceholder(sp) => match(sp)
  (g2: SGeneric)     => true
  (cm: SCombination) => anyContainsPlaceholder(cm.scTypes)
  (c: SClass)        => anyContainsPlaceholder(c.scParams)
  (t2: STuple)       => anyEntryPlaceholder(t2.stEntries)
  (e2: SEnum)        => anyContainsPlaceholder(e2.seParams)
  (o: Spec)          => false

fun anyContainsPlaceholder(ss: List<Spec>) => any(ss, containsPlaceholder)

fun anyEntryPlaceholder(es: List<SEntry>) => any(es, anyEntryPlaceholderStep)

fun anyEntryPlaceholderStep(x: SEntry) => match(x.seType)
  (ty: Spec) => containsPlaceholder(ty)
  () => false

# Is `name` used anywhere in `sp` OUTSIDE a union? Union-only params are the
# benign where-bindable gap; outside-union means the interface match should
# have pinned it and where-solving would rescue a bogus match.
fun appearsOutsideUnion(sp, name, inUnion) => match(sp)
  (g2: SGeneric)     => g2.sgName == name && !inUnion
  (cm: SCombination) => anyOutsideUnion(cm.scTypes, name, true)
  (c: SClass)        => anyOutsideUnion(c.scParams, name, inUnion)
  (t2: STuple)       => anyEntryOutside(t2.stEntries, name, inUnion)
  (e2: SEnum)        => anyOutsideUnion(e2.seParams, name, inUnion)
  (o: Spec)          => false

fun anyOutsideUnion(ss: List<Spec>, name, inUnion) => any(ss, (x) => appearsOutsideUnion(x, name, inUnion))

fun anyEntryOutside(es: List<SEntry>, name,
                           inUnion) => any(es, (x) => anyEntryOutsideStep(x, name, inUnion))

fun anyEntryOutsideStep(x: SEntry, name, inUnion) => match(x.seType)
  (ty: Spec) => appearsOutsideUnion(ty, name, inUnion)
  () => false

# ── finding concrete instantiations ─────────────────────────────────────────
# find_instantiations: one callback over the whole tree. PeName / PeNewEnum /
# SEnum / SNamed feed dataRefs, SClass feeds typeRefs — only with concrete args.

fun findConcreteInstantiations(statements: List<PStmt>): GRefs =>
  walkStmts(statements, emptyResolverGlobal, GRefs(List(), List()),
            Walk<GRefs>((acc, _r, x) => (s = fciExpr(x, acc), r = None),
                        wkNoStmt<GRefs>,
                        (acc, _r, sp) => (s = fciSpec(sp, acc), r = None))).s

fun fciExpr(x: PExpr, acc: GRefs): GRefs => match(x)
  (nm: PeName)    => nameRef(nm.refName, nm.refTypeParams, acc)
  (ne: PeNewEnum) => nameRef(ne.rootName, ne.neTypeParams, acc)
  (o: PExpr)      => acc

fun nameRef(name, args, acc) => !isEmpty(args) && isConcreteTypeArgs(args)
  ? GRefs(addRef(acc.gdData, mkGRef(name, args)), acc.gdTypes)
  : acc

fun fciSpec(sp: Spec, acc: GRefs): GRefs => match(sp)
  (c: SClass)  => !isEmpty(c.scParams) && isConcreteTypeArgs(c.scParams)
    ? GRefs(acc.gdData, addRef(acc.gdTypes, mkGRef(c.scName, c.scParams)))
    : acc
  (e2: SEnum)  => nameRef(e2.seRoot, e2.seParams, acc)
  (n: SNamed)  => nameRef(n.snName, n.snParams, acc)
  (o: Spec)    => acc

# ── substitution ────────────────────────────────────────────────────────────
# Placeholders substitute by SPEC-scope name first, then — for an enum
# template's own placeholders only — by BARE name (strip @hash): an enum's
# T-scope hash differs from the function's, but both come from one source
# identifier, so the bare match is correct within a single specialisation. EnumSpec substitution walks all_fields with a
# visited-set cycle guard (search_and_replace deliberately skips them) AND
# its own params; a NamedSpec-with-params inside all_fields inline-redirects
# to its mangled name once concrete.

class [final] GSub(gsExact: List<Binding>, gsBare: List<Binding>,
                   gsFormals: Dict<String, List<String>>,
                   gsEnumFormals: Set<String>)

# Two independent name -> spec maps, each read by first-match lookup. A generic
# parameter list has no repeated names, so which end an entry goes on cannot
# change any lookup.
fun gsubOf(gens: List<PGen>, args: List<Spec>, formals) =>
  zipFold(gens, args, GSub(List(), List(), formals, enumFormalNames(formals)),
          (acc, g2, a) => GSub(prepend(Binding(g2.genName, a), acc.gsExact),
                               prepend(Binding(bareGenName(g2.genName), a), acc.gsBare),
                               acc.gsFormals, acc.gsEnumFormals))

# Every placeholder an enum template declares — the only ones the bare-name
# match is for (see resolveGp).
fun enumFormalNames(formals: Dict<String, List<String>>) => fold(values(formals), Set(),
                                                                 (acc, ns) => fold(ns, acc, add))

fun bareGenName(name)
  let at = findByte(name, '@', 0)
  ret at < 0 ? name : slice(name, 0, at)

# The bare-name match is for ENUM-template placeholders only — the ones
# all_fields and identity completion carry under the enum's own scope hash.
# Any other unmatched placeholder (a callee's own param left unbound at a call
# site) is not this specialisation's to guess: binding it by name to whichever
# host param shares the letter was a silent miscompile. Left in place, the
# unresolved-generic-call report names it at the use site.
fun resolveGp(name, sub: GSub) => match(bindingOf(sub.gsExact, name))
  (b: Spec) => b
  ()        => contains(sub.gsEnumFormals, name)
    ? bindingOf(sub.gsBare, bareGenName(name))
    : None

# substitute: the walk's spec callback. A placeholder resolves; an EnumSpec —
# its params already walked, bottom-up — runs _substitute_enum: the in-field
# rules over those params, then identity completion. Every other node is the
# walk's (a union re-flattens there, as CombinationSpec's does).
fun gsubSpec(sp: Spec, sub: GSub): Spec|None => match(sp)
  (g2: SGeneric) => resolveGp(g2.sgName, sub)
  (e2: SEnum)    => gsubEnumNode(e2, e2.seParams, sub, List())
  (o: Spec)      => None

fun gsubStmt(st: PStmt, sub: GSub): PStmt =>
  walkStmt(st, emptyResolverGlobal, false,
           Walk<Bool>(wkNoExpr<Bool>, wkNoStmt<Bool>,
                      (s, _r, sp) => (s = s, r = gsubSpec(sp, sub)))).x

# _substitute_enum: substitute the given params; fields are DERIVED from the
# instance statement, so there is no stored copy to walk. IDENTITY COMPLETION
# (identity-vs-state ruling): a bare template-rooted spec inside a
# specialisation must carry its FULL type arguments — the stored-fields walk
# used to bake the function's bindings into each copy; with fields derived,
# the spec itself is the carrier, so substitution-on-read can reconstruct
# the instance view. Unbound formals attach as their placeholder, exactly
# Python's _resolve_gp.
fun gsubEnumNode(e2: SEnum, params0: List<Spec>, sub: GSub,
                 visited: List<String>)
  let params2 = gsubInFieldList(params0, sub, visited)
  ret SEnum(e2.seRoot, e2.seValidLeaves, e2.seAllLeaves,
            gsubCompleted(e2, params2, sub), e2.seLine, e2.sePath)

fun gsubCompleted(e2: SEnum, params2, sub: GSub): List<Spec>
  if !isEmpty(params2)
    ret params2
  ret match(get(sub.gsFormals, e2.seRoot))
    (names: List<String>) => gsubFormalArgs(names, e2,
                                       sub, List())
    ()                    => params2

# POSITIONAL: these are the enum's type arguments, so the order they come out
# in is the argument list.
fun gsubFormalArgs(ns: List<String>, e2: SEnum, sub: GSub, acc: List<Spec>) =>
  fold(ns, acc, (a, x) => gsubFormalArgsStep(a, x, e2, sub))

fun gsubFormalArgsStep(a: List<Spec>, x: String, e2: SEnum, sub: GSub) => match(resolveGp(x, sub))
  (b: Spec) => append(a, b)
  () => append(a, SGeneric(x, false, e2.seLine))

fun gsubInField(ft, sub: GSub, visited: List<String>) => match(ft)
  (g2: SGeneric) => match(resolveGp(g2.sgName, sub))
    (b: Spec) => b
    ()        => ft
  (n: SNamed)    => isEmpty(n.snParams)
    ? ft
    : gsubNamedInField(n, sub, visited)
  (e2: SEnum)    => gsubEnumNode(e2, e2.seParams, sub, visited)
  (o: Spec)      => ft

# Python gates on `any(n is not o)`: an unchanged NamedSpec is returned as-is
# — in particular the inline redirect does NOT fire on already-concrete
# params that this substitution didn't touch.
fun gsubNamedInField(n, sub: GSub, visited: List<String>)
  let newTp = gsubInFieldList(n.snParams, sub, visited)
  if eqSpecs(newTp, n.snParams)
    ret n
  ret isConcreteTypeArgs(newTp)
    ? SNamed(mangledName(n.snName, newTp), List(), n.snLine)
    : SNamed(n.snName, newTp, n.snLine)

fun gsubInFieldList(ts: List<Spec>, sub: GSub,
                    visited: List<String>) => gsubInFieldLoop(ts, sub, visited, List())

fun gsubInFieldLoop(ts: List<Spec>, sub: GSub, visited: List<String>, acc: List<Spec>) =>
  fold(ts, acc, (a, x) => append(a, gsubInField(x, sub, visited)))

# ── specialisation ──────────────────────────────────────────────────────────
# Substitute, rename to the mangled name, clear the gens. A CLASS also renames
# its own concrete methods (and slot table) with an @type-sig suffix — two
# instantiations would otherwise emit colliding C symbols; '@' keeps
# name_matches compatibility for member lookup.

fun createSpecializedVersion(st, args: List<Spec>,
                             formals)
  let gens = stmtGens(st)
  if isEmpty(gens) || isEmpty(args)
    ret st
  let sub = gsubOf(gens, args, formals)
  let newName = mangledName(stmtName(st), args)
  ret renameSpecialized(gsubStmt(st, sub), newName, args)

fun renameSpecialized(st, newName, args: List<Spec>) => match(st)
  (f: PsFun)  => PsFun(newName, f.fAttrs, List(), f.fParams, f.fBody,
                       f.fRet, f.fWheres, f.psfLine, f.fRetInferred,
                       f.fNested, f.fImports, f.fGlobal)
  (l: PsLet)  => PsLet(newName, l.lAttrs, List(), l.lType, l.lDefault,
                       l.lArrayLen, l.lWheres, l.pslLine, l.lTypeInferred,
                       l.lImports)
  (c: PsClass) => specializedClass(c, newName, args)
  # The VARIANT tree renames with the same $generic$ suffix — the redirect
  # mangles leaf names inside every EnumSpec it visits, and every enum-spec
  # rebuild collects the variant STATEMENT names, so the two must agree
  # (Python __rename_variant_tree; a stale root-mangled/leaves-original
  # spec silently skipped union boxing at emit).
  (e2: PsEnum) => PsEnum(newName, e2.eAttrs, List(), e2.eParams,
                         renameVariantTree(e2.eVariants, args),
                         e2.eHasParams, e2.pseLine, e2.eRootName, e2.eSpec,
                         e2.eImports)
  (ta: PsTypealias) => PsTypealias(newName, ta.taAttrs, List(),
                                   ta.taType, ta.taWheres, ta.pstLine,
                                   ta.taImports)
  (o: PStmt)  => st

fun renameVariantTree(vs: List<PStmt>, args: List<Spec>) => map(vs, (v) => renameVariant(v, args))

fun renameVariant(v, args: List<Spec>) => match(v)
  (ve: PsEnum) => PsEnum(mangledName(ve.eName, args), ve.eAttrs, ve.eGens,
                         ve.eParams,
                         renameVariantTree(ve.eVariants, args),
                         ve.eHasParams, ve.pseLine, ve.eRootName, ve.eSpec,
                         ve.eImports)
  (o: PStmt)   => v

fun specializedClass(c: PsClass, newName, args: List<Spec>)
  let sig = joinUids(args, "")
  let rn = methodRenames(c.cMembers, sig, List())
  ret PsClass(newName, c.cAttrs, List(), c.cParams, c.cImplements,
              c.cWheres,
              renameMembers(c.cMembers, rn, List()),
              c.cIsInterface, c.pscLine, c.cAllParents,
              renameSlots(c.cAllSlots, rn), c.cImports)

class [final] Binding2(b2From: String, b2To: String)

fun methodRenames(ms: List<PStmt>, sig, acc: List<Binding2>) =>
  fold(ms, acc, (a, x) => methodRenamesStep(a, x, sig))

fun methodRenamesStep(a: List<Binding2>, x: PStmt, sig) => match(x)
  (f: PsFun) => match(f.fBody)
    (b: PExpr) => append(a, Binding2(f.fName, f.fName + "@" + sig))
    () => a
  (o: PStmt) => a

fun renamedTo(rn: List<Binding2>, name: String) => match(firstWhere(rn, (b) => b.b2From == name))
  (b: Binding2) => b.b2To
  ()            => name

fun renameMembers(ms: List<PStmt>, rn: List<Binding2>, acc: List<PStmt>) =>
  fold(ms, acc, (a, x) => renameMembersStep(a, x, rn))

fun renameMembersStep(a: List<PStmt>, x: PStmt, rn: List<Binding2>) => match(x)
  (f: PsFun) => append(a, renamedTo(rn, f.fName) == f.fName
    ? x
    : PsFun(renamedTo(rn, f.fName), f.fAttrs, f.fGens,
            f.fParams, f.fBody, f.fRet, f.fWheres,
            f.psfLine, f.fRetInferred, f.fNested,
            f.fImports, f.fGlobal))
  (o: PStmt) => append(a, x)

fun renameSlots(ss, rn: List<Binding2>) => match(ss)
  (l: List<Slot>) => isEmpty(rn) ? ss : renameSlotList(l, rn,
                                                       List())
  ()              => None

fun renameSlotList(ss: List<Slot>, rn: List<Binding2>, acc): List<Slot> =>
  fold(ss, acc, (a, x) => append(a, Slot(renamedTo(rn, x.slotName), x.slotType,
                renameProvides(x.slotProvides, rn,
                               List()))))

fun renameProvides(ps: List<String>, rn: List<Binding2>, acc: List<String>) =>
  fold(ps, acc, (a, x) => addNameOnce(a, renamedTo(rn, x)))

# ── creating specialized statements ─────────────────────────────────────────
# All refs SORTED by (name, arg-uids); dedup key is (mangled name, statement
# KIND) — a class and its synthesised constructor share a name and BOTH must
# specialise.

fun createSpecializedStatements(statements: List<PStmt>,
                                refs: GRefs)
  let allRefs = sortRefs(concat(refs.gdData, refs.gdTypes))
  let formals = gsFormalsOf(statements,
                            Dict())
  ret cssLoop(statements, allRefs, formals,
              existingKeys(statements, Set()),
              List())

# Template formals for identity completion: root -> the declaration's formal
# names, in order (mirror of Python's template_formals map).
fun gsFormalsOf(ss: List<PStmt>, acc) =>
  fold(ss, acc, gsFormalsOfStep)

fun gsFormalsOfStep(a: Dict<String, List<String>>, x: PStmt) => match(x)
  (e: PsEnum) => isEmpty(e.eGens)
    ? a
    : put(a, e.eName, map(e.eGens, (g2) => g2.genName))
  (o: PStmt) => a

fun stmtKind(st) => match(st)
  (f: PsFun)   => "fun"
  (l: PsLet)   => "let"
  (d: PsDestructure) => "destructure"
  (c: PsClass) => "class"
  (e2: PsEnum) => "enum"
  (ta: PsTypealias) => "typealias"
  (o: PStmt)   => "other"

# The name+kind keys already present. A SET: its one consumer asks only
# whether a key is taken, so the order it was collected in is not read.
fun existingKeys(ss: List<PStmt>, acc: Set<String>) =>
  fold(ss, acc, (a, x) => add(a, stmtName(x) + "\t" + stmtKind(x)))

# Sorted by refLess. This was an INSERTION SORT — each ref walked the sorted
# prefix rebuilding it as it went, so ordering n refs cost O(n^2) copies. The
# stdlib sort is a stable mergesort and takes the same comparator.
fun sortRefs(refs: List<GRef>) => sortBy(refs, refLess)

# Order: name, then the uid spellings ELEMENT-WISE (Python compares the
# tuple, not a joined string), then the DEEP structural spelling — uid
# collapses id-less specs, and a tie decided by set-iteration order was the
# last source of whole-compiler C divergence. deepId is the serialised
# TypeId spelling, the same spelling Python's __deep_id routes through.
fun refLess(a: GRef, b: GRef) => a.grName != b.grName ? a.grName < b.grName
  : strsLess(map(a.grArgs, refUid), map(b.grArgs, refUid))
    ? true
    : strsLess(map(b.grArgs, refUid), map(a.grArgs, refUid))
      ? false
      : strsLess(map(a.grArgs, deepId), map(b.grArgs, deepId))

# Python's sort key uses `as_unique_id_str() or ""` — the EMPTY string for
# an id-less spec (mangledName's "unknown" belongs to naming, not sorting).
fun refUid(sp) => uid(sp)

# Lexicographic list-of-strings compare (Python tuple <).
fun [tail] strsLess(a: List<String>, b: List<String>) => match(head(a))
  (x: String) => match(head(b))
    (y: String) => x != y ? x < y : strsLess(dropOne(a), dropOne(b))
    ()          => false
  ()          => !isEmpty(b)

# The deep spelling is the serialised TypeId — ONE identity spelling, defined
# in ast/identity.yafl and mirrored by Python's pyast/typespec/identity.py.
fun deepId(sp) => tiSerialise(spellingOf(sp))

# The specialisations emitted, in order, and the keys already emitted. The
# keys answer membership only, so they are a Set.
class [final] CssState(csOut: List<PStmt>, csKeys: Set<String>)

fun cssLoop(ss: List<PStmt>, allRefs: List<GRef>, formals, keys, acc) =>
  fold(ss, (keys = keys, acc = acc), (st, x) => cssLoopStep(st, x, allRefs, formals)).acc

fun cssLoopStep(st: (keys: Set<String>, acc: List<PStmt>), x: PStmt, allRefs: List<GRef>, formals) =>
  isEmpty(stmtGens(x))
  ? (keys = st.keys, acc = st.acc)
  : cssForStmt(allRefs, x, formals, st.keys, st.acc)
    |> (st2) => (keys = st2.csKeys, acc = st2.csOut)

fun cssForStmt(rs: List<GRef>, st, formals, keys, acc) =>
  fold(rs, (keys = keys, acc = acc), (st3, x) => cssForStmtStep(st3, x, st, formals))
    |> (r) => CssState(r.acc, r.keys)

fun cssForStmtStep(st3: (keys: Set<String>, acc: List<PStmt>), x: GRef, st, formals) =>
  x.grName != stmtName(st)
  ? (keys = st3.keys, acc = st3.acc)
  : cssOne(x, st, formals, st3.keys, st3.acc)
    |> (st2) => (keys = st2.csKeys, acc = st2.csOut)

fun cssOne(ref: GRef, st,
           formals, keys,
           acc)
  let key = mangledName(ref.grName, ref.grArgs) + "\t" + stmtKind(st)
  if contains(keys, key)
    ret CssState(acc, keys)
  let sp = createSpecializedVersion(st, ref.grArgs, formals)
  let sp2 = match(sp)
    (e2: PsEnum) => layoutEnum(e2)      # rebuild _enum_spec post-substitution
    (o: PStmt)   => sp
  ret CssState(append(acc,
                          sp2),
               add(keys, key))

# ── the redirect ────────────────────────────────────────────────────────────
# Five node kinds carry type params; each redirects to the mangled name and
# clears them — the EnumSpec also mangles its LEAF names.

fun replaceConcreteReferences(statements: List<PStmt>, refs: GRefsIx): List<PStmt>
  let w = rcrWalk(refs)
  ret map(statements, (st) => rcrSlots(walkStmt(st, emptyResolverGlobal, false, w).x, w))

# redirect_reference: the five node kinds that carry type params. The walk is
# bottom-up, so the lookup sees params that already carry this round's inner
# renames — looking up with the RAW params matched a stale bare-spelling
# instantiation and froze it into the name (two fold<F,(List<str>,…)>-style
# instantiations differing only INSIDE a param collapsed onto one symbol).
fun rcrWalk(refs: GRefsIx): Walk<Bool> =>
  Walk<Bool>((s, _r, x) => (s = s, r = rcrExpr(x, refs)),
             wkNoStmt<Bool>,
             (s, _r, sp) => (s = s, r = rcrSpec(sp, refs)))

# The redirect's ref test is DICT-backed (user ruling 2026-07-22: lookups
# are dict-backed — Python's is an O(1) frozen-set hit, and the linear pair
# of scans here dominated the self-host mono phase). addRef dedups by
# refKey, so each key holds exactly one GRef; the exact name compare on the
# hit preserves hasExactRef's collision guard.
# The mangled key is only a FAST PATH: id-less args all spell "unknown", so
# DISTINCT (name, args) pairs can collide onto one key — the index buckets
# every ref per key and membership is Python's STRUCTURAL set test on
# (name, type_params), mirrored with eqSpecs over the bucket. A single-entry
# dict either swallowed unresolved-spelling references (redirected to a
# stale unknown-keyed instantiation) or, with an equality guard alone,
# missed spellings recorded behind the bucket head.
class [final] GRefsIx(giData: Dict<String, List<GRef>>,
                      giTypes: Dict<String, List<GRef>>)

fun indexRefs(refs: GRefs) => GRefsIx(fold(refs.gdData, Dict(), ixAdd),
                                      fold(refs.gdTypes, Dict(), ixAdd))

fun ixAdd(acc, g2) => match(get(acc, refKey(g2)))
  # A hash bucket, scanned by inBucket for a match — order not observable.
  (bucket: List<GRef>) => put(acc, refKey(g2), prepend(g2, bucket))
  ()                    => put(acc, refKey(g2), list1(g2))

fun inRefs(ix: Dict<String, List<GRef>>, name,
           args: List<Spec>) => !isEmpty(args) && isConcreteTypeArgs(args)
    && inRefsHit(ix, name, args, mangledName(name, args))

# The mangled key is only the bucket INDEX; the membership answer is decided
# by identity — name plus argument TypeIds, computed once per query, exactly
# as Python's __instance_key builds the dict key once per membership test.
fun inRefsHit(ix: Dict<String, List<GRef>>, name: String, args: List<Spec>,
              key: String) => match(get(ix, key))
  (bucket: List<GRef>) => inBucket(bucket, name, spellList(args))
  ()                    => false

fun inBucket(bs: List<GRef>, name: String, ids: List<TypeId>) =>
  any(bs, (x) => (x.grName == name && eqTypeIds(x.grIds, ids)))

fun rcrExpr(x: PExpr, refs: GRefsIx): PExpr|None => match(x)
  (nm: PeName) => inRefs(refs.giData, nm.refName, nm.refTypeParams)
    ? with nm(refName = mangledName(nm.refName, nm.refTypeParams), refTypeParams = List())
    : None
  # Python's redirect table rewrites root_spec_name AND leaf_name — the
  # specialised enum's variant tree carries mangled names, so the
  # constructor's leaf reference must match.
  (ne: PeNewEnum) => inRefs(refs.giData, ne.rootName, ne.neTypeParams)
    ? with ne(rootName = mangledName(ne.rootName, ne.neTypeParams),
              leafName = mangledName(ne.leafName, ne.neTypeParams),
              neTypeParams = List())
    : None
  (o: PExpr) => None

fun rcrSpec(sp: Spec, refs: GRefsIx): Spec|None => match(sp)
  (c: SClass) => inRefs(refs.giTypes, c.scName, c.scParams)
    ? SClass(mangledName(c.scName, c.scParams), List(), c.scLine)
    : None
  # all_fields is not redirected — EnumSpec.search_and_replace never visits
  # it; __refresh_enum_spec_all_fields syncs the copies later.
  (e2: SEnum) => inRefs(refs.giData, e2.seRoot, e2.seParams)
    ? SEnum(mangledName(e2.seRoot, e2.seParams),
            mangleLeaves(e2.seValidLeaves, e2.seParams),
            mangleLeaves(e2.seAllLeaves, e2.seParams),
            List(), e2.seLine, mangleLeaves(e2.sePath, e2.seParams))
    : None
  # NamedSpec is a traversal LEAF: the redirect applies to the node itself.
  (n: SNamed) => inRefs(refs.giData, n.snName, n.snParams)
    ? SNamed(mangledName(n.snName, n.snParams), List(), n.snLine)
    : None
  (o: Spec) => None

fun mangleLeaves(leaves: List<String>, args: List<Spec>) => map(leaves, (x) => mangledName(x, args))

# redirect_slots: the walk never visits cAllSlots (derived data, rebuilt by
# every compile), but the first compile after this pass reads a PARENT's
# table before the parent rebuilds it — so the cached slot types are
# redirected here, by the same rules.
fun rcrSlots(st: PStmt, w: Walk<Bool>): PStmt => match(st)
  (c: PsClass) => match(c.cAllSlots)
    (l: List<Slot>) => with c(cAllSlots = map(l, (sl) => with sl(slotType = rcrSlotType(sl.slotType, w))))
    ()              => st
  (o: PStmt) => st

fun rcrSlotType(sp: Spec|None, w: Walk<Bool>): Spec|None => match(sp)
  (s2: Spec) => walkSpec(s2, emptyResolverGlobal, false, w).x
  ()         => None

# ── prune + finalize ────────────────────────────────────────────────────────

fun pruneUnusedGenerics(statements: List<PStmt>) => pugLoop(statements, List())

fun pugLoop(ss: List<PStmt>, acc: List<PStmt>) =>
  fold(ss, acc, (a, x) => isEmpty(stmtGens(x)) ? append(a, x) : a)

# Rebuild _enum_spec for specialized (or non-generic) ROOT enums every round.
fun finalizeSpecializedEnumSpecs(statements: List<PStmt>,
                                 specialized: List<String>)
  ret fseLoop(statements, specialized, List())

fun fseLoop(ss: List<PStmt>, specialized: List<String>, acc: List<PStmt>) =>
  fold(ss, acc, (a, x) => fseLoopStep(a, x, specialized))

fun fseLoopStep(a: List<PStmt>, x: PStmt, specialized: List<String>) => match(x)
  (e2: PsEnum) => isRootEnum(e2)
            && (contains(specialized, e2.eName) || isEmpty(e2.eGens))
    ? append(a, layoutEnum(e2))
    : append(a, x)
  (o: PStmt) => append(a, x)

fun isRootEnum(e2: PsEnum) => match(e2.eRootName)
  (rn: String) => rn == e2.eName
  ()           => false

# ── constraint discharge for generic trait instances ────────────────────────

# Generic [trait] lets, each paired with the trait PATTERN it implements
# (the witness class's parent, remapped class→let placeholders).
class [final] GProvider(gpLet: PsLet, gpPattern: SClass)

fun genericInstanceProviders(statements: List<PStmt>,
                             r) => gipLoop(statements, r, List())

fun gipLoop(ss: List<PStmt>, r, acc: List<GProvider>) =>
  fold(ss, acc, (a, x) => gipLoopStep(a, x, r))

fun gipLoopStep(a: List<GProvider>, x: PStmt, r) => match(x)
  (let2: PsLet) => !isEmpty(let2.lGens) && hasAttr(let2.lAttrs, "trait")
    ? providerPatterns(let2, r, a)
    : a
  (o: PStmt) => a

fun providerPatterns(let2, r,
                     acc): List<GProvider> => match(let2.lType)
  (dc: SClass) => match(soleItem(findType(r, dc.scName)))
    (f: Found) => match(f.fStmt)
      (cls: PsClass) => match(cls.cAllParents)
        (ps: List<Spec>) => patternLoop(ps,
                                        paramMapping(cls.cGens,
                                                     dc.scParams),
                                        let2, acc)
        ()               => acc
      (o: PStmt)     => acc
    ()         => acc
  ()           => acc

fun patternLoop(ps: List<Spec>, remap: List<Binding>, let2, acc: List<GProvider>) =>
  fold(ps, acc, (a, x) => patternLoopStep(a, x, remap, let2))

fun patternLoopStep(a: List<GProvider>, x: Spec, remap: List<Binding>, let2) => match(x)
  (pc: SClass) => match(substitute(x, remap))
    (sub: SClass) => append(a, GProvider(let2, sub))
    (o: Spec) => a
  (o2: Spec) => a

# Constraint identity is the TOTAL spelling (Python keys its dict by
# spelling_of): is_concrete deliberately admits a bare placeholder, so the
# spelling — not a completeness-gated identity — is the honest dedup key.
# First one in wins, as Python's setdefault.
# On the FRONT: this collection is consumed by genericInstanceRefs, whose
# output is gathered into the ref set and SORTED before anything is generated
# from it, so the order constraints are discovered in is not observable. The
# first spelling still wins, which is what the dedup decides.
fun addConstraintOnce(acc, sp) => hasConstraint(acc, spellingOf(sp)) ? acc : prepend(sp, acc)

fun hasConstraint(cs: List<Spec>, id2) => any(cs, (x) => eqTypeId(spellingOf(x), id2))

# Every concrete trait constraint in any `where` clause anywhere in the tree
# (top-level and nested method wheres alike), plus every AMBIENT instance
# member call's solved scope — an ambient call records its demand on the use,
# not in any `where` clause. Python's `collect` callback.
fun collectConcreteConstraints(statements: List<PStmt>, acc: List<Spec>): List<Spec> =>
  walkStmts(statements, emptyResolverGlobal, acc,
            Walk<List<Spec>>((a, _r, x) => (s = cccExpr(x, a), r = None),
                             (a, _r, st) => (s = cccWheres(traitParamsOf(st), a), r = None),
                             wkNoSpec<List<Spec>>)).s

# A named statement's `where` clauses: Python's NamedStatement.trait_params,
# instances and type aliases included.
fun traitParamsOf(st: PStmt): List<Spec> => match(st)
  (f: PsFun)            => f.fWheres
  (l: PsLet)            => l.lWheres
  (c: PsClass)          => c.cWheres
  (ta: PsTypealias)     => ta.taWheres
  (ti: PsTraitInstance) => ti.tiWheres
  (o: PStmt)            => List()

fun cccExpr(x: PExpr, acc: List<Spec>): List<Spec> => match(x)
  (nm: PeName) => match(nm.penTrait)
    (c: SClass) => isConcrete(c) ? addConstraintOnce(acc, c) : acc
    ()          => acc
  (o: PExpr)   => acc

fun cccWheres(ws: List<Spec>, acc: List<Spec>): List<Spec> => fold(ws, acc, cccWheresStep)

fun cccWheresStep(a: List<Spec>, x: Spec) => match(x)
  (wc: SClass) => isConcrete(wc)
    ? addConstraintOnce(a, x)
    : a
  (o: Spec) => a

# monoMap is the seen-refs list itself, keyed by refKey on lookup. Python
# builds {mangled → (base, args)} from refs with non-empty args; an empty-args
# ref's key ends "$generic$unknown", which never names a specialisation, so no
# explicit filter is needed here.
fun monoLookup(rs: List<GRef>, mangled) => firstWhere(rs, (x) => refKey(x) == mangled)

# Undo mangling structurally: Wrap$generic$Leaf → Wrap<Leaf>, recursively.
fun specFromMangled(sp, mono: List<GRef>) => match(sp)
  (c: SClass) => isEmpty(c.scParams)
    ? sfmBare(c, mono)
    : SClass(c.scName, sfmList(c.scParams, mono, List()),
             c.scLine)
  # A mangled ENUM inner type (Sized<List$generic$bigint> demanded against
  # the pattern Sized<List<T>>): restore the root, the type params and the
  # leaves (ListFull$generic$bigint is the view's ListFull) — a merge
  # compares views.
  (e2: SEnum) => isEmpty(e2.seParams)
    ? sfmEnumBare(e2, mono)
    : SEnum(e2.seRoot, e2.seValidLeaves, e2.seAllLeaves,
            sfmList(e2.seParams, mono, List()), e2.seLine, e2.sePath)
  (o: Spec)   => sp

fun sfmEnumBare(e2, mono: List<GRef>) => match(monoLookup(mono, e2.seRoot))
  (g2: GRef) => SEnum(g2.grName, map(e2.seValidLeaves, sfmLeaf), map(e2.seAllLeaves, sfmLeaf),
                      sfmList(g2.grArgs, mono, List()),
                      e2.seLine, map(e2.sePath, sfmLeaf))
  ()         => e2

fun sfmLeaf(name: String): String
  let at = indexOf(name, "$generic$", 0)
  ret at < 0 ? name : slice(name, 0, at)

fun sfmBare(c, mono: List<GRef>) => match(monoLookup(mono, c.scName))
  (g2: GRef) => SClass(g2.grName, sfmList(g2.grArgs, mono, List()), c.scLine)
  ()         => c

fun sfmList(ss: List<Spec>, mono: List<GRef>, acc: List<Spec>) =>
  fold(ss, acc, (a, x) => append(a, specFromMangled(x, mono)))

# Inverse: structural Wrap<Leaf,Int> → bare Wrap$generic$Leaf_Int.
fun mangledFromSpec(sp) => match(sp)
  (c: SClass) => isEmpty(c.scParams)
    ? sp
    : SClass(mangledName(c.scName,
                         mfsList(c.scParams, List())),
             List(), c.scLine)
  (o: Spec)   => sp

fun mfsList(ss: List<Spec>, acc: List<Spec>) =>
  fold(ss, acc, (a, x) => append(a, mangledFromSpec(x)))

# The concrete interfaces implemented by NON-generic [trait] instances.
fun concreteInstanceInterfaces(statements: List<PStmt>,
                               r) => ciiLoop(statements, r, List())

# One builder threaded through all three levels: the statement walk, the
# per-instance step and the parent walk only ever WRITE to it, and the order
# they write in is the declaration order Python's comprehension produces.
fun ciiLoop(ss: List<PStmt>, r, acc: List<Spec>) =>
  fold(ss, acc, (a, x) => ciiLoopStep(a, x, r))

fun ciiLoopStep(a: List<Spec>, x: PStmt, r) => match(x)
  (let2: PsLet) => isEmpty(let2.lGens) && hasAttr(let2.lAttrs, "trait")
    ? instanceIfaces(let2, r, a)
    : a
  (o: PStmt) => a

fun instanceIfaces(let2: PsLet, r,
                   acc): List<Spec> => match(let2.lType)
  (dc: SClass) => match(soleItem(findType(r, dc.scName)))
    (f: Found) => match(f.fStmt)
      (cls: PsClass) => match(cls.cAllParents)
        (ps: List<Spec>) => ifaceLoop(ps,
                                      paramMapping(cls.cGens,
                                                   dc.scParams),
                                      acc)
        ()               => acc
      (o: PStmt)     => acc
    ()         => acc
  ()           => acc

fun ifaceLoop(ps: List<Spec>, remap: List<Binding>, acc: List<Spec>) =>
  fold(ps, acc, (a, x) => ifaceLoopStep(a, x, remap))

fun ifaceLoopStep(a: List<Spec>, x: Spec, remap: List<Binding>) => match(x)
  (pc: SClass) => match(substitute(x, remap))
    (sub: SClass) => isConcrete(sub)
      ? append(a, sub)
      : a
    (o: Spec) => a
  (o2: Spec) => a

# Mono-time where-discharge: strict positional bind_from_constraint_match
# against re-inflated concrete instance interfaces.
fun bindWhereParams(let2: PsLet, mapping,
                    instanceIfaces2: List<Spec>,
                    mono: List<GRef>)
  ret bwpWheres(let2.lWheres, let2, mapping, instanceIfaces2, mono)

fun [tail] bwpWheres(ws: List<Spec>, let2: PsLet, mapping, ifaces: List<Spec>, mono: List<GRef>)
  let targets = unboundGens(let2.lGens, mapping, List())
  if isEmpty(targets)
    ret mapping
  ret match(head(ws))
    (w: Spec) => bwpWheres(dropOne(ws), let2, bwpOne(w, mapping, targets, ifaces, mono), ifaces, mono)
    ()        => mapping

fun unboundGens(gs: List<PGen>, mapping: List<Binding>, acc): List<String> =>
  fold(gs, acc, (a, x) => unboundGensStep(a, x, mapping))

fun unboundGensStep(a: List<String>, x: PGen, mapping: List<Binding>) => match(bindingOf(mapping, x.genName))
  (b: Spec) => a
  () => append(a, x.genName)

fun bwpOne(wc, mapping, targets: List<String>,
           ifaces: List<Spec>, mono: List<GRef>) => match(substitute(wc, mapping))
  (sub: SClass) => match(firstSome(ifaces, (i) => bwpIface(i, sub, targets, mono)))
    (b: List<Binding>) => concat(mapping, b)
    ()                 => mapping
  (o: Spec)     => mapping

fun bwpIface(i: Spec, sub: SClass, targets: List<String>, mono: List<GRef>) => match(specFromMangled(i, mono))
  (iface: SClass) => bindFromConstraintMatch(sub, iface, targets)
  (o: Spec)       => None

# Witness-let instantiations needed to satisfy the constraints via the
# generic providers.
fun genericInstanceRefs(providers: List<GProvider>, constraints: List<Spec>,
                        monoRefs: List<GRef>,
                        ifaces: List<Spec>)
  ret girProviders(providers, constraints, monoRefs, ifaces,
                   List())

fun girProviders(ps: List<GProvider>,
                 constraints: List<Spec>,
                 mono: List<GRef>,
                 ifaces: List<Spec>,
                 acc: List<GRef>) =>
  fold(ps, acc, (a, x) => girConstraints(constraints, x, mono, ifaces, a))

fun girConstraints(cs: List<Spec>,
                   p: GProvider,
                   mono: List<GRef>,
                   ifaces: List<Spec>,
                   acc: List<GRef>) =>
  fold(cs, acc, (a, x) => girConstraintsStep(a, x, p, mono, ifaces))

fun girConstraintsStep(a: List<GRef>, x: Spec, p: GProvider, mono: List<GRef>, ifaces: List<Spec>) => match(x)
  (con: SClass) => p.gpPattern.scName == con.scName
    ? girOne(p, con, mono, ifaces, a)
    : a
  (o: Spec) => a

fun girOne(p: GProvider, con, mono: List<GRef>, ifaces: List<Spec>,
           acc): List<GRef>
  let letGens = p.gpLet.lGens
  let names = genNames(letGens, List())
  ret match(specFromMangled(con, mono))
    (inflated: SClass) => match(patternBinding(p.gpPattern, inflated, names,
                                               emptyResolver()))
      (m: List<Binding>) => girBound(p, letGens, names, m, ifaces, mono, acc)
      ()                 => acc
    (o: Spec)          => acc

fun girBound(p: GProvider, letGens: List<PGen>, names: List<String>,
             mapping0, ifaces: List<Spec>, mono: List<GRef>,
             acc): List<GRef>
  let unbound = unboundGens(letGens, mapping0, List())
  let mapping = !isEmpty(unbound) && !isEmpty(mapping0)
                && allUnionOnly(unbound, p.gpPattern)
    ? bindWhereParams(p.gpLet, mapping0, ifaces, mono)
    : mapping0
  if !isEmpty(unboundGens(letGens, mapping, List()))
    ret acc
  let args = mangledArgs(letGens, mapping, List())
  ret isConcreteTypeArgs(args)
    ? addRef(acc, mkGRef(p.gpLet.lName, args))
    : acc

fun allUnionOnly(ns: List<String>, pattern) => all(ns, (x) => !(appearsOutsideUnion(pattern, x, false)))

fun mangledArgs(gs: List<PGen>, mapping: List<Binding>, acc): List<Spec> =>
  fold(gs, acc, (a, x) => mangledArgsStep(a, x, mapping))

fun mangledArgsStep(a: List<Spec>, x: PGen, mapping: List<Binding>) => match(bindingOf(mapping, x.genName))
  (b: Spec) => append(a, mangledFromSpec(b))
  () => a

# ── the iterative driver ─────────────────────────────────────────────────────
# Python: __convert_generics_iterative. Round bound 64: legitimate transitive
# instantiation chains stabilise in a handful of rounds; a loop still minting
# new instantiations after that is deepening without bound (mutual polymorphic
# recursion — the direct case is caught structurally by the offender counts).

class [final] GIter(giStmts: List<PStmt>, giErrs: Set<PErr>)

fun addRefsAll(rs: List<GRef>, acc: List<GRef>) =>
  fold(rs, acc, addRef)

fun addSpecsAll(ss: List<Spec>, acc) =>
  fold(ss, acc, addConstraintOnce)

fun addNamesAll(ns: List<String>, acc: List<String>) => addNamesAllB(ns, acc, Set(acc))

fun addNamesAllB(ns: List<String>, out: List<String>, seen: Set<String>) =>
  fold(ns, (out = out, seen = seen), addNamesAllStep).out

fun addNamesAllStep(st: (out: List<String>, seen: Set<String>), x: String) =>
  contains(st.seen, x)
  ? (out = st.out, seen = st.seen)
  : (out = append(st.out, x), seen = add(st.seen, x))

fun convertGenericsIterative(statements) => monoRound(statements, 0, List(), List(), List())

fun [tail] monoRound(statements, round2,
                     allSpecEnums: List<String>, seenCons,
                     seenMono): GIter
  if round2 >= 64                                # _MAX_MONO_ROUNDS
    ret monoErrors(statements, seenMono)
  # Step 1: find all concrete instantiations.
  let found = findConcreteInstantiations(statements)
  let seenMono2 = addRefsAll(found.gdTypes,
                             addRefsAll(found.gdData, seenMono))
  # Step 1b: generic trait instances are selected by constraint discharge, not
  # by an explicit type-param reference. Discharge the constraints seen so far
  # against the generic instances, seeding witness-let refs.
  let r = rootResolver(statements)
  let seenCons2 = addSpecsAll(collectConcreteConstraints(statements,
                                                               List()),
                              seenCons)
  let dataRefs = addRefsAll(
      genericInstanceRefs(genericInstanceProviders(statements, r),
                                seenCons2, seenMono2,
                                concreteInstanceInterfaces(statements, r)),
      found.gdData)
  if isEmpty(dataRefs) && isEmpty(found.gdTypes)
    ret GIter(pruneUnusedGenerics(statements), Set())
  # Step 2: create specialized versions for matching NamedStatements.
  let specialized = createSpecializedStatements(statements,
                                                GRefs(dataRefs, found.gdTypes))
  # Step 2b: newly-created specialized statements may carry extra concrete
  # refs that arose from substitution — include them, but only when their
  # specialized target already exists (created in a prior iteration).
  let refs = isEmpty(specialized)
    ? GRefs(dataRefs, found.gdTypes)
    : withExtraRefs(GRefs(dataRefs, found.gdTypes), specialized, statements)
  # Step 3: redirect over ALL statements, including the new ones — a
  # specialized statement from the PREVIOUS iteration may carry un-redirected
  # refs that only became concrete after substitution.
  let redirected = replaceConcreteReferences(concat(statements, specialized),
                                             indexRefs(refs))
  # Step 4: rebuild _enum_spec for EVERY known specialized enum, not just this
  # iteration's — cross-enum field references update as redirects land.
  let allSpecEnums2 = addNamesAll(enumNamesOf(specialized),
                                  allSpecEnums)
  let finalized = isEmpty(allSpecEnums2)
    ? redirected
    : finalizeSpecializedEnumSpecs(redirected, allSpecEnums2)
  if isEmpty(specialized)
    ret GIter(pruneUnusedGenerics(finalized), Set())
  ret monoRound(finalized, round2 + 1, allSpecEnums2, seenCons2, seenMono2)

fun withExtraRefs(refs: GRefs, specialized: List<PStmt>,
                  statements: List<PStmt>)
  let extra = findConcreteInstantiations(specialized)
  let existing = allStmtNames(statements, List())
  ret GRefs(addRefsAll(existingOnly(extra.gdData, existing,
                                          List()),
                       refs.gdData),
            addRefsAll(existingOnly(extra.gdTypes, existing,
                                          List()),
                       refs.gdTypes))

fun existingOnly(rs: List<GRef>, existing: List<String>, acc: List<GRef>) =>
  fold(rs, acc, (a, x) => contains(existing, refKey(x)) ? append(a, x) : a)

fun allStmtNames(ss: List<PStmt>, acc: List<String>) =>
  fold(ss, acc, (a, x) => append(a, stmtName(x)))

fun enumNamesOf(ss): List<String> => enumNamesLoop(ss, List())

fun enumNamesLoop(ss: List<PStmt>, acc: List<String>) =>
  fold(ss, acc, enumNamesLoopStep)

fun enumNamesLoopStep(a: List<String>, x: PStmt) => match(x)
  (e2: PsEnum) => append(a, e2.eName)
  (o: PStmt) => a

# Loop exhausted: blame the generics with runaway per-name instantiation
# counts, at their declarations; else one generic message.
fun monoErrors(statements, seenMono: List<GRef>)
  let offenders = sort(offenderNames(seenMono))
  ret isEmpty(offenders)
    ? GIter(statements, add(Set(),PErr(PLine("$generics", 1, 1),
        "generic instantiation did not stabilise after 64 rounds — likely polymorphic recursion through mutually recursive generics; recursive calls must use the functions' own type parameters")))
    : GIter(statements, offenderErrs(offenders, statements, seenMono,
                                     Set()))

fun offenderNames(seenMono: List<GRef>) =>
  fold(seenMono, Set<String>(),
       (out, x) => contains(out, x.grName) || countRefsFor(seenMono, x.grName, 0) < 32   # _MAX_MONO_ROUNDS // 2
         ? out
         : add(out, x.grName))

# A Set, not a deduped list: monoErrors sorts this immediately, so any order
# built here is discarded one call later. Keeping a builder as well would be
# three orderings imposed on data that has none — first-seen, thrown away,
# then re-imposed by sort.
fun countRefsFor(rs: List<GRef>, name: String, n) =>
  fold(rs, n, (a, x) => x.grName == name ? a + 1 : a)

fun offenderErrs(ns: List<String>, statements: List<PStmt>, seenMono: List<GRef>, acc: Set<PErr>) =>
  fold(ns, acc, (a, x) => add(a, PErr(offenderLine(statements, x),
                       offenderMsg(x,
                                   countRefsFor(seenMono, x,
                                                0)))))

fun offenderMsg(name, count: Int)
  ret "polymorphic recursion: `" + bareOfUnique(name) + "` is instantiated at ever-deeper type arguments (" + show(count) + " distinct instantiations without stabilising) — a recursive call must use the function's own type parameters, not a compound of them (e.g. Wrap<T>)"

# Python's by_name dict: later statements with the same name overwrite, so the
# LAST match wins.
fun offenderLine(ss, name): PLine => offLineLoop(ss, name, PLine("$generics", 1, 1))

fun offLineLoop(ss: List<PStmt>, name, best: PLine) =>
  fold(ss, best, (a, x) => stmtName(x) == name ? stmtLine(x) : a)

# ── trait-reference resolution ───────────────────────────────────────────────
# Python: __resolve_trait_references. After monomorphisation, a TRAIT-scope
# function reference is rewritten as DotExpression(provider, method) on the
# concrete [trait] instance whose witness class implements the required trait,
# so codegen sees a normal method call.

fun resolveTraitReferences(statements: List<PStmt>): List<PStmt>
  let root = rootResolver(statements)
  let traits = traitLets(root)
  ret walkStmts(statements, root, false,
                Walk<Bool>((s, sc, x) => (s = s, r = rtrExpr(x, root, sc, traits)),
                           wkNoStmt<Bool>, wkNoSpec<Bool>)).x

# redirect: only a name is redirected. `sc` is the scope at the name — the
# finds read through it, as Python's callback reads through its `r`; the
# providers are judged against the ROOT, as Python's implements_trait is.
fun rtrExpr(x: PExpr, root: Resolver, sc: Resolver, traits: List<PStmt>): PExpr|None => match(x)
  (nm: PeName) => redirectName(nm, root, sc, traits)
  (o: PExpr)   => None

fun redirectName(nm: PeName, root: Resolver, sc: Resolver, traits: List<PStmt>): PExpr|None =>
  match(traitSpecFor(nm, sc))
    (ts: SClass) => redirectWith(nm, ts, root, sc, traits)
    ()           => None

fun traitSpecFor(nm: PeName, r) => match(nm.penTrait)
  (c: SClass) => c
  (o: Spec)   => None
  ()          => derivedTraitScope(nm, r)

fun derivedTraitScope(nm: PeName, r) => match(soleItem(findData(r, nm.refName)))
  (f: Found) => match(f.fScope)
    (t2: ScTrait) => match(f.fTraitScope)
      (c: SClass) => c
      ()          => None
    (o2: RScope)  => None
  ()         => None

fun redirectWith(nm: PeName, ts: SClass, root: Resolver, sc: Resolver,
                 traits: List<PStmt>): PExpr|None
  ret match(soleLetOf(traitProviders(traits, ts, root, List())))
    (provider: PsLet) => redirectVia(nm, ts, provider, sc)
    ()                => None

# Provider count taken on the finding walk itself (no-length ruling) — the
# ambiguity diagnostic needs the number; soleLetOf keeps the list variant.
fun traitProviderCount(ls: List<PStmt>, ts: SClass, r, n) =>
  fold(ls, n, (a, x) => traitProviderCountStep(a, x, ts, r))

fun traitProviderCountStep(a: Int, x: PStmt, ts: SClass, r) => match(x)
  (let2: PsLet) => implementsTrait(let2, ts, r)
    ? (a + 1)
    : a
  (o: PStmt) => a

fun traitProviders(ls: List<PStmt>, ts: SClass, r, acc: List<PsLet>) =>
  fold(ls, acc, (a, x) => traitProvidersStep(a, x, ts, r))

fun traitProvidersStep(a: List<PsLet>, x: PStmt, ts: SClass, r) => match(x)
  (let2: PsLet) => implementsTrait(let2, ts, r)
    ? append(a, let2)
    : a
  (o: PStmt) => a

fun implementsTrait(tr: PsLet, ts: SClass, r) => match(tr.lType)
  (dc: SClass) => match(soleItem(findType(r, dc.scName)))
    (f: Found) => match(f.fStmt)
      (cls: PsClass) => match(cls.cAllParents)
        (ps: List<Spec>) => anyParentMatches(ps, ts,
                                             mangledSpecList(ts.scParams,
                                                             List()))
        ()               => false
      (o: PStmt)     => false
    ()         => false
  ()           => false

# A monomorphised witness declares its parents with MANGLED inner names
# (Sized<List$generic$Int>) while the demanded scope is structural
# (Sized<List<Int>>): compare against both spellings.
fun mangledSpecList(ss: List<Spec>, acc: List<Spec>) =>
  fold(ss, acc, (a, x) => append(a, mangledFromSpec(x)))

fun anyParentMatches(ps: List<Spec>, ts: SClass,
                            mangled: List<Spec>) => any(ps, (x) => anyParentMatchesStep(x, ts, mangled))

fun anyParentMatchesStep(x: Spec, ts: SClass, mangled: List<Spec>) => match(x)
  (pc: SClass) => pc.scName == ts.scName
            && (isEmpty(ts.scParams)
                || eqSpecs(pc.scParams, ts.scParams)
                || eqSpecs(pc.scParams, mangled))
  (o: Spec) => false

fun soleLetOf(ls: List<PsLet>) => sizeAtLeast(ls, 2) ? None : head(ls)

fun soleFoundOf(fs: List<Found>) => sizeAtLeast(fs, 2) ? None : head(fs)

fun redirectVia(nm: PeName, ts: SClass, provider: PsLet,
                r): PExpr|None => match(provider.lType)
  (pc: SClass) => match(soleItem(findType(r, pc.scName)))
    (f: Found) => match(f.fStmt)
      (cls: PsClass) => redirectMethod(nm, ts, provider, cls, r)
      (o: PStmt)     => None
    ()         => None
  ()           => None

fun redirectMethod(nm: PeName, ts: SClass, provider: PsLet, cls: PsClass,
                   r): PExpr|None
  let mds0 = classFindData(cls, r, simpleName(nm.refName))
  if isEmpty(mds0)
    ret None
  let many = match(soleFoundOf(mds0))
    (one: Found) => false
    ()           => true
  let mds = many ? disambiguateMethods(mds0, nm, ts, r) : mds0
  ret match(soleFoundOf(mds))
    (md: Found) => PeDot(PeName(provider.lName, List(), nm.penLine,
                                None),
                         md.fName, nm.penLine)
    ()          => None

# Multiple overloads — disambiguate by comparing the concrete type of the
# interface method (looked up by exact hash) against the class methods.
fun disambiguateMethods(mds, nm: PeName, ts: SClass,
                        r) => match(soleItem(findType(r, ts.scName)))
  (f: Found) => match(f.fStmt)
    (icls: PsClass) => disambiguateVia(mds, nm, ts, icls, r)
    (o: PStmt)      => mds
  ()         => mds

fun disambiguateVia(mds, nm: PeName, ts: SClass, icls: PsClass,
                    r) => match(soleFoundOf(classFindData(icls, r, nm.refName)))
  (imd: Found) => match(imd.fStmt)
    (ifn: PsFun) => disambiguateByType(mds, ts, icls, ifn, r)
    (o: PStmt)   => mds
  ()           => mds

fun disambiguateByType(mds, ts: SClass, icls: PsClass,
                       ifn: PsFun, r)
  let ifaceType0 = funType(ifn)
  let ifaceType = !isEmpty(icls.cGens) && !isEmpty(ts.scParams)
    ? substitute(ifaceType0, paramMapping(icls.cGens, ts.scParams))
    : ifaceType0
  let matching = matchingByType(mds, ifaceType, r, List())
  let single = match(soleFoundOf(matching))
    (one: Found) => true
    ()           => false
  ret single ? matching : mds

fun matchingByType(ms: List<Found>, ifaceType: Spec, r, acc: List<Found>) =>
  fold(ms, acc, (a, x) => triTrue(assignableEq(r, ifaceType, stmtType(x.fStmt))) ? append(a, x) : a)

# ── refresh embedded EnumSpec.all_fields ─────────────────────────────────────
# Python: __refresh_enum_spec_all_fields. Sync every embedded copy to the
# canonical _enum_spec. Python detects staleness by tuple IDENTITY (eq
# excludes all_fields); the port compares CONTENT one level deep — each pass
# propagates one extra level through the canonical dependency graph, exactly
# as Python's identity walk does, capped at 16 passes.

# Root name -> its canonical enum spec. A Dict: the only question asked is
# canonLookup, which walked both lists in lockstep, and the "already have this
# root" test was a second scan of the same data.
class [final] Canon(cnMap: Dict<String, SEnum>)
class [final] CanonPass(cpCanon: Canon, cpChanged: Bool)
class [final] FieldsFix(ffFields: List<SField>, ffChanged: Bool)

fun refreshEnumSpecAllFields(statements: List<PStmt>)
  let canon0 = collectCanonical(statements,
                                Canon(Dict()))
  if isEmpty(canon0.cnMap)
    ret statements
  ret walkStmts(statements, emptyResolverGlobal, false,
                Walk<Bool>(wkNoExpr<Bool>, wkNoStmt<Bool>,
                           (s, _r, sp) => (s = s, r = rfrSpec(sp, canon0)))).x

# Root enums only (skip nested variant stmts); first spec per root wins.
fun collectCanonical(ss: List<PStmt>, acc) =>
  fold(ss, acc, collectCanonicalStep)

fun collectCanonicalStep(a: Canon, x: PStmt) => match(x)
  (e2: PsEnum) => isRootEnum(e2)
    ? canonAdd(a, e2)
    : a
  (o: PStmt) => a

fun canonAdd(acc, e2: PsEnum) => match(e2.eSpec)
  (sp: Spec) => match(sp)
    # FIRST spec for a root wins, as the scan-then-append did.
    (es: SEnum) => contains(acc.cnMap, es.seRoot)
      ? acc
      : Canon(put(acc.cnMap, es.seRoot, es))
    (o: Spec)   => acc
  ()         => acc

fun canonLookup(c: Canon, root: String) => get(c.cnMap, root)

fun fieldsStale(fe: SEnum, spec: SEnum) => !eqStrs(fe.seAllLeaves, spec.seAllLeaves)

fun canonRefreshed(fe: SEnum, spec: SEnum)
  ret SEnum(fe.seRoot, fe.seValidLeaves, spec.seAllLeaves, fe.seParams,
            fe.seLine, fe.sePath)

# An embedded enum spec whose leaf list is stale against its root's
# canonical spec takes the canonical leaves.
fun rfrSpec(sp: Spec, c: Canon): Spec|None => match(sp)
  (e2: SEnum) => match(canonLookup(c, e2.seRoot))
    (spec: SEnum) => fieldsStale(e2, spec) ? canonRefreshed(e2, spec) : None
    ()            => None
  (o: Spec) => None

# ── unresolved-generic-call guard ────────────────────────────────────────────
# Python: report_unresolved_generic_calls. A reference from NON-generic code
# to a still-generic function means call-site inference could not ground its
# type arguments — report at the use site instead of crashing in codegen.

# ── undischarged trait constraints ───────────────────────────────────────────
# Port of generics.py::report_undischarged_traits. The counterpart of
# reportUnresolvedGenericCalls for TRAIT scope: a reference that still resolves
# to TRAIT scope after resolveTraitReferences has run found no single provider
# for its constraint. Codegen has no representation for that and dies naming
# the trait METHOD rather than the constraint that went unsatisfied.
#
# Runs AFTER the redirect, so anything legitimately rewritten is already gone
# and what remains is exactly what would have crashed. Surviving generic
# templates are skipped, as reportUnresolvedGenericCalls already does.

class [final] UtAcc(utSeen: Set<String>, utErrs: Set<PErr>)

fun reportUndischargedTraits(statements: List<PStmt>): Set<PErr>
  let root = rootResolver(statements)
  let traits = traitLets(root)
  let w = Walk<UtAcc>((a, sc, x) => (s = utExprCb(a, x, sc, root, traits), r = None),
                      wkNoStmt<UtAcc>, wkNoSpec<UtAcc>)
  # A surviving generic template is skipped: its TRAIT refs are legitimately unbound.
  ret fold(statements, UtAcc(Set(), Set()),
           (acc, st) => isEmpty(stmtGens(st)) ? walkStmt(st, root, acc, w).s : acc).utErrs

# The trait scope is read through the scope at the name; the providers are
# judged against the root, as Python's scan does.
fun utExprCb(a: UtAcc, x: PExpr, sc: Resolver, root: Resolver, traits: List<PStmt>): UtAcc => match(x)
  (nm: PeName) => match(traitSpecFor(nm, sc))
    (ts: SClass) => utCheck(a, nm, ts, root, traits)
    ()           => a
  (o: PExpr)   => a

# One error per CONSTRAINT, not per reference: a single missing instance
# otherwise reports once per `==`/`hashOf` call inside the monomorphised
# container.
fun utCheck(a, nm: PeName, ts: SClass, r,
            traits: List<PStmt>)
  let n = traitProviderCount(traits, ts, r, 0)
  if n == 1
    ret a
  let shown = traitDisplay(ts)
  if contains(a.utSeen, shown)
    ret a
  ret UtAcc(add(a.utSeen, shown),
            add(a.utErrs, PErr(nm.penLine, utMessage(shown, nm, n))))

fun utMessage(shown, nm: PeName, n)
  let method = bareOfUnique(nm.refName)
  ret n == 0
    ? "no instance of " + shown + " (needed by `" + method + "`)"
    : String(n) + " instances of " + shown + " are in scope (needed by `"
      + method + "`) — the choice is ambiguous"

# `BasicEquality<(bigint,bigint)>` rather than the raw mangled name:
# post-monomorphisation a trait's arguments live in its MANGLED name, not in
# its params. No `$generic$` means it was never monomorphised — show the bare
# name only, exactly as Python does.
fun traitDisplay(ts: SClass)
  let gx = indexOf(ts.scName, "$generic$", 0)
  ret gx < 0
    ? bareOfUnique(ts.scName)
    : bareOfUnique(slice(ts.scName, 0, gx)) + "<"
      + slice(ts.scName, gx + 9, length(ts.scName)) + ">"


fun reportUnresolvedGenericCalls(statements: List<PStmt>): Set<PErr>
  let root = rootResolver(statements)
  let w = Walk<Set<PErr>>((acc, sc, x) => (s = rugExpr(x, sc, acc), r = None),
                          wkNoStmt<Set<PErr>>, wkNoSpec<Set<PErr>>)
  # A surviving generic template's body is legitimately generic.
  ret fold(statements, Set<PErr>(), (acc, st) => isEmpty(stmtGens(st)) ? walkStmt(st, root, acc, w).s : acc)

fun rugExpr(x: PExpr, sc: Resolver, acc: Set<PErr>): Set<PErr> => match(x)
  (nm: PeName) => rugName(nm, sc, acc)
  (o: PExpr)   => acc

fun rugName(nm: PeName, r, acc): Set<PErr> => rugUnresolved(nm, r)
  ? add(acc, PErr(nm.penLine, rugMsg(bareOfUnique(nm.refName))))
  : acc

fun rugMsg(name)
  ret "cannot infer the type arguments of generic function `" + name + "` here — write them explicitly: " + name + "<...>(...)"

fun rugUnresolved(nm: PeName, r)
  let bag = findData(r, nm.refName)
  ret match(soleItem(bag))
    (f: Found) => match(f.fStmt)
      # The template survived pruning: the use is fine only when it carries a
      # full, ground set of type arguments.
      (fn: PsFun) => !isEmpty(fn.fGens)
                     && (!sameLen(nm.refTypeParams,
                                    fn.fGens)
                         || anyFreePlaceholders(nm.refTypeParams, r))
      (o: PStmt)  => false
    # Dangling: the name WAS resolved (it carries the @-hash) but its generic
    # template has been pruned, and the use still holds unbound placeholders.
    ()         => isEmpty(bag.bItems)
                  && findByte(nm.refName, '@', 0) >= 0
                  && !isEmpty(nm.refTypeParams)
                  && anyFreePlaceholders(nm.refTypeParams, r)

fun anyFreePlaceholders(ts: List<Spec>, r) => any(ts, (x) => hasFreePlaceholders(x, r))

# ── entry point ──────────────────────────────────────────────────────────────
# Python: convert_generic_to_concrete. On errors the ORIGINAL statements come
# back with them; otherwise iterate → refresh → resolve traits.

fun convertGenericToConcrete(statements)
  let it = convertGenericsIterative(statements)
  if !isEmpty(it.giErrs)
    ret GIter(statements, it.giErrs)
  ret GIter(resolveTraitReferences(refreshEnumSpecAllFields(it.giStmts)),
            Set())
