# bootstrap/lazy_thunks.yafl — lazy thunk machinery, ported from
# lowering/lazy_thunks.py: per unique IR value-type T, the stub class
# Lazy$<mangle>, waiter task subtype, lazy_fetch$/lazy_finish$/lazy_drain$
# functions and the [future] worker runner. See the Python module docstring
# for the stub layout and the fetch/drain protocols — the op sequences below
# are 1:1 with it.
#
# DELIBERATE DEVIATION (pure port): Python reverses Lazy$<mangle> class names
# back to IR types through the mutable _STRUCT_REGISTRY (sha1 isn't
# invertible). Here the DRIVER carries (mangle → CgType) pairs from the
# creation sites (genLazyAlloc / letLazyGlobal — both know the type), and
# lazyMachinery below is a pure function of the type; ensure-idempotence is
# the driver's name-keyed dedupe. Output is byte-identical; only the
# plumbing differs.
namespace Bootstrap::Lower::Ast

import System

import Bootstrap::Codegen
import Bootstrap::Ir
import Bootstrap::StdlibCandidates



# ── naming (stubClassName / futureRunnerName live in generate_stmt.yafl,
#    fetchFunctionName in generate_expr.yafl) ────────────────────────────────

fun finisherFunctionName(t2) => "lazy_finish$" + irMangle(t2)

fun drainFunctionName(t2) => "lazy_drain$" + irMangle(t2)

# The task subtype every [lazy] waiter is an instance of — shared with
# async_lower's naming so reads of a completed task's `result` cast to the
# actual emitted struct. Keyed by the value type itself, exactly as
# async_lower names the subtype a function returning `t2` completes; the
# empty value has no result to hold, so its waiter is the base task.
fun waiterSubtypeName(t2) => match(taskSubtypeName(t2))
  (name: String) => name
  ()              => "task"

# ── shared helpers ───────────────────────────────────────────────────────────

fun svLazyDiscard() => RpStackVar(CgDataPointer(), "$sv_lazy_discard")

fun lazyRuntimeCall1(name, argName, argVal): Op
  ret OpMove(svLazyDiscard(),
             RpRuntimeInvoke(name, RpNewStruct(list1(RpNamedValue(argName, argVal))), CgDataPointer()),
             true, List())

# The stub's value store. A global's stub is a declared root, scanned once at
# cycle open, so the store publishes what it wrote: a thread may drop the
# value from its stack before its take (codegen/param.py ObjectField.root).
fun storeValue(valueF: RpObjectField, value): Op
  ret OpMove(with valueF(root = true), value, false, List())

# ── stub class ───────────────────────────────────────────────────────────────

fun makeStubObject(valueType)
  ret CgObject(stubClassName(valueType), List(), List(),
               CgImmediateStruct(list4(CgField("type", CgDataPointer()),
                                       CgField("flag", CgDataPointer()),
                                       CgField("closure", CgFuncPointer(false)),
                                       CgField("value", valueType))),
               None, "lazy stub for " + irMangle(valueType),
               false, true, 0)   # is_mutable: flag/value memoised after construction

# ── drain: walk the waiter chain, write value into each result, complete ────

# Write `value` into a waiter's `result` slot — none for the empty value,
# whose waiter is the base task.
fun lazyStoreWaiterResult(waiter, valueType, value): List<Op>
  if isUnit(valueType)
    ret List()
  ret list1<Op>(OpMove(RpObjectField(valueType, waiter, waiterSubtypeName(valueType), "result", None, false, false),
                       value, false, List()))

fun makeDrainFunction(valueType): CgFunction
  let flagField = RpStackVar(CgDataPointer(), "flag_field")
  let value = RpStackVar(valueType, "value")
  let svHead = RpStackVar(CgDataPointer(), "$sv_head")
  let svNext = RpStackVar(CgDataPointer(), "$sv_next")
  let head = list3<Op>(
      OpMove(svHead, RpRuntimeInvoke("lazy_chain_swap_sentinel",
                                     RpNewStruct(list1(RpNamedValue("flag", flagField))),
                                     CgDataPointer()), false, List()),
      OpLabel("$loop", List()),
      OpJumpIf("$done", svHead, true, List()))
  let tail2 = list5<Op>(
      OpMove(svNext, RpRuntimeInvoke("lazy_chain_step",
                                     RpNewStruct(list1(RpNamedValue("head", svHead))),
                                     CgDataPointer()), false, List()),
      lazyRuntimeCall1("task_complete_deferred", "self", svHead),
      OpMove(svHead, svNext, false, List()),
      OpJump("$loop", List()),
      OpLabel("$done", List()))
  # head.result = value — per-IR-type write (GC_WRITE_BARRIER via field store)
  let ops = concat(concat(head, lazyStoreWaiterResult(svHead, valueType, value)), tail2)
  ret CgFunction(drainFunctionName(valueType),
                 CgStruct(list3(CgField("this", CgDataPointer()),
                                CgField("flag_field", CgDataPointer()),
                                CgField("value", valueType))),
                 CgDataPointer(),
                 CgStruct(list3(CgField("$sv_head", CgDataPointer()),
                                CgField("$sv_next", CgDataPointer()),
                                CgField("$sv_lazy_discard", CgDataPointer()))),
                 build(push(pushAll(seqBuilder(), ops), OpReturn(RpNullPointer(), List()))),
                 "lazy chain drain for " + irMangle(valueType),
                 None, false, false, true, false)

# `this`-less call to the per-IR-type drain (drain ignores its this).
fun emitDrainCall(valueType, flagAddr, value): Op
  ret OpCall(RpGlobalFunction(drainFunctionName(valueType), None, false, None, false, false),
             RpNewStruct(list2(RpNamedValue("flag_field", flagAddr),
                               RpNamedValue("value", value))),
             None, false, false, CgDataPointer(), List())

# ── fetch: the force protocol (bypass_async, hand-built IS_TASK branching) ──

fun makeFetchFunction(valueType): CgFunction
  let cls = stubClassName(valueType)
  let waiterTy = waiterSubtypeName(valueType)
  let wrapped = wrapReturnType(valueType)
  let this = RpStackVar(CgDataPointer(), "this")
  let waiter = RpStackVar(CgDataPointer(), "waiter")
  let status = RpStackVar(CgInt(32), "status")
  let flagAddr = RpStackVar(CgDataPointer(), "flag_addr")
  let closure = RpStackVar(CgFuncPointer(false), "closure")
  let rwrapped = RpStackVar(wrapped, "result_wrapped")
  let value = RpStackVar(valueType, "value")
  let flagF = RpObjectField(CgDataPointer(), this, cls, "flag", None, false, false)
  let closureF = RpObjectField(CgFuncPointer(false), this, cls, "closure", None, false, false)
  let valueF = RpObjectField(valueType, this, cls, "value", None, false, false)
  let isComplete = RpRuntimeInvoke("lazy_global_init_complete",
                                   RpNewStruct(list1(RpNamedValue("p", flagF))), CgInt(32))
  ret CgFunction(fetchFunctionName(valueType),
                 CgStruct(list1(CgField("this", CgDataPointer()))),
                 wrapped,
                 # Stack layout, in declaration order.
                 CgStruct(build(push(push(
                     builderFrom(list5(CgField("waiter", CgDataPointer()),
                                       CgField("status", CgInt(32)),
                                       CgField("flag_addr", CgDataPointer()),
                                       CgField("closure", CgFuncPointer(false)),
                                       CgField("result_wrapped", wrapped))),
                     CgField("value", valueType)),
                     CgField("$sv_lazy_discard", CgDataPointer())))),
                 cgOpsOf(fetchOps(valueType, cls, waiterTy, wrapped, this, waiter, status, flagAddr,
                          closure, rwrapped, value, flagF, closureF, valueF, isComplete)),
                 "lazy fetch for " + irMangle(valueType),
                 None, false, false, true, false)

fun fetchOps(valueType: CgType, cls: String, waiterTy: String, wrapped: CgType,
             this: RParam, waiter: RParam, status: RParam, flagAddr: RParam,
             closure: RParam, rwrapped: RParam, value: RParam,
             flagF: RParam, closureF: RParam, valueF: RpObjectField, isComplete: RParam): List<Op>
  let finisher = finisherFunctionName(valueType)
  let head = list5<Op>(
      OpJumpIf("$slow", isComplete, true, List()),
      OpReturn(wrapValue(valueF, wrapped), List()),
      OpLabel("$slow", List()),
      OpNewObject(waiterTy, waiter, None, false, List()),
      lazyRuntimeCall1("task_init", "self", waiter))
  let enqueue = list5<Op>(
      OpMove(flagAddr, RpPointerTo(flagF), false, List()),
      OpMove(status, RpRuntimeInvoke("lazy_thunk_enqueue",
                                     RpNewStruct(list2(RpNamedValue("flag", flagAddr),
                                                       RpNamedValue("waiter", waiter))),
                                     CgInt(32)), false, List()),
      OpJumpIf("$already_done", RpIntEqConst(status, 2), false, List()),
      OpJumpIf("$return_waiter", RpIntEqConst(status, 0), false, List()),
      # status == 1: won init race
      OpMove(closure, closureF, false, List()))
  # Sync init: unwrap, store, clear closure, drain
  let syncInit = concat(list4(
      OpCall(closure, RpNewStruct(List()), rwrapped, false, false, None, List()),
      OpJumpIf("$async_init",
               RpRuntimeInvoke("UNLIKELY",
                               RpNewStruct(list1(RpNamedValue("x", isTaskParam(rwrapped, wrapped)))),
                               CgInt(32)), false, List()),
      OpMove(value, unwrapValue(rwrapped, valueType), false, List()),
      storeValue(valueF, value)),
    list1(OpMove(closureF, RpZeroOf(CgFuncPointer(false)), false, List())))
  let asyncTail = list4(
      emitDrainCall(valueType, RpPointerTo(flagF), value),
      OpReturn(wrapValue(value, wrapped), List()),
      OpLabel("$async_init", List()),
      OpMove(svLazyDiscard(),
             RpRuntimeInvoke("task_on_complete",
                             RpNewStruct(list2(
                               RpNamedValue("task", RpRuntimeInvoke("TASK_UNTAG",
                                              RpNewStruct(list1(RpNamedValue("p", taskPtrFrom(rwrapped, wrapped)))),
                                              CgDataPointer())),
                               RpNamedValue("cb", RpGlobalFunction(finisher, this, false, None, false, false)))),
                             CgDataPointer()),
             true, List()))
  let tail = list5<Op>(
      OpReturn(RpTagTask(waiter, wrapped), List()),
      OpLabel("$already_done", List()),
      OpReturn(wrapValue(valueF, wrapped), List()),
      OpLabel("$return_waiter", List()),
      OpReturn(RpTagTask(waiter, wrapped), List()))
  ret concat(concat(concat(concat(head, enqueue), syncInit), asyncTail), tail)

# ── [future] worker runner ───────────────────────────────────────────────────

# Fire signature (this=stub, task) -> object_t*, matching _task_fire exactly —
# the fetch must NOT be fired directly (its wrapped(T) result can be a hidden
# sret and would misread the fire's two-pointer frame). Runs the fetch and
# discards the result; either race outcome leaves the protocol consistent.
fun makeFutureRunnerFunction(valueType)
  let wrapped = wrapReturnType(valueType)
  let this = RpStackVar(CgDataPointer(), "this")
  let rwrapped = RpStackVar(wrapped, "result_wrapped")
  ret CgFunction(futureRunnerName(valueType),
                 CgStruct(list2(CgField("this", CgDataPointer()),
                                CgField("$task", CgDataPointer()))),
                 CgDataPointer(),
                 CgStruct(list1(CgField("result_wrapped", wrapped))),
                 cgOpsOf(list2(OpCall(RpGlobalFunction(fetchFunctionName(valueType), this, false, None, false, false),
                              RpNewStruct(List()), rwrapped, false, false, None, List()),
                       OpReturn(RpNullPointer(), List()))),
                 "[future] worker runner for " + irMangle(valueType),
                 None, false, false, true, false)

# ── finisher (async-completion callback) ─────────────────────────────────────

fun makeFinisherFunction(valueType): CgFunction
  let cls = stubClassName(valueType)
  let waiterTy = waiterSubtypeName(valueType)
  let this = RpStackVar(CgDataPointer(), "this")
  let completed = RpStackVar(CgDataPointer(), "completed")
  let value = RpStackVar(valueType, "value")
  let closureF = RpObjectField(CgFuncPointer(false), this, cls, "closure", None, false, false)
  let valueF = RpObjectField(valueType, this, cls, "value", None, false, false)
  let flagF = RpObjectField(CgDataPointer(), this, cls, "flag", None, false, false)
  let completedResult = isUnit(valueType)
    ? RpZeroOf(valueType)
    : RpObjectField(valueType, completed, waiterTy, "result", None, false, false)
  ret CgFunction(finisherFunctionName(valueType),
                 CgStruct(list2(CgField("this", CgDataPointer()),
                                CgField("completed", CgDataPointer()))),
                 CgDataPointer(),
                 CgStruct(list1(CgField("value", valueType))),
                 cgOpsOf(concat(list2(OpMove(value, completedResult, false, List()),
                                     storeValue(valueF, value)),
                        list3(OpMove(closureF, RpZeroOf(CgFuncPointer(false)), false, List()),
                              emitDrainCall(valueType, RpPointerTo(flagF), value),
                              OpReturn(RpNullPointer(), List())))),
                 "lazy fetch async-finisher for " + irMangle(valueType),
                 None, true, false, true, false)

# ── the full per-type machinery (pure ensure_lazy_machinery) ─────────────────

class [final] LazyMachineryOut(lmObjects: List<CgObject>, lmFunctions: List<CgFunction>)

# The stub class, canonical task subtype and the four functions for one value
# type. The driver dedupes by name against what async_lower will later
# register (same subtype names ⇒ same emitted structs, no cross-type punning)
# and adds the foreign `task` object once.
fun lazyMachinery(valueType)
  ret LazyMachineryOut(
        list2(makeTaskSubtypeObject(waiterSubtypeName(valueType), valueType),
              makeStubObject(valueType)),
        list4(makeFetchFunction(valueType),
              makeFinisherFunction(valueType),
              makeDrainFunction(valueType),
              makeFutureRunnerFunction(valueType)))
