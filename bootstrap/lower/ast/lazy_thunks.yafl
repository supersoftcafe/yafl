# bootstrap/lazy_thunks.yafl — lazy thunk machinery, ported from
# lowering/lazy_thunks.py: per unique IR value-type T, the stub class
# Lazy$<mangle>, the lazy_fetch$ function and the [future] worker runner, plus
# the runtime's two gate functions. See the Python module docstring for the
# stub layout and the fetch protocol — the op sequences below are 1:1 with it.
#
# DELIBERATE DEVIATION (pure port): Python reverses Lazy$<mangle> class names
# back to IR types through the mutable _STRUCT_REGISTRY (sha1 isn't
# invertible). Here the DRIVER carries (mangle → CgType) pairs from the
# creation sites (genLazyAlloc / letLazyGlobal — both know the type), and
# lazyMachinery below is a pure function of the type; ensure-idempotence is
# the driver's name-keyed dedupe. Output is byte-identical; only the
# plumbing differs.
namespace Bootstrap::Lower::Ast

import System

import Bootstrap::Codegen
import Bootstrap::Ir
import Bootstrap::StdlibCandidates



# ── naming (stubClassName / futureRunnerName live in generate_stmt.yafl,
#    fetchFunctionName in generate_expr.yafl) ────────────────────────────────

# ── the gate ─────────────────────────────────────────────────────────────────

# The runtime's gate around a stub's initialiser (yafllib lazy.c), declared
# as a [foreign] function is: it takes the flag's address and its result is
# None. lazy_acquire may suspend; lazy_release never does.
fun lazyAcquire() => "lazy_acquire"

fun lazyRelease() => "lazy_release"

fun cgNone() => CgStruct(List())

fun makeGateFunction(symbol: String, sync: Bool): CgFunction
  ret CgFunction(symbol,
                 CgStruct(list2(CgField("this", CgDataPointer()), CgField("flag", CgDataPointer()))),
                 cgNone(), CgStruct(List()), cgOpsOf(List()), symbol, symbol,
                 sync, false, false, false)

fun gateCall(symbol: String, sync: Bool, flagAddr: RParam, register: RParam): Op
  ret OpCall(RpGlobalFunction(symbol, None, false, symbol, true, sync),
             RpNewStruct(list1(RpNamedValue("flag", flagAddr))),
             register, false, true, None, Dict())

# ── stub class ───────────────────────────────────────────────────────────────

fun makeStubObject(valueType)
  ret CgObject(stubClassName(valueType), List(), List(),
               CgImmediateStruct(list4(CgField("type", CgDataPointer()),
                                       CgField("flag", CgDataPointer()),
                                       CgField("closure", CgFuncPointer(false)),
                                       CgField("value", valueType))),
               None, "lazy stub for " + irMangle(valueType),
               false, true, 0)   # is_mutable: flag/value memoised after construction

# ── fetch: ordinary pre-async code around the gate ──────────────────────────

fun makeFetchFunction(valueType): CgFunction
  let cls = stubClassName(valueType)
  let this = RpStackVar(CgDataPointer(), "this")
  let closure = RpStackVar(CgFuncPointer(false), "closure")
  let value = RpStackVar(valueType, "value")
  let acquired = RpStackVar(cgNone(), "acquired")
  let released = RpStackVar(cgNone(), "released")
  let flagF = RpObjectField(CgDataPointer(), this, cls, "flag", None, false, false)
  let closureF = RpObjectField(CgFuncPointer(false), this, cls, "closure", None, false, false)
  let valueF = RpObjectField(valueType, this, cls, "value", None, false, false)
  let isComplete = RpRuntimeInvoke("lazy_global_init_complete",
                                   RpNewStruct(list1(RpNamedValue("p", flagF))), CgInt(32))
  let gate = list3<Op>(
      OpJumpIf("$done", isComplete, false, Dict()),
      gateCall(lazyAcquire(), false, RpPointerTo(flagF), acquired),
      # Complete now: another caller held the gate, and this one waited.
      OpJumpIf("$done", isComplete, false, Dict()))
  let init = list5<Op>(
      OpMove(closure, closureF, false, Dict()),
      OpCall(closure, RpNewStruct(List()), value, false, false, None, Dict()),
      OpMove(valueF, value, false, Dict()),
      OpMove(closureF, RpZeroOf(CgFuncPointer(false)), false, Dict()),
      gateCall(lazyRelease(), true, RpPointerTo(flagF), released))
  let done = list2<Op>(OpLabel("$done", Dict()), OpReturn(valueF, Dict()))
  ret CgFunction(fetchFunctionName(valueType),
                 CgStruct(list1(CgField("this", CgDataPointer()))),
                 valueType,
                 CgStruct(list4(CgField("closure", CgFuncPointer(false)),
                                CgField("value", valueType),
                                CgField("acquired", cgNone()),
                                CgField("released", cgNone()))),
                 cgOpsOf(concat(concat(gate, init), done)),
                 "lazy fetch for " + irMangle(valueType),
                 None, false, false, false, false)

# ── [future] worker runner ───────────────────────────────────────────────────

# Fire signature (this=stub, task) -> object_t*, matching _task_fire exactly —
# the fetch must NOT be fired directly (its wrapped(T) result can be a hidden
# sret and would misread the fire's two-pointer frame). Runs the fetch and
# discards the result; either gate outcome leaves the protocol consistent.
fun makeFutureRunnerFunction(valueType)
  let wrapped = wrapReturnType(valueType)
  let this = RpStackVar(CgDataPointer(), "this")
  let rwrapped = RpStackVar(wrapped, "result_wrapped")
  ret CgFunction(futureRunnerName(valueType),
                 CgStruct(list2(CgField("this", CgDataPointer()),
                                CgField("$task", CgDataPointer()))),
                 CgDataPointer(),
                 CgStruct(list1(CgField("result_wrapped", wrapped))),
                 cgOpsOf(list2(OpCall(RpGlobalFunction(fetchFunctionName(valueType), this, false, None, false, false),
                              RpNewStruct(List()), rwrapped, false, false, None, Dict()),
                       OpReturn(RpNullPointer(), Dict()))),
                 "[future] worker runner for " + irMangle(valueType),
                 None, false, false, true, false)

# ── the full per-type machinery (pure ensure_lazy_machinery) ─────────────────

class [final] LazyMachineryOut(lmObjects: List<CgObject>, lmFunctions: List<CgFunction>)

# The stub class and, in Python's registration order, the gate functions, the
# fetch and the runner for one value type. The driver adds each one absent.
fun lazyMachinery(valueType)
  ret LazyMachineryOut(
        list1(makeStubObject(valueType)),
        list4(makeGateFunction(lazyAcquire(), false),
              makeGateFunction(lazyRelease(), true),
              makeFetchFunction(valueType),
              makeFutureRunnerFunction(valueType)))
