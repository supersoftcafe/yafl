# bootstrap/drops.yafl — affine drop insertion, ported from lowering/drops.py.
# An unused `[linear]` binding whose type has a Drop instance in scope is
# consumed BY POLICY at scope exit: the scope's value binds to a temporary,
# a drop(x) call is appended per binding, the temporary is the result.
# The rewritten calls then resolve through an ordinary RE-CONVERGENCE, and the
# linearity checker sees plain consumption. Two granularities, WHOLE bindings
# only: (1) scope level — referenced NOWHERE, batched drop at scope exit;
# (2) path level — consumed on some control paths, drop inserted on each
# abandoning path (the non-consuming ternary/match branch, the value of an
# early `ret` that skips the consumption), mirroring the linearity checker's
# per-path exactly-once merge. Shapes outside that rule (double use, a
# reference under a lambda, nested fn or match guard) bail out unchanged and
# keep the checker's error.
namespace Bootstrap::Lower::Ast

import System
import System::Containers

import Bootstrap::Ast
import Bootstrap::Frontend
import Bootstrap::Parse
import Bootstrap::Resolve
import Bootstrap::StdlibCandidates
import Bootstrap::Types



class [final] DropsOut(dsStmts: List<PStmt>, dsChanged: Bool)
class [final] DrE(deExpr: PExpr, deChanged: Bool)
class [final] DrS(dsStmt: PStmt, dsChanged2: Bool)

fun insertDrops(statements: List<PStmt>, r)
  let insts = dropInstances(r)
  ret drTop(statements, r, insts, List(), false)

# Program order throughout this pass: statements come out where they went in,
# with drop calls spliced in. The `changed` flag rides alongside as a plain
# value — only the statement list is accumulated.
fun drTop(ss: List<PStmt>, r, insts: List<TraitInst>, acc, changed) =>
  fold(ss, (acc = acc, changed = changed), (st, x) => drTopStep(st, x, r, insts))
    |> (r2) => DropsOut(r2.acc, r2.changed)

fun drTopStep(st: (acc: List<PStmt>, changed: Bool), x: PStmt, r, insts: List<TraitInst>) =>
  drToplevel(x, r, insts)
  |> (o) => (acc = append(st.acc, o.dsStmt), changed = st.changed || o.dsChanged2)

fun drToplevel(st, r, insts: List<TraitInst>) => match(st)
  (f: PsFun)   => drFn(f, r, insts)
  (c: PsClass) => drClassMembers(c, r, insts)
  (ti: PsTraitInstance) => drInstanceMembers(ti, r, insts)
  (o: PStmt)   => DrS(st, false)

fun drInstanceMembers(ti: PsTraitInstance, r,
                      insts: List<TraitInst>)
  let out = drMembers(ti.tiMembers, r, insts, List(), false)
  ret out.dmChanged
    ? DrS(PsTraitInstance(ti.tiName, ti.tiAttrs, ti.tiAmbient, ti.tiGens,
                          ti.tiPattern,
                          ti.tiWheres, out.dmStmts, ti.pstiLine,
                          ti.tiImports),
          true)
    : DrS(ti, false)

# Only member FUNCTIONS are rewritten (Python: __rewrite_fn on
# FunctionStatements, everything else passes through).
class [final] DrMembers(dmStmts: List<PStmt>, dmChanged: Bool)

fun drClassMembers(c: PsClass, r, insts: List<TraitInst>)
  let out = drMembers(c.cMembers, r, insts, List(), false)
  ret out.dmChanged
    ? DrS(PsClass(c.cName, c.cAttrs, c.cGens, c.cParams, c.cImplements,
                  c.cWheres, out.dmStmts, c.cIsInterface,
                  c.pscLine, c.cAllParents, c.cAllSlots, c.cImports),
          true)
    : DrS(c, false)

fun drMembers(ms: List<PStmt>, r, insts: List<TraitInst>, acc, changed) =>
  fold(ms, (acc = acc, changed = changed), (st, x) => drMembersStep(st, x, r, insts))
    |> (r2) => DrMembers(r2.acc, r2.changed)

fun drMembersStep(st: (acc: List<PStmt>, changed: Bool), x: PStmt, r, insts: List<TraitInst>) => match(x)
  (f: PsFun) => drFn(f, r, insts)
    |> (o) => (acc = append(st.acc, o.dsStmt), changed = st.changed || o.dsChanged2)
  (o2: PStmt) => (acc = append(st.acc, x), changed = st.changed)

fun drFn(f: PsFun, r, insts: List<TraitInst>)
  if hasAttr(f.fAttrs, "foreign")
    ret DrS(f, false)
  ret match(f.fBody)
    (b: PExpr) => drFnBody(f, b, r, insts)
    ()         => DrS(f, false)

fun drFnBody(f: PsFun, b, r, insts: List<TraitInst>): DrS
  let rewritten = drExpr(b, f.fWheres, r, insts)
  let params = flattenParams(f.fParams)
  let referenced = referencedNames(rewritten.deExpr, List())
  let drops = unusedDroppable(params, referenced, f.fWheres, r, insts)
  let body2 = isEmpty(drops)
    ? rewritten.deExpr
    : withDrops(rewritten.deExpr, drops)
  let bal = drBalLoop(partiallyUsedDroppable(params, referenced,
                                                   f.fWheres, r, insts),
                      body2, false)
  let changed = rewritten.deChanged || !isEmpty(drops) || bal.deChanged
  ret changed
    ? DrS(PsFun(f.fName, f.fAttrs, f.fGens, f.fParams, bal.deExpr, f.fRet,
                f.fWheres, f.psfLine, f.fRetInferred, f.fNested, f.fImports, f.fGlobal),
          true)
    : DrS(f, false)

# ── droppability ────────────────────────────────────────────────────────────
# Every [trait] instance whose witness implements System::Drop<T>, as its
# interface over the instance's own type-parameter names: a generic instance
# (`<T> Drop<ListBuilder<T>>`) covers every instantiation of its `T`, a ground
# one exactly its type.

fun dropInterfaceName(r) => match(soleItem(findType(r, "System::Drop")))
  (f: Found) => stmtName(f.fStmt)
  ()         => None

fun dropInstances(r) => match(dropInterfaceName(r))
  (dn: String) => tiDropsLoop(traitInstanceStmts(r), dn,
                              dLetsLoop(traitLets(r), dn, r, List()))
  ()           => List<TraitInst>()

fun isDropOf(c: SClass, dn) => c.scName == dn && exactly(c.scParams, 1)

# PRE-LOWERING first-class instances: the pattern is the interface.
fun tiDropsLoop(ts: List<PStmt>, dn, acc: List<TraitInst>) =>
  fold(ts, acc, (a, x) => tiDropsLoopStep(a, x, dn))

fun tiDropsLoopStep(a: List<TraitInst>, x: PStmt, dn) => match(x)
  (ti: PsTraitInstance) => match(ti.tiPattern)
    (c: SClass) => isDropOf(c, dn)
      ? prepend(TraitInst(genNames(ti.tiGens, List()), c), a)
      : a
    (o: Spec) => a
  (o2: PStmt) => a

fun dLetsLoop(ts: List<PStmt>, dn, r, acc: List<TraitInst>) =>
  fold(ts, acc, (a, x) => dLetsLoopStep(a, x, dn, r))

fun dLetsLoopStep(a: List<TraitInst>, x: PStmt, dn, r) => match(x)
  (let2: PsLet) => witnessDrops(let2, dn, r, a)
  (o: PStmt) => a

fun witnessDrops(let2: PsLet, dn, r,
                 acc: List<TraitInst>): List<TraitInst> => match(let2.lType)
  (dt: Spec) => match(dt)
    (dc: SClass) => match(soleItem(findType(r, dc.scName)))
      (f: Found) => match(f.fStmt)
        (cls: PsClass) => match(cls.cAllParents)
          (ps: List<Spec>) => parentDrops(ps, dn,
                                          genNames(cls.cGens, List()), acc)
          ()               => acc
        (o: PStmt)     => acc
      ()         => acc
    (o2: Spec)   => acc
  ()         => acc

fun parentDrops(ps: List<Spec>, dn, names: List<String>, acc: List<TraitInst>) =>
  fold(ps, acc, (a, x) => parentDropsStep(a, x, dn, names))

fun parentDropsStep(a: List<TraitInst>, x: Spec, dn, names: List<String>) => match(x)
  (pc: SClass) => isDropOf(pc, dn)
    ? prepend(TraitInst(names, pc), a)
    : a
  (o: Spec) => a

fun droppable(sp: Spec|None, wheres: List<Spec>, r,
              insts: List<TraitInst>) => match(sp)
  (s2: Spec) => carriesLinearity(s2, r) && droppableSpec(s2, wheres, r, insts)
  ()         => false

# A placeholder is droppable iff the enclosing function itself declares
# `where Drop<T>` for it. Any other type must instantiate some instance's
# `T` — read with its own placeholders (an enclosing generic's `T` in a
# `ListBuilder<T>`) as the real types they are where it is declared.
fun droppableSpec(s2, wheres: List<Spec>, r,
                  insts: List<TraitInst>) => match(s2)
  (g2: SGeneric) => match(dropInterfaceName(r))
    (dn: String) => whereDropsPlaceholder(wheres, dn, g2.sgName)
    ()           => false
  (o: Spec)      => instantiatesADrop(withOpaquePlaceholders(s2), insts, r)

fun instantiatesADrop(wanted, insts: List<TraitInst>, r)
  let u = uid(wanted)
  ret u != "" && any(insts, (ti) => instantiatesDrop(ti, wanted, u, r))

fun instantiatesDrop(ti: TraitInst, wanted, u, r) => match(head(ti.tiIface.scParams))
  (pattern: Spec) => match(patternBinding(pattern, wanted, ti.tiParams, r))
    (m: List<Binding>) => uid(substitute(pattern, m)) == u
    ()                 => false
  ()              => false

fun whereDropsPlaceholder(ws: List<Spec>, dn,
                                 name) => any(ws, (x) => whereDropsPlaceholderStep(x, dn, name))

fun whereDropsPlaceholderStep(x: Spec, dn, name) => match(x)
  (wc: SClass) => wc.scName == dn && exactly(wc.scParams, 1)
            && firstIsPlaceholder(wc.scParams, name)
  (o: Spec) => false

fun firstIsPlaceholder(as2: List<Spec>, name) => match(head(as2))
  (sp: Spec) => match(sp)
    (g2: SGeneric) => g2.sgName == name
    (o: Spec)      => false
  ()         => false

# ── the bottom-up rewrite ───────────────────────────────────────────────────
# Children first, then a BLOCK appends drops for its own unused droppable
# lets, and a LAMBDA for its unused droppable params.

fun drExpr(x, wheres: List<Spec>, r,
           insts: List<TraitInst>) => match(x)
  (d: PeDot)     => drExpr(d.base, wheres, r, insts)
    |> (o) => DrE(o.deChanged ? PeDot(o.deExpr, d.member, d.pedLine) : x,
                  o.deChanged)
  (c: PeCall)    => drPair(c.function, c.parameter, wheres, r, insts)
    |> (p) => DrE(p.deChanged
                    ? PeCall(pairA(p.deExpr), pairB(p.deExpr), c.pecLine)
                    : x,
                  p.deChanged)
  (qq: PeCoalesce)   => drPair(qq.qqSubject, qq.qqFallback, wheres, r, insts)
    |> (p) => DrE(p.deChanged
                    ? PeCoalesce(pairA(p.deExpr), pairB(p.deExpr), qq.peqqLine)
                    : x,
                  p.deChanged)
  (wx: PeWith)   => drPair(wx.withSubject, wx.withRepls, wheres, r, insts)
    |> (p) => DrE(p.deChanged
                    ? PeWith(pairA(p.deExpr), pairB(p.deExpr), wx.pewLine)
                    : x,
                  p.deChanged)
  (tp: PeTuple)  => drEntries(tp, wheres, r, insts)
  (te: PeTernary) => drTernary(te, wheres, r, insts)
  (bk: PeBlock)  => drBlock(bk, wheres, r, insts)
  (mt: PeMatch)  => drMatch(mt, wheres, r, insts)
  (lm: PeLambda) => drLambda(lm, wheres, r, insts)
  (op: PeBuiltinOp) => drExpr(op.opParams, wheres, r, insts)
    |> (o) => DrE(o.deChanged
                    ? PeBuiltinOp(op.opType, op.opName, o.deExpr, op.peboLine)
                    : x,
                  o.deChanged)
  (ps: PePinSet) => drPinSet(ps, wheres, r, insts)
  (nw: PeNew)    => drExpr(nw.newParam, wheres, r, insts)
    |> (o) => DrE(o.deChanged ? PeNew(nw.newType, o.deExpr, nw.penwLine) : x,
                  o.deChanged)
  (ar: PeArrayRead) => drPair(ar.arrObj, ar.arrIndex, wheres, r, insts)
    |> (p) => DrE(p.deChanged
                    ? PeArrayRead(pairA(p.deExpr), pairB(p.deExpr),
                                  ar.pearLine)
                    : x,
                  p.deChanged)
  (cv: PeConvert) => drExpr(cv.convInner, wheres, r, insts)
    |> (o) => DrE(o.deChanged
                    ? PeConvert(o.deExpr, cv.convTarget, cv.pecvLine)
                    : x,
                  o.deChanged)
  (ne: PeNewEnum) => drFieldArgs(ne, wheres, r, insts)
  (o: PeLiteral) => DrE(x, false)
  (o: PeLowered) => DrE(x, false)
  (o: PeName) => DrE(x, false)

fun drFieldArgs(ne: PeNewEnum, wheres: List<Spec>, r,
                insts: List<TraitInst>)
  let out = drFaLoop(ne.fieldArgs, wheres, r, insts, List(),
                     false)
  ret DrE(out.dfChanged
            ? PeNewEnum(ne.rootName, ne.leafName, out.dfArgs,
                        ne.neTypeParams, ne.penewLine)
            : ne,
          out.dfChanged)

class [final] DrFa(dfArgs: List<PFieldArg>, dfChanged: Bool)

fun drFaLoop(fas: List<PFieldArg>, wheres: List<Spec>, r, insts: List<TraitInst>, acc, changed) =>
  fold(fas, (acc = acc, changed = changed), (st, x) => drFaLoopStep(st, x, wheres, r, insts))
    |> (r2) => DrFa(r2.acc, r2.changed)

fun drFaLoopStep(st: (acc: List<PFieldArg>, changed: Bool), x: PFieldArg, wheres: List<Spec>, r,
                 insts: List<TraitInst>) =>
  drExpr(x.faValue, wheres, r, insts)
  |> (o) => (acc = append(st.acc,
        PFieldArg(x.faName, o.deExpr)),
    changed = st.changed || o.deChanged)

# A two-child rebuild packs the pair into a synthetic tuple to ride the DrE
# slot; unpacked immediately by the caller.
fun drPair(a, b, wheres: List<Spec>, r,
           insts: List<TraitInst>)
  let oa = drExpr(a, wheres, r, insts)
  let ob = drExpr(b, wheres, r, insts)
  ret DrE(PeTuple(prepend(PTupEnt("", false, oa.deExpr),
                          prepend(PTupEnt("", false, ob.deExpr),
                                  List())),
                  exprLine(a)),
          oa.deChanged || ob.deChanged)

fun entryOf(x, i) => match(x)
  (tp: PeTuple) => entryAt(tp.exprs, i, x)
  (o: PExpr)    => x

fun pairA(x) => match(x)
  (tp: PeTuple) => entryAt(tp.exprs, 0, x)
  (o: PExpr)    => x

fun pairB(x) => match(x)
  (tp: PeTuple) => entryAt(tp.exprs, 1, x)
  (o: PExpr)    => x

fun entryAt(es: List<PTupEnt>, i, fallback): PExpr => match(head(drop(es, i)))
  (e: PTupEnt) => e.tupValue
  ()           => fallback

fun drEntries(tp: PeTuple, wheres: List<Spec>, r,
              insts: List<TraitInst>)
  let out = drEntryLoop(tp.exprs, wheres, r, insts, List(),
                        false)
  ret DrE(out.deChanged
            ? PeTuple(entriesOf3(out.deExpr, tp.exprs), tp.petLine)
            : tp,
          out.deChanged)

fun entriesOf3(x, orig) => match(x)
  (tp: PeTuple) => tp.exprs
  (o: PExpr)    => orig

fun drEntryLoop(es: List<PTupEnt>, wheres: List<Spec>, r, insts: List<TraitInst>, acc, changed) =>
  fold(es, (acc = acc, changed = changed), (st, x) => drEntryLoopStep(st, x, wheres, r, insts))
    |> (r2) => DrE(PeTuple(r2.acc, PLine("", 0, 0)), r2.changed)

fun drEntryLoopStep(st: (acc: List<PTupEnt>, changed: Bool), x: PTupEnt, wheres: List<Spec>, r,
                    insts: List<TraitInst>) =>
  drExpr(x.tupValue, wheres, r, insts)
  |> (o) => (acc = append(st.acc,
        PTupEnt(x.tupName, x.tupSpread,
                o.deExpr)),
    changed = st.changed || o.deChanged)

fun drTernary(te: PeTernary, wheres: List<Spec>, r,
              insts: List<TraitInst>)
  let oc = drExpr(te.condition, wheres, r, insts)
  let ot = drExpr(te.trueResult, wheres, r, insts)
  let of2 = drExpr(te.falseResult, wheres, r, insts)
  let changed = oc.deChanged || ot.deChanged || of2.deChanged
  ret DrE(changed
            ? PeTernary(oc.deExpr, ot.deExpr, of2.deExpr, te.pety)
            : te,
          changed)

fun drPinSet(ps: PePinSet, wheres: List<Spec>, r,
             insts: List<TraitInst>)
  let os = drExpr(ps.psSubject, wheres, r, insts)
  let ot = drExpr(ps.psTarget, wheres, r, insts)
  let ov = drExpr(ps.psValue, wheres, r, insts)
  let changed = os.deChanged || ot.deChanged || ov.deChanged
  ret DrE(changed
            ? PePinSet(os.deExpr, ot.deExpr, ov.deExpr, ps.pepsLine)
            : ps,
          changed)

fun drMatch(mt: PeMatch, wheres: List<Spec>, r,
            insts: List<TraitInst>)
  let os = drExpr(mt.subject, wheres, r, insts)
  let arms = drArms(mt.arms, wheres, r, insts, List(), false)
  let changed = os.deChanged || arms.daChanged
  ret DrE(changed
            ? with mt(subject = os.deExpr, arms = arms.daArms)
            : mt,
          changed)

class [final] DrArms(daArms: List<PArm>, daChanged: Bool)

fun drArms(as2: List<PArm>, wheres: List<Spec>, r, insts: List<TraitInst>, acc, changed) =>
  fold(as2, (acc = acc, changed = changed), (st, x) => drArmsStep(st, x, wheres, r, insts))
    |> (r2) => DrArms(r2.acc, r2.changed)

fun drArmsStep(st: (acc: List<PArm>, changed: Bool), x: PArm, wheres: List<Spec>, r,
               insts: List<TraitInst>) =>
  drExpr(x.armBody, wheres, r, insts)
  |> (o) => (acc = append(st.acc, with x(armBody = o.deExpr)), changed = st.changed || o.deChanged)

fun drBlock(bk: PeBlock, wheres: List<Spec>, r,
            insts: List<TraitInst>): DrE
  let ss = drBlockStmts(bk.blockStmts, wheres, r, insts, List(),
                        false)
  let ov = drExpr(bk.blockValue, wheres, r, insts)
  let rebuilt = ss.dmChanged || ov.deChanged
    ? PeBlock(ss.dmStmts, ov.deExpr, bk.blockTag, bk.pebkLine)
    : bk
  # The block's OWN unused droppable lets drop at its exit.
  let lets = bindingLets(blockStmtsOf(rebuilt),
                              List())
  let referenced = blockReferenced(rebuilt)
  let drops = unusedDroppable(lets, referenced, wheres, r, insts)
  let dropped = isEmpty(drops) ? rebuilt : withDrops(rebuilt, drops)
  let bal = drBalLoop(partiallyUsedDroppable(lets, referenced,
                                                   wheres, r, insts),
                      dropped, false)
  ret DrE(bal.deExpr,
          ss.dmChanged || ov.deChanged || !isEmpty(drops) || bal.deChanged)

fun blockStmtsOf(x) => match(x)
  (bk: PeBlock) => bk.blockStmts
  (o: PExpr)    => List()

fun blockReferenced(x) => referencedNames(x, List())

fun drBlockStmts(ss: List<PStmt>, wheres: List<Spec>, r, insts: List<TraitInst>, acc, changed) =>
  fold(ss, (acc = acc, changed = changed), (st, x) => drBlockStmtsStep(st, x, wheres, r, insts))
    |> (r2) => DrMembers(r2.acc, r2.changed)

fun drBlockStmtsStep(st: (acc: List<PStmt>, changed: Bool), x: PStmt, wheres: List<Spec>, r,
                     insts: List<TraitInst>) =>
  drStmt(x, wheres, r, insts)
  |> (o) => (acc = append(st.acc, o.dsStmt), changed = st.changed || o.dsChanged2)

fun drStmt(st, wheres: List<Spec>, r,
           insts: List<TraitInst>) => match(st)
  (l: PsLet) => match(l.lDefault)
    (d: PExpr) => drExpr(d, wheres, r, insts)
      |> (o) => DrS(o.deChanged
                      ? PsLet(l.lName, l.lAttrs, l.lGens, l.lType, o.deExpr,
                              l.lArrayLen, l.lWheres, l.pslLine,
                              l.lTypeInferred, l.lImports)
                      : st,
                    o.deChanged)
    ()         => DrS(st, false)
  (d: PsDestructure) => match(d.dDefault)
    (x: PExpr) => drExpr(x, wheres, r, insts)
      |> (o) => DrS(o.deChanged
                      ? PsDestructure(d.dName, d.dAttrs, d.dType,
                                      d.dTargets, o.deExpr, d.psdLine,
                                      d.dTypeInferred)
                      : st,
                    o.deChanged)
    ()         => DrS(st, false)
  (f: PsFun)   => drFn(f, r, insts)
  (rt: PsRet)  => drExpr(rt.retValue, wheres, r, insts)
    |> (o) => DrS(o.deChanged ? PsRet(o.deExpr, rt.psrLine) : st,
                  o.deChanged)
  (a: PsAction) => drExpr(a.action, wheres, r, insts)
    |> (o) => DrS(o.deChanged ? PsAction(o.deExpr, a.psaLine) : st,
                  o.deChanged)
  (fa: PsFieldAssign) => drFieldAssign(fa, st, wheres, r, insts)
  (i: PsIf)    => drIf(i, wheres, r, insts)
  (o: PStmt)   => DrS(st, false)

# A field assignment drops inside its target and its value alike.
fun drFieldAssign(fa: PsFieldAssign, st, wheres: List<Spec>, r, insts: List<TraitInst>)
  let t = drExpr(fa.faTarget, wheres, r, insts)
  let v = drExpr(fa.faValue, wheres, r, insts)
  ret DrS(t.deChanged || v.deChanged ? PsFieldAssign(t.deExpr, v.deExpr, fa.psfaLine) : st,
          t.deChanged || v.deChanged)

fun drIf(i: PsIf, wheres: List<Spec>, r, insts: List<TraitInst>)
  let oc = drExpr(i.ifCond, wheres, r, insts)
  let ot = drBlockStmts(i.ifTrue, wheres, r, insts, List(), false)
  let of2 = drBlockStmts(i.ifFalse, wheres, r, insts, List(),
                         false)
  let changed = oc.deChanged || ot.dmChanged || of2.dmChanged
  ret DrS(changed
            ? PsIf(oc.deExpr, ot.dmStmts, of2.dmStmts, i.psifLine)
            : i,
          changed)

fun drLambda(lm: PeLambda, wheres: List<Spec>, r,
             insts: List<TraitInst>): DrE
  let ob = drExpr(lm.lamBody, wheres, r, insts)
  let params = flattenParams(lm.lamParams)
  let referenced = referencedNames(ob.deExpr, List())
  let drops = unusedDroppable(params, referenced, wheres, r, insts)
  let body2 = isEmpty(drops) ? ob.deExpr : withDrops(ob.deExpr, drops)
  let bal = drBalLoop(partiallyUsedDroppable(params, referenced,
                                                   wheres, r, insts),
                      body2, false)
  let changed = ob.deChanged || !isEmpty(drops) || bal.deChanged
  ret DrE(changed
            ? PeLambda(lm.lamParams, bal.deExpr, lm.pelLine, lm.lamRet)
            : lm,
          changed)

# ── the drop candidates and the rewrite shape ───────────────────────────────

fun unusedDroppable(lets: List<PStmt>, referenced: List<String>,
                    wheres: List<Spec>, r,
                    insts: List<TraitInst>) => udLoop(lets, referenced, wheres, r, insts, List())

fun udLoop(ls: List<PStmt>,
            referenced: List<String>,
            wheres: List<Spec>,
            r,
            insts: List<TraitInst>,
            acc: List<PStmt>) =>
  fold(ls, acc, (a, x) => udLoopStep(a, x, referenced, wheres, r, insts))

fun udLoopStep(a: List<PStmt>, x: PStmt, referenced: List<String>, wheres: List<Spec>, r, insts: List<TraitInst>) => match(x)
  (let2: PsLet) => isUnusedDroppable(let2, referenced, wheres, r, insts)
    ? append(a, x)
    : a
  (o: PStmt) => a

fun isUnusedDroppable(let2: PsLet, referenced: List<String>,
                      wheres: List<Spec>, r,
                      insts: List<TraitInst>) => !contains(referenced, let2.lName)
    && eligibleDroppable(let2, wheres, r, insts)

fun eligibleDroppable(let2: PsLet, wheres: List<Spec>, r,
                      insts: List<TraitInst>) => !startsWith(bareOfUnique(let2.lName), "_")
    && bareOfUnique(let2.lName) != "this"
    && !hasAttr(let2.lAttrs, "terminal")
    && !hasAttr(let2.lAttrs, "lazy")
    && !hasAttr(let2.lAttrs, "future")
    && droppable(let2.lType, wheres, r, insts)

fun partiallyUsedDroppable(lets: List<PStmt>, referenced: List<String>,
                           wheres: List<Spec>, r,
                           insts: List<TraitInst>)
  ret puLoop(lets, referenced, wheres, r, insts, List())

fun puLoop(ls: List<PStmt>,
            referenced: List<String>,
            wheres: List<Spec>,
            r,
            insts: List<TraitInst>,
            acc: List<PStmt>) =>
  fold(ls, acc, (a, x) => puLoopStep(a, x, referenced, wheres, r, insts))

fun puLoopStep(a: List<PStmt>, x: PStmt, referenced: List<String>, wheres: List<Spec>, r, insts: List<TraitInst>) => match(x)
  (let2: PsLet) => contains(referenced, let2.lName)
             && eligibleDroppable(let2, wheres, r, insts)
    ? append(a, x)
    : a
  (o: PStmt) => a

# `body` extended so each drop releases at scope exit: value computed FIRST
# (a derived view of a dropped handle drains before the close), then the
# drops, then the saved value is the result.
fun withDrops(body, drops: List<PStmt>): PExpr
  let lr = exprLine(body)
  let keep = "$drop_keep@" + hash6(lr.plFile, lr.plLine, lr.plCol)
  let stmts0 = blockStmtsOf2(body)
  let value0 = blockValueOf(body)
  # Order is the whole point here: the body's own statements, then the let
  # that saves its value, then the drop calls.
  let stmts = concat(
      append(stmts0,
           PsLet(keep, List(), List(), None,
                 value0, "", List(), lr)),
      dropCalls(drops, List()))
  ret PeBlock(stmts, PeName(keep, List(), lr), "", lr)

fun blockStmtsOf2(body) => match(body)
  (bk: PeBlock) => bk.blockStmts
  (o: PExpr)    => List()

fun blockValueOf(body) => match(body)
  (bk: PeBlock) => bk.blockValue
  (o: PExpr)    => body

fun dropCalls(ds: List<PStmt>, acc: List<PStmt>) =>
  fold(ds, acc, dropCallsStep)

fun dropCallsStep(a: List<PStmt>, x: PStmt) => match(x)
  (let2: PsLet) => append(a, dropCall(let2))
  (o: PStmt) => a

# ── path-level balancing ────────────────────────────────────────────────────
# A droppable binding referenced on SOME paths gets a drop on each abandoning
# path, so every path consumes it exactly once (the linearity checker's merge
# rule). Anything outside that shape — double use, a reference under a lambda,
# nested fn or match guard — bails out (ok=false), keeping the checker's error.

class [final] DrBx(bxExpr: PExpr, bxDid: Bool, bxOk: Bool)
class [final] DrBi(biStmt: PStmt, biDid: Bool, biOk: Bool)
class [final] DrBs(bsStmts: List<PStmt>, bsValue: PExpr|None, bsDid: Bool,
                   bsOk: Bool)

fun drBalLoop(ls: List<PStmt>, body, changed) =>
  fold(ls, (body = body, changed = changed), drBalLoopStep)
    |> (r) => DrE(r.body, r.changed)

fun drBalLoopStep(st: (body: PExpr, changed: Bool), x: PStmt) => match(x)
  (let2: PsLet) => drBalance(st.body, let2)
    |> (o) => (body = o.deExpr, changed = st.changed || o.deChanged)
  (o: PStmt) => (body = st.body, changed = st.changed)

# A block binding exists from its declaring statement on: a path that leaves
# before it (an early `ret`) never held it, so the accounting starts after it
# and the statements up to it pass through. A parameter has no declaring
# statement — it is held from the top.
fun drBalance(body, let2: PsLet)
  let stmts = blockStmtsOf2(body)
  let start = drBindingEnd(stmts, let2.lName, 1)
  let out = drEnsureStmts(drop(stmts, start), blockValueOf(body),
                          false, false, let2, take(stmts, start), false)
  if !out.bsOk || !out.bsDid
    ret DrE(body, false)
  ret match(out.bsValue)
    (v: PExpr) => DrE(PeBlock(out.bsStmts, v, "", exprLine(body)), true)
    ()         => DrE(body, false)

fun drBail() => DrBs(List(), None, false, false)

# One past the index of the statement that binds `name`, or 0 when none does.
fun drBindingEnd(ss: List<PStmt>, name: String, at: Int): Int =>
  match(findIndex(ss, (s) => any(bindingLets(list1(s), List()), (b) => drLetName(b) == name)))
    (k: Int) => at + k
    ()       => 0

fun drLetName(st: PStmt) => match(st)
  (let2: PsLet) => let2.lName
  (o: PStmt)    => ""

fun drRefs(x, name: String): Bool => contains(referencedNames(x, List()), name)

fun drRefsOpt(x: PExpr|None, name: String) => match(x)
  (e2: PExpr) => drRefs(e2, name)
  ()          => false

fun drRefsStmt(st, name: String): Bool => contains(refStmt(st, List()), name)

fun drRefsAny(ss: List<PStmt>, name: String) => any(ss, (x) => drRefsStmt(x, name))

fun oneDrop(let2: PsLet): List<PStmt> => prepend(let2, List())

# Path accounting through a statement list. `tail2` says the caller's
# continuation consumes on fall-through; every path must total exactly one.
fun drEnsureStmts(ss: List<PStmt>, value, tail2, consumed, let2: PsLet, acc, did) => match(head(ss))
  (v: PStmt) => match(v)
    (rt: PsRet) => drEnsureRet(rt, dropOne(ss), value, consumed, let2, acc, did)
    (i2: PsIf)  => drEnsureIfStep(i2, dropOne(ss), value, tail2, consumed, let2, acc, did)
    (o: PStmt)  => drEnsurePlain(v, dropOne(ss), value, tail2, consumed, let2, acc, did)
  () => drEnsureEnd(value, tail2, consumed, let2, acc, did)

fun drEnsurePlain(st, rest, value,
                  tail2: Bool, consumed: Bool, let2: PsLet,
                  acc: List<PStmt>, did): DrBs
  if !drRefsStmt(st, let2.lName)
    ret drEnsureStmts(rest, value, tail2, consumed, let2,
                      append(acc, st), did)
  if consumed
    ret drBail()
  let fs = drFixStmt(st, let2)
  if !fs.biOk
    ret drBail()
  ret drEnsureStmts(rest, value, tail2, true, let2,
                    append(acc, fs.biStmt), did || fs.biDid)

# This path exits the function here; the tail never runs. Anything after the
# `ret` is unreachable and kept as-is.
fun drEnsureRet(rt: PsRet, rest, value,
                consumed: Bool, let2: PsLet,
                acc: List<PStmt>, did: Bool): DrBs
  let r2 = drRefs(rt.retValue, let2.lName)
  let need = 1 - (consumed ? 1 : 0) - (r2 ? 1 : 0)
  if need < 0
    ret drBail()
  let fx = r2 ? drFixExpr(rt.retValue, let2) : DrBx(rt.retValue, false, true)
  if !fx.bxOk
    ret drBail()
  let nv = need == 1 ? withDrops(fx.bxExpr, oneDrop(let2)) : fx.bxExpr
  ret DrBs(drCopyRestB(rest, append(acc,
                                PsRet(nv, rt.psrLine))),
           value, did || fx.bxDid || need == 1, true)

fun drCopyRestB(ss: List<PStmt>, acc: List<PStmt>) =>
  fold(ss, acc, append)

fun drEnsureIfStep(i2: PsIf, rest, value,
                   tail2: Bool, consumed: Bool, let2: PsLet,
                   acc: List<PStmt>, did: Bool): DrBs
  let later = drRefsAny(rest, let2.lName) || drRefsOpt(value, let2.lName)
              || tail2
  let fi = drEnsureIf(i2, consumed, later, let2)
  if !fi.biOk
    ret drBail()
  # Falling branches were made to consume exactly when nothing before or
  # after this `if` does; a both-terminating `if` never falls through.
  let bothTerm = blockTerminates(i2.ifTrue) && blockTerminates(i2.ifFalse)
  let consumed2 = bothTerm ? consumed : (consumed || !later)
  ret drEnsureStmts(rest, value, tail2, consumed2, let2,
                    append(acc, fi.biStmt), did || fi.biDid)

fun drEnsureIf(i2: PsIf, consumed, later, let2: PsLet)
  let name = let2.lName
  if drRefs(i2.ifCond, name)
    ret drEnsureIfCond(i2, consumed, later, let2)
  let tb = drEnsureBranch(i2.ifTrue, consumed, later, let2)
  if !tb.bsOk
    ret DrBi(i2, false, false)
  let fb = drEnsureBranch(i2.ifFalse, consumed, later, let2)
  if !fb.bsOk
    ret DrBi(i2, false, false)
  ret DrBi(PsIf(i2.ifCond, tb.bsStmts, fb.bsStmts, i2.psifLine),
           tb.bsDid || fb.bsDid, true)

# The condition consumed it; any branch re-use is the checker's error.
fun drEnsureIfCond(i2: PsIf, consumed, later, let2: PsLet)
  let name = let2.lName
  if consumed || later || drRefsAny(i2.ifTrue, name)
     || drRefsAny(i2.ifFalse, name)
    ret DrBi(i2, false, false)
  let fx = drFixExpr(i2.ifCond, let2)
  if !fx.bxOk
    ret DrBi(i2, false, false)
  ret DrBi(PsIf(fx.bxExpr, i2.ifTrue, i2.ifFalse, i2.psifLine), fx.bxDid,
           true)

fun drEnsureBranch(blk, consumed, later,
                   let2: PsLet)
  let term = blockTerminates(blk)
  # A terminating branch never reaches the tail; a falling one does.
  let need = 1 - (consumed ? 1 : 0) - (term || !later ? 0 : 1)
  if need < 0
    ret drBail()
  if need == 0
    ret drRefsAny(blk, let2.lName)
      ? drBail()
      : DrBs(blk, None, false, true)
  ret drEnsureStmts(blk, None, false, false, let2, List(),
                    false)

fun drEnsureEnd(value: PExpr|None, tail2, consumed, let2: PsLet,
                acc, did)
  let vr = drRefsOpt(value, let2.lName)
  let need = 1 - (consumed ? 1 : 0) - (vr ? 1 : 0) - (tail2 ? 1 : 0)
  if need < 0
    ret drBail()
  ret match(value)
    (v: PExpr) => drEnsureEndValue(v, vr, need, let2, acc, did)
    ()         => need == 1
      ? DrBs(append(acc, dropCall(let2)), None, true, true)
      : DrBs(acc, None, did, true)

fun drEnsureEndValue(v, vr: Bool, need, let2: PsLet,
                     acc: List<PStmt>, did: Bool): DrBs
  let fx = vr ? drFixExpr(v, let2) : DrBx(v, false, true)
  if !fx.bxOk
    ret drBail()
  # Scope-exit timing: the value is computed FIRST, then the drop.
  let nv = need == 1 ? withDrops(fx.bxExpr, oneDrop(let2)) : fx.bxExpr
  ret DrBs(acc, nv, did || fx.bxDid || need == 1, true)

# ── divergence inside an expression ─────────────────────────────────────────
# Bottom-up: a fixed inner branch counts as consumption for its parent.
# Nodes not referencing the binding pass through untouched.

fun drFixExpr(x, let2: PsLet)
  if !drRefs(x, let2.lName)
    ret DrBx(x, false, true)
  ret match(x)
    (te: PeTernary) => drFixTernary(te, let2)
    (mt: PeMatch)   => drFixMatch(mt, let2)
    # A reference under a lambda is a capture; keep the checker's error.
    (lm: PeLambda)  => DrBx(x, false, false)
    (d: PeDot)      => drFixExpr(d.base, let2)
      |> (o) => DrBx(PeDot(o.bxExpr, d.member, d.pedLine), o.bxDid, o.bxOk)
    (c: PeCall)     => drFixPair(c.function, c.parameter, let2)
      |> (p) => DrBx(PeCall(pairA(p.bxExpr), pairB(p.bxExpr), c.pecLine),
                     p.bxDid, p.bxOk)
    (qq: PeCoalesce)    => drFixPair(qq.qqSubject, qq.qqFallback, let2)
      |> (p) => DrBx(PeCoalesce(pairA(p.bxExpr), pairB(p.bxExpr), qq.peqqLine),
                     p.bxDid, p.bxOk)
    (wx: PeWith)    => drFixPair(wx.withSubject, wx.withRepls, let2)
      |> (p) => DrBx(PeWith(pairA(p.bxExpr), pairB(p.bxExpr), wx.pewLine),
                     p.bxDid, p.bxOk)
    (tp: PeTuple)   => drFixEntries(tp, let2)
    (bk: PeBlock)   => drFixBlock(bk, let2)
    (op: PeBuiltinOp) => drFixExpr(op.opParams, let2)
      |> (o) => DrBx(PeBuiltinOp(op.opType, op.opName, o.bxExpr, op.peboLine),
                     o.bxDid, o.bxOk)
    # Its three operands run in order, as a call's arguments do.
    (ps: PePinSet)  => drFixEntries(PeTuple(prepend(PTupEnt("", false, ps.psSubject),
                                              prepend(PTupEnt("", false, ps.psTarget),
                                                prepend(PTupEnt("", false, ps.psValue),
                                                        List()))),
                                            ps.pepsLine), let2)
      |> (p) => DrBx(PePinSet(entryOf(p.bxExpr, 0), entryOf(p.bxExpr, 1),
                              entryOf(p.bxExpr, 2), ps.pepsLine),
                     p.bxDid, p.bxOk)
    (nw: PeNew)     => drFixExpr(nw.newParam, let2)
      |> (o) => DrBx(PeNew(nw.newType, o.bxExpr, nw.penwLine), o.bxDid,
                     o.bxOk)
    (ar: PeArrayRead) => drFixPair(ar.arrObj, ar.arrIndex, let2)
      |> (p) => DrBx(PeArrayRead(pairA(p.bxExpr), pairB(p.bxExpr),
                                 ar.pearLine),
                     p.bxDid, p.bxOk)
    (cv: PeConvert) => drFixExpr(cv.convInner, let2)
      |> (o) => DrBx(PeConvert(o.bxExpr, cv.convTarget, cv.pecvLine),
                     o.bxDid, o.bxOk)
    (ne: PeNewEnum) => drFixFieldArgs(ne, let2)
    (o: PeLiteral) => DrBx(x, false, true)
    (o: PeLowered) => DrBx(x, false, true)
    (o: PeName) => DrBx(x, false, true)

fun drFixPair(a, b, let2: PsLet)
  let oa = drFixExpr(a, let2)
  if !oa.bxOk
    ret DrBx(a, false, false)
  let ob = drFixExpr(b, let2)
  if !ob.bxOk
    ret DrBx(a, false, false)
  ret DrBx(PeTuple(prepend(PTupEnt("", false, oa.bxExpr),
                           prepend(PTupEnt("", false, ob.bxExpr),
                                   List())),
                   exprLine(a)),
           oa.bxDid || ob.bxDid, true)

fun drFixEntries(tp: PeTuple, let2: PsLet)
  let out = drFixEntryLoop(tp.exprs, let2, List(), false)
  if !out.bxOk
    ret DrBx(tp, false, false)
  ret DrBx(PeTuple(entriesOf3(out.bxExpr, tp.exprs), tp.petLine), out.bxDid,
           true)

fun [tail] drFixEntryLoop(es: List<PTupEnt>, let2: PsLet, acc, did) => match(head(es))
  (e: PTupEnt) => drFixExpr(e.tupValue, let2)
    |> (o) => o.bxOk
      ? drFixEntryLoop(dropOne(es), let2,
                       append(acc, PTupEnt(e.tupName, e.tupSpread, o.bxExpr)),
                       did || o.bxDid)
      : DrBx(PeTuple(acc, PLine("", 0, 0)), false, false)
  ()           => DrBx(PeTuple(acc, PLine("", 0, 0)), did, true)

fun drFixFieldArgs(ne: PeNewEnum, let2: PsLet)
  let out = drFixFaLoop(ne.fieldArgs, let2, List(), false)
  if !out.faOk
    ret DrBx(ne, false, false)
  ret DrBx(PeNewEnum(ne.rootName, ne.leafName, out.faArgs, ne.neTypeParams,
                     ne.penewLine),
           out.faDid, true)

class [final] DrFaB(faArgs: List<PFieldArg>, faDid: Bool, faOk: Bool)

fun [tail] drFixFaLoop(fas: List<PFieldArg>, let2: PsLet, acc, did) => match(head(fas))
  (fa: PFieldArg) => drFixExpr(fa.faValue, let2)
    |> (o) => o.bxOk
      ? drFixFaLoop(dropOne(fas), let2, append(acc, PFieldArg(fa.faName, o.bxExpr)), did || o.bxDid)
      : DrFaB(acc, false, false)
  ()              => DrFaB(acc, did, true)

fun drFixTernary(te: PeTernary, let2: PsLet): DrBx
  let name = let2.lName
  if drRefs(te.condition, name)
    ret drFixTernaryCond(te, let2)
  let ft = drFixExpr(te.trueResult, let2)
  if !ft.bxOk
    ret DrBx(te, false, false)
  let ff = drFixExpr(te.falseResult, let2)
  if !ff.bxOk
    ret DrBx(te, false, false)
  let tr = drRefs(ft.bxExpr, name)
  let fr = drRefs(ff.bxExpr, name)
  if tr == fr
    ret DrBx(PeTernary(te.condition, ft.bxExpr, ff.bxExpr, te.pety),
             ft.bxDid || ff.bxDid, true)
  let nt = tr ? ft.bxExpr : withDrops(ft.bxExpr, oneDrop(let2))
  let nf = tr ? withDrops(ff.bxExpr, oneDrop(let2)) : ff.bxExpr
  ret DrBx(PeTernary(te.condition, nt, nf, te.pety), true, true)

# The condition consumed it; branch re-use is the checker's error.
fun drFixTernaryCond(te: PeTernary, let2: PsLet)
  let name = let2.lName
  if drRefs(te.trueResult, name) || drRefs(te.falseResult, name)
    ret DrBx(te, false, false)
  let fc = drFixExpr(te.condition, let2)
  if !fc.bxOk
    ret DrBx(te, false, false)
  ret DrBx(PeTernary(fc.bxExpr, te.trueResult, te.falseResult, te.pety),
           fc.bxDid, true)

fun drFixMatch(mt: PeMatch, let2: PsLet)
  let name = let2.lName
  # A guard runs on fall-through paths too; keep the checker's error.
  if drGuardRefs(mt.arms, name)
    ret DrBx(mt, false, false)
  if drRefs(mt.subject, name)
    ret drFixMatchSubject(mt, let2)
  let fixed = drFixArmLoop(mt.arms, let2, List(), false)
  if !fixed.abOk
    ret DrBx(mt, false, false)
  let anyR = drArmRefsAny(fixed.abArms, name)
  let allR = drArmRefsAll(fixed.abArms, name)
  if allR || !anyR
    ret DrBx(with mt(arms = fixed.abArms), fixed.abDid,
             true)
  ret DrBx(with mt(arms = drWrapArms(fixed.abArms, name, let2,
                                     List())),
           true, true)

fun drFixMatchSubject(mt: PeMatch, let2: PsLet)
  let name = let2.lName
  if drArmRefsAny(mt.arms, name)
    ret DrBx(mt, false, false)
  let fs = drFixExpr(mt.subject, let2)
  if !fs.bxOk
    ret DrBx(mt, false, false)
  ret DrBx(with mt(subject = fs.bxExpr), fs.bxDid, true)

fun drGuardRefs(as2: List<PArm>, name: String) => any(as2, (x) => drRefsOpt(x.armGuard, name))

fun drArmRefsAny(as2: List<PArm>, name: String) => any(as2, (x) => drRefs(x.armBody, name))

fun drArmRefsAll(as2: List<PArm>, name: String) => all(as2, (x) => drRefs(x.armBody, name))

class [final] DrArmB(abArms: List<PArm>, abDid: Bool, abOk: Bool)

fun [tail] drFixArmLoop(as2: List<PArm>, let2: PsLet, acc, did) => match(head(as2))
  (a: PArm) => drFixExpr(a.armBody, let2)
    |> (o) => o.bxOk
      ? drFixArmLoop(dropOne(as2), let2, append(acc, with a(armBody = o.bxExpr)), did || o.bxDid)
      : DrArmB(acc, false, false)
  ()        => DrArmB(acc, did, true)

fun drWrapArms(as2: List<PArm>, name: String, let2: PsLet, acc: List<PArm>): List<PArm> =>
  fold(as2, acc, (a, x) => drRefs(x.armBody, name)
    ? append(a, x)
    : append(a, with x(armBody = withDrops(x.armBody,
                                     oneDrop(let2)))))

fun drFixBlock(bk: PeBlock, let2: PsLet)
  let ss = drFixStmtLoop(bk.blockStmts, let2, List(), false)
  if !ss.bsOk
    ret DrBx(bk, false, false)
  let ov = drFixExpr(bk.blockValue, let2)
  if !ov.bxOk
    ret DrBx(bk, false, false)
  ret DrBx(PeBlock(ss.bsStmts, ov.bxExpr, bk.blockTag, bk.pebkLine),
           ss.bsDid || ov.bxDid, true)

fun [tail] drFixStmtLoop(ss: List<PStmt>, let2: PsLet, acc, did) => match(head(ss))
  (s: PStmt) => drFixStmt(s, let2)
    |> (o) => o.biOk
      ? drFixStmtLoop(dropOne(ss), let2, append(acc, o.biStmt), did || o.biDid)
      : DrBs(acc, None, false, false)
  ()         => DrBs(acc, None, did, true)

fun drFixStmt(st, let2: PsLet)
  if !drRefsStmt(st, let2.lName)
    ret DrBi(st, false, true)
  ret match(st)
    (l: PsLet) => match(l.lDefault)
      (d: PExpr) => drFixExpr(d, let2)
        |> (o) => DrBi(PsLet(l.lName, l.lAttrs, l.lGens, l.lType, o.bxExpr,
                             l.lArrayLen, l.lWheres, l.pslLine,
                             l.lTypeInferred, l.lImports),
                       o.bxDid, o.bxOk)
      ()         => DrBi(st, false, true)
    (d: PsDestructure) => match(d.dDefault)
      (x: PExpr) => drFixExpr(x, let2)
        |> (o) => DrBi(PsDestructure(d.dName, d.dAttrs, d.dType, d.dTargets,
                                     o.bxExpr, d.psdLine, d.dTypeInferred),
                       o.bxDid, o.bxOk)
      ()         => DrBi(st, false, true)
    (rt: PsRet)  => drFixExpr(rt.retValue, let2)
      |> (o) => DrBi(PsRet(o.bxExpr, rt.psrLine), o.bxDid, o.bxOk)
    (a: PsAction) => drFixExpr(a.action, let2)
      |> (o) => DrBi(PsAction(o.bxExpr, a.psaLine), o.bxDid, o.bxOk)
    (fa: PsFieldAssign) => drFixFieldAssign(fa, let2)
    (i: PsIf)    => drFixIf(i, let2)
    # A reference under a nested fn is a capture; keep the checker's error.
    (f: PsFun)   => DrBi(st, false, false)
    (o: PStmt)   => DrBi(st, false, true)

fun drFixFieldAssign(fa: PsFieldAssign, let2: PsLet)
  let t = drFixExpr(fa.faTarget, let2)
  let v = drFixExpr(fa.faValue, let2)
  ret DrBi(PsFieldAssign(t.bxExpr, v.bxExpr, fa.psfaLine), t.bxDid || v.bxDid, t.bxOk && v.bxOk)

fun drFixIf(i: PsIf, let2: PsLet)
  let oc = drFixExpr(i.ifCond, let2)
  if !oc.bxOk
    ret DrBi(i, false, false)
  let ot = drFixStmtLoop(i.ifTrue, let2, List(), false)
  if !ot.bsOk
    ret DrBi(i, false, false)
  let of2 = drFixStmtLoop(i.ifFalse, let2, List(), false)
  if !of2.bsOk
    ret DrBi(i, false, false)
  ret DrBi(PsIf(oc.bxExpr, ot.bsStmts, of2.bsStmts, i.psifLine),
           oc.bxDid || ot.bsDid || of2.bsDid, true)

# A plain `drop(x)`: a concrete binding resolves through the type's
# `instance [ambient]`; a `[linear] T` binding through the enclosing fn's
# `where Drop<T>`.
fun dropCall(let2: PsLet)
  ret PsAction(PeCall(PeName("drop", List(), let2.pslLine),
                      PeTuple(prepend(PTupEnt("", false,
                                             PeName(let2.lName, List(),
                                                    let2.pslLine)), List()),
                              let2.pslLine),
                      let2.pslLine),
               let2.pslLine)
