# bootstrap/known_tags.yafl — ported from lowering/known_tags.py: resolve
# dispatch on statically-known tags (case-of-known-constructor). After
# fusion, a union packed with a constant `$tag` is dispatched on a few ops
# later; in SSA the tag is statically decidable (ssa_defs), so the `JumpIf`
# hardens to an unconditional `Jump` (taken) or evaporates (never taken).
# The dead pack then falls to deadstores, and the straightened flow lets
# branch threading collapse further. Runs in the pre-async fixpoint at -O1+.
# Phi-safe: no labels renamed or removed; a hardened/dropped JumpIf can
# strand its other edge as unreachable code — harmless, and a folded
# function is re-stripped so the dropped arm stops pinning otherwise-dead
# functions against the reachability prune.
namespace Bootstrap::Lower::Ir

import System

import Bootstrap::Ir



fun resolveKnownTags(a: CgApp): CgApp
  ret appWithFunctions(a, map(appFunctions(a), ktFunction))

fun ktFunction(f: CgFunction): CgFunction
  let defs = singleDefs(f)
  let walked = ktWalk<ChainStream<Op>>(chainStream<Op>(chain(f.fnOps)), defs,
                                       builder<Op >(), false)
  if !walked.folded
    ret f
  ret cgFunctionStripUnusedOperations(cgFunctionWith(f, walked.ops,
                                                     f.fnStackVars))

# Stream-driven (storage-agnostic). Error arm unreachable: Never.
fun [tail] ktWalk<S>(s: S, defs: SsaDefs,
                     [terminal] acc: ListBuilder<Op >, folded: Bool): (ops: List<Op>, folded: Bool) where Stream<S, Op, Never>
  let r = streamNext<S, Op, Never>(s)
  ret match(r.value)
    (ok: Ok<Op | None, Never>) => match(ok.value)
      (cur: Op) => match(cur)
        (ji: OpJumpIf) => match(staticInt(ji.jumpIfCondition, defs))
          (cond: Int) => ktWalk<S>(r.stream, defs, ktHarden(acc, ji, cond), true)
          ()          => ktWalk<S>(r.stream, defs, push<Op >(acc, cur), folded)
        (o: Op)        => ktWalk<S>(r.stream, defs, push<Op >(acc, cur), folded)
      (n: None) => (build<Op >(acc), folded)
    (er: Error<Op | None, Never>) => (build<Op >(acc), folded)

# Taken: `Jump(label)`; never taken: the guard evaporates.
fun ktHarden([terminal] acc: ListBuilder<Op >, ji: OpJumpIf,
             cond: Int): ListBuilder<Op >
  ret (cond != 0) != ji.jumpIfInvert
    ? push<Op >(acc, OpJump(ji.jumpIfLabel, List<RParam>()))
    : acc
