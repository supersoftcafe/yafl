# bootstrap/sync_inference.yafl — the sync-guarantee fixpoint, ported from
# lowering/sync_inference.py. After inlining and before task lowering:
# propagate [sync] to functions provably never suspending. Seed = programmer
# [sync] + non-foreign leaves (no non-tail Calls, no ParallelCall, not
# returning TagTask); propagate F when every non-tail Call resolves sync (a
# VirtualFunction needs every implementation sync; empty impl set stays
# conservatively async); materialise fn.sync only — task lowering uniformly
# emits IfTask checks, so a misclassified suspender aborts cleanly.
namespace Bootstrap::Lower::Ir

import System

import Bootstrap::Ast

import Bootstrap::Ir
import Bootstrap::Parse
import Bootstrap::StdlibCandidates



# The sync fixpoint without the materialisation: names provably unable to
# suspend. Shared by inferSync and the -O3 single-caller inline gate —
# inlining a suspending callee into its caller merges the two live sets, so
# every suspension in the merged body saves the combined frame; the gate
# keeps suspending helpers outboard where their own small frame is all they
# save.
fun computeSyncNames(a: CgApp): Set<String>
  let virtualImpls = gfSlotFuncs(a)   # slot → implementing functions (all objects, foreign incl.)
  let seed = fold(appFunctions(a), Set<String>(),
                  (acc: Set<String>, f: CgFunction) => siSeedable(f) ? add<String>(acc, f.fnName) : acc)
  ret siFixpoint(a, virtualImpls, seed)

fun inferSync(a: CgApp): CgApp
  let syncSet = computeSyncNames(a)
  ret appWithFunctions(a, map(appFunctions(a),
        (f: CgFunction) => siMaterialise(f, syncSet)))

fun siMaterialise(f: CgFunction, syncSet: Set<String>): CgFunction
  ret CgFunction(f.fnName, f.fnParams, f.fnResult, f.fnStackVars, f.fnOps,
                 f.fnComment, f.fnForeignSymbol,
                 contains<String>(syncSet, f.fnName),
                 f.fnTail, f.fnBypassAsync, f.fnAlwaysInline,
                 f.fnSourceFile, f.fnSourceLine)

# A body returning TagTask(...) produces a tagged task pointer — its callers'
# PTR_IS_TASK fires; the function cannot be sync regardless of its Calls.
fun siReturnsTaggedTask(f: CgFunction): Bool
  ret any(f.fnOps, siOpReturnsTagTask)

fun siOpReturnsTagTask(op: Op): Bool
  ret match(op)
    (r: OpReturn) => match(r.returnValue)
      (tt: RpTagTask) => true
      (o: RParam)      => false
    (o: Op)       => false

fun siHasNoNontailCalls(f: CgFunction): Bool
  ret !any(f.fnOps, siOpIsNontailCallish)

fun siOpIsNontailCallish(op: Op): Bool
  ret match(op)
    (c: OpCall)          => !c.callMusttail
    (pc: OpParallelCall) => true
    (o: Op)              => false

fun siSeedable(f: CgFunction): Bool
  ret f.fnSync
      || (isNoneStr(f.fnForeignSymbol)
          && !siReturnsTaggedTask(f)
          && siHasNoNontailCalls(f))

fun isNoneStr(s2: String|None): Bool
  ret match(s2)
    (x: String) => false
    ()           => true

# ── the fixed point ──────────────────────────────────────────────────────────

# The sync names are a membership set — every reader asks "is this name in
# it" — so it is a Set, and the fixpoint's "did anything get added" is its
# size rather than a co-walk over two chains.
fun [tail] siFixpoint(a: CgApp, impls: List<SlotFuncs>, syncSet: Set<String>): Set<String>
  let grown = fold(appFunctions(a), syncSet,
                   (acc: Set<String>, f: CgFunction) => siTryAdd(acc, f, impls))
  ret size<String>(grown) == size<String>(syncSet) ? grown : siFixpoint(a, impls, grown)

# Foreign functions have empty bodies (all([]) would falsely qualify) — their
# sync-ness comes only from the programmer seed.
fun siTryAdd(acc: Set<String>, f: CgFunction, impls: List<SlotFuncs>): Set<String>
  if contains<String>(acc, f.fnName)
    ret acc
  if !isNoneStr(f.fnForeignSymbol) || siReturnsTaggedTask(f)
    ret acc
  ret siBodyIsSync(f, acc, impls) ? add<String>(acc, f.fnName) : acc

fun siBodyIsSync(f: CgFunction, syncSet: Set<String>, impls: List<SlotFuncs>): Bool
  ret !any(f.fnOps, (op: Op) => siOpBlocksSync(op, syncSet, impls))

fun siOpBlocksSync(op: Op, syncSet: Set<String>, impls: List<SlotFuncs>): Bool
  ret match(op)
    (pc: OpParallelCall) => true
    (c: OpCall)          => !c.callMusttail && !siCallIsSync(c, syncSet, impls)
    (o: Op)              => false

fun siCallIsSync(c: OpCall, syncSet: Set<String>, impls: List<SlotFuncs>): Bool
  ret match(c.callFunction)
    (gf: RpGlobalFunction)  => contains<String>(syncSet, gf.name)
    (vf: RpVirtualFunction) => siVirtualIsSync(vf.name, syncSet, impls)
    (o: RParam)             => false

fun siVirtualIsSync(name: String, syncSet: Set<String>, impls: List<SlotFuncs>): Bool
  let names = gfSlotLookup(impls, name)
  ret !isEmpty(names) && !any(names, (n: String) => !contains<String>(syncSet, n))
