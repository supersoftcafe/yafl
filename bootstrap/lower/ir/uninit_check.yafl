# bootstrap/uninit_check.yafl — definite-assignment validation, ported from
# lowering/uninit_check.py: a forward dataflow where each program point
# carries the set of StackVars definitely initialised on EVERY path reaching
# it (meet = intersection at joins); any op reading outside its entry set is
# a codegen bug. Params initialise on entry; unreachable ops are skipped.
# Phis read nothing unconditionally (their target writes on block entry);
# a per-edge pass verifies each Phi source against its predecessor's exit
# set. IfTask writes task_lhs/call_id_lhs only on the TAKEN branch.
# Python raises; the port returns violation strings for the driver.
namespace Bootstrap::Lower::Ir

import System

import Bootstrap::Ast

import Bootstrap::Codegen
import Bootstrap::Ir
import Bootstrap::Parse
import Bootstrap::StdlibCandidates
import Bootstrap::Types



fun checkApplication(a: CgApp): List<String>
  ret fold(a.appFunctions, List<String>(), ucCheckOne)

fun ucCheckOne(acc: List<String>, f: CgFunction): List<String>
  ret isNoneStr(f.fnForeignSymbol) ? concat(acc, ucCheckFunction(f)) : acc

# entry[i]: Unreached until the fixpoint first reaches ops[i].
enum InitSet
  enum IsUnreached()
  enum IsSet(isNames: List<String>)

# The dataflow state is DICT-backed (user ruling 2026-07-22): entry[i]
# updates were whole-list rebuilds and reads O(i) walks — quadratic per
# worklist step at self-host scale. Absent key = Unreached; ops snapshot in
# a Dict<Int, Op> for O(log n) random access at jump targets.
class [final] UcIx(uiOps: Dict<Int, Op>, uiN: Int)

fun ucIndexOps(ops: List<Op>): UcIx
  let built = ucIxLoop(chain(ops), 0, Dict<Int, Op>())
  ret UcIx(built.d, built.n)

# The op count rides the indexing walk (no-length ruling).
fun [tail] ucIxLoop(os: Chain<Op>, i: Int, acc: Dict<Int, Op>): (d: Dict<Int, Op>, n: Int)
  ret match(os)
    (nil: ChainEnd) => (acc, i)
    (l: ChainLink)  => ucIxLoop(l.next, i + 1, put(acc, i, l.value))

fun ucIxOp(ix: UcIx, i: Int): Op
  ret match(get(ix.uiOps, i))
    (op: Op) => op
    ()       => OpReturnVoid(List<RParam>())   # unreachable: 0 <= i < uiN

fun ucEntryAt(entry: Dict<Int, InitSet>, i: Int): InitSet
  ret match(get(entry, i))
    (s2: InitSet) => s2
    ()            => IsUnreached()

# entry[i] = names DEFINITELY initialised on entry to ops[i] (must-dataflow;
# absent key = unreachable). Shared by the checker below and by async_lower's
# zero-init repair, so both see identical semantics.
fun ucComputeEntrySets(f: CgFunction): Dict<Int, InitSet>
  let labels = ucLabelIndex(f.fnOps)
  let params = map(cgFieldsOfOrEmpty(f.fnParams), ucKeyField)
  let ix = ucIndexOps(f.fnOps)
  let entry0 = put(Dict<Int, InitSet>(), 0,
                   IsSet(sort<String>(params)))
  ret ucFixpoint(ix, labels, entry0, list1(0))

fun ucCheckFunction(f: CgFunction): List<String>
  if isEmpty(f.fnOps)
    ret List<String>()
  let labels = ucLabelIndex(f.fnOps)
  let entry = ucComputeEntrySets(f)
  ret concat(ucVerify(f, entry), ucCheckPhiSources(f, labels, entry))

# Label name → op index. A Dict, not a scan list: ucLabelAt is consulted once
# per CFG edge inside BOTH fixpoints (here and async_lower's liveness), so a
# linear filter made every successor lookup O(labels). Python indexes the same
# mapping as a dict (async_lower.py `labels`), and — like a dict — a repeated
# label name keeps the LAST index.
fun ucLabelIndex(ops: List<Op>): Dict<String, Int>
  ret ucLabelLoop(chain(ops), 0, Dict<String, Int>())

fun [tail] ucLabelLoop(os: Chain<Op>, i: Int, acc: Dict<String, Int>): Dict<String, Int>
  ret match(os)
    (nil: ChainEnd) => acc
    (l: ChainLink)  => ucLabelLoop(l.next, i + 1, ucLabelPut(acc, l.value, i))

fun ucLabelPut(acc: Dict<String, Int>, op: Op, i: Int): Dict<String, Int>
  ret match(op)
    (lb: OpLabel) => put(acc, lb.labelName, i)
    (o: Op)       => acc

fun ucLabelAt(labels: Dict<String, Int>, name: String): Int|None
  ret get(labels, name)

# ── CFG successors ───────────────────────────────────────────────────────────

fun ucSuccessors(ix: UcIx, labels: Dict<String, Int>, i: Int): List<Int>
  let n = ix.uiN
  ret match(ucIxOp(ix, i))
    (r: OpReturn)      => List<Int>()
    (rv: OpReturnVoid) => List<Int>()
    (a: OpAbort)       => List<Int>()
    (c: OpCall)        => c.callMusttail ? List<Int>() : ucFall(i, n)
    (j: OpJump)        => ucLabelOnly(labels, j.jumpName)
    (ji: OpJumpIf)     => concat(ucLabelOnly(labels, ji.jumpIfLabel), ucFall(i, n))
    (t2: OpIfTask)     => concat(ucLabelOnly(labels, t2.taskTarget), ucFall(i, n))
    # Codegen emits `default: abort()`: successors are exactly the cases.
    (sw: OpSwitchJump) => fold(sw.switchCases, List<Int>(),
                               (acc: List<Int>, cs: OpCase) => concat(acc, ucLabelOnly(labels, cs.caseLabel)))
    (o: Op)            => ucFall(i, n)

fun ucFall(i: Int, n: Int): List<Int>
  ret i + 1 < n ? list1(i + 1) : List<Int>()

fun ucLabelOnly(labels: Dict<String, Int>, name: String): List<Int>
  ret match(ucLabelAt(labels, name))
    (x: Int) => list1(x)
    ()        => List<Int>()

# ── per-op reads/writes for the dataflow ─────────────────────────────────────

# Phi: zero unconditional reads, target written on block entry (sources are
# checked per-edge below). IfTask: get_live_vars omits task_lhs/call_id_lhs;
# they land only on the taken branch.
#
# Sets key by NAME + TYPE (ucKey), matching Python's frozenset of StackVar
# dataclasses exactly: a variable written at one precision and read at
# another must NOT unify — that (type,name) strictness is how Python caught
# the bool-slot precision bug (TODO.md OPEN 2026-07-17).
fun ucKey(sv: RParam): String
  ret stackVarName(sv) + "|" + irMangle(rpGetType(sv))

fun ucKeyField(fld: CgField): String
  ret fld.fieldName + "|" + irMangle(fld.fieldType)

fun ucTakeKey(acc: List<String>, sv: RParam): List<String>
  ret match(sv)
    (s2: RpStackVar) => append(acc, ucKey(sv))
    (o: RParam)       => acc

fun ucReads(op: Op): List<String>
  ret match(op)
    (ph: OpPhi) => List<String>()
    (o: Op)     => fold(opReadStackVars(op), List<String>(), ucTakeKey)

fun ucWrites(op: Op): List<String>
  ret fold(ssavOpWrites(op), List<String>(), ucTakeKey)

fun ucBranchOnlyWrites(op: Op): List<String>
  ret match(op)
    (t2: OpIfTask) => fold(list2(t2.taskLhs, t2.callIdLhs), List<String>(), ucTakeKey)
    (o: Op)        => List<String>()

# ── the fixpoint ─────────────────────────────────────────────────────────────

# ONE self-recursive stepper — the fixpoint/step/flow trio was a mutual
# recursion ([tail] refuses those), burning three C frames per worklist item:
# an -O3 mega-function's worklist overflowed the standard 8MB stack. Fused,
# the loop is [tail] and runs in constant stack.
fun [tail] ucFixpoint(ix: UcIx, labels: Dict<String, Int>,
                      entry: Dict<Int, InitSet>, worklist: List<Int>): Dict<Int, InitSet>
  if isEmpty(worklist)
    ret entry
  let i = headIntOr(worklist, 0)
  let rest = tail(worklist)
  let cur = ucEntryAt(entry, i)
  if cur is IsUnreached
    ret ucFixpoint(ix, labels, entry, rest)
  let e2 = ucNamesOf(cur)
  let op = ucIxOp(ix, i)
  let writes = ucWrites(op)
  let branchOnly = ucBranchOnlyWrites(op)
  let exitFall = fold(filter(writes,
                             (w: String) => !strListMember(branchOnly, w)),
                      e2, strListAdd)
  let exitBranch = fold(writes, e2, strListAdd)
  let out = fold(ucSuccessors(ix, labels, i), (entry, rest),
                 (acc: (e: Dict<Int, InitSet>, w: List<Int>), succ: Int) =>
                   ucJoinInto(acc.e, acc.w, succ,
                              ucIsBranchTarget(op, labels, succ) ? exitBranch : exitFall))
  ret ucFixpoint(ix, labels, out.e, out.w)

fun headIntOr(l: List<Int>, dflt: Int): Int
  ret match(head(l))
    (i: Int) => i
    ()        => dflt

fun ucNamesOf(s2: InitSet): List<String>
  ret match(s2)
    (i: IsSet)       => i.isNames
    (u: IsUnreached) => List<String>()   # unreachable: caller tested

fun ucIsBranchTarget(op: Op, labels: Dict<String, Int>, succ: Int): Bool
  ret match(op)
    (ji: OpJumpIf)     => ucLabelIs(labels, ji.jumpIfLabel, succ)
    (t2: OpIfTask)     => ucLabelIs(labels, t2.taskTarget, succ)
    (sw: OpSwitchJump) => any(sw.switchCases, (cs: OpCase) => ucLabelIs(labels, cs.caseLabel, succ))
    (o: Op)            => false

fun ucLabelIs(labels: Dict<String, Int>, name: String, succ: Int): Bool
  ret match(ucLabelAt(labels, name))
    (x: Int) => x == succ
    ()        => false

# meet = intersection; a change re-queues the successor.
fun ucJoinInto(entry: Dict<Int, InitSet>, worklist: List<Int>, succ: Int,
               incoming: List<String>): (e: Dict<Int, InitSet>, w: List<Int>)
  ret match(ucEntryAt(entry, succ))
    (u: IsUnreached) => (put(entry, succ, IsSet(incoming)), append(worklist, succ))
    (s2: IsSet)      => ucJoinExisting(entry, worklist, succ, s2.isNames, incoming)

fun ucJoinExisting(entry: Dict<Int, InitSet>, worklist: List<Int>, succ: Int,
                   old: List<String>, incoming: List<String>): (e: Dict<Int, InitSet>, w: List<Int>)
  let met = filter(old, (n: String) => strListMember(incoming, n))
  ret sameLen(chain(met), chain(old))
    ? (entry, worklist)
    : (put(entry, succ, IsSet(met)), append(worklist, succ))

# ── verification ─────────────────────────────────────────────────────────────

fun ucVerify(f: CgFunction, entry: Dict<Int, InitSet>): List<String>
  ret ucVerifyLoop(f, chain(f.fnOps), entry, 0, List<String>())

fun [tail] ucVerifyLoop(f: CgFunction, os: Chain<Op>, entry: Dict<Int, InitSet>,
                        i: Int, acc: List<String>): List<String>
  ret match(os)
    (nil: ChainEnd) => acc
    (l: ChainLink)  => match(ucEntryAt(entry, i))
      (u: IsUnreached) => ucVerifyLoop(f, l.next, entry, i + 1, acc)
      (e2: IsSet)      => ucVerifyLoop(f, l.next, entry, i + 1,
                            concat(acc, ucVerifyOp(f, l.value, i, e2.isNames)))

fun ucVerifyOp(f: CgFunction, op: Op, i: Int, e2: List<String>): List<String>
  let missing = filter(ucReads(op), (n: String) => !strListMember(e2, n))
  ret isEmpty(missing)
    ? List<String>()
    : list1(f.fnName + ": uninitialised StackVar read at op #" + String(i)
            + "; missing: [" + join(sort<String>(missing), ", ")
            + "] — codegen bug: read-before-write, or the variable should be in the task-heap state object")

# ── per-edge Phi verification ────────────────────────────────────────────────

class [final] PhiEdge(pheFrom: String, pheTo: String, pheExit: List<String>)

fun ucCheckPhiSources(f: CgFunction, labels: Dict<String, Int>, entry: Dict<Int, InitSet>): List<String>
  let phiBlocks = ucPhiBlocks(f.fnOps)
  if isEmpty(phiBlocks)
    ret List<String>()
  let edges = ucPhiEdges(f.fnOps, entry, phiBlocks)
  ret fold(edges, List<String>(), (acc: List<String>, ed: PhiEdge) =>
        concat(acc, ucCheckEdge(f, phiBlocks, ed)))

# Phi ops indexed by their enclosing block label.
class [final] PhiBlock(phbLabel: String, phbPhis: List<Op>)

fun ucPhiBlocks(ops: List<Op>): List<PhiBlock>
  ret ucPhiBlocksLoop(chain(ops), "", List<PhiBlock>())

fun [tail] ucPhiBlocksLoop(ops: Chain<Op>, current: String, acc: List<PhiBlock>): List<PhiBlock>
  ret match(ops)
    (nil: ChainEnd) => acc
    (l: ChainLink)  => match(l.value)
      (lb: OpLabel) => ucPhiBlocksLoop(l.next, lb.labelName, acc)
      (ph: OpPhi)   => length(current) > 0
        ? ucPhiBlocksLoop(l.next, current, ucPhiBlockAdd(acc, current, l.value))
        : ucPhiBlocksLoop(l.next, current, acc)
      (o: Op)       => ucPhiBlocksLoop(l.next, current, acc)

fun ucPhiBlockAdd(acc: List<PhiBlock>, label: String, ph: Op): List<PhiBlock>
  ret any(acc, (b: PhiBlock) => b.phbLabel == label)
    ? map(acc, (b: PhiBlock) => b.phbLabel == label ? PhiBlock(label, append(b.phbPhis, ph)) : b)
    : append(acc, PhiBlock(label, list1(ph)))

fun ucIsPhiBlock(phiBlocks: List<PhiBlock>, name: String): Bool
  ret any(phiBlocks, (b: PhiBlock) => b.phbLabel == name)

# Every edge from a labelled block into a Phi block, with the exit set at the
# transfer point (fall-through edges use the PREVIOUS op's entry|writes).
fun ucPhiEdges(ops: List<Op>, entry: Dict<Int, InitSet>, phiBlocks: List<PhiBlock>): List<PhiEdge>
  ret ucPhiEdgesLoop(chain(ops), entry, phiBlocks, 0, "", None, List<PhiEdge>())

fun [tail] ucPhiEdgesLoop(os: Chain<Op>, entry: Dict<Int, InitSet>, phiBlocks: List<PhiBlock>,
                          i: Int, current: String, prev: Op|None,
                          acc: List<PhiEdge>): List<PhiEdge>
  ret match(os)
    (nil: ChainEnd) => acc
    (l: ChainLink)  => match(l.value)
      (lb: OpLabel) => ucPhiEdgesLoop(l.next, entry, phiBlocks, i + 1,
                         lb.labelName, lb,
                         ucFallEdge(entry, phiBlocks, i, current, prev, lb,
                                    acc))
      (o: Op)       => ucPhiEdgesLoop(l.next, entry, phiBlocks, i + 1,
                         current, l.value,
                         ucJumpEdges(l.value, entry, phiBlocks, i, current,
                                     acc))

fun ucFallEdge(entry: Dict<Int, InitSet>, phiBlocks: List<PhiBlock>,
               i: Int, current: String, prev0: Op|None, lb: OpLabel,
               acc: List<PhiEdge>): List<PhiEdge>
  if !ucIsPhiBlock(phiBlocks, lb.labelName) || length(current) == 0 || i == 0
    ret acc
  ret match(prev0)
    (prev: Op) => !ucPrevFallsIntoLabel(prev)
      ? acc
      : ucFallEdgeOn(entry, i, current, prev, lb, acc)
    ()         => acc

fun ucFallEdgeOn(entry: Dict<Int, InitSet>, i: Int, current: String,
                 prev: Op, lb: OpLabel, acc: List<PhiEdge>): List<PhiEdge>
  ret match(ucEntryAt(entry, i - 1))
    (u: IsUnreached) => acc
    (pe: IsSet)      => append(acc, PhiEdge(current, lb.labelName,
                                            fold(ucWrites(prev), pe.isNames, strListAdd)))

fun ucPrevFallsIntoLabel(prev: Op): Bool
  ret match(prev)
    (j: OpJump)        => false
    (r: OpReturn)      => false
    (rv: OpReturnVoid) => false
    (a: OpAbort)       => false
    (c: OpCall)        => !c.callMusttail
    (o: Op)            => true

fun ucJumpEdges(op: Op, entry: Dict<Int, InitSet>, phiBlocks: List<PhiBlock>,
                i: Int, current: String, acc: List<PhiEdge>): List<PhiEdge>
  if length(current) == 0
    ret acc
  ret match(ucEntryAt(entry, i))
    (u: IsUnreached) => acc
    (e2: IsSet)      => ucJumpEdgesOn(op, phiBlocks, current,
                                      fold(ucWrites(op), e2.isNames, strListAdd), acc)

fun ucJumpEdgesOn(op: Op, phiBlocks: List<PhiBlock>, current: String,
                  exitHere: List<String>, acc: List<PhiEdge>): List<PhiEdge>
  ret match(op)
    (j: OpJump)        => ucAddEdgeIf(acc, phiBlocks, current, j.jumpName, exitHere)
    (ji: OpJumpIf)     => ucAddEdgeIf(acc, phiBlocks, current, ji.jumpIfLabel, exitHere)
    (t2: OpIfTask)     => ucAddEdgeIf(acc, phiBlocks, current, t2.taskTarget, exitHere)
    (sw: OpSwitchJump) => fold(sw.switchCases, acc,
                               (a: List<PhiEdge>, cs: OpCase) => ucAddEdgeIf(a, phiBlocks, current, cs.caseLabel, exitHere))
    (o: Op)            => acc

fun ucAddEdgeIf(acc: List<PhiEdge>, phiBlocks: List<PhiBlock>, current: String,
                target: String, exitHere: List<String>): List<PhiEdge>
  ret ucIsPhiBlock(phiBlocks, target)
    ? append(acc, PhiEdge(current, target, exitHere))
    : acc

fun ucCheckEdge(f: CgFunction, phiBlocks: List<PhiBlock>, ed: PhiEdge): List<String>
  ret match(head(filter(phiBlocks, (b: PhiBlock) => b.phbLabel == ed.pheTo)))
    (b: PhiBlock) => fold(b.phbPhis, List<String>(), (acc: List<String>, ph: Op) =>
                       concat(acc, ucCheckPhiEdge(f, ph, ed)))
    ()             => List<String>()

fun ucCheckPhiEdge(f: CgFunction, ph: Op, ed: PhiEdge): List<String>
  ret match(ph)
    (p: OpPhi) => fold(p.phiSources, List<String>(), (acc: List<String>, s2: OpPhiSource) =>
                    s2.sourceLabel == ed.pheFrom
                      ? concat(acc, ucCheckSource(f, ed, s2))
                      : acc)
    (o: Op)     => List<String>()

fun ucCheckSource(f: CgFunction, ed: PhiEdge, s2: OpPhiSource): List<String>
  let missing = filter(fold(rpReadStackVars(s2.sourceValue), List<String>(), ucTakeKey),
                       (n: String) => !strListMember(ed.pheExit, n))
  ret isEmpty(missing)
    ? List<String>()
    : list1(f.fnName + ": Phi at block " + ed.pheTo + ", source from predecessor "
            + ed.pheFrom + " reads uninitialised: ["
            + join(sort<String>(missing), ", ") + "]")
