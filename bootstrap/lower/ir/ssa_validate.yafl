# bootstrap/ssa_validate.yafl — SSA / control-flow / Phi validation, ported
# from lowering/ssa_validate.py. Three invariants from AST lowering to C
# emission: (1) single definition per StackVar (params count once; $sv_* and
# friends are deliberate multi-write scratch; a Move from a type-appropriate
# zero is a declaration, not a redefinition); (2) every path ends in a
# terminator; (3) each Phi sits in the Phi region of a Label whose CFG
# predecessors exactly match its sources. __entrypoint__ is hand-built and
# skipped. Python RAISES SSAValidationError; the port returns the violation
# strings — the driver decides how to die.
namespace Bootstrap::Lower::Ir

import System

import Bootstrap::Ir
import Bootstrap::StdlibCandidates
import Bootstrap::Types



fun ssaValidate(fns: List<CgFunction>, ssa)
  ret fold(fns, List(), (acc, f) => concat(acc, ssavFn(f, ssa)))

fun ssavFn(f: CgFunction, ssa)
  if f.fnName == "__entrypoint__"
    ret List()
  # After phi_removal the IR is deliberately not single-assignment; the final
  # validation checks control flow and termination only.
  ret ssa
    ? concat(ssavSingleDefinition(f), concat(ssavPhiWellFormed(f), ssavAllPathsReturn(f)))
    : ssavAllPathsReturn(f)

# ── single definition ────────────────────────────────────────────────────────

# Async-lowering reuses fixed scratch slots across call sites — deliberate
# multi-write.
fun ssavIsScratchSlot(name) => startsWith(name, "$sv_") || startsWith(name, "$wrap$")
    || startsWith(name, "$sm_wrap$") || startsWith(name, "$musttail$ret$")
    || name == "$state" || name == "$completed_task"

# A Move from a type-appropriate zero is a GC-safety / state-machine
# pre-initialisation — logically a declaration, not a redefinition.
fun ssavIsZeroInit(op) => match(op)
  (m: OpMove) => ssavIsZeroSource(m.moveSource)
  (o: Op)     => false

fun ssavIsZeroSource(src) => match(src)
  (np: RpNullPointer) => true
  (z: RpZeroOf)       => true
  (i: RpInteger)      => i.value == 0
  (f: RpFloat)        => f.value == 0.0
  (o: RParam)         => false

# Each parameter is defined once, on entry; each op defines what it writes.
fun ssavCollectWriteCounts(f: CgFunction): Dict<String, Int>
  let fromParams = fold(cgFieldsOfOrEmpty(f.fnParams), Dict(),
                        (acc, fld) => put(acc, fld.fieldName, 1))
  ret fold(f.fnOps, fromParams, ssavCountOp)

fun ssavCountOp(acc: Dict<String, Int>, op): Dict<String, Int> => ssavIsZeroInit(op)
  ? acc
  : fold(opGetLiveVars(op).writes, acc, ssavCountTarget)

fun ssavCountTarget(acc: Dict<String, Int>, target): Dict<String, Int> => match(target)
  (sv: RpStackVar) => sdBump(acc, sv.name)
  (o: RParam)       => acc

fun ssavSingleDefinition(f: CgFunction): List<String>
  let counts = ssavCollectWriteCounts(f)
  let multi = filter(keys(counts), (name) => ssavCount(counts, name) > 1 && !ssavIsScratchSlot(name))
  if isEmpty(multi)
    ret List()
  # In order of first definition, as Python reports its dict.
  let first = ssavFirstDefinitions(f)
  let violations = sortBy(multi, (x, y) => ssavCount(first, x) < ssavCount(first, y))
  ret list1(f.fnName + ": SSA single-definition invariant violated: "
            + join(map(violations, (name) => name + " defined " + String(ssavCount(counts, name)) + " times"), "; "))

fun ssavCount(counts: Dict<String, Int>, name: String): Int => get(counts, name) ?? 0

# Each defined name -> the position of its first definition: parameters
# first, then the ops' writes in order.
fun ssavFirstDefinitions(f: CgFunction): Dict<String, Int>
  let fromParams = fold(cgFieldsOfOrEmpty(f.fnParams), (Dict(), 0),
                        (acc: (at: Dict<String, Int>, n: Int), fld) => (ssavFirstAt(acc.at, fld.fieldName, acc.n), acc.n + 1))
  ret fold(f.fnOps, fromParams,
           (acc: (at: Dict<String, Int>, n: Int), op) =>
             (fold(opGetLiveVars(op).writes, acc.at, (d, w) => ssavFirstAtVar(d, w, acc.n)), acc.n + 1)).at

fun ssavFirstAtVar(at: Dict<String, Int>, w, n: Int): Dict<String, Int> => match(w)
  (sv: RpStackVar) => ssavFirstAt(at, sv.name, n)
  (o: RParam)      => at

fun ssavFirstAt(at: Dict<String, Int>, name: String, n: Int): Dict<String, Int>
  ret contains(at, name) ? at : put(at, name, n)

# ── all paths return ─────────────────────────────────────────────────────────

# No path may fall off the end of the function: its last op must not fall
# through. A function with no ops is an extern declaration.
fun ssavAllPathsReturn(f: CgFunction): List<String> => match(lastOp(f.fnOps))
  (op: Op) => opFallsThrough(op)
    ? list1(f.fnName + ": function does not end in a terminator op — control would fall off the end")
    : List()
  ()        => List()

# Seq twin: hop to the last segment, read its final element.
fun [tail] lastOp(s: Segment<Op>|None): Op|None => match(s)
  (nil: None)        => None
  (seg: Segment<Op>) => match(seg.next)
    (n2: Segment<Op>) => lastOp(seg.next)
    (nil2: None)      => seg.length > 0i32 ? seg.array(seg.length - 1i32) : None

fun [tail] lastOp(ops: Chain<Op>): Op|None => match(ops)
  (nil: ChainEnd) => None
  (l: ChainLink)  => match(l.next)
    (nil2: ChainEnd) => l.value
    (l2: ChainLink)  => lastOp(l.next)

# ── Phi well-formedness ──────────────────────────────────────────────────────

# Walk ops tracking the current label and whether we are still in its Phi
# region (Labels open one; any non-Phi op closes it).
fun ssavPhiWellFormed(f: CgFunction): List<String>
  let preds = cgBlockPredecessors(f)
  let p0 = cgPullOp(seqStream(f.fnOps))
  ret ssavPhiLoop(p0.op, p0.stream, preds, f.fnName, "", false, List())

fun [tail] ssavPhiLoop(cur: Op|None, st: SeqStream<Op>, preds: List<PredEntry>, fname,
                       current, inRegion, acc: List<String>): List<String>
  if cur is None
    ret acc
  let op = forceOp(cur)
  let p = cgPullOp(st)
  ret match(op)
    (lb: OpLabel) => ssavPhiLoop(p.op, p.stream, preds, fname, lb.labelName, true, acc)
    (ph: OpPhi)   => ssavPhiLoop(p.op, p.stream, preds, fname, current, inRegion,
                                 concat(acc, ssavPhiCheck(ph, preds, fname, current, inRegion)))
    (o: Op)       => ssavPhiLoop(p.op, p.stream, preds, fname, current, false, acc)

fun ssavPhiCheck(ph: OpPhi, preds: List<PredEntry>, fname,
                 current, inRegion): List<String>
  if !inRegion || length(current) == 0
    ret list1(fname + ": Phi appears outside the Phi region of any block")
  let expected = filter(predsOf(preds, current), (s2) => length(s2) > 0)
  let sources = map(ph.phiSources, (s2) => s2.sourceLabel)
  let missing = filter(expected, (s2) => !strListMember(sources, s2))
  let extra = filter(sources, (s2) => !contains(expected, s2))
  ret isEmpty(missing) && isEmpty(extra)
    ? List()
    : list1(fname + ": Phi @ " + current + " has mismatched sources; missing: ["
            + join(sort(missing), ", ") + "]; extra: ["
            + join(sort(extra), ", ") + "]")
