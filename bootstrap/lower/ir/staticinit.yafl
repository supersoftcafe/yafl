# bootstrap/staticinit.yafl — ported from lowering/staticinit.py. Objects
# built from constants become static globals (promote_static_objects), and a
# flat-struct global's init has the globals it reads replaced by their
# constants (resolve_flat_struct_global_inits). Both read constants, and
# write statics, with literal discovery's interpreter and emitter
# (literal_discovery.yafl): one model of what a constant is.
namespace Bootstrap::Lower::Ir

import System
import System::Containers

import Bootstrap::Ast

import Bootstrap::Codegen
import Bootstrap::Ir
import Bootstrap::Parse
import Bootstrap::StdlibCandidates



fun resolveFlatStructGlobalInits(a: CgApp)
  ret appOf(appFunctions(a), appObjects(a),
            map(appGlobals(a), (g2) => siResolveGlobal(g2, a)))

fun siResolveGlobal(g2, a: CgApp)
  if !isNoneStr(g2.globalObjectName) || !isNoneStr(g2.globalLazyInitFunction)
    ret g2
  ret match(g2.globalInit)
    (init: RParam) => match(init)
      (ns: RpNewStruct) => match(siResolvedConstants(init, a))
        (r: RParam)  => CgGlobal(g2.globalName, g2.globalType, r, g2.globalObjectName,
                                 g2.globalLazyInitFunction, g2.globalLazyInitFlag)
        (e: LdFail)  => g2
      (o: RParam)       => g2
    ()              => g2

# `val` with each global it reads replaced by that global's constant (literal
# discovery's reading of it).
fun siResolvedConstants(val: RParam, a: CgApp): RParam|LdFail => match(val)
  (gv: RpGlobalVar) => ldGlobalValue(a, gv.name) ?> (v: LdVal) =>
    ldEmit(a, ldStEmpty(), ldEmNew(Dict(), 0, ldStaticPrefix(), Dict()), v, gv.fieldType, true)
      ?> (out: LdEmitted) => out.edRp
  (ns: RpNewStruct) => fold<RpNamedValue, List<RpNamedValue>|LdFail>(ns.values, List<RpNamedValue>(),
                            (acc: List<RpNamedValue>|LdFail, nv) => acc ?> (got: List<RpNamedValue>) =>
                              siResolvedConstants(nv.value, a) ?> (r: RParam) => append(got, RpNamedValue(nv.name, r)))
    ?> (vs: List<RpNamedValue>) => RpNewStruct(vs)
  (i: RpInteger)    => val
  (s2: RpString)    => val
  (o: RParam)       => LdFail(ldOpaque())

# ── the -O1 half (promote_static_objects + inline_single_use_globals +
# convert_static_objects_pass) ────────────────────────────────────────────────
#
# PYTHON QUIRK MIRRORED: `_si_counter` is module-level, so $si$N numbering is
# GLOBAL across all functions and all four pass rounds, starting at 0 per
# compile. The port threads the counter explicitly.

# ── one function's promotions ───────────────────────────────────────────────
#
# Stage 2 of literal discovery (literal_discovery.yafl): each construction
# whose value is a literal becomes a static global, and the construction a
# load of it. The constructions are literal discovery's — an unpinned
# NewObject whose stores are all fresh initialisation stores, every one
# constant, other constructions included — so a whole graph goes static,
# children first, in op order. Its emitter writes the statics: never a pinned
# object, never a [pinnable] one a late write could still fill (an array is
# trimmed to its length first, as compaction would).


class [final] SiPromoAcc(saKnown: Dict<Int, String>, saCounter: Int, saGlobals: List<CgGlobal>,
                    saPromoted: Dict<String, RParam>)

fun siPromoteOne(f: CgFunction, a: CgApp,
                 counter: Int): (fn: CgFunction, globals: List<CgGlobal>, counter: Int)
  let made = ldConstsOf(a, ldStEmpty(), f.fnOps)
  let conses = ldConstructions(f.fnOps, ldOnce(f.fnOps))
  let out = fold(conses, SiPromoAcc(Dict(), counter, List(), Dict()), (acc, cons) => match(get(made.coConsts.lcValues, cons.cnName))
    (v: LdVal) => siPromoteValue(a, made.coSt, acc, cons.cnName, v)
    ()         => acc)
  if isEmpty(out.saPromoted)
    ret (f, List(), counter)
  let ops = fold(f.fnOps, Array<Op>(), (arr, op) => siPromotedOp(arr, op, out.saPromoted))
  ret (cgFunctionWith(f, ops, f.fnStackVars), out.saGlobals, out.saCounter)

fun siPromoteValue(a: CgApp, st: LdSt, acc: SiPromoAcc, name: String, v: LdVal): SiPromoAcc
  ret match(ldEmit(a, st, ldEmNew(acc.saKnown, acc.saCounter, "$si$", Dict()), v, CgDataPointer(false), false))
    (out: LdEmitted) => SiPromoAcc(fold(keys(out.edEm.emNames), acc.saKnown,
                                   (d, k) => put(d, k, get(out.edEm.emNames, k) ?? "")),
                              out.edEm.emCounter,
                              concat(acc.saGlobals, out.edEm.emGlobals),
                              put(acc.saPromoted, name, out.edRp))
    (e: LdFail)      => acc

fun siPromotedOp(arr: Array<Op>, op: Op, promoted: Dict<String, RParam>): Array<Op> => match(op)
  (no: OpNewObject) => match(no.newObjRegister)
    (sv: RpStackVar) => match(get(promoted, sv.name))
      (rp: RParam) => push(arr, OpMove(no.newObjRegister, rp, false, Dict()))
      ()           => push(arr, op)
    (o: RParam)      => push(arr, op)
  (m: OpMove)       => match(m.moveTarget)
    (of: RpObjectField) => match(of.pointer)
      (sv: RpStackVar) => contains(promoted, sv.name) ? arr : push(arr, op)
      (o: RParam)      => push(arr, op)
    (o: RParam)         => push(arr, op)
  (o: Op)           => push(arr, op)


# Python merge order: globals = {**all_new_globals, **app.globals} — the NEW
# globals come FIRST in iteration order, then the old (order matters for
# emission).
fun siPromoteStaticObjects(a: CgApp, counter: Int): (app: CgApp, counter: Int)
  let out = siPsLoop(appFunctions(a), a, counter)
  ret (appOf(out.fns, appObjects(a), concat(out.globals, appGlobals(a))),
       out.counter)

# Functions in app order, and the globals each one promoted after it — both
# orders are emission order.
fun siPsLoop(fs: List<CgFunction>, a: CgApp,
             counter): (fns: List<CgFunction>, globals: List<CgGlobal>, counter: Int) =>
  fold(fs, (fns = List<CgFunction>(), globals = List<CgGlobal>(), counter = counter),
       (st, f) =>
         siPromoteOne(f, a, st.counter)
           |> (out) => (fns = append(st.fns, out.fn), globals = concat(st.globals, out.globals),
                        counter = out.counter))

# ── inline_single_use_globals ───────────────────────────────────────────────

# The globals a value or an op reads. Writes are not counted: a static object
# is a constant, so no op writes one, and single use is about its readers.
fun siGlobalsReadByRp(val) => siGlobalNames(rpFlatten(val, true))

fun siGlobalsReadByOp(op) => siGlobalNames(opAllParams(op))

fun siGlobalNames(params: List<RParam>) => fold(params, List(), siAddGlobal)

fun siAddGlobal(acc: List<String>, p: RParam) => match(p)
  (gv: RpGlobalVar) => siAddName(acc, gv.name)
  (o: RParam)       => acc

# Names are deduped ON THE LIST, deliberately — NOT by building a Set. An op
# mentions a handful of globals at most, and this runs for every op of every
# function on every static round: four sweeps of the whole program. A Set is a
# hash-tree allocation per op, which is precisely the per-op allocation the
# srFirstFn sweep below was introduced to remove. A linear scan over three or
# four names allocates nothing but the cons cells, and the order is not
# observed — both consumers fold these into Dicts.
fun siAddName(acc, n): List<String> => any(acc, (y) => y == n) ? acc : prepend(n, acc)

# Reference counts per global name, AND the first function whose ops mention
# each name — both from ONE sweep.
#
# The first-referencing map exists so siTryFold does not re-scan the whole
# application per candidate global. That search was globals x functions x ops,
# allocating a fresh List<String> per op in siGlobalsReadByOp, and it dominated
# compilation: measured on the self-host, the four convertStaticObjectsPass
# rounds were 1777s of a 2586s compile (69%). This sweep already visits every
# op, so recording the first function costs nothing and makes the lookup
# O(log n).
class [final] SiRefs(srCounts: Dict<String, Int>, srFirstFn: Dict<String, String>)

fun siCountGlobalRefs(a: CgApp)
  let fromOps = fold(appFunctions(a),
                     SiRefs(Dict(), Dict()),
                     siCountFn)
  ret SiRefs(fold(appGlobals(a), fromOps.srCounts, siCountGlobal),
             fromOps.srFirstFn)

fun siCountFn(acc: SiRefs, f: CgFunction)
  ret fold(f.fnOps, acc, (a2, op) => siCountOp(a2, op, f.fnName))

fun siCountOp(acc: SiRefs, op, fnName: String)
  ret fold(siGlobalsReadByOp(op), acc,
           (a3, n) =>
             SiRefs(sdBump(a3.srCounts, n), siFirstSeen(a3.srFirstFn, n, fnName)))

# FIRST in iteration order — the same function the old per-candidate scan
# would have stopped at, since both walk appFunctions in order.
fun siFirstSeen(m, name: String,
                fnName: String) => match(get(m, name))
  (seen: String) => m
  ()             => put(m, name, fnName)

fun siCountGlobal(acc: Dict<String, Int>, g2: CgGlobal)
  let withInit = match(g2.globalInit)
    (init: RParam) => fold(siGlobalsReadByRp(init), acc, sdBump)
    ()             => acc
  ret match(g2.globalLazyInitFlag)
    (flag: String) => sdBump(withInit, flag)
    ()             => withInit

fun [tail] siTraceToGlobal(val, vmap: FunValues) => match(val)
  (gv: RpGlobalVar) => gv.name
  (sv: RpStackVar)  => match(gfFvLookup(vmap, sv.name))
    (src: RParam) => siTraceToGlobal(src, vmap)
    ()            => None
  (o: RParam)       => None

# fn does nothing but copy the source global to the target global.
fun siIsTrivialCopyFn(f: CgFunction, source, target)
  if any(f.fnOps, siHardOp)
    ret false
  let writes = filter(f.fnOps, (op) => siWritesGlobal(op, target))
  if !exactly(writes, 1)
    ret false
  ret match(nthOf(writes, 0))
    (m: OpMove) => match(siTraceToGlobal(m.moveSource, gfFunValueMap(f)))
      (traced: String) => traced == source
      ()               => false
    ()          => false

# Rules out a trivial copy function: it calls, allocates or branches.
fun siHardOp(op) => match(op)
  (c: OpCall)              => true
  (no: OpNewObject)        => true
  (ji: OpJumpIf)           => true
  (x: OpLabel)             => false
  (x: OpMove)              => false
  (x: OpJump)              => false
  (x: OpIfTask)            => false
  (x: OpAssertNotTask)     => false
  (x: OpSwitchJump)        => false
  (x: OpAwait)             => false
  (x: OpReturnVoid)        => false
  (x: OpAbort)             => false
  (x: OpReturn)            => false
  (x: OpPhi)               => false
  (x: OpProfEnter)         => false
  (x: OpProfLeave)         => false

fun siWritesGlobal(op, name) => match(op)
  (m: OpMove) => match(m.moveTarget)
    (gv: RpGlobalVar) => gv.name == name
    (o: RParam)       => false
  (o: Op)     => false

# One committed fold: si global removed, init fn removed, target rewritten.
class [final] SiFold(sfSi: String, sfFn: String, sfTarget: String,
                     sfNew: CgGlobal)

fun siInlineSingleUseGlobals(a: CgApp)
  let refs = siCountGlobalRefs(a)
  # Both of these are built ONCE per round. appGlobals() is not a field read —
  # it sorts every global name — so calling it per candidate made this pass
  # quadratic in the number of globals.
  let globals = appGlobals(a)
  let lazyTargets = siLazyTargets(globals)
  let folds = fold(globals, List(),
                   (acc, g2) =>
                     siTryFold(acc, g2, a, refs, lazyTargets))
  if isEmpty(folds)
    ret a
  ret appOf(filter(appFunctions(a),
                   (f) => !any(folds,
                               (fd) => fd.sfFn == f.fnName)),
            appObjects(a),
            map(filter(appGlobals(a),
                       (g2) => !any(folds,
                                    (fd) => fd.sfSi == g2.globalName)),
                (g2) => siFolded(g2, folds)))

fun siFolded(g2, folds: List<SiFold>)
  ret match(head(filter(folds,
                        (fd) => fd.sfTarget == g2.globalName)))
    (fd: SiFold) => fd.sfNew
    ()           => g2

# A static global (objectName set, no lazy init) referenced EXACTLY once,
# from a lazy-init function that is a trivial copy into its target.
fun siTryFold(acc: List<SiFold>, g2: CgGlobal, a: CgApp,
              refs: SiRefs,
              lazyTargets: Dict<String, CgGlobal>)
  if g2.globalObjectName is None || !(g2.globalLazyInitFunction is None)
    ret acc
  if sdCountOf(refs.srCounts, g2.globalName) != 1
    ret acc
  # The single referencing function comes from the index built alongside the
  # counts, not a fresh sweep per candidate.
  ret match(get(refs.srFirstFn, g2.globalName))
    (fnName: String) => siFoldAgainst(acc, g2, a, fnName, lazyTargets)
    ()               => acc

fun siFoldAgainst(acc: List<SiFold>, si: CgGlobal, a: CgApp,
                  fnName,
                  lazyTargets: Dict<String, CgGlobal>) => match(get(lazyTargets, fnName))
  (target: CgGlobal) => match(appFunction(a, fnName))
    (f: CgFunction) => siIsTrivialCopyFn(f, si.globalName,
                                         target.globalName)
      # A fold list, scanned by name — order is not observed.
      ? prepend(SiFold(si.globalName, fnName, target.globalName,
                       CgGlobal(target.globalName, target.globalType,
                                si.globalInit, si.globalObjectName,
                                None, None)),
                acc)
      : acc
    ()              => acc
  ()                 => acc

# lazy-init function name -> the global it initialises. This replaced a scan
# of the whole ordered global list per candidate; FIRST wins, matching the
# order that scan walked in.
fun siLazyTargets(globals: List<CgGlobal>) => fold(globals, Dict(), siLazyTargetAdd)

fun siLazyTargetAdd(acc: Dict<String, CgGlobal>,
                    g2: CgGlobal) => match(g2.globalLazyInitFunction)
  (lf: String) => contains(acc, lf) ? acc : put(acc, lf, g2)
  ()           => acc

# One iteration of: promote NewObjects → inline single-use globals → trim.
# One iteration of: promote constructions → settle globals whose initialiser
# is now a constant (literal discovery, unless turned off) → inline
# single-use globals → trim.
fun convertStaticObjectsPass(a: CgApp, counter, settle: Bool): (app: CgApp, counter: Int)
  let p2 = siPromoteStaticObjects(a, counter)
  let settled = settle ? settleGlobals(p2.app) : p2.app
  ret (removedUnusedStuff(siInlineSingleUseGlobals(settled)), p2.counter)
