# bootstrap/sroa.yafl — scalar replacement of aggregates for projection-only
# locals, ported from lowering/sroa.py. A struct local only ever read through
# field projections splits into per-field scalars (v.f → v$f seeded by a Move
# right after v's single SSA definition), so async state roots only the
# genuinely-live fields — the correctness fix for the O(n) suspension leak.
# Runs at every -O level just before async lowering, while still SSA.
# Predicate: sv_reads == proj_reads (any whole use tips sv_reads above),
# single definition by a non-keep Move or a Call (never a Phi), plain
# non-empty struct type (never the async TaskWrapper ABI). Bounded 8 rounds —
# nested aggregates peel one level per round.
namespace Bootstrap::Lower::Ir

import System

import Bootstrap::Codegen
import Bootstrap::Ir
import Bootstrap::StdlibCandidates



fun splitProjectedAggregates(a: CgApp) => appWithFunctions(a, powerMap(appFunctions(a),
                                            (f) => sroaFix(f, Set(), 8)))

fun [tail] sroaFix(f, done: Set<String>, left): CgFunction
  if left == 0
    ret f
  let sp = sroaFindSplittable(f, done)
  ret isEmpty(sp)
    ? f
    : sroaFix(sroaApply(f, sp), fold(sp, done, (d, s2) => add(d, s2.srName)), left - 1)

class [final] Sroa(srName: String, srVar: RParam, srDefIndex: Int,
                   srFields: List<SroaField>)
class [final] SroaField(sfField: String, sfLocal: RParam)

# ── the predicate ────────────────────────────────────────────────────────────

fun sroaFindSplittable(f: CgFunction, done: Set<String>)
  let svReads = sroaSvReads(f.fnOps)
  let projReads = sroaProjReads(f.fnOps)
  let defs = sroaDefs(f.fnOps)
  ret build(sroaConsiderAll(
      chain(sort(keys(defs.sdEntries))),
      done, svReads, projReads, defs, builder()))

# Candidates come out in the sorted name order they are considered in.
fun [tail] sroaConsiderAll(ns: Chain<String>, done: Set<String>,
                           svReads: Dict<String, Int>,
                           projReads: Dict<String, Dict<String, Int>>, defs: SroaDefs,
                           [terminal] acc: ListBuilder<Sroa>) => match(ns)
  (nil: ChainEnd) => acc
  (l: ChainLink)  => sroaConsiderAll(l.next, done, svReads, projReads, defs,
                         sroaConsider(acc, l.value, done, svReads,
                                      projReads, defs))

# Read occurrences: a projection StructField(StackVar v, f) flattens to BOTH
# nodes, so a var whose every read is a projection has sv_reads == proj_total;
# any whole use is a bare StackVar with no enclosing StructField.
fun sroaSvReads(ops: Segment<Op>|None): Dict<String, Int> => fold(ops, Dict(),
                                               (acc, op) => fold(opAllParams(op), acc, sroaSvRead1))

fun sroaSvRead1(acc: Dict<String, Int>, p): Dict<String, Int> => match(p)
  (sv: RpStackVar) => sdBump(acc, sv.name)
  (o: RParam)       => acc

# Projection reads, by var then field.
fun sroaProjReads(ops: Segment<Op>|None): Dict<String, Dict<String, Int>> => fold(ops, Dict(),
                                                 (acc, op) => fold(opAllParams(op), acc, sroaProj1))

fun sroaProj1(acc, p) => match(p)
  (sf: RpStructField) => match(sf.structVal)
    (sv: RpStackVar) => pjIncr(acc, sv.name, sf.field)
    (o: RParam)       => acc
  (o2: RParam)         => acc

fun pjIncr(acc: Dict<String, Dict<String, Int>>, v: String, f: String): Dict<String, Dict<String, Int>>
  ret put(acc, v, sdBump(sroaProjOf(acc, v), f))

fun sroaProjTotal(projected: Dict<String, Int>): Int
  ret fold(keys(projected), 0, (n: Int, fld: String) => n + (get(projected, fld) ?? 0))

fun sroaProjOf(projReads: Dict<String, Dict<String, Int>>, v: String): Dict<String, Int> => get(projReads, v) ?? Dict()

# Single-definition sites (SSA — a name written twice is defensively skipped).
# sdOp is the defining op itself — carried, so the eligibility test does not
# have to index back into fnOps once per candidate.
class [final] SroaDef(sdName: String, sdVar: RParam, sdIndex: Int, sdOp: Op)
class [final] SroaDefs(sdEntries: Dict<String, SroaDef>, sdMulti: Set<String>)

fun sroaDefs(ops: Segment<Op>|None) => sroaDefsLoop(ops, 0i32, 0, SroaDefs(Dict(), Set()))

fun [tail] sroaDefsLoop(s: Segment<Op>|None, iSeg, i, acc) => match(s)
  (nil: None)        => acc
  (seg: Segment<Op>) => iSeg < seg.length
    ? sroaDefsLoop(s, iSeg + 1i32, i + 1,
        fold(opGetLiveVars(seg.array(iSeg)).writes, acc,
             (a, w) => sroaDef1(a, w, i, seg.array(iSeg))))
    : sroaDefsLoop(seg.next, 0i32, i, acc)

fun sroaDef1(acc, w, i, op) => match(w)
  (sv: RpStackVar) => SroaDefs(put(acc.sdEntries, sv.name, SroaDef(sv.name, w, i, op)),
                               contains(acc.sdEntries, sv.name) ? add(acc.sdMulti, sv.name) : acc.sdMulti)
  (o: RParam)       => acc

fun sroaConsider([terminal] acc, name: String,
                 done: Set<String>, svReads: Dict<String, Int>,
                 projReads: Dict<String, Dict<String, Int>>, defs: SroaDefs)
  if contains(defs.sdMulti, name) || contains(done, name)
    ret acc
  ret match(get(defs.sdEntries, name))
    (d: SroaDef) => sroaConsiderDef(acc, name, d, svReads, projReads)
    ()            => acc

fun sroaConsiderDef([terminal] acc: ListBuilder<Sroa>, name,
                    d: SroaDef, svReads: Dict<String, Int>,
                    projReads: Dict<String, Dict<String, Int>>)
  # Only plain non-empty structs — never the async TaskWrapper ABI.
  let fields = sroaStructFields(rpGetType(d.sdVar))
  if isEmpty(fields)
    ret acc
  let projected = sroaProjOf(projReads, name)
  let projTotal = sroaProjTotal(projected)
  let reads = get(svReads, name) ?? 0
  if reads == 0 || reads != projTotal
    ret acc
  if !sroaDefOpOk(d.sdOp)
    ret acc
  let used = sort(keys(projected))
  ret push(acc, Sroa(name, d.sdVar, d.sdIndex,
                map(used, (fld) => SroaField(fld,
                      RpStackVar(rpStructFieldLookup(fields, fld), name + "$" + fld)))))

fun sroaStructFields(t2) => match(t2)
  (s2: CgStruct)          => s2.fields
  (im: CgImmediateStruct) => im.fields
  (o: CgType)             => List()

# Project after an ordinary single-result definition only; a Phi join and
# side-effect-anchoring keep-Moves stay whole.
fun sroaDefOpOk(op) => match(op)
  (m: OpMove) => !m.moveKeep
  (c: OpCall) => true
  (o: Op)     => false

# ── the rewrite ──────────────────────────────────────────────────────────────

fun sroaApply(f: CgFunction, sp: List<Sroa>)
  let newOps = build(sroaApplyLoop(f.fnOps, 0i32, sp, 0,
                                   seqBuilder()))
  let newFields = fold(sp, List(),
        (acc, s2) => concat(acc,
          map(s2.srFields, (fl) => CgField(stackVarName(fl.sfLocal), rpGetType(fl.sfLocal)))))
  ret cgFunctionWith(f, newOps,
        CgStruct(concat(cgFieldsOfOrEmpty(f.fnStackVars), newFields)))

# Rewrite every projection v.f → v$f; the freshly inserted seeding Moves are
# NOT routed through the replacer, so they read the original v exactly once,
# right after its definition — before any suspension can intervene.
fun [tail] sroaApplyLoop(s: Segment<Op>|None, iSeg: Int32, sp: List<Sroa>, i,
                         [terminal] acc): SeqBuilder<Op> => match(s)
  (nil: None)        => acc
  (seg: Segment<Op>) => iSeg < seg.length
    ? sroaApplyLoop(s, iSeg + 1i32, sp, i + 1,
        pushAll(
            push(acc, opReplaceParams(seg.array(iSeg),
                          (p) => sroaReplacer(p, sp))),
            sroaSeedMoves(sp, i)))
    : sroaApplyLoop(seg.next, 0i32, sp, i, acc)

fun sroaReplacer(p, sp: List<Sroa>): RParam => match(p)
  (sf: RpStructField) => match(sf.structVal)
    (sv: RpStackVar) => sroaFieldLocal(sp, sv.name, sf.field, p)
    (o: RParam)       => p
  (o2: RParam)         => p

fun sroaFieldLocal(sp: List<Sroa>, v: String, f, orig): RParam
  ret match(head(filter(sp, (s2) => s2.srName == v)))
    (s2: Sroa) => match(head(filter(s2.srFields, (fl) => fl.sfField == f)))
      (fl: SroaField) => fl.sfLocal
      ()               => orig
    ()          => orig

fun sroaSeedMoves(sp: List<Sroa>, i: Int): List<Op>
  ret fold(sp, List(), (acc, s2) => s2.srDefIndex == i
             ? concat(acc, map(s2.srFields, (fl) =>
                 OpMove(fl.sfLocal, RpStructField(s2.srVar, fl.sfField), false, Dict())))
             : acc)
