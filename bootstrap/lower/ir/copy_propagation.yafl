# bootstrap/copy_propagation.yafl — ported from lowering/copy_propagation.py:
# a Move(M, S) of StackVar into StackVar immediately followed by an op that
# reads M substitutes S into that op; the Move is dropped only when M's TOTAL
# read count was exactly 1 (other readers keep it). Never across a Label (a
# merge could see M carrying another value). Iterates to a fixpoint so Move
# chains collapse one hop at a time; finally prunes stack_var declarations no
# longer referenced. The substitution swaps in the SOURCE INSTANCE (Python's
# replace_params semantics) — never a name-only rename, which would keep the
# old instance's TYPE and mint a same-name-different-type chimera.
namespace Bootstrap::Lower::Ir

import System

import Bootstrap::Ir
import Bootstrap::StdlibCandidates



fun propagateCopies(a: CgApp): CgApp
  ret appWithFunctions(a, map(appFunctions(a), cpFunction))

fun [tail] cpFunction(f: CgFunction): CgFunction
  let out = cpOnce(f)
  ret out.cpChanged ? cpFunction(out.cpFn) : f

class [final] CpOut(cpFn: CgFunction, cpChanged: Bool)

fun cpOnce(f: CgFunction): CpOut
  let readCounts = cpCountReads(f.fnOps)
  let walked = cpWalk(chain(f.fnOps), readCounts, builder<Op >(), false)
  ret walked.cpwChanged
    ? CpOut(cpPruneStackVars(f, walked.cpwOps), true)
    : CpOut(f, false)

# Python's get_live_vars returns a frozenset PER OP: an op reading the same
# var twice (done.io, done.v in one call) counts ONCE. Counting occurrences
# instead keeps the Move on the multi-reader path where Python drops it.
fun cpAddName(acc: Set<String>, n: String): Set<String>
  ret add<String>(acc, n)

fun cpCountReads(ops: List<Op>): Dict<String, Int>
  ret fold(ops, Dict<String, Int>(),
           (acc: Dict<String, Int>, op: Op) =>
             fold(fold(opReadVarNames(op), Set<String>(), cpAddName), acc, sdBump))

class [final] CpWalkOut(cpwOps: List<Op>, cpwChanged: Bool)

fun [tail] cpWalk(ops: Chain<Op>, readCounts: Dict<String, Int>,
                  [terminal] acc: ListBuilder<Op >, changed: Bool): CpWalkOut
  ret match(ops)
    (nil: ChainEnd) => CpWalkOut(build<Op >(acc), changed)
    (l: ChainLink)  => match(cpTryPropagate(l, readCounts))
      (s2: CpStep) => cpWalk(s2.cpsRest, readCounts,
                             _pushChain<Op >(acc, chain<Op>(s2.cpsEmit)), true)
      ()            => cpWalk(l.next, readCounts, push<Op >(acc, l.value),
                              changed)

class [final] CpStep(cpsEmit: List<Op>, cpsRest: Chain<Op>)

# The candidate shape: Move(M:StackVar, S:StackVar); next op not a Label and
# reads M. Emits the substituted next op (keeping the Move when M has other
# readers) and consumes both ops.
fun cpTryPropagate(l: ChainLink<Op>, readCounts: Dict<String, Int>): CpStep|None
  ret match(l.value)
    (m: OpMove) => cpTryMove(l, m, readCounts)
    (o: Op)     => None

fun cpTryMove(l: ChainLink<Op>, m: OpMove, readCounts: Dict<String, Int>): CpStep|None
  ret match(m.moveTarget)
    (mt: RpStackVar) => match(m.moveSource)
      (ms: RpStackVar) => cpTryNext(l, m, mt, ms, readCounts)
      (o: RParam)       => None
    (o2: RParam)      => None

fun cpTryNext(l: ChainLink<Op>, m: OpMove, mt: RpStackVar, ms: RpStackVar,
              readCounts: Dict<String, Int>): CpStep|None
  ret match(l.next)
    (nil: ChainEnd) => None
    (nx: ChainLink) => match(nx.value)
      (lb: OpLabel) => None
      (o: Op)       => strListMember(opReadVarNames(nx.value), mt.name)
        ? cpEmit(m, mt, ms, nx, readCounts)
        : None

# `m` is the Move being (possibly) kept — but this helper only re-emits it,
# so it takes the ROOT type: a narrowed variant type in a signature is for
# helpers that read variant fields.
fun cpEmit(m: Op, mt: RpStackVar, ms: RpStackVar, nx: ChainLink<Op>,
           readCounts: Dict<String, Int>): CpStep
  # Python substitutes the SOURCE INSTANCE (replace_params swaps the whole
  # StackVar node for `s`, TYPE INCLUDED) — a name-only rename would keep the
  # target instance's type and mint a same-name-different-type chimera when
  # the two declarations disagree (the $par_result|unsupported uninit ghost).
  let substituted = opReplaceParams(nx.value, (p: RParam) => cpSubstVar(p, mt.name, ms))
  # M's only read was the one just substituted → drop the Move entirely;
  # other readers elsewhere keep it.
  ret sdCountOf(readCounts, mt.name) == 1
    ? CpStep(list1(substituted), nx.next)
    : CpStep(list2(m, substituted), nx.next)

fun cpSubstVar(p: RParam, m: String, s: RpStackVar): RParam
  ret match(p)
    (sv: RpStackVar) => sv.name == m ? s : p
    (o: RParam)      => p

# Drop stack_var declarations no longer referenced anywhere (reads OR writes).
fun cpPruneStackVars(f: CgFunction, newOps: List<Op>): CgFunction
  let mentioned = fold(newOps, Set<String>(),
                       (acc: Set<String>, op: Op) =>
                         fold(concat(opReadVarNames(op), cpWriteNames(op)), acc,
                              (s2: Set<String>, n: String) => add<String>(s2, n)))
  ret cgFunctionWith(f, newOps,
        CgStruct(filter(cgFieldsOfOrEmpty(f.fnStackVars),
                        (fld: CgField) => contains<String>(mentioned, fld.fieldName))))

fun cpWriteNames(op: Op): List<String>
  ret fold(ssavOpWrites(op), List<String>(), rpTakeStackVarName)
