# bootstrap/copy_propagation.yafl — ported from lowering/copy_propagation.py:
# a Move(M, S) of StackVar into StackVar immediately followed by an op that
# reads M substitutes S into that op; the Move is dropped only when M's TOTAL
# read count was exactly 1 (other readers keep it). Never across a Label (a
# merge could see M carrying another value). Iterates to a fixpoint so Move
# chains collapse one hop at a time; finally prunes stack_var declarations no
# longer referenced. The substitution swaps in the SOURCE INSTANCE (Python's
# replace_params semantics) — never a name-only rename, which would keep the
# old instance's TYPE and mint a same-name-different-type chimera.
namespace Bootstrap::Lower::Ir

import System

import Bootstrap::Ir
import Bootstrap::StdlibCandidates



fun propagateCopies(a: CgApp) => appWithFunctions(a, map(appFunctions(a), cpFunction))

fun [tail] cpFunction(f)
  let out = cpOnce(f)
  ret out.cpChanged ? cpFunction(out.cpFn) : f

class [final] CpOut(cpFn: CgFunction, cpChanged: Bool)

fun cpOnce(f)
  let readCounts = cpCountReads(f.fnOps)
  let walked = cpWalk(seqStream(f.fnOps),
                        readCounts, seqBuilder(), false)
  ret walked.cpwChanged
    ? CpOut(cpPruneStackVars(f, walked.cpwOps), true)
    : CpOut(f, false)

# Python's get_live_vars returns a frozenset PER OP: an op reading the same
# var twice (done.io, done.v in one call) counts ONCE. Counting occurrences
# instead keeps the Move on the multi-reader path where Python drops it.
fun cpAddName(acc: Set<String>, n: String) => add(acc, n)

fun cpCountReads(ops: Segment<Op>|None)
  ret fold(ops, Dict(),
           (acc, op) =>
             fold(fold(opReadVarNames(op), Set(), cpAddName), acc, sdBump))

class [final] CpWalkOut(cpwOps: Segment<Op>|None, cpwChanged: Bool)

# PAIRED-CARRY stream walk: pull the first element, then the [tail] carry
# loop holds the PREVIOUS op as a parameter and pulls the next — the pair
# exists as two locals, no lookahead into the container. When a pair
# propagates, BOTH are consumed: emit, pull afresh to re-establish the
# carry, recurse. Storage-agnostic: the container appears only in cpOnce's
# source construction.
fun cpWalk<S>(s: S, readCounts: Dict<String, Int>,
              [terminal] acc, changed) where Stream<S, Op, Never>
  let r = streamNext<S, Op, Never>(s)
  ret match(r.value)
    (ok: Ok<Op | None, Never>) => match(ok.value)
      (first: Op) => cpCarry(first, r.stream, readCounts, acc, changed)
      (n: None)   => CpWalkOut(build(acc), changed)
    (er: Error<Op | None, Never>) => CpWalkOut(build(acc), changed)

fun [tail] cpCarry<S>(cur, s: S, readCounts: Dict<String, Int>,
                      [terminal] acc, changed) where Stream<S, Op, Never>
  let r = streamNext<S, Op, Never>(s)
  ret match(r.value)
    (ok: Ok<Op | None, Never>) => match(ok.value)
      (nxt: Op) => match(cpTryPropagate(cur, nxt, readCounts))
        # Both ops of the pair are consumed: emit, then pull one more IN
        # PLACE to re-establish the carry ([tail] needs direct
        # self-recursion, so the re-prime cannot be its own function).
        (s2: CpStep) => streamNext<S, Op, Never>(r.stream)
          |> (r2) => match(r2.value)
            (ok2: Ok<Op | None, Never>) => match(ok2.value)
              (nx2: Op)  => cpCarry(nx2, r2.stream, readCounts,
                                    pushAll(acc, s2.cpsEmit), true)
              (n2: None) => CpWalkOut(build(pushAll(acc, s2.cpsEmit)), true)
            (er2: Error<Op | None, Never>) =>
              CpWalkOut(build(pushAll(acc, s2.cpsEmit)), true)
        ()            => cpCarry(nxt, r.stream, readCounts,
                                 push(acc, cur), changed)
      (n: None) => CpWalkOut(build(push(acc, cur)), changed)
    (er: Error<Op | None, Never>) => CpWalkOut(build(push(acc, cur)), changed)

class [final] CpStep(cpsEmit: List<Op>)

# The candidate shape: Move(M:StackVar, S:StackVar); next op not a Label and
# reads M. Emits the substituted next op (keeping the Move when M has other
# readers); the carry loop consumes both.
fun cpTryPropagate(cur, nxt, readCounts: Dict<String, Int>) => match(cur)
  (m: OpMove) => cpTryMove(m, nxt, readCounts)
  (o: Op)     => None

fun cpTryMove(m, nxt, readCounts: Dict<String, Int>) => match(m.moveTarget)
  (mt: RpStackVar) => match(m.moveSource)
    (ms: RpStackVar) => cpTryNext(m, mt, ms, nxt, readCounts)
    (o: RParam)       => None
  (o2: RParam)      => None

fun cpTryNext(m, mt: RpStackVar, ms, nxt,
              readCounts: Dict<String, Int>) => match(nxt)
  (lb: OpLabel) => None
  (o: Op)       => strListMember(opReadVarNames(nxt), mt.name)
    ? cpEmit(m, mt, ms, nxt, readCounts)
    : None

# `m` is the Move being (possibly) kept — but this helper only re-emits it,
# so it takes the ROOT type: a narrowed variant type in a signature is for
# helpers that read variant fields.
fun cpEmit(m, mt: RpStackVar, ms, nxt,
           readCounts: Dict<String, Int>)
  # Python substitutes the SOURCE INSTANCE (replace_params swaps the whole
  # StackVar node for `s`, TYPE INCLUDED) — a name-only rename would keep the
  # target instance's type and mint a same-name-different-type chimera when
  # the two declarations disagree (the $par_result|unsupported uninit ghost).
  let substituted = opReplaceParams(nxt, (p) => cpSubstVar(p, mt.name, ms))
  # M's only read was the one just substituted → drop the Move entirely;
  # other readers elsewhere keep it.
  ret sdCountOf(readCounts, mt.name) == 1
    ? CpStep(list1(substituted))
    : CpStep(list2(m, substituted))

fun cpSubstVar(p, m, s) => match(p)
  (sv: RpStackVar) => sv.name == m ? s : p
  (o: RParam)      => p

# Drop stack_var declarations no longer referenced anywhere (reads OR writes).
fun cpPruneStackVars(f: CgFunction, newOps)
  let mentioned = fold(newOps, Set(),
                       (acc, op) =>
                         fold(concat(opReadVarNames(op), cpWriteNames(op)), acc,
                              (s2, n) => add(s2, n)))
  ret cgFunctionWith(f, newOps,
        CgStruct(filter(cgFieldsOfOrEmpty(f.fnStackVars),
                        (fld) => contains(mentioned, fld.fieldName))))

fun cpWriteNames(op) => fold(ssavOpWrites(op), List(), rpTakeStackVarName)
