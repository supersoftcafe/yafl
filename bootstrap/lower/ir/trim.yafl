# bootstrap/trim.yafl — dead-code elimination over the IR, ported from
# lowering/trim.py: drop functions/objects/globals not reachable from
# __entrypoint__, via the reference model (ir/references.yafl), worklist to a
# fixpoint; the survivors rebuild in SORTED name order, exactly like Python's
# `sorted(to_app.*)` — C emission order depends on it).
namespace Bootstrap::Lower::Ir

import System
import System::Containers

import Bootstrap::Ir
import Bootstrap::StdlibCandidates



# ── the worklist fixpoint ────────────────────────────────────────────────────

fun removedUnusedStuff(a: CgApp): CgApp => trimLoop(a, ssFunction1("__entrypoint__"), ssEmpty())

fun [tail] trimLoop(a: CgApp, scanSets: ScanSets, toApp: ScanSets): CgApp
  let fromGlobals = fold(setNames(scanSets.ssGlobals), ssEmpty(),
                         (acc, n) => ssUnion(acc, scanAppGlobal(a, n)))
  let fromObjects = fold(setNames(scanSets.ssObjects), fromGlobals,
                         (acc, n) => ssUnion(acc, scanAppObject(a, n)))
  let seenSets = ssUnion(scanSets, fold(setNames(scanSets.ssFunctions), fromObjects,
                         (acc, n) => ssUnion(acc, scanAppFunction(a, n))))
  let newScanSets = ssSub(seenSets, toApp)
  ret ssIsEmpty(newScanSets)
    ? trimRebuild(a, toApp)
    : trimLoop(a, newScanSets, ssUnion(seenSets, toApp))

fun scanAppGlobal(a: CgApp, name: String) => match(appGlobal(a, name))
  (g2: CgGlobal) => scanGlobal(g2)
  ()              => ssEmpty()

fun scanAppObject(a: CgApp, name: String) => match(appObject(a, name))
  (o: CgObject) => scanObject(o)
  ()             => ssEmpty()

fun scanAppFunction(a: CgApp, name: String) => match(appFunction(a, name))
  (f: CgFunction) => scanFunction(f)
  ()               => ssEmpty()

# Survivors rebuild in SORTED name order (Python `sorted(...)`) — the
# deterministic emission order the C contract pins.
fun trimRebuild(a: CgApp, toApp: ScanSets) => appOf(
    trimPick(setNames(toApp.ssFunctions), (n) => appFunction(a, n)),
    trimPickObjects(setNames(toApp.ssObjects), a),
    trimPickGlobals(setNames(toApp.ssGlobals), a))

# The picked entities keep the (sorted) name order they were asked for — it
# becomes their emission order.
fun trimPick(names: List<String>, get: (:String): CgFunction|None)
  ret trimPickLoop(names, get,
                         List())

fun trimPickLoop(ns: List<String>, get: (:String): CgFunction|None,
                 acc: List<CgFunction>) => fold(ns, acc, (a, n) => appendSome(a, get(n)))



fun trimPickObjects(names: List<String>, a: CgApp)
  ret trimPickObjLoop(names, a, List())

fun trimPickObjLoop(ns: List<String>, a: CgApp,
                    acc: List<CgObject>) => fold(ns, acc, (out, n) => appendSome(out, appObject(a, n)))

fun trimPickGlobals(names: List<String>, a: CgApp)
  ret trimPickGlbLoop(names, a, List())

fun trimPickGlbLoop(ns: List<String>, a: CgApp,
                    acc: List<CgGlobal>) => fold(ns, acc, (out, n) => appendSome(out, appGlobal(a, n)))

# ── addressTakenFunctions (trim.py address_taken_functions) ─────────────────
# Internal functions whose ADDRESS escapes as a value: every reference except
# the callee slot of a direct call and a vtable slot (the virtual call sites
# enumerate those). Such a function can be called from a site the IR cannot
# enumerate — through a closure, a union slot, the runtime — so nothing may
# be assumed about the arguments it receives. Same scan model as the
# dead-code pass.

fun addressTakenFunctions(a: CgApp): StrSet
  let fromOps = fold(appFunctions(a), setEmpty(), (acc, f) => fold(f.fnOps, acc, atfOp))
  ret fold(appGlobals(a), fromOps, atfGlobal)

fun atfOp(acc: StrSet, op) => match(op)
  (c: OpCall) => match(c.callFunction)
    (gf: RpGlobalFunction) => atfCallSite(acc, c, gf)
    (o: RParam)            => setUnion(acc, scanOp(op).ssFunctions)
  (o2: Op)    => setUnion(acc, scanOp(op).ssFunctions)

fun atfCallSite(acc: StrSet, c: OpCall, gf: RpGlobalFunction)
  let s1 = setUnion(acc, scanRParam(c.callParameters).ssFunctions)
  let s2 = match(c.callRegister)
    (reg: RParam) => setUnion(s1, scanRParam(reg).ssFunctions)
    ()             => s1
  ret match(gf.object)
    (obj: RParam) => setUnion(s2, scanRParam(obj).ssFunctions)
    ()             => s2

fun atfGlobal(acc: StrSet, g2: CgGlobal)
  let s1 = match(g2.globalLazyInitFunction)
    (name: String) => setAdd(acc, name)
    ()              => acc
  ret match(g2.globalInit)
    (init: RParam) => setUnion(s1, scanRParam(init).ssFunctions)
    ()              => s1
