# bootstrap/lower/ir/fast_stores.yafl — ported from lowering/fast_stores.py:
# elide the write barrier on stores into an object that is still brand new.
#
# RpObjectField.fresh already carries the fact this pass proves: the object
# was allocated moments ago, straight-line before this store, and nothing has
# published it. Two duties fall away when it holds — the SATB deletion
# barrier (no cycle can have OPENED inside the window, because opening one
# needs a safe point and there is none), and the relocation resolve (no safe
# point means no compaction, so the pointer cannot have gone stale).
#
# Construction codegen sets `fresh` on the stores it emits itself. Nothing
# else did, so the async state object — allocated at every suspension and
# immediately filled with that site's live set — paid a barrier on every
# save. That was the bulk of the barriers in a self-compile.
#
# THE DATAFLOW is a forward must-analysis run as a repeated LINEAR SWEEP
# rather than over a built CFG: carry a fact set through the ops in order; a
# jump to L intersects the carried fact into `arriving[L]`; a Label L starts
# from `carried ∩ arriving[L]`; after a terminator the carried fact is the
# UNIVERSE, so the unreachable run up to the next label contributes nothing.
# Every set starts at the universe and only shrinks, so sweeping to a
# fixpoint gives the greatest fixpoint — which is what lets a loop whose body
# holds no safe point keep its window.
#
# Runs LAST, after async_lower (which emits the state stores) and after
# pinnable_reads, so every RpObjectField is already in its final shape.
# Matching only a bare RpStackVar base is what keeps [pinnable] objects out
# for free: their bases are object_resolve wraps by then.
namespace Bootstrap::Lower::Ir

import System

import Bootstrap::Ir
import Bootstrap::StdlibCandidates



# The carried fact plus the label→fact map, threaded through one sweep.
class [final] FsWalk(fwFact: Set<String>, fwArr: Dict<String, Set<String>>)

# Instruction order out; the carried fact rides alongside.
class [linear, final] FsAcc(faOps: SeqBuilder<Op>, faFact: Set<String>)

# Bounded: the sets are finite and shrink monotonically.
let [const] fsMaxSweeps: Int = 8

# ── op classification ───────────────────────────────────────────────────────

# Can this op reach a GC safe point? An allocation polls, a call may allocate
# inside the callee, and a runtime helper is opaque. Any of them can open a
# cycle or relocate, which ends every window at once. An op shape this pass
# does not model falls here too, so an unmodelled op costs optimisation,
# never soundness.
fun fsKillsEverything(op: Op)
  if fsIsSafePoint(op) || fsHasRuntimeInvoke(op)
    ret true
  ret !fsIsModelled(op)

fun fsIsSafePoint(op: Op) => op is OpCall || op is OpParallelCall || op is OpNewObject

fun fsHasRuntimeInvoke(op: Op) => any(opAllParams(op), (p) => p is RpRuntimeInvoke)

fun fsIsModelled(op: Op)
  ret op is OpMove || op is OpLabel || op is OpJump || op is OpJumpIf
      || op is OpIfTask || op is OpAssertNotTask || op is OpSwitchJump
      || op is OpReturn || op is OpReturnVoid || op is OpAbort || op is OpPhi

# Control does not fall through past these.
fun fsIsTerminal(op: Op)
  ret op is OpJump || op is OpReturn || op is OpReturnVoid || op is OpAbort
      || fsIsMusttail(op)

fun fsIsMusttail(op: Op) => match(op)
  (c: OpCall) => c.callMusttail
  (o: Op)     => false

fun fsJumpTargets(op: Op): List<String> => match(op)
  (j: OpJump)        => list1(j.jumpName)
  (ji: OpJumpIf)     => list1(ji.jumpIfLabel)
  (it: OpIfTask)     => list1(it.taskTarget)
  (sw: OpSwitchJump) => map(sw.switchCases, (c) => c.caseLabel)
  (o: Op)            => List()

# ── the transfer function ───────────────────────────────────────────────────

fun fsStep(op: Op, fresh: Set<String>): Set<String>
  if fsKillsEverything(op)
    ret fsNewWindow(op)
  ret match(fsAliasTarget(op, fresh))
    (t2: String) => add(fresh, t2)
    ()           => fsSurvivors(op, fresh)

# The allocation itself is the one safe point that also OPENS a window:
# relocation can only happen at a LATER safe point, so the object is clean
# from the instruction after its own allocation.
fun fsNewWindow(op: Op): Set<String> => match(op)
  (no: OpNewObject) => fsRegisterName(no.newObjRegister)
  (o: Op)           => Set<String>()

fun fsRegisterName(r: RParam): Set<String> => match(r)
  (sv: RpStackVar) => add(Set<String>(), sv.name)
  (o: RParam)      => Set<String>()

# `Move(StackVar t, StackVar s)` with `s` fresh is a second NAME for the one
# object, not a publication.
fun fsAliasTarget(op: Op, fresh: Set<String>): String|None => match(op)
  (m: OpMove) => fsAliasMove(m, fresh)
  (o: Op)     => None

fun fsAliasMove(m: OpMove, fresh: Set<String>): String|None => match(m.moveTarget)
  (tv: RpStackVar) => fsAliasSource(m.moveSource, fresh, tv.name)
  (o: RParam)      => None

fun fsAliasSource(src: RParam, fresh: Set<String>, target: String): String|None => match(src)
  (sv: RpStackVar) => contains(fresh, sv.name) ? target : None
  (o: RParam)      => None

# Anything this op WRITES no longer holds what it held: esOpPublishes only
# inspects reads, so the kill has to be explicit.
fun fsSurvivors(op: Op, fresh: Set<String>): Set<String>
  let kept = filter(fresh, (n) => !esOpPublishes(op, n))
  ret fold(fsWritten(op), kept, (s, sv) => fsRemoveVar(s, sv))

# OpIfTask assigns taskLhs and callIdLhs on the side and reports NO writes at
# all from opGetLiveVars, so it needs naming here.
fun fsWritten(op: Op): List<RParam> => match(op)
  (it: OpIfTask) => concat(list1(it.taskLhs), list1(it.callIdLhs))
  (o: Op)        => opGetLiveVars(op).writes

fun fsRemoveVar(s: Set<String>, sv: RParam): Set<String> => match(sv)
  (v: RpStackVar) => remove(s, v.name)
  (o: RParam)     => s

# ── the sweep ───────────────────────────────────────────────────────────────

fun fsUniverse(ops: Segment<Op>|None): Set<String>
  ret fold(ops, Set<String>(), (s, op) => fsUniverseOp(s, op))

fun fsUniverseOp(s: Set<String>, op: Op): Set<String> => match(op)
  (no: OpNewObject) => union(s, fsRegisterName(no.newObjRegister))
  (o: Op)           => s

fun fsInitArriving(ops: Segment<Op>|None, universe: Set<String>)
  ret fold(ops, Dict<String, Set<String>>(),
           (d, op) => fsInitLabel(d, op, universe))

fun fsInitLabel(d: Dict<String, Set<String>>, op: Op,
                universe: Set<String>): Dict<String, Set<String>> => match(op)
  (l: OpLabel) => put(d, l.labelName, universe)
  (o: Op)      => d

fun fsIntersect(a: Set<String>, b: Set<String>) => filter(a, (x) => contains(b, x))

fun fsEntered(op: Op, fact: Set<String>,
              arr: Dict<String, Set<String>>): Set<String> => match(op)
  (l: OpLabel) => fsEnteredLabel(fact, get(arr, l.labelName))
  (o: Op)      => fact

fun fsEnteredLabel(fact: Set<String>, known: Set<String>|None): Set<String> => match(known)
  (s: Set<String>) => fsIntersect(fact, s)
  ()               => fact

fun fsCarry(op: Op, after: Set<String>, universe: Set<String>) => fsIsTerminal(op)
  ? universe                        # unreachable until the next Label
  : after

fun fsRecordJumps(arr: Dict<String, Set<String>>, targets: List<String>,
                  after: Set<String>)
  ret fold(targets, arr, (d, t2) => fsIntersectInto(d, t2, after))

fun fsIntersectInto(d: Dict<String, Set<String>>, t2: String,
                    after: Set<String>): Dict<String, Set<String>> => match(get(d, t2))
  (s: Set<String>) => put(d, t2, fsIntersect(s, after))
  ()               => d

fun fsTotal(d: Dict<String, Set<String>>): Int => fold(values(d), 0, (n, s) => n + size(s))

fun [tail] fsSweepLoop(st: SeqStream<Op>, universe: Set<String>, w: FsWalk): FsWalk
  let p = cgPullOp(st)
  ret match(p.op)
    (nil: None) => w
    (op: Op)    => fsSweepLoop(p.stream, universe, fsSweepStep(w, op, universe))

fun fsSweepStep(w: FsWalk, op: Op, universe: Set<String>)
  let entered = fsEntered(op, w.fwFact, w.fwArr)
  # AFTER the step, not before: a branch whose condition consumes the bare
  # pointer publishes it before control transfers, so the taken edge must
  # carry the post-kill fact.
  let after = fsStep(op, entered)
  ret FsWalk(fsCarry(op, after, universe),
             fsRecordJumps(w.fwArr, fsJumpTargets(op), after))

# Not converging inside the budget must fall back to the safe BOTTOM, not to
# the last sweep: this is a greatest fixpoint, so the sets are still too
# LARGE and stopping early would claim freshness the sweep has not yet
# disproved. Empty facts at every label leave only the straight-line run
# before the first label optimisable.
# `round` counts sweeps ALREADY DONE, starting at 1, so the budget is exactly
# fsMaxSweeps sweeps — the same count the Python side runs.
fun [tail] fsFixpoint(ops: Segment<Op>|None, universe: Set<String>,
                      arr: Dict<String, Set<String>>, round): Dict<String, Set<String>>
  let swept = fsSweepLoop(seqStream(ops), universe, FsWalk(Set<String>(), arr)).fwArr
  if fsTotal(swept) == fsTotal(arr)
    ret swept
  ret round >= fsMaxSweeps
    ? fsBottom(swept)
    : fsFixpoint(ops, universe, swept, round + 1)

fun fsBottom(arr: Dict<String, Set<String>>): Dict<String, Set<String>>
  ret fold(keys(arr), Dict<String, Set<String>>(),
           (d, k) => put(d, k, Set<String>()))

# ── the rewrite ─────────────────────────────────────────────────────────────

fun markFastStores(a: CgApp)
  ret appWithFunctions(a, map(appFunctions(a), (f) => fsFunction(f)))

fun fsFunction(f: CgFunction)
  let universe = fsUniverse(f.fnOps)
  if isEmpty(universe)
    ret f                           # nothing this pass could ever prove
  let arr = fsFixpoint(f.fnOps, universe, fsInitArriving(f.fnOps, universe), 1)
  ret cgFunctionWith(f,
                     build(fsEmitLoop(seqStream(f.fnOps), universe, arr,
                                      FsAcc(seqBuilder(), Set<String>()))),
                     f.fnStackVars)

fun [tail] fsEmitLoop(st: SeqStream<Op>, universe: Set<String>,
                      arr: Dict<String, Set<String>>,
                      [terminal] acc: FsAcc): SeqBuilder<Op>
  let p = cgPullOp(st)
  ret match(p.op)
    (nil: None) => acc.faOps
    (op: Op)    => fsEmitLoop(p.stream, universe, arr,
                              fsEmitStep(acc, op, universe, arr))

fun fsEmitStep([terminal] acc: FsAcc, op: Op, universe: Set<String>,
               arr: Dict<String, Set<String>>): FsAcc
  let entered = fsEntered(op, acc.faFact, arr)
  ret FsAcc(push(acc.faOps, fsMaybeFast(op, entered)),
            fsCarry(op, fsStep(op, entered), universe))

fun fsMaybeFast(op: Op, fact: Set<String>): Op => match(op)
  (m: OpMove) => fsMaybeFastMove(m, fact)
  (o: Op)     => op

fun fsMaybeFastMove(m: OpMove, fact: Set<String>): Op => match(m.moveTarget)
  (of: RpObjectField) => !of.fresh && fsBaseInFact(of.pointer, fact)
    ? with m(moveTarget = with of(fresh = true))
    : m
  (o: RParam)         => m

fun fsBaseInFact(ptr: RParam, fact: Set<String>) => match(ptr)
  (sv: RpStackVar) => contains(fact, sv.name)
  (o: RParam)      => false
