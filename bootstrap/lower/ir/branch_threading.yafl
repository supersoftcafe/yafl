# bootstrap/branch_threading.yafl — ported from lowering/branch_threading.py:
# replace Jump(L) with a copy of the terminator immediately following
# Label(L) when that terminator is itself Return/ReturnVoid/unconditional
# Jump; fixpoint, then strip newly-unreachable ops. Python's `terminator is
# not op` identity guard becomes a structural same-name-Jump guard here —
# the only shape where substitution would spin (Label L; Jump L).
namespace Bootstrap::Lower::Ir

import System

import Bootstrap::Ir



fun threadBranches(a: CgApp): CgApp
  ret appWithFunctions(a, map(appFunctions(a), btFunction))

fun [tail] btFunction(f: CgFunction): CgFunction
  let out = btOnce(f.fnOps)
  ret out.btChanged
    ? btFunction(cgFunctionStripUnusedOperations(cgFunctionWith(f, out.btOps, f.fnStackVars)))
    : f

class [final] BtOut(btOps: Segment<Op>|None, btChanged: Bool)

# Instruction order out; `changed` rides alongside as a plain value.
class [linear, final] BtAcc(baOps: SeqBuilder<Op >, baChanged: Bool)

fun btOnce(ops: Segment<Op>|None): BtOut
  ret btLoop<SeqStream<Op>>(seqStream<Op>(ops), ops,
                              BtAcc(seqBuilder<Op >(), false))

# Stream-driven walk; `ops` rides alongside for the label-target search
# (random access, not part of the sequential drive). Error arm: Never.
fun [tail] btLoop<S>(s: S, ops: Segment<Op>|None,
                     [terminal] acc: BtAcc): BtOut where Stream<S, Op, Never>
  let r = streamNext<S, Op, Never>(s)
  ret match(r.value)
    (ok: Ok<Op | None, Never>) => match(ok.value)
      (cur: Op) => btLoop<S>(r.stream, ops, btStep(acc, cur, ops))
      (n: None) => BtOut(build<Op >(acc.baOps), acc.baChanged)
    (er: Error<Op | None, Never>) => BtOut(build<Op >(acc.baOps), acc.baChanged)

fun btStep([terminal] acc: BtAcc, op: Op, ops: Segment<Op>|None): BtAcc
  ret match(op)
    (j: OpJump) => match(btTerminatorAfter(ops, j.jumpName))
      (t2: Op) => btSameJump(t2, j)
        ? BtAcc(push<Op >(acc.baOps, op), acc.baChanged)
        : BtAcc(push<Op >(acc.baOps, t2), true)
      ()        => BtAcc(push<Op >(acc.baOps, op), acc.baChanged)
    (o: Op)     => BtAcc(push<Op >(acc.baOps, op), acc.baChanged)

fun btSameJump(t2: Op, j: OpJump): Bool
  ret match(t2)
    (j2: OpJump) => j2.jumpName == j.jumpName
    (o: Op)      => false

fun btTerminatorAfter(ops: Segment<Op>|None, labelName: String): Op|None
  ret btTaLoop(seqStream<Op>(ops), labelName)

fun [tail] btTaLoop(st: SeqStream<Op>, labelName: String): Op|None
  let p = cgPullOp(st)
  ret match(p.op)
    (nil: None) => None
    (op: Op)    => btIsTargetLabel(op, labelName)
      ? btNextTerminator(cgPullOp(p.stream).op)
      : btTaLoop(p.stream, labelName)

fun btIsTargetLabel(op: Op, labelName: String): Bool
  ret match(op)
    (lb: OpLabel) => lb.labelName == labelName
    (o: Op)       => false

fun btNextTerminator(rest: Op|None): Op|None
  ret match(rest)
    (nil: None) => None
    (op: Op)    => match(op)
      (r: OpReturn)      => op
      (rv: OpReturnVoid) => op
      (j: OpJump)        => op
      (o: Op)            => None
