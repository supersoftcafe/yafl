# bootstrap/branch_threading.yafl — ported from lowering/branch_threading.py:
# replace Jump(L) with a copy of the terminator immediately following
# Label(L) when that terminator is itself Return/ReturnVoid/unconditional
# Jump; fixpoint, then strip newly-unreachable ops. Python's `terminator is
# not op` identity guard becomes a structural same-name-Jump guard here —
# the only shape where substitution would spin (Label L; Jump L).
namespace Bootstrap::Lower::Ir

import System
import System::Containers

import Bootstrap::Ir



fun threadBranches(a: CgApp) => appWithFunctions(a, powerMap(appFunctions(a), btFunction))

fun [tail] btFunction(f): CgFunction
  let out = btOnce(f.fnOps)
  ret out.btChanged
    ? btFunction(cgFunctionStripUnusedOperations(cgFunctionWith(f, out.btOps, f.fnStackVars)))
    : f

class [final] BtOut(btOps: Array<Op>, btChanged: Bool)

# Instruction order out; `changed` rides alongside as a plain value.
class [final] BtAcc(baOps: Array<Op>, baChanged: Bool)

fun btOnce(ops: Array<Op>) => btLoop(arrayStream(ops), ops,
                                              BtAcc(Array<Op>(), false))

# Stream-driven walk; `ops` rides alongside for the label-target search
# (random access, not part of the sequential drive). Error arm: Never.
fun [tail] btLoop<S>(s: S, ops: Array<Op>,
                     acc: BtAcc) where Stream<S, Op, Never>
  let r = streamNext<S, Op, Never>(s)
  ret match(r.value)
    (ok: Ok<Op | None, Never>) => match(ok.value)
      (cur: Op) => btLoop(r.stream, ops, btStep(acc, cur, ops))
      (n: None) => BtOut(acc.baOps, acc.baChanged)
    (er: Error<Op | None, Never>) => BtOut(acc.baOps, acc.baChanged)

fun btStep(acc: BtAcc, op, ops: Array<Op>) => match(op)
  (j: OpJump) => match(btTerminatorAfter(ops, j.jumpName))
    (t2: Op) => btSameJump(t2, j)
      ? BtAcc(push(acc.baOps, op), acc.baChanged)
      : BtAcc(push(acc.baOps, t2), true)
    ()        => BtAcc(push(acc.baOps, op), acc.baChanged)
  (o: Op)     => BtAcc(push(acc.baOps, op), acc.baChanged)

fun btSameJump(t2, j: OpJump) => match(t2)
  (j2: OpJump) => j2.jumpName == j.jumpName
  (o: Op)      => false

fun btTerminatorAfter(ops: Array<Op>, labelName) => btTaLoop(arrayStream(ops), labelName)

fun [tail] btTaLoop(st: ArrayStream<Op>, labelName): Op|None
  let p = cgPullOp(st)
  ret match(p.op)
    (nil: None) => None
    (op: Op)    => btIsTargetLabel(op, labelName)
      ? btNextTerminator(cgPullOp(p.stream).op)
      : btTaLoop(p.stream, labelName)

fun btIsTargetLabel(op, labelName) => match(op)
  (lb: OpLabel) => lb.labelName == labelName
  (o: Op)       => false

fun btNextTerminator(rest: Op|None) => match(rest)
  (nil: None) => None
  (op: Op)    => match(op)
    (r: OpReturn)      => op
    (rv: OpReturnVoid) => op
    (j: OpJump)        => op
    (o: Op)            => None
