# bootstrap/inlining.yafl — ported from lowering/inlining.py: the IR inliner.
# Structural guards are fixed (direct call to an internal global function with
# NewStruct args, not recursive — recursiveFunctions, which covers a self-call
# — not musttail, target non-empty and not [future]); the POLICY decides
# which eligible targets to pull in — the size cutoff, or [inline(always)]. A
# fn is never an inlining SINK if it is __entrypoint__ or bypass_async
# (async_lower passes those through untouched, so a suspending body inlined
# into them would never get its state machine). Also here: recursiveFunctions
# (trim.py — same __scan model as the dead-code pass, so they can never
# disagree about what references what).
namespace Bootstrap::Lower::Ir

import System
import System::Containers

import Bootstrap::Ast

import Bootstrap::Codegen
import Bootstrap::Ir
import Bootstrap::Lower::Ast
import Bootstrap::Parse
import Bootstrap::StdlibCandidates



fun inlCutoffComplexity() => 5

# The IR inliner's knob (--inline-threshold): compiler.py's InlineOptions.
# The small-function cutoff, in ops (-O2 and up).
class [final] InlineOpts(ioThreshold: Int)

fun inlineDefaults() => InlineOpts(inlCutoffComplexity())

# ── the pass ─────────────────────────────────────────────────────────────────

fun inlineSmallFunctions(a: CgApp, inlineAlways, epoch: Int, cutoff: Int)
  let recursive = recursiveFunctions(a)
  ret appWithFunctions(a, powerMap(appFunctions(a), (f) =>
        doInlining(f, "s" + String(epoch), a, recursive, (target) =>
          inlPolicy(target, inlineAlways, cutoff))))

# Inline a small function (under the cutoff) always; inline an
# `[inline(always)]` target regardless of size only when `inlineAlways` is set
# (-O3); never inline an `[inline(never)]` target.
fun inlPolicy(target: CgFunction, inlineAlways: Bool, cutoff: Int): Bool => match(target.fnInline)
  (n: InlineNever)  => false
  (a: InlineAlways) => inlineAlways || !atLeast(target.fnOps, cutoff)
  (u: InlineAuto)   => !atLeast(target.fnOps, cutoff)
  (e: InlineEarly)  => !atLeast(target.fnOps, cutoff)

# ── the engine ───────────────────────────────────────────────────────────────

# The rewritten op stream and the extra stack slots the inlined bodies need.
# The ops are appended in place, and a splice never looks back at what was
# emitted before it: how it ends is decided from the callee (inlSplice).
class [final] InlAcc(inlOps: Array<Op>,
                     inlVars: List<CgField>)

# The inlined-name uniquifier is the fixpoint EPOCH, not the op count:
# distinct per round by construction (the count merely happened to change
# every round), and never a calculated length. Python mirrors this exactly.
# A recursive target is refused whatever the policy says: the guard joins the
# policy here, so every site below asks the one predicate.
fun doInlining(f, tag, a: CgApp, recursive: Set<String>,
               policy: (:CgFunction): Bool)
  if f.fnName == "__entrypoint__" || f.fnBypassAsync
    ret f
  let shouldInline = (target: CgFunction) => !contains(recursive, target.fnName) && policy(target)
  let out = inlLoop(f.fnOps, 0, tag, a, shouldInline,
                    InlAcc(Array<Op>(), List()))
  ret cgFunctionWith(f, out.inlOps,
        CgStruct(concat(cgFieldsOfOrEmpty(f.fnStackVars), out.inlVars)))

fun [tail] inlLoop(s: Array<Op>, index: Int, tag,
                   a: CgApp, shouldInline,
                   acc: InlAcc): InlAcc
  ret index < size(s)
    ? inlLoop(s, index + 1, tag, a, shouldInline,
              inlStep(s[index], tag + "$" + String(index),
                      a, shouldInline, acc))
    : acc

# One op: splice the callee in when every guard passes, else keep the op.
fun inlStep(op, uniqueId, a: CgApp,
            shouldInline,
            acc: InlAcc) => match(inlCandidate(op, a, shouldInline))
  (t2: InlTarget) => inlSplice(t2, uniqueId, acc)
  ()               => InlAcc(push<Op>(acc.inlOps, op), acc.inlVars)

class [final] InlTarget(itCall: OpCall, itGf: RpGlobalFunction,
                        itArgs: RpNewStruct, itTarget: CgFunction)

fun inlCandidate(op, a: CgApp,
                 shouldInline) => match(op)
  (c: OpCall) => match(c.callFunction)
    (gf: RpGlobalFunction) => match(c.callParameters)
      (ns: RpNewStruct) => inlCandidateChecked(c, gf, ns, a, shouldInline)
      (o3: RParam)      => None
    (o: RParam)   => None
  (o4: Op)    => None

fun inlCandidateChecked(c, gf, ns, a: CgApp,
                        shouldInline)
  if c.callMusttail
    ret None
  ret match(appFunction(a, gf.name))
    # A [future] body is the unit a worker runs: inlined, its entry yield
    # would hand the rest of the CALLER over instead.
    (target: CgFunction) => !isEmpty(target.fnOps)
                            && !target.fnFuture
                            && shouldInline(target)
      ? InlTarget(c, gf, ns, target)
      : None
    ()                    => None

# ── the splice ───────────────────────────────────────────────────────────────
# Fresh inl<id>$-prefixed stack vars for the callee's params + locals, label
# renames, `this` capture, param Moves, then the body with every Return
# replaced by Move(register)+Jump(end) and musttail flags cleared, and the end
# Label after it. Except: when the callee's first Return is its last op, that
# Return is its only one and control simply falls out of it, so it emits no
# Jump and the splice no Label. Decided from the callee, before emitting, so
# the splice never re-reads what it emitted. Python does the same.

fun inlSplice(t2: InlTarget, uniqueId,
              acc: InlAcc)
  let target = t2.itTarget
  let pFields = cgFieldsOfOrEmpty(target.fnParams)
  let allFields = concat(pFields, cgFieldsOfOrEmpty(target.fnStackVars))
  let renames = concat(
        map(allFields, (f2) =>
          RpRename(f2.fieldName, "inl" + uniqueId + "$" + f2.fieldName)),
        inlLabelRenames(target.fnOps, uniqueId))
  let newVars = map(allFields, (f2) =>
        CgField("inl" + uniqueId + "$" + f2.fieldName, f2.fieldType))
  let endLabel = "inl" + uniqueId + "end"
  let firstReturn = inlFirstReturn(target.fnOps, 0)
  let fallsOut = match(firstReturn)
    (k: Int) => k == size(target.fnOps) - 1
    ()       => false
  let ops1 = inlThisCapture(t2, uniqueId, allFields, acc.inlOps)
  let ops2 = inlParamMovesB(t2.itArgs.values, dropOne(pFields),
                            uniqueId, allFields, ops1)
  let ops3 = fold(target.fnOps, ops2,
                  (acc2: Array<Op>, op: Op) => inlBodyOp(op, t2.itCall, renames, endLabel, fallsOut, acc2))
  let ops4 = firstReturn is None || fallsOut ? ops3 : push<Op>(ops3, OpLabel(endLabel, Dict()))
  ret InlAcc(ops4, concat(acc.inlVars, newVars))

# The index of the callee's first Return, if it has one.
fun [tail] inlFirstReturn(ops: Array<Op>, i: Int): Int|None
  ret i >= size(ops) ? None : (ops[i] is OpReturn ? i : inlFirstReturn(ops, i + 1))

fun inlLabelRenames(ops: Array<Op>, uniqueId)
  ret fold(ops, List<RpRename>(), (acc: List<RpRename>, op: Op) => inlLabelRename(acc, op, uniqueId))

fun inlLabelRename(acc: List<RpRename>, op: Op, uniqueId): List<RpRename> => match(op)
  (lb: OpLabel) => append(acc, RpRename(lb.labelName, "inl" + uniqueId + "$" + lb.labelName))
  (o: Op)       => acc

# The renamed StackVar for a callee param/local (its declared type + the
# fresh inl<id>$ name) — the Move targets Python builds via variable_mapping.
fun inlMappedVar(fields: List<CgField>, name,
                 uniqueId) => match(head(filter(fields, (f2) => f2.fieldName == name)))
  (f2: CgField) => RpStackVar(f2.fieldType, "inl" + uniqueId + "$" + name)
  ()             => RpStackVar(CgVoid(), "inl" + uniqueId + "$" + name)
                    # unreachable: every param name is a field

fun inlThisCapture(t2: InlTarget, uniqueId, allFields: List<CgField>,
                   ops: Array<Op>): Array<Op> => match(t2.itGf.object)
  (obj: RParam) => match(head(cgFieldsOfOrEmpty(t2.itTarget.fnParams)))
    (f2: CgField) => push<Op>(ops,
        OpMove(inlMappedVar(allFields, f2.fieldName, uniqueId), obj,
               false, Dict()))
    ()             => ops   # unreachable: object implies a this param
  ()             => ops

fun inlParamMovesB(args: List<RpNamedValue>, params: List<CgField>,
                  uniqueId, allFields: List<CgField>,
                  ops: Array<Op>): Array<Op> =>
  zipFold(args, params, ops, (out: Array<Op>, av, pf) =>
    push<Op>(out, OpMove(inlMappedVar(allFields, pf.fieldName, uniqueId), av.value, false, Dict())))

fun inlBodyOp(op, c: OpCall, renames: List<RpRename>, endLabel, fallsOut: Bool,
              acc: Array<Op>): Array<Op> => match(op)
  (r: OpReturn)  => fallsOut
    ? inlReturnMove(r, c, renames, acc)
    : push<Op>(inlReturnMove(r, c, renames, acc), OpJump(endLabel, Dict()))
  (cl: OpCall)   => cl.callMusttail
    ? push<Op>(acc, opRenameVars(OpCall(cl.callFunction, cl.callParameters,
                                      cl.callRegister, false, cl.callImpure,
                                      cl.callResultType, cl.callSavedVars),
                               renames))
    : push<Op>(acc, opRenameVars(op, renames))
  (o: Op)        => push<Op>(acc, opRenameVars(op, renames))

fun inlReturnMove(r: OpReturn, c: OpCall, renames: List<RpRename>,
                  acc: Array<Op>): Array<Op> => match(c.callRegister)
  (reg: RParam) => push<Op>(acc, OpMove(reg,
                                   rpRenameVars(r.returnValue, renames),
                                   false, Dict()))
  ()             => acc


# ── recursiveFunctions (trim.py recursive_functions) ────────────────────────
# Internal functions on a cycle of the reference graph: each reaches itself,
# directly or through other functions, closures among them. Inlining one only
# unrolls the recursion, a level per round, so no inlining policy takes them.
# The graph changes between rounds, so each round recomputes this.

fun recursiveFunctions(a: CgApp): Set<String>
  let edges = EEdges(fold(appFunctions(a), Dict(), rfEdge))
  ret rfSccs(ceCyclicSccs(ceSccs(edges), edges, List()), Set())

fun rfEdge(acc: Dict<String, List<String>>, f: CgFunction)
  ret put(acc, f.fnName, setNames(scanFunction(f).ssFunctions))

# Named walks, not `fold`: a fold over a List into a Set can match both the
# List and the Set overload.
fun rfSccs(ss: List<List<String>>, acc: Set<String>) => fold(ss, acc, (a, s) => rfMembers(s, a))

fun rfMembers(ns: List<String>, acc: Set<String>) => fold(ns, acc, add)
