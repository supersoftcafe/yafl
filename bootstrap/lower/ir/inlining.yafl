# bootstrap/inlining.yafl — ported from lowering/inlining.py: the IR inliner.
# Structural guards are fixed (direct call to an internal global function with
# NewStruct args, not recursive — recursiveFunctions, which covers a self-call
# — not musttail, target non-empty and not [future]); the POLICY decides
# which eligible targets to pull in — the size cutoff, or [inline(always)]. A
# fn is never an inlining SINK if it is __entrypoint__ or bypass_async
# (async_lower passes those through untouched, so a suspending body inlined
# into them would never get its state machine). Also here: recursiveFunctions
# (trim.py — same __scan model as the dead-code pass, so they can never
# disagree about what references what).
namespace Bootstrap::Lower::Ir

import System

import Bootstrap::Ast

import Bootstrap::Codegen
import Bootstrap::Ir
import Bootstrap::Lower::Ast
import Bootstrap::Parse
import Bootstrap::StdlibCandidates



fun inlCutoffComplexity() => 5

# The IR inliner's knob (--inline-threshold): compiler.py's InlineOptions.
# The small-function cutoff, in ops (-O2 and up).
class [final] InlineOpts(ioThreshold: Int)

fun inlineDefaults() => InlineOpts(inlCutoffComplexity())

# ── the pass ─────────────────────────────────────────────────────────────────

fun inlineSmallFunctions(a: CgApp, inlineAlways, epoch: Int, cutoff: Int)
  let recursive = recursiveFunctions(a)
  ret appWithFunctions(a, map(appFunctions(a), (f) =>
        doInlining(f, "s" + String(epoch), a, recursive, (target) =>
          !atLeast(target.fnOps, cutoff)
          || (inlineAlways && target.fnAlwaysInline))))

# ── the engine ───────────────────────────────────────────────────────────────

# The rewritten op stream and the extra stack slots the inlined bodies need.
# The ops are a builder: an op that is NOT a call site — the overwhelming
# majority — now costs O(1) to keep, where it used to copy every op emitted so
# far. A splice still materialises the stream, because the end-label
# bookkeeping inspects it, but that is once per inlined call rather than once
# per instruction.
class [linear, final] InlAcc(inlOps: ListBuilder<Op>,
                             inlVars: List<CgField>)

# The inlined-name uniquifier is the fixpoint EPOCH, not the op count:
# distinct per round by construction (the count merely happened to change
# every round), and never a calculated length. Python mirrors this exactly.
# A recursive target is refused whatever the policy says: the guard joins the
# policy here, so every site below asks the one predicate.
fun doInlining(f, tag, a: CgApp, recursive: Set<String>,
               policy: (:CgFunction): Bool)
  if f.fnName == "__entrypoint__" || f.fnBypassAsync
    ret f
  let shouldInline = (target: CgFunction) => !contains(recursive, target.fnName) && policy(target)
  let out = inlLoop(f.fnOps, 0i32, 0, tag, a, shouldInline,
                    InlAcc(builder(), List()))
  # The splice assembly stays a transient List (end-bookkeeping reads and
  # pops it); the retained result crosses to Segment storage here.
  ret cgFunctionWith(f, cgOpsOf(build(out.inlOps)),
        CgStruct(concat(cgFieldsOfOrEmpty(f.fnStackVars), out.inlVars)))

fun [tail] inlLoop(s: Segment<Op>|None, iSeg, index, tag,
                   a: CgApp, shouldInline,
                   [terminal] acc): InlAcc => match(s)
  (nil: None)        => acc
  (seg: Segment<Op>) => iSeg < seg.length
    ? inlLoop(s, iSeg + 1i32, index + 1, tag, a, shouldInline,
              inlStep(seg.array(iSeg), tag + "$" + String(index),
                      a, shouldInline, acc))
    : inlLoop(seg.next, 0i32, index, tag, a, shouldInline, acc)

# One op: splice the callee in when every guard passes, else keep the op.
fun inlStep(op, uniqueId, a: CgApp,
            shouldInline,
            [terminal] acc: InlAcc) => match(inlCandidate(op, a, shouldInline))
  (t2: InlTarget) => inlSplice(t2, uniqueId, acc)
  ()               => InlAcc(push(acc.inlOps, op), acc.inlVars)

class [final] InlTarget(itCall: OpCall, itGf: RpGlobalFunction,
                        itArgs: RpNewStruct, itTarget: CgFunction)

fun inlCandidate(op, a: CgApp,
                 shouldInline) => match(op)
  (c: OpCall) => match(c.callFunction)
    (gf: RpGlobalFunction) => match(c.callParameters)
      (ns: RpNewStruct) => inlCandidateChecked(c, gf, ns, a, shouldInline)
      (o3: RParam)      => None
    (o: RParam)   => None
  (o4: Op)    => None

fun inlCandidateChecked(c, gf, ns, a: CgApp,
                        shouldInline)
  if c.callMusttail
    ret None
  ret match(appFunction(a, gf.name))
    # A [future] body is the unit a worker runs: inlined, its entry yield
    # would hand the rest of the CALLER over instead.
    (target: CgFunction) => !isEmpty(target.fnOps)
                            && !target.fnFuture
                            && shouldInline(target)
      ? InlTarget(c, gf, ns, target)
      : None
    ()                    => None

# ── the splice ───────────────────────────────────────────────────────────────
# Fresh inl<id>$-prefixed stack vars for the callee's params + locals, label
# renames, `this` capture, param Moves, the body with every Return replaced by
# Move(register)+Jump(end) and musttail flags cleared, then the end-label
# bookkeeping: append the Label only when some end-jump is not simply the last
# op emitted; pop a sole trailing end-jump (Python's `end_jump in new_ops` /
# first-index semantics — the label is unique per splice, so the global test
# reduces to this segment).

fun inlSplice(t2: InlTarget, uniqueId,
              [terminal] acc: InlAcc)
  let target = t2.itTarget
  let pFields = cgFieldsOfOrEmpty(target.fnParams)
  let allFields = concat(pFields, cgFieldsOfOrEmpty(target.fnStackVars))
  let renames = concat(
        map(allFields, (f2) =>
          RpRename(f2.fieldName, "inl" + uniqueId + "$" + f2.fieldName)),
        inlLabelRenames(target.fnOps, uniqueId))
  let newVars = map(allFields, (f2) =>
        CgField("inl" + uniqueId + "$" + f2.fieldName, f2.fieldType))
  let endLabel = "inl" + uniqueId + "end"
  # One builder from the call site's ops through to the inlined body; the
  # end bookkeeping READS the result, so it is built there and not before.
  let ops1 = inlThisCapture(t2, uniqueId, allFields, acc.inlOps)
  let ops2 = inlParamMovesB(chain(t2.itArgs.values), chain(tail(pFields)),
                            uniqueId, allFields, ops1)
  let ops3 = inlBody(target.fnOps, 0i32, t2.itCall, renames, endLabel, ops2)
  ret InlAcc(builderFrom(inlEndBookkeeping(build(ops3), endLabel)),
             concat(acc.inlVars, newVars))

fun inlLabelRenames(ops: Segment<Op>|None, uniqueId)
  ret build(inlLabelRenamesB(ops, 0i32, uniqueId, builder()))

fun [tail] inlLabelRenamesB(s: Segment<Op>|None, i, uniqueId,
                           [terminal] acc): ListBuilder<RpRename> => match(s)
  (nil: None)        => acc
  (seg: Segment<Op>) => i >= seg.length
    ? inlLabelRenamesB(seg.next, 0i32, uniqueId, acc)
    : match(seg.array(i))
        (lb: OpLabel) => inlLabelRenamesB(s, i + 1i32, uniqueId,
            push(acc, RpRename(lb.labelName,
                      "inl" + uniqueId + "$" + lb.labelName)))
        (o: Op)       => inlLabelRenamesB(s, i + 1i32, uniqueId, acc)

# The renamed StackVar for a callee param/local (its declared type + the
# fresh inl<id>$ name) — the Move targets Python builds via variable_mapping.
fun inlMappedVar(fields: List<CgField>, name,
                 uniqueId) => match(head(filter(fields, (f2) => f2.fieldName == name)))
  (f2: CgField) => RpStackVar(f2.fieldType, "inl" + uniqueId + "$" + name)
  ()             => RpStackVar(CgVoid(), "inl" + uniqueId + "$" + name)
                    # unreachable: every param name is a field

fun inlThisCapture(t2: InlTarget, uniqueId, allFields: List<CgField>,
                   [terminal] ops): ListBuilder<Op> => match(t2.itGf.object)
  (obj: RParam) => match(head(cgFieldsOfOrEmpty(t2.itTarget.fnParams)))
    (f2: CgField) => push(ops,
        OpMove(inlMappedVar(allFields, f2.fieldName, uniqueId), obj,
               false, Dict()))
    ()             => ops   # unreachable: object implies a this param
  ()             => ops

fun inlParamMoves(args: Chain<RpNamedValue>, params: Chain<CgField>,
                         uniqueId, allFields: List<CgField>,
                         ops: List<Op>)
  ret build(inlParamMovesB(args, params, uniqueId, allFields, builderFrom(ops)))

fun [tail] inlParamMovesB(args: Chain<RpNamedValue>, params: Chain<CgField>,
                         uniqueId, allFields: List<CgField>,
                         [terminal] ops): ListBuilder<Op> => match(args)
  (nil: ChainEnd) => ops
  (av: ChainLink) => match(params)
    (nil2: ChainEnd) => ops
    (pf: ChainLink)  => inlParamMovesB(av.next, pf.next, uniqueId, allFields,
        push(ops, OpMove(inlMappedVar(allFields, pf.value.fieldName,
                                   uniqueId),
                      av.value.value, false, Dict())))

fun [tail] inlBody(s: Segment<Op>|None, i, c: OpCall, renames: List<RpRename>,
                   endLabel,
                   [terminal] acc): ListBuilder<Op> => match(s)
  (nil: None)        => acc
  (seg: Segment<Op>) => i < seg.length
    ? inlBody(s, i + 1i32, c, renames, endLabel,
              inlBodyOp(seg.array(i), c, renames, endLabel, acc))
    : inlBody(seg.next, 0i32, c, renames, endLabel, acc)

fun inlBodyOp(op, c: OpCall, renames: List<RpRename>, endLabel,
              [terminal] acc): ListBuilder<Op> => match(op)
  (r: OpReturn)  => push(inlReturnMove(r, c, renames, acc),
                         OpJump(endLabel, Dict()))
  (cl: OpCall)   => cl.callMusttail
    ? push(acc, opRenameVars(OpCall(cl.callFunction, cl.callParameters,
                                    cl.callRegister, false, cl.callImpure,
                                    cl.callResultType, cl.callSavedVars),
                             renames))
    : push(acc, opRenameVars(op, renames))
  (o: Op)        => push(acc, opRenameVars(op, renames))

fun inlReturnMove(r: OpReturn, c: OpCall, renames: List<RpRename>,
                  [terminal] acc): ListBuilder<Op> => match(c.callRegister)
  (reg: RParam) => push(acc, OpMove(reg,
                                 rpRenameVars(r.returnValue, renames),
                                 false, Dict()))
  ()             => acc

# Python: `if end_jump in new_ops` (any Return was seen), then FIRST index —
# if it is not the very last op, some jump needs a target: append the Label;
# otherwise the sole jump sits just before where the label would go: pop it.
fun inlEndBookkeeping(ops, endLabel) => match(inlFirstEndJumpIsLast(chain(ops), endLabel))
  (isLast: Bool) => isLast
    ? inlDropLast(chain(ops), List())
    : build(push(builderFrom(ops),
                 OpLabel(endLabel, Dict())))
  ()             => ops

# None: no end-jump. true: the FIRST end-jump is the very last op (pop it).
# false: it has a successor (append the Label). Purely structural — the old
# index-vs-length compare is gone (no-length ruling).
fun [tail] inlFirstEndJumpIsLast(ops: Chain<Op>, endLabel) => match(ops)
  (nil: ChainEnd) => None
  (l: ChainLink)  => match(l.value)
    (j: OpJump) => j.jumpName == endLabel
      ? !(l.next is ChainLink)
      : inlFirstEndJumpIsLast(l.next, endLabel)
    (o: Op)     => inlFirstEndJumpIsLast(l.next, endLabel)

fun inlDropLast(ops, acc: List<Op>): List<Op> => build(inlDropLastB(ops, builderFrom(acc)))

fun [tail] inlDropLastB(ops: Chain<Op>, [terminal] acc: ListBuilder<Op>) => match(ops)
  (nil: ChainEnd) => acc
  (l: ChainLink)  => match(l.next)
    (nil2: ChainEnd) => acc
    (o: ChainLink)   => inlDropLastB(l.next, push(acc, l.value))

# ── recursiveFunctions (trim.py recursive_functions) ────────────────────────
# Internal functions on a cycle of the reference graph: each reaches itself,
# directly or through other functions, closures among them. Inlining one only
# unrolls the recursion, a level per round, so no inlining policy takes them.
# The graph changes between rounds, so each round recomputes this.

fun recursiveFunctions(a: CgApp): Set<String>
  let edges = EEdges(fold(appFunctions(a), Dict(), rfEdge))
  ret rfSccs(chain(ceCyclicSccs(chain(ceSccs(edges)), edges, List())), Set())

fun rfEdge(acc: Dict<String, List<String>>, f: CgFunction)
  ret put(acc, f.fnName, setNames(scanFunction(f).ssFunctions))

# Named walks, not `fold`: a fold over a List into a Set can match both the
# List and the Set overload.
fun [tail] rfSccs(ss: Chain<List<String>>, acc: Set<String>) => match(ss)
  (nil: ChainEnd) => acc
  (l: ChainLink)  => rfSccs(l.next, rfMembers(chain(l.value), acc))

fun [tail] rfMembers(ns: Chain<String>, acc: Set<String>) => match(ns)
  (nil: ChainEnd) => acc
  (l: ChainLink)  => rfMembers(l.next, add(acc, l.value))
