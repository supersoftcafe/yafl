# bootstrap/phi_removal.yafl — leave SSA before async lowering, ported from
# lowering/phi_removal.py: (1) cgFunctionLowerPhis (ir.yafl) turns every Phi
# into per-edge Moves; (2) copy coalescing folds a phi web's edge copy
# Move(T, src) into src's defining op when src is defined once and read once
# (by the copy) and nothing touches T between definition and copy within the
# block — the definition is renamed to write T and the copy disappears.
# saved_vars count as READS. From here the IR is deliberately NOT single-
# assignment; the final ssa_validate runs with ssa=false.
namespace Bootstrap::Lower::Ir

import System

import Bootstrap::Ir
import Bootstrap::StdlibCandidates



fun removePhis(a: CgApp): CgApp
  ret appWithFunctions(a, map(appFunctions(a),
        (f: CgFunction) => prCoalesceCopies(cgFunctionLowerPhis(f))))

# ── def/read counts (saved_vars are reads) ──────────────────────────────────

class [final] PrCounts(prDefs: List<StrCount>, prReads: List<StrCount>)

fun prCountVars(ops: Segment<Op>|None): PrCounts
  ret fold(ops, PrCounts(List<StrCount>(), List<StrCount>()), prCountOp)

fun prCountOp(acc: PrCounts, op: Op): PrCounts
  let reads1 = fold(opReadVarNames(op), acc.prReads, strCountIncr)
  let reads2 = fold(opSavedVars(op), reads1,
                    (r: List<StrCount>, sv: RParam) => prIncrIfStackVar(r, sv))
  let defs1 = fold(ssavOpWrites(op), acc.prDefs,
                   (d: List<StrCount>, sv: RParam) => prIncrIfStackVar(d, sv))
  ret PrCounts(defs1, reads2)

fun prIncrIfStackVar(acc: List<StrCount>, sv: RParam): List<StrCount>
  ret match(sv)
    (s2: RpStackVar) => strCountIncr(acc, s2.name)
    (o: RParam)       => acc

# ── the coalescer ────────────────────────────────────────────────────────────

fun prCoalesceCopies(f: CgFunction): CgFunction
  let counts = prCountVars(f.fnOps)
  let p0 = cgPullOp(seqStream<Op>(f.fnOps))
  let out = prScan(p0.op, p0.stream, List<Op>(), counts, 0, List<Int>(), List<PrRename>(),
                   counts.prDefs)
  ret isEmpty(out.proRemoved)
    ? f
    : prRebuild(f, out)

# proRemoved: op indices to drop. proRenames: (def-op index, s → T's own
# StackVar spelling) substitutions — name AND type, mirroring Python: a
# name-only rename kept the source's type and minted the same name at two
# precisions, breaking the (type,name)-keyed liveness kill in async_lower.
class [final] PrRename(prrIdx: Int, prrOld: String, prrNewVar: RParam)
class [final] PrOut(proRemoved: List<Int>, proRenames: List<PrRename>)

# `back` is the ops already scanned, most-recent FIRST — prFindDef's backward
# walk reads it directly instead of re-indexing `ops` (prepend keeps the list
# front-normal, so chain() over it is free).
fun [tail] prScan(cur: Op|None, st: SeqStream<Op>, back: List<Op>, counts: PrCounts, i: Int,
                  removed: List<Int>, renames: List<PrRename>,
                  defs: List<StrCount>): PrOut
  if cur is None
    ret PrOut(removed, renames)
  let op = forceOp(cur)
  let p = cgPullOp(st)
  ret match(prCandidate(op))
    (c: PrCand) => c.pcSelf
      # `removed` is turned into a Dict set by its consumer, and each rename
      # is applied by matching its op index — neither order is observed.
      ? prScan(p.op, p.stream, prepend(op, back), counts, i + 1,
               prepend(i, removed), renames, defs)
      : prTryCoalesce(op, p.op, p.stream, back, counts, i, c, removed, renames, defs)
    ()           => prScan(p.op, p.stream, prepend(op, back), counts, i + 1,
                           removed, renames, defs)

# A coalescible copy: Move without keep, StackVar := StackVar. pcSelf marks
# the degenerate T := T (dropped outright).
class [final] PrCand(pcT: String, pcS: String, pcSelf: Bool, pcTVar: RParam)

fun prCandidate(op: Op): PrCand|None
  ret match(op)
    (m: OpMove) => m.moveKeep ? None : prCandTargets(m)
    (o: Op)     => None

fun prCandTargets(m: OpMove): PrCand|None
  ret match(m.moveTarget)
    (t2: RpStackVar) => match(m.moveSource)
      (s2: RpStackVar) => PrCand(t2.name, s2.name, t2.name == s2.name, m.moveTarget)
      (o: RParam)       => None
    (o2: RParam)      => None

fun prTryCoalesce(op: Op, nxt: Op|None, st: SeqStream<Op>, back: List<Op>,
                  counts: PrCounts, i: Int,
                  c: PrCand, removed: List<Int>, renames: List<PrRename>,
                  defs: List<StrCount>): PrOut
  let onwards = prepend(op, back)
  if strCountGet(defs, c.pcS) != 1 || strCountGet(counts.prReads, c.pcS) != 1
    ret prScan(nxt, st, onwards, counts, i + 1, removed, renames, defs)
  ret match(prFindDef(chain(back), i - 1, c))
    (di: Int) => prScan(nxt, st, onwards, counts, i + 1, prepend(i, removed),
                        prepend(PrRename(di, c.pcS, c.pcTVar), renames),
                        strCountIncr(defs, c.pcT))
    ()         => prScan(nxt, st, onwards, counts, i + 1, removed, renames, defs)

# Walk back within the block to src's definition; bail on a block boundary
# (labels/jumps/returns — value flow beyond the block is invisible here) or
# when T or S is touched in between.
fun [tail] prFindDef(back: Chain<Op>, j: Int, c: PrCand): Int|None
  ret match(back)
    (nil: ChainEnd) => None
    (l: ChainLink)  => prBlockBoundary(l.value)
      ? None
      : prWritesName(l.value, c.pcS)
        ? j
        : prTouches(l.value, c.pcT) || prTouches(l.value, c.pcS)
          ? None
          : prFindDef(l.next, j - 1, c)

fun prBlockBoundary(op: Op): Bool
  ret match(op)
    (lb: OpLabel)      => true
    (j: OpJump)        => true
    (ji: OpJumpIf)     => true
    (sw: OpSwitchJump) => true
    (t2: OpIfTask)     => true
    (r: OpReturn)      => true
    (rv: OpReturnVoid) => true
    (a: OpAbort)       => true
    (o: Op)            => false

fun prWritesName(op: Op, name: String): Bool
  ret any(ssavOpWrites(op), (sv: RParam) => prIsNamed(sv, name))

fun prIsNamed(sv: RParam, name: String): Bool
  ret match(sv)
    (s2: RpStackVar) => s2.name == name
    (o: RParam)       => false

fun prTouches(op: Op, name: String): Bool
  ret strListMember(opReadVarNames(op), name) || prWritesName(op, name)

# ── rebuild: apply renames, drop removed ops and dead source stackvars ──────

fun prRebuild(f: CgFunction, out: PrOut): CgFunction
  let removedSet = prRemovedSet(chain(out.proRemoved), Dict<Int, Bool>())
  let newOps = prRebuildOps(f.fnOps, out, removedSet)
  let dead = prDeadSources(f.fnOps, 0i32, 0, removedSet, Set<String>())
  ret cgFunctionWith(f, newOps,
        CgStruct(filter(cgFieldsOfOrEmpty(f.fnStackVars),
                        (fld: CgField) => !contains<String>(dead, fld.fieldName))))

fun prRebuildOps(ops: Segment<Op>|None, out: PrOut, removedSet: Dict<Int, Bool>): Segment<Op>|None
  ret build<Op >(prRebuildLoopB(ops, 0i32, out, removedSet, 0, seqBuilder<Op >()))

# Removed indices are a SET (Python's `removed: set[int]`) — the membership
# test runs once per op, so a list scan made the rebuild quadratic.
fun [tail] prRemovedSet(is2: Chain<Int>, acc: Dict<Int, Bool>): Dict<Int, Bool>
  ret match(is2)
    (nil: ChainEnd) => acc
    (l: ChainLink)  => prRemovedSet(l.next, put(acc, l.value, true))

fun prIsRemoved(removedSet: Dict<Int, Bool>, i: Int): Bool
  ret match(get(removedSet, i))
    (b: Bool) => b
    ()        => false

fun [tail] prRebuildLoopB(s: Segment<Op>|None, iSeg: Int32, out: PrOut,
                          removedSet: Dict<Int, Bool>,
                          i: Int, [terminal] acc: SeqBuilder<Op >): SeqBuilder<Op >
  ret match(s)
    (nil: None)        => acc
    (seg: Segment<Op>) => iSeg < seg.length
      ? prRebuildLoopB(s, iSeg + 1i32, out, removedSet, i + 1,
          prIsRemoved(removedSet, i)
            ? acc
            : push<Op >(acc, prApplyRename(seg.array(iSeg), i, out.proRenames)))
      : prRebuildLoopB(seg.next, 0i32, out, removedSet, i, acc)

fun prApplyRename(op: Op, i: Int, renames: List<PrRename>): Op
  ret fold(renames, op, (o: Op, r: PrRename) => r.prrIdx == i
             ? opReplaceParams(o, (p: RParam) => prIsNamed(p, r.prrOld) ? r.prrNewVar : p)
             : o)

# Dead = each removed non-self copy's SOURCE name.
fun [tail] prDeadSources(s: Segment<Op>|None, iSeg: Int32, i: Int, removedSet: Dict<Int, Bool>,
                         acc: Set<String>): Set<String>
  ret match(s)
    (nil: None)        => acc
    (seg: Segment<Op>) => iSeg < seg.length
      ? prDeadSources(s, iSeg + 1i32, i + 1, removedSet,
          prIsRemoved(removedSet, i) ? prDeadOne(acc, seg.array(iSeg)) : acc)
      : prDeadSources(seg.next, 0i32, i, removedSet, acc)

fun prDeadOne(acc: Set<String>, op: Op): Set<String>
  ret match(prCandidate(op))
    (c: PrCand) => c.pcSelf ? acc : add<String>(acc, c.pcS)
    ()           => acc
