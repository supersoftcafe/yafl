# bootstrap/phi_removal.yafl — leave SSA before async lowering, ported from
# lowering/phi_removal.py: (1) cgFunctionLowerPhis (ir.yafl) turns every Phi
# into per-edge Moves; (2) copy coalescing folds a phi web's edge copy
# Move(T, src) into src's defining op when src is defined once and read once
# (by the copy) and nothing touches T between definition and copy within the
# block — the definition is renamed to write T and the copy disappears.
# saved_vars count as READS. From here the IR is deliberately NOT single-
# assignment; the final ssa_validate runs with ssa=false.
namespace Bootstrap::Lower::Ir

import System
import System::Containers

import Bootstrap::Ir
import Bootstrap::StdlibCandidates



fun removePhis(a: CgApp) => appWithFunctions(a, powerMap(appFunctions(a),
                              (f) => prCoalesceCopies(cgFunctionLowerPhis(f))))

# ── def/read counts (saved_vars are reads) ──────────────────────────────────

class [final] PrCounts(prDefs: Dict<String, Int>, prReads: Dict<String, Int>)

fun prCountVars(ops: Array<Op>) => fold(ops, PrCounts(Dict(), Dict()), prCountOp)

fun prCountOp(acc: PrCounts, op)
  let reads1 = fold(opReadVarNames(op), acc.prReads, sdBump)
  let reads2 = fold(values(opSavedVars(op)), reads1,
                    prIncrIfStackVar)
  let defs1 = fold(opGetLiveVars(op).writes, acc.prDefs,
                   prIncrIfStackVar)
  ret PrCounts(defs1, reads2)

fun prCount(counts: Dict<String, Int>, name: String): Int => get(counts, name) ?? 0

fun prIncrIfStackVar(acc: Dict<String, Int>, sv): Dict<String, Int> => match(sv)
  (s2: RpStackVar) => sdBump(acc, s2.name)
  (o: RParam)       => acc

# ── the coalescer ────────────────────────────────────────────────────────────

fun prCoalesceCopies(f): CgFunction
  let counts = prCountVars(f.fnOps)
  let out = prScan(f.fnOps, 0, counts, List(), List(), counts.prDefs)
  ret isEmpty(out.proRemoved)
    ? f
    : prRebuild(f, out)

# proRemoved: op indices to drop. proRenames: (def-op index, s → T's own
# StackVar spelling) substitutions — name AND type, mirroring Python: a
# name-only rename kept the source's type and minted the same name at two
# precisions, breaking the (type,name)-keyed liveness kill in async_lower.
class [final] PrRename(prrIdx: Int, prrOld: String, prrNewVar: RParam)
class [final] PrOut(proRemoved: List<Int>, proRenames: List<PrRename>)

# The ops are walked by index, so prFindDef can read back from any of them.
fun [tail] prScan(ops: Array<Op>, i: Int, counts: PrCounts,
                  removed, renames,
                  defs: Dict<String, Int>): PrOut
  if i >= size(ops)
    ret PrOut(removed, renames)
  ret match(prCandidate(ops[i]))
    (c: PrCand) => c.pcSelf
      # `removed` is turned into a Dict set by its consumer, and each rename
      # is applied by matching its op index — neither order is observed.
      ? prScan(ops, i + 1, counts, prepend(i, removed), renames, defs)
      : prTryCoalesce(ops, i, counts, c, removed, renames, defs)
    ()           => prScan(ops, i + 1, counts, removed, renames, defs)

# A coalescible copy: Move without keep, StackVar := StackVar. pcSelf marks
# the degenerate T := T (dropped outright).
class [final] PrCand(pcT: String, pcS: String, pcSelf: Bool, pcTVar: RParam)

fun prCandidate(op) => match(op)
  (m: OpMove) => m.moveKeep ? None : prCandTargets(m)
  (o: Op)     => None

fun prCandTargets(m: OpMove) => match(m.moveTarget)
  (t2: RpStackVar) => match(m.moveSource)
    (s2: RpStackVar) => PrCand(t2.name, s2.name, t2.name == s2.name, m.moveTarget)
    (o: RParam)       => None
  (o2: RParam)      => None

fun prTryCoalesce(ops: Array<Op>, i: Int, counts: PrCounts,
                  c: PrCand, removed, renames,
                  defs: Dict<String, Int>)
  if prCount(defs, c.pcS) != 1 || prCount(counts.prReads, c.pcS) != 1
    ret prScan(ops, i + 1, counts, removed, renames, defs)
  ret match(prFindDef(ops, i - 1, c))
    (di: Int) => prScan(ops, i + 1, counts, prepend(i, removed),
                        prepend(PrRename(di, c.pcS, c.pcTVar), renames),
                        sdBump(defs, c.pcT))
    ()         => prScan(ops, i + 1, counts, removed, renames, defs)

# Walk back within the block to src's definition; bail on a block boundary
# (labels/jumps/returns — value flow beyond the block is invisible here) or
# when T or S is touched in between.
# The search stops at the first op, from j down, that is a block boundary,
# writes `s`, or touches either name; only a write that is not a boundary is
# a hit.
fun [tail] prFindDef(ops: Array<Op>, j: Int, c: PrCand): Int|None
  if j < 0
    ret None
  ret prStopsSearch(ops[j], c)
    ? (!prBlockBoundary(ops[j]) && prWritesName(ops[j], c.pcS) ? j : None)
    : prFindDef(ops, j - 1, c)

fun prStopsSearch(op: Op, c: PrCand): Bool =>
  prBlockBoundary(op) || prWritesName(op, c.pcS) || prTouches(op, c.pcT) || prTouches(op, c.pcS)

fun prBlockBoundary(op) => op is OpLabel || !opFallsThrough(op) || !isEmpty(opBranchTargets(op))

fun prWritesName(op, name) => any(opTargets(op), (sv) => prIsNamed(sv, name))

fun prIsNamed(sv, name) => match(sv)
  (s2: RpStackVar) => s2.name == name
  (o: RParam)       => false

fun prTouches(op, name) => contains(opReadVarNames(op), name) || prWritesName(op, name)

# ── rebuild: apply renames, drop removed ops and dead source stackvars ──────

fun prRebuild(f: CgFunction, out: PrOut)
  let removedSet = prRemovedSet(out.proRemoved, Dict())
  let newOps = prRebuildOps(f.fnOps, out, removedSet)
  let dead = fold(out.proRemoved, Set<String>(), (acc: Set<String>, i: Int) => prDeadOne(acc, f.fnOps[i]))
  ret cgFunctionWith(f, newOps,
        CgStruct(filter(cgFieldsOfOrEmpty(f.fnStackVars),
                        (fld) => !contains(dead, fld.fieldName))))

fun prRebuildOps(ops: Array<Op>, out: PrOut, removedSet: Dict<Int, Bool>)
  ret prRebuildLoopB(ops, out, removedSet, 0, Array<Op>())

# Removed indices are a SET (Python's `removed: set[int]`) — the membership
# test runs once per op, so a list scan made the rebuild quadratic.
fun prRemovedSet(is2: List<Int>, acc: Dict<Int, Bool>) => fold(is2, acc, (a, i) => put(a, i, true))

fun prIsRemoved(removedSet: Dict<Int, Bool>, i: Int) => match(get(removedSet, i))
  (b: Bool) => b
  ()        => false

fun [tail] prRebuildLoopB(s: Array<Op>, out: PrOut,
                          removedSet: Dict<Int, Bool>,
                          i: Int, acc: Array<Op>): Array<Op>
  ret i < size(s)
    ? prRebuildLoopB(s, out, removedSet, i + 1,
        prIsRemoved(removedSet, i)
          ? acc
          : push(acc, prApplyRename(s[i], i, out.proRenames)))
    : acc

fun prApplyRename(op: Op, i: Int, renames: List<PrRename>)
  ret fold(renames, op, (o, r) => r.prrIdx == i
             ? opReplaceParams(o, (p) => prIsNamed(p, r.prrOld) ? r.prrNewVar : p)
             : o)

# Dead = each removed non-self copy's SOURCE name (prRebuild reads the
# removed indices straight out of the op array).
fun prDeadOne(acc, op): Set<String> => match(prCandidate(op))
  (c: PrCand) => c.pcSelf ? acc : add(acc, c.pcS)
  ()           => acc
