# bootstrap/lower/ir/mutable_stores.yafl — ported from lowering/mutable_stores.py:
# tell each field store whether its container is mutable.
#
# Whether an object is mutable is a fact about its class (objIsMutable), known
# here and not to the runtime without a read of the object's page header. A
# store into a mutable object takes GC_STORE_MUTABLE_IN, which skips the
# nursery's private test: a mutable object is never private (yafl.h, "Pointer
# stores"). Every other store keeps GC_STORE_IN, which is correct for either.
#
# Runs at every optimisation level, last, after the representation merge, so
# the object names it reads are the ones emitted.
namespace Bootstrap::Lower::Ir

import System

import Bootstrap::Ir
import Bootstrap::StdlibCandidates


fun markMutableStores(a: CgApp): CgApp
  let mutableClasses = msMutableNames(chain(appObjects(a)), setEmpty())
  ret appWithFunctions(a, map(appFunctions(a), (f) => msFunction(f, mutableClasses)))

fun [tail] msMutableNames(os: Chain<CgObject>, acc) => match(os)
  (nil: ChainEnd) => acc
  (l: ChainLink)  => msMutableNames(l.next, l.value.objIsMutable
                                              ? setAdd(acc, l.value.objName)
                                              : acc)

fun msFunction(f: CgFunction, mutableClasses: StrSet)
  ret cgFunctionWith(f, map(f.fnOps, (op) => msOp(op, mutableClasses)), f.fnStackVars)

fun msOp(op: Op, mutableClasses: StrSet): Op => match(op)
  (m: OpMove) => msMove(m, mutableClasses)
  (o: Op)     => op

fun msMove(m: OpMove, mutableClasses: StrSet): Op => match(m.moveTarget)
  (of: RpObjectField) => setHas(mutableClasses, of.objectName)
    ? with m(moveTarget = with of(mutable = true))
    : m
  (o: RParam)         => m
