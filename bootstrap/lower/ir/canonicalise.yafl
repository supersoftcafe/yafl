# bootstrap/canonicalise.yafl — ported from lowering/canonicalise.py: spell
# equal code equally, so representation dedup finds more of it. Runs just
# before dedup, after every other IR pass, and changes no behaviour.
#
# DEBRIS. The emitter's own per-function cleanup chain (gen.yafl genFunction:
# lower phis, strip unused ops, simplify control flow, fold struct fields,
# propagate copies, simplify again, eliminate common subexpressions) runs here,
# BEFORE dedup, and the locals it leaves unused are dropped from the
# declarations, which dedup compares as a set. Emission then finds nothing more
# to do.
#
# OBJECT FIELD NAMES. A generated object's field names carry the hash of the
# declaration that made them, so two classes with the same layout never
# compare equal. Each generated object's fields are renamed to their position,
# consistently in the object, every field access and every static initialiser.
# Foreign objects keep their names, as do `type` and `array`. Off under
# --profile, like dedup.
namespace Bootstrap::Lower::Ir

import System

import Bootstrap::Ir



# ── API ──────────────────────────────────────────────────────────────────────

fun canonicaliseApp(a: CgApp, profile: Bool): CgApp
  if profile
    ret a
  let rn = cnRenames(appObjects(a))
  ret appOf(map(appFunctions(a), (f) => cnFunctionFields(rn, cnCleaned(f))),
            map(appObjects(a), (o) => cnObject(rn, o)),
            map(appGlobals(a), (g2) => cnGlobal(rn, g2)))

# ── debris: the emitter's cleanups, then unused declarations ────────────────

fun cnCleaned(f: CgFunction): CgFunction
  if !(f.fnForeignSymbol is None) || f.fnOps is None
    ret f
  let c = cgFunctionEliminateCSE(cgFunctionSimplifyControlFlow(cgFunctionCopyPropagate(
            cgFunctionFoldStructFields(cgFunctionSimplifyControlFlow(
              cgFunctionStripUnusedOperations(cgFunctionLowerPhis(f)))))))
  let used = fold(c.fnOps, cnNames(setEmpty(), map(cgFieldsOfOrEmpty(c.fnParams), (fd) => fd.fieldName)),
                  cnOpLocals)
  let decls = cgFieldsOfOrEmpty(c.fnStackVars)
  ret any(decls, (fd) => !setHas(used, fd.fieldName))
    ? cgFunctionWith(c, c.fnOps, CgStruct(filter(decls, (fd) => setHas(used, fd.fieldName))))
    : c

fun cnNames(acc: StrSet, names: List<String>): StrSet => fold(names, acc, (s2, n) => setAdd(s2, n))

# Every local an op mentions: what it reads (each flattened param re-flattened
# as a read, as Python does), its saved set, and what it writes — a write is
# not in the flattened params.
fun cnOpLocals(acc: StrSet, op: Op): StrSet
  let reads = fold(opAllParams(op), acc,
                   (s2, q) => fold(rpFlatten(q, true), s2, cnAddLocal))
  let saved = fold(opSavedVars(op), reads, cnAddLocal)
  ret fold(cnWrites(op), saved, cnAddLocal)

fun cnAddLocal(acc: StrSet, r: RParam): StrSet => match(r)
  (sv: RpStackVar) => setAdd(acc, sv.name)
  (o: RParam)      => acc

fun cnWrites(op: Op): List<RParam> => match(op)
  (x: OpMove)         => prepend(x.moveTarget, List())
  (x: OpPhi)          => prepend(x.phiTarget, List())
  (x: OpNewObject)    => prepend(x.newObjRegister, List())
  (x: OpCall)         => cnOpt(x.callRegister, List())
  (x: OpIfTask)       => prepend(x.taskLhs, prepend(x.callIdLhs, List()))
  (x: OpParallelCall) => cnOpt(x.parRegister, x.parResults)
  (o: Op)             => List()

fun cnOpt(r: RParam|None, rest: List<RParam>): List<RParam> => match(r)
  (x: RParam) => prepend(x, rest)
  ()          => rest

# ── object field names by position ───────────────────────────────────────────

fun cnRenames(objs: List<CgObject>): Dict<String, Dict<String, String>>
  ret fold(filter(objs, (o) => !o.objIsForeign), Dict(),
           (d, o) => put(d, o.objName, cnPositional(cgFieldsOfOrEmpty(o.objFields))))

fun cnPositional(fields: List<CgField>): Dict<String, String>
  ret fold(fields, (d = Dict(), i = 0),
           (acc, fd) => (d = put(acc.d, fd.fieldName, cnPositionName(fd.fieldName, acc.i)),
                         i = acc.i + 1)).d

fun cnPositionName(name: String, i: Int): String
  ret name == "type" || name == "array" ? name : "$f" + String(i)

fun cnRename(r: Dict<String, String>, name: String): String => match(get(r, name))
  (x: String) => x
  ()          => name

fun cnObject(rn: Dict<String, Dict<String, String>>, o: CgObject): CgObject => match(get(rn, o.objName))
  (r: Dict<String, String>) => CgObject(o.objName, o.objExtends, o.objFunctions,
                                        CgImmediateStruct(map(cgFieldsOfOrEmpty(o.objFields),
                                          (fd) => CgField(cnRename(r, fd.fieldName), fd.fieldType))),
                                        cnRenameOpt(r, o.objLengthField), o.objComment,
                                        o.objIsForeign, o.objIsMutable, o.objDiscriminator,
                                        o.objIsPinnable)
  ()                        => o

fun cnRenameOpt(r: Dict<String, String>, name: String|None): String|None => match(name)
  (x: String) => cnRename(r, x)
  ()          => None

fun cnFunctionFields(rn: Dict<String, Dict<String, String>>, f: CgFunction): CgFunction
  ret cgFunctionReplaceParams(f, (p) => cnAccess(rn, p))

fun cnGlobal(rn: Dict<String, Dict<String, String>>, g2: CgGlobal): CgGlobal => match(g2.globalInit)
  (init: RParam) => CgGlobal(g2.globalName, g2.globalType,
                             cnStaticInit(rn, g2.globalObjectName,
                                          rpReplaceParams(init, (p) => cnAccess(rn, p))),
                             g2.globalObjectName, g2.globalLazyInitFunction, g2.globalLazyInitFlag)
  ()             => g2

# A static instance's initialiser names its object's fields.
fun cnStaticInit(rn: Dict<String, Dict<String, String>>, objName: String|None, init: RParam): RParam
  ret match(objName)
    (n: String) => match(get(rn, n))
      (r: Dict<String, String>) => match(init)
        (ns: RpNewStruct) => RpNewStruct(map(ns.values, (v) => RpNamedValue(cnRename(r, v.name), v.value)))
        (o: RParam)       => init
      ()                        => init
    ()          => init

fun cnAccess(rn: Dict<String, Dict<String, String>>, p: RParam): RParam => match(p)
  (x: RpObjectField)  => match(get(rn, x.objectName))
    (r: Dict<String, String>) => RpObjectField(x.fieldType, x.pointer, x.objectName,
                                               cnRename(r, x.field), x.index, x.fresh)
    ()                        => p
  (x: RpArrayElement) => match(get(rn, x.objectName))
    (r: Dict<String, String>) => RpArrayElement(x.elementType, x.pointer, x.objectName,
                                                cnRename(r, x.field), cnRename(r, x.lengthField),
                                                x.index, x.checked)
    ()                        => p
  (o: RParam)         => p
