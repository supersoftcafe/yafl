# bootstrap/ssa_defs.yafl — ported from lowering/ssa_defs.py: SSA def-chain
# analysis over the pre-async IR — a LIBRARY, not a pass. Pre-async, every
# StackVar has at most one definition (ssa_validate enforces it), so "what
# value does this local hold?" is answerable by chasing Moves. Several
# pipeline stages share that question — struct-read folding, known-tag
# resolution, string-append flattening — and this module is its single home.
# Nothing here rewrites anything: pure queries, safe to call from any stage.
namespace Bootstrap::Lower::Ir

import System
import System::Containers

import Bootstrap::Ir
import Bootstrap::StdlibCandidates



# Each StackVar's sole defining source, DICT-backed (user ruling 2026-07-22:
# Python dicts port as Dict for lookup). The SdEntry wrapper keeps "absent"
# and "known-unknowable" (Phi merge, call result, repeated definition)
# distinct, exactly like Python's dict-with-None-values — both answer None
# from sdGet, which is also Python's `defs.get(name)` behaviour.
class [final] SdEntry(sdSource: RParam|None)
class [final] SsaDefs(sdMap: Dict<String, SdEntry>)

fun sdMaxChase() => 8   # def-chain depth bound (copies of copies of packs)

fun singleDefs(f: CgFunction) => fold(f.fnOps, SsaDefs(Dict()), sdCollectOp)

fun sdCollectOp(acc, op) => fold(opGetLiveVars(op).writes, acc, (a, w) => sdDefineWritten(a, w, op))

fun sdDefineWritten(acc, w, op) => match(w)
  (sv: RpStackVar) => sdDefine(acc, sv.name, sdSourceOf(op))
  (o: RParam)      => acc   # unreachable: only locals are written

# A Move's source; anything else (a call result, a Phi merge) is unknowable.
fun sdSourceOf(op): RParam|None => match(op)
  (m: OpMove) => m.moveSource
  (o: Op)     => None

# A REPEATED definition poisons to None (defensive — ssa_validate should
# forbid it pre-async).
fun sdDefine(acc: SsaDefs, name, source) => match(get(acc.sdMap, name))
  (prior: SdEntry) => SsaDefs(put(acc.sdMap, name, SdEntry(None)))
  ()               => SsaDefs(put(acc.sdMap, name, SdEntry(source)))

fun sdGet(defs: SsaDefs, name: String) => match(get(defs.sdMap, name))
  (e: SdEntry) => e.sdSource
  ()           => None

# How many ops read each StackVar (a def whose value is read exactly once can
# be absorbed into its sole reader). saved_vars count as reads — a var marked
# to persist across a call has a future reader (async lowering's state
# machine) that get_live_vars cannot see; deadstores applies the same rule,
# and dropping such a def segfaults at resumption.
fun sdReadCounts(f: CgFunction) => fold(f.fnOps, Dict(), sdCountOp)

fun sdCountOp(acc: Dict<String, Int>, op): Dict<String, Int>
  ret fold(values(opSavedVars(op)),
           fold(opGetLiveVars(op).reads, acc, sdCountVar), sdCountVar)

fun sdCountVar(acc, rp): Dict<String, Int> => match(rp)
  (sv: RpStackVar) => sdBump(acc, sv.name)
  (o: RParam)      => acc

fun sdBump(acc: Dict<String, Int>, name: String) => match(get(acc, name))
  (n: Int) => put(acc, name, n + 1)
  ()       => put(acc, name, 1)

fun sdCountOf(counts: Dict<String, Int>, name: String) => match(get(counts, name))
  (n: Int) => n
  ()       => 0

# Chase `param` through StackVar copies to its defining value, if that value
# is statically known. Returns a NewStruct/Integer/... or None.
fun [tail] resolveValue(param, defs: SsaDefs, depth)
  if depth <= 0
    ret None
  ret match(param)
    (sv: RpStackVar)       => match(sdGet(defs, sv.name))
      (src: RParam) => resolveValue(src, defs, depth - 1)
      ()            => None
    (sf: RpStructField)    => sdResolveField(sf, defs, depth)
    (ns: RpNewStruct)      => param
    (i: RpInteger)         => param
    (s2: RpString)         => param
    (fl: RpFloat)          => param
    (np: RpNullPointer)    => param
    (gv: RpGlobalVar)      => param
    (gf: RpGlobalFunction) => param
    (o: RParam)            => None

fun sdResolveField(sf: RpStructField, defs: SsaDefs, depth)
  ret match(resolveValue(sf.structVal, defs, depth - 1))
    (base: RParam) => match(base)
      (ns: RpNewStruct) => sdFieldValue(ns.values, sf.field, defs, depth)
      (o: RParam)       => None
    ()             => None

# `resolve_value(fval) or fval`: prefer the chased value, else the raw one.
fun sdFieldValue(vs: List<RpNamedValue>, field: String,
                 defs: SsaDefs, depth) => match(firstWhere(vs, (v) => v.name == field))
  (v: RpNamedValue) => sdPreferChased(v.value, defs, depth)
  ()                => None

fun sdPreferChased(v, defs: SsaDefs, depth) => match(resolveValue(v, defs, depth - 1))
  (rv: RParam) => rv
  ()           => v

# A value simple enough to duplicate into each read site: pure, no evaluation
# order, no code growth beyond a name. (RuntimeInvoke and friends are
# excluded — side effects / non-trivial C expressions stay anchored.)
fun sdIsDuplicable(p) => match(p)
  (sv: RpStackVar)       => true
  (i: RpInteger)         => true
  (s2: RpString)         => true
  (fl: RpFloat)          => true
  (np: RpNullPointer)    => true
  (gv: RpGlobalVar)      => true
  (gf: RpGlobalFunction) => true
  (o: RParam)            => false

# The compile-time integer value of `param`, or None if not decidable.
fun staticInt(param, defs: SsaDefs) => match(param)
  (eq: RpIntEqConst) => match(staticInt(eq.value, defs))
    (v: Int) => v == eq.constVal ? 1 : 0
    ()       => None
  # A conjunction: false once any test is known to fail, true once every
  # test is known to hold.
  (np: RpNullPattern) => fold(np.tests, SdNullAcc(false, true), (acc, t2) => sdNullStep(acc, t2, defs))
    |> (acc) => acc.snFails ? 0 : acc.snAllKnown ? 1 : None
  (o: RParam)        => match(resolveValue(param, defs, sdMaxChase()))
    (rv: RParam) => match(rv)
      (i: RpInteger) => i.value
      (o2: RParam)   => None
    ()           => None


class [final] SdNullAcc(snFails: Bool, snAllKnown: Bool)

fun sdNullStep(acc: SdNullAcc, t2: RpNullTest, defs: SsaDefs): SdNullAcc
  ret match(staticNull(t2.word, defs, sdMaxChase()))
    (n: Bool) => SdNullAcc(acc.snFails || n != t2.isNull, acc.snAllKnown)
    ()        => SdNullAcc(acc.snFails, false)

# Is the pointer word `word` statically NULL (true), never NULL (false), or
# not known (None)? Never NULL is the word's type's refinement (dpNonNull) —
# asked only after the zero forms, which a value typed never-NULL is never
# built from.
fun staticNull(word, defs: SsaDefs, depth): Bool|None => match(word)
  (np: RpNullPointer) => true
  (z: RpZeroOf)       => true
  (o: RParam)         => cgIsNeverNull(rpGetType(word)) ? false : sdStaticNullChased(word, defs, depth)

fun sdStaticNullChased(word, defs: SsaDefs, depth): Bool|None
  if depth <= 0
    ret None
  ret match(resolveValue(word, defs, depth))
    (rv: RParam) => eqRParam(rv, word) ? None : staticNull(rv, defs, depth - 1)
    ()           => None
