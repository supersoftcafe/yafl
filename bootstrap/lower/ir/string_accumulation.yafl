# bootstrap/string_accumulation.yafl — ported from
# lowering/string_accumulation.py: deforest string accumulation loops into
# in-place builder writes. The naive `go(acc + x, …)` [tail] loop is O(n²);
# at the IR level (post tail_loop) the pattern is a loop-carried Phi:
#
#     A   = Phi[(entry, init), (backedge, B)]
#     ...
#     B   = string_append(A, x)          # or a concat_n rooted at A
#
# The accumulator becomes two loop-carried variables — a heap buffer and a
# byte offset — appended in place via string_builder_reserve +
# string_copy_to_dangerously; every OTHER read of A becomes
# string_resize(buf, off): an exact-size snapshot, correct at ANY point of
# the accumulation. Bail-outs (all conservative, all per-Phi): at least one
# step edge and one init edge; A read exactly once within a step chain;
# pushes and inits DUPLICABLE; chain intermediates read only by the chain;
# an acc buried deep inside another Phi's source bails; an acc read INSIDE
# the loop span (outside the chains) bails — an in-loop snapshot copies the
# whole buffer every iteration, strictly worse than the append it replaced.
# Runs in the pre-async fixpoint at -O1+ AFTER string_concat. Idempotent.
namespace Bootstrap::Lower::Ir

import System

import Bootstrap::Ast

import Bootstrap::Codegen
import Bootstrap::Ir
import Bootstrap::Parse
import Bootstrap::StdlibCandidates



fun saInvoke1(function, a0) => RpRuntimeInvoke(function,
                                               RpNewStruct(list1(RpNamedValue("a0", a0))),
                                               CgDataPointer())

fun saInvoke2(function, a0, a1)
  ret RpRuntimeInvoke(function,
                      RpNewStruct(list2(RpNamedValue("a0", a0),
                                        RpNamedValue("a1", a1))),
                      CgDataPointer())

fun saInvoke3(function, a0, a1, a2)
  ret RpRuntimeInvoke(function,
                      RpNewStruct(list3(RpNamedValue("a0", a0),
                                        RpNamedValue("a1", a1),
                                        RpNamedValue("a2", a2))),
                      CgDataPointer())

fun saLengthOf(value) => saInvoke1("string_length_int", value)

# One back-edge's recognised push chain.
class [final] SaStep(saEdge: String, saResult: String, saPushes: List<RParam>,
                     saChainMoves: List<String>)

# The ordered operand list of an append/concat_n invoke, else None.
fun saOperandsOf(inv: RpRuntimeInvoke): List<RParam>|None => match(inv.parameters)
  (ns: RpNewStruct) => map(filter(ns.values,
                                  (v) => v.name != "count"),
                           (v) => v.value)
    |> (values) =>
      inv.function == scAppendName() && exactly(chain(values), 2) ? values
      : inv.function == scConcatName() ? values
      : None
  (o: RParam)       => None

# ── recognise one Phi source as a push chain ────────────────────────────────

# Chase a Phi source to an append/concat_n chain left-rooted at `acc`. The
# Phi source itself must be a single-read var defined by the chain's final
# invoke (the Phi counts as its one read).
fun saRecogniseStep(edge, source, acc,
                    defs: SsaDefs, reads: Dict<String, Int>) => match(source)
  (sv: RpStackVar) => scReadOnce(reads, sv.name)
    ? saStepFromRoot(edge, sv.name, acc, defs, reads)
    : None
  (o: RParam)      => None

fun saStepFromRoot(edge, resultName, acc,
                   defs: SsaDefs, reads: Dict<String, Int>): SaStep|None
  ret match(sdGet(defs, resultName))
    (rootDef: RParam) => match(saFlatten(rootDef, acc, defs, reads))
      (sp: (ops: List<RParam>, moves: List<String>)) =>
        saStepFromSpine(edge, resultName, acc, sp.ops, sp.moves)
      ()                                             => None
    ()                => None

# Operand spine of the append tree at `param`; None = not a chain. Names of
# single-read locals the chase passed through ride along in `moves`.
fun saFlatten(param, acc, defs: SsaDefs,
              reads: Dict<String, Int>): (ops: List<RParam>, moves: List<String>)|None
  ret match(param)
    (inv: RpRuntimeInvoke) => match(saOperandsOf(inv))
      (ops: List<RParam>) => saFlattenInvoke(ops, acc, defs, reads)
      ()                  => None
    (sv: RpStackVar)       => sv.name == acc
      ? (list1(sv), List<String>())
      : scReadOnce(reads, sv.name)
        ? saFlattenChase(sv, acc, defs, reads)
        : None
    (o: RParam)            => None

fun saFlattenInvoke(ops: List<RParam>, acc, defs: SsaDefs,
                    reads: Dict<String, Int>): (ops: List<RParam>, moves: List<String>)|None
  ret match(head(ops))
    (first: RParam) => match(saFlatten(first, acc, defs, reads))
      (left: (ops: List<RParam>, moves: List<String>)) =>
        (concat(left.ops, tail(ops)), left.moves)
      ()                                               => None
    ()              => None

fun saFlattenChase(sv: RpStackVar, acc, defs: SsaDefs,
                   reads: Dict<String, Int>): (ops: List<RParam>, moves: List<String>)|None
  ret match(sdGet(defs, sv.name))
    (inner: RParam) => match(saFlatten(inner, acc, defs, reads))
      (deeper: (ops: List<RParam>, moves: List<String>)) =>
        (deeper.ops, prepend(sv.name, deeper.moves))
      ()                                                 => None
    ()              => None

fun saStepFromSpine(edge, resultName, acc,
                    spine: List<RParam>, moves)
  if !atLeast(chain(spine), 2)
    ret None
  let pushes = tail(spine)
  ret saRootIsAcc(head(spine), acc)
     && !any(pushes, (p) => saMentionsVar(p, acc))
     && !any(pushes, (p) => !sdIsDuplicable(p))
    # The moves are gathered into a set by their only reader, and the chase
    # already prepends into this list, so the front is where this goes.
    ? SaStep(edge, resultName, pushes, prepend(resultName, moves))
    : None

fun saRootIsAcc(root: RParam|None, acc) => match(root)
  (r: RParam) => match(r)
    (sv: RpStackVar) => sv.name == acc
    (o: RParam)      => false
  ()          => false

fun saMentionsVar(p, name) => rpTest(p, (q) => saIsVarNamed(q, name))

fun saIsVarNamed(q, name) => match(q)
  (sv: RpStackVar) => sv.name == name
  (o: RParam)      => false

# ── the pass ────────────────────────────────────────────────────────────────

fun deforestStringAccumulation(a: CgApp) => appWithFunctions(a, map(appFunctions(a), saFunction))

# One accumulator Phi at a time (the -O1 fixpoint reruns us).
class [final] SaPlan(saPhiIdx: Int, saAcc: String, saSteps: List<SaStep>,
                     saInits: List<OpPhiSource>)

fun saFunction(f)
  let defs = singleDefs(f)
  let reads = sdReadCounts(f)
  ret match(saFindPlan(seqStream(f.fnOps), 0, defs, reads))
    (plan: SaPlan) => saApplyPlan(f, plan, defs, reads)
    ()             => f

# Stream + carried index (the plan records op POSITIONS). Error arm: Never.
fun [tail] saFindPlan<S>(s: S, i, defs: SsaDefs,
                         reads: Dict<String, Int>) where Stream<S, Op, Never>
  let r = streamNext<S, Op, Never>(s)
  ret match(r.value)
    (ok: Ok<Op | None, Never>) => match(ok.value)
      (cur: Op) => match(saPlanForOp(cur, i, defs, reads))
        (plan: SaPlan) => plan
        ()             => saFindPlan(r.stream, i + 1, defs, reads)
      (n: None) => None
    (er: Error<Op | None, Never>) => None

fun saPlanForOp(op, i, defs: SsaDefs,
                reads: Dict<String, Int>) => match(op)
  (ph: OpPhi) => match(ph.phiTarget)
    (sv: RpStackVar) => saPlanForPhi(ph, sv.name, i, defs, reads)
    (o: RParam)      => None
  (o: Op)     => None

fun saPlanForPhi(ph: OpPhi, acc, i, defs: SsaDefs,
                 reads: Dict<String, Int>): SaPlan|None
  let split = saSplitSources(chain(ph.phiSources), acc, defs, reads,
                             SaSplit(builder(),
                                     builder()))
  ret !isEmpty(split.steps) && !isEmpty(split.inits)
     && !any(split.inits,
             (s2) => !sdIsDuplicable(s2.sourceValue))
    ? SaPlan(i, acc, split.steps, split.inits)
    : None

# The phi's sources split in two, each keeping the source order: the edges
# that STEP the accumulator, and the ones that SEED it.
class [linear, final] SaSplit(spSteps: ListBuilder<SaStep>,
                              spInits: ListBuilder<OpPhiSource>)

fun [tail] saSplitSources(ss: Chain<OpPhiSource>, acc,
                          defs: SsaDefs, reads: Dict<String, Int>,
                          [terminal] sp: SaSplit): (steps: List<SaStep>, inits: List<OpPhiSource>)
  ret match(ss)
    (nil: ChainEnd) => (build(sp.spSteps),
                        build(sp.spInits))
    (l: ChainLink)  => match(saRecogniseStep(l.value.sourceLabel,
                                             l.value.sourceValue, acc,
                                             defs, reads))
      (step: SaStep) => saSplitSources(l.next, acc, defs, reads,
                            SaSplit(push(sp.spSteps, step),
                                    sp.spInits))
      ()             => saSplitSources(l.next, acc, defs, reads,
                            SaSplit(sp.spSteps,
                                    push(sp.spInits, l.value)))

# ── plan-level bail-outs ────────────────────────────────────────────────────

# An acc buried deeper inside ANOTHER Phi's source has no safe rewrite point
# (its value is consumed on the predecessor edge, where an inserted snapshot
# Move would not execute); a DIRECT acc source takes the snapshot expression
# itself, so only the buried shape bails.
fun saPhiSourceBuriesAcc(op, i: Int, plan: SaPlan) => match(op)
  (ph: OpPhi) => i != plan.saPhiIdx
    && any(ph.phiSources,
           (s2) => !saIsDirectAcc(s2.sourceValue, plan.saAcc)
                                && saMentionsVar(s2.sourceValue, plan.saAcc))
  (o: Op)     => false

fun saIsDirectAcc(v, acc) => match(v)
  (sv: RpStackVar) => sv.name == acc
  (o: RParam)      => false

# Loop body ≈ the op span from the accumulator's Phi to the last jump back
# to its label; any acc read in that span (outside the recognised chains)
# bails the plan.
fun saLoopLabel(f: CgFunction, phiIdx: Int): String|None
  ret saLabelScan(seqStream(f.fnOps), 0, phiIdx, None)

fun [tail] saLabelScan<S>(s: S, i, phiIdx: Int,
                          latest): String|None where Stream<S, Op, Never>
  let r = streamNext<S, Op, Never>(s)
  ret match(r.value)
    (ok: Ok<Op | None, Never>) => match(ok.value)
      (cur: Op) => i >= phiIdx
        ? latest
        : saLabelScan(r.stream, i + 1, phiIdx, saLabelName(cur, latest))
      (n: None) => latest
    (er: Error<Op | None, Never>) => latest

fun saLabelName(op, latest): String|None => match(op)
  (lb: OpLabel) => lb.labelName
  (o: Op)       => latest

fun saJumpTarget(op) => match(op)
  (ji: OpJumpIf) => ji.jumpIfLabel
  (j: OpJump)    => j.jumpName
  (o: Op)        => None

fun saSpanEnd(f: CgFunction, loopLabel: String|None, phiIdx): Int => match(loopLabel)
  (lbl: String) => saSpanScan(seqStream(f.fnOps), 0, lbl, phiIdx)
  ()            => phiIdx

fun [tail] saSpanScan<S>(s: S, i, lbl, latest): Int where Stream<S, Op, Never>
  let r = streamNext<S, Op, Never>(s)
  ret match(r.value)
    (ok: Ok<Op | None, Never>) => match(ok.value)
      (cur: Op) => saSpanScan(r.stream, i + 1, lbl,
                              saTargets(cur, lbl) ? i : latest)
      (n: None) => latest
    (er: Error<Op | None, Never>) => latest

fun saTargets(op, lbl) => match(saJumpTarget(op))
  (t2: String) => t2 == lbl
  ()           => false

fun saReadsAccOutsideChain(op: Op, acc, chainAll: Set<String>) => saChainMoveTarget(op, chainAll)
  ? false
  : any(opGetLiveVars(op).reads,
        (sv) => saIsDirectAcc(sv, acc))

fun saChainMoveTarget(op, chainAll: Set<String>) => match(op)
  (m: OpMove) => match(m.moveTarget)
    (sv: RpStackVar) => contains(chainAll, sv.name)
    (o: RParam)      => false
  (o: Op)     => false

fun [tail] saAnyInSpan<S>(s: S, i, from2, to2,
                          acc, chainAll: Set<String>) where Stream<S, Op, Never>
  let r = streamNext<S, Op, Never>(s)
  ret match(r.value)
    (ok: Ok<Op | None, Never>) => match(ok.value)
      (cur: Op) => i > to2
        ? false
        : i >= from2 && saReadsAccOutsideChain(cur, acc, chainAll)
          ? true
          : saAnyInSpan(r.stream, i + 1, from2, to2, acc, chainAll)
      (n: None) => false
    (er: Error<Op | None, Never>) => false

# ── the rewrite ─────────────────────────────────────────────────────────────

fun saBufName(base): String   ret base + "$sb_buf"
fun saOffName(base): String   ret base + "$sb_off"

fun saApplyPlan(f, plan: SaPlan, defs: SsaDefs,
                reads: Dict<String, Int>)
  let chainAll = fold(plan.saSteps, Set(),
                      (acc2, s2) =>
                        fold(s2.saChainMoves, acc2,
                             (s3, n) => add(s3, n)))
  if saAnyBuried(seqStream(f.fnOps), 0, plan)
    ret f
  let spanEnd = saSpanEnd(f, saLoopLabel(f, plan.saPhiIdx), plan.saPhiIdx)
  if saAnyInSpan(seqStream(f.fnOps), 0, plan.saPhiIdx + 1, spanEnd,
                 plan.saAcc, chainAll)
    ret f
  let out = saRewriteOps(f.fnOps, 0i32, 0, plan, chainAll, (List(), 0))
  ret saRestack(f, plan, chainAll, out.ops, out.n)

fun [tail] saAnyBuried<S>(s: S, i, plan: SaPlan) where Stream<S, Op, Never>
  let r = streamNext<S, Op, Never>(s)
  ret match(r.value)
    (ok: Ok<Op | None, Never>) => match(ok.value)
      (cur: Op) => saPhiSourceBuriesAcc(cur, i, plan)
        ? true
        : saAnyBuried(r.stream, i + 1, plan)
      (n: None) => false
    (er: Error<Op | None, Never>) => false

fun saBufVar(plan: SaPlan) => RpStackVar(CgDataPointer(), saBufName(plan.saAcc))

fun saOffVar(plan: SaPlan) => RpStackVar(CgDataPointer(), saOffName(plan.saAcc))

fun saSnapshot(plan: SaPlan) => saInvoke2("string_resize", saBufVar(plan), saOffVar(plan))

# No snapshot LIST rides this walk. Every snapshot var is `acc$snap@<k>` for
# k = the count of snaps taken before it, so the carried count `n` already
# determines the whole set — and with it the declaration order of their stack
# fields, which is observed (it is C struct field order, and Python appends
# them in exactly this order).
fun [tail] saRewriteOps(s: Segment<Op>|None, iSeg, i, plan: SaPlan,
                        chainAll: Set<String>,
                        acc: (ops: List<Op>, n: Int)): (ops: List<Op>, n: Int) => match(s)
  (nil: None)        => acc
  (seg: Segment<Op>) => iSeg < seg.length
    ? saRewriteOps(s, iSeg + 1i32, i + 1, plan, chainAll,
                   saRewriteOne(seg.array(iSeg), i, plan, chainAll,
                                acc))
    : saRewriteOps(seg.next, 0i32, i, plan, chainAll, acc)

fun saRewriteOne(op: Op, i: Int, plan: SaPlan, chainAll: Set<String>,
                 acc: (ops: List<Op>, n: Int)): (ops: List<Op>, n: Int)
  if i == plan.saPhiIdx
    ret (concat(acc.ops, saPhiPair(plan)), acc.n)
  ret match(saStepOrChainMove(op, plan, chainAll))
    (kind: Int) => kind == 1
      ? (concat(acc.ops, saPushSeq(saStepFor(op, plan), plan)), acc.n)
      : acc                          # kind 2: absorbed intermediate — drop
    ()          => saRewriteRead(op, plan, acc)

# 1 = the chain's final Move (becomes the push sequence); 2 = an absorbed
# intermediate; None = anything else.
fun saStepOrChainMove(op, plan: SaPlan, chainAll: Set<String>) => match(op)
  (m: OpMove) => match(m.moveTarget)
    (sv: RpStackVar) =>
      any(plan.saSteps, (s2) => s2.saResult == sv.name) ? 1
      : contains(chainAll, sv.name) ? 2
      : None
    (o: RParam)      => None
  (o: Op)     => None

fun saStepFor(op, plan: SaPlan)
  let name = match(op)
    (m: OpMove) => match(m.moveTarget)
      (sv: RpStackVar) => sv.name
      (o: RParam)      => ""
    (o: Op)     => ""
  ret match(head(filter(plan.saSteps, (s2) => s2.saResult == name)))
    (s2: SaStep) => s2
    ()           => SaStep("", "", List(), List())

# The accumulator Phi becomes the (buf, off) Phi pair. (Python constructs
# both with DEFAULT saved_vars — the original Phi's set is discarded.)
fun saPhiPair(plan: SaPlan): List<Op>
  let bufSources = concat(
        map(plan.saInits, (s2) => s2),
        map(plan.saSteps,
            (s2) => OpPhiSource(s2.saEdge,
                                RpStackVar(CgDataPointer(),
                                           saBufName(s2.saResult)))))
  let offSources = concat(
        map(plan.saInits,
            (s2) => OpPhiSource(s2.sourceLabel,
                                saLengthOf(s2.sourceValue))),
        map(plan.saSteps,
            (s2) => OpPhiSource(s2.saEdge,
                                RpStackVar(CgDataPointer(),
                                           saOffName(s2.saResult)))))
  # The buffer Phi precedes the offset Phi.
  ret prepend(OpPhi(saBufVar(plan), bufSources, List()),
              prepend(OpPhi(saOffVar(plan), offSources,
                            List()),
                      List()))

# The chain's final Move becomes the in-place push sequence: reserve →
# dangerous copy, then advance the offset, once per operand.
fun saPushSeq(step: SaStep, plan: SaPlan)
  ret build(saPushLoop(chain(step.saPushes), 0, step,
                       saBufVar(plan), saOffVar(plan), builder()))

fun saPushLoop(ps: Chain<RParam>, i, step: SaStep,
                      curBuf, curOff,
                      [terminal] acc): ListBuilder<Op> => match(ps)
  (nil: ChainEnd) => acc
  (l: ChainLink)  => saPushStep(l, i, step, curBuf, curOff, acc)

fun saPushStep(l: ChainLink<RParam>, i, step: SaStep,
                      curBuf, curOff,
                      [terminal] acc: ListBuilder<Op>): ListBuilder<Op>
  let names = saPushNames(step, i, l.next is ChainEnd)
  let nbuf = RpStackVar(CgDataPointer(), names.buf)
  let noff = RpStackVar(CgDataPointer(), names.off)
  let grown = saInvoke3("string_builder_reserve", curBuf, curOff,
                        saLengthOf(l.value))
  # Copy into the buffer, then advance the offset — in that order.
  let pushed = push(push(acc,
        OpMove(nbuf,
               saInvoke3("string_copy_to_dangerously", grown, curOff,
                         l.value),
               false, List())),
        OpMove(noff, saInvoke2("integer_add", curOff, saLengthOf(l.value)),
               false, List()))
  ret saPushLoop(l.next, i + 1, step, nbuf, noff, pushed)

# The LAST push takes the result names — detected structurally, never by an
# index-versus-length compare (no-length ruling).
fun saPushNames(step: SaStep, i: Int, isLast): (buf: String, off: String) => isLast
  ? (saBufName(step.saResult), saOffName(step.saResult))
  : (saBufName(step.saResult) + "@" + String(i),
     saOffName(step.saResult) + "@" + String(i))

# Everything else: reads of the accumulator become snapshots, and a saved
# accumulator becomes a saved (buf, off) pair.
fun saRewriteRead(op, plan: SaPlan,
                  acc: (ops: List<Op>, n: Int)): (ops: List<Op>, n: Int)
  let stage1 = match(op)
    (ph: OpPhi) => saPhiRead(ph, plan, acc.n)
    (o: Op)     => saSnapRead(op, plan, acc.n)
  let staged = saResave(stage1.op, plan)
  ret (build(push(
           pushAll(builderFrom(acc.ops),
                       stage1.pre),
           staged)),
       stage1.n)

fun saPhiRead(ph: OpPhi, plan: SaPlan,
              n: Int): (op: Op, pre: List<Op>, n: Int) => (saOtherPhi(ph, plan), List(), n)

fun saOtherPhi(ph: OpPhi, plan: SaPlan)
  ret OpPhi(ph.phiTarget,
            map(ph.phiSources,
                (s2) => saIsDirectAcc(s2.sourceValue, plan.saAcc)
                  ? OpPhiSource(s2.sourceLabel, saSnapshot(plan))
                  : s2),
            ph.phiSavedVars)

# The snap ordinal is the CARRIED count of snaps taken so far — never the
# list's length (no-length ruling).
fun saSnapRead(op, plan: SaPlan,
               n): (op: Op, pre: List<Op>, n: Int)
  if !any(opGetLiveVars(op).reads,
          (sv) => saIsDirectAcc(sv, plan.saAcc))
    ret (op, List(), n)
  let snap = saSnapVar(plan, n)
  ret (opRenameVars(op, prepend(
                            RpRename(plan.saAcc, stackVarName(snap)),
                            List())),
       prepend(OpMove(snap, saSnapshot(plan), false, List()),
               List()),
       n + 1)

fun saSnapVar(plan: SaPlan, k: Int)
  ret RpStackVar(CgDataPointer(), plan.saAcc + "$snap@" + String(k))

# Fields for snaps 0..n-1, in ordinal order — the order they were taken in,
# which is the order Python's snap_vars list holds them.
fun [tail] saSnapFields(k, n, plan: SaPlan,
                        [terminal] acc): ListBuilder<CgField> => k >= n
  ? acc
  : saSnapFields(k + 1, n, plan,
                 push(acc,
                     CgField(stackVarName(saSnapVar(plan, k)),
                             CgDataPointer())))

fun saResave(op, plan: SaPlan) => any(opSavedVars(op), (sv) => saIsDirectAcc(sv, plan.saAcc))
  ? opWithSavedVars(op,
      svSetUnion(filter(opSavedVars(op),
                        (sv) => !saIsDirectAcc(sv, plan.saAcc)),
                 list2(saBufVar(plan), saOffVar(plan))))
  : op

# Declare the introduced locals; retire the replaced ones (the accumulator,
# the step results and the absorbed intermediates).
fun saRestack(f: CgFunction, plan: SaPlan, chainAll: Set<String>,
              newOps: List<Op>, nSnaps)
  let retired = add(chainAll, plan.saAcc)
  let kept = filter(cgFieldsOfOrEmpty(f.fnStackVars),
                    (fld) => !contains(retired, fld.fieldName))
  # Declaration order: the surviving locals, then the buffer and offset, then
  # one field per snapshot.
  let base = push(push(
      builderFrom(kept),
      CgField(saBufName(plan.saAcc), CgDataPointer())),
      CgField(saOffName(plan.saAcc), CgDataPointer()))
  let withSnaps = build(saSnapFields(0, nSnaps, plan, base))
  # The rewrite assembles a transient List; the retained result crosses to
  # Segment storage here.
  ret cgFunctionWith(f, cgOpsOf(newOps),
                     CgStruct(fold(plan.saSteps, withSnaps, saStepFields)))

fun saStepFields(acc: List<CgField>, step: SaStep)
  ret saStepFieldLoop(chain(step.saPushes), 0, step, acc)

fun saStepFieldLoop(ps: Chain<RParam>, i, step: SaStep,
                           acc: List<CgField>)
  ret build(saStepFieldLoopB(ps, i, step, builderFrom(acc)))

fun [tail] saStepFieldLoopB(ps: Chain<RParam>, i, step: SaStep,
                           [terminal] acc): ListBuilder<CgField> => match(ps)
  (nil: ChainEnd) => acc
  (l: ChainLink)  => saPushNames(step, i, l.next is ChainEnd)
    |> (names) => saStepFieldLoopB(l.next, i + 1, step,
                    push(push(acc, CgField(names.buf, CgDataPointer())),
                           CgField(names.off, CgDataPointer())))
