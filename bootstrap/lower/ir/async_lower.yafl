# bootstrap/async_lower.yafl — task lowering, ported from
# lowering/async_lower.py (1,827 lines; read in full — the ledger carries the
# per-mechanism map). Each function with non-tail calls becomes: a HOT PATH
# (original name; UNLIKELY(IS_TASK) after every non-tail call; one shared
# $asynccommon cold tail that saves live locals to a heap state object,
# creates the task, registers fn$async and returns the tagged task) and, for
# non-sync functions, a STATE MACHINE fn$async($state, $completed_task)
# dispatching on $state->idx — running on ordinary C locals, touching state
# fields only at the two suspension boundaries. Oversized looping bodies take
# the STUB launch instead of a duplicated hot path. __parallel__ sites are
# first OUTLINED behind the runtime backpressure choice.
namespace Bootstrap::Lower::Ir

import System

import Bootstrap::Ast

import Bootstrap::Codegen
import Bootstrap::Frontend
import Bootstrap::Ir
import Bootstrap::Parse
import Bootstrap::StdlibCandidates
import Bootstrap::Types



# ── module scratch vars (hot path shares ONE set; the SM allocates per-site
#    $sv_par_sm$i / $sv_launcher_sm$i) ────────────────────────────────────────

fun alSvState() => RpStackVar(CgDataPointer(), "$sv_state")

fun alSvTask(): RParam => RpStackVar(CgDataPointer(), "$sv_task")

fun alSvDiscard(): RParam => RpStackVar(CgDataPointer(), "$sv_discard")

fun alSvCallId() => RpStackVar(CgInt(32), "$sv_call_id")

fun alSvAsyncTask() => RpStackVar(CgDataPointer(), "$sv_async_task")

fun alSvParTask() => RpStackVar(CgDataPointer(), "$sv_par_task")

fun alSvLauncher() => RpStackVar(CgDataPointer(), "$sv_launcher")

fun alStateParam(): RParam => RpStackVar(CgDataPointer(), "$state")

fun alCompletedParam() => RpStackVar(CgDataPointer(), "$completed_task")

# ── return conversion ────────────────────────────────────────────────────────

# SM: Return → [store value into my_task's subtype result field] +
# task_complete + ReturnVoid; ReturnVoid → task_complete + ReturnVoid.
# Instruction order, so the ops go into a builder: each one either passes
# through or expands to a short sequence, and the concat this replaces copied
# everything emitted so far for every op in the function.
fun alConvertReturnsSm(ops: List<Op>, myTaskField, fnResult,
                       subtype: String|None)
  ret build(alConvertReturnsSmB(chain(ops), myTaskField, fnResult,
                                subtype, builder()))

fun [tail] alConvertReturnsSmB(ops: Chain<Op>, myTaskField,
                               fnResult, subtype: String|None,
                               [terminal] acc: ListBuilder<Op>) => match(ops)
  (nil: ChainEnd) => acc
  (l: ChainLink)  => alConvertReturnsSmB(l.next, myTaskField, fnResult,
                         subtype,
                         alConvertReturnSmOne(acc, l.value, myTaskField,
                                              fnResult, subtype))

fun alConvertReturnSmOne([terminal] acc: ListBuilder<Op>, op,
                         myTaskField, fnResult,
                         subtype: String|None): ListBuilder<Op> => match(op)
  (r: OpReturn)      => pushAll(acc,
                            alSmReturn(r, myTaskField, fnResult,
                                       subtype))
  (rv: OpReturnVoid) => pushAll(acc,
                            alSmComplete(myTaskField))
  (o: Op)            => push(acc, op)

fun alSmReturn(r: OpReturn, myTaskField, fnResult,
               subtype: String|None): List<Op> => match(subtype)
  (st: String) => alIsVoid(fnResult)
    ? alSmComplete(myTaskField)
    : concat(list1(OpMove(RpObjectField(fnResult, myTaskField, st, "result", None, false),
                          r.returnValue, false, List())),
             alSmComplete(myTaskField))
  ()            => alSmComplete(myTaskField)

fun alSmComplete(myTaskField): List<Op>
  ret list2(OpMove(alSvDiscard(),
                   RpRuntimeInvoke("task_complete",
                                   RpNewStruct(list1(RpNamedValue("self", myTaskField))),
                                   CgDataPointer()),
                   true, List()),
            OpReturnVoid(List()))

fun alIsVoid(t2) => match(t2)
  (v: CgVoid) => true
  (o: CgType) => false

# Hot path: only when the return type was TaskWrapper-promoted — SyncWrap
# each Return (unless the value is already wrapped-shaped: hand-built
# async-pending returns interoperate), and align musttail result_types.
fun alConvertReturnsHot(ops, wrappedResult): List<Op> => match(wrappedResult)
  (w: CgTaskWrapper) => map(ops, (op) => alHotReturnOne(op, wrappedResult))
  (o: CgType)         => ops

fun alHotReturnOne(op, wrapped) => match(op)
  (r: OpReturn) => eqCgType(rpGetType(r.returnValue), wrapped)
    ? op
    : OpReturn(RpSyncWrap(r.returnValue, wrapped), r.returnSavedVars)
  (c: OpCall)   => c.callMusttail
    ? OpCall(c.callFunction, c.callParameters, c.callRegister, true, c.callImpure,
             wrapped, c.callSavedVars)
    : op
  (o: Op)       => op

# ── per-pattern emit helpers ─────────────────────────────────────────────────

fun alRuntimeDiscard(sv, name, args): Op
  ret OpMove(sv, RpRuntimeInvoke(name, RpNewStruct(args), CgDataPointer()),
             true, List())

# par_task alloc + init + remaining + per-slot closures.
# nClosures is CARRIED from the walk that built `closures` — the par-join
# countdown is genuine runtime data, never a recalculated length.
fun alEmitParTaskSetup(parTaskVar, parTaskName,
                       closures: List<RParam>, nClosures): List<Op>
  let setup = list3(OpNewObject(parTaskName, parTaskVar, None, List()),
                    alRuntimeDiscard(alSvDiscard(), "task_init",
                                     list1(RpNamedValue("task", parTaskVar))),
                    OpMove(RpObjectField(CgInt(32), parTaskVar, parTaskName, "remaining", None, false),
                           RpInteger(nClosures, 32), false, List()))
  ret concat(setup, alClosureStores(chain(closures), parTaskVar, parTaskName, 0, List()))

fun alClosureStores(cs, parTaskVar, parTaskName,
                           k: Int, acc: List<Op>): List<Op>
  ret build(alClosureStoresB(cs, parTaskVar, parTaskName, k, builderFrom(acc)))

fun [tail] alClosureStoresB(cs: Chain<RParam>, parTaskVar, parTaskName,
                           k, [terminal] acc: ListBuilder<Op>) => match(cs)
  (nil: ChainEnd) => acc
  (l: ChainLink)  => alClosureStoresB(l.next, parTaskVar, parTaskName, k + 1,
      push(acc, OpMove(RpObjectField(CgDataPointer(), parTaskVar, parTaskName,
                                  "closure_" + String(k), None, false),
                    l.value, false, List())))

# One launcher task wired to fire slot K's lambda on a worker thread.
fun alEmitPostLauncher(launcherVar, parTaskVar,
                       fnName, callSite: Int, slot: Int): List<Op>
  let launcherCb = RpGlobalFunction(fnName + "$par$" + String(callSite) + "$launcher$" + String(slot),
                                    parTaskVar, false, None, false, false)
  ret list3(OpMove(launcherVar,
                   RpRuntimeInvoke("task_create",
                                   RpNewStruct(list1(RpNamedValue("self", RpNullPointer()))),
                                   CgDataPointer()), false, List()),
            alRuntimeDiscard(alSvDiscard(), "task_on_complete",
                             list2(RpNamedValue("task", launcherVar),
                                   RpNamedValue("cb", launcherCb))),
            alRuntimeDiscard(alSvDiscard(), "thread_work_post_parallel",
                             list1(RpNamedValue("task", launcherVar))))

# Task alloc: None → base task_t via task_create; task_obj → task_obj_create;
# else NewObject + task_init.
fun alEmitTaskAlloc(svTask, subtype: String|None): List<Op> => match(subtype)
  (st: String) => st == "task_obj"
    ? list1(OpMove(svTask,
                   RpRuntimeInvoke("task_obj_create",
                                   RpNewStruct(list1(RpNamedValue("self", RpNullPointer()))),
                                   CgDataPointer()), false, List()))
    : list2(OpNewObject(st, svTask, None, List()),
            alRuntimeDiscard(alSvDiscard(), "task_init",
                             list1(RpNamedValue("task", svTask))))
  ()            => list1(OpMove(svTask,
                   RpRuntimeInvoke("task_create",
                                   RpNewStruct(list1(RpNamedValue("self", RpNullPointer()))),
                                   CgDataPointer()), false, List()))

# SM cold-block tail: write idx, register fn$async on the in-flight task
# (already a clean task_t pointer), return.
fun alEmitSuspendToAsync(idxField, idx, untaggedTask,
                         fnName): List<Op>
  let callback = RpGlobalFunction(fnName + "$async", alStateParam(), false, None, false, false)
  ret list3(OpMove(idxField, RpInteger(idx, 32), false, List()),
            alRuntimeDiscard(alSvDiscard(), "task_on_complete",
                             list2(RpNamedValue("task", untaggedTask),
                                   RpNamedValue("cb", callback))),
            OpReturnVoid(List()))

# ── tail-call detection ──────────────────────────────────────────────────────

# Call(register=R); Return(R) with R's type == fn.result → musttail (register
# cleared, result_type set); void Call; ReturnVoid → musttail. Codegen emits
# `return foo(...)` which clang TCOs even at -O0.
fun alDiscoverTailCalls(f)
  if !atLeast(f.fnOps, 2)
    ret f
  ret cgFunctionWith(f, alTailScan(f.fnOps, f.fnResult), f.fnStackVars)

fun alTailScan(s: Segment<Op>|None, fnResult): Segment<Op>|None
  let p0 = cgPullOp(seqStream(s))
  let p1 = cgPullOp(p0.stream)
  ret build(alTailScanB(p0.op, p1.op, p1.stream, fnResult, seqBuilder()))

# (cur, nxt) window over the op stream: the pattern match consumes a pair, so
# the window shifts by one or two. Both refills are pulled up front to keep
# every recursion direct ([tail]); the one-shift arm discards the second.
fun [tail] alTailScanB(cur: Op|None, nxt: Op|None, st: SeqStream<Op>, fnResult,
                       [terminal] acc: SeqBuilder<Op>): SeqBuilder<Op>
  if cur is None
    ret acc
  let op = forceOp(cur)
  let pA = cgPullOp(st)
  let pB = cgPullOp(pA.stream)
  ret match(nxt)
    (nil: None) => push(acc, op)
    (n: Op)     => match(alTailPattern(op, n, fnResult))
      (t2: Op) => alTailScanB(pA.op, pB.op, pB.stream, fnResult, push(acc, t2))
      ()       => alTailScanB(nxt, pA.op, pA.stream, fnResult, push(acc, op))

fun alTailPattern(op, nxt, fnResult) => match(op)
  (c: OpCall) => c.callMusttail ? None : alTailPatternCall(c, nxt, fnResult)
  (o: Op)     => None

fun alTailPatternCall(c: OpCall, nxt, fnResult) => match(c.callRegister)
  (reg: RParam) => alTailValued(c, reg, nxt, fnResult)
  ()             => alTailVoid(c, nxt, fnResult)

fun alTailValued(c: OpCall, reg, nxt, fnResult) => match(nxt)
  (r: OpReturn) => match(r.returnValue)
    (sv: RpStackVar) => alRegNamed(reg, sv.name) && eqCgType(rpGetType(reg), fnResult)
      ? OpCall(c.callFunction, c.callParameters, None, true, c.callImpure,
               rpGetType(reg), c.callSavedVars)
      : None
    (o: RParam)       => None
  (o2: Op)       => None

fun alRegNamed(reg, name) => match(reg)
  (sv: RpStackVar) => sv.name == name
  (o: RParam)       => false

fun alTailVoid(c: OpCall, nxt, fnResult)
  if !alResultTypeVoidish(c.callResultType) || !alIsVoid(fnResult)
    ret None
  ret match(nxt)
    (rv: OpReturnVoid) => OpCall(c.callFunction, c.callParameters, None, true,
                                 c.callImpure, c.callResultType, c.callSavedVars)
    (o: Op)             => None

fun alResultTypeVoidish(t2: CgType|None) => match(t2)
  (x: CgType) => alIsVoid(x)
  ()           => true

# ── StackVar sets (keyed by name; SSA names are unique per function) ─────────

# A new member goes on the FRONT. The order of one of these sets is never
# observed: every consumer that turns one into output runs it through
# svSortedByName first, and the others ask only membership, union, difference
# or equality — none of which can see the order. The ONE consumer that did
# observe it, alAllStateVars, now keeps its own ordered builder.
fun svSetAdd(acc, v) => alSvMember(acc, v) ? acc : prepend(v, acc)

fun alSvMember(acc: List<RParam>, v) => any(acc, (x) => stackVarName(x) == stackVarName(v))

fun svSetUnion(a: List<RParam>, b: List<RParam>): List<RParam> => fold(b, a, svSetAdd)

fun svSetSub(a: List<RParam>, b: List<RParam>) => filter(a, (x) => !alSvMember(b, x))

fun svSetEq(a: List<RParam>, b: List<RParam>)
  ret sameLen(chain(a), chain(b)) && !any(a, (x) => !alSvMember(b, x))

fun svSortedByName(a: List<RParam>): List<RParam>
  ret map(sort(map(a, stackVarName)),
          (n) => alSvNamed(a, n))

fun alSvNamed(a: List<RParam>, n) => match(head(filter(a, (x) => stackVarName(x) == n)))
  (x: RParam) => x
  ()           => RpNullPointer()   # unreachable: name came from the same list

# ── liveness: __calculate_saved_vars ─────────────────────────────────────────

# Per-op reads/writes with the Phi rule: a Phi reads NOTHING unconditionally
# (each source is consumed on its predecessor edge only — added per-edge via
# alPhiSourcesInto) and writes its target.
fun alReadsOf(op): List<RParam> => match(op)
  (ph: OpPhi) => List()
  (o: Op)     => opReadStackVars(op)

fun alWritesOf(op) => fold(ssavOpWrites(op), List(), rpTakeStackVar)

fun alCalculateSavedVars(f: CgFunction)
  ret cgFunctionWith(f, cgOpsOf(alLivenessIterate(cgOpsToList(f.fnOps),
                                                  alInvariants(f.fnOps))),
                     f.fnStackVars)

# The label index and the enclosing block label per op: fixed across
# generations, so built ONCE rather than per pass.
#
# Per-op reads/writes are deliberately NOT cached here. Measured: a
# Dict<Int,_> get costs ~2400 instructions at 10k entries against ~900 for the
# two-element fold it would replace, and with the backward sweep the fixpoint
# runs ~3 passes, so a cache cannot repay building itself.
class [final] AlInv(avLabels: Dict<String, Int>, avBlocks: Dict<Int, String>,
                    avN: Int)

fun alInvariants(ops: Segment<Op>|None): AlInv
  let bi = alBlockIndex(ops)
  ret AlInv(ucLabelIndex(ops), bi.d, bi.n)

# Enclosing block label per op index (nearest preceding Label; "" before any).
fun alBlockIndex(ops: Segment<Op>|None): (d: Dict<Int, String>, n: Int)
  ret alBlockIndexLoop(ops, 0i32, 0, "", Dict())

fun [tail] alBlockIndexLoop(s: Segment<Op>|None, iSeg, i, cur,
                            acc): (d: Dict<Int, String>, n: Int) => match(s)
  (nil: None)        => (acc, i)
  (seg: Segment<Op>) => iSeg < seg.length
    ? (alLabelNameOr(seg.array(iSeg), cur)
        |> (nxt) => alBlockIndexLoop(s, iSeg + 1i32, i + 1, nxt, put(acc, i, nxt)))
    : alBlockIndexLoop(seg.next, 0i32, i, cur, acc)

fun alLabelNameOr(op, cur) => match(op)
  (lb: OpLabel) => lb.labelName
  (o: Op)       => cur

fun [tail] alLivenessIterate(ops: List<Op>, inv)
  let newOps = alLivenessPass(ops, inv)
  ret alOpsSavedEq(ops, newOps) ? newOps : alLivenessIterate(newOps, inv)

fun alOpsSavedEq(a: List<Op>, b: List<Op>) => alOpsSavedEqLoop(chain(a), chain(b))

fun [tail] alOpsSavedEqLoop(a: Chain<Op>, b: Chain<Op>) => match(a)
  (nil: ChainEnd) => true
  (la: ChainLink) => match(b)
    (lb: ChainLink) => svSetEq(opSavedVars(la.value), opSavedVars(lb.value))
      ? alOpsSavedEqLoop(la.next, lb.next)
      : false
    ()              => true

# Per-pass O(1)-indexed snapshot (user ruling 2026-07-22): the old forceNth
# walk was O(i) per read, O(n^2) per pass, times the fixpoint iterations —
# async liveness ran 79+ minutes at self-host scale without completing. ONLY
# the ops move between generations; AlInv carries everything that does not.
class [final] AlIx(aiOps: Dict<Int, Op>, aiInv: AlInv)

# The index scan walks the ops once. Prepending each op as it goes yields the
# BACKWARD order for free, so the backward liveness sweep below needs no
# reverse function: a function whose job is "these elements, backwards" is
# exactly what the container rules forbid, and one is not needed here — the
# scan that was already happening produces it as a by-product.
fun alIndexPass(ops: List<Op>, inv): (ix: AlIx, back: List<Op>)
  ret alIxLoop(chain(ops), 0, Dict(), List())
    |> (byIndex, back) => (ix = AlIx(byIndex, inv), back = back)

fun [tail] alIxLoop(os: Chain<Op>, i, acc: Dict<Int, Op>,
                    back: List<Op>): (byIndex: Dict<Int, Op>, back: List<Op>) => match(os)
  (nil: ChainEnd) => (byIndex = acc, back = back)
  (l: ChainLink)  => alIxLoop(l.next, i + 1, put(acc, i, l.value),
                              prepend(l.value, back))

fun alIxOp(ix: AlIx, i: Int) => match(get(ix.aiOps, i))
  (op: Op) => op
  ()       => OpReturnVoid(List())   # unreachable: 0 <= i < avN

fun alIxBlock(ix: AlIx, i: Int) => match(get(ix.aiInv.avBlocks, i))
  (s2: String) => s2
  ()           => ""

# Liveness is a BACKWARD analysis, so the sweep runs BACKWARD and the
# fall-through successor is the op just computed — carried as `nxt`, not read
# out of the previous generation. Sweeping forward moved information backward
# exactly one op per pass, so the pass count grew with function length and the
# fixpoint cost O(ops^2) op-visits (measured on the findstr proxy: an 82-op
# function took 46 passes; backward it takes 3, and the emitted C is
# byte-identical). Reading the freshest available value is ordinary chaotic
# iteration — same monotone transfer functions, same least fixed point.
fun alLivenessPass(ops: List<Op>, inv) => alIndexPass(ops, inv)
  |> (ix, back) => alLivenessCalc(chain(back), ix, inv.avN - 1, None,
                                  List())

# `acc` is prepended to, so walking backward still yields forward order.
fun [tail] alLivenessCalc(os: Chain<Op>, ix: AlIx, i, nxt: Op|None,
                          acc) => match(os)
  (nil: ChainEnd) => acc
  (l: ChainLink)  => alLivenessOne(l.value, ix, i, nxt)
    |> (o) => alLivenessCalc(l.next, ix, i - 1, o, prepend(o, acc))

# saved(op) = (edge-in of the fall-through/Jump successor ∪ edge-in of the
# JumpIf target) − op's own writes. A Jump's successor is its label WHEREVER
# the op sits — testing last-op first severed the back edge of a loop whose
# back-edge Jump is the function's final op (the array-ctor fill inlined
# into a tail position), so nothing loop-carried was saved across a park
# inside that loop (async_lower.py calc).
fun alLivenessOne(op, ix: AlIx, i, nxt: Op|None)
  let ss1 = alIsJumpOp(op) || i < ix.aiInv.avN - 1
    ? alSs1(ix, i, op, nxt)
    : List()
  let ss2 = alSs2(ix, i, op)
  ret opWithSavedVars(op, svSetSub(svSetUnion(ss1, ss2), alWritesOf(op)))

fun alIsJumpOp(op) => match(op)
  (j: OpJump) => true
  (o: Op)     => false

fun alSs1(ix: AlIx, i, op, nxt: Op|None) => match(op)
  (j: OpJump) => match(ucLabelAt(ix.aiInv.avLabels, j.jumpName))
    (t2: Int) => alEdgeIn(ix, i, t2)
    ()         => List()
  (o: Op)     => alEdgeInNext(ix, i, nxt)

# Fall-through edge: the successor's saved set is the one just computed.
fun alEdgeInNext(ix: AlIx, i, nxt: Op|None) => match(nxt)
  (o: Op) => svSetUnion(alSavedSetOf(o),
                        alPhiSourcesInto(ix, i + 1, alIxBlock(ix, i)))
  ()      => alEdgeIn(ix, i, i + 1)   # unreachable: i < avN - 1 implies a successor

fun alSs2(ix: AlIx, i: Int, op) => match(op)
  (ji: OpJumpIf) => match(ucLabelAt(ix.aiInv.avLabels, ji.jumpIfLabel))
    (t2: Int) => alEdgeIn(ix, i, t2)
    ()         => List()
  (o: Op)        => List()

fun alEdgeIn(ix: AlIx, fromIdx: Int, targetIdx)
  ret svSetUnion(alSavedSetAt(ix, targetIdx),
                 alPhiSourcesInto(ix, targetIdx, alIxBlock(ix, fromIdx)))

fun alSavedSetAt(ix: AlIx, index: Int) => alSavedSetOf(alIxOp(ix, index))

fun alSavedSetOf(op): List<RParam>
  ret svSetUnion(fold(alReadsOf(op), List(), svSetAdd), opSavedVars(op))

# Phi sources arriving on the edge from `pred`: scan the run of Phis at the
# target.
fun alPhiSourcesInto(ix: AlIx, j, pred) => alPhiSourcesLoop(ix, j + 1, pred, List())

fun [tail] alPhiSourcesLoop(ix: AlIx, j, pred, acc)
  if j >= ix.aiInv.avN
    ret acc
  ret match(alIxOp(ix, j))
    (ph: OpPhi) => alPhiSourcesLoop(ix, j + 1, pred,
                     fold(ph.phiSources, acc, (a, s2) =>
                       s2.sourceLabel == pred
                         ? fold(rpReadStackVars(s2.sourceValue), a, svSetAdd)
                         : a))
    (o: Op)     => acc

# ── basic blocks ─────────────────────────────────────────────────────────────

class [final] ABlock(abName: String, abOps: List<Op>, abLive: List<RParam>,
                     abResult: RParam|None)

# Partition liveness-annotated ops on non-musttail Call | ParallelCall (the
# splitter is the LAST op of its block); block name cont$<i>; live = last
# op's saved_vars; result = last op's register.
fun alCreateBasicBlocks(f: CgFunction): List<ABlock> => alCreateBasicBlocksN(f).bs

# The block count rides alPartition's existing carried counter.
fun alCreateBasicBlocksN(f: CgFunction): (bs: List<ABlock>, n: Int)
  let annotated = alCalculateSavedVars(f)
  ret alPartition(seqStream(annotated.fnOps), 0, List(), List())

# `n` is the count of blocks already in `acc` — carried, not re-measured;
# the final tuple's n is the TOTAL block count (last block is n, so n+1).
#
# Two ordered accumulators, so they travel together in one linear record: the
# ops of the block being filled, and the blocks finished so far. Both orders
# are instruction order. The current block's builder is BUILT at each splitter
# — that is what closes the block — and a fresh one starts the next.
class [linear, final] PartAcc(paCur: ListBuilder<Op>,
                              paBlocks: ListBuilder<ABlock>)

fun alPartition(st: SeqStream<Op>, n, cur,
                acc): (bs: List<ABlock>, n: Int)
  ret alPartitionB(st, n,
                   PartAcc(builderFrom(cur),
                           builderFrom(acc)))

fun [tail] alPartitionB(st: SeqStream<Op>, n,
                        [terminal] acc: PartAcc): (bs: List<ABlock>, n: Int)
  let p = cgPullOp(st)
  ret match(p.op)
    (nil: None) =>
      (build(push(acc.paBlocks,
                  alMakeBlock(n, build(acc.paCur)))),
       n + 1)
    (op2: Op)   => alIsSplitter(op2)
      ? alPartitionB(p.stream, n + 1,
            PartAcc(builder(),
                    push(acc.paBlocks,
                        alMakeBlock(n, build(push(acc.paCur,
                                                  op2))))))
      : alPartitionB(p.stream, n, PartAcc(push(acc.paCur, op2),
                                        acc.paBlocks))

fun alIsSplitter(op) => match(op)
  (c: OpCall)          => !c.callMusttail
  (pc: OpParallelCall) => true
  (o: Op)              => false

fun alMakeBlock(index: Int, ops) => match(lastOp(chain(ops)))
  (op: Op) => ABlock("cont$" + String(index), ops, opSavedVars(op), alBlockResult(op))
  ()        => ABlock("cont$" + String(index), ops, List(), None)

fun alBlockResult(op) => match(op)
  (c: OpCall)          => c.callRegister
  (pc: OpParallelCall) => pc.parRegister
  (o: Op)              => None

# ── heap-frame layout ────────────────────────────────────────────────────────

class [final] AFrame(afPtrSlots: List<NameIdx>, afInlineSlots: List<NameStr>,
                     afSlotFields: List<CgField>, afNArray: Int,
                     afDecomposed: List<NameIdx>)
class [final] NameIdx(niName: String, niIdx: Int)
class [final] NameStr(nsName: String, nsStr: String)

fun niLookup(l: List<NameIdx>, name: String) => match(head(filter(l, (e2) => e2.niName == name)))
  (e2: NameIdx) => e2.niIdx
  ()             => None

fun nsLookup(l: List<NameStr>, name: String) => match(head(filter(l, (e2) => e2.nsName == name)))
  (e2: NameStr) => e2.nsStr
  ()             => None

# Frame-resident locals: saved live vars (SORTED by name — reproducibility)
# + call-result registers over bbs[:-1]; first-seen order, last-seen type.
fun alFrameFieldTypes(bbs: List<ABlock>)
  ret ffFields(alFftLoop(chain(alNonTerminal(bbs)), ffEmpty()))

fun alNonTerminal(bbs: List<ABlock>) => alDropLast(bbs)

# Non-terminal blocks AND their count from one walk (no-length ruling).
fun alNonTerminalN(bbs: List<ABlock>): (bs: List<ABlock>, n: Int)
  ret alNtLoop(chain(bbs), 0, builder())

fun [tail] alNtLoop(c: Chain<ABlock>, n,
                    [terminal] acc: ListBuilder<ABlock>): (bs: List<ABlock>, n: Int) => match(c)
  (nil: ChainEnd) => (build(acc), n)
  (l: ChainLink)  => l.next is ChainEnd
    ? (build(acc), n)
    : alNtLoop(l.next, n + 1, push(acc, l.value))

# Everything but the last element, in order.
fun alDropLast<T>(l: List<T>): List<T> => build(alDropLastLoop(chain(l), builder()))

fun [tail] alDropLastLoop<T>(c: Chain<T>, [terminal] acc: ListBuilder<T>): ListBuilder<T>
  ret match(c)
    (nil: ChainEnd) => acc
    (l: ChainLink)  => match(l.next)
      (nil2: ChainEnd) => acc
      (l2: ChainLink)  => alDropLastLoop(l.next, push(acc, l.value))

# The frame's fields as Python builds them: a DICT, where assigning a key that
# is already present replaces its value and leaves it in its original position.
# The port modelled that with a List, an `any` scan to find a repeat and a
# `map` rewrite to update it — two passes over every field already collected,
# for every variable of every block. Frames here run to hundreds of variables.
#
# The position is recorded instead of maintained: a name takes the next
# sequence number the first time it is seen, and ffFields recovers the order
# with one sort at the end.
class [final] FrameFields(ffTypes: Dict<String, CgType>,
                          ffOrder: Dict<String, Int>, ffNext: Int)

fun ffEmpty() => FrameFields(Dict(), Dict(), 0)

fun _ffOrd(d: Dict<String, Int>, n: String) => match(get(d, n))
  (i: Int) => i
  ()       => 0

fun _ffType(d: Dict<String, CgType>, n: String) => match(get(d, n))
  (t2: CgType) => t2
  ()           => CgVoid()

fun ffFields(acc: FrameFields) => map(
                                    sortBy(keys(acc.ffTypes),
                                           (x, y) =>
                                             _ffOrd(acc.ffOrder, x) < _ffOrd(acc.ffOrder, y)),
                                    (n) => CgField(n, _ffType(acc.ffTypes, n)))

fun [tail] alFftLoop(bbs: Chain<ABlock>, acc: FrameFields) => match(bbs)
  (nil: ChainEnd) => acc
  (l: ChainLink)  => alFftLoop(l.next, alFftBlock(l.value, acc))

fun alFftBlock(bb: ABlock, acc: FrameFields)
  let withLive = fold(svSortedByName(bb.abLive), acc, alFftPut)
  ret match(bb.abResult)
    (r: RParam) => alFftPutR(withLive, r)
    ()           => withLive

fun alFftPut(acc, v) => alFftPutR(acc, v)

# first-seen ORDER, last-seen TYPE (Python dict assignment semantics).
fun alFftPutR(acc, v) => match(v)
  (sv: RpStackVar) => match(get(acc.ffOrder, sv.name))
    (i: Int) => FrameFields(put(acc.ffTypes, sv.name, rpGetType(v)),
                            acc.ffOrder, acc.ffNext)
    ()       => FrameFields(put(acc.ffTypes, sv.name, rpGetType(v)),
                            put(acc.ffOrder, sv.name, acc.ffNext),
                            acc.ffNext + 1)
  (o: RParam)       => acc

# Interference: pairs simultaneously live over BOTH op sequences (SM view is
# authoritative; hot view keeps coalescing safe there too). live-out pairs;
# writes × live-out; live-IN pairs (reads + live-out survivors not redefined)
# — reads do NOT interfere with the op's own write (slot = f(slot) is sound).
# The graph is DICT-backed (user ruling 2026-07-22): the old edge LIST paid
# a full scan per insertion and per neighbour query — cubic at self-host
# scale, where big state machines have hundreds of frame vars (async ran
# 79+ min without completing). Both directed keys are stored so presence is
# one get; adjacency lists keep first-seen order, which is the edge-list
# order alNeighbours used to produce per node.
class [final] IGraph(igEdges: Dict<String, Bool>,
                     igAdj: Dict<String, List<String>>)

fun alEmptyGraph() => IGraph(Dict(), Dict())

fun alBuildInterference(opSeqs: List<List<Op>>,
                        frameNames: List<String>)
  let frameIx = fold(frameNames, Dict(),
                     (ix, n) => put(ix, n, true))
  ret fold(opSeqs, alEmptyGraph(),
           (acc, ops) => fold(ops, acc,
             (a, op) => alInterfereOp(a, op, frameIx)))

fun alInFrame(frameIx: Dict<String, Bool>, n: String): Bool => !(get(frameIx, n) is None)

fun alInterfereOp(acc, op,
                  frameIx: Dict<String, Bool>): IGraph
  let liveOut = filter(map(opSavedVars(op), stackVarName),
                       (n) => alInFrame(frameIx, n))
  let writes = map(alWritesOf(op), stackVarName)
  let acc1 = alLinkAllPairs(acc, liveOut)
  let acc2 = fold(writes, acc1, (a, w) =>
               alInFrame(frameIx, w)
                 ? fold(liveOut, a, (a2, n) => alLink(a2, w, n))
                 : a)
  let liveIn = concat(filter(map(alReadsOf(op), stackVarName),
                             (n) => alInFrame(frameIx, n)),
                      filter(liveOut,
                             (n) => !strListMember(writes, n)))
  ret alLinkAllPairs(acc2, liveIn)

fun alLink(acc, a, b)
  if a == b
    ret acc
  if !(get(acc.igEdges, a + "\u{a7}" + b) is None)
    ret acc
  ret IGraph(put(put(acc.igEdges, a + "\u{a7}" + b, true),
                 b + "\u{a7}" + a, true),
             alAdjAdd(alAdjAdd(acc.igAdj, a, b), b, a))

# The neighbour goes on the FRONT of the adjacency list. The only reader is
# the colouring, which folds the neighbours into the SET of colours already
# taken and then picks the lowest free one — the set is the same whichever
# order its members arrive in, so no colour assignment can change.
fun alAdjAdd(adj: Dict<String, List<String>>, from2: String,
             to2) => match(get(adj, from2))
  (prev: List<String>) => put(adj, from2, prepend(to2, prev))
  ()                   => put(adj, from2, list1(to2))

fun alLinkAllPairs(acc, names: List<String>) => alLapLoop(acc, chain(names))

fun [tail] alLapLoop(acc, ns: Chain<String>) => match(ns)
  (nil: ChainEnd) => acc
  (l: ChainLink)  => alLapLoop(alLapInner(acc, l.value, l.next), l.next)

fun [tail] alLapInner(acc, a, ns: Chain<String>) => match(ns)
  (nil: ChainEnd) => acc
  (l: ChainLink)  => alLapInner(alLink(acc, a, l.value), a, l.next)

fun alNeighbours(graph: IGraph, name: String) => match(get(graph.igAdj, name))
  (ns: List<String>) => ns
  ()                 => List()

# Greedy colouring in the given name order.
fun alColour(names: List<String>, graph: IGraph)
  ret fold(names, List(), (acc, n) => alColourOne(acc, n, graph))

# The colours already taken by this name's neighbours form a SET — alFirstFree
# asks nothing of it but membership. The new entry goes on the FRONT of the
# accumulator, which is a name→colour map read by niLookup: each name is
# coloured exactly once, so no lookup can find a different entry.
fun alColourOne(acc, name, graph: IGraph)
  let used = fold(alNeighbours(graph, name), Set(),
                  (u, nb) => alUsedColour(u, acc, nb))
  ret prepend(NameIdx(name, alFirstFree(used, 0)), acc)

fun alUsedColour(u, acc: List<NameIdx>, nb: String): Set<Int> => match(niLookup(acc, nb))
  (c: Int) => add(u, c)
  ()        => u

fun [tail] alFirstFree(used: Set<Int>, c) => contains(used, c) ? alFirstFree(used, c + 1) : c

# All-pointer struct leaf paths (nested), None otherwise.
fun alPtrLeaves(t2): (ls: List<String>, n: Int)|None => match(t2)
  (s2: CgStruct)          => alPtrLeavesFields(s2.fields)
  (im: CgImmediateStruct) => alPtrLeavesFields(im.fields)
  (o: CgType)             => None

# Paths encoded as "/"-joined field names (root-first); the leaf count
# rides the same fold (no-length ruling).
# The paths come out in FIELD order and are indexed positionally by the
# decomposed layout, so they are built at the tail. `ok` clears as soon as a
# field is neither a pointer nor an all-pointer struct, and the part-built list
# is then dropped unbuilt.
class [linear, final] PlfAcc(plPaths: ListBuilder<String>, plN: Int,
                             plOk: Bool)

fun alPtrLeavesFields(fields: List<CgField>): (ls: List<String>, n: Int)|None
  ret alPlfLoop(chain(fields), PlfAcc(builder(), 0, true))

fun [tail] alPlfLoop(fs: Chain<CgField>,
                     [terminal] acc: PlfAcc): (ls: List<String>, n: Int)|None => match(fs)
  (nil: ChainEnd) => acc.plOk && acc.plN > 0
    ? (build(acc.plPaths), acc.plN)
    : None
  (l: ChainLink)  => acc.plOk
    ? alPlfLoop(l.next, alPlfOne(acc, l.value))
    : None

fun alPlfOne([terminal] acc: PlfAcc, f2: CgField) => match(f2.fieldType)
  (d: CgDataPointer) => PlfAcc(push(acc.plPaths, f2.fieldName),
                               acc.plN + 1, true)
  (s2: CgStruct)     => alPlfNested(acc, f2, alPtrLeavesFields(s2.fields))
  (im: CgImmediateStruct) => alPlfNested(acc, f2,
                                         alPtrLeavesFields(im.fields))
  (o: CgType)        => PlfAcc(acc.plPaths, acc.plN, false)

fun alPlfNested([terminal] acc: PlfAcc, f2: CgField,
                inner: (ls: List<String>, n: Int)|None) => match(inner)
  (ps: (ls: List<String>, n: Int)) =>
      PlfAcc(pushAll(acc.plPaths,
                 map(ps.ls,
                     (p) => f2.fieldName + "/" + p)),
             acc.plN + ps.n, true)
  ()  => PlfAcc(acc.plPaths, acc.plN, false)

# Frame layout: coalesce per exact-type class (by_type in FIRST-SEEN type
# order — type_index numbers from it), then route slots: strict DataPointer →
# trailing GC array; all-pointer structs → decomposed array runs; else inline
# $slot$<typeidx>$<colour> fields.
fun alComputeFrameLayout(smBbs: List<ABlock>, hotBbs: List<ABlock>,
                         livenessOps: List<Op>)
  let fieldTypes = alFrameFieldTypes(smBbs)
  let frameNames = map(fieldTypes, (f2) => f2.fieldName)
  let hotOps = fold(hotBbs, List(), (acc, bb) => concat(acc, bb.abOps))
  let graph = alBuildInterference(list2(livenessOps, hotOps), frameNames)
  let byType = alGroupByType(fieldTypes)
  ret alLayoutLoop(chain(byType), graph, 0, AFrame(List(), List(),
                                                   List(), 0, List()))

class [final] TypeGroup(tgType: CgType, tgNames: List<String>)

# Fields grouped by exact type: the groups in FIRST-SEEN type order, because
# the type index numbers from it, and the names within a group in field order,
# because the colouring walks them in that order.
#
# Each group SELECTS its fields rather than being accumulated into. The old
# shape appended the name to the matching group for every field, and since a
# group's names live inside the group list, that meant rebuilding the entire
# list of groups once per field of the frame.
fun alGroupByType(fieldTypes: List<CgField>)
  ret map(
        build(alDistinctTypes(chain(fieldTypes), List(),
                              builder())),
        (t2) => TypeGroup(t2,
            map(filter(fieldTypes,
                       (f2) => eqCgType(f2.fieldType, t2)),
                (f2) => f2.fieldName)))

# The distinct field types in first-seen order. `seen` answers only "have I
# had this type before", so its own order is free; the builder carries the
# order that matters.
fun [tail] alDistinctTypes(fs: Chain<CgField>, seen: List<CgType>,
                           [terminal] out): ListBuilder<CgType> => match(fs)
  (nil: ChainEnd) => out
  (l: ChainLink)  => any(seen, (t2) => eqCgType(t2, l.value.fieldType))
    ? alDistinctTypes(l.next, seen, out)
    : alDistinctTypes(l.next, prepend(l.value.fieldType, seen),
                      push(out, l.value.fieldType))

fun [tail] alLayoutLoop(gs: Chain<TypeGroup>, graph: IGraph, ti, acc: AFrame) => match(gs)
  (nil: ChainEnd) => acc
  (l: ChainLink)  => alLayoutLoop(l.next, graph, ti + 1,
                                  alLayoutGroup(l.value, graph, ti, acc))

fun alLayoutGroup(g2: TypeGroup, graph: IGraph, ti: Int, acc: AFrame)
  let colour = alColour(g2.tgNames, graph)
  let nColours = alDistinctColourCount(colour)
  ret match(g2.tgType)
    (d: CgDataPointer) => AFrame(
        concat(acc.afPtrSlots, map(colour, (e2) => NameIdx(e2.niName, acc.afNArray + e2.niIdx))),
        acc.afInlineSlots, acc.afSlotFields, acc.afNArray + nColours, acc.afDecomposed)
    (o: CgType) => alLayoutNonPtr(g2, colour, nColours, ti, acc)

fun alLayoutNonPtr(g2: TypeGroup, colour: List<NameIdx>, nColours: Int, ti: Int, acc: AFrame)
  ret match(alPtrLeaves(g2.tgType))
    (leaves: (ls: List<String>, n: Int)) => alLayoutDecomposed(colour, leaves.n, acc)
    ()                      => alLayoutInline(g2, colour, ti, acc)

# colour_base maps each distinct colour (sorted) to array base indices.
fun alLayoutDecomposed(colour: List<NameIdx>, width, acc: AFrame): AFrame
  let sorted2 = alSortedColours(colour)
  let entries = map(colour, (e2) => NameIdx(e2.niName,
                      acc.afNArray + alIndexOfInt(sorted2.cs, e2.niIdx) * width))
  ret AFrame(acc.afPtrSlots, acc.afInlineSlots, acc.afSlotFields,
             acc.afNArray + width * sorted2.n,
             concat(acc.afDecomposed, entries))

fun alLayoutInline(g2: TypeGroup, colour: List<NameIdx>, ti: Int, acc: AFrame): AFrame
  let sortedColours = alSortedColours(colour).cs
  let newFields = map(sortedColours, (c) => CgField("$slot$" + String(ti) + "$" + String(c), g2.tgType))
  ret AFrame(acc.afPtrSlots,
             concat(acc.afInlineSlots, map(colour, (e2) =>
               NameStr(e2.niName, "$slot$" + String(ti) + "$" + String(e2.niIdx)))),
             concat(acc.afSlotFields, newFields), acc.afNArray, acc.afDecomposed)

fun alDistinctColourCount(colour: List<NameIdx>): Int => alSortedColours(colour).n

# The distinct colours in use, ascending, and how many there are.
#
# A Set says both things directly. What this replaces collected the distinct
# values by scanning everything collected so far for each one, then sorted them
# with a hand-written selection sort — a full scan of the remainder to find
# each next smallest, and an append to put it at the end.
fun alSortedColours(colour: List<NameIdx>): (cs: List<Int>, n: Int)
  let distinct = fold(colour, Set(),
                     (acc, e2) => add(acc, e2.niIdx))
  ret (sort(distinct), size(distinct))

fun alIndexOfInt(l: List<Int>, x: Int) => alIoiLoop(chain(l), x, 0)

fun [tail] alIoiLoop(ls: Chain<Int>, x: Int, i) => match(ls)
  (nil: ChainEnd) => 0   # unreachable: x came from the list
  (l: ChainLink)  => l.value == x ? i : alIoiLoop(l.next, x, i + 1)

# ── store/load between locals and the state object ───────────────────────────

# `sp` = the state-object base (Python's state_param argument): the HOT PATH
# and stub launch address the freshly-allocated $sv_state; the STATE MACHINE
# addresses its $state parameter. Hardcoding one base here read a never-
# written $state in the hot path's save block (uninit_check caught it).
fun alArrayElem(sp, stateName, index): RParam
  ret RpObjectField(CgDataPointer(), sp, stateName, "array",
                    RpInteger(index, 32), false)

# Frame local reference: trailing-array slot | shared inline slot | named field.
fun alStateField(name, t2, sp, stateName, layout: AFrame)
  ret match(niLookup(layout.afPtrSlots, name))
    (i: Int) => alArrayElem(sp, stateName, i)
    ()        => match(nsLookup(layout.afInlineSlots, name))
      (slot: String) => RpObjectField(t2, sp, stateName, slot, None, false)
      ()              => RpObjectField(t2, sp, stateName, name, None, false)

# local → state; a decomposed struct stores one leaf per array element.
fun alStoreVar(v, sp, stateName, layout: AFrame)
  ret match(niLookup(layout.afDecomposed, stackVarName(v)))
    (base: Int) => alStoreDecomposed(v, sp, stateName, base)
    ()           => list1(OpMove(alStateField(stackVarName(v), rpGetType(v), sp, stateName, layout),
                                 v, false, List()))

fun alStoreDecomposed(v, sp, stateName, base) => match(alPtrLeaves(rpGetType(v)))
  (paths: (ls: List<String>, n: Int)) => alSdLoop(chain(paths.ls), v, sp, stateName, base, 0, List())
  ()                     => List()   # unreachable: decomposed entries are all-ptr structs

fun alSdLoop(ps, v: RParam, sp, stateName,
                    base, i, acc: List<Op>)
  ret build(alSdLoopB(ps, v, sp, stateName, base, i, builderFrom(acc)))

fun [tail] alSdLoopB(ps: Chain<String>, v: RParam, sp, stateName,
                    base, i, [terminal] acc: ListBuilder<Op>) => match(ps)
  (nil: ChainEnd) => acc
  (l: ChainLink)  => alSdLoopB(l.next, v, sp, stateName, base, i + 1,
      push(acc, OpMove(alArrayElem(sp, stateName, base + i),
                    alPathField(v, l.value), false, List())))

fun alPathField(v: RParam, path): RParam
  ret fold(splitPath(path), v, (src, f2) => RpStructField(src, f2))

fun splitPath(path) => splitPathLoop(path, 0, 0, List())

fun splitPathLoop(path, start, i, acc: List<String>): List<String>
  ret build(splitPathLoopB(path, start, i, builderFrom(acc)))

fun [tail] splitPathLoopB(path, start, i, [terminal] acc: ListBuilder<String>): ListBuilder<String>
  if i >= length(path)
    ret push(acc, slice(path, start, i))
  ret byteAt(path, i) == '/'
    ? splitPathLoopB(path, i + 1, i + 1, push(acc, slice(path, start, i)))
    : splitPathLoopB(path, start, i + 1, acc)

# state → local; a decomposed struct is rebuilt from its array elements via
# nested NewStructs (index walk in leaf order).
fun alLoadVar(v, sp, stateName, layout: AFrame): List<Op>
  ret match(niLookup(layout.afDecomposed, stackVarName(v)))
    (base: Int) => list1(OpMove(v, alRebuild(rpGetType(v), sp, stateName, base).rbValue,
                                false, List()))
    ()           => list1(OpMove(v, alStateField(stackVarName(v), rpGetType(v), sp, stateName, layout),
                                 false, List()))

class [final] Rebuilt(rbValue: RParam, rbNext: Int)

# The values go into the struct in FIELD order, matching the index walk that
# reads them out of the array, so they are built at the tail.
fun alRebuild(t2, sp, stateName, idx): Rebuilt
  ret alRebuildFields(cgFieldsOfOrEmpty(t2), sp, stateName, idx,
                      builder())

fun [tail] alRebuildFields(fields: List<CgField>, sp, stateName, idx,
                           [terminal] acc): Rebuilt
  if isEmpty(fields)
    ret Rebuilt(RpNewStruct(build(acc)), idx)
  let f2 = forceNth(fields, 0)
  let rest = tail(fields)
  ret match(f2.fieldType)
    (s2: CgStruct) => alRebuildNested(f2, rest, sp, stateName, idx, acc)
    (im: CgImmediateStruct) => alRebuildNested(f2, rest, sp, stateName, idx, acc)
    (o: CgType)    => alRebuildFields(rest, sp, stateName, idx + 1,
                        push(acc,
                            RpNamedValue(f2.fieldName,
                                         alArrayElem(sp, stateName, idx))))

fun alRebuildNested(f2: CgField, rest: List<CgField>, sp, stateName, idx,
                    [terminal] acc): Rebuilt
  let inner = alRebuild(f2.fieldType, sp, stateName, idx)
  ret alRebuildFields(rest, sp, stateName, inner.rbNext,
                      push(acc,
                          RpNamedValue(f2.fieldName, inner.rbValue)))

# ── musttail unroll (SM view) + state object ────────────────────────────────

fun alUnrollMusttail(f: CgFunction)
  ret cgFunctionWith(f, build(alUmLoop(f.fnOps, 0i32, 0, seqBuilder())),
                     f.fnStackVars)

fun [tail] alUmLoop(s: Segment<Op>|None, iSeg, counter,
                    [terminal] acc): SeqBuilder<Op> => match(s)
  (nil: None)        => acc
  (seg: Segment<Op>) => iSeg >= seg.length
    ? alUmLoop(seg.next, 0i32, counter, acc)
    : match(alUmOne(seg.array(iSeg), counter))
        (u: UmOut) => alUmLoop(s, iSeg + 1i32, u.umCounter,
                               pushAll(acc, u.umOps))
        ()          => alUmLoop(s, iSeg + 1i32, counter, push(acc, seg.array(iSeg)))

class [final] UmOut(umOps: List<Op>, umCounter: Int)

fun alUmOne(op, counter) => match(op)
  (c: OpCall) => c.callMusttail ? alUmCall(c, counter + 1) : None
  (o: Op)     => None

fun alUmCall(c: OpCall, n) => alResultTypeVoidish(c.callResultType)
  ? UmOut(list2(OpCall(c.callFunction, c.callParameters, None, false, c.callImpure,
                       c.callResultType, c.callSavedVars),
                OpReturnVoid(List())), n)
  : alUmValued(c, n)

fun alUmValued(c: OpCall, n)
  let tmp = RpStackVar(alForceResultType(c.callResultType), "$musttail$ret$" + String(n))
  ret UmOut(list2(OpCall(c.callFunction, c.callParameters, tmp, false, c.callImpure,
                         c.callResultType, c.callSavedVars),
                  OpReturn(tmp, List())), n)

fun alForceResultType(t2: CgType|None) => match(t2)
  (x: CgType) => x
  ()           => CgDataPointer()   # unreachable: valued musttails carry a type

# State object: type, my_task, <inline PTR-BEARING slots>, idx, $ptr_count,
# <non-ptr slots>, array[0] — pointer slots kept LOW for the location mask.
fun alCreateStateObject(f: CgFunction, stateName, layout: AFrame)
  let inlinePtr = filter(layout.afSlotFields, (f2) => cgHasPointers(f2.fieldType))
  let nonPtr = filter(layout.afSlotFields, (f2) => !cgHasPointers(f2.fieldType))
  # The layout is fixed: header, pointer-bearing inline slots, index and
  # pointer count, non-pointer slots, and the GC array LAST — it is a trailing
  # flexible array, so nothing may follow it. One builder, in that order.
  let fl0 = builderFrom(list2(CgField("type", CgDataPointer()),
                              CgField("my_task", CgDataPointer())))
  let fl1 = pushAll(fl0, inlinePtr)
  let fl2 = pushAll(fl1,
                list2(CgField("idx", CgInt(32)),
                      CgField("$ptr_count", CgInt(32))))
  let fl3 = pushAll(fl2, nonPtr)
  let fields = build(push(fl3,
                   CgField("array", CgArray(CgDataPointer(), 0))))
  ret CgObject(stateName, List(), List(),
               CgImmediateStruct(fields), "$ptr_count", f.fnComment,
               false, true, 0)   # is_mutable: idx + live vars rewritten at every suspension

# ── hot-path function ────────────────────────────────────────────────────────

# All state-resident vars over bbs[:-1]: sorted live per block + result reg,
# first-seen dedup — the prologue zero-inits every NON-PARAM one (GC safety
# for cold blocks firing before later sites' vars are assigned).
# DISCOVERY ORDER IS OBSERVED HERE — this is the one place a StackVar set's
# order reaches the output. The list becomes the hot path's zero-init
# prologue, and Python builds it with all_state_vars.append(var) in exactly
# this order (per block: live-sorted, then the block's result register). So it
# is a builder with a separate membership set, not svSetAdd — svSetAdd puts
# new members on the FRONT, which reversed the whole prologue.
class [linear, final] AsvAcc(asOrder: ListBuilder<RParam>, asSeen: Set<String>)

fun alAllStateVars(bbs: List<ABlock>)
  ret asvBuild(alAsvLoop(chain(alNonTerminal(bbs)),
                         AsvAcc(builder(), Set())))

fun asvBuild(acc: AsvAcc) => build(acc.asOrder)

fun [tail] alAsvLoop(bs: Chain<ABlock>, [terminal] acc) => match(bs)
  (nil: ChainEnd) => acc
  (l: ChainLink)  => alAsvLoop(l.next, alAsvBlock(acc, l.value))

fun alAsvBlock([terminal] acc, bb: ABlock) => match(bb.abResult)
  (r: RParam) => asvAdd(alAsvLive(chain(svSortedByName(bb.abLive)), acc), r)
  ()          => alAsvLive(chain(svSortedByName(bb.abLive)), acc)

fun [tail] alAsvLive(vs: Chain<RParam>, [terminal] acc) => match(vs)
  (nil: ChainEnd) => acc
  (l: ChainLink)  => alAsvLive(l.next, asvAdd(acc, l.value))

fun asvAdd([terminal] acc, v) => contains(acc.asSeen, stackVarName(v))
  ? acc
  : AsvAcc(push(acc.asOrder, v),
           add(acc.asSeen, stackVarName(v)))

fun alZeroVal(t2) => match(t2)
  (d: CgDataPointer) => RpNullPointer()
  (i: CgInt)         => RpInteger(0, i.precision)
  (o: CgType)        => RpZeroOf(t2)

class [final] HotOut(hoOps: List<Op>, hoWrapFields: List<CgField>)

# The same two lists while they are being BUILT. Both are ordered — the ops are
# instruction order, the wrap fields are frame-field order — and every hot site
# used to concat its ops onto everything emitted so far, so assembling a
# function was quadratic in its own instruction count. HotOut stays a plain
# record because the assembler reads it several times; only the walk is linear.
class [linear, final] HotAcc(haOps: ListBuilder<Op>,
                             haWrapFields: ListBuilder<CgField>)

fun hotBuild(acc: HotAcc) => HotOut(build(acc.haOps), build(acc.haWrapFields))

# Zero-init every state-resident var that is not already a parameter, in the
# order alAllStateVars settled on.
fun [tail] alHotPrologue(vs: Chain<RParam>, paramNames: List<String>,
                         [terminal] acc: ListBuilder<Op>) => match(vs)
  (nil: ChainEnd) => acc
  (l: ChainLink)  => strListMember(paramNames, stackVarName(l.value))
    ? alHotPrologue(l.next, paramNames, acc)
    : alHotPrologue(l.next, paramNames,
                    push(acc, OpMove(l.value,
                                     alZeroVal(rpGetType(l.value)),
                                     false, List())))

fun alCreateHotPathFunc(f: CgFunction, stateName, subtype: String|None,
                        bbs: List<ABlock>, layout: AFrame)
  let wrappedResult = wrapReturnType(f.fnResult)
  let paramNames = map(cgFieldsOfOrEmpty(f.fnParams), (fld) => fld.fieldName)
  # The prologue's zero-inits open the op stream, so the builder starts with
  # them and the hot sites push onto the same one; the terminal block's ops
  # close it.
  let prologue = alHotPrologue(chain(alAllStateVars(bbs)), paramNames,
                               builder())
  let body = alHotSites(chain(alNonTerminal(bbs)), f, wrappedResult, 0,
                        HotAcc(prologue, builder()))
  let withTerminal = hotBuild(
      HotAcc(pushAll(body.haOps,
                 alConvertReturnsHot(alLastBlock(bbs).abOps,
                                     wrappedResult)),
             body.haWrapFields))
  let hasPar = any(alNonTerminal(bbs), (bb) => alBlockIsPar(bb))
  ret f.fnSync
    ? alHotAssembleSync(f, wrappedResult, withTerminal, hasPar)
    : alHotAssembleAsync(f, stateName, subtype, bbs, layout, wrappedResult, withTerminal, hasPar)

fun alLastBlock(bbs: List<ABlock>) => match(lastOp2(chain(bbs)))
  (bb: ABlock) => bb
  ()            => ABlock("", List(), List(), None)   # unreachable: >=1 block always

fun [tail] lastOp2(bbs: Chain<ABlock>) => match(bbs)
  (nil: ChainEnd) => None
  (l: ChainLink)  => match(l.next)
    (nil2: ChainEnd) => l.value
    (l2: ChainLink)  => lastOp2(l.next)

fun alBlockIsPar(bb: ABlock) => match(lastOp(chain(bb.abOps)))
  (op: Op) => match(op)
    (pc: OpParallelCall) => true
    (o: Op)               => false
  ()        => false

fun [tail] alHotSites(bs: Chain<ABlock>, f: CgFunction, wrappedResult,
                      i, [terminal] acc) => match(bs)
  (nil: ChainEnd) => acc
  (l: ChainLink)  => alHotSites(l.next, f, wrappedResult, i + 1,
                                alHotSite(l.value, f, wrappedResult, i, acc))

fun alHotSite(bb: ABlock, f: CgFunction, wrappedResult, i,
              [terminal] acc) => match(lastOp(chain(bb.abOps)))
  (op: Op) => match(op)
    (pc: OpParallelCall) => alHotPar(bb, pc, f, wrappedResult, i, acc)
    (c: OpCall)          => alHotCall(bb, c, wrappedResult, i, acc)
    (o: Op)               => acc   # unreachable: non-terminal blocks end in a splitter
  ()        => acc

fun alHotPar(bb: ABlock, pc: OpParallelCall, f: CgFunction, wrappedResult,
             i: Int, [terminal] acc: HotAcc): HotAcc
  let parTaskName = "task$par$" + String(i) + "$" + f.fnName
  let closures = alClosuresCounted(chain(pc.parCalls), 0, builder())
  let ops1 = pushAll(acc.haOps,
                 alConvertReturnsHot(alDropLast(bb.abOps),
                                     wrappedResult))
  let ops2 = pushAll(ops1,
                 alEmitParTaskSetup(alSvParTask(), parTaskName,
                                    closures.cs, closures.n))
  let ops3 = alHotParLaunchers(ops2, f.fnName, i, chain(pc.parCalls), 0)
  ret HotAcc(pushAll(ops3,
                 list3(OpMove(alSvAsyncTask(), alSvParTask(), false, List()),
                       OpMove(alSvCallId(), RpInteger(i + 1, 32), false, List()),
                       OpJump("$asynccommon", List()))),
             acc.haWrapFields)

fun alClosureOf(callRef) => match(callRef)
  (gf: RpGlobalFunction) => match(gf.object)
    (obj: RParam) => obj
    ()             => RpNullPointer()
  (o: RParam)             => RpNullPointer()

fun [tail] alHotParLaunchers([terminal] acc, fnName,
                             site: Int, calls: Chain<RParam>,
                             k): ListBuilder<Op> => match(calls)
  (nil: ChainEnd) => acc
  (l: ChainLink)  => alHotParLaunchers(
      pushAll(acc,
          alEmitPostLauncher(alSvLauncher(), alSvParTask(),
                             fnName, site, k)),
      fnName, site, l.next, k + 1)

# One closure per parallel call, its count riding the walk (no-length ruling).
fun [tail] alClosuresCounted(ps: Chain<RParam>, n,
                             [terminal] acc: ListBuilder<RParam>): (cs: List<RParam>, n: Int)
  ret match(ps)
    (nil: ChainEnd) => (build(acc), n)
    (l: ChainLink)  => alClosuresCounted(l.next, n + 1,
                                         push(acc,
                                              alClosureOf(l.value)))

fun alHotCall(bb: ABlock, c: OpCall, wrappedResult, i,
              [terminal] acc: HotAcc) => match(c.callRegister)
  (reg: RParam) => alHotValued(bb, c, reg, wrappedResult, i, acc)
  ()             => alHotDiscarded(bb, c, wrappedResult, i, acc)

# register None + result_type None → pure void: emit unchanged. Non-void
# discarded → $wrap$<i> temp + IfTask, no unwrap Move.
fun alHotDiscarded(bb: ABlock, c: OpCall, wrappedResult, i,
                   [terminal] acc: HotAcc) => match(c.callResultType)
  (dt: CgType) => alHotDiscardedTyped(bb, c, dt, wrappedResult, i, acc)
  ()            => HotAcc(pushAll(acc.haOps,
                              alConvertReturnsHot(bb.abOps,
                                                  wrappedResult)),
                          acc.haWrapFields)

fun alHotDiscardedTyped(bb: ABlock, c: OpCall, dt, wrappedResult,
                        i, [terminal] acc: HotAcc)
  let dw = wrapReturnType(dt)
  let svWrap = RpStackVar(dw, "$wrap$" + String(i))
  let ops1 = pushAll(acc.haOps,
                 alConvertReturnsHot(alDropLast(bb.abOps),
                                     wrappedResult))
  let ops2 = push(ops1, OpCall(c.callFunction, c.callParameters, svWrap,
                               c.callMusttail, c.callImpure,
                               c.callResultType, c.callSavedVars))
  ret HotAcc(push(ops2, alIfTaskOp(svWrap, dw, i)),
             push(acc.haWrapFields,
                  CgField("$wrap$" + String(i), dw)))

fun alIfTaskOp(sv, wrapped, i) => OpIfTask(isTaskParam(sv, wrapped), taskPtrFrom(sv, wrapped),
                                           alSvAsyncTask(), alSvCallId(), i + 1, "$asynccommon", List())

# needs_temp: Python tests `wrapped is not result_type` — the wrap function
# returns its input unchanged for pass-through shapes, so structural
# inequality is the faithful port.
fun alHotValued(bb: ABlock, c: OpCall, reg, wrappedResult,
                i, [terminal] acc: HotAcc)
  let resultType = rpGetType(reg)
  let wrappedType = wrapReturnType(resultType)
  ret eqCgType(wrappedType, resultType)
    ? alHotValuedDirect(bb, c, reg, wrappedType, wrappedResult, i, acc)
    : alHotValuedTemp(bb, c, reg, wrappedType, wrappedResult, i, acc)

fun alHotValuedDirect(bb: ABlock, c: OpCall, reg, wrappedType,
                      wrappedResult, i,
                      [terminal] acc: HotAcc)
  let ops1 = pushAll(acc.haOps,
                 alConvertReturnsHot(bb.abOps, wrappedResult))
  ret HotAcc(push(ops1, alIfTaskOp(reg, wrappedType, i)),
             acc.haWrapFields)

fun alHotValuedTemp(bb: ABlock, c: OpCall, reg, wrappedType,
                    wrappedResult, i,
                    [terminal] acc: HotAcc)
  let svWrap = RpStackVar(wrappedType, "$wrap$" + String(i))
  let ops1 = pushAll(acc.haOps,
                 alConvertReturnsHot(alDropLast(bb.abOps),
                                     wrappedResult))
  let ops2 = push(ops1, OpCall(c.callFunction, c.callParameters, svWrap,
                               c.callMusttail, c.callImpure,
                               c.callResultType, c.callSavedVars))
  let ops3 = push(ops2, alIfTaskOp(svWrap, wrappedType, i))
  ret HotAcc(push(ops3, OpMove(reg, RpStructField(svWrap, "value"),
                               false, List())),
             push(acc.haWrapFields,
                  CgField("$wrap$" + String(i), wrappedType)))

# sync: $asynccommon aborts (a proven-sync fn reached it = broken contract).
fun alHotAssembleSync(f: CgFunction, wrappedResult, body: HotOut, hasPar: Bool): CgFunction
  let commonOps = list2<Op>(OpLabel("$asynccommon", List()),
                        OpAbort("sync function reached $asynccommon", List()))
  let parFields = hasPar
    ? list3(CgField("$sv_par_task", CgDataPointer()),
            CgField("$sv_launcher", CgDataPointer()),
            CgField("$sv_discard", CgDataPointer()))
    : List()
  let extra = concat(concat(list2(CgField("$sv_call_id", CgInt(32)),
                                  CgField("$sv_async_task", CgDataPointer())),
                            parFields),
                     body.hoWrapFields)
  ret CgFunction(f.fnName, f.fnParams, wrappedResult,
                 CgStruct(concat(cgFieldsOfOrEmpty(f.fnStackVars), extra)),
                 cgOpsOf(concat(body.hoOps, commonOps)), f.fnComment, f.fnForeignSymbol,
                 f.fnSync, f.fnTail, f.fnBypassAsync, f.fnAlwaysInline,
                 f.fnSourceFile, f.fnSourceLine)

fun alHotAssembleAsync(f: CgFunction, stateName, subtype: String|None,
                       bbs: List<ABlock>, layout: AFrame, wrappedResult,
                       body: HotOut, hasPar: Bool): CgFunction
  let nonTerminal = alNonTerminal(bbs)
  # One builder for the whole function body: the hot-path ops it was handed,
  # then the async-common epilogue pushed on in emission order. Every step
  # here used to copy everything emitted before it.
  let common0 = pushAll(
      builderFrom(body.hoOps),
      list2(OpLabel("$asynccommon", List()),
            OpNewObject(stateName, alSvState(),
                        RpInteger(layout.afNArray, 32),
                        List())))
  # Save only the suspending site's live set — shared slots must not be
  # clobbered by dead locals — dispatched on the recorded call id (1-based).
  let common1 = push(common0,
                       OpSwitchJump(alSvCallId(),
                                    alSaveCases(chain(nonTerminal), 0, List()),
                                    List()))
  let common2 = push(common1, OpJump("$save$done", List()))
  let common3 = alSaveBlocks(chain(nonTerminal), stateName, layout, 0, common2)
  let common4 = push(common3, OpLabel("$save$done", List()))
  let common5 = pushAll(common4, list2(
      OpMove(RpObjectField(CgDataPointer(), alSvState(), stateName, "my_task", None, false),
             RpNullPointer(), false, List()),
      OpMove(RpObjectField(CgInt(32), alSvState(), stateName, "idx", None, false),
             alSvCallId(), false, List())))
  let common6 = pushAll(common5,
                            alEmitTaskAlloc(alSvTask(), subtype))
  let callback = RpGlobalFunction(f.fnName + "$async", alSvState(), false, None, false, false)
  let common7 = pushAll(common6, list3(
      OpMove(RpObjectField(CgDataPointer(), alSvState(), stateName, "my_task", None, false),
             alSvTask(), false, List()),
      alRuntimeDiscard(alSvDiscard(), "task_on_complete",
                       list2(RpNamedValue("task", alSvAsyncTask()),
                             RpNamedValue("cb", callback))),
      OpReturn(RpTagTask(alSvTask(), wrappedResult), List())))
  let parFields = hasPar
    ? list2(CgField("$sv_par_task", CgDataPointer()), CgField("$sv_launcher", CgDataPointer()))
    : List()
  let extra = concat(concat(list5(CgField("$sv_state", CgDataPointer()),
                                  CgField("$sv_task", CgDataPointer()),
                                  CgField("$sv_discard", CgDataPointer()),
                                  CgField("$sv_call_id", CgInt(32)),
                                  CgField("$sv_async_task", CgDataPointer())),
                            parFields),
                     body.hoWrapFields)
  ret CgFunction(f.fnName, f.fnParams, wrappedResult,
                 CgStruct(concat(cgFieldsOfOrEmpty(f.fnStackVars), extra)),
                 cgOpsOf(build(common7)), f.fnComment, f.fnForeignSymbol,
                 f.fnSync, f.fnTail, f.fnBypassAsync, f.fnAlwaysInline,
                 f.fnSourceFile, f.fnSourceLine)

fun alSaveCases(bs: Chain<ABlock>, i, acc: List<OpCase>)
  ret build(alSaveCasesB(bs, i, builderFrom(acc)))

fun [tail] alSaveCasesB(bs: Chain<ABlock>, i, [terminal] acc): ListBuilder<OpCase> => match(bs)
  (nil: ChainEnd) => acc
  (l: ChainLink)  => alSaveCasesB(l.next, i + 1,
                                 push(acc, OpCase(i + 1, "$save$" + String(i))))

fun [tail] alSaveBlocks(bs: Chain<ABlock>, stateName, layout: AFrame,
                        i, [terminal] acc: ListBuilder<Op>) => match(bs)
  (nil: ChainEnd) => acc
  (l: ChainLink)  => alSaveBlocks(l.next, stateName, layout, i + 1,
      push(
          alSaveStores(l.value, stateName, layout,
              push(acc, OpLabel("$save$" + String(i), List()))),
          OpJump("$save$done", List())))

# Hot-path $asynccommon save: the base is the freshly-allocated $sv_state
# (Python 948: __store_var(var, __sv_state, ...)).
fun alSaveStores(bb: ABlock, stateName, layout: AFrame,
                 [terminal] acc): ListBuilder<Op>
  ret alSaveStoresLoop(chain(svSortedByName(bb.abLive)), stateName, layout,
                       acc)

fun [tail] alSaveStoresLoop(vs: Chain<RParam>, stateName,
                            layout: AFrame,
                            [terminal] acc: ListBuilder<Op>) => match(vs)
  (nil: ChainEnd) => acc
  (l: ChainLink)  => alSaveStoresLoop(l.next, stateName, layout,
      pushAll(acc, alStoreVar(l.value, alSvState(),
                              stateName, layout)))

# ── stub launch (oversized looping bodies) ───────────────────────────────────

fun alStubThresholdOps() => 256

# Stub mode: every UNPLACED param gains a state field (stub stores, entry
# case reloads).
# Of the four lists in a frame layout, only afSlotFields is ORDER-bearing — it
# becomes struct fields. The other three are name-keyed lookups (niLookup,
# nsLookup, alPlaced) whose entries carry their own array index, so a new one
# goes on the front. The slot fields are SELECTED from the parameters in
# parameter order rather than appended one at a time.
#
# alPlaced is asked of the ORIGINAL layout throughout: parameter names are
# distinct, and every entry added here is named after the parameter that added
# it, so no parameter can be blocked by another parameter's entry.
fun alAugmentLayoutWithParams(layout: AFrame, params: List<CgField>)
  let slotted = filter(params, (p) => alAugIsSlotField(layout, p))
  ret fold(params, AFrame(layout.afPtrSlots, layout.afInlineSlots,
                          concat(layout.afSlotFields, slotted),
                          layout.afNArray, layout.afDecomposed),
           (acc, p) => alAugOne(layout, acc, p))

fun alAugIsSlotField(layout: AFrame, p: CgField) => alPlaced(layout, p.fieldName)
  ? false
  : match(p.fieldType)
    (d: CgDataPointer) => false
    (o: CgType)        => alPtrLeaves(p.fieldType) is None

fun alAugOne(layout: AFrame, acc, p: CgField)
  if alPlaced(layout, p.fieldName)
    ret acc
  ret match(p.fieldType)
    (d: CgDataPointer) => AFrame(prepend(NameIdx(p.fieldName, acc.afNArray),
                                         acc.afPtrSlots),
                                 acc.afInlineSlots, acc.afSlotFields,
                                 acc.afNArray + 1, acc.afDecomposed)
    (o: CgType)        => alAugNonPtr(acc, p)

fun alAugNonPtr(acc: AFrame, p: CgField) => match(alPtrLeaves(p.fieldType))
  (leaves: (ls: List<String>, n: Int)) =>
      AFrame(acc.afPtrSlots, acc.afInlineSlots, acc.afSlotFields,
             acc.afNArray + leaves.n,
             prepend(NameIdx(p.fieldName, acc.afNArray), acc.afDecomposed))
  ()  => AFrame(acc.afPtrSlots,
                prepend(NameStr(p.fieldName, p.fieldName),
                        acc.afInlineSlots),
                acc.afSlotFields, acc.afNArray, acc.afDecomposed)

fun alPlaced(acc: AFrame, name: String) => any(acc.afPtrSlots, (e2) => e2.niName == name)
    || any(acc.afInlineSlots, (e2) => e2.nsName == name)
    || any(acc.afDecomposed, (e2) => e2.niName == name)
    || any(acc.afSlotFields, (f2) => f2.fieldName == name)

fun alCreateStubLaunchFunc(f: CgFunction, stateName, subtype: String|None,
                           layout: AFrame, entryIdx): CgFunction
  let wrappedResult = wrapReturnType(f.fnResult)
  let ops0 = list1<Op>(OpNewObject(stateName, alSvState(), RpInteger(layout.afNArray, 32), List()))
  # Stub launch stores into its own fresh $sv_state (Python 1053).
  let ops1 = fold(cgFieldsOfOrEmpty(f.fnParams), ops0, (acc, p) =>
               concat(acc, alStoreVar(RpStackVar(p.fieldType, p.fieldName), alSvState(), stateName, layout)))
  let ops2 = concat(ops1, list2(
      OpMove(RpObjectField(CgDataPointer(), alSvState(), stateName, "my_task", None, false),
             RpNullPointer(), false, List()),
      OpMove(RpObjectField(CgInt(32), alSvState(), stateName, "idx", None, false),
             RpInteger(entryIdx, 32), false, List())))
  let ops3 = concat(ops2, alEmitTaskAlloc(alSvTask(), subtype))
  let ops4 = concat(ops3, list3(
      OpMove(RpObjectField(CgDataPointer(), alSvState(), stateName, "my_task", None, false),
             alSvTask(), false, List()),
      # The machine's C signature is ($state, $completed_task); the state
      # rides the callee-object slot.
      OpCall(RpGlobalFunction(f.fnName + "$async", alSvState(), false, None, false, false),
             RpNewStruct(list1(RpNamedValue("$completed_task", RpNullPointer()))),
             None, false, false, None, List()),
      OpReturn(RpTagTask(alSvTask(), wrappedResult), List())))
  # Declare $sv_discard exactly when the ops write it (synthesised-subtype
  # task_init discards through it; the other alloc paths don't).
  let svFields = alOpsWriteDiscard(ops4)
    ? list3(CgField("$sv_state", CgDataPointer()), CgField("$sv_task", CgDataPointer()),
            CgField("$sv_discard", CgDataPointer()))
    : list2(CgField("$sv_state", CgDataPointer()), CgField("$sv_task", CgDataPointer()))
  ret CgFunction(f.fnName, f.fnParams, wrappedResult, CgStruct(svFields), cgOpsOf(ops4),
                 f.fnComment, f.fnForeignSymbol, f.fnSync, f.fnTail,
                 f.fnBypassAsync, f.fnAlwaysInline,
                 f.fnSourceFile, f.fnSourceLine)

fun alOpsWriteDiscard(ops: List<Op>) => any(ops, (op) => alWritesDiscard(op))

fun alWritesDiscard(op) => match(op)
  (m: OpMove) => match(m.moveTarget)
    (sv: RpStackVar) => sv.name == "$sv_discard"
    (o: RParam)       => false
  (o2: Op)     => false

# ── state-machine function ───────────────────────────────────────────────────

# void fn$async($state, $completed_task): dispatch on $state->idx, run the
# body on ORDINARY LOCALS (fields touched only at boundaries), park via the
# per-site cold blocks. Deliberately phi-lowered at the resume joins —
# ssa_validate exempts $async multi-defs.
fun alCreateStateMachineFunc(f: CgFunction, stateName: String, subtype: String|None,
                             bbs: List<ABlock>, layout: AFrame, withEntryCase: Bool): CgFunction
  let nt = alNonTerminalN(bbs)
  let nonTerminal = nt.bs
  let n = nt.n
  # Park stores skip loaded-only vars (loop invariants — their field is
  # already current; the only way in is a dispatch load).
  let bodyDefs = fold(bbs, Set(), (acc, bb) =>
                   fold(bb.abOps, acc, (a, op) =>
                     fold(alWritesOf(op), a, (a2, w) =>
                       add(a2, stackVarName(w)))))
  let idxField = RpObjectField(CgInt(32), alStateParam(), stateName, "idx", None, false)
  let myTaskField = RpObjectField(CgDataPointer(), alStateParam(), stateName, "my_task", None, false)
  let dispatch0 = alSmDispatchSwitch(n, withEntryCase, idxField)
  let body = alSmSites(chain(nonTerminal), f, stateName, subtype, layout, bodyDefs,
                       idxField, myTaskField, 0,
                       SmAcc(builderFrom(dispatch0),
                             builder(), builder()))
  let withTerminal = smBuild(
      SmAcc(pushAll(body.saOps,
                alConvertReturnsSm(alLastBlock(bbs).abOps,
                                   myTaskField, f.fnResult,
                                   subtype)),
            body.saCold, body.saWrapFields))
  let dispatchTail = alSmDispatchTail(nonTerminal, f, stateName, layout, withEntryCase, bbs)
  let allOps = alPrunePhiSources(concat(concat(withTerminal.smOps, withTerminal.smCold), dispatchTail))
  ret alSmAssemble(f, allOps, bbs, withTerminal.smWrapFields)

class [final] SmOut(smOps: List<Op>, smCold: List<Op>, smWrapFields: List<CgField>)

# The same three lists while they are being BUILT. All three are ordered — the
# body ops, the cold park blocks and the frame's wrap fields — and every
# suspension site used to concat its ops onto everything emitted before it, so
# lowering a state machine was quadratic in its own instruction count. SmOut
# stays plain because the assembler reads it repeatedly; only the walk is
# linear.
class [linear, final] SmAcc(saOps: ListBuilder<Op>, saCold: ListBuilder<Op>,
                            saWrapFields: ListBuilder<CgField>)

fun smBuild(acc: SmAcc) => SmOut(build(acc.saOps), build(acc.saCold),
                                 build(acc.saWrapFields))

# Case 0 is unused; cases 1..n are the suspension sites in index order, and
# the entry case — when there is one — comes after them.
fun alSmDispatchSwitch(n, withEntryCase: Bool, idxField): List<Op>
  let cases = alSmCases(n, 0, builder())
  let cases2 = build(withEntryCase
    ? push(cases, OpCase(n + 1, "$case$entry"))
    : cases)
  ret withEntryCase
    ? list2(OpSwitchJump(idxField, cases2, List()),
            OpLabel("$sm$body", List()))
    : list1(OpSwitchJump(idxField, cases2, List()))

fun [tail] alSmCases(n, i,
                     [terminal] acc: ListBuilder<OpCase>): ListBuilder<OpCase>
  if i >= n
    ret acc
  ret alSmCases(n, i + 1,
                push(acc, OpCase(i + 1, "$case$" + String(i + 1))))

fun [tail] alSmSites(bs: Chain<ABlock>, f: CgFunction, stateName,
                     subtype: String|None, layout: AFrame, bodyDefs: Set<String>,
                     idxField, myTaskField, i,
                     [terminal] acc) => match(bs)
  (nil: ChainEnd) => acc
  (l: ChainLink)  => alSmSites(l.next, f, stateName, subtype, layout, bodyDefs,
                               idxField, myTaskField, i + 1,
                               alSmSite(l.value, f, stateName, subtype, layout, bodyDefs,
                                        idxField, myTaskField, i, acc))

fun alSmSite(bb: ABlock, f: CgFunction, stateName, subtype: String|None,
             layout: AFrame, bodyDefs: Set<String>, idxField,
             myTaskField, i, [terminal] acc)
  let bodyOps = alConvertReturnsSm(alDropLast(bb.abOps), myTaskField, f.fnResult, subtype)
  # SM saves address the $state parameter (Python 1179).
  let saveStores = fold(svSortedByName(bb.abLive), List(), (a, v) =>
                     contains(bodyDefs, stackVarName(v))
                       ? concat(a, alStoreVar(v, alStateParam(), stateName, layout))
                       : a)
  ret match(lastOp(chain(bb.abOps)))
    (op: Op) => match(op)
      (pc: OpParallelCall) => alSmPar(pc, f, stateName, layout, idxField, i,
                          SmAcc(pushAll(acc.saOps,
                                            bodyOps),
                                acc.saCold, acc.saWrapFields),
                          saveStores)
      (c: OpCall)          => alSmCall(c, f, idxField, i,
                          SmAcc(pushAll(acc.saOps,
                                            bodyOps),
                                acc.saCold, acc.saWrapFields),
                          saveStores)
      (o: Op)               => acc   # unreachable
    ()        => acc

# A ParallelCall always parks.
fun alSmPar(pc: OpParallelCall, f: CgFunction, stateName: String, layout: AFrame,
            idxField, i: Int, [terminal] acc: SmAcc,
            saveStores: List<Op>): SmAcc
  let parTaskName = "task$par$" + String(i) + "$" + f.fnName
  let svParSm = RpStackVar(CgDataPointer(), "$sv_par_sm$" + String(i))
  let svLauncherSm = RpStackVar(CgDataPointer(), "$sv_launcher_sm$" + String(i))
  let closures = alClosuresCounted(chain(pc.parCalls), 0, builder())
  let ops1 = pushAll(acc.saOps,
                 alEmitParTaskSetup(svParSm, parTaskName,
                                    closures.cs, closures.n))
  let ops2 = alSmParLaunchers(ops1, svLauncherSm, svParSm, f.fnName, i, chain(pc.parCalls), 0)
  let ops3 = pushAll(pushAll(ops2, saveStores),
                 alEmitSuspendToAsync(idxField, i + 1, svParSm,
                                      f.fnName))
  ret SmAcc(push(ops3, OpLabel("$resume$" + String(i), List())),
            acc.saCold,
            pushAll(acc.saWrapFields,
                list2(CgField("$sv_par_sm$" + String(i), CgDataPointer()),
                      CgField("$sv_launcher_sm$" + String(i), CgDataPointer()))))

fun [tail] alSmParLaunchers([terminal] acc, launcherVar,
                            parVar, fnName, site: Int,
                            calls: Chain<RParam>, k): ListBuilder<Op> => match(calls)
  (nil: ChainEnd) => acc
  (l: ChainLink)  => alSmParLaunchers(
      pushAll(acc, alEmitPostLauncher(launcherVar, parVar,
                                      fnName, site, k)),
      launcherVar, parVar, fnName, site, l.next, k + 1)

fun alSmCall(c, f: CgFunction, idxField, i,
             [terminal] acc: SmAcc, saveStores: List<Op>) => match(c.callRegister)
  (reg: RParam) => alSmValued(c, reg, f, idxField, i, acc, saveStores)
  ()             => alSmNoReg(c, f, idxField, i, acc, saveStores)

fun alSmNoReg(c, f: CgFunction, idxField, i,
              [terminal] acc: SmAcc, saveStores: List<Op>) => match(c.callResultType)
  # Discarded non-void: $sm_wrap$<i> register, IS_TASK, no unwrap.
  (dt: CgType) => alSmChecked(c, RpStackVar(wrapReturnType(dt), "$sm_wrap$" + String(i)),
                              wrapReturnType(dt), None, true, f, idxField, i, acc, saveStores)
  # Pure void: no check; resume label directly after the call.
  ()            => SmAcc(push(push(acc.saOps, c),
                             OpLabel("$resume$" + String(i), List())),
                         acc.saCold, acc.saWrapFields)

fun alSmValued(c, reg, f: CgFunction, idxField, i,
               [terminal] acc: SmAcc, saveStores: List<Op>)
  let resultType = rpGetType(reg)
  let wrappedType = wrapReturnType(resultType)
  ret eqCgType(wrappedType, resultType)
    ? alSmChecked(c, reg, wrappedType, None, false, f, idxField, i, acc, saveStores)
    : alSmChecked(c, RpStackVar(wrappedType, "$sm_wrap$" + String(i)), wrappedType,
                  OpMove(reg, RpStructField(RpStackVar(wrappedType, "$sm_wrap$" + String(i)), "value"),
                         false, List()),
                  true, f, idxField, i, acc, saveStores)

# The IS_TASK check + unwrap sit BEFORE $resume$<i> (sync edge only); the
# park path is the ONLY place block i's locals reach the state object.
fun alSmChecked(c: OpCall, svCheck: RParam, checkType: CgType, unwrapOp: Op|None,
                retarget: Bool, f: CgFunction, idxField: RParam, i: Int,
                [terminal] acc: SmAcc, saveStores: List<Op>): SmAcc
  let callOp = retarget
    ? OpCall(c.callFunction, c.callParameters, svCheck, c.callMusttail, c.callImpure,
             c.callResultType, c.callSavedVars)
    : c
  let check = RpRuntimeInvoke("UNLIKELY",
                              RpNewStruct(list1(RpNamedValue("x", isTaskParam(svCheck, checkType)))),
                              CgInt(32))
  let asyncLabel = "$async_sm$" + String(i)
  let ops1 = push(push(acc.saOps, callOp),
                  OpJumpIf(asyncLabel, check, false, List()))
  let ops2 = match(unwrapOp)
    (u: Op) => push(ops1, u)
    ()       => ops1
  let ops3 = push(ops2, OpLabel("$resume$" + String(i), List()))
  let untagged = RpRuntimeInvoke("TASK_UNTAG",
                                 RpNewStruct(list1(RpNamedValue("p", taskPtrFrom(svCheck, checkType)))),
                                 CgDataPointer())
  let cold1 = pushAll(push(acc.saCold,
                           OpLabel(asyncLabel, List())),
                          saveStores)
  let cold2 = pushAll(cold1,
                  alEmitSuspendToAsync(idxField, i + 1, untagged,
                                       f.fnName))
  let wraps = retarget
    ? push(acc.saWrapFields,
           CgField(stackVarName(svCheck), checkType))
    : acc.saWrapFields
  ret SmAcc(ops3, cold2, wraps)

# Dispatch cases at the tail: reload the site's live set, extract the
# completed call's result, jump to the resume point.
fun alSmDispatchTail(nonTerminal: List<ABlock>, f: CgFunction, stateName,
                     layout: AFrame, withEntryCase, bbs: List<ABlock>)
  let cases = alSmDtLoop(chain(nonTerminal), f, stateName, layout, 0,
                         builder())
  ret build(withEntryCase
    ? pushAll(cases,
          alSmEntryCase(f, stateName, layout, nonTerminal))
    : cases)

fun [tail] alSmDtLoop(bs: Chain<ABlock>, f: CgFunction, stateName,
                      layout: AFrame, i,
                      [terminal] acc: ListBuilder<Op>) => match(bs)
  (nil: ChainEnd) => acc
  (l: ChainLink)  => alSmDtLoop(l.next, f, stateName, layout, i + 1,
                                alSmDtCase(l.value, f, stateName, layout, i, acc))

# One dispatch case: its label, the site's live set reloaded, the completed
# call's result extracted, then the jump to the resume point — in that order.
fun alSmDtCase(bb: ABlock, f: CgFunction, stateName, layout: AFrame,
               i: Int, [terminal] acc: ListBuilder<Op>): ListBuilder<Op>
  let ops1 = alSmDtLoads(chain(svSortedByName(bb.abLive)), stateName, layout,
                 push(acc, OpLabel("$case$" + String(i + 1),
                                   List())))
  let ops2 = pushAll(ops1, alSmDtExtract(bb, f, i))
  ret push(ops2, OpJump("$resume$" + String(i), List()))

fun [tail] alSmDtLoads(vs: Chain<RParam>, stateName: String, layout: AFrame,
                       [terminal] acc: ListBuilder<Op>): ListBuilder<Op> => match(vs)
  (nil: ChainEnd) => acc
  (l: ChainLink)  => alSmDtLoads(l.next, stateName, layout,
      pushAll(acc, alLoadVar(l.value, alStateParam(),
                             stateName, layout)))

fun alSmDtExtract(bb: ABlock, f: CgFunction, i: Int): List<Op> => match(lastOp(chain(bb.abOps)))
  (op: Op) => match(op)
    (pc: OpParallelCall) => alSmDtPar(pc, f, i)
    (o: Op)               => alSmDtResult(bb)
  ()        => List()

# Completed par_task: assemble the result tuple from its result_k fields.
fun alSmDtPar(pc: OpParallelCall, f: CgFunction, i: Int): List<Op> => match(pc.parRegister)
  (reg: RParam) => list1(OpMove(reg,
      RpNewStruct(alSmDtParFields(chain(pc.parResults), "task$par$" + String(i) + "$" + f.fnName, 0, List())),
      false, List()))
  ()             => List()

fun alSmDtParFields(rs, parTaskName, k: Int,
                           acc: List<RpNamedValue>)
  ret build(alSmDtParFieldsB(rs, parTaskName, k, builderFrom(acc)))

fun [tail] alSmDtParFieldsB(rs: Chain<RParam>, parTaskName, k,
                           [terminal] acc: ListBuilder<RpNamedValue>) => match(rs)
  (nil: ChainEnd) => acc
  (l: ChainLink)  => alSmDtParFieldsB(l.next, parTaskName, k + 1,
      push(acc, RpNamedValue("_" + String(k),
        RpObjectField(rpGetType(l.value), alCompletedParam(),
                      parTaskName, "result_" + String(k), None, false))))

fun alSmDtResult(bb: ABlock): List<Op> => match(bb.abResult)
  (reg: RParam) => match(taskSubtypeName(rpGetType(reg)))
    (st: String) => list1(OpMove(reg,
                      RpObjectField(rpGetType(reg), alCompletedParam(), st, "result", None, false),
                      false, List()))
    ()            => list1(OpMove(reg, RpNullPointer(), false, List()))
  ()             => List()

# Entry case (stub mode): load params, then every live var not yet loaded
# (the zero-filled field equals the old field-addressed semantics).
fun alSmEntryCase(f: CgFunction, stateName, layout: AFrame,
                  nonTerminal: List<ABlock>)
  let afterParams = alSmEntryParams(chain(cgFieldsOfOrEmpty(f.fnParams)),
                        stateName, layout,
                        EntryAcc(push(builder(),
                                     OpLabel("$case$entry", List())),
                                 Set()))
  let afterLive = alSmEntryBlocks(chain(nonTerminal), stateName, layout,
                                  afterParams)
  ret build(push(afterLive.eaOps,
                 OpJump("$sm$body", List())))

# Every parameter, then every block's live set, each loaded ONCE — first
# occurrence wins and the loads come out in that order. `seen` is asked only
# whether a name has been loaded, so it is a Set; the loads are ordered, so
# they go into a builder, and the two travel together.
class [linear, final] EntryAcc(eaOps: ListBuilder<Op>, eaSeen: Set<String>)

fun [tail] alSmEntryParams(ps: Chain<CgField>, stateName,
                           layout: AFrame,
                           [terminal] acc): EntryAcc => match(ps)
  (nil: ChainEnd) => acc
  (l: ChainLink)  => alSmEntryParams(l.next, stateName, layout,
      EntryAcc(pushAll(acc.eaOps,
                   alLoadVar(RpStackVar(l.value.fieldType,
                                        l.value.fieldName),
                             alStateParam(), stateName, layout)),
               add(acc.eaSeen, l.value.fieldName)))

fun [tail] alSmEntryBlocks(bs: Chain<ABlock>, stateName,
                           layout: AFrame,
                           [terminal] acc): EntryAcc => match(bs)
  (nil: ChainEnd) => acc
  (l: ChainLink)  => alSmEntryBlocks(l.next, stateName, layout,
      alSmEntryLive(chain(svSortedByName(l.value.abLive)), stateName,
                    layout, acc))

fun [tail] alSmEntryLive(vs: Chain<RParam>, stateName: String, layout: AFrame,
                         [terminal] acc: EntryAcc): EntryAcc => match(vs)
  (nil: ChainEnd) => acc
  (l: ChainLink)  => contains(acc.eaSeen, stackVarName(l.value))
    ? alSmEntryLive(l.next, stateName, layout, acc)
    : alSmEntryLive(l.next, stateName, layout,
        EntryAcc(pushAll(acc.eaOps,
                     alLoadVar(l.value, alStateParam(), stateName,
                               layout)),
                 add(acc.eaSeen, stackVarName(l.value))))

fun alSmAssemble(f: CgFunction, allOps: List<Op>, bbs: List<ABlock>,
                 wrapFields)
  # Params become plain locals (the SM's own signature is $state/$completed);
  # block result registers not otherwise declared ($musttail$ret$N) too.
  # Parameters become locals, then any block result register not already
  # declared. Both are ordered — these are struct fields — and `seen` answers
  # only membership, so the pair travels as a builder and a Set.
  let declared = Set(map(cgFieldsOfOrEmpty(f.fnStackVars),
                         (fld) => fld.fieldName))
  let withParams = alSmDeclareParams(chain(cgFieldsOfOrEmpty(f.fnParams)),
                                     DeclAcc(builder(), declared))
  let withResults = alSmDeclareResults(chain(bbs), withParams)
  ret CgFunction(f.fnName + "$async",
                 CgStruct(list2(CgField("$state", CgDataPointer()),
                                CgField("$completed_task", CgDataPointer()))),
                 CgVoid(),
                 # extra_stack = ($sv_discard,) + sm_wrap_fields — discard FIRST
                 # (Python async_lower.py:1343; declaration order is C order).
                 CgStruct(concat(concat(cgFieldsOfOrEmpty(f.fnStackVars),
                                        build(withResults.daFields)),
                                 prepend(CgField("$sv_discard", CgDataPointer()), wrapFields))),
                 cgOpsOf(allOps), f.fnComment, None, false, false, false, false)

class [linear, final] DeclAcc(daFields: ListBuilder<CgField>,
                             daSeen: Set<String>)

fun [tail] alSmDeclareParams(ps: Chain<CgField>,
                             [terminal] acc: DeclAcc) => match(ps)
  (nil: ChainEnd) => acc
  (l: ChainLink)  => contains(acc.daSeen, l.value.fieldName)
    ? alSmDeclareParams(l.next, acc)
    : alSmDeclareParams(l.next,
          DeclAcc(push(acc.daFields, l.value),
                  add(acc.daSeen, l.value.fieldName)))

fun [tail] alSmDeclareResults(bs: Chain<ABlock>,
                              [terminal] acc) => match(bs)
  (nil: ChainEnd) => acc
  (l: ChainLink)  => alSmDeclareResults(l.next,
                                        alSmDeclareResult(acc, l.value))

fun alSmDeclareResult([terminal] acc, bb: ABlock) => match(bb.abResult)
  (reg: RParam) => contains(acc.daSeen, stackVarName(reg))
    ? acc
    : DeclAcc(push(acc.daFields,
                  CgField(stackVarName(reg), rpGetType(reg))),
              add(acc.daSeen, stackVarName(reg)))
  ()             => acc

# Drop Phi sources whose predecessor labels now live in the OTHER function;
# an all-pruned Phi disappears (its target is written elsewhere).
fun alPrunePhiSources(ops: List<Op>)
  let preds = ucPhiEdgesPreds(ops)
  ret build(alPpsLoop(chain(ops), preds, "", builder()))

# Label → the labels that can reach it. A Dict of Sets: the only question ever
# asked of it is "is this phi source one of this block's predecessors", which
# is membership on both levels. The list-of-pairs it replaces answered a lookup
# by allocating a filtered copy of itself, and inserting rebuilt the entire
# list once per edge.
fun ucPhiEdgesPreds(ops: List<Op>) => alBpLoop(chain(ops), None, "", Dict())

# The preceding op is CARRIED rather than re-indexed: alBpFall only ever needs
# ops[i-1], and `prev` is None exactly where the index form tested i == 0.
fun [tail] alBpLoop(os: Chain<Op>, prev: Op|None, cur,
                    acc: Dict<String, Set<String>>) => match(os)
  (nil: ChainEnd) => acc
  (l: ChainLink)  => match(l.value)
    (lb: OpLabel) => alBpLoop(l.next, lb, lb.labelName,
                              alBpFall(prev, cur, lb.labelName, acc))
    (o: Op)       => alBpLoop(l.next, o, cur, alBpJumps(o, cur, acc))

fun alBpFall(prev: Op|None, cur, label: String,
             acc): Dict<String, Set<String>>
  if length(cur) == 0
    ret acc
  ret match(prev)
    (p: Op) => ucPrevFallsIntoLabel(p) ? alBpAdd(acc, label, cur) : acc
    ()      => acc

fun alBpJumps(op, cur,
              acc): Dict<String, Set<String>>
  if length(cur) == 0
    ret acc
  ret match(op)
    (j: OpJump)        => alBpAdd(acc, j.jumpName, cur)
    (ji: OpJumpIf)     => alBpAdd(acc, ji.jumpIfLabel, cur)
    (t2: OpIfTask)     => alBpAdd(acc, t2.taskTarget, cur)
    (sw: OpSwitchJump) => fold(sw.switchCases, acc,
                               (a, cs) =>
                                 alBpAdd(a, cs.caseLabel, cur))
    (o: Op)            => acc

fun alBpAdd(acc: Dict<String, Set<String>>, label: String,
            pred) => put(acc, label,
                         add(alBpOf(acc, label), pred))

fun alBpOf(acc: Dict<String, Set<String>>, label: String) => match(get(acc, label))
  (ps: Set<String>) => ps
  ()                 => Set()

fun [tail] alPpsLoop(os: Chain<Op>, preds: Dict<String, Set<String>>,
                     cur,
                     [terminal] acc: ListBuilder<Op>) => match(os)
  (nil: ChainEnd) => acc
  (l: ChainLink)  => match(l.value)
    (lb: OpLabel) => alPpsLoop(l.next, preds, lb.labelName,
                               push(acc, l.value))
    (ph: OpPhi)   => alPpsLoop(l.next, preds, cur,
                               alPpsPhi(acc, ph, preds, cur))
    (o: Op)       => alPpsLoop(l.next, preds, cur, push(acc, o))

fun alPpsPhi([terminal] acc, ph: OpPhi,
             preds: Dict<String, Set<String>>, cur): ListBuilder<Op>
  if length(cur) == 0
    ret push(acc, ph)
  let blockPreds = alBpOf(preds, cur)
  let kept = filter(ph.phiSources,
                    (s2) => contains(blockPreds,
                                     s2.sourceLabel))
  ret sameLen(chain(kept), chain(ph.phiSources))
    ? push(acc, ph)
    : (isEmpty(kept)
        ? acc
        : push(acc, OpPhi(ph.phiTarget, kept, ph.phiSavedVars)))

# ── per-function orchestrator ────────────────────────────────────────────────

class [final] AlOut(aloFunctions: List<CgFunction>, aloObjects: List<CgObject>)

# The same two lists while they are being ACCUMULATED across every function in
# the program. Both are ordered — they become the app's emission order — and
# merging used to concat the whole collection so far onto each function's small
# contribution, once per function of the program.
class [linear, final] AlAcc(aaFunctions: ListBuilder<CgFunction>,
                            aaObjects: ListBuilder<CgObject>)

fun alAccEmpty() => AlAcc(builder(), builder())

fun alAccBuild(acc: AlAcc) => AlOut(build(acc.aaFunctions),
                                    build(acc.aaObjects))

fun alMergeOne([terminal] acc: AlAcc, out: AlOut)
  ret AlAcc(pushAll(acc.aaFunctions,
                        out.aloFunctions),
            pushAll(acc.aaObjects,
                        out.aloObjects))

fun alConvertFunction(f: CgFunction): AlOut
  if f.fnName == "__entrypoint__" || f.fnBypassAsync
    ret AlOut(list1(f), List())
  let afterTail = alDiscoverTailCalls(f)
  let stateName = f.fnName + "$state"
  let built = alCreateBasicBlocksN(afterTail)
  if !atLeast(chain(built.bs), 2)
    ret AlOut(list1(alSimpleWrap(afterTail)), List())
  ret alConvertMulti(f, afterTail, stateName, built.bs, built.n)

# <2 blocks: only the return type adjusts (SyncWrap promotion when wrapped).
fun alSimpleWrap(f: CgFunction)
  let wrapped = wrapReturnType(f.fnResult)
  ret match(wrapped)
    (w: CgTaskWrapper) => CgFunction(f.fnName, f.fnParams, wrapped, f.fnStackVars,
                                     cgOpsOf(alConvertReturnsHot(cgOpsToList(f.fnOps), wrapped)),
                                     f.fnComment, f.fnForeignSymbol, f.fnSync,
                                     f.fnTail, f.fnBypassAsync, f.fnAlwaysInline,
                                     f.fnSourceFile, f.fnSourceLine)
    (o: CgType)         => CgFunction(f.fnName, f.fnParams, wrapped, f.fnStackVars,
                                     f.fnOps, f.fnComment, f.fnForeignSymbol,
                                     f.fnSync, f.fnTail, f.fnBypassAsync, f.fnAlwaysInline,
                                     f.fnSourceFile, f.fnSourceLine)

fun alConvertMulti(f: CgFunction, afterTail: CgFunction, stateName,
                   bbs: List<ABlock>, nBbs: Int): AlOut
  let subtype = taskSubtypeName(f.fnResult)
  # The SM view (musttail unrolled) defines the authoritative frame layout.
  let smFn = any(afterTail.fnOps, alIsMusttailCall) ? alUnrollMusttail(afterTail) : afterTail
  let smBuilt = any(afterTail.fnOps, alIsMusttailCall)
    ? alCreateBasicBlocksN(smFn)
    : (bbs, nBbs)
  let smBbs = smBuilt.bs
  let layout0 = alComputeFrameLayout(smBbs, bbs, cgOpsToList(alCalculateSavedVars(smFn).fnOps))
  let useStub = !f.fnSync && atLeast(smFn.fnOps, alStubThresholdOps() + 1) && alHasParkingLoop(smFn.fnOps)
  let layout = useStub ? alAugmentLayoutWithParams(layout0, cgFieldsOfOrEmpty(f.fnParams)) : layout0
  let hotFn = useStub
    ? alCreateStubLaunchFunc(afterTail, stateName, subtype, layout, smBuilt.n)
    : alCreateHotPathFunc(afterTail, stateName, subtype, bbs, layout)
  let par = alParMachinery(f, bbs)
  if f.fnSync
    ret AlOut(concat(list1(hotFn), par.aloFunctions), par.aloObjects)
  let stateObj = alCreateStateObject(smFn, stateName, layout)
  let machineFn = alCreateStateMachineFunc(smFn, stateName, subtype, smBbs, layout, useStub)
  ret AlOut(concat(list2(hotFn, machineFn), par.aloFunctions),
            concat(list1(stateObj), par.aloObjects))

fun alIsMusttailCall(op) => match(op)
  (c: OpCall) => c.callMusttail
  (o: Op)     => false

# Jump/JumpIf/Switch to an ALREADY-SEEN label = a loop.
# Stub only when a PARK SITE lies inside a loop (Python has_parking_loop): a
# back edge alone is not enough — a compute-only loop never parks at runtime,
# and stubbing it turns a zero-allocation call into a heap state allocation
# per call. Walk once, recording the park count at each label; a jump back to
# a seen label with parks accrued since is a parking loop. Park ops = exactly
# what the basic-block builder splits on (non-musttail Call, ParallelCall).
fun alHasParkingLoop(ops: Segment<Op>|None) => alHplLoop(ops, 0i32, Dict(), 0)

fun [tail] alHplLoop(s: Segment<Op>|None, i, labelParks,
                     parks) => match(s)
  (nil: None)        => false
  (seg: Segment<Op>) => i >= seg.length
    ? alHplLoop(seg.next, 0i32, labelParks, parks)
    : match(seg.array(i))
        (lb: OpLabel)        => alHplLoop(s, i + 1i32,
                                          put(labelParks, lb.labelName, parks),
                                          parks)
        (c: OpCall)          => alHplLoop(s, i + 1i32, labelParks,
                                          c.callMusttail ? parks : parks + 1)
        (pc: OpParallelCall) => alHplLoop(s, i + 1i32, labelParks, parks + 1)
        (j: OpJump)          => alHplHit(labelParks, j.jumpName, parks)
          ? true : alHplLoop(s, i + 1i32, labelParks, parks)
        (ji: OpJumpIf)       => alHplHit(labelParks, ji.jumpIfLabel, parks)
          ? true : alHplLoop(s, i + 1i32, labelParks, parks)
        (sw: OpSwitchJump)   => any(sw.switchCases, (cs) =>
                                      alHplHit(labelParks, cs.caseLabel, parks))
          ? true : alHplLoop(s, i + 1i32, labelParks, parks)
        (o: Op)              => alHplLoop(s, i + 1i32, labelParks, parks)

fun alHplHit(labelParks: Dict<String, Int>, name: String, parks) => match(get(labelParks, name))
  (atLabel: Int) => parks > atLabel
  ()              => false

# ── parallel machinery ───────────────────────────────────────────────────────

fun alParMachinery(f: CgFunction, bbs: List<ABlock>)
  ret alAccBuild(alPmLoop(chain(alNonTerminal(bbs)), f, 0, alAccEmpty()))

fun [tail] alPmLoop(bs: Chain<ABlock>, f: CgFunction, i,
                    [terminal] acc: AlAcc) => match(bs)
  (nil: ChainEnd) => acc
  (l: ChainLink)  => alPmLoop(l.next, f, i + 1, alPmOne(l.value, f, i, acc))

fun alPmOne(bb: ABlock, f: CgFunction, i: Int, [terminal] acc): AlAcc
  ret match(lastOp(chain(bb.abOps)))
    (op: Op) => match(op)
      (pc: OpParallelCall) => alPmSite(pc, f, i, acc)
      (o: Op)               => acc
    ()        => acc

fun alPmSite(pc: OpParallelCall, f: CgFunction, i: Int,
             [terminal] acc: AlAcc)
  let parTaskName = "task$par$" + String(i) + "$" + f.fnName
  let resTypes = map(pc.parResults, rpGetType)
  let obj = alParTaskObject(parTaskName, resTypes)
  ret alPmSlots(chain(resTypes), chain(pc.parCalls), f, i, parTaskName, 0,
                AlAcc(acc.aaFunctions, push(acc.aaObjects, obj)))

# The result types and the call refs are walked in lockstep — one slot per
# pair, as many slots as the ParallelCall has (the two are equal by
# construction: resTypes IS map(pc.parResults, rpGetType)).
fun [tail] alPmSlots(ts: Chain<CgType>, cs: Chain<RParam>, f: CgFunction, site: Int,
                     parTaskName, k,
                     [terminal] acc: AlAcc) => match(ts)
  (nil: ChainEnd) => acc
  (lt: ChainLink) => match(cs)
    (lc: ChainLink)  => alPmSlots(lt.next, lc.next, f, site, parTaskName, k + 1,
                          alPmSlot(lt.value, lc.value, f, site, parTaskName, k, acc))
    (nil2: ChainEnd) => acc

fun alPmSlot(rt, callRef, f: CgFunction, site: Int,
             parTaskName, k: Int, [terminal] acc: AlAcc)
  let cb = alSlotCallback(f.fnName, site, k, parTaskName, rt)
  let launcher = alLauncherCallback(f.fnName, site, k, parTaskName,
                                    alLambdaNameOf(callRef, k), rt)
  ret AlAcc(push(push(acc.aaFunctions, cb), launcher),
            acc.aaObjects)

fun alLambdaNameOf(callRef, k: Int) => match(callRef)
  (gf: RpGlobalFunction) => gf.name
  (o: RParam)             => "__unknown_" + String(k) + "__"

# par_task: task_t prefix + remaining + closure_k + result_k.
fun alParTaskObject(parTaskName, resultTypes: List<CgType>): CgObject
  # Field order IS struct layout: the task_t prefix, `remaining`, one closure
  # slot per parallel call, then one result slot per call — one builder end to
  # end, so no stage rebuilds what the previous one produced.
  let fields0 = push(
      builderFrom(taskFields()),
      CgField("remaining", CgInt(32)))
  let fields1 = alPtoClosuresB(fields0, chain(resultTypes), 0)
  let fields2 = alPtoResults(fields1, chain(resultTypes), 0, 0)
  ret CgObject(parTaskName, list1("task"), List(),
               CgImmediateStruct(fields2.fs),
               None, "parallel join task with " + String(fields2.n) + " slots",
               false, true, 0)

fun [tail] alPtoClosuresB([terminal] acc, ts: Chain<CgType>, k: Int): ListBuilder<CgField>
  ret match(ts)
    (nil: ChainEnd) => acc
    (l: ChainLink)  => alPtoClosuresB(push(acc, CgField("closure_" + String(k), CgDataPointer())), l.next, k + 1)

fun [tail] alPtoResults([terminal] acc: ListBuilder<CgField>, ts: Chain<CgType>,
                        k, n): (fs: List<CgField>, n: Int) => match(ts)
  (nil: ChainEnd) => (build(acc), n)
  (l: ChainLink)  => alPtoResults(push(acc,
                                      CgField("result_" + String(k),
                                              l.value)),
                                  l.next, k + 1, n + 1)

# Slot callback: result_k = extract(completed sub-task) + task_par_decrement.
fun alSlotCallback(fnName, site: Int, slot: Int, parTaskName,
                   resultType): CgFunction
  let svPar = RpStackVar(CgDataPointer(), "$par_task")
  let svSub = RpStackVar(CgDataPointer(), "$completed_sub_task")
  let svDiscardCb = RpStackVar(CgDataPointer(), "$sv_discard_cb")
  let extract = match(taskSubtypeName(resultType))
    (st: String) => alIsVoid(resultType)
      ? List<Op>()
      : list1(OpMove(RpObjectField(resultType, svPar, parTaskName, "result_" + String(slot), None, false),
                     RpObjectField(resultType, svSub, st, "result", None, false),
                     false, List()))
    ()            => List<Op>()
  let ops = concat(extract, list2(
      alRuntimeDiscard(svDiscardCb, "task_par_decrement", list1(RpNamedValue("par_task", svPar))),
      OpReturn(RpNullPointer(), List())))
  ret CgFunction(fnName + "$par$" + String(site) + "$slot$" + String(slot),
                 CgStruct(list2(CgField("$par_task", CgDataPointer()),
                                CgField("$completed_sub_task", CgDataPointer()))),
                 CgDataPointer(),
                 CgStruct(list1(CgField("$sv_discard_cb", CgDataPointer()))),
                 cgOpsOf(ops), "", None, false, false, false, false)

# Launcher: read closure_k, call the lambda; sync → write result + decrement;
# async → register the slot callback on the returned task.
fun alLauncherCallback(fnName, site: Int, slot: Int, parTaskName,
                       lambdaName, resultType): CgFunction
  let svPar = RpStackVar(CgDataPointer(), "$par_task")
  let svClosure = RpStackVar(CgDataPointer(), "$launcher_closure")
  let wrappedType = wrapReturnType(resultType)
  let needsTemp = !eqCgType(wrappedType, resultType)
  let svResultW = RpStackVar(wrappedType, "$result_w")
  let svDiscardCb = RpStackVar(CgDataPointer(), "$sv_discard_cb")
  let unwrapped = needsTemp ? RpStructField(svResultW, "value") : svResultW
  let slotCb = RpGlobalFunction(fnName + "$par$" + String(site) + "$slot$" + String(slot),
                                svPar, false, None, false, false)
  let untag = RpRuntimeInvoke("TASK_UNTAG",
                              RpNewStruct(list1(RpNamedValue("p", taskPtrFrom(svResultW, wrappedType)))),
                              CgDataPointer())
  let ops = concat(concat(list5(
      OpMove(svClosure, RpObjectField(CgDataPointer(), svPar, parTaskName, "closure_" + String(slot), None, false),
             false, List()),
      OpCall(RpGlobalFunction(lambdaName, svClosure, false, None, false, false),
             RpNewStruct(List()), svResultW, false, false, None, List()),
      OpJumpIf("$launcher_async",
               RpRuntimeInvoke("UNLIKELY",
                               RpNewStruct(list1(RpNamedValue("x", isTaskParam(svResultW, wrappedType)))),
                               CgInt(32)), false, List()),
      OpMove(RpObjectField(resultType, svPar, parTaskName, "result_" + String(slot), None, false),
             unwrapped, false, List()),
      alRuntimeDiscard(svDiscardCb, "task_par_decrement", list1(RpNamedValue("par_task", svPar)))),
    list3(
      OpJump("$launcher_done", List()),
      OpLabel("$launcher_async", List()),
      alRuntimeDiscard(svDiscardCb, "task_on_complete",
                       list2(RpNamedValue("task", untag), RpNamedValue("cb", slotCb))))),
    list2(OpLabel("$launcher_done", List()),
          OpReturn(RpNullPointer(), List())))
  ret CgFunction(fnName + "$par$" + String(site) + "$launcher$" + String(slot),
                 CgStruct(list2(CgField("$par_task", CgDataPointer()),
                                CgField("$launched_task", CgDataPointer()))),
                 CgDataPointer(),
                 CgStruct(list3(CgField("$launcher_closure", CgDataPointer()),
                                CgField("$result_w", wrappedType),
                                CgField("$sv_discard_cb", CgDataPointer()))),
                 cgOpsOf(ops), "", None, false, false, false, false)

# ── task-subtype collection ──────────────────────────────────────────────────

# One subtype per distinct non-Void return type + the foreign task object.
# The DRIVER unions these with app objects LETTING APP WIN — lazy_thunks
# pre-registers subtypes under the same names; never flip the union.
# One subtype per distinct name, in first-seen order, with the foreign task
# object last. The names are tracked in a Set: the old shape asked "have I
# made this one already" by scanning every subtype collected so far, once per
# function of the whole program.
class [linear, final] CtsAcc(ctObjs: ListBuilder<CgObject>,
                             ctSeen: Set<String>)

fun collectTaskSubtypes(a: CgApp)
  let subs = alCtsLoop(chain(appFunctions(a)),
                       CtsAcc(builder(), Set()))
  ret build(push(subs.ctObjs, makeTaskForeignObject()))

fun [tail] alCtsLoop(fs: Chain<CgFunction>,
                     [terminal] acc) => match(fs)
  (nil: ChainEnd) => acc
  (l: ChainLink)  => alCtsLoop(l.next, alCtsOne(acc, l.value))

fun alCtsOne([terminal] acc, f: CgFunction)
  if alIsVoid(f.fnResult)
    ret acc
  ret match(taskSubtypeName(f.fnResult))
    (name: String) => contains(acc.ctSeen, name)
      ? acc
      : CtsAcc(push(acc.ctObjs,
                   makeTaskSubtypeObject(name, alCtsInner(f.fnResult))),
               add(acc.ctSeen, name))
    ()              => acc

fun alCtsInner(t2) => match(t2)
  (w: CgTaskWrapper) => w.inner
  (o: CgType)         => t2

# ── __parallel__ backpressure outlining ──────────────────────────────────────

# Each well-formed ParallelCall (register present, every call a
# GlobalFunction) is replaced by a call to a synthesised fn$par_site$<opidx>
# helper: sequential arm when the pool is saturated, the original
# ParallelCall otherwise — same tuple either way.
fun alOutlineParallelSites(f)
  if !any(f.fnOps, alOpIsParallel)
    ret AlOut2(f, List())
  ret alOpsLoop(f.fnOps, 0i32, f, 0,
                OpsAcc(seqBuilder(), builder()))

class [final] AlOut2(alo2Fn: CgFunction, alo2Helpers: List<CgFunction>)

fun alOpIsParallel(op) => match(op)
  (pc: OpParallelCall) => true
  (o: Op)               => false

# Two ordered outputs: the rewritten op stream, and the outlined helper
# functions in the order their sites appear.
class [linear, final] OpsAcc(oaOps: SeqBuilder<Op>,
                             oaHelpers: ListBuilder<CgFunction>)

fun [tail] alOpsLoop(s: Segment<Op>|None, iSeg, f: CgFunction, i,
                     [terminal] acc: OpsAcc) => match(s)
  (nil: None)        => AlOut2(cgFunctionWith(f, build(acc.oaOps),
                                           f.fnStackVars),
                            build(acc.oaHelpers))
  (seg: Segment<Op>) => iSeg >= seg.length
    ? alOpsLoop(seg.next, 0i32, f, i, acc)
    : match(alOutlineOne(seg.array(iSeg), f, i))
        (o2: OutlineOne) => alOpsLoop(s, iSeg + 1i32, f, i + 1,
                                OpsAcc(push(acc.oaOps, o2.ooSiteCall),
                                       push(acc.oaHelpers,
                                            o2.ooHelper)))
        ()                => alOpsLoop(s, iSeg + 1i32, f, i + 1,
                                OpsAcc(push(acc.oaOps, seg.array(iSeg)),
                                       acc.oaHelpers))

class [final] OutlineOne(ooSiteCall: Op, ooHelper: CgFunction)

fun alOutlineOne(op, f: CgFunction, opIndex: Int) => match(op)
  (pc: OpParallelCall) => alWellFormedPc(pc) ? alBuildOutline(pc, f, opIndex) : None
  (o: Op)               => None

fun alWellFormedPc(pc: OpParallelCall)
  ret !isNoneR(pc.parRegister) && !any(pc.parCalls, (c) => !alIsGlobalFn(c))

fun isNoneR(r: RParam|None) => match(r)
  (x: RParam) => false
  ()           => true

fun alIsGlobalFn(c) => match(c)
  (gf: RpGlobalFunction) => true
  (o: RParam)             => false

fun alBuildOutline(pc: OpParallelCall, f: CgFunction, opIndex: Int): OutlineOne
  let helperName = f.fnName + "$par_site$" + String(opIndex)
  let closureParams = alCpList(chain(pc.parCalls), 0, List())
  let helperCalls = alHcList(chain(pc.parCalls), chain(closureParams), List())
  let svAccepting = RpStackVar(CgInt(32), "$accepting")
  let register = alForceRegister(pc.parRegister)
  let seqCalls = alSeqCalls(chain(helperCalls), chain(pc.parResults), List())
  # The helper's body in emission order: the backpressure test, the sequential
  # fallback calls, the tuple build, then the fork path.
  let ho0 = builderFrom<Op>(list2(
      OpMove(svAccepting, RpRuntimeInvoke("thread_work_accepting",
                                          RpNewStruct(List()), CgInt(32)),
             false, List()),
      OpJumpIf("$fork", svAccepting, false, List())))
  let ho1 = push(pushAll(ho0, seqCalls),
      OpMove(register, RpNewStruct(alTupleFields(chain(pc.parResults), 0, List())),
             false, List()))
  let helperOps = build(pushAll(ho1, 
      list4(OpReturn(register, List()),
            OpLabel("$fork", List()),
            OpParallelCall(helperCalls, pc.parResults, pc.parRegister, List()),
            OpReturn(register, List()))))
  let helperParams = concat(list1(CgField("$unused_self", CgDataPointer())),
                            map(closureParams, (p) => CgField(stackVarName(p), CgDataPointer())))
  # Stack layout: the per-call results, the tuple register, then $accepting.
  let helperStack = build(push(push(
      builderFrom(map(pc.parResults,
                      (r) => CgField(stackVarName(r),
                                     rpGetType(r)))),
      CgField(stackVarName(register), rpGetType(register))),
      CgField("$accepting", CgInt(32))))
  let helper = CgFunction(helperName, CgStruct(helperParams), rpGetType(register),
                          CgStruct(helperStack), cgOpsOf(helperOps),
                          "__parallel__ backpressure dispatch for " + f.fnName + " site " + String(opIndex),
                          None, false, false, false, false)
  let siteCall = OpCall(RpGlobalFunction(helperName, None, false, None, false, false),
                        RpNewStruct(alSiteArgs(chain(pc.parCalls), 0, List())),
                        pc.parRegister, false, false, None, List())
  ret OutlineOne(siteCall, helper)

fun alForceRegister(r: RParam|None) => match(r)
  (x: RParam) => x
  ()           => RpNullPointer()   # unreachable: well-formedness checked

fun alCpList(ps: Chain<RParam>, k, acc: List<RParam>) => build(alCpListB(ps, k, builderFrom(acc)))

fun [tail] alCpListB(ps: Chain<RParam>, k, [terminal] acc): ListBuilder<RParam> => match(ps)
  (nil: ChainEnd) => acc
  (l: ChainLink)  => alCpListB(l.next, k + 1, push(acc, RpStackVar(CgDataPointer(), "$c" + String(k))))

fun alHcList(calls, cps, acc: List<RParam>): List<RParam>
  ret build(alHcListB(calls, cps, builderFrom(acc)))

fun [tail] alHcListB(calls: Chain<RParam>, cps: Chain<RParam>, [terminal] acc: ListBuilder<RParam>)
  ret match(calls)
    (nil: ChainEnd) => acc
    (lc: ChainLink) => match(cps)
      (lp: ChainLink)  => alHcListB(lc.next, lp.next,
                                   push(acc, alRebindObject(lc.value, lp.value)))
      (nil2: ChainEnd) => acc

fun alRebindObject(c, obj) => match(c)
  (gf: RpGlobalFunction) => RpGlobalFunction(gf.name, obj, gf.external, gf.cSymbol, gf.impure, gf.sync)
  (o: RParam)             => c

fun alSeqCalls(calls, results, acc: List<Op>): List<Op>
  ret build(alSeqCallsB(calls, results, builderFrom(acc)))

fun [tail] alSeqCallsB(calls: Chain<RParam>, results: Chain<RParam>, [terminal] acc: ListBuilder<Op>)
  ret match(calls)
    (nil: ChainEnd) => acc
    (lc: ChainLink) => match(results)
      (lr: ChainLink)  => alSeqCallsB(lc.next, lr.next,
                            push(acc, OpCall(lc.value, RpNewStruct(List()),
                                          lr.value, false, false, None, List())))
      (nil2: ChainEnd) => acc

fun alTupleFields(rs, k: Int, acc: List<RpNamedValue>): List<RpNamedValue>
  ret build(alTupleFieldsB(rs, k, builderFrom(acc)))

fun [tail] alTupleFieldsB(rs: Chain<RParam>, k, [terminal] acc: ListBuilder<RpNamedValue>)
  ret match(rs)
    (nil: ChainEnd) => acc
    (l: ChainLink)  => alTupleFieldsB(l.next, k + 1,
                         push(acc, RpNamedValue("_" + String(k), l.value)))

fun alSiteArgs(calls, k: Int, acc: List<RpNamedValue>): List<RpNamedValue>
  ret build(alSiteArgsB(calls, k, builderFrom(acc)))

fun [tail] alSiteArgsB(calls: Chain<RParam>, k, [terminal] acc: ListBuilder<RpNamedValue>)
  ret match(calls)
    (nil: ChainEnd) => acc
    (l: ChainLink)  => alSiteArgsB(l.next, k + 1,
                         push(acc, RpNamedValue("$c" + String(k), alClosureOf(l.value))))

# ── zero-init repair for state-saves ─────────────────────────────────────────

# Aggressive IR inlining (-O3) can place a suspension inside a loop whose body
# defines a live range crossing the back-edge: the state-save at the suspension
# then reads the variable BEFORE any write on the first-iteration path (it
# holds a real value only from iteration two). The value saved on that first
# pass is never consumed — but saving indeterminate memory is still wrong, and
# uninit_check rightly rejects it. Zero-init exactly those variables at entry
# so every save stores a DEFINED value. Only STATE-SAVE Moves are repaired —
# a general repair would mask the real read-before-write bugs the checker
# exists for.
fun alZeroInitUnwrittenSaves(f: CgFunction): CgFunction
  let entry = ucComputeEntrySets(f)
  let offenders = alZiusLoop(f.fnOps, 0i32, 0, entry, List())
  if isEmpty(offenders)
    ret f
  let inits = map<RParam, Op>(svSortedByName(offenders), (v) =>
        OpMove(v, alZeroVal(rpGetType(v)), false, List()))
  ret cgFunctionWith(f, build(pushAll(pushAll(seqBuilder(),
                                                  inits),
                                      f.fnOps)),
                     f.fnStackVars)

fun [tail] alZiusLoop(s: Segment<Op>|None, iSeg, i, entry: Dict<Int, InitSet>,
                      acc) => match(s)
  (nil: None)        => acc
  (seg: Segment<Op>) => iSeg < seg.length
    ? alZiusLoop(s, iSeg + 1i32, i + 1, entry,
                 alZiusStep(seg.array(iSeg), ucEntryAt(entry, i), acc))
    : alZiusLoop(seg.next, 0i32, i, entry, acc)

fun alZiusStep(op, e, acc) => match(e)
  (u: IsUnreached) => acc
  (s2: IsSet)      => match(op)
    (m: OpMove) => alZiusMove(m, s2.isNames, acc)
    (o: Op)     => acc

# The Python guard chain: Move target is ObjectField on the `$state` StackVar,
# source is a StackVar missing from the entry set.
fun alZiusMove(m: OpMove, names: Set<String>, acc) => match(m.moveTarget)
  (tf: RpObjectField) => alZiusStateField(tf) ? alZiusSource(m.moveSource, names, acc) : acc
  (o: RParam)          => acc

fun alZiusStateField(tf: RpObjectField) => match(tf.pointer)
  (p: RpStackVar) => p.name == "$state"
  (o: RParam)     => false

# Entry sets key by name|type (ucKey) — membership must use the same key.
fun alZiusSource(src, names: Set<String>, acc) => match(src)
  (v: RpStackVar) => contains(names, ucKey(src)) ? acc : svSetAdd(acc, src)
  (o: RParam)     => acc

# ── the driver ───────────────────────────────────────────────────────────────

fun lowerAsync(a: CgApp)
  # Outline first, so the helpers are converted by the same pass below.
  let outlined = alOutlineAll(chain(appFunctions(a)),
                              OutAcc(builder(),
                                     builder()))
  let all = concat(build(outlined.otFns),
                   build(outlined.otHelpers))
  let converted = alAccBuild(alConvertAll(chain(all), alAccEmpty()))
  let repaired = map(converted.aloFunctions, alZeroInitUnwrittenSaves)
  let withObjs = fold(converted.aloObjects,
                      appOf(repaired, appObjects(a), appGlobals(a)),
                      appPutObject)
  # Subtypes union: APP WINS on collisions (lazy_thunks pre-registrations).
  ret fold(collectTaskSubtypes(withObjs), withObjs, alPutIfAbsent)

# The functions in app order, and every outlined helper after them — both
# ordered, because they become the app's emission order.
class [linear, final] OutAcc(otFns: ListBuilder<CgFunction>,
                             otHelpers: ListBuilder<CgFunction>)

fun [tail] alOutlineAll(fs: Chain<CgFunction>,
                        [terminal] acc: OutAcc) => match(fs)
  (nil: ChainEnd) => acc
  (l: ChainLink)  => alOutlineAll(l.next, alOutlineStep(acc, l.value))

fun alOutlineStep([terminal] acc: OutAcc, f)
  if f.fnBypassAsync || f.fnName == "__entrypoint__"
    ret OutAcc(push(acc.otFns, f), acc.otHelpers)
  let out = alOutlineParallelSites(f)
  ret OutAcc(push(acc.otFns, out.alo2Fn),
             pushAll(acc.otHelpers,
                         out.alo2Helpers))

fun [tail] alConvertAll(fs: Chain<CgFunction>,
                        [terminal] acc: AlAcc) => match(fs)
  (nil: ChainEnd) => acc
  (l: ChainLink)  => alConvertAll(l.next,
                                  alMergeOne(acc, alConvertFunction(l.value)))

fun alPutIfAbsent(a, o) => appHasObject(a, o.objName) ? a : appPutObject(a, o)
