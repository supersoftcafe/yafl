# bootstrap/async_lower.yafl — task lowering, ported from
# lowering/async_lower.py (1,827 lines; read in full — the ledger carries the
# per-mechanism map). Each function with non-tail calls becomes: a HOT PATH
# (original name; UNLIKELY(IS_TASK) after every non-tail call; one shared
# $asynccommon cold tail that saves live locals to a heap state object,
# creates the task, registers fn$async and returns the tagged task) and, for
# non-sync functions, a STATE MACHINE fn$async($state, $completed_task)
# dispatching on $state->idx — running on ordinary C locals, touching state
# fields only at the two suspension boundaries. Oversized looping bodies take
# the STUB launch instead of a duplicated hot path. __parallel__ sites are
# first OUTLINED behind the runtime backpressure choice.
namespace Bootstrap::Lower::Ir

import System

import Bootstrap::Ast

import Bootstrap::Codegen
import Bootstrap::Frontend
import Bootstrap::Ir
import Bootstrap::Parse
import Bootstrap::StdlibCandidates
import Bootstrap::Types



# ── module scratch vars (hot path shares ONE set; the SM allocates per-site
#    $sv_par_sm$i / $sv_launcher_sm$i) ────────────────────────────────────────

fun alSvState(): RParam
  ret RpStackVar(CgDataPointer(), "$sv_state")

fun alSvTask(): RParam
  ret RpStackVar(CgDataPointer(), "$sv_task")

fun alSvDiscard(): RParam
  ret RpStackVar(CgDataPointer(), "$sv_discard")

fun alSvCallId(): RParam
  ret RpStackVar(CgInt(32), "$sv_call_id")

fun alSvAsyncTask(): RParam
  ret RpStackVar(CgDataPointer(), "$sv_async_task")

fun alSvParTask(): RParam
  ret RpStackVar(CgDataPointer(), "$sv_par_task")

fun alSvLauncher(): RParam
  ret RpStackVar(CgDataPointer(), "$sv_launcher")

fun alStateParam(): RParam
  ret RpStackVar(CgDataPointer(), "$state")

fun alCompletedParam(): RParam
  ret RpStackVar(CgDataPointer(), "$completed_task")

# ── return conversion ────────────────────────────────────────────────────────

# SM: Return → [store value into my_task's subtype result field] +
# task_complete + ReturnVoid; ReturnVoid → task_complete + ReturnVoid.
fun alConvertReturnsSm(ops: List<Op>, myTaskField: RParam, fnResult: CgType,
                       subtype: String|None): List<Op>
  ret fold(ops, List<Op>(), (acc: List<Op>, op: Op) => alConvertReturnSmOne(acc, op, myTaskField, fnResult, subtype))

fun alConvertReturnSmOne(acc: List<Op>, op: Op, myTaskField: RParam,
                         fnResult: CgType, subtype: String|None): List<Op>
  ret match(op)
    (r: OpReturn)      => concat(acc, alSmReturn(r, myTaskField, fnResult, subtype))
    (rv: OpReturnVoid) => concat(acc, alSmComplete(myTaskField))
    (o: Op)            => append(acc, op)

fun alSmReturn(r: OpReturn, myTaskField: RParam, fnResult: CgType,
               subtype: String|None): List<Op>
  ret match(subtype)
    (st: String) => alIsVoid(fnResult)
      ? alSmComplete(myTaskField)
      : concat(list1(OpMove(RpObjectField(fnResult, myTaskField, st, "result", None, false),
                            r.returnValue, false, List<RParam>())),
               alSmComplete(myTaskField))
    ()            => alSmComplete(myTaskField)

fun alSmComplete(myTaskField: RParam): List<Op>
  ret list2(OpMove(alSvDiscard(),
                   RpRuntimeInvoke("task_complete",
                                   RpNewStruct(list1(RpNamedValue("self", myTaskField))),
                                   CgDataPointer()),
                   true, List<RParam>()),
            OpReturnVoid(List<RParam>()))

fun alIsVoid(t2: CgType): Bool
  ret match(t2)
    (v: CgVoid) => true
    (o: CgType) => false

# Hot path: only when the return type was TaskWrapper-promoted — SyncWrap
# each Return (unless the value is already wrapped-shaped: hand-built
# async-pending returns interoperate), and align musttail result_types.
fun alConvertReturnsHot(ops: List<Op>, wrappedResult: CgType): List<Op>
  ret match(wrappedResult)
    (w: CgTaskWrapper) => map(ops, (op: Op) => alHotReturnOne(op, wrappedResult))
    (o: CgType)         => ops

fun alHotReturnOne(op: Op, wrapped: CgType): Op
  ret match(op)
    (r: OpReturn) => eqCgType(rpGetType(r.returnValue), wrapped)
      ? op
      : OpReturn(RpSyncWrap(r.returnValue, wrapped), r.returnSavedVars)
    (c: OpCall)   => c.callMusttail
      ? OpCall(c.callFunction, c.callParameters, c.callRegister, true, c.callImpure,
               wrapped, c.callSavedVars)
      : op
    (o: Op)       => op

# ── per-pattern emit helpers ─────────────────────────────────────────────────

fun alRuntimeDiscard(sv: RParam, name: String, args: List<RpNamedValue>): Op
  ret OpMove(sv, RpRuntimeInvoke(name, RpNewStruct(args), CgDataPointer()),
             true, List<RParam>())

# par_task alloc + init + remaining + per-slot closures.
# nClosures is CARRIED from the walk that built `closures` — the par-join
# countdown is genuine runtime data, never a recalculated length.
fun alEmitParTaskSetup(parTaskVar: RParam, parTaskName: String,
                       closures: List<RParam>, nClosures: Int): List<Op>
  let setup = list3(OpNewObject(parTaskName, parTaskVar, None, List<RParam>()),
                    alRuntimeDiscard(alSvDiscard(), "task_init",
                                     list1(RpNamedValue("task", parTaskVar))),
                    OpMove(RpObjectField(CgInt(32), parTaskVar, parTaskName, "remaining", None, false),
                           RpInteger(nClosures, 32), false, List<RParam>()))
  ret concat(setup, alClosureStores(chain(closures), parTaskVar, parTaskName, 0, List<Op>()))

fun alClosureStores(cs: Chain<RParam>, parTaskVar: RParam, parTaskName: String,
                           k: Int, acc: List<Op>): List<Op>
  ret build<Op >(alClosureStoresB(cs, parTaskVar, parTaskName, k, _pushChain<Op >(builder<Op >(), chain<Op >(acc))))

fun [tail] alClosureStoresB(cs: Chain<RParam>, parTaskVar: RParam, parTaskName: String,
                           k: Int, [terminal] acc: ListBuilder<Op >): ListBuilder<Op >
  ret match(cs)
    (nil: ChainEnd) => acc
    (l: ChainLink)  => alClosureStoresB(l.next, parTaskVar, parTaskName, k + 1,
        push<Op >(acc, OpMove(RpObjectField(CgDataPointer(), parTaskVar, parTaskName,
                                         "closure_" + String(k), None, false),
                           l.value, false, List<RParam>())))

# One launcher task wired to fire slot K's lambda on a worker thread.
fun alEmitPostLauncher(launcherVar: RParam, parTaskVar: RParam,
                       fnName: String, callSite: Int, slot: Int): List<Op>
  let launcherCb = RpGlobalFunction(fnName + "$par$" + String(callSite) + "$launcher$" + String(slot),
                                    parTaskVar, false, None, false, false)
  ret list3(OpMove(launcherVar,
                   RpRuntimeInvoke("task_create",
                                   RpNewStruct(list1(RpNamedValue("self", RpNullPointer()))),
                                   CgDataPointer()), false, List<RParam>()),
            alRuntimeDiscard(alSvDiscard(), "task_on_complete",
                             list2(RpNamedValue("task", launcherVar),
                                   RpNamedValue("cb", launcherCb))),
            alRuntimeDiscard(alSvDiscard(), "thread_work_post_parallel",
                             list1(RpNamedValue("task", launcherVar))))

# Task alloc: None → base task_t via task_create; task_obj → task_obj_create;
# else NewObject + task_init.
fun alEmitTaskAlloc(svTask: RParam, subtype: String|None): List<Op>
  ret match(subtype)
    (st: String) => st == "task_obj"
      ? list1(OpMove(svTask,
                     RpRuntimeInvoke("task_obj_create",
                                     RpNewStruct(list1(RpNamedValue("self", RpNullPointer()))),
                                     CgDataPointer()), false, List<RParam>()))
      : list2(OpNewObject(st, svTask, None, List<RParam>()),
              alRuntimeDiscard(alSvDiscard(), "task_init",
                               list1(RpNamedValue("task", svTask))))
    ()            => list1(OpMove(svTask,
                     RpRuntimeInvoke("task_create",
                                     RpNewStruct(list1(RpNamedValue("self", RpNullPointer()))),
                                     CgDataPointer()), false, List<RParam>()))

# SM cold-block tail: write idx, register fn$async on the in-flight task
# (already a clean task_t pointer), return.
fun alEmitSuspendToAsync(idxField: RParam, idx: Int, untaggedTask: RParam,
                         fnName: String): List<Op>
  let callback = RpGlobalFunction(fnName + "$async", alStateParam(), false, None, false, false)
  ret list3(OpMove(idxField, RpInteger(idx, 32), false, List<RParam>()),
            alRuntimeDiscard(alSvDiscard(), "task_on_complete",
                             list2(RpNamedValue("task", untaggedTask),
                                   RpNamedValue("cb", callback))),
            OpReturnVoid(List<RParam>()))

# ── tail-call detection ──────────────────────────────────────────────────────

# Call(register=R); Return(R) with R's type == fn.result → musttail (register
# cleared, result_type set); void Call; ReturnVoid → musttail. Codegen emits
# `return foo(...)` which clang TCOs even at -O0.
fun alDiscoverTailCalls(f: CgFunction): CgFunction
  if !atLeast(chain(f.fnOps), 2)
    ret f
  ret cgFunctionWith(f, alTailScan(chain(f.fnOps), f.fnResult, List<Op>()), f.fnStackVars)

fun alTailScan(os: Chain<Op>, fnResult: CgType, acc: List<Op>): List<Op>
  ret build<Op >(alTailScanB(os, fnResult, _pushChain<Op >(builder<Op >(), chain<Op >(acc))))

fun [tail] alTailScanB(os: Chain<Op>, fnResult: CgType, [terminal] acc: ListBuilder<Op >): ListBuilder<Op >
  ret match(os)
    (nil: ChainEnd) => acc
    (l: ChainLink)  => match(l.next)
      (nil2: ChainEnd) => push<Op >(acc, l.value)
      (n: ChainLink)   => match(alTailPattern(l.value, n.value, fnResult))
        (t2: Op) => alTailScanB(n.next, fnResult, push<Op >(acc, t2))
        ()       => alTailScanB(l.next, fnResult, push<Op >(acc, l.value))

fun alTailPattern(op: Op, nxt: Op, fnResult: CgType): Op|None
  ret match(op)
    (c: OpCall) => c.callMusttail ? None : alTailPatternCall(c, nxt, fnResult)
    (o: Op)     => None

fun alTailPatternCall(c: OpCall, nxt: Op, fnResult: CgType): Op|None
  ret match(c.callRegister)
    (reg: RParam) => alTailValued(c, reg, nxt, fnResult)
    ()             => alTailVoid(c, nxt, fnResult)

fun alTailValued(c: OpCall, reg: RParam, nxt: Op, fnResult: CgType): Op|None
  ret match(nxt)
    (r: OpReturn) => match(r.returnValue)
      (sv: RpStackVar) => alRegNamed(reg, sv.name) && eqCgType(rpGetType(reg), fnResult)
        ? OpCall(c.callFunction, c.callParameters, None, true, c.callImpure,
                 rpGetType(reg), c.callSavedVars)
        : None
      (o: RParam)       => None
    (o2: Op)       => None

fun alRegNamed(reg: RParam, name: String): Bool
  ret match(reg)
    (sv: RpStackVar) => sv.name == name
    (o: RParam)       => false

fun alTailVoid(c: OpCall, nxt: Op, fnResult: CgType): Op|None
  if !alResultTypeVoidish(c.callResultType) || !alIsVoid(fnResult)
    ret None
  ret match(nxt)
    (rv: OpReturnVoid) => OpCall(c.callFunction, c.callParameters, None, true,
                                 c.callImpure, c.callResultType, c.callSavedVars)
    (o: Op)             => None

fun alResultTypeVoidish(t2: CgType|None): Bool
  ret match(t2)
    (x: CgType) => alIsVoid(x)
    ()           => true

# ── StackVar sets (keyed by name; SSA names are unique per function) ─────────

fun svSetAdd(acc: List<RParam>, v: RParam): List<RParam>
  ret alSvMember(acc, v) ? acc : append(acc, v)

fun alSvMember(acc: List<RParam>, v: RParam): Bool
  ret any(acc, (x: RParam) => stackVarName(x) == stackVarName(v))

fun svSetUnion(a: List<RParam>, b: List<RParam>): List<RParam>
  ret fold(b, a, svSetAdd)

fun svSetSub(a: List<RParam>, b: List<RParam>): List<RParam>
  ret filter(a, (x: RParam) => !alSvMember(b, x))

fun svSetEq(a: List<RParam>, b: List<RParam>): Bool
  ret sameLen(chain(a), chain(b)) && !any(a, (x: RParam) => !alSvMember(b, x))

fun svSortedByName(a: List<RParam>): List<RParam>
  ret map(sort<String>(map(a, stackVarName)),
          (n: String) => alSvNamed(a, n))

fun alSvNamed(a: List<RParam>, n: String): RParam
  ret match(head(filter(a, (x: RParam) => stackVarName(x) == n)))
    (x: RParam) => x
    ()           => RpNullPointer()   # unreachable: name came from the same list

# ── liveness: __calculate_saved_vars ─────────────────────────────────────────

# Per-op reads/writes with the Phi rule: a Phi reads NOTHING unconditionally
# (each source is consumed on its predecessor edge only — added per-edge via
# alPhiSourcesInto) and writes its target.
fun alReadsOf(op: Op): List<RParam>
  ret match(op)
    (ph: OpPhi) => List<RParam>()
    (o: Op)     => opReadStackVars(op)

fun alWritesOf(op: Op): List<RParam>
  ret fold(ssavOpWrites(op), List<RParam>(), rpTakeStackVar)

fun alCalculateSavedVars(f: CgFunction): CgFunction
  ret cgFunctionWith(f, alLivenessIterate(f.fnOps, alInvariants(f.fnOps)),
                     f.fnStackVars)

# The label index and the enclosing block label per op: fixed across
# generations, so built ONCE rather than per pass.
#
# Per-op reads/writes are deliberately NOT cached here. Measured: a
# Dict<Int,_> get costs ~2400 instructions at 10k entries against ~900 for the
# two-element fold it would replace, and with the backward sweep the fixpoint
# runs ~3 passes, so a cache cannot repay building itself.
class [final] AlInv(avLabels: Dict<String, Int>, avBlocks: Dict<Int, String>,
                    avN: Int)

fun alInvariants(ops: List<Op>): AlInv
  let bi = alBlockIndex(ops)
  ret AlInv(ucLabelIndex(ops), bi.d, bi.n)

# Enclosing block label per op index (nearest preceding Label; "" before any).
fun alBlockIndex(ops: List<Op>): (d: Dict<Int, String>, n: Int)
  ret alBlockIndexLoop(chain(ops), 0, "", Dict<Int, String>())

fun [tail] alBlockIndexLoop(os: Chain<Op>, i: Int, cur: String,
                            acc: Dict<Int, String>): (d: Dict<Int, String>, n: Int)
  ret match(os)
    (nil: ChainEnd) => (acc, i)
    (l: ChainLink)  => alLabelNameOr(l.value, cur)
      |> (nxt) => alBlockIndexLoop(l.next, i + 1, nxt, put(acc, i, nxt))

fun alLabelNameOr(op: Op, cur: String): String
  ret match(op)
    (lb: OpLabel) => lb.labelName
    (o: Op)       => cur

fun [tail] alLivenessIterate(ops: List<Op>, inv: AlInv): List<Op>
  let newOps = alLivenessPass(ops, inv)
  ret alOpsSavedEq(ops, newOps) ? newOps : alLivenessIterate(newOps, inv)

fun alOpsSavedEq(a: List<Op>, b: List<Op>): Bool
  ret alOpsSavedEqLoop(chain(a), chain(b))

fun [tail] alOpsSavedEqLoop(a: Chain<Op>, b: Chain<Op>): Bool
  ret match(a)
    (nil: ChainEnd) => true
    (la: ChainLink) => match(b)
      (lb: ChainLink) => svSetEq(opSavedVars(la.value), opSavedVars(lb.value))
        ? alOpsSavedEqLoop(la.next, lb.next)
        : false
      ()              => true

# Per-pass O(1)-indexed snapshot (user ruling 2026-07-22): the old forceNth
# walk was O(i) per read, O(n^2) per pass, times the fixpoint iterations —
# async liveness ran 79+ minutes at self-host scale without completing. ONLY
# the ops move between generations; AlInv carries everything that does not.
class [final] AlIx(aiOps: Dict<Int, Op>, aiInv: AlInv)

# The index scan walks the ops once. Prepending each op as it goes yields the
# BACKWARD order for free, so the backward liveness sweep below needs no
# reverse function: a function whose job is "these elements, backwards" is
# exactly what the container rules forbid, and one is not needed here — the
# scan that was already happening produces it as a by-product.
fun alIndexPass(ops: List<Op>, inv: AlInv): (ix: AlIx, back: List<Op>)
  ret alIxLoop(chain(ops), 0, Dict<Int, Op>(), List<Op>())
    |> (byIndex, back) => (ix = AlIx(byIndex, inv), back = back)

fun [tail] alIxLoop(os: Chain<Op>, i: Int, acc: Dict<Int, Op>,
                    back: List<Op>): (byIndex: Dict<Int, Op>, back: List<Op>)
  ret match(os)
    (nil: ChainEnd) => (byIndex = acc, back = back)
    (l: ChainLink)  => alIxLoop(l.next, i + 1, put(acc, i, l.value),
                                prepend(l.value, back))

fun alIxOp(ix: AlIx, i: Int): Op
  ret match(get(ix.aiOps, i))
    (op: Op) => op
    ()       => OpReturnVoid(List<RParam>())   # unreachable: 0 <= i < avN

fun alIxBlock(ix: AlIx, i: Int): String
  ret match(get(ix.aiInv.avBlocks, i))
    (s2: String) => s2
    ()           => ""

# Liveness is a BACKWARD analysis, so the sweep runs BACKWARD and the
# fall-through successor is the op just computed — carried as `nxt`, not read
# out of the previous generation. Sweeping forward moved information backward
# exactly one op per pass, so the pass count grew with function length and the
# fixpoint cost O(ops^2) op-visits (measured on the findstr proxy: an 82-op
# function took 46 passes; backward it takes 3, and the emitted C is
# byte-identical). Reading the freshest available value is ordinary chaotic
# iteration — same monotone transfer functions, same least fixed point.
fun alLivenessPass(ops: List<Op>, inv: AlInv): List<Op>
  ret alIndexPass(ops, inv)
    |> (ix, back) => alLivenessCalc(chain(back), ix, inv.avN - 1, None,
                                    List<Op>())

# `acc` is prepended to, so walking backward still yields forward order.
fun [tail] alLivenessCalc(os: Chain<Op>, ix: AlIx, i: Int, nxt: Op|None,
                          acc: List<Op>): List<Op>
  ret match(os)
    (nil: ChainEnd) => acc
    (l: ChainLink)  => alLivenessOne(l.value, ix, i, nxt)
      |> (o) => alLivenessCalc(l.next, ix, i - 1, o, prepend(o, acc))

# saved(op) = (edge-in of the fall-through/Jump successor ∪ edge-in of the
# JumpIf target) − op's own writes.
fun alLivenessOne(op: Op, ix: AlIx, i: Int, nxt: Op|None): Op
  let ss1 = i >= ix.aiInv.avN - 1
    ? List<RParam>()
    : alSs1(ix, i, op, nxt)
  let ss2 = alSs2(ix, i, op)
  ret opWithSavedVars(op, svSetSub(svSetUnion(ss1, ss2), alWritesOf(op)))

fun alSs1(ix: AlIx, i: Int, op: Op, nxt: Op|None): List<RParam>
  ret match(op)
    (j: OpJump) => match(ucLabelAt(ix.aiInv.avLabels, j.jumpName))
      (t2: Int) => alEdgeIn(ix, i, t2)
      ()         => List<RParam>()
    (o: Op)     => alEdgeInNext(ix, i, nxt)

# Fall-through edge: the successor's saved set is the one just computed.
fun alEdgeInNext(ix: AlIx, i: Int, nxt: Op|None): List<RParam>
  ret match(nxt)
    (o: Op) => svSetUnion(alSavedSetOf(o),
                          alPhiSourcesInto(ix, i + 1, alIxBlock(ix, i)))
    ()      => alEdgeIn(ix, i, i + 1)   # unreachable: i < avN - 1 implies a successor

fun alSs2(ix: AlIx, i: Int, op: Op): List<RParam>
  ret match(op)
    (ji: OpJumpIf) => match(ucLabelAt(ix.aiInv.avLabels, ji.jumpIfLabel))
      (t2: Int) => alEdgeIn(ix, i, t2)
      ()         => List<RParam>()
    (o: Op)        => List<RParam>()

fun alEdgeIn(ix: AlIx, fromIdx: Int, targetIdx: Int): List<RParam>
  ret svSetUnion(alSavedSetAt(ix, targetIdx),
                 alPhiSourcesInto(ix, targetIdx, alIxBlock(ix, fromIdx)))

fun alSavedSetAt(ix: AlIx, index: Int): List<RParam>
  ret alSavedSetOf(alIxOp(ix, index))

fun alSavedSetOf(op: Op): List<RParam>
  ret svSetUnion(fold(alReadsOf(op), List<RParam>(), svSetAdd), opSavedVars(op))

# Phi sources arriving on the edge from `pred`: scan the run of Phis at the
# target.
fun alPhiSourcesInto(ix: AlIx, j: Int, pred: String): List<RParam>
  ret alPhiSourcesLoop(ix, j + 1, pred, List<RParam>())

fun [tail] alPhiSourcesLoop(ix: AlIx, j: Int, pred: String, acc: List<RParam>): List<RParam>
  if j >= ix.aiInv.avN
    ret acc
  ret match(alIxOp(ix, j))
    (ph: OpPhi) => alPhiSourcesLoop(ix, j + 1, pred,
                     fold(ph.phiSources, acc, (a: List<RParam>, s2: OpPhiSource) =>
                       s2.sourceLabel == pred
                         ? fold(rpReadStackVars(s2.sourceValue), a, svSetAdd)
                         : a))
    (o: Op)     => acc

# ── basic blocks ─────────────────────────────────────────────────────────────

class [final] ABlock(abName: String, abOps: List<Op>, abLive: List<RParam>,
                     abResult: RParam|None)

# Partition liveness-annotated ops on non-musttail Call | ParallelCall (the
# splitter is the LAST op of its block); block name cont$<i>; live = last
# op's saved_vars; result = last op's register.
fun alCreateBasicBlocks(f: CgFunction): List<ABlock>
  ret alCreateBasicBlocksN(f).bs

# The block count rides alPartition's existing carried counter.
fun alCreateBasicBlocksN(f: CgFunction): (bs: List<ABlock>, n: Int)
  let annotated = alCalculateSavedVars(f)
  ret alPartition(chain(annotated.fnOps), 0, List<Op>(), List<ABlock>())

# `n` is the count of blocks already in `acc` — carried, not re-measured;
# the final tuple's n is the TOTAL block count (last block is n, so n+1).
fun [tail] alPartition(os: Chain<Op>, n: Int, cur: List<Op>, acc: List<ABlock>): (bs: List<ABlock>, n: Int)
  ret match(os)
    (nil: ChainEnd) => (append(acc, alMakeBlock(n, cur)), n + 1)
    (l: ChainLink)  => alIsSplitter(l.value)
      ? alPartition(l.next, n + 1, List<Op>(),
                    append(acc, alMakeBlock(n, append(cur, l.value))))
      : alPartition(l.next, n, append(cur, l.value), acc)

fun alIsSplitter(op: Op): Bool
  ret match(op)
    (c: OpCall)          => !c.callMusttail
    (pc: OpParallelCall) => true
    (o: Op)              => false

fun alMakeBlock(index: Int, ops: List<Op>): ABlock
  ret match(lastOp(chain(ops)))
    (op: Op) => ABlock("cont$" + String(index), ops, opSavedVars(op), alBlockResult(op))
    ()        => ABlock("cont$" + String(index), ops, List<RParam>(), None)

fun alBlockResult(op: Op): RParam|None
  ret match(op)
    (c: OpCall)          => c.callRegister
    (pc: OpParallelCall) => pc.parRegister
    (o: Op)              => None

# ── heap-frame layout ────────────────────────────────────────────────────────

class [final] AFrame(afPtrSlots: List<NameIdx>, afInlineSlots: List<NameStr>,
                     afSlotFields: List<CgField>, afNArray: Int,
                     afDecomposed: List<NameIdx>)
class [final] NameIdx(niName: String, niIdx: Int)
class [final] NameStr(nsName: String, nsStr: String)

fun niLookup(l: List<NameIdx>, name: String): Int|None
  ret match(head(filter(l, (e2: NameIdx) => e2.niName == name)))
    (e2: NameIdx) => e2.niIdx
    ()             => None

fun nsLookup(l: List<NameStr>, name: String): String|None
  ret match(head(filter(l, (e2: NameStr) => e2.nsName == name)))
    (e2: NameStr) => e2.nsStr
    ()             => None

# Frame-resident locals: saved live vars (SORTED by name — reproducibility)
# + call-result registers over bbs[:-1]; first-seen order, last-seen type.
fun alFrameFieldTypes(bbs: List<ABlock>): List<CgField>
  ret alFftLoop(chain(alNonTerminal(bbs)), List<CgField>())

fun alNonTerminal(bbs: List<ABlock>): List<ABlock>
  ret alDropLast(bbs)

# Non-terminal blocks AND their count from one walk (no-length ruling).
fun alNonTerminalN(bbs: List<ABlock>): (bs: List<ABlock>, n: Int)
  ret alNtLoop(chain(bbs), 0, List<ABlock>())

fun [tail] alNtLoop(c: Chain<ABlock>, n: Int, acc: List<ABlock>): (bs: List<ABlock>, n: Int)
  ret match(c)
    (nil: ChainEnd) => (acc, n)
    (l: ChainLink)  => l.next is ChainEnd
      ? (acc, n)
      : alNtLoop(l.next, n + 1, append(acc, l.value))

fun alDropLast<T>(l: List<T>): List<T>
  ret alDropLastLoop(chain(l), List<T>())

fun [tail] alDropLastLoop<T>(c: Chain<T>, acc: List<T>): List<T>
  ret match(c)
    (nil: ChainEnd) => acc
    (l: ChainLink)  => match(l.next)
      (nil2: ChainEnd) => acc
      (l2: ChainLink)  => alDropLastLoop<T>(l.next, append<T>(acc, l.value))

fun [tail] alFftLoop(bbs: Chain<ABlock>, acc: List<CgField>): List<CgField>
  ret match(bbs)
    (nil: ChainEnd) => acc
    (l: ChainLink)  => alFftLoop(l.next, alFftBlock(l.value, acc))

fun alFftBlock(bb: ABlock, acc: List<CgField>): List<CgField>
  let withLive = fold(svSortedByName(bb.abLive), acc, alFftPut)
  ret match(bb.abResult)
    (r: RParam) => alFftPutR(withLive, r)
    ()           => withLive

fun alFftPut(acc: List<CgField>, v: RParam): List<CgField>
  ret alFftPutR(acc, v)

# first-seen ORDER, last-seen TYPE (Python dict assignment semantics).
fun alFftPutR(acc: List<CgField>, v: RParam): List<CgField>
  ret match(v)
    (sv: RpStackVar) => any(acc, (f2: CgField) => f2.fieldName == sv.name)
      ? map(acc, (f2: CgField) => f2.fieldName == sv.name ? CgField(sv.name, rpGetType(v)) : f2)
      : append(acc, CgField(sv.name, rpGetType(v)))
    (o: RParam)       => acc

# Interference: pairs simultaneously live over BOTH op sequences (SM view is
# authoritative; hot view keeps coalescing safe there too). live-out pairs;
# writes × live-out; live-IN pairs (reads + live-out survivors not redefined)
# — reads do NOT interfere with the op's own write (slot = f(slot) is sound).
# The graph is DICT-backed (user ruling 2026-07-22): the old edge LIST paid
# a full scan per insertion and per neighbour query — cubic at self-host
# scale, where big state machines have hundreds of frame vars (async ran
# 79+ min without completing). Both directed keys are stored so presence is
# one get; adjacency lists keep first-seen order, which is the edge-list
# order alNeighbours used to produce per node.
class [final] IGraph(igEdges: Dict<String, Bool>,
                     igAdj: Dict<String, List<String>>)

fun alEmptyGraph(): IGraph
  ret IGraph(Dict<String, Bool>(), Dict<String, List<String>>())

fun alBuildInterference(opSeqs: List<List<Op>>,
                        frameNames: List<String>): IGraph
  let frameIx = fold(frameNames, Dict<String, Bool>(),
                     (ix: Dict<String, Bool>, n: String) => put(ix, n, true))
  ret fold(opSeqs, alEmptyGraph(),
           (acc: IGraph, ops: List<Op>) => fold(ops, acc,
             (a: IGraph, op: Op) => alInterfereOp(a, op, frameIx)))

fun alInFrame(frameIx: Dict<String, Bool>, n: String): Bool
  ret !(get(frameIx, n) is None)

fun alInterfereOp(acc: IGraph, op: Op,
                  frameIx: Dict<String, Bool>): IGraph
  let liveOut = filter(map(opSavedVars(op), stackVarName),
                       (n: String) => alInFrame(frameIx, n))
  let writes = map(alWritesOf(op), stackVarName)
  let acc1 = alLinkAllPairs(acc, liveOut)
  let acc2 = fold(writes, acc1, (a: IGraph, w: String) =>
               alInFrame(frameIx, w)
                 ? fold(liveOut, a, (a2: IGraph, n: String) => alLink(a2, w, n))
                 : a)
  let liveIn = concat(filter(map(alReadsOf(op), stackVarName),
                             (n: String) => alInFrame(frameIx, n)),
                      filter(liveOut,
                             (n: String) => !strListMember(writes, n)))
  ret alLinkAllPairs(acc2, liveIn)

fun alLink(acc: IGraph, a: String, b: String): IGraph
  if a == b
    ret acc
  if !(get(acc.igEdges, a + "\u{a7}" + b) is None)
    ret acc
  ret IGraph(put(put(acc.igEdges, a + "\u{a7}" + b, true),
                 b + "\u{a7}" + a, true),
             alAdjAdd(alAdjAdd(acc.igAdj, a, b), b, a))

fun alAdjAdd(adj: Dict<String, List<String>>, from2: String,
             to2: String): Dict<String, List<String>>
  ret match(get(adj, from2))
    (prev: List<String>) => put(adj, from2, append(prev, to2))
    ()                   => put(adj, from2, list1(to2))

fun alLinkAllPairs(acc: IGraph, names: List<String>): IGraph
  ret alLapLoop(acc, chain(names))

fun [tail] alLapLoop(acc: IGraph, ns: Chain<String>): IGraph
  ret match(ns)
    (nil: ChainEnd) => acc
    (l: ChainLink)  => alLapLoop(alLapInner(acc, l.value, l.next), l.next)

fun [tail] alLapInner(acc: IGraph, a: String, ns: Chain<String>): IGraph
  ret match(ns)
    (nil: ChainEnd) => acc
    (l: ChainLink)  => alLapInner(alLink(acc, a, l.value), a, l.next)

fun alNeighbours(graph: IGraph, name: String): List<String>
  ret match(get(graph.igAdj, name))
    (ns: List<String>) => ns
    ()                 => List<String>()

# Greedy colouring in the given name order.
fun alColour(names: List<String>, graph: IGraph): List<NameIdx>
  ret fold(names, List<NameIdx>(), (acc: List<NameIdx>, n: String) => alColourOne(acc, n, graph))

fun alColourOne(acc: List<NameIdx>, name: String, graph: IGraph): List<NameIdx>
  let used = fold(alNeighbours(graph, name), List<Int>(), (u: List<Int>, nb: String) =>
               alUsedColour(u, acc, nb))
  ret append(acc, NameIdx(name, alFirstFree(used, 0)))

fun alUsedColour(u: List<Int>, acc: List<NameIdx>, nb: String): List<Int>
  ret match(niLookup(acc, nb))
    (c: Int) => append(u, c)
    ()        => u

fun [tail] alFirstFree(used: List<Int>, c: Int): Int
  ret any(used, (x: Int) => x == c) ? alFirstFree(used, c + 1) : c

# All-pointer struct leaf paths (nested), None otherwise.
fun alPtrLeaves(t2: CgType): (ls: List<String>, n: Int)|None
  ret match(t2)
    (s2: CgStruct)          => alPtrLeavesFields(s2.fields)
    (im: CgImmediateStruct) => alPtrLeavesFields(im.fields)
    (o: CgType)             => None

# Paths encoded as "/"-joined field names (root-first); the leaf count
# rides the same fold (no-length ruling).
fun alPtrLeavesFields(fields: List<CgField>): (ls: List<String>, n: Int)|None
  let out = fold(fields, (List<String>(), 0, true),
                 (acc: (paths: List<String>, n: Int, ok: Bool), f2: CgField) => alPlfOne(acc, f2))
  ret out.ok && out.n > 0 ? (out.paths, out.n) : None

fun alPlfOne(acc: (paths: List<String>, n: Int, ok: Bool), f2: CgField): (paths: List<String>, n: Int, ok: Bool)
  if !acc.ok
    ret acc
  ret match(f2.fieldType)
    (d: CgDataPointer) => (append(acc.paths, f2.fieldName), acc.n + 1, true)
    (s2: CgStruct)     => alPlfNested(acc, f2, alPtrLeavesFields(s2.fields))
    (im: CgImmediateStruct) => alPlfNested(acc, f2, alPtrLeavesFields(im.fields))
    (o: CgType)        => (acc.paths, acc.n, false)

fun alPlfNested(acc: (paths: List<String>, n: Int, ok: Bool), f2: CgField,
                inner: (ls: List<String>, n: Int)|None): (paths: List<String>, n: Int, ok: Bool)
  ret match(inner)
    (ps: (ls: List<String>, n: Int)) => (concat(acc.paths, map(ps.ls, (p: String) => f2.fieldName + "/" + p)),
                                         acc.n + ps.n, true)
    ()                  => (acc.paths, acc.n, false)

# Frame layout: coalesce per exact-type class (by_type in FIRST-SEEN type
# order — type_index numbers from it), then route slots: strict DataPointer →
# trailing GC array; all-pointer structs → decomposed array runs; else inline
# $slot$<typeidx>$<colour> fields.
fun alComputeFrameLayout(smBbs: List<ABlock>, hotBbs: List<ABlock>,
                         livenessOps: List<Op>): AFrame
  let fieldTypes = alFrameFieldTypes(smBbs)
  let frameNames = map(fieldTypes, (f2: CgField) => f2.fieldName)
  let hotOps = fold(hotBbs, List<Op>(), (acc: List<Op>, bb: ABlock) => concat(acc, bb.abOps))
  let graph = alBuildInterference(list2(livenessOps, hotOps), frameNames)
  let byType = alGroupByType(fieldTypes)
  ret alLayoutLoop(chain(byType), graph, 0, AFrame(List<NameIdx>(), List<NameStr>(),
                                                   List<CgField>(), 0, List<NameIdx>()))

class [final] TypeGroup(tgType: CgType, tgNames: List<String>)

fun alGroupByType(fieldTypes: List<CgField>): List<TypeGroup>
  ret fold(fieldTypes, List<TypeGroup>(), (acc: List<TypeGroup>, f2: CgField) => alGbtPut(acc, f2))

fun alGbtPut(acc: List<TypeGroup>, f2: CgField): List<TypeGroup>
  ret any(acc, (g2: TypeGroup) => eqCgType(g2.tgType, f2.fieldType))
    ? map(acc, (g2: TypeGroup) => eqCgType(g2.tgType, f2.fieldType)
                 ? TypeGroup(g2.tgType, append(g2.tgNames, f2.fieldName)) : g2)
    : append(acc, TypeGroup(f2.fieldType, list1(f2.fieldName)))

fun [tail] alLayoutLoop(gs: Chain<TypeGroup>, graph: IGraph, ti: Int, acc: AFrame): AFrame
  ret match(gs)
    (nil: ChainEnd) => acc
    (l: ChainLink)  => alLayoutLoop(l.next, graph, ti + 1,
                                    alLayoutGroup(l.value, graph, ti, acc))

fun alLayoutGroup(g2: TypeGroup, graph: IGraph, ti: Int, acc: AFrame): AFrame
  let colour = alColour(g2.tgNames, graph)
  let nColours = alDistinctColourCount(colour)
  ret match(g2.tgType)
    (d: CgDataPointer) => AFrame(
        concat(acc.afPtrSlots, map(colour, (e2: NameIdx) => NameIdx(e2.niName, acc.afNArray + e2.niIdx))),
        acc.afInlineSlots, acc.afSlotFields, acc.afNArray + nColours, acc.afDecomposed)
    (o: CgType) => alLayoutNonPtr(g2, colour, nColours, ti, acc)

fun alLayoutNonPtr(g2: TypeGroup, colour: List<NameIdx>, nColours: Int, ti: Int, acc: AFrame): AFrame
  ret match(alPtrLeaves(g2.tgType))
    (leaves: (ls: List<String>, n: Int)) => alLayoutDecomposed(colour, leaves.n, acc)
    ()                      => alLayoutInline(g2, colour, ti, acc)

# colour_base maps each distinct colour (sorted) to array base indices.
fun alLayoutDecomposed(colour: List<NameIdx>, width: Int, acc: AFrame): AFrame
  let sorted2 = alSortedColours(colour)
  let entries = map(colour, (e2: NameIdx) => NameIdx(e2.niName,
                      acc.afNArray + alIndexOfInt(sorted2.cs, e2.niIdx) * width))
  ret AFrame(acc.afPtrSlots, acc.afInlineSlots, acc.afSlotFields,
             acc.afNArray + width * sorted2.n,
             concat(acc.afDecomposed, entries))

fun alLayoutInline(g2: TypeGroup, colour: List<NameIdx>, ti: Int, acc: AFrame): AFrame
  let sortedColours = alSortedColours(colour).cs
  let newFields = map(sortedColours, (c: Int) => CgField("$slot$" + String(ti) + "$" + String(c), g2.tgType))
  ret AFrame(acc.afPtrSlots,
             concat(acc.afInlineSlots, map(colour, (e2: NameIdx) =>
               NameStr(e2.niName, "$slot$" + String(ti) + "$" + String(e2.niIdx)))),
             concat(acc.afSlotFields, newFields), acc.afNArray, acc.afDecomposed)

fun alDistinctColourCount(colour: List<NameIdx>): Int
  ret alSortedColours(colour).n

fun alSortedColours(colour: List<NameIdx>): (cs: List<Int>, n: Int)
  let dd = fold(colour, (List<Int>(), 0),
                (acc: (cs: List<Int>, n: Int), e2: NameIdx) =>
                  any(acc.cs, (x: Int) => x == e2.niIdx)
                    ? acc
                    : (append(acc.cs, e2.niIdx), acc.n + 1))
  ret (alSortInts(dd.cs), dd.n)

fun alSortInts(l: List<Int>): List<Int>
  ret alSortIntsLoop(l, List<Int>())

fun [tail] alSortIntsLoop(l: List<Int>, acc: List<Int>): List<Int>
  if isEmpty(l)
    ret acc
  let m = fold(l, forceNth(l, 0), (a: Int, x: Int) => x < a ? x : a)
  ret alSortIntsLoop(filter(l, (x: Int) => x != m), append(acc, m))

fun alIndexOfInt(l: List<Int>, x: Int): Int
  ret alIoiLoop(chain(l), x, 0)

fun [tail] alIoiLoop(ls: Chain<Int>, x: Int, i: Int): Int
  ret match(ls)
    (nil: ChainEnd) => 0   # unreachable: x came from the list
    (l: ChainLink)  => l.value == x ? i : alIoiLoop(l.next, x, i + 1)

# ── store/load between locals and the state object ───────────────────────────

# `sp` = the state-object base (Python's state_param argument): the HOT PATH
# and stub launch address the freshly-allocated $sv_state; the STATE MACHINE
# addresses its $state parameter. Hardcoding one base here read a never-
# written $state in the hot path's save block (uninit_check caught it).
fun alArrayElem(sp: RParam, stateName: String, index: Int): RParam
  ret RpObjectField(CgDataPointer(), sp, stateName, "array",
                    RpInteger(index, 32), false)

# Frame local reference: trailing-array slot | shared inline slot | named field.
fun alStateField(name: String, t2: CgType, sp: RParam, stateName: String, layout: AFrame): RParam
  ret match(niLookup(layout.afPtrSlots, name))
    (i: Int) => alArrayElem(sp, stateName, i)
    ()        => match(nsLookup(layout.afInlineSlots, name))
      (slot: String) => RpObjectField(t2, sp, stateName, slot, None, false)
      ()              => RpObjectField(t2, sp, stateName, name, None, false)

# local → state; a decomposed struct stores one leaf per array element.
fun alStoreVar(v: RParam, sp: RParam, stateName: String, layout: AFrame): List<Op>
  ret match(niLookup(layout.afDecomposed, stackVarName(v)))
    (base: Int) => alStoreDecomposed(v, sp, stateName, base)
    ()           => list1(OpMove(alStateField(stackVarName(v), rpGetType(v), sp, stateName, layout),
                                 v, false, List<RParam>()))

fun alStoreDecomposed(v: RParam, sp: RParam, stateName: String, base: Int): List<Op>
  ret match(alPtrLeaves(rpGetType(v)))
    (paths: (ls: List<String>, n: Int)) => alSdLoop(chain(paths.ls), v, sp, stateName, base, 0, List<Op>())
    ()                     => List<Op>()   # unreachable: decomposed entries are all-ptr structs

fun alSdLoop(ps: Chain<String>, v: RParam, sp: RParam, stateName: String,
                    base: Int, i: Int, acc: List<Op>): List<Op>
  ret build<Op >(alSdLoopB(ps, v, sp, stateName, base, i, _pushChain<Op >(builder<Op >(), chain<Op >(acc))))

fun [tail] alSdLoopB(ps: Chain<String>, v: RParam, sp: RParam, stateName: String,
                    base: Int, i: Int, [terminal] acc: ListBuilder<Op >): ListBuilder<Op >
  ret match(ps)
    (nil: ChainEnd) => acc
    (l: ChainLink)  => alSdLoopB(l.next, v, sp, stateName, base, i + 1,
        push<Op >(acc, OpMove(alArrayElem(sp, stateName, base + i),
                           alPathField(v, l.value), false, List<RParam>())))

fun alPathField(v: RParam, path: String): RParam
  ret fold(splitPath(path), v, (src: RParam, f2: String) => RpStructField(src, f2))

fun splitPath(path: String): List<String>
  ret splitPathLoop(path, 0, 0, List<String>())

fun splitPathLoop(path: String, start: Int, i: Int, acc: List<String>): List<String>
  ret build<String >(splitPathLoopB(path, start, i, _pushChain<String >(builder<String >(), chain<String >(acc))))

fun [tail] splitPathLoopB(path: String, start: Int, i: Int, [terminal] acc: ListBuilder<String >): ListBuilder<String >
  if i >= length(path)
    ret push<String >(acc, slice(path, start, i))
  ret byteAt(path, i) == '/'
    ? splitPathLoopB(path, i + 1, i + 1, push<String >(acc, slice(path, start, i)))
    : splitPathLoopB(path, start, i + 1, acc)

# state → local; a decomposed struct is rebuilt from its array elements via
# nested NewStructs (index walk in leaf order).
fun alLoadVar(v: RParam, sp: RParam, stateName: String, layout: AFrame): List<Op>
  ret match(niLookup(layout.afDecomposed, stackVarName(v)))
    (base: Int) => list1(OpMove(v, alRebuild(rpGetType(v), sp, stateName, base).rbValue,
                                false, List<RParam>()))
    ()           => list1(OpMove(v, alStateField(stackVarName(v), rpGetType(v), sp, stateName, layout),
                                 false, List<RParam>()))

class [final] Rebuilt(rbValue: RParam, rbNext: Int)

fun alRebuild(t2: CgType, sp: RParam, stateName: String, idx: Int): Rebuilt
  ret alRebuildFields(cgFieldsOfOrEmpty(t2), sp, stateName, idx, List<RpNamedValue>())

fun [tail] alRebuildFields(fields: List<CgField>, sp: RParam, stateName: String, idx: Int,
                           acc: List<RpNamedValue>): Rebuilt
  if isEmpty(fields)
    ret Rebuilt(RpNewStruct(acc), idx)
  let f2 = forceNth(fields, 0)
  let rest = tail(fields)
  ret match(f2.fieldType)
    (s2: CgStruct) => alRebuildNested(f2, rest, sp, stateName, idx, acc)
    (im: CgImmediateStruct) => alRebuildNested(f2, rest, sp, stateName, idx, acc)
    (o: CgType)    => alRebuildFields(rest, sp, stateName, idx + 1,
                        append(acc, RpNamedValue(f2.fieldName, alArrayElem(sp, stateName, idx))))

fun alRebuildNested(f2: CgField, rest: List<CgField>, sp: RParam, stateName: String, idx: Int,
                    acc: List<RpNamedValue>): Rebuilt
  let inner = alRebuild(f2.fieldType, sp, stateName, idx)
  ret alRebuildFields(rest, sp, stateName, inner.rbNext,
                      append(acc, RpNamedValue(f2.fieldName, inner.rbValue)))

# ── musttail unroll (SM view) + state object ────────────────────────────────

fun alUnrollMusttail(f: CgFunction): CgFunction
  ret cgFunctionWith(f, alUmLoop(chain(f.fnOps), 0, List<Op>()), f.fnStackVars)

fun [tail] alUmLoop(os: Chain<Op>, counter: Int, acc: List<Op>): List<Op>
  ret match(os)
    (nil: ChainEnd) => acc
    (l: ChainLink)  => match(alUmOne(l.value, counter))
      (u: UmOut) => alUmLoop(l.next, u.umCounter, concat(acc, u.umOps))
      ()          => alUmLoop(l.next, counter, append(acc, l.value))

class [final] UmOut(umOps: List<Op>, umCounter: Int)

fun alUmOne(op: Op, counter: Int): UmOut|None
  ret match(op)
    (c: OpCall) => c.callMusttail ? alUmCall(c, counter + 1) : None
    (o: Op)     => None

fun alUmCall(c: OpCall, n: Int): UmOut
  ret alResultTypeVoidish(c.callResultType)
    ? UmOut(list2(OpCall(c.callFunction, c.callParameters, None, false, c.callImpure,
                         c.callResultType, c.callSavedVars),
                  OpReturnVoid(List<RParam>())), n)
    : alUmValued(c, n)

fun alUmValued(c: OpCall, n: Int): UmOut
  let tmp = RpStackVar(alForceResultType(c.callResultType), "$musttail$ret$" + String(n))
  ret UmOut(list2(OpCall(c.callFunction, c.callParameters, tmp, false, c.callImpure,
                         c.callResultType, c.callSavedVars),
                  OpReturn(tmp, List<RParam>())), n)

fun alForceResultType(t2: CgType|None): CgType
  ret match(t2)
    (x: CgType) => x
    ()           => CgDataPointer()   # unreachable: valued musttails carry a type

# State object: type, my_task, <inline PTR-BEARING slots>, idx, $ptr_count,
# <non-ptr slots>, array[0] — pointer slots kept LOW for the location mask.
fun alCreateStateObject(f: CgFunction, stateName: String, layout: AFrame): CgObject
  let inlinePtr = filter(layout.afSlotFields, (f2: CgField) => cgHasPointers(f2.fieldType))
  let nonPtr = filter(layout.afSlotFields, (f2: CgField) => !cgHasPointers(f2.fieldType))
  let fields = concat(concat(concat(list2(CgField("type", CgDataPointer()),
                                          CgField("my_task", CgDataPointer())),
                                    inlinePtr),
                             list2(CgField("idx", CgInt(32)),
                                   CgField("$ptr_count", CgInt(32)))),
                      append(nonPtr, CgField("array", CgArray(CgDataPointer(), 0))))
  ret CgObject(stateName, List<String>(), List<CgFuncSlot>(),
               CgImmediateStruct(fields), "$ptr_count", f.fnComment,
               false, true, 0)   # is_mutable: idx + live vars rewritten at every suspension

# ── hot-path function ────────────────────────────────────────────────────────

# All state-resident vars over bbs[:-1]: sorted live per block + result reg,
# first-seen dedup — the prologue zero-inits every NON-PARAM one (GC safety
# for cold blocks firing before later sites' vars are assigned).
fun alAllStateVars(bbs: List<ABlock>): List<RParam>
  ret fold(alNonTerminal(bbs), List<RParam>(), alAsvBlock)

fun alAsvBlock(acc: List<RParam>, bb: ABlock): List<RParam>
  let withLive = fold(svSortedByName(bb.abLive), acc, svSetAdd)
  ret match(bb.abResult)
    (r: RParam) => svSetAdd(withLive, r)
    ()           => withLive

fun alZeroVal(t2: CgType): RParam
  ret match(t2)
    (d: CgDataPointer) => RpNullPointer()
    (i: CgInt)         => RpInteger(0, i.precision)
    (o: CgType)        => RpZeroOf(t2)

class [final] HotOut(hoOps: List<Op>, hoWrapFields: List<CgField>)

fun alCreateHotPathFunc(f: CgFunction, stateName: String, subtype: String|None,
                        bbs: List<ABlock>, layout: AFrame): CgFunction
  let wrappedResult = wrapReturnType(f.fnResult)
  let paramNames = map(cgFieldsOfOrEmpty(f.fnParams), (fld: CgField) => fld.fieldName)
  let prologue = fold(alAllStateVars(bbs), List<Op>(), (acc: List<Op>, v: RParam) =>
                   strListMember(paramNames, stackVarName(v))
                     ? acc
                     : append(acc, OpMove(v, alZeroVal(rpGetType(v)), false, List<RParam>())))
  let body = alHotSites(chain(alNonTerminal(bbs)), f, wrappedResult, 0, HotOut(prologue, List<CgField>()))
  let withTerminal = HotOut(concat(body.hoOps, alConvertReturnsHot(alLastBlock(bbs).abOps, wrappedResult)),
                            body.hoWrapFields)
  let hasPar = any(alNonTerminal(bbs), (bb: ABlock) => alBlockIsPar(bb))
  ret f.fnSync
    ? alHotAssembleSync(f, wrappedResult, withTerminal, hasPar)
    : alHotAssembleAsync(f, stateName, subtype, bbs, layout, wrappedResult, withTerminal, hasPar)

fun alLastBlock(bbs: List<ABlock>): ABlock
  ret match(lastOp2(chain(bbs)))
    (bb: ABlock) => bb
    ()            => ABlock("", List<Op>(), List<RParam>(), None)   # unreachable: >=1 block always

fun [tail] lastOp2(bbs: Chain<ABlock>): ABlock|None
  ret match(bbs)
    (nil: ChainEnd) => None
    (l: ChainLink)  => match(l.next)
      (nil2: ChainEnd) => l.value
      (l2: ChainLink)  => lastOp2(l.next)

fun alBlockIsPar(bb: ABlock): Bool
  ret match(lastOp(chain(bb.abOps)))
    (op: Op) => match(op)
      (pc: OpParallelCall) => true
      (o: Op)               => false
    ()        => false

fun [tail] alHotSites(bs: Chain<ABlock>, f: CgFunction, wrappedResult: CgType,
                      i: Int, acc: HotOut): HotOut
  ret match(bs)
    (nil: ChainEnd) => acc
    (l: ChainLink)  => alHotSites(l.next, f, wrappedResult, i + 1,
                                  alHotSite(l.value, f, wrappedResult, i, acc))

fun alHotSite(bb: ABlock, f: CgFunction, wrappedResult: CgType, i: Int, acc: HotOut): HotOut
  ret match(lastOp(chain(bb.abOps)))
    (op: Op) => match(op)
      (pc: OpParallelCall) => alHotPar(bb, pc, f, wrappedResult, i, acc)
      (c: OpCall)          => alHotCall(bb, c, wrappedResult, i, acc)
      (o: Op)               => acc   # unreachable: non-terminal blocks end in a splitter
    ()        => acc

fun alHotPar(bb: ABlock, pc: OpParallelCall, f: CgFunction, wrappedResult: CgType,
             i: Int, acc: HotOut): HotOut
  let parTaskName = "task$par$" + String(i) + "$" + f.fnName
  let closures = alClosuresCounted(chain(pc.parCalls), 0, List<RParam>())
  let ops1 = concat(acc.hoOps, alConvertReturnsHot(alDropLast(bb.abOps), wrappedResult))
  let ops2 = concat(ops1, alEmitParTaskSetup(alSvParTask(), parTaskName, closures.cs, closures.n))
  let ops3 = alHotParLaunchers(ops2, f.fnName, i, chain(pc.parCalls), 0)
  ret HotOut(concat(ops3, list3(OpMove(alSvAsyncTask(), alSvParTask(), false, List<RParam>()),
                                OpMove(alSvCallId(), RpInteger(i + 1, 32), false, List<RParam>()),
                                OpJump("$asynccommon", List<RParam>()))),
             acc.hoWrapFields)

fun alClosureOf(callRef: RParam): RParam
  ret match(callRef)
    (gf: RpGlobalFunction) => match(gf.object)
      (obj: RParam) => obj
      ()             => RpNullPointer()
    (o: RParam)             => RpNullPointer()

fun [tail] alHotParLaunchers(acc: List<Op>, fnName: String, site: Int,
                             calls: Chain<RParam>, k: Int): List<Op>
  ret match(calls)
    (nil: ChainEnd) => acc
    (l: ChainLink)  => alHotParLaunchers(
        concat(acc, alEmitPostLauncher(alSvLauncher(), alSvParTask(), fnName, site, k)),
        fnName, site, l.next, k + 1)

# One closure per parallel call, its count riding the walk (no-length ruling).
fun [tail] alClosuresCounted(ps: Chain<RParam>, n: Int,
                             acc: List<RParam>): (cs: List<RParam>, n: Int)
  ret match(ps)
    (nil: ChainEnd) => (acc, n)
    (l: ChainLink)  => alClosuresCounted(l.next, n + 1, append(acc, alClosureOf(l.value)))

fun alHotCall(bb: ABlock, c: OpCall, wrappedResult: CgType, i: Int, acc: HotOut): HotOut
  ret match(c.callRegister)
    (reg: RParam) => alHotValued(bb, c, reg, wrappedResult, i, acc)
    ()             => alHotDiscarded(bb, c, wrappedResult, i, acc)

# register None + result_type None → pure void: emit unchanged. Non-void
# discarded → $wrap$<i> temp + IfTask, no unwrap Move.
fun alHotDiscarded(bb: ABlock, c: OpCall, wrappedResult: CgType, i: Int, acc: HotOut): HotOut
  ret match(c.callResultType)
    (dt: CgType) => alHotDiscardedTyped(bb, c, dt, wrappedResult, i, acc)
    ()            => HotOut(concat(acc.hoOps, alConvertReturnsHot(bb.abOps, wrappedResult)),
                            acc.hoWrapFields)

fun alHotDiscardedTyped(bb: ABlock, c: OpCall, dt: CgType, wrappedResult: CgType,
                        i: Int, acc: HotOut): HotOut
  let dw = wrapReturnType(dt)
  let svWrap = RpStackVar(dw, "$wrap$" + String(i))
  let ops1 = concat(acc.hoOps, alConvertReturnsHot(alDropLast(bb.abOps), wrappedResult))
  let ops2 = append(ops1, OpCall(c.callFunction, c.callParameters, svWrap, c.callMusttail,
                                 c.callImpure, c.callResultType, c.callSavedVars))
  ret HotOut(append(ops2, alIfTaskOp(svWrap, dw, i)),
             append(acc.hoWrapFields, CgField("$wrap$" + String(i), dw)))

fun alIfTaskOp(sv: RParam, wrapped: CgType, i: Int): Op
  ret OpIfTask(isTaskParam(sv, wrapped), taskPtrFrom(sv, wrapped),
               alSvAsyncTask(), alSvCallId(), i + 1, "$asynccommon", List<RParam>())

# needs_temp: Python tests `wrapped is not result_type` — the wrap function
# returns its input unchanged for pass-through shapes, so structural
# inequality is the faithful port.
fun alHotValued(bb: ABlock, c: OpCall, reg: RParam, wrappedResult: CgType,
                i: Int, acc: HotOut): HotOut
  let resultType = rpGetType(reg)
  let wrappedType = wrapReturnType(resultType)
  ret eqCgType(wrappedType, resultType)
    ? alHotValuedDirect(bb, c, reg, wrappedType, wrappedResult, i, acc)
    : alHotValuedTemp(bb, c, reg, wrappedType, wrappedResult, i, acc)

fun alHotValuedDirect(bb: ABlock, c: OpCall, reg: RParam, wrappedType: CgType,
                      wrappedResult: CgType, i: Int, acc: HotOut): HotOut
  let ops1 = concat(acc.hoOps, alConvertReturnsHot(bb.abOps, wrappedResult))
  ret HotOut(append(ops1, alIfTaskOp(reg, wrappedType, i)), acc.hoWrapFields)

fun alHotValuedTemp(bb: ABlock, c: OpCall, reg: RParam, wrappedType: CgType,
                    wrappedResult: CgType, i: Int, acc: HotOut): HotOut
  let svWrap = RpStackVar(wrappedType, "$wrap$" + String(i))
  let ops1 = concat(acc.hoOps, alConvertReturnsHot(alDropLast(bb.abOps), wrappedResult))
  let ops2 = append(ops1, OpCall(c.callFunction, c.callParameters, svWrap, c.callMusttail,
                                 c.callImpure, c.callResultType, c.callSavedVars))
  let ops3 = append(ops2, alIfTaskOp(svWrap, wrappedType, i))
  ret HotOut(append(ops3, OpMove(reg, RpStructField(svWrap, "value"), false, List<RParam>())),
             append(acc.hoWrapFields, CgField("$wrap$" + String(i), wrappedType)))

# sync: $asynccommon aborts (a proven-sync fn reached it = broken contract).
fun alHotAssembleSync(f: CgFunction, wrappedResult: CgType, body: HotOut, hasPar: Bool): CgFunction
  let commonOps = list2(OpLabel("$asynccommon", List<RParam>()),
                        OpAbort("sync function reached $asynccommon", List<RParam>()))
  let parFields = hasPar
    ? list3(CgField("$sv_par_task", CgDataPointer()),
            CgField("$sv_launcher", CgDataPointer()),
            CgField("$sv_discard", CgDataPointer()))
    : List<CgField>()
  let extra = concat(concat(list2(CgField("$sv_call_id", CgInt(32)),
                                  CgField("$sv_async_task", CgDataPointer())),
                            parFields),
                     body.hoWrapFields)
  ret CgFunction(f.fnName, f.fnParams, wrappedResult,
                 CgStruct(concat(cgFieldsOfOrEmpty(f.fnStackVars), extra)),
                 concat(body.hoOps, commonOps), f.fnComment, f.fnForeignSymbol,
                 f.fnSync, f.fnTail, f.fnBypassAsync, f.fnAlwaysInline)

fun alHotAssembleAsync(f: CgFunction, stateName: String, subtype: String|None,
                       bbs: List<ABlock>, layout: AFrame, wrappedResult: CgType,
                       body: HotOut, hasPar: Bool): CgFunction
  let nonTerminal = alNonTerminal(bbs)
  let common0 = list2(OpLabel("$asynccommon", List<RParam>()),
                      OpNewObject(stateName, alSvState(), RpInteger(layout.afNArray, 32), List<RParam>()))
  # Save only the suspending site's live set — shared slots must not be
  # clobbered by dead locals — dispatched on the recorded call id (1-based).
  let common1 = append(common0,
                       OpSwitchJump(alSvCallId(),
                                    alSaveCases(chain(nonTerminal), 0, List<OpCase>()),
                                    List<RParam>()))
  let common2 = append(common1, OpJump("$save$done", List<RParam>()))
  let common3 = alSaveBlocks(chain(nonTerminal), stateName, layout, 0, common2)
  let common4 = append(common3, OpLabel("$save$done", List<RParam>()))
  let common5 = concat(common4, list2(
      OpMove(RpObjectField(CgDataPointer(), alSvState(), stateName, "my_task", None, false),
             RpNullPointer(), false, List<RParam>()),
      OpMove(RpObjectField(CgInt(32), alSvState(), stateName, "idx", None, false),
             alSvCallId(), false, List<RParam>())))
  let common6 = concat(common5, alEmitTaskAlloc(alSvTask(), subtype))
  let callback = RpGlobalFunction(f.fnName + "$async", alSvState(), false, None, false, false)
  let common7 = concat(common6, list3(
      OpMove(RpObjectField(CgDataPointer(), alSvState(), stateName, "my_task", None, false),
             alSvTask(), false, List<RParam>()),
      alRuntimeDiscard(alSvDiscard(), "task_on_complete",
                       list2(RpNamedValue("task", alSvAsyncTask()),
                             RpNamedValue("cb", callback))),
      OpReturn(RpTagTask(alSvTask(), wrappedResult), List<RParam>())))
  let parFields = hasPar
    ? list2(CgField("$sv_par_task", CgDataPointer()), CgField("$sv_launcher", CgDataPointer()))
    : List<CgField>()
  let extra = concat(concat(list5(CgField("$sv_state", CgDataPointer()),
                                  CgField("$sv_task", CgDataPointer()),
                                  CgField("$sv_discard", CgDataPointer()),
                                  CgField("$sv_call_id", CgInt(32)),
                                  CgField("$sv_async_task", CgDataPointer())),
                            parFields),
                     body.hoWrapFields)
  ret CgFunction(f.fnName, f.fnParams, wrappedResult,
                 CgStruct(concat(cgFieldsOfOrEmpty(f.fnStackVars), extra)),
                 concat(body.hoOps, common7), f.fnComment, f.fnForeignSymbol,
                 f.fnSync, f.fnTail, f.fnBypassAsync, f.fnAlwaysInline)

fun alSaveCases(bs: Chain<ABlock>, i: Int, acc: List<OpCase>): List<OpCase>
  ret build<OpCase >(alSaveCasesB(bs, i, _pushChain<OpCase >(builder<OpCase >(), chain<OpCase >(acc))))

fun [tail] alSaveCasesB(bs: Chain<ABlock>, i: Int, [terminal] acc: ListBuilder<OpCase >): ListBuilder<OpCase >
  ret match(bs)
    (nil: ChainEnd) => acc
    (l: ChainLink)  => alSaveCasesB(l.next, i + 1,
                                   push<OpCase >(acc, OpCase(i + 1, "$save$" + String(i))))

fun [tail] alSaveBlocks(bs: Chain<ABlock>, stateName: String, layout: AFrame,
                        i: Int, acc: List<Op>): List<Op>
  ret match(bs)
    (nil: ChainEnd) => acc
    (l: ChainLink)  => alSaveBlocks(l.next, stateName, layout, i + 1,
                         concat(append(acc, OpLabel("$save$" + String(i), List<RParam>())),
                                append(alSaveStores(l.value, stateName, layout),
                                       OpJump("$save$done", List<RParam>()))))

# Hot-path $asynccommon save: the base is the freshly-allocated $sv_state
# (Python 948: __store_var(var, __sv_state, ...)).
fun alSaveStores(bb: ABlock, stateName: String, layout: AFrame): List<Op>
  ret fold(svSortedByName(bb.abLive), List<Op>(),
           (a: List<Op>, v: RParam) => concat(a, alStoreVar(v, alSvState(), stateName, layout)))

# ── stub launch (oversized looping bodies) ───────────────────────────────────

fun alStubThresholdOps(): Int
  ret 256

# Stub mode: every UNPLACED param gains a state field (stub stores, entry
# case reloads).
fun alAugmentLayoutWithParams(layout: AFrame, params: List<CgField>): AFrame
  ret fold(params, layout, alAugOne)

fun alAugOne(acc: AFrame, p: CgField): AFrame
  if alPlaced(acc, p.fieldName)
    ret acc
  ret match(p.fieldType)
    (d: CgDataPointer) => AFrame(append(acc.afPtrSlots, NameIdx(p.fieldName, acc.afNArray)),
                                 acc.afInlineSlots, acc.afSlotFields, acc.afNArray + 1, acc.afDecomposed)
    (o: CgType)        => alAugNonPtr(acc, p)

fun alAugNonPtr(acc: AFrame, p: CgField): AFrame
  ret match(alPtrLeaves(p.fieldType))
    (leaves: (ls: List<String>, n: Int)) => AFrame(acc.afPtrSlots, acc.afInlineSlots, acc.afSlotFields,
                                     acc.afNArray + leaves.n,
                                     append(acc.afDecomposed, NameIdx(p.fieldName, acc.afNArray)))
    ()                      => AFrame(acc.afPtrSlots,
                                     append(acc.afInlineSlots, NameStr(p.fieldName, p.fieldName)),
                                     append(acc.afSlotFields, p), acc.afNArray, acc.afDecomposed)

fun alPlaced(acc: AFrame, name: String): Bool
  ret any(acc.afPtrSlots, (e2: NameIdx) => e2.niName == name)
      || any(acc.afInlineSlots, (e2: NameStr) => e2.nsName == name)
      || any(acc.afDecomposed, (e2: NameIdx) => e2.niName == name)
      || any(acc.afSlotFields, (f2: CgField) => f2.fieldName == name)

fun alCreateStubLaunchFunc(f: CgFunction, stateName: String, subtype: String|None,
                           layout: AFrame, entryIdx: Int): CgFunction
  let wrappedResult = wrapReturnType(f.fnResult)
  let ops0 = list1(OpNewObject(stateName, alSvState(), RpInteger(layout.afNArray, 32), List<RParam>()))
  # Stub launch stores into its own fresh $sv_state (Python 1053).
  let ops1 = fold(cgFieldsOfOrEmpty(f.fnParams), ops0, (acc: List<Op>, p: CgField) =>
               concat(acc, alStoreVar(RpStackVar(p.fieldType, p.fieldName), alSvState(), stateName, layout)))
  let ops2 = concat(ops1, list2(
      OpMove(RpObjectField(CgDataPointer(), alSvState(), stateName, "my_task", None, false),
             RpNullPointer(), false, List<RParam>()),
      OpMove(RpObjectField(CgInt(32), alSvState(), stateName, "idx", None, false),
             RpInteger(entryIdx, 32), false, List<RParam>())))
  let ops3 = concat(ops2, alEmitTaskAlloc(alSvTask(), subtype))
  let ops4 = concat(ops3, list3(
      OpMove(RpObjectField(CgDataPointer(), alSvState(), stateName, "my_task", None, false),
             alSvTask(), false, List<RParam>()),
      # The machine's C signature is ($state, $completed_task); the state
      # rides the callee-object slot.
      OpCall(RpGlobalFunction(f.fnName + "$async", alSvState(), false, None, false, false),
             RpNewStruct(list1(RpNamedValue("$completed_task", RpNullPointer()))),
             None, false, false, None, List<RParam>()),
      OpReturn(RpTagTask(alSvTask(), wrappedResult), List<RParam>())))
  # Declare $sv_discard exactly when the ops write it (synthesised-subtype
  # task_init discards through it; the other alloc paths don't).
  let svFields = alOpsWriteDiscard(ops4)
    ? list3(CgField("$sv_state", CgDataPointer()), CgField("$sv_task", CgDataPointer()),
            CgField("$sv_discard", CgDataPointer()))
    : list2(CgField("$sv_state", CgDataPointer()), CgField("$sv_task", CgDataPointer()))
  ret CgFunction(f.fnName, f.fnParams, wrappedResult, CgStruct(svFields), ops4,
                 f.fnComment, f.fnForeignSymbol, f.fnSync, f.fnTail,
                 f.fnBypassAsync, f.fnAlwaysInline)

fun alOpsWriteDiscard(ops: List<Op>): Bool
  ret any(ops, (op: Op) => alWritesDiscard(op))

fun alWritesDiscard(op: Op): Bool
  ret match(op)
    (m: OpMove) => match(m.moveTarget)
      (sv: RpStackVar) => sv.name == "$sv_discard"
      (o: RParam)       => false
    (o2: Op)     => false

# ── state-machine function ───────────────────────────────────────────────────

# void fn$async($state, $completed_task): dispatch on $state->idx, run the
# body on ORDINARY LOCALS (fields touched only at boundaries), park via the
# per-site cold blocks. Deliberately phi-lowered at the resume joins —
# ssa_validate exempts $async multi-defs.
fun alCreateStateMachineFunc(f: CgFunction, stateName: String, subtype: String|None,
                             bbs: List<ABlock>, layout: AFrame, withEntryCase: Bool): CgFunction
  let nt = alNonTerminalN(bbs)
  let nonTerminal = nt.bs
  let n = nt.n
  # Park stores skip loaded-only vars (loop invariants — their field is
  # already current; the only way in is a dispatch load).
  let bodyDefs = fold(bbs, List<String>(), (acc: List<String>, bb: ABlock) =>
                   fold(bb.abOps, acc, (a: List<String>, op: Op) =>
                     fold(alWritesOf(op), a, (a2: List<String>, w: RParam) =>
                       strListAdd(a2, stackVarName(w)))))
  let idxField = RpObjectField(CgInt(32), alStateParam(), stateName, "idx", None, false)
  let myTaskField = RpObjectField(CgDataPointer(), alStateParam(), stateName, "my_task", None, false)
  let dispatch0 = alSmDispatchSwitch(n, withEntryCase, idxField)
  let body = alSmSites(chain(nonTerminal), f, stateName, subtype, layout, bodyDefs,
                       idxField, myTaskField, 0,
                       SmOut(dispatch0, List<Op>(), List<CgField>()))
  let withTerminal = SmOut(concat(body.smOps,
                                  alConvertReturnsSm(alLastBlock(bbs).abOps, myTaskField,
                                                     f.fnResult, subtype)),
                           body.smCold, body.smWrapFields)
  let dispatchTail = alSmDispatchTail(nonTerminal, f, stateName, layout, withEntryCase, bbs)
  let allOps = alPrunePhiSources(concat(concat(withTerminal.smOps, withTerminal.smCold), dispatchTail))
  ret alSmAssemble(f, allOps, bbs, withTerminal.smWrapFields)

class [final] SmOut(smOps: List<Op>, smCold: List<Op>, smWrapFields: List<CgField>)

fun alSmDispatchSwitch(n: Int, withEntryCase: Bool, idxField: RParam): List<Op>
  let cases = alSmCases(n, 0, List<OpCase>())
  let cases2 = withEntryCase ? append(cases, OpCase(n + 1, "$case$entry")) : cases
  let sw = list1(OpSwitchJump(idxField, cases2, List<RParam>()))
  ret withEntryCase ? append(sw, OpLabel("$sm$body", List<RParam>())) : sw

fun [tail] alSmCases(n: Int, i: Int, acc: List<OpCase>): List<OpCase>
  if i >= n
    ret acc
  ret alSmCases(n, i + 1, append(acc, OpCase(i + 1, "$case$" + String(i + 1))))

fun [tail] alSmSites(bs: Chain<ABlock>, f: CgFunction, stateName: String,
                     subtype: String|None, layout: AFrame, bodyDefs: List<String>,
                     idxField: RParam, myTaskField: RParam, i: Int, acc: SmOut): SmOut
  ret match(bs)
    (nil: ChainEnd) => acc
    (l: ChainLink)  => alSmSites(l.next, f, stateName, subtype, layout, bodyDefs,
                                 idxField, myTaskField, i + 1,
                                 alSmSite(l.value, f, stateName, subtype, layout, bodyDefs,
                                          idxField, myTaskField, i, acc))

fun alSmSite(bb: ABlock, f: CgFunction, stateName: String, subtype: String|None,
             layout: AFrame, bodyDefs: List<String>, idxField: RParam,
             myTaskField: RParam, i: Int, acc: SmOut): SmOut
  let bodyOps = alConvertReturnsSm(alDropLast(bb.abOps), myTaskField, f.fnResult, subtype)
  # SM saves address the $state parameter (Python 1179).
  let saveStores = fold(svSortedByName(bb.abLive), List<Op>(), (a: List<Op>, v: RParam) =>
                     strListMember(bodyDefs, stackVarName(v))
                       ? concat(a, alStoreVar(v, alStateParam(), stateName, layout))
                       : a)
  ret match(lastOp(chain(bb.abOps)))
    (op: Op) => match(op)
      (pc: OpParallelCall) => alSmPar(pc, f, stateName, layout, idxField, i,
                                      SmOut(concat(acc.smOps, bodyOps), acc.smCold, acc.smWrapFields),
                                      saveStores)
      (c: OpCall)          => alSmCall(c, f, idxField, i,
                                      SmOut(concat(acc.smOps, bodyOps), acc.smCold, acc.smWrapFields),
                                      saveStores)
      (o: Op)               => acc   # unreachable
    ()        => acc

# A ParallelCall always parks.
fun alSmPar(pc: OpParallelCall, f: CgFunction, stateName: String, layout: AFrame,
            idxField: RParam, i: Int, acc: SmOut, saveStores: List<Op>): SmOut
  let parTaskName = "task$par$" + String(i) + "$" + f.fnName
  let svParSm = RpStackVar(CgDataPointer(), "$sv_par_sm$" + String(i))
  let svLauncherSm = RpStackVar(CgDataPointer(), "$sv_launcher_sm$" + String(i))
  let closures = alClosuresCounted(chain(pc.parCalls), 0, List<RParam>())
  let ops1 = concat(acc.smOps, alEmitParTaskSetup(svParSm, parTaskName, closures.cs, closures.n))
  let ops2 = alSmParLaunchers(ops1, svLauncherSm, svParSm, f.fnName, i, chain(pc.parCalls), 0)
  let ops3 = concat(concat(ops2, saveStores),
                    alEmitSuspendToAsync(idxField, i + 1, svParSm, f.fnName))
  ret SmOut(append(ops3, OpLabel("$resume$" + String(i), List<RParam>())),
            acc.smCold,
            concat(acc.smWrapFields, list2(CgField("$sv_par_sm$" + String(i), CgDataPointer()),
                                           CgField("$sv_launcher_sm$" + String(i), CgDataPointer()))))

fun [tail] alSmParLaunchers(acc: List<Op>, launcherVar: RParam, parVar: RParam,
                            fnName: String, site: Int, calls: Chain<RParam>, k: Int): List<Op>
  ret match(calls)
    (nil: ChainEnd) => acc
    (l: ChainLink)  => alSmParLaunchers(
        concat(acc, alEmitPostLauncher(launcherVar, parVar, fnName, site, k)),
        launcherVar, parVar, fnName, site, l.next, k + 1)

fun alSmCall(c: OpCall, f: CgFunction, idxField: RParam, i: Int,
             acc: SmOut, saveStores: List<Op>): SmOut
  ret match(c.callRegister)
    (reg: RParam) => alSmValued(c, reg, f, idxField, i, acc, saveStores)
    ()             => alSmNoReg(c, f, idxField, i, acc, saveStores)

fun alSmNoReg(c: OpCall, f: CgFunction, idxField: RParam, i: Int,
              acc: SmOut, saveStores: List<Op>): SmOut
  ret match(c.callResultType)
    # Discarded non-void: $sm_wrap$<i> register, IS_TASK, no unwrap.
    (dt: CgType) => alSmChecked(c, RpStackVar(wrapReturnType(dt), "$sm_wrap$" + String(i)),
                                wrapReturnType(dt), None, true, f, idxField, i, acc, saveStores)
    # Pure void: no check; resume label directly after the call.
    ()            => SmOut(concat(append<Op>(acc.smOps, c),
                                  list1(OpLabel("$resume$" + String(i), List<RParam>()))),
                           acc.smCold, acc.smWrapFields)

fun alSmValued(c: OpCall, reg: RParam, f: CgFunction, idxField: RParam, i: Int,
               acc: SmOut, saveStores: List<Op>): SmOut
  let resultType = rpGetType(reg)
  let wrappedType = wrapReturnType(resultType)
  ret eqCgType(wrappedType, resultType)
    ? alSmChecked(c, reg, wrappedType, None, false, f, idxField, i, acc, saveStores)
    : alSmChecked(c, RpStackVar(wrappedType, "$sm_wrap$" + String(i)), wrappedType,
                  OpMove(reg, RpStructField(RpStackVar(wrappedType, "$sm_wrap$" + String(i)), "value"),
                         false, List<RParam>()),
                  true, f, idxField, i, acc, saveStores)

# The IS_TASK check + unwrap sit BEFORE $resume$<i> (sync edge only); the
# park path is the ONLY place block i's locals reach the state object.
fun alSmChecked(c: OpCall, svCheck: RParam, checkType: CgType, unwrapOp: Op|None,
                retarget: Bool, f: CgFunction, idxField: RParam, i: Int,
                acc: SmOut, saveStores: List<Op>): SmOut
  let callOp = retarget
    ? OpCall(c.callFunction, c.callParameters, svCheck, c.callMusttail, c.callImpure,
             c.callResultType, c.callSavedVars)
    : c
  let check = RpRuntimeInvoke("UNLIKELY",
                              RpNewStruct(list1(RpNamedValue("x", isTaskParam(svCheck, checkType)))),
                              CgInt(32))
  let asyncLabel = "$async_sm$" + String(i)
  let ops1 = concat(append(acc.smOps, callOp),
                    list1(OpJumpIf(asyncLabel, check, false, List<RParam>())))
  let ops2 = match(unwrapOp)
    (u: Op) => append(ops1, u)
    ()       => ops1
  let ops3 = append(ops2, OpLabel("$resume$" + String(i), List<RParam>()))
  let untagged = RpRuntimeInvoke("TASK_UNTAG",
                                 RpNewStruct(list1(RpNamedValue("p", taskPtrFrom(svCheck, checkType)))),
                                 CgDataPointer())
  let cold1 = concat(append(acc.smCold, OpLabel(asyncLabel, List<RParam>())), saveStores)
  let cold2 = concat(cold1, alEmitSuspendToAsync(idxField, i + 1, untagged, f.fnName))
  let wraps = retarget
    ? append(acc.smWrapFields, CgField(stackVarName(svCheck), checkType))
    : acc.smWrapFields
  ret SmOut(ops3, cold2, wraps)

# Dispatch cases at the tail: reload the site's live set, extract the
# completed call's result, jump to the resume point.
fun alSmDispatchTail(nonTerminal: List<ABlock>, f: CgFunction, stateName: String,
                     layout: AFrame, withEntryCase: Bool, bbs: List<ABlock>): List<Op>
  let cases = alSmDtLoop(chain(nonTerminal), f, stateName, layout, 0, List<Op>())
  ret withEntryCase ? concat(cases, alSmEntryCase(f, stateName, layout, nonTerminal)) : cases

fun [tail] alSmDtLoop(bs: Chain<ABlock>, f: CgFunction, stateName: String,
                      layout: AFrame, i: Int, acc: List<Op>): List<Op>
  ret match(bs)
    (nil: ChainEnd) => acc
    (l: ChainLink)  => alSmDtLoop(l.next, f, stateName, layout, i + 1,
                                  alSmDtCase(l.value, f, stateName, layout, i, acc))

fun alSmDtCase(bb: ABlock, f: CgFunction, stateName: String, layout: AFrame,
               i: Int, acc: List<Op>): List<Op>
  let loads = fold(svSortedByName(bb.abLive), List<Op>(), (a: List<Op>, v: RParam) =>
                concat(a, alLoadVar(v, alStateParam(), stateName, layout)))
  let ops1 = concat(append(acc, OpLabel("$case$" + String(i + 1), List<RParam>())), loads)
  let ops2 = concat(ops1, alSmDtExtract(bb, f, i))
  ret append(ops2, OpJump("$resume$" + String(i), List<RParam>()))

fun alSmDtExtract(bb: ABlock, f: CgFunction, i: Int): List<Op>
  ret match(lastOp(chain(bb.abOps)))
    (op: Op) => match(op)
      (pc: OpParallelCall) => alSmDtPar(pc, f, i)
      (o: Op)               => alSmDtResult(bb)
    ()        => List<Op>()

# Completed par_task: assemble the result tuple from its result_k fields.
fun alSmDtPar(pc: OpParallelCall, f: CgFunction, i: Int): List<Op>
  ret match(pc.parRegister)
    (reg: RParam) => list1(OpMove(reg,
        RpNewStruct(alSmDtParFields(chain(pc.parResults), "task$par$" + String(i) + "$" + f.fnName, 0, List<RpNamedValue>())),
        false, List<RParam>()))
    ()             => List<Op>()

fun alSmDtParFields(rs: Chain<RParam>, parTaskName: String, k: Int,
                           acc: List<RpNamedValue>): List<RpNamedValue>
  ret build<RpNamedValue >(alSmDtParFieldsB(rs, parTaskName, k, _pushChain<RpNamedValue >(builder<RpNamedValue >(), chain<RpNamedValue >(acc))))

fun [tail] alSmDtParFieldsB(rs: Chain<RParam>, parTaskName: String, k: Int,
                           [terminal] acc: ListBuilder<RpNamedValue >): ListBuilder<RpNamedValue >
  ret match(rs)
    (nil: ChainEnd) => acc
    (l: ChainLink)  => alSmDtParFieldsB(l.next, parTaskName, k + 1,
        push<RpNamedValue >(acc, RpNamedValue("_" + String(k),
          RpObjectField(rpGetType(l.value), alCompletedParam(),
                        parTaskName, "result_" + String(k), None, false))))

fun alSmDtResult(bb: ABlock): List<Op>
  ret match(bb.abResult)
    (reg: RParam) => match(taskSubtypeName(rpGetType(reg)))
      (st: String) => list1(OpMove(reg,
                        RpObjectField(rpGetType(reg), alCompletedParam(), st, "result", None, false),
                        false, List<RParam>()))
      ()            => list1(OpMove(reg, RpNullPointer(), false, List<RParam>()))
    ()             => List<Op>()

# Entry case (stub mode): load params, then every live var not yet loaded
# (the zero-filled field equals the old field-addressed semantics).
fun alSmEntryCase(f: CgFunction, stateName: String, layout: AFrame,
                  nonTerminal: List<ABlock>): List<Op>
  let ops0 = list1(OpLabel("$case$entry", List<RParam>()))
  let paramLoads = fold(cgFieldsOfOrEmpty(f.fnParams), (ops0, List<String>()),
                        (acc: (ops: List<Op>, seen: List<String>), p: CgField) =>
                          (concat(acc.ops, alLoadVar(RpStackVar(p.fieldType, p.fieldName), alStateParam(), stateName, layout)),
                           strListAdd(acc.seen, p.fieldName)))
  let liveLoads = fold(nonTerminal, paramLoads, (acc: (ops: List<Op>, seen: List<String>), bb: ABlock) =>
                    fold(svSortedByName(bb.abLive), acc,
                         (a: (ops: List<Op>, seen: List<String>), v: RParam) =>
                           strListMember(a.seen, stackVarName(v))
                             ? a
                             : (concat(a.ops, alLoadVar(v, alStateParam(), stateName, layout)),
                                strListAdd(a.seen, stackVarName(v)))))
  ret append(liveLoads.ops, OpJump("$sm$body", List<RParam>()))

fun alSmAssemble(f: CgFunction, allOps: List<Op>, bbs: List<ABlock>,
                 wrapFields: List<CgField>): CgFunction
  # Params become plain locals (the SM's own signature is $state/$completed);
  # block result registers not otherwise declared ($musttail$ret$N) too.
  let declared = map(cgFieldsOfOrEmpty(f.fnStackVars), (fld: CgField) => fld.fieldName)
  let withParams = fold(cgFieldsOfOrEmpty(f.fnParams), (List<CgField>(), declared),
                        (acc: (fs: List<CgField>, seen: List<String>), p: CgField) =>
                          strListMember(acc.seen, p.fieldName)
                            ? acc
                            : (append(acc.fs, p), strListAdd(acc.seen, p.fieldName)))
  let withResults = fold(bbs, withParams, (acc: (fs: List<CgField>, seen: List<String>), bb: ABlock) =>
                      alSmDeclareResult(acc, bb))
  ret CgFunction(f.fnName + "$async",
                 CgStruct(list2(CgField("$state", CgDataPointer()),
                                CgField("$completed_task", CgDataPointer()))),
                 CgVoid(),
                 # extra_stack = ($sv_discard,) + sm_wrap_fields — discard FIRST
                 # (Python async_lower.py:1343; declaration order is C order).
                 CgStruct(concat(concat(cgFieldsOfOrEmpty(f.fnStackVars), withResults.fs),
                                 prepend<CgField>(CgField("$sv_discard", CgDataPointer()), wrapFields))),
                 allOps, f.fnComment, None, false, false, false, false)

fun alSmDeclareResult(acc: (fs: List<CgField>, seen: List<String>), bb: ABlock): (fs: List<CgField>, seen: List<String>)
  ret match(bb.abResult)
    (reg: RParam) => strListMember(acc.seen, stackVarName(reg))
      ? acc
      : (append(acc.fs, CgField(stackVarName(reg), rpGetType(reg))), strListAdd(acc.seen, stackVarName(reg)))
    ()             => acc

# Drop Phi sources whose predecessor labels now live in the OTHER function;
# an all-pruned Phi disappears (its target is written elsewhere).
fun alPrunePhiSources(ops: List<Op>): List<Op>
  let preds = ucPhiEdgesPreds(ops)
  ret alPpsLoop(chain(ops), preds, "", List<Op>())

class [final] BlockPreds(bpLabel: String, bpPreds: List<String>)

fun ucPhiEdgesPreds(ops: List<Op>): List<BlockPreds>
  ret alBpLoop(chain(ops), None, "", List<BlockPreds>())

# The preceding op is CARRIED rather than re-indexed: alBpFall only ever needs
# ops[i-1], and `prev` is None exactly where the index form tested i == 0.
fun [tail] alBpLoop(os: Chain<Op>, prev: Op|None, cur: String,
                    acc: List<BlockPreds>): List<BlockPreds>
  ret match(os)
    (nil: ChainEnd) => acc
    (l: ChainLink)  => match(l.value)
      (lb: OpLabel) => alBpLoop(l.next, lb, lb.labelName,
                                alBpFall(prev, cur, lb.labelName, acc))
      (o: Op)       => alBpLoop(l.next, o, cur, alBpJumps(o, cur, acc))

fun alBpFall(prev: Op|None, cur: String, label: String, acc: List<BlockPreds>): List<BlockPreds>
  if length(cur) == 0
    ret acc
  ret match(prev)
    (p: Op) => ucPrevFallsIntoLabel(p) ? alBpAdd(acc, label, cur) : acc
    ()      => acc

fun alBpJumps(op: Op, cur: String, acc: List<BlockPreds>): List<BlockPreds>
  if length(cur) == 0
    ret acc
  ret match(op)
    (j: OpJump)        => alBpAdd(acc, j.jumpName, cur)
    (ji: OpJumpIf)     => alBpAdd(acc, ji.jumpIfLabel, cur)
    (t2: OpIfTask)     => alBpAdd(acc, t2.taskTarget, cur)
    (sw: OpSwitchJump) => fold(sw.switchCases, acc,
                               (a: List<BlockPreds>, cs: OpCase) => alBpAdd(a, cs.caseLabel, cur))
    (o: Op)            => acc

fun alBpAdd(acc: List<BlockPreds>, label: String, pred: String): List<BlockPreds>
  ret any(acc, (e2: BlockPreds) => e2.bpLabel == label)
    ? map(acc, (e2: BlockPreds) => e2.bpLabel == label
                 ? BlockPreds(label, strListAdd(e2.bpPreds, pred)) : e2)
    : append(acc, BlockPreds(label, list1(pred)))

fun alBpOf(acc: List<BlockPreds>, label: String): List<String>
  ret match(head(filter(acc, (e2: BlockPreds) => e2.bpLabel == label)))
    (e2: BlockPreds) => e2.bpPreds
    ()                => List<String>()

fun [tail] alPpsLoop(os: Chain<Op>, preds: List<BlockPreds>, cur: String,
                     acc: List<Op>): List<Op>
  ret match(os)
    (nil: ChainEnd) => acc
    (l: ChainLink)  => match(l.value)
      (lb: OpLabel) => alPpsLoop(l.next, preds, lb.labelName, append(acc, l.value))
      (ph: OpPhi)   => alPpsLoop(l.next, preds, cur, alPpsPhi(acc, ph, preds, cur))
      (o: Op)       => alPpsLoop(l.next, preds, cur, append(acc, o))

fun alPpsPhi(acc: List<Op>, ph: OpPhi, preds: List<BlockPreds>, cur: String): List<Op>
  if length(cur) == 0
    ret append<Op>(acc, ph)
  let blockPreds = alBpOf(preds, cur)
  let kept = filter(ph.phiSources, (s2: OpPhiSource) => strListMember(blockPreds, s2.sourceLabel))
  ret sameLen(chain(kept), chain(ph.phiSources))
    ? append<Op>(acc, ph)
    : (isEmpty(kept) ? acc : append(acc, OpPhi(ph.phiTarget, kept, ph.phiSavedVars)))

# ── per-function orchestrator ────────────────────────────────────────────────

class [final] AlOut(aloFunctions: List<CgFunction>, aloObjects: List<CgObject>)

fun alConvertFunction(f: CgFunction): AlOut
  if f.fnName == "__entrypoint__" || f.fnBypassAsync
    ret AlOut(list1(f), List<CgObject>())
  let afterTail = alDiscoverTailCalls(f)
  let stateName = f.fnName + "$state"
  let built = alCreateBasicBlocksN(afterTail)
  if !atLeast(chain(built.bs), 2)
    ret AlOut(list1(alSimpleWrap(afterTail)), List<CgObject>())
  ret alConvertMulti(f, afterTail, stateName, built.bs, built.n)

# <2 blocks: only the return type adjusts (SyncWrap promotion when wrapped).
fun alSimpleWrap(f: CgFunction): CgFunction
  let wrapped = wrapReturnType(f.fnResult)
  ret match(wrapped)
    (w: CgTaskWrapper) => CgFunction(f.fnName, f.fnParams, wrapped, f.fnStackVars,
                                     alConvertReturnsHot(f.fnOps, wrapped),
                                     f.fnComment, f.fnForeignSymbol, f.fnSync,
                                     f.fnTail, f.fnBypassAsync, f.fnAlwaysInline)
    (o: CgType)         => CgFunction(f.fnName, f.fnParams, wrapped, f.fnStackVars,
                                     f.fnOps, f.fnComment, f.fnForeignSymbol,
                                     f.fnSync, f.fnTail, f.fnBypassAsync, f.fnAlwaysInline)

fun alConvertMulti(f: CgFunction, afterTail: CgFunction, stateName: String,
                   bbs: List<ABlock>, nBbs: Int): AlOut
  let subtype = taskSubtypeName(f.fnResult)
  # The SM view (musttail unrolled) defines the authoritative frame layout.
  let smFn = any(afterTail.fnOps, alIsMusttailCall) ? alUnrollMusttail(afterTail) : afterTail
  let smBuilt = any(afterTail.fnOps, alIsMusttailCall)
    ? alCreateBasicBlocksN(smFn)
    : (bbs, nBbs)
  let smBbs = smBuilt.bs
  let layout0 = alComputeFrameLayout(smBbs, bbs, alCalculateSavedVars(smFn).fnOps)
  let useStub = !f.fnSync && atLeast(chain(smFn.fnOps), alStubThresholdOps() + 1) && alHasParkingLoop(smFn.fnOps)
  let layout = useStub ? alAugmentLayoutWithParams(layout0, cgFieldsOfOrEmpty(f.fnParams)) : layout0
  let hotFn = useStub
    ? alCreateStubLaunchFunc(afterTail, stateName, subtype, layout, smBuilt.n)
    : alCreateHotPathFunc(afterTail, stateName, subtype, bbs, layout)
  let par = alParMachinery(f, bbs)
  if f.fnSync
    ret AlOut(concat(list1(hotFn), par.aloFunctions), par.aloObjects)
  let stateObj = alCreateStateObject(smFn, stateName, layout)
  let machineFn = alCreateStateMachineFunc(smFn, stateName, subtype, smBbs, layout, useStub)
  ret AlOut(concat(list2(hotFn, machineFn), par.aloFunctions),
            concat(list1(stateObj), par.aloObjects))

fun alIsMusttailCall(op: Op): Bool
  ret match(op)
    (c: OpCall) => c.callMusttail
    (o: Op)     => false

# Jump/JumpIf/Switch to an ALREADY-SEEN label = a loop.
# Stub only when a PARK SITE lies inside a loop (Python has_parking_loop): a
# back edge alone is not enough — a compute-only loop never parks at runtime,
# and stubbing it turns a zero-allocation call into a heap state allocation
# per call. Walk once, recording the park count at each label; a jump back to
# a seen label with parks accrued since is a parking loop. Park ops = exactly
# what the basic-block builder splits on (non-musttail Call, ParallelCall).
fun alHasParkingLoop(ops: List<Op>): Bool
  ret alHplLoop(chain(ops), Dict<String, Int>(), 0)

fun [tail] alHplLoop(ops: Chain<Op>, labelParks: Dict<String, Int>,
                     parks: Int): Bool
  ret match(ops)
    (nil: ChainEnd) => false
    (l: ChainLink)  => match(l.value)
      (lb: OpLabel)        => alHplLoop(l.next,
                                        put(labelParks, lb.labelName, parks),
                                        parks)
      (c: OpCall)          => alHplLoop(l.next, labelParks,
                                        c.callMusttail ? parks : parks + 1)
      (pc: OpParallelCall) => alHplLoop(l.next, labelParks, parks + 1)
      (j: OpJump)          => alHplHit(labelParks, j.jumpName, parks)
        ? true : alHplLoop(l.next, labelParks, parks)
      (ji: OpJumpIf)       => alHplHit(labelParks, ji.jumpIfLabel, parks)
        ? true : alHplLoop(l.next, labelParks, parks)
      (sw: OpSwitchJump)   => any(sw.switchCases, (cs: OpCase) =>
                                    alHplHit(labelParks, cs.caseLabel, parks))
        ? true : alHplLoop(l.next, labelParks, parks)
      (o: Op)              => alHplLoop(l.next, labelParks, parks)

fun alHplHit(labelParks: Dict<String, Int>, name: String, parks: Int): Bool
  ret match(get(labelParks, name))
    (atLabel: Int) => parks > atLabel
    ()              => false

# ── parallel machinery ───────────────────────────────────────────────────────

fun alParMachinery(f: CgFunction, bbs: List<ABlock>): AlOut
  ret alPmLoop(chain(alNonTerminal(bbs)), f, 0, AlOut(List<CgFunction>(), List<CgObject>()))

fun [tail] alPmLoop(bs: Chain<ABlock>, f: CgFunction, i: Int, acc: AlOut): AlOut
  ret match(bs)
    (nil: ChainEnd) => acc
    (l: ChainLink)  => alPmLoop(l.next, f, i + 1, alPmOne(l.value, f, i, acc))

fun alPmOne(bb: ABlock, f: CgFunction, i: Int, acc: AlOut): AlOut
  ret match(lastOp(chain(bb.abOps)))
    (op: Op) => match(op)
      (pc: OpParallelCall) => alPmSite(pc, f, i, acc)
      (o: Op)               => acc
    ()        => acc

fun alPmSite(pc: OpParallelCall, f: CgFunction, i: Int, acc: AlOut): AlOut
  let parTaskName = "task$par$" + String(i) + "$" + f.fnName
  let resTypes = map(pc.parResults, rpGetType)
  let obj = alParTaskObject(parTaskName, resTypes)
  ret alPmSlots(chain(resTypes), chain(pc.parCalls), f, i, parTaskName, 0,
                AlOut(acc.aloFunctions, append(acc.aloObjects, obj)))

# The result types and the call refs are walked in lockstep — one slot per
# pair, as many slots as the ParallelCall has (the two are equal by
# construction: resTypes IS map(pc.parResults, rpGetType)).
fun [tail] alPmSlots(ts: Chain<CgType>, cs: Chain<RParam>, f: CgFunction, site: Int,
                     parTaskName: String, k: Int, acc: AlOut): AlOut
  ret match(ts)
    (nil: ChainEnd) => acc
    (lt: ChainLink) => match(cs)
      (lc: ChainLink)  => alPmSlots(lt.next, lc.next, f, site, parTaskName, k + 1,
                            alPmSlot(lt.value, lc.value, f, site, parTaskName, k, acc))
      (nil2: ChainEnd) => acc

fun alPmSlot(rt: CgType, callRef: RParam, f: CgFunction, site: Int,
             parTaskName: String, k: Int, acc: AlOut): AlOut
  let cb = alSlotCallback(f.fnName, site, k, parTaskName, rt)
  let launcher = alLauncherCallback(f.fnName, site, k, parTaskName,
                                    alLambdaNameOf(callRef, k), rt)
  ret AlOut(concat(acc.aloFunctions, list2(cb, launcher)), acc.aloObjects)

fun alLambdaNameOf(callRef: RParam, k: Int): String
  ret match(callRef)
    (gf: RpGlobalFunction) => gf.name
    (o: RParam)             => "__unknown_" + String(k) + "__"

# par_task: task_t prefix + remaining + closure_k + result_k.
fun alParTaskObject(parTaskName: String, resultTypes: List<CgType>): CgObject
  let fields0 = append(taskFields(), CgField("remaining", CgInt(32)))
  let fields1 = alPtoClosures(fields0, chain(resultTypes), 0)
  let fields2 = alPtoResults(fields1, chain(resultTypes), 0, 0)
  ret CgObject(parTaskName, list1("task"), List<CgFuncSlot>(),
               CgImmediateStruct(fields2.fs),
               None, "parallel join task with " + String(fields2.n) + " slots",
               false, true, 0)

fun alPtoClosures(acc: List<CgField>, ts: Chain<CgType>, k: Int): List<CgField>
  ret build<CgField >(alPtoClosuresB(_pushChain<CgField >(builder<CgField >(), chain<CgField >(acc)), ts, k))

fun [tail] alPtoClosuresB([terminal] acc: ListBuilder<CgField >, ts: Chain<CgType>, k: Int): ListBuilder<CgField >
  ret match(ts)
    (nil: ChainEnd) => acc
    (l: ChainLink)  => alPtoClosuresB(push<CgField >(acc, CgField("closure_" + String(k), CgDataPointer())), l.next, k + 1)

fun [tail] alPtoResults(acc: List<CgField>, ts: Chain<CgType>, k: Int,
                        n: Int): (fs: List<CgField>, n: Int)
  ret match(ts)
    (nil: ChainEnd) => (acc, n)
    (l: ChainLink)  => alPtoResults(append(acc, CgField("result_" + String(k), l.value)),
                                    l.next, k + 1, n + 1)

# Slot callback: result_k = extract(completed sub-task) + task_par_decrement.
fun alSlotCallback(fnName: String, site: Int, slot: Int, parTaskName: String,
                   resultType: CgType): CgFunction
  let svPar = RpStackVar(CgDataPointer(), "$par_task")
  let svSub = RpStackVar(CgDataPointer(), "$completed_sub_task")
  let svDiscardCb = RpStackVar(CgDataPointer(), "$sv_discard_cb")
  let extract = match(taskSubtypeName(resultType))
    (st: String) => alIsVoid(resultType)
      ? List<Op>()
      : list1(OpMove(RpObjectField(resultType, svPar, parTaskName, "result_" + String(slot), None, false),
                     RpObjectField(resultType, svSub, st, "result", None, false),
                     false, List<RParam>()))
    ()            => List<Op>()
  let ops = concat(extract, list2(
      alRuntimeDiscard(svDiscardCb, "task_par_decrement", list1(RpNamedValue("par_task", svPar))),
      OpReturn(RpNullPointer(), List<RParam>())))
  ret CgFunction(fnName + "$par$" + String(site) + "$slot$" + String(slot),
                 CgStruct(list2(CgField("$par_task", CgDataPointer()),
                                CgField("$completed_sub_task", CgDataPointer()))),
                 CgDataPointer(),
                 CgStruct(list1(CgField("$sv_discard_cb", CgDataPointer()))),
                 ops, "", None, false, false, false, false)

# Launcher: read closure_k, call the lambda; sync → write result + decrement;
# async → register the slot callback on the returned task.
fun alLauncherCallback(fnName: String, site: Int, slot: Int, parTaskName: String,
                       lambdaName: String, resultType: CgType): CgFunction
  let svPar = RpStackVar(CgDataPointer(), "$par_task")
  let svClosure = RpStackVar(CgDataPointer(), "$launcher_closure")
  let wrappedType = wrapReturnType(resultType)
  let needsTemp = !eqCgType(wrappedType, resultType)
  let svResultW = RpStackVar(wrappedType, "$result_w")
  let svDiscardCb = RpStackVar(CgDataPointer(), "$sv_discard_cb")
  let unwrapped = needsTemp ? RpStructField(svResultW, "value") : svResultW
  let slotCb = RpGlobalFunction(fnName + "$par$" + String(site) + "$slot$" + String(slot),
                                svPar, false, None, false, false)
  let untag = RpRuntimeInvoke("TASK_UNTAG",
                              RpNewStruct(list1(RpNamedValue("p", taskPtrFrom(svResultW, wrappedType)))),
                              CgDataPointer())
  let ops = concat(concat(list5(
      OpMove(svClosure, RpObjectField(CgDataPointer(), svPar, parTaskName, "closure_" + String(slot), None, false),
             false, List<RParam>()),
      OpCall(RpGlobalFunction(lambdaName, svClosure, false, None, false, false),
             RpNewStruct(List<RpNamedValue>()), svResultW, false, false, None, List<RParam>()),
      OpJumpIf("$launcher_async",
               RpRuntimeInvoke("UNLIKELY",
                               RpNewStruct(list1(RpNamedValue("x", isTaskParam(svResultW, wrappedType)))),
                               CgInt(32)), false, List<RParam>()),
      OpMove(RpObjectField(resultType, svPar, parTaskName, "result_" + String(slot), None, false),
             unwrapped, false, List<RParam>()),
      alRuntimeDiscard(svDiscardCb, "task_par_decrement", list1(RpNamedValue("par_task", svPar)))),
    list3(
      OpJump("$launcher_done", List<RParam>()),
      OpLabel("$launcher_async", List<RParam>()),
      alRuntimeDiscard(svDiscardCb, "task_on_complete",
                       list2(RpNamedValue("task", untag), RpNamedValue("cb", slotCb))))),
    list2(OpLabel("$launcher_done", List<RParam>()),
          OpReturn(RpNullPointer(), List<RParam>())))
  ret CgFunction(fnName + "$par$" + String(site) + "$launcher$" + String(slot),
                 CgStruct(list2(CgField("$par_task", CgDataPointer()),
                                CgField("$launched_task", CgDataPointer()))),
                 CgDataPointer(),
                 CgStruct(list3(CgField("$launcher_closure", CgDataPointer()),
                                CgField("$result_w", wrappedType),
                                CgField("$sv_discard_cb", CgDataPointer()))),
                 ops, "", None, false, false, false, false)

# ── task-subtype collection ──────────────────────────────────────────────────

# One subtype per distinct non-Void return type + the foreign task object.
# The DRIVER unions these with app objects LETTING APP WIN — lazy_thunks
# pre-registers subtypes under the same names; never flip the union.
fun collectTaskSubtypes(a: CgApp): List<CgObject>
  let subs = fold(a.appFunctions, List<CgObject>(), alCtsOne)
  ret append(subs, makeTaskForeignObject())

fun alCtsOne(acc: List<CgObject>, f: CgFunction): List<CgObject>
  if alIsVoid(f.fnResult)
    ret acc
  ret match(taskSubtypeName(f.fnResult))
    (name: String) => any(acc, (o: CgObject) => o.objName == name)
      ? acc
      : append(acc, makeTaskSubtypeObject(name, alCtsInner(f.fnResult)))
    ()              => acc

fun alCtsInner(t2: CgType): CgType
  ret match(t2)
    (w: CgTaskWrapper) => w.inner
    (o: CgType)         => t2

# ── __parallel__ backpressure outlining ──────────────────────────────────────

# Each well-formed ParallelCall (register present, every call a
# GlobalFunction) is replaced by a call to a synthesised fn$par_site$<opidx>
# helper: sequential arm when the pool is saturated, the original
# ParallelCall otherwise — same tuple either way.
fun alOutlineParallelSites(f: CgFunction): AlOut2
  if !any(f.fnOps, alOpIsParallel)
    ret AlOut2(f, List<CgFunction>())
  ret alOpsLoop(chain(f.fnOps), f, 0, List<Op>(), List<CgFunction>())

class [final] AlOut2(alo2Fn: CgFunction, alo2Helpers: List<CgFunction>)

fun alOpIsParallel(op: Op): Bool
  ret match(op)
    (pc: OpParallelCall) => true
    (o: Op)               => false

fun [tail] alOpsLoop(os: Chain<Op>, f: CgFunction, i: Int, acc: List<Op>,
                     helpers: List<CgFunction>): AlOut2
  ret match(os)
    (nil: ChainEnd) => AlOut2(cgFunctionWith(f, acc, f.fnStackVars), helpers)
    (l: ChainLink)  => match(alOutlineOne(l.value, f, i))
      (o2: OutlineOne) => alOpsLoop(l.next, f, i + 1, append(acc, o2.ooSiteCall),
                                    append(helpers, o2.ooHelper))
      ()                => alOpsLoop(l.next, f, i + 1, append(acc, l.value), helpers)

class [final] OutlineOne(ooSiteCall: Op, ooHelper: CgFunction)

fun alOutlineOne(op: Op, f: CgFunction, opIndex: Int): OutlineOne|None
  ret match(op)
    (pc: OpParallelCall) => alWellFormedPc(pc) ? alBuildOutline(pc, f, opIndex) : None
    (o: Op)               => None

fun alWellFormedPc(pc: OpParallelCall): Bool
  ret !isNoneR(pc.parRegister) && !any(pc.parCalls, (c: RParam) => !alIsGlobalFn(c))

fun isNoneR(r: RParam|None): Bool
  ret match(r)
    (x: RParam) => false
    ()           => true

fun alIsGlobalFn(c: RParam): Bool
  ret match(c)
    (gf: RpGlobalFunction) => true
    (o: RParam)             => false

fun alBuildOutline(pc: OpParallelCall, f: CgFunction, opIndex: Int): OutlineOne
  let helperName = f.fnName + "$par_site$" + String(opIndex)
  let closureParams = alCpList(chain(pc.parCalls), 0, List<RParam>())
  let helperCalls = alHcList(chain(pc.parCalls), chain(closureParams), List<RParam>())
  let svAccepting = RpStackVar(CgInt(32), "$accepting")
  let register = alForceRegister(pc.parRegister)
  let seqCalls = alSeqCalls(chain(helperCalls), chain(pc.parResults), List<Op>())
  let helperOps = concat(concat(list2(
      OpMove(svAccepting, RpRuntimeInvoke("thread_work_accepting",
                                          RpNewStruct(List<RpNamedValue>()), CgInt(32)),
             false, List<RParam>()),
      OpJumpIf("$fork", svAccepting, false, List<RParam>())),
    append(seqCalls,
      OpMove(register, RpNewStruct(alTupleFields(chain(pc.parResults), 0, List<RpNamedValue>())),
             false, List<RParam>()))),
    list4(OpReturn(register, List<RParam>()),
          OpLabel("$fork", List<RParam>()),
          OpParallelCall(helperCalls, pc.parResults, pc.parRegister, List<RParam>()),
          OpReturn(register, List<RParam>())))
  let helperParams = concat(list1(CgField("$unused_self", CgDataPointer())),
                            map(closureParams, (p: RParam) => CgField(stackVarName(p), CgDataPointer())))
  let helperStack = append(append(map(pc.parResults, (r: RParam) => CgField(stackVarName(r), rpGetType(r))),
                                  CgField(stackVarName(register), rpGetType(register))),
                           CgField("$accepting", CgInt(32)))
  let helper = CgFunction(helperName, CgStruct(helperParams), rpGetType(register),
                          CgStruct(helperStack), helperOps,
                          "__parallel__ backpressure dispatch for " + f.fnName + " site " + String(opIndex),
                          None, false, false, false, false)
  let siteCall = OpCall(RpGlobalFunction(helperName, None, false, None, false, false),
                        RpNewStruct(alSiteArgs(chain(pc.parCalls), 0, List<RpNamedValue>())),
                        pc.parRegister, false, false, None, List<RParam>())
  ret OutlineOne(siteCall, helper)

fun alForceRegister(r: RParam|None): RParam
  ret match(r)
    (x: RParam) => x
    ()           => RpNullPointer()   # unreachable: well-formedness checked

fun alCpList(ps: Chain<RParam>, k: Int, acc: List<RParam>): List<RParam>
  ret build<RParam >(alCpListB(ps, k, _pushChain<RParam >(builder<RParam >(), chain<RParam >(acc))))

fun [tail] alCpListB(ps: Chain<RParam>, k: Int, [terminal] acc: ListBuilder<RParam >): ListBuilder<RParam >
  ret match(ps)
    (nil: ChainEnd) => acc
    (l: ChainLink)  => alCpListB(l.next, k + 1, push<RParam >(acc, RpStackVar(CgDataPointer(), "$c" + String(k))))

fun alHcList(calls: Chain<RParam>, cps: Chain<RParam>, acc: List<RParam>): List<RParam>
  ret build<RParam >(alHcListB(calls, cps, _pushChain<RParam >(builder<RParam >(), chain<RParam >(acc))))

fun [tail] alHcListB(calls: Chain<RParam>, cps: Chain<RParam>, [terminal] acc: ListBuilder<RParam >): ListBuilder<RParam >
  ret match(calls)
    (nil: ChainEnd) => acc
    (lc: ChainLink) => match(cps)
      (lp: ChainLink)  => alHcListB(lc.next, lp.next,
                                   push<RParam >(acc, alRebindObject(lc.value, lp.value)))
      (nil2: ChainEnd) => acc

fun alRebindObject(c: RParam, obj: RParam): RParam
  ret match(c)
    (gf: RpGlobalFunction) => RpGlobalFunction(gf.name, obj, gf.external, gf.cSymbol, gf.impure, gf.sync)
    (o: RParam)             => c

fun alSeqCalls(calls: Chain<RParam>, results: Chain<RParam>, acc: List<Op>): List<Op>
  ret build<Op >(alSeqCallsB(calls, results, _pushChain<Op >(builder<Op >(), chain<Op >(acc))))

fun [tail] alSeqCallsB(calls: Chain<RParam>, results: Chain<RParam>, [terminal] acc: ListBuilder<Op >): ListBuilder<Op >
  ret match(calls)
    (nil: ChainEnd) => acc
    (lc: ChainLink) => match(results)
      (lr: ChainLink)  => alSeqCallsB(lc.next, lr.next,
                            push<Op >(acc, OpCall(lc.value, RpNewStruct(List<RpNamedValue>()),
                                               lr.value, false, false, None, List<RParam>())))
      (nil2: ChainEnd) => acc

fun alTupleFields(rs: Chain<RParam>, k: Int, acc: List<RpNamedValue>): List<RpNamedValue>
  ret build<RpNamedValue >(alTupleFieldsB(rs, k, _pushChain<RpNamedValue >(builder<RpNamedValue >(), chain<RpNamedValue >(acc))))

fun [tail] alTupleFieldsB(rs: Chain<RParam>, k: Int, [terminal] acc: ListBuilder<RpNamedValue >): ListBuilder<RpNamedValue >
  ret match(rs)
    (nil: ChainEnd) => acc
    (l: ChainLink)  => alTupleFieldsB(l.next, k + 1,
                         push<RpNamedValue >(acc, RpNamedValue("_" + String(k), l.value)))

fun alSiteArgs(calls: Chain<RParam>, k: Int, acc: List<RpNamedValue>): List<RpNamedValue>
  ret build<RpNamedValue >(alSiteArgsB(calls, k, _pushChain<RpNamedValue >(builder<RpNamedValue >(), chain<RpNamedValue >(acc))))

fun [tail] alSiteArgsB(calls: Chain<RParam>, k: Int, [terminal] acc: ListBuilder<RpNamedValue >): ListBuilder<RpNamedValue >
  ret match(calls)
    (nil: ChainEnd) => acc
    (l: ChainLink)  => alSiteArgsB(l.next, k + 1,
                         push<RpNamedValue >(acc, RpNamedValue("$c" + String(k), alClosureOf(l.value))))

# ── zero-init repair for state-saves ─────────────────────────────────────────

# Aggressive IR inlining (-O3) can place a suspension inside a loop whose body
# defines a live range crossing the back-edge: the state-save at the suspension
# then reads the variable BEFORE any write on the first-iteration path (it
# holds a real value only from iteration two). The value saved on that first
# pass is never consumed — but saving indeterminate memory is still wrong, and
# uninit_check rightly rejects it. Zero-init exactly those variables at entry
# so every save stores a DEFINED value. Only STATE-SAVE Moves are repaired —
# a general repair would mask the real read-before-write bugs the checker
# exists for.
fun alZeroInitUnwrittenSaves(f: CgFunction): CgFunction
  let entry = ucComputeEntrySets(f)
  let offenders = alZiusLoop(chain(f.fnOps), 0, entry, List<RParam>())
  if isEmpty(offenders)
    ret f
  let inits = map(svSortedByName(offenders), (v: RParam) =>
        OpMove(v, alZeroVal(rpGetType(v)), false, List<RParam>()))
  ret cgFunctionWith(f, concat(inits, f.fnOps), f.fnStackVars)

fun [tail] alZiusLoop(ops: Chain<Op>, i: Int, entry: Dict<Int, InitSet>,
                      acc: List<RParam>): List<RParam>
  ret match(ops)
    (nil: ChainEnd) => acc
    (l: ChainLink)  => alZiusLoop(l.next, i + 1, entry,
                                  alZiusStep(l.value, ucEntryAt(entry, i), acc))

fun alZiusStep(op: Op, e: InitSet, acc: List<RParam>): List<RParam>
  ret match(e)
    (u: IsUnreached) => acc
    (s2: IsSet)      => match(op)
      (m: OpMove) => alZiusMove(m, s2.isNames, acc)
      (o: Op)     => acc

# The Python guard chain: Move target is ObjectField on the `$state` StackVar,
# source is a StackVar missing from the entry set.
fun alZiusMove(m: OpMove, names: List<String>, acc: List<RParam>): List<RParam>
  ret match(m.moveTarget)
    (tf: RpObjectField) => alZiusStateField(tf) ? alZiusSource(m.moveSource, names, acc) : acc
    (o: RParam)          => acc

fun alZiusStateField(tf: RpObjectField): Bool
  ret match(tf.pointer)
    (p: RpStackVar) => p.name == "$state"
    (o: RParam)     => false

# Entry sets key by name|type (ucKey) — membership must use the same key.
fun alZiusSource(src: RParam, names: List<String>, acc: List<RParam>): List<RParam>
  ret match(src)
    (v: RpStackVar) => strListMember(names, ucKey(src)) ? acc : svSetAdd(acc, src)
    (o: RParam)     => acc

# ── the driver ───────────────────────────────────────────────────────────────

fun lowerAsync(a: CgApp): CgApp
  # Outline first, so the helpers are converted by the same pass below.
  let outlined = fold(a.appFunctions, (List<CgFunction>(), List<CgFunction>()),
                      (acc: (fns: List<CgFunction>, helpers: List<CgFunction>), f: CgFunction) =>
                        alOutlineStep(acc, f))
  let all = concat(outlined.fns, outlined.helpers)
  let converted = fold(all, AlOut(List<CgFunction>(), List<CgObject>()),
                       (acc: AlOut, f: CgFunction) => alMergeOut(acc, alConvertFunction(f)))
  let repaired = map(converted.aloFunctions, alZeroInitUnwrittenSaves)
  let withObjs = fold(converted.aloObjects,
                      appOf(repaired, a.appObjects, a.appGlobals),
                      appPutObject)
  # Subtypes union: APP WINS on collisions (lazy_thunks pre-registrations).
  ret fold(collectTaskSubtypes(withObjs), withObjs, alPutIfAbsent)

fun alOutlineStep(acc: (fns: List<CgFunction>, helpers: List<CgFunction>),
                  f: CgFunction): (fns: List<CgFunction>, helpers: List<CgFunction>)
  if f.fnBypassAsync || f.fnName == "__entrypoint__"
    ret (append(acc.fns, f), acc.helpers)
  let out = alOutlineParallelSites(f)
  ret (append(acc.fns, out.alo2Fn), concat(acc.helpers, out.alo2Helpers))

fun alMergeOut(acc: AlOut, out: AlOut): AlOut
  ret AlOut(concat(acc.aloFunctions, out.aloFunctions),
            concat(acc.aloObjects, out.aloObjects))

fun alPutIfAbsent(a: CgApp, o: CgObject): CgApp
  ret appHasObject(a, o.objName) ? a : appPutObject(a, o)
