# bootstrap/async_lower.yafl — task lowering, ported from
# lowering/async_lower.py (1,827 lines; read in full — the ledger carries the
# per-mechanism map). Each function with non-tail calls becomes: a HOT PATH
# (original name; UNLIKELY(IS_TASK) after every non-tail call; one shared
# $asynccommon cold tail that saves live locals to a heap state object,
# creates the task, registers fn$async and returns the tagged task) and, for
# non-sync functions, a STATE MACHINE fn$async($state, $completed_task)
# dispatching on $state->idx — running on ordinary C locals, touching state
# fields only at the two suspension boundaries. Oversized looping bodies take
# the STUB launch instead of a duplicated hot path.
namespace Bootstrap::Lower::Ir

import System
import System::Containers

import Bootstrap::Ast

import Bootstrap::Codegen
import Bootstrap::Frontend
import Bootstrap::Ir
import Bootstrap::Parse
import Bootstrap::StdlibCandidates
import Bootstrap::Types



# ── module scratch vars (the hot path shares ONE set) ────────────────────────

fun alSvState() => RpStackVar(CgDataPointer(false), "$sv_state")

fun alSvTask(): RParam => RpStackVar(CgDataPointer(false), "$sv_task")

fun alSvDiscard(): RParam => RpStackVar(CgDataPointer(false), "$sv_discard")

fun alSvCallId() => RpStackVar(CgInt(32), "$sv_call_id")

fun alSvAsyncTask() => RpStackVar(CgDataPointer(false), "$sv_async_task")

fun alStateParam(): RParam => RpStackVar(CgDataPointer(false), "$state")

fun alCompletedParam() => RpStackVar(CgDataPointer(false), "$completed_task")

# ── return conversion ────────────────────────────────────────────────────────

# SM: Return → [store value into my_task's subtype result field] +
# task_complete + ReturnVoid; ReturnVoid → task_complete + ReturnVoid.
# Instruction order, so the ops go into a builder: each one either passes
# through or expands to a short sequence, and the concat this replaces copied
# everything emitted so far for every op in the function.
fun alConvertReturnsSm(ops: List<Op>, myTaskField, fnResult,
                       subtype: String|None)
  ret alConvertReturnsSmB(ops, myTaskField, fnResult,
                                subtype, List())

fun alConvertReturnsSmB(ops: List<Op>,
                        myTaskField,
                        fnResult,
                        subtype: String|None,
                        acc: List<Op>) =>
  fold(ops, acc, (a, x) => alConvertReturnSmOne(a, x, myTaskField,
                                              fnResult, subtype))

fun alConvertReturnSmOne(acc: List<Op>, op,
                         myTaskField, fnResult,
                         subtype: String|None): List<Op> => match(op)
  (r: OpReturn)        => concat(acc,
                            alSmReturn(r, myTaskField, fnResult,
                                       subtype))
  (rv: OpReturnVoid)   => concat(acc,
                            alSmComplete(myTaskField))
  (x: OpLabel)         => append(acc, op)
  (x: OpMove)          => append(acc, op)
  (x: OpJump)          => append(acc, op)
  (x: OpJumpIf)        => append(acc, op)
  (x: OpIfTask)        => append(acc, op)
  (x: OpAssertNotTask) => append(acc, op)
  (x: OpSwitchJump)    => append(acc, op)
  (x: OpNewObject)     => append(acc, op)
  (x: OpCall)          => append(acc, op)
  (x: OpAwait)         => append(acc, op)
  (x: OpAbort)         => append(acc, op)
  (x: OpPhi)           => append(acc, op)
  (x: OpProfEnter)     => append(acc, op)
  (x: OpProfLeave)     => append(acc, op)

fun alSmReturn(r: OpReturn, myTaskField, fnResult,
               subtype: String|None): List<Op> => match(subtype)
  (st: String) => alIsVoid(fnResult)
    ? alSmComplete(myTaskField)
    : concat(list1(OpMove(RpObjectField(fnResult, myTaskField, st, "result", None, false, false),
                          r.returnValue, false, Dict())),
             alSmComplete(myTaskField))
  ()            => alSmComplete(myTaskField)

fun alSmComplete(myTaskField): List<Op>
  ret list2(OpMove(alSvDiscard(),
                   RpRuntimeInvoke("task_complete",
                                   RpNewStruct(list1(RpNamedValue("self", myTaskField))),
                                   CgDataPointer(false)),
                   true, Dict()),
            OpReturnVoid(Dict()))

fun alIsVoid(t2) => match(t2)
  (v: CgVoid) => true
  (o: CgType) => false

# Hot path: bring each Return's value into the function's task-carrying
# return shape (wrapValue), and align musttail result_types with it. A no-op
# when the return type carries the task signal in-band.
fun alConvertReturnsHot(ops, fnResult): List<Op>
  let wrappedResult = wrapReturnType(fnResult)
  ret eqCgType(wrappedResult, fnResult)
    ? ops
    : map(ops, (op) => alHotReturnOne(op, wrappedResult))

fun alHotReturnOne(op, wrapped) => match(op)
  (r: OpReturn)        => OpReturn(wrapValue(r.returnValue, wrapped), r.returnSavedVars)
  (c: OpCall)          => c.callMusttail
    ? OpCall(c.callFunction, c.callParameters, c.callRegister, true, c.callImpure,
             wrapped, c.callSavedVars)
    : op
  (x: OpLabel)         => op
  (x: OpMove)          => op
  (x: OpJump)          => op
  (x: OpJumpIf)        => op
  (x: OpIfTask)        => op
  (x: OpAssertNotTask) => op
  (x: OpSwitchJump)    => op
  (x: OpNewObject)     => op
  (x: OpAwait)         => op
  (x: OpReturnVoid)    => op
  (x: OpAbort)         => op
  (x: OpPhi)           => op
  (x: OpProfEnter)     => op
  (x: OpProfLeave)     => op

# ── per-pattern emit helpers ─────────────────────────────────────────────────

fun alRuntimeDiscard(sv, name, args): Op
  ret OpMove(sv, RpRuntimeInvoke(name, RpNewStruct(args), CgDataPointer(false)),
             true, Dict())

# Task alloc: None → base task_t via task_create; a runtime subtype (task_obj,
# task_str) → its `<name>_create`; else NewObject + task_init.
fun alEmitTaskAlloc(svTask, subtype: String|None): List<Op> => match(subtype)
  (st: String) => isRuntimeTaskSubtype(st)
    ? list1(OpMove(svTask,
                   RpRuntimeInvoke(st + "_create",
                                   RpNewStruct(list1(RpNamedValue("self", RpNullPointer()))),
                                   CgDataPointer(false)), false, Dict()))
    : list2(OpNewObject(st, svTask, None, false, Dict()),
            alRuntimeDiscard(alSvDiscard(), "task_init",
                             list1(RpNamedValue("task", svTask))))
  ()            => list1(OpMove(svTask,
                   RpRuntimeInvoke("task_create",
                                   RpNewStruct(list1(RpNamedValue("self", RpNullPointer()))),
                                   CgDataPointer(false)), false, Dict()))

# SM cold-block tail: write idx, register fn$async on the in-flight task
# (already a clean task_t pointer), return.
fun alEmitSuspendToAsync(idxField, idx, untaggedTask,
                         fnName): List<Op>
  let callback = RpGlobalFunction(fnName + "$async", alStateParam(), false, None, false, false)
  ret list3(OpMove(idxField, RpInteger(idx, 32), false, Dict()),
            alRuntimeDiscard(alSvDiscard(), "task_on_complete",
                             list2(RpNamedValue("task", untaggedTask),
                                   RpNamedValue("cb", callback))),
            OpReturnVoid(Dict()))

# ── tail-call detection ──────────────────────────────────────────────────────

# Call(register=R); Return(R) with R's type == fn.result → musttail (register
# cleared, result_type set); void Call; ReturnVoid → musttail. Codegen emits
# `return foo(...)` which clang TCOs even at -O0.
fun alDiscoverTailCalls(f)
  if !atLeast(f.fnOps, 2)
    ret f
  ret cgFunctionWith(f, alTailScan(f.fnOps, f.fnResult), f.fnStackVars)

fun alTailScan(s: Segment<Op>|None, fnResult): Segment<Op>|None
  let p0 = cgPullOp(seqStream(s))
  let p1 = cgPullOp(p0.stream)
  ret build(alTailScanB(p0.op, p1.op, p1.stream, fnResult, seqBuilder()))

# (cur, nxt) window over the op stream: the pattern match consumes a pair, so
# the window shifts by one or two. Both refills are pulled up front to keep
# every recursion direct ([tail]); the one-shift arm discards the second.
fun [tail] alTailScanB(cur: Op|None, nxt: Op|None, st: SeqStream<Op>, fnResult,
                       [terminal] acc: SeqBuilder<Op>): SeqBuilder<Op>
  if cur is None
    ret acc
  let op = forceOp(cur)
  let pA = cgPullOp(st)
  let pB = cgPullOp(pA.stream)
  ret match(nxt)
    (nil: None) => push(acc, op)
    (n: Op)     => match(alTailPattern(op, n, fnResult))
      (t2: Op) => alTailScanB(pA.op, pB.op, pB.stream, fnResult, push(acc, t2))
      ()       => alTailScanB(nxt, pA.op, pA.stream, fnResult, push(acc, op))

fun alTailPattern(op, nxt, fnResult) => match(op)
  (c: OpCall) => c.callMusttail ? None : alTailPatternCall(c, nxt, fnResult)
  (o: Op)     => None

fun alTailPatternCall(c: OpCall, nxt, fnResult) => match(c.callRegister)
  (reg: RParam) => alTailValued(c, reg, nxt, fnResult)
  ()             => alTailVoid(c, nxt, fnResult)

fun alTailValued(c: OpCall, reg, nxt, fnResult) => match(nxt)
  (r: OpReturn) => match(r.returnValue)
    (sv: RpStackVar) => alRegNamed(reg, sv.name) && eqCgType(rpGetType(reg), fnResult)
      ? OpCall(c.callFunction, c.callParameters, None, true, c.callImpure,
               rpGetType(reg), c.callSavedVars)
      : None
    (o: RParam)       => None
  (o2: Op)       => None

fun alRegNamed(reg, name) => match(reg)
  (sv: RpStackVar) => sv.name == name
  (o: RParam)       => false

fun alTailVoid(c: OpCall, nxt, fnResult)
  if !alResultTypeVoidish(c.callResultType) || !alIsVoid(fnResult)
    ret None
  ret match(nxt)
    (rv: OpReturnVoid) => OpCall(c.callFunction, c.callParameters, None, true,
                                 c.callImpure, c.callResultType, c.callSavedVars)
    (o: Op)             => None

fun alResultTypeVoidish(t2: CgType|None) => match(t2)
  (x: CgType) => alIsVoid(x)
  ()           => true

# ── liveness: __calculate_saved_vars ─────────────────────────────────────────

# Per-op reads/writes with the Phi rule: a Phi reads NOTHING unconditionally
# (each source is consumed on its predecessor edge only — added per-edge via
# alPhiSourcesInto) and writes its target.
fun alReadsOf(op): List<RParam> => match(op)
  (ph: OpPhi) => List()
  (o: Op)     => opReadStackVars(op)

fun alWritesOf(op) => fold(opTargets(op), List(), rpTakeStackVar)

fun alCalculateSavedVars(f: CgFunction)
  let ops = cgOpsToList(f.fnOps)
  let st = alLiveState(ops, f.fnOps)
  let saved = alLivenessFix(st, alInitialSaved(ops, 0, Dict()))
  ret cgFunctionWith(f, cgOpsOf(alWriteSaved(ops, 0, saved, List())),
                     f.fnStackVars)

# __calculate_saved_vars, structure for structure. Everything that does not
# change between passes is built ONCE: the op index, the label index, the
# enclosing block of each op, and each op's reads and writes (Python's
# rw_cache). The fixpoint works on each op's live set — Python's frozenset,
# here the variables by name — keyed by op index, and a pass reads the
# freshest successor value, as Python's `cur` does. A set is derived from its
# successor's by adding the few reads missing from it and removing the writes,
# so neighbouring ops SHARE nearly all of their (persistent) structure, and
# those exact sets are what the ops carry.
class [final] AlRw(rwReads: Dict<String, RParam>, rwWrites: List<String>)

class [final] AlLive(lsOps: Dict<Int, Op>, lsLabels: Dict<String, Int>,
                     lsBlocks: Dict<Int, String>, lsRw: Dict<Int, AlRw>, lsN: Int)

fun alLiveState(ops: List<Op>, seg: Segment<Op>|None): AlLive
  let bi = alBlockIndex(seg)
  ret alLiveIndex(ops, 0, AlLive(Dict(), ucLabelIndex(seg), bi.d, Dict(), bi.n))

fun alLiveIndex(os: List<Op>, i, acc: AlLive): AlLive =>
  fold(os, (acc = acc, i = i),
       (st, x) => (acc = alLiveIndexOne(st.acc, st.i, x), i = st.i + 1)).acc

fun alLiveIndexOne(acc: AlLive, i, op): AlLive
  ret AlLive(put(acc.lsOps, i, op), acc.lsLabels, acc.lsBlocks,
             put(acc.lsRw, i, AlRw(vsOf(alReadsOf(op)), map(alWritesOf(op), stackVarName))),
             acc.lsN)

fun alInitialSaved(os: List<Op>, i, acc: Dict<Int, Dict<String, RParam>>): Dict<Int, Dict<String, RParam>> =>
  fold(os, (i = i, acc = acc),
       alInitialSavedStep).acc

fun alInitialSavedStep(st: (i: Int, acc: Dict<Int, Dict<String, RParam>>), x: Op) =>
  (i = st.i + 1,
  acc = isEmpty(opSavedVars(x))
      ? st.acc : put(st.acc, st.i, opSavedVars(x)))

fun alSavedAt(saved: Dict<Int, Dict<String, RParam>>, i: Int): Dict<String, RParam> => match(get(saved, i))
  (s2: Dict<String, RParam>) => s2
  ()                         => Dict()

fun alRwAt(st: AlLive, i: Int): AlRw => match(get(st.lsRw, i))
  (rw: AlRw) => rw
  ()         => AlRw(Dict(), List())   # unreachable: 0 <= i < lsN

# The default is unreachable: 0 <= i < lsN.
fun alOpAt(st: AlLive, i: Int): Op => get(st.lsOps, i) ?? OpReturnVoid(Dict())

fun alBlockAt(st: AlLive, i: Int) => match(get(st.lsBlocks, i))
  (s2: String) => s2
  ()           => ""

# `small`'s members not already in `big`, put into it: a member already there
# is skipped, so an unchanged set keeps its structure.
fun alAddAll(big: Dict<String, RParam>, small: Dict<String, RParam>): Dict<String, RParam>
  ret isEmpty(small) ? big : fold(values(small), big, (d, v) =>
        contains(d, stackVarName(v)) ? d : put(d, stackVarName(v), v))

fun alRemoveAll(s2: Dict<String, RParam>, names: List<String>): Dict<String, RParam>
  ret fold(names, s2, (d, n) => contains(d, n) ? remove(d, n) : d)

# Python's `iterate`: passes until one changes nothing.
fun alLivenessFix(st: AlLive, saved: Dict<Int, Dict<String, RParam>>): Dict<Int, Dict<String, RParam>>
  let pass = alLivePass(st, saved, st.lsN - 1, false)
  ret pass.changed ? alLivenessFix(st, pass.saved) : pass.saved

# Liveness is a BACKWARD analysis, so the sweep runs BACKWARD: a successor's
# set is the one this pass just computed. Sweeping forward moved information
# back one op per pass, O(ops^2) op-visits. Same monotone transfer functions,
# same least fixed point.
fun [tail] alLivePass(st: AlLive, saved: Dict<Int, Dict<String, RParam>>, i,
                      changed: Bool): (saved: Dict<Int, Dict<String, RParam>>, changed: Bool)
  if i < 0
    ret (saved, changed)
  let now = alCalc(st, saved, i)
  let same = alSameVars(alSavedAt(saved, i), now)
  ret alLivePass(st, same ? saved : put(saved, i, now), i - 1, changed || !same)

# Equal sets: the same size, and every member of one in the other.
fun alSameVars(a: Dict<String, RParam>, b: Dict<String, RParam>)
  ret size(a) == size(b) && all(values(b), (v) => contains(a, stackVarName(v)))

# saved(op) = (edge-in of the fall-through/Jump successor ∪ edge-in of the
# JumpIf target) − op's own writes. A Jump's successor is its label WHEREVER
# the op sits — testing last-op first severed the back edge of a loop whose
# back-edge Jump is the function's final op (the array-ctor fill inlined into a
# tail position), so nothing loop-carried was saved across a park inside it.
fun alCalc(st: AlLive, saved: Dict<Int, Dict<String, RParam>>, i: Int): Dict<String, RParam>
  let op = alOpAt(st, i)
  let ss1 = match(op)
    (j: OpJump) => match(ucLabelAt(st.lsLabels, j.jumpName))
      (t2: Int) => alEdgeIn(st, saved, i, t2)
      ()         => Dict<String, RParam>()
    (o: Op)     => i >= st.lsN - 1 ? Dict<String, RParam>() : alEdgeIn(st, saved, i, i + 1)
  let ss2 = match(op)
    (ji: OpJumpIf) => match(ucLabelAt(st.lsLabels, ji.jumpIfLabel))
      (t2: Int) => alEdgeIn(st, saved, i, t2)
      ()         => Dict<String, RParam>()
    (o: Op)        => Dict<String, RParam>()
  ret alRemoveAll(alAddAll(ss1, ss2), alRwAt(st, i).rwWrites)

fun alEdgeIn(st: AlLive, saved: Dict<Int, Dict<String, RParam>>, fromIdx: Int, targetIdx: Int): Dict<String, RParam>
  ret alAddAll(alSavedSetAt(st, saved, targetIdx), alPhiSourcesInto(st, targetIdx, alBlockAt(st, fromIdx)))

# Python's saved_set_at: the target's saved set ∪ its reads — the few reads go
# INTO the saved set.
fun alSavedSetAt(st: AlLive, saved: Dict<Int, Dict<String, RParam>>, index: Int): Dict<String, RParam>
  ret alAddAll(alSavedAt(saved, index), alRwAt(st, index).rwReads)

# Phi sources arriving on the edge from `pred`: scan the run of Phis at the
# target.
fun alPhiSourcesInto(st: AlLive, j: Int, pred: String) => alPhiSourcesLoop(st, j + 1, pred, Dict())

fun [tail] alPhiSourcesLoop(st: AlLive, j: Int, pred: String,
                            acc: Dict<String, RParam>): Dict<String, RParam>
  if j >= st.lsN
    ret acc
  ret match(alOpAt(st, j))
    (ph: OpPhi) => alPhiSourcesLoop(st, j + 1, pred,
                     fold(ph.phiSources, acc, (a, s2) =>
                       s2.sourceLabel == pred ? alAddAll(a, vsOf(rpReadStackVars(s2.sourceValue))) : a))
    (o: Op)     => acc

# Each op carries its own live set as the fixpoint left it.
fun alWriteSaved(os: List<Op>,
                 i,
                 saved: Dict<Int, Dict<String, RParam>>,
                 acc: List<Op>): List<Op> =>
  fold(os, (acc = acc, i = i),
       (st, x) => (acc = append(st.acc, opWithSavedVars(x, alSavedAt(saved, st.i))), i = st.i + 1)).acc

# Enclosing block label per op index (nearest preceding Label; "" before any).
fun alBlockIndex(ops: Segment<Op>|None): (d: Dict<Int, String>, n: Int)
  ret alBlockIndexLoop(ops, 0i32, 0, "", Dict())

fun [tail] alBlockIndexLoop(s: Segment<Op>|None, iSeg, i, cur,
                            acc): (d: Dict<Int, String>, n: Int) => match(s)
  (nil: None)        => (acc, i)
  (seg: Segment<Op>) => iSeg < seg.length
    ? (alLabelNameOr(seg.array(iSeg), cur)
        |> (nxt) => alBlockIndexLoop(s, iSeg + 1i32, i + 1, nxt, put(acc, i, nxt)))
    : alBlockIndexLoop(seg.next, 0i32, i, cur, acc)

fun alLabelNameOr(op, cur) => match(op)
  (lb: OpLabel) => lb.labelName
  (o: Op)       => cur

# ── basic blocks ─────────────────────────────────────────────────────────────

class [final] ABlock(abName: String, abOps: List<Op>, abLive: Dict<String, RParam>,
                     abResult: RParam|None)

# Partition liveness-annotated ops on may-suspend Call | Await (the
# splitter is the LAST op of its block); block name cont$<i>; live = last
# op's saved_vars; result = last op's register.
fun alCreateBasicBlocks(f: CgFunction): List<ABlock> => alCreateBasicBlocksN(f).bs

# The block count rides alPartition's existing carried counter.
fun alCreateBasicBlocksN(f: CgFunction): (bs: List<ABlock>, n: Int)
  let annotated = alCalculateSavedVars(f)
  ret alPartition(seqStream(annotated.fnOps), 0, List(), List())

# `n` is the count of blocks already in `acc` — carried, not re-measured;
# the final tuple's n is the TOTAL block count (last block is n, so n+1).
#
# Two ordered accumulators, so they travel together in one linear record: the
# ops of the block being filled, and the blocks finished so far. Both orders
# are instruction order. The current block's builder is BUILT at each splitter
# — that is what closes the block — and a fresh one starts the next.
class [final] PartAcc(paCur: List<Op>,
                              paBlocks: List<ABlock>)

fun alPartition(st: SeqStream<Op>, n, cur,
                acc): (bs: List<ABlock>, n: Int)
  ret alPartitionB(st, n,
                   PartAcc(cur,
                           acc))

fun [tail] alPartitionB(st: SeqStream<Op>, n,
                        acc: PartAcc): (bs: List<ABlock>, n: Int)
  let p = cgPullOp(st)
  ret match(p.op)
    (nil: None) =>
      (append(acc.paBlocks,
                  alMakeBlock(n, acc.paCur)),
       n + 1)
    (op2: Op)   => alIsSplitter(op2)
      ? alPartitionB(p.stream, n + 1,
            PartAcc(List(),
                    append(acc.paBlocks,
                        alMakeBlock(n, append(acc.paCur,
                                                  op2)))))
      : alPartitionB(p.stream, n, PartAcc(append(acc.paCur, op2),
                                        acc.paBlocks))

# Parks: a call that may suspend, or an Await.
fun alIsSplitter(op) => match(op)
  (c: OpCall)              => opCallMaySuspend(c)
  (aw: OpAwait)            => true
  (x: OpLabel)             => false
  (x: OpMove)              => false
  (x: OpJump)              => false
  (x: OpJumpIf)            => false
  (x: OpIfTask)            => false
  (x: OpAssertNotTask)     => false
  (x: OpSwitchJump)        => false
  (x: OpNewObject)         => false
  (x: OpReturnVoid)        => false
  (x: OpAbort)             => false
  (x: OpReturn)            => false
  (x: OpPhi)               => false
  (x: OpProfEnter)         => false
  (x: OpProfLeave)         => false

fun alMakeBlock(index: Int, ops) => match(lastOp(ops))
  (op: Op) => ABlock("cont$" + String(index), ops, opSavedVars(op), alBlockResult(op))
  ()        => ABlock("cont$" + String(index), ops, Dict(), None)

fun alBlockResult(op) => match(op)
  (c: OpCall)              => c.callRegister
  (aw: OpAwait)            => aw.awaitRegister
  (x: OpLabel)             => None
  (x: OpMove)              => None
  (x: OpJump)              => None
  (x: OpJumpIf)            => None
  (x: OpIfTask)            => None
  (x: OpAssertNotTask)     => None
  (x: OpSwitchJump)        => None
  (x: OpNewObject)         => None
  (x: OpReturnVoid)        => None
  (x: OpAbort)             => None
  (x: OpReturn)            => None
  (x: OpPhi)               => None
  (x: OpProfEnter)         => None
  (x: OpProfLeave)         => None

# ── heap-frame layout ────────────────────────────────────────────────────────

# Python's FrameLayout: the frame locals by NAME — strict object_t* locals to
# their array index, other locals to their shared inline field, all-pointer
# structs to their decomposed base — and the slot fields, the one ORDERED part
# (they become struct fields).
class [final] AFrame(afPtrSlots: Dict<String, Int>, afInlineSlots: Dict<String, String>,
                     afSlotFields: List<CgField>, afNArray: Int,
                     afDecomposed: Dict<String, Int>)
class [final] NameIdx(niName: String, niIdx: Int)

fun afEmpty() => AFrame(Dict(), Dict(), List(), 0, Dict())

# Frame-resident locals: saved live vars (SORTED by name — reproducibility)
# + call-result registers over bbs[:-1]; first-seen order, last-seen type.
fun alFrameFieldTypes(bbs: List<ABlock>)
  ret ffFields(alFftLoop(alNonTerminal(bbs), ffEmpty()))

fun alNonTerminal(bbs: List<ABlock>) => dropLastOne(bbs)

# Non-terminal blocks AND their count from one walk (no-length ruling).
fun alNonTerminalN(bbs: List<ABlock>): (bs: List<ABlock>, n: Int) =>
  fold(dropLastOne(bbs), (bs = List<ABlock>(), n = 0), (st, b) => (bs = append(st.bs, b), n = st.n + 1))

# Everything but the last element, in order.
# The frame's fields as Python builds them: a DICT, where assigning a key that
# is already present replaces its value and leaves it in its original position.
# The port modelled that with a List, an `any` scan to find a repeat and a
# `map` rewrite to update it — two passes over every field already collected,
# for every variable of every block. Frames here run to hundreds of variables.
#
# The position is recorded instead of maintained: a name takes the next
# sequence number the first time it is seen, and ffFields recovers the order
# with one sort at the end.
class [final] FrameFields(ffTypes: Dict<String, CgType>,
                          ffOrder: Dict<String, Int>, ffNext: Int)

fun ffEmpty() => FrameFields(Dict(), Dict(), 0)

fun _ffOrd(d: Dict<String, Int>, n: String) => match(get(d, n))
  (i: Int) => i
  ()       => 0

fun _ffType(d: Dict<String, CgType>, n: String) => match(get(d, n))
  (t2: CgType) => t2
  ()           => CgVoid()

fun ffFields(acc: FrameFields) => map(
                                    sortBy(keys(acc.ffTypes),
                                           (x, y) =>
                                             _ffOrd(acc.ffOrder, x) < _ffOrd(acc.ffOrder, y)),
                                    (n) => CgField(n, _ffType(acc.ffTypes, n)))

fun alFftLoop(bbs: List<ABlock>, acc: FrameFields) =>
  fold(bbs, acc, (a, x) => alFftBlock(x, a))

fun alFftBlock(bb: ABlock, acc: FrameFields)
  let withLive = fold(vsSorted(bb.abLive), acc, alFftPut)
  ret match(bb.abResult)
    (r: RParam) => alFftPutR(withLive, r)
    ()           => withLive

fun alFftPut(acc, v) => alFftPutR(acc, v)

# first-seen ORDER, last-seen TYPE (Python dict assignment semantics).
fun alFftPutR(acc, v) => match(v)
  (sv: RpStackVar) => match(get(acc.ffOrder, sv.name))
    (i: Int) => FrameFields(put(acc.ffTypes, sv.name, rpGetType(v)),
                            acc.ffOrder, acc.ffNext)
    ()       => FrameFields(put(acc.ffTypes, sv.name, rpGetType(v)),
                            put(acc.ffOrder, sv.name, acc.ffNext),
                            acc.ffNext + 1)
  (o: RParam)       => acc

# Interference: pairs simultaneously live over BOTH op sequences (SM view is
# authoritative; hot view keeps coalescing safe there too). live-out pairs;
# writes × live-out; live-IN pairs (reads + live-out survivors not redefined)
# — reads do NOT interfere with the op's own write (slot = f(slot) is sound).
# The graph is DICT-backed (user ruling 2026-07-22): the old edge LIST paid
# a full scan per insertion and per neighbour query — cubic at self-host
# scale, where big state machines have hundreds of frame vars (async ran
# 79+ min without completing). Both directed keys are stored so presence is
# one get; adjacency lists keep first-seen order, which is the edge-list
# order alNeighbours used to produce per node.
class [final] IGraph(igAdj: Dict<String, Set<String>>)

fun alEmptyGraph() => IGraph(Dict())

fun alBuildInterference(opSeqs: List<List<Op>>,
                        frameNames: List<String>)
  let frameIx = fold(frameNames, Dict(),
                     (ix, n) => put(ix, n, true))
  ret fold(opSeqs, alEmptyGraph(),
           (acc, ops) => fold(ops, IfAcc(acc, Set(), Set()),
             (a, op) => alInterfereOp(a, op, frameIx)).ifGraph)

# The graph so far, and the previous op's live-out and live-in names: every
# pair within those is already linked (alLinkAllPairs).
class [final] IfAcc(ifGraph: IGraph, ifPrevOut: Set<String>, ifPrevIn: Set<String>)

fun alInFrame(frameIx: Dict<String, Bool>, n: String): Bool => !(get(frameIx, n) is None)

# The live sets are SETS of names: an edge set does not depend on the order
# its pairs are linked in.
fun alInterfereOp(st: IfAcc, op,
                  frameIx: Dict<String, Bool>): IfAcc
  let liveOut = filter(keys(opSavedVars(op)), (n) => alInFrame(frameIx, n))
  let writes = Set(map(alWritesOf(op), stackVarName))
  let acc1 = alLinkAllPairs(st.ifGraph, liveOut, st.ifPrevOut)
  let acc2 = fold(writes, acc1, (a, w) =>
               alInFrame(frameIx, w)
                 ? fold(liveOut, a, (a2, n) => alLink(a2, w, n))
                 : a)
  let liveIn = union(filter(Set(map(alReadsOf(op), stackVarName)),
                            (n) => alInFrame(frameIx, n)),
                     filter(liveOut, (n) => !contains(writes, n)))
  ret IfAcc(alLinkAllPairs(acc2, liveIn, st.ifPrevIn), liveOut, liveIn)

# Python's link: both directions into each node's neighbour SET.
fun alLink(acc: IGraph, a: String, b: String): IGraph
  if a == b || contains(alNeighbours(acc, a), b)
    ret acc
  ret IGraph(alAdjAdd(alAdjAdd(acc.igAdj, a, b), b, a))

fun alAdjAdd(adj: Dict<String, Set<String>>, from2: String, to2: String) => match(get(adj, from2))
  (prev: Set<String>) => put(adj, from2, add(prev, to2))
  ()                  => put(adj, from2, add(Set(), to2))

# Every pair in `names`, given that every pair in `prev` is already linked: a
# pair of two names both in `prev` is, so only the names new since `prev` need
# linking — against the whole set. Neighbouring ops' live sets are nearly
# equal, so this is O(new·L), not O(L²), per op, and the edge set is exactly
# the all-pairs one.
fun alLinkAllPairs(acc: IGraph, names: Set<String>, prev: Set<String>): IGraph
  ret fold(names, acc, (a, x) => contains(prev, x)
                                   ? a
                                   : fold(names, a, (a2, y) => alLink(a2, x, y)))

fun alNeighbours(graph: IGraph, name: String): Set<String> => match(get(graph.igAdj, name))
  (ns: Set<String>) => ns
  ()                => Set()

# Greedy colouring in the given name order — Python's __colour, a name → colour
# map. The colours already taken by a name's neighbours form a SET: alFirstFree
# asks nothing of it but membership.
fun alColour(names: List<String>, graph: IGraph): List<NameIdx>
  let colours = fold(names, Dict(), (acc, n) => alColourOne(acc, n, graph))
  ret map(names, (n) => NameIdx(n, alColourOf(colours, n)))

fun alColourOne(acc: Dict<String, Int>, name: String, graph: IGraph): Dict<String, Int>
  let used = fold(alNeighbours(graph, name), Set(), (u, nb) => alUsedColour(u, acc, nb))
  ret put(acc, name, alFirstFree(used, 0))

fun alUsedColour(u: Set<Int>, acc: Dict<String, Int>, nb: String): Set<Int> => match(get(acc, nb))
  (c: Int) => add(u, c)
  ()        => u

fun alColourOf(colours: Dict<String, Int>, name: String) => match(get(colours, name))
  (c: Int) => c
  ()        => 0   # unreachable: every name was coloured

fun [tail] alFirstFree(used: Set<Int>, c) => contains(used, c) ? alFirstFree(used, c + 1) : c

# All-pointer struct leaf paths (nested), None otherwise.
fun alPtrLeaves(t2): (ls: List<String>, n: Int)|None => match(t2)
  (s2: CgStruct)          => alPtrLeavesFields(s2.fields)
  (im: CgImmediateStruct) => alPtrLeavesFields(im.fields)
  (o: CgType)             => None

# Paths encoded as "/"-joined field names (root-first); the leaf count
# rides the same fold (no-length ruling).
# The paths come out in FIELD order and are indexed positionally by the
# decomposed layout, so they are built at the tail. `ok` clears as soon as a
# field is neither a pointer nor an all-pointer struct, and the part-built list
# is then dropped unbuilt.
class [final] PlfAcc(plPaths: List<String>, plN: Int,
                             plOk: Bool)

fun alPtrLeavesFields(fields: List<CgField>): (ls: List<String>, n: Int)|None
  let acc = foldWhile(fields, PlfAcc(List(), 0, true), alPlfOne, (a) => a.plOk)
  ret acc.plOk && acc.plN > 0 ? (acc.plPaths, acc.plN) : None

fun alPlfOne(acc: PlfAcc, f2: CgField) => match(f2.fieldType)
  (d: CgDataPointer) => PlfAcc(append(acc.plPaths, f2.fieldName),
                               acc.plN + 1, true)
  (s2: CgStruct)     => alPlfNested(acc, f2, alPtrLeavesFields(s2.fields))
  (im: CgImmediateStruct) => alPlfNested(acc, f2,
                                         alPtrLeavesFields(im.fields))
  (o: CgType)        => PlfAcc(acc.plPaths, acc.plN, false)

fun alPlfNested(acc: PlfAcc, f2: CgField,
                inner: (ls: List<String>, n: Int)|None) => match(inner)
  (ps: (ls: List<String>, n: Int)) =>
      PlfAcc(concat(acc.plPaths,
                 map(ps.ls,
                     (p) => f2.fieldName + "/" + p)),
             acc.plN + ps.n, true)
  ()  => PlfAcc(acc.plPaths, acc.plN, false)

# Frame layout: coalesce per exact-type class (by_type in FIRST-SEEN type
# order — type_index numbers from it), then route slots: strict DataPointer →
# trailing GC array; all-pointer structs → decomposed array runs; else inline
# $slot$<typeidx>$<colour> fields.
fun alComputeFrameLayout(smBbs: List<ABlock>, hotBbs: List<ABlock>,
                         livenessOps: List<Op>)
  let fieldTypes = alFrameFieldTypes(smBbs)
  let frameNames = map(fieldTypes, (f2) => f2.fieldName)
  let hotOps = alBlockOps(hotBbs, List())
  let graph = alBuildInterference(list2(livenessOps, hotOps), frameNames)
  let byType = alGroupByType(fieldTypes)
  ret alLayoutLoop(byType, graph, 0, afEmpty())

fun alBlockOps(bs: List<ABlock>, acc: List<Op>): List<Op> =>
  fold(bs, acc, (a, x) => concat(a, x.abOps))

class [final] TypeGroup(tgType: CgType, tgNames: List<String>)

# Fields grouped by exact type: the groups in FIRST-SEEN type order, because
# the type index numbers from it, and the names within a group in field order,
# because the colouring walks them in that order.
#
# Each group SELECTS its fields rather than being accumulated into. The old
# shape appended the name to the matching group for every field, and since a
# group's names live inside the group list, that meant rebuilding the entire
# list of groups once per field of the frame.
fun alGroupByType(fieldTypes: List<CgField>)
  ret map(
        alDistinctTypes(fieldTypes, List(),
                              List()),
        (t2) => TypeGroup(t2,
            map(filter(fieldTypes,
                       (f2) => eqCgType(f2.fieldType, t2)),
                (f2) => f2.fieldName)))

# The distinct field types in first-seen order. `seen` answers only "have I
# had this type before", so its own order is free; the builder carries the
# order that matters.
fun alDistinctTypes(fs: List<CgField>, seen: List<CgType>, out): List<CgType> =>
  fold(fs, (seen = seen, out = out),
       alDistinctTypesStep).out

fun alDistinctTypesStep(st: (seen: List<CgType>, out: List<CgType>), x: CgField) =>
  any(st.seen, (t2) => eqCgType(t2, x.fieldType))
  ? (seen = st.seen, out = st.out)
  : (seen = prepend(x.fieldType, st.seen), out = append(st.out, x.fieldType))

fun alLayoutLoop(gs: List<TypeGroup>, graph: IGraph, ti, acc: AFrame) =>
  fold(gs, (acc = acc, ti = ti),
       (st, x) => (acc = alLayoutGroup(x, graph, st.ti, st.acc), ti = st.ti + 1)).acc

fun alLayoutGroup(g2: TypeGroup, graph: IGraph, ti: Int, acc: AFrame)
  let colour = alColour(g2.tgNames, graph)
  let nColours = alDistinctColourCount(colour)
  ret match(g2.tgType)
    (d: CgDataPointer) => AFrame(
        fold(colour, acc.afPtrSlots, (d2, e2) => put(d2, e2.niName, acc.afNArray + e2.niIdx)),
        acc.afInlineSlots, acc.afSlotFields, acc.afNArray + nColours, acc.afDecomposed)
    (o: CgType) => alLayoutNonPtr(g2, colour, nColours, ti, acc)

fun alLayoutNonPtr(g2: TypeGroup, colour: List<NameIdx>, nColours: Int, ti: Int, acc: AFrame)
  ret match(alPtrLeaves(g2.tgType))
    (leaves: (ls: List<String>, n: Int)) => alLayoutDecomposed(colour, leaves.n, acc)
    ()                      => alLayoutInline(g2, colour, ti, acc)

# colour_base maps each distinct colour (sorted) to array base indices.
fun alLayoutDecomposed(colour: List<NameIdx>, width, acc: AFrame): AFrame
  let sorted2 = alSortedColours(colour)
  ret AFrame(acc.afPtrSlots, acc.afInlineSlots, acc.afSlotFields,
             acc.afNArray + width * sorted2.n,
             fold(colour, acc.afDecomposed, (d2, e2) =>
               put(d2, e2.niName, acc.afNArray + alIndexOfInt(sorted2.cs, e2.niIdx) * width)))

fun alLayoutInline(g2: TypeGroup, colour: List<NameIdx>, ti: Int, acc: AFrame): AFrame
  let sortedColours = alSortedColours(colour).cs
  let newFields = map(sortedColours, (c) => CgField("$slot$" + String(ti) + "$" + String(c), g2.tgType))
  ret AFrame(acc.afPtrSlots,
             fold(colour, acc.afInlineSlots, (d2, e2) =>
               put(d2, e2.niName, "$slot$" + String(ti) + "$" + String(e2.niIdx))),
             concat(acc.afSlotFields, newFields), acc.afNArray, acc.afDecomposed)

fun alDistinctColourCount(colour: List<NameIdx>): Int => alSortedColours(colour).n

# The distinct colours in use, ascending, and how many there are.
#
# A Set says both things directly. What this replaces collected the distinct
# values by scanning everything collected so far for each one, then sorted them
# with a hand-written selection sort — a full scan of the remainder to find
# each next smallest, and an append to put it at the end.
fun alSortedColours(colour: List<NameIdx>): (cs: List<Int>, n: Int)
  let distinct = fold(colour, Set(),
                     (acc, e2) => add(acc, e2.niIdx))
  ret (sort(distinct), size(distinct))

fun alIndexOfInt(l: List<Int>, x: Int) => match(findIndex(l, (y) => y == x))
  (i: Int) => i
  ()       => 0   # unreachable: x came from the list

# ── store/load between locals and the state object ───────────────────────────

# `sp` = the state-object base (Python's state_param argument): the HOT PATH
# and stub launch address the freshly-allocated $sv_state; the STATE MACHINE
# addresses its $state parameter. Hardcoding one base here read a never-
# written $state in the hot path's save block (uninit_check caught it).
fun alArrayElem(sp, stateName, index): RParam
  ret RpObjectField(CgDataPointer(false), sp, stateName, "array",
                    RpInteger(index, 32), false, false)

# Frame local reference: trailing-array slot | shared inline slot | named field.
fun alStateField(name, t2, sp, stateName, layout: AFrame)
  ret match(get(layout.afPtrSlots, name))
    (i: Int) => alArrayElem(sp, stateName, i)
    ()        => match(get(layout.afInlineSlots, name))
      (slot: String) => RpObjectField(t2, sp, stateName, slot, None, false, false)
      ()              => RpObjectField(t2, sp, stateName, name, None, false, false)

# local → state; a decomposed struct stores one leaf per array element.
fun alStoreVar(v, sp, stateName, layout: AFrame)
  ret match(get(layout.afDecomposed, stackVarName(v)))
    (base: Int) => alStoreDecomposed(v, sp, stateName, base)
    ()           => list1(OpMove(alStateField(stackVarName(v), rpGetType(v), sp, stateName, layout),
                                 v, false, Dict()))

fun alStoreDecomposed(v, sp, stateName, base) => match(alPtrLeaves(rpGetType(v)))
  (paths: (ls: List<String>, n: Int)) => alSdLoop(paths.ls, v, sp, stateName, base, 0, List())
  ()                     => List()   # unreachable: decomposed entries are all-ptr structs

fun alSdLoop(ps, v: RParam, sp, stateName,
                    base, i, acc: List<Op>)
  ret alSdLoopB(ps, v, sp, stateName, base, i, acc)

fun alSdLoopB(ps: List<String>, v: RParam, sp, stateName, base, i, acc: List<Op>) =>
  fold(ps, (i = i, acc = acc),
       (st, x) => alSdLoopBStep(st, x, v, sp, stateName, base)).acc

fun alSdLoopBStep(st: (i: Int, acc: List<Op>), x: String, v: RParam, sp, stateName, base) =>
  (i = st.i + 1,
  acc = append(st.acc, OpMove(alArrayElem(sp, stateName, base + st.i),
      alPathField(v, x), false, Dict())))

fun alPathField(v: RParam, path): RParam
  ret fold(splitPath(path), v, (a, f) => RpStructField(a, f))

fun splitPath(path) => splitPathLoop(path, 0, 0, List())

fun splitPathLoop(path, start, i, acc: List<String>): List<String>
  ret splitPathLoopB(path, start, i, acc)

fun [tail] splitPathLoopB(path, start, i, acc: List<String>): List<String>
  if i >= length(path)
    ret append(acc, slice(path, start, i))
  ret byteAt(path, i) == '/'
    ? splitPathLoopB(path, i + 1, i + 1, append(acc, slice(path, start, i)))
    : splitPathLoopB(path, start, i + 1, acc)

# state → local; a decomposed struct is rebuilt from its array elements via
# nested NewStructs (index walk in leaf order).
fun alLoadVar(v, sp, stateName, layout: AFrame): List<Op>
  ret match(get(layout.afDecomposed, stackVarName(v)))
    (base: Int) => list1(OpMove(v, alRebuild(rpGetType(v), sp, stateName, base).rbValue,
                                false, Dict()))
    ()           => list1(OpMove(v, alStateField(stackVarName(v), rpGetType(v), sp, stateName, layout),
                                 false, Dict()))

class [final] Rebuilt(rbValue: RParam, rbNext: Int)

# The values go into the struct in FIELD order, matching the index walk that
# reads them out of the array, so they are built at the tail.
fun alRebuild(t2, sp, stateName, idx): Rebuilt
  ret alRebuildFields(cgFieldsOfOrEmpty(t2), sp, stateName, idx,
                      List())

fun [tail] alRebuildFields(fields: List<CgField>, sp, stateName, idx,
                           acc): Rebuilt
  if isEmpty(fields)
    ret Rebuilt(RpNewStruct(acc), idx)
  let f2 = forceNth(fields, 0)
  let rest = dropOne(fields)
  ret match(f2.fieldType)
    (s2: CgStruct) => alRebuildNested(f2, rest, sp, stateName, idx, acc)
    (im: CgImmediateStruct) => alRebuildNested(f2, rest, sp, stateName, idx, acc)
    (o: CgType)    => alRebuildFields(rest, sp, stateName, idx + 1,
                        append(acc,
                            RpNamedValue(f2.fieldName,
                                         alArrayElem(sp, stateName, idx))))

fun alRebuildNested(f2: CgField, rest: List<CgField>, sp, stateName, idx,
                    acc): Rebuilt
  let inner = alRebuild(f2.fieldType, sp, stateName, idx)
  ret alRebuildFields(rest, sp, stateName, inner.rbNext,
                      append(acc,
                          RpNamedValue(f2.fieldName, inner.rbValue)))

# ── musttail unroll (SM view) + state object ────────────────────────────────

# A SYNC musttail is expanded in place (alExpandSyncCall) and never splits a
# block, so no block result declares its temp — the unroll declares it (and
# any wrap local) itself, as Python's does.
fun alUnrollMusttail(f: CgFunction)
  let um = alUmLoop(f.fnOps, 0i32, 0, UmAcc(seqBuilder(), List()))
  ret cgFunctionWith(f, build(um.uaOps),
                     cgStructAdd(f.fnStackVars, CgStruct(um.uaVars)))

class [linear, final] UmAcc(uaOps: SeqBuilder<Op>, uaVars: List<CgField>)

fun [tail] alUmLoop(s: Segment<Op>|None, iSeg, counter,
                    [terminal] acc: UmAcc): UmAcc => match(s)
  (nil: None)        => acc
  (seg: Segment<Op>) => iSeg >= seg.length
    ? alUmLoop(seg.next, 0i32, counter, acc)
    : match(alUmOne(seg.array(iSeg), counter))
        (u: UmOut) => alUmLoop(s, iSeg + 1i32, u.umCounter,
                               UmAcc(pushAll(acc.uaOps, u.umOps), concat(acc.uaVars, u.umVars)))
        ()          => alUmLoop(s, iSeg + 1i32, counter,
                                UmAcc(push(acc.uaOps, seg.array(iSeg)), acc.uaVars))

class [final] UmOut(umOps: List<Op>, umCounter: Int, umVars: List<CgField>)

fun alUmOne(op, counter) => match(op)
  (c: OpCall) => c.callMusttail ? alUmCall(c, counter + 1) : None
  (o: Op)     => None

fun alUmCall(c: OpCall, n) => alResultTypeVoidish(c.callResultType)
  ? UmOut(list2(OpCall(c.callFunction, c.callParameters, None, false, c.callImpure,
                       c.callResultType, c.callSavedVars),
                OpReturnVoid(Dict())), n, List())
  : alUmValued(c, n)

fun alUmValued(c: OpCall, n)
  let tmpName = "$musttail$ret$" + String(n)
  let tmpType = alForceResultType(c.callResultType)
  let tmp = RpStackVar(tmpType, tmpName)
  let call = OpCall(c.callFunction, c.callParameters, tmp, false, c.callImpure,
                    c.callResultType, c.callSavedVars)
  if opCallIsSync(call)
    let se = alExpandSyncCall(call, "$syncwrap$" + tmpName)
    ret UmOut(concat(se.seOps, list1<Op>(OpReturn(tmp, Dict()))), n,
              prepend(CgField(tmpName, tmpType), se.seVars))
  ret UmOut(list2<Op>(call, OpReturn(tmp, Dict())), n, List())

# ── deferred awaits (defer_awaits.yafl places them) ─────────────────────────
# An OpAwait realises a deferred call's result where it is used: it parks only
# on a task still running; a completed one is read in place, so every later use
# is a test. A returned OpAwait is for a Return of the whole value: the hot path
# hands the pending value to the caller as it stands.

# When a function's only suspension points are returned OpAwaits it never
# parks: each such OpAwait, with the projection and Return that follow it,
# becomes the Return of the pending value itself, and the function needs no
# state machine.
fun alReturnUnparked(f: CgFunction): CgFunction
  if !any(f.fnOps, alIsReturnedAwait) || any(f.fnOps, alParksUnreturned)
    ret f
  ret cgFunctionWith(f, build(alRuLoop(cgOpsToList(f.fnOps), false, seqBuilder())),
                     f.fnStackVars)

fun alIsReturnedAwait(op) => match(op)
  (aw: OpAwait) => aw.awaitReturned
  (o: Op)       => false

fun alParksUnreturned(op) => alIsSplitter(op) && !alIsReturnedAwait(op)

fun alRuLoop(os: List<Op>, skipping: Bool, [terminal] acc: SeqBuilder<Op>): SeqBuilder<Op> =>
  fold(os, (skipping = skipping, acc = acc),
       alRuLoopStep).acc

fun alRuLoopStep(st: (skipping: Bool, acc: SeqBuilder<Op>), x: Op) =>
  st.skipping
  ? (skipping = !(x is OpReturn), acc = st.acc)
  : match(x)
    (aw: OpAwait) => (skipping = true, acc = push(st.acc, OpReturn(aw.awaitSource, Dict())))
    (o: Op) => (skipping = false, acc = push(st.acc, o))

# A deferred await's test, and the value of one that did not park: from the
# completed task when there was one, else as the call returned it.
# The task an Await's pending value holds, untagged, or NULL.
fun alAwaitTask(aw: OpAwait) => pendingTaskOf(aw.awaitSource, rpGetType(aw.awaitSource))

fun alTaskRunning(aw: OpAwait) => RpRuntimeInvoke("TASK_RUNNING",
                                                  RpNewStruct(list1(RpNamedValue("task", alAwaitTask(aw)))),
                                                  CgInt(32))

fun alAwaitValue(aw: OpAwait, label: String): List<Op>
  let resultType = rpGetType(aw.awaitRegister)
  ret concat(list3<Op>(OpJumpIf(label + "$done", alAwaitTask(aw), false, Dict()),
                       OpMove(aw.awaitRegister, unwrapValue(aw.awaitSource, resultType), false, Dict()),
                       OpJump(label + "$end", Dict())),
             list3<Op>(OpLabel(label + "$done", Dict()),
                       OpMove(aw.awaitRegister, alTaskResultOf(alAwaitTask(aw), resultType), false, Dict()),
                       OpLabel(label + "$end", Dict())))

# __extract_from_task: the result a completed task carries.
fun alTaskResultOf(task: RParam, resultType: CgType): RParam
  if isUnit(resultType)
    ret RpZeroOf(resultType)
  ret match(taskSubtypeName(resultType))
    (st: String) => RpObjectField(resultType, task, st, "result", None, false, false)
    ()            => RpNullPointer()

# ── sync calls (async_lower.py __expand_sync_call / __expand_sync_calls) ────
# A call proven sync is a plain call: no block split, no IfTask. It keeps the
# uniform task-carrying return ABI — its callee may also be reached from a
# may-suspend site — so a primitive result is received in its wrapped shape
# and unwrapped, and every result passes a debug-build OpAssertNotTask.

class [final] SyncExp(seOps: List<Op>, seVars: List<CgField>)

fun alExpandSyncCall(c: OpCall, wrapName: String): SyncExp => match(c.callRegister)
  (reg: RParam) => alExpandSyncValued(c, reg, wrapName)
  ()            => alResultTypeVoidish(c.callResultType)
                     ? SyncExp(list1<Op>(c), List())   # void: nothing comes back to check
                     : alExpandSyncReceived(c, None, alForceResultType(c.callResultType), wrapName)

fun alExpandSyncValued(c: OpCall, reg: RParam, wrapName: String)
  let resultType = rpGetType(reg)
  let wrapped = wrapReturnType(resultType)
  ret eqCgType(wrapped, resultType)
    ? SyncExp(list2<Op>(c, OpAssertNotTask(isTaskParam(reg, wrapped), Dict())), List())
    : alExpandSyncReceived(c, reg, resultType, wrapName)

# Receive into `wrapName` (the wrapped shape), check, and unwrap into the
# original register when there is one.
fun alExpandSyncReceived(c: OpCall, reg: RParam|None, resultType, wrapName: String)
  let wrapped = wrapReturnType(resultType)
  let received = RpStackVar(wrapped, wrapName)
  let checked = list2<Op>(OpCall(c.callFunction, c.callParameters, received, c.callMusttail,
                             c.callImpure, c.callResultType, c.callSavedVars),
                      OpAssertNotTask(isTaskParam(received, wrapped), Dict()))
  let ops = match(reg)
    (r: RParam) => concat(checked, list1<Op>(OpMove(r, unwrapValue(received, resultType), false, Dict())))
    ()          => checked
  ret SyncExp(ops, list1(CgField(wrapName, wrapped)))

fun alIsSyncNontailCall(op) => match(op)
  (c: OpCall) => !c.callMusttail && opCallIsSync(c)
  (o: Op)     => false

class [linear, final] EscAcc(ecOps: SeqBuilder<Op>, ecVars: List<CgField>, ecGrew: Bool)

# Expand every non-tail sync call. Runs after tail discovery, so a sync call
# in tail position stays a musttail passing its callee's result straight
# through. Unchanged (Python returns fn itself) unless an expansion grew.
fun alExpandSyncCalls(f: CgFunction)
  let acc = alEscLoop(f.fnOps, 0i32, 0, EscAcc(seqBuilder(), List(), false))
  let grew = acc.ecGrew
  let vars = acc.ecVars
  let ops = build(acc.ecOps)
  ret grew ? cgFunctionWith(f, ops, cgStructAdd(f.fnStackVars, CgStruct(vars))) : f

fun [tail] alEscLoop(s: Segment<Op>|None, iSeg, index,
                     [terminal] acc: EscAcc): EscAcc => match(s)
  (nil: None)        => acc
  (seg: Segment<Op>) => iSeg >= seg.length
    ? alEscLoop(seg.next, 0i32, index, acc)
    : alEscLoop(s, iSeg + 1i32, index + 1, alEscOne(seg.array(iSeg), index, acc))

fun alEscOne(op, index: Int, [terminal] acc: EscAcc): EscAcc => match(op)
  (c: OpCall) => alIsSyncNontailCall(op)
    ? alEscPush(alExpandSyncCall(c, alSyncWrapName(c.callRegister, index)), acc)
    : EscAcc(push(acc.ecOps, op), acc.ecVars, acc.ecGrew)
  (o: Op)     => EscAcc(push(acc.ecOps, op), acc.ecVars, acc.ecGrew)

fun alEscPush(se: SyncExp, [terminal] acc: EscAcc): EscAcc
  ret EscAcc(pushAll(acc.ecOps, se.seOps), concat(acc.ecVars, se.seVars),
             acc.ecGrew || atLeast(se.seOps, 2))

fun alSyncWrapName(reg: RParam|None, index: Int) => match(reg)
  (r: RParam) => alSyncWrapNameOf(r, index)
  ()          => "$syncwrap$" + String(index)

fun alSyncWrapNameOf(reg: RParam, index: Int) => match(reg)
  (sv: RpStackVar) => "$syncwrap$" + sv.name
  (o: RParam)      => "$syncwrap$" + String(index)

fun alForceResultType(t2: CgType|None) => match(t2)
  (x: CgType) => x
  ()           => CgDataPointer(false)   # unreachable: valued musttails carry a type

# State object: type, my_task, <inline PTR-BEARING slots>, idx, $ptr_count,
# <non-ptr slots>, array[0] — pointer slots kept LOW for the location mask.
fun alCreateStateObject(f: CgFunction, stateName, layout: AFrame)
  let inlinePtr = filter(layout.afSlotFields, (f2) => cgHasPointers(f2.fieldType))
  let nonPtr = filter(layout.afSlotFields, (f2) => !cgHasPointers(f2.fieldType))
  # The layout is fixed: header, pointer-bearing inline slots, index and
  # pointer count, non-pointer slots, and the GC array LAST — it is a trailing
  # flexible array, so nothing may follow it. One builder, in that order.
  let fl0 = list2(CgField("type", CgDataPointer(false)),
                              CgField("my_task", CgDataPointer(false)))
  let fl1 = concat(fl0, inlinePtr)
  let fl2 = concat(fl1,
                list2(CgField("idx", CgInt(32)),
                      CgField("$ptr_count", CgInt(32))))
  let fl3 = concat(fl2, nonPtr)
  let fields = append(fl3,
                   CgField("array", CgArray(CgDataPointer(false), 0)))
  ret CgObject(stateName, List(), List(),
               CgImmediateStruct(fields), "$ptr_count", f.fnComment,
               false, true, 0)   # is_mutable: idx + live vars rewritten at every suspension

# ── hot-path function ────────────────────────────────────────────────────────

# All state-resident vars over bbs[:-1]: sorted live per block + result reg,
# first-seen dedup — the prologue zero-inits every NON-PARAM one (GC safety
# for cold blocks firing before later sites' vars are assigned).
# DISCOVERY ORDER IS OBSERVED HERE — this is the one place a StackVar set's
# order reaches the output. The list becomes the hot path's zero-init
# prologue, and Python builds it with all_state_vars.append(var) in exactly
# this order (per block: live-sorted, then the block's result register). So it
# is a builder with a separate membership set.
class [final] AsvAcc(asOrder: List<RParam>, asSeen: Set<String>)

fun alAllStateVars(bbs: List<ABlock>)
  ret asvBuild(alAsvLoop(alNonTerminal(bbs),
                         AsvAcc(List(), Set())))

fun asvBuild(acc: AsvAcc) => acc.asOrder

fun alAsvLoop(bs: List<ABlock>, acc) =>
  fold(bs, acc, alAsvBlock)

fun alAsvBlock(acc, bb: ABlock) => match(bb.abResult)
  (r: RParam) => asvAdd(alAsvLive(vsSorted(bb.abLive), acc), r)
  ()          => alAsvLive(vsSorted(bb.abLive), acc)

fun alAsvLive(vs: List<RParam>, acc) =>
  fold(vs, acc, asvAdd)

fun asvAdd(acc, v) => contains(acc.asSeen, stackVarName(v))
  ? acc
  : AsvAcc(append(acc.asOrder, v),
           add(acc.asSeen, stackVarName(v)))

fun alZeroVal(t2) => match(t2)
  (d: CgDataPointer) => RpNullPointer()
  (i: CgInt)         => RpInteger(0, i.precision)
  (o: CgType)        => RpZeroOf(t2)

class [final] HotOut(hoOps: List<Op>, hoWrapFields: List<CgField>)

# The same two lists while they are being BUILT. Both are ordered — the ops are
# instruction order, the wrap fields are frame-field order — and every hot site
# used to concat its ops onto everything emitted so far, so assembling a
# function was quadratic in its own instruction count. HotOut stays a plain
# record because the assembler reads it several times; only the walk is linear.
class [final] HotAcc(haOps: List<Op>,
                             haWrapFields: List<CgField>)

fun hotBuild(acc: HotAcc) => HotOut(acc.haOps, acc.haWrapFields)

# Zero-init every state-resident var that is not already a parameter, in the
# order alAllStateVars settled on.
fun alHotPrologue(vs: List<RParam>,
                  paramNames: List<String>,
                  acc: List<Op>) =>
  fold(vs, acc, (a, x) => strListMember(paramNames, stackVarName(x))
    ? a
    : append(a, OpMove(x,
                                     alZeroVal(rpGetType(x)),
                                     false, Dict())))

fun alCreateHotPathFunc(f: CgFunction, stateName, subtype: String|None,
                        bbs: List<ABlock>, layout: AFrame)
  let wrappedResult = wrapReturnType(f.fnResult)
  let paramNames = map(cgFieldsOfOrEmpty(f.fnParams), (fld) => fld.fieldName)
  # The prologue's zero-inits open the op stream, so the builder starts with
  # them and the hot sites push onto the same one; the terminal block's ops
  # close it.
  let prologue = alHotPrologue(alAllStateVars(bbs), paramNames,
                               List())
  let body = alHotSites(alNonTerminal(bbs), f, f.fnResult, 0,
                        HotAcc(prologue, List()))
  let withTerminal = hotBuild(
      HotAcc(concat(body.haOps,
                 alConvertReturnsHot(alLastBlock(bbs).abOps,
                                     f.fnResult)),
             body.haWrapFields))
  ret f.fnSync
    ? alHotAssembleSync(f, wrappedResult, withTerminal)
    : alHotAssembleAsync(f, stateName, subtype, bbs, layout, wrappedResult, withTerminal)

fun alLastBlock(bbs: List<ABlock>) => match(head(takeLastOne(bbs)))
  (bb: ABlock) => bb
  ()            => ABlock("", List(), Dict(), None)   # unreachable: >=1 block always

fun alHotSites(bs: List<ABlock>,
               f: CgFunction,
               fnResult,
               i,
               acc: HotAcc) =>
  fold(bs, (acc = acc, i = i),
       (st, x) => (acc = alHotSite(x, f, fnResult, st.i, st.acc), i = st.i + 1)).acc

fun alHotSite(bb: ABlock, f: CgFunction, fnResult, i,
              acc) => match(lastOp(bb.abOps))
  (op: Op) => match(op)
    (c: OpCall)              => alHotCall(bb, c, fnResult, i, acc)
    (aw: OpAwait)            => alHotAwait(bb, aw, fnResult, i, acc)
    # The last block ends in its own terminator; every other ends in a splitter.
    (x: OpLabel)             => acc
    (x: OpMove)              => acc
    (x: OpJump)              => acc
    (x: OpJumpIf)            => acc
    (x: OpIfTask)            => acc
    (x: OpAssertNotTask)     => acc
    (x: OpSwitchJump)        => acc
    (x: OpNewObject)         => acc
    (x: OpReturnVoid)        => acc
    (x: OpAbort)             => acc
    (x: OpReturn)            => acc
    (x: OpPhi)               => acc
    (x: OpProfEnter)         => acc
    (x: OpProfLeave)         => acc
  ()        => acc

# The deferred call ran earlier: park on its task if it is still running, else
# take the value — from the task, or as returned. Returned whole, the caller
# takes the pending value as it stands.
fun alHotAwait(bb: ABlock, aw: OpAwait, fnResult, i,
               acc: HotAcc)
  let ops1 = concat(acc.haOps,
                 alConvertReturnsHot(dropLastOne(bb.abOps),
                                     fnResult))
  if aw.awaitReturned
    ret HotAcc(append(ops1, OpReturn(aw.awaitSource, Dict())), acc.haWrapFields)
  let ops2 = append(ops1, OpIfTask(alTaskRunning(aw), alAwaitTask(aw), alSvAsyncTask(), alSvCallId(),
                                 i + 1, "$asynccommon", Dict()))
  ret HotAcc(concat(ops2, alAwaitValue(aw, "$await$" + String(i))),
             acc.haWrapFields)

fun alHotCall(bb: ABlock, c: OpCall, fnResult, i,
              acc: HotAcc) => match(c.callRegister)
  (reg: RParam) => alHotValued(bb, c, reg, fnResult, i, acc)
  ()             => alHotDiscarded(bb, c, fnResult, i, acc)

# register None + result_type None → pure void: emit unchanged. Non-void
# discarded → $wrap$<i> temp + IfTask, no unwrap Move.
fun alHotDiscarded(bb: ABlock, c: OpCall, fnResult, i,
                   acc: HotAcc) => match(c.callResultType)
  (dt: CgType) => alHotDiscardedTyped(bb, c, dt, fnResult, i, acc)
  ()            => HotAcc(concat(acc.haOps,
                              alConvertReturnsHot(bb.abOps,
                                                  fnResult)),
                          acc.haWrapFields)

fun alHotDiscardedTyped(bb: ABlock, c: OpCall, dt, fnResult,
                        i, acc: HotAcc)
  let dw = wrapReturnType(dt)
  let svWrap = RpStackVar(dw, "$wrap$" + String(i))
  let ops1 = concat(acc.haOps,
                 alConvertReturnsHot(dropLastOne(bb.abOps),
                                     fnResult))
  let ops2 = append(ops1, OpCall(c.callFunction, c.callParameters, svWrap,
                               c.callMusttail, c.callImpure,
                               c.callResultType, c.callSavedVars))
  ret HotAcc(append(ops2, alIfTaskOp(svWrap, dw, i)),
             append(acc.haWrapFields,
                  CgField("$wrap$" + String(i), dw)))

fun alIfTaskOp(sv, wrapped, i) => OpIfTask(isTaskParam(sv, wrapped), taskPtrFrom(sv, wrapped),
                                           alSvAsyncTask(), alSvCallId(), i + 1, "$asynccommon", Dict())

# needs_temp: Python tests `wrapped is not result_type` — the wrap function
# returns its input unchanged for pass-through shapes, so structural
# inequality is the faithful port.
fun alHotValued(bb: ABlock, c: OpCall, reg, fnResult,
                i, acc: HotAcc)
  let resultType = rpGetType(reg)
  let wrappedType = wrapReturnType(resultType)
  ret eqCgType(wrappedType, resultType)
    ? alHotValuedDirect(bb, c, reg, wrappedType, fnResult, i, acc)
    : alHotValuedTemp(bb, c, reg, wrappedType, fnResult, i, acc)

fun alHotValuedDirect(bb: ABlock, c: OpCall, reg, wrappedType,
                      fnResult, i,
                      acc: HotAcc)
  let ops1 = concat(acc.haOps,
                 alConvertReturnsHot(bb.abOps, fnResult))
  ret HotAcc(append(ops1, alIfTaskOp(reg, wrappedType, i)),
             acc.haWrapFields)

fun alHotValuedTemp(bb: ABlock, c: OpCall, reg, wrappedType,
                    fnResult, i,
                    acc: HotAcc)
  let svWrap = RpStackVar(wrappedType, "$wrap$" + String(i))
  let ops1 = concat(acc.haOps,
                 alConvertReturnsHot(dropLastOne(bb.abOps),
                                     fnResult))
  let ops2 = append(ops1, OpCall(c.callFunction, c.callParameters, svWrap,
                               c.callMusttail, c.callImpure,
                               c.callResultType, c.callSavedVars))
  let ops3 = append(ops2, alIfTaskOp(svWrap, wrappedType, i))
  ret HotAcc(append(ops3, OpMove(reg, unwrapValue(svWrap, rpGetType(reg)),
                               false, Dict())),
             append(acc.haWrapFields,
                  CgField("$wrap$" + String(i), wrappedType)))

# sync: $asynccommon aborts (a proven-sync fn reached it = broken contract).
fun alHotAssembleSync(f: CgFunction, wrappedResult, body: HotOut): CgFunction
  let commonOps = list2<Op>(OpLabel("$asynccommon", Dict()),
                        OpAbort("sync function reached $asynccommon", Dict()))
  let extra = concat(list2(CgField("$sv_call_id", CgInt(32)),
                           CgField("$sv_async_task", CgDataPointer(false))),
                     body.hoWrapFields)
  ret CgFunction(f.fnName, f.fnParams, wrappedResult,
                 CgStruct(concat(cgFieldsOfOrEmpty(f.fnStackVars), extra)),
                 cgOpsOf(concat(body.hoOps, commonOps)), f.fnComment, f.fnForeignSymbol,
                 f.fnSync, f.fnTail, f.fnBypassAsync, f.fnAlwaysInline,
                 f.fnSourceFile, f.fnSourceLine, f.fnFuture)

fun alHotAssembleAsync(f: CgFunction, stateName, subtype: String|None,
                       bbs: List<ABlock>, layout: AFrame, wrappedResult,
                       body: HotOut): CgFunction
  let nonTerminal = alNonTerminal(bbs)
  # The hot-path ops it was handed, then the async-common epilogue appended
  # in emission order.
  let common0 = concat(
      body.hoOps,
      list2(OpLabel("$asynccommon", Dict()),
            OpNewObject(stateName, alSvState(),
                        RpInteger(layout.afNArray, 32),
                        false, Dict())))
  # Save only the suspending site's live set — shared slots must not be
  # clobbered by dead locals — dispatched on the recorded call id (1-based).
  let common1 = append(common0,
                       OpSwitchJump(alSvCallId(),
                                    alSaveCases(nonTerminal, 0, List()),
                                    Dict()))
  let common2 = append(common1, OpJump("$save$done", Dict()))
  let common3 = alSaveBlocks(nonTerminal, stateName, layout, 0, common2)
  let common4 = append(common3, OpLabel("$save$done", Dict()))
  let common5 = concat(common4, list2(
      OpMove(RpObjectField(CgDataPointer(false), alSvState(), stateName, "my_task", None, false, false),
             RpNullPointer(), false, Dict()),
      OpMove(RpObjectField(CgInt(32), alSvState(), stateName, "idx", None, false, false),
             alSvCallId(), false, Dict())))
  let common6 = concat(common5,
                            alEmitTaskAlloc(alSvTask(), subtype))
  let callback = RpGlobalFunction(f.fnName + "$async", alSvState(), false, None, false, false)
  let common7 = concat(common6, list3(
      OpMove(RpObjectField(CgDataPointer(false), alSvState(), stateName, "my_task", None, false, false),
             alSvTask(), false, Dict()),
      alRuntimeDiscard(alSvDiscard(), "task_on_complete",
                       list2(RpNamedValue("task", alSvAsyncTask()),
                             RpNamedValue("cb", callback))),
      OpReturn(RpTagTask(alSvTask(), wrappedResult), Dict())))
  let extra = concat(list5(CgField("$sv_state", CgDataPointer(false)),
                           CgField("$sv_task", CgDataPointer(false)),
                           CgField("$sv_discard", CgDataPointer(false)),
                           CgField("$sv_call_id", CgInt(32)),
                           CgField("$sv_async_task", CgDataPointer(false))),
                     body.hoWrapFields)
  ret CgFunction(f.fnName, f.fnParams, wrappedResult,
                 CgStruct(concat(cgFieldsOfOrEmpty(f.fnStackVars), extra)),
                 cgOpsOf(common7), f.fnComment, f.fnForeignSymbol,
                 f.fnSync, f.fnTail, f.fnBypassAsync, f.fnAlwaysInline,
                 f.fnSourceFile, f.fnSourceLine, f.fnFuture)

fun alSaveCases(bs: List<ABlock>, i, acc: List<OpCase>)
  ret alSaveCasesB(bs, i, acc)

fun alSaveCasesB(bs: List<ABlock>, i, acc): List<OpCase> =>
  fold(bs, (acc = acc, i = i),
       (st, x) => (acc = append(st.acc, OpCase(st.i + 1, "$save$" + String(st.i))), i = st.i + 1)).acc

fun alSaveBlocks(bs: List<ABlock>, stateName, layout: AFrame, i, acc: List<Op>) =>
  fold(bs, (i = i, acc = acc),
       (st, x) => alSaveBlocksStep(st, x, stateName, layout)).acc

fun alSaveBlocksStep(st: (i: Int, acc: List<Op>), x: ABlock, stateName, layout: AFrame) =>
  (i = st.i + 1,
  acc = append(
      alSaveStores(x, stateName, layout,
          append(st.acc, OpLabel("$save$" + String(st.i), Dict()))),
      OpJump("$save$done", Dict())))

# Hot-path $asynccommon save: the base is the freshly-allocated $sv_state
# (Python 948: __store_var(var, __sv_state, ...)).
fun alSaveStores(bb: ABlock, stateName, layout: AFrame,
                 acc): List<Op>
  ret alSaveStoresLoop(vsSorted(bb.abLive), stateName, layout,
                       acc)

fun alSaveStoresLoop(vs: List<RParam>,
                     stateName,
                     layout: AFrame,
                     acc: List<Op>) =>
  fold(vs, acc, (a, x) => concat(a, alStoreVar(x, alSvState(),
                              stateName, layout)))

# ── stub launch (oversized looping bodies) ───────────────────────────────────

fun alStubThresholdOps() => 256

# Stub mode: every UNPLACED param gains a state field (stub stores, entry
# case reloads).
# Of the four parts of a frame layout, only afSlotFields is ORDER-bearing — it
# becomes struct fields. The other three are keyed by name. The slot fields are SELECTED from the parameters in
# parameter order rather than appended one at a time.
#
# alPlaced is asked of the ORIGINAL layout throughout: parameter names are
# distinct, and every entry added here is named after the parameter that added
# it, so no parameter can be blocked by another parameter's entry.
fun alAugmentLayoutWithParams(layout: AFrame, params: List<CgField>)
  let slotted = filter(params, (p) => alAugIsSlotField(layout, p))
  ret fold(params, AFrame(layout.afPtrSlots, layout.afInlineSlots,
                          concat(layout.afSlotFields, slotted),
                          layout.afNArray, layout.afDecomposed),
           (acc, p) => alAugOne(layout, acc, p))

fun alAugIsSlotField(layout: AFrame, p: CgField) => alPlaced(layout, p.fieldName)
  ? false
  : match(p.fieldType)
    (d: CgDataPointer) => false
    (o: CgType)        => alPtrLeaves(p.fieldType) is None

fun alAugOne(layout: AFrame, acc, p: CgField)
  if alPlaced(layout, p.fieldName)
    ret acc
  ret match(p.fieldType)
    (d: CgDataPointer) => AFrame(put(acc.afPtrSlots, p.fieldName, acc.afNArray),
                                 acc.afInlineSlots, acc.afSlotFields,
                                 acc.afNArray + 1, acc.afDecomposed)
    (o: CgType)        => alAugNonPtr(acc, p)

fun alAugNonPtr(acc: AFrame, p: CgField) => match(alPtrLeaves(p.fieldType))
  (leaves: (ls: List<String>, n: Int)) =>
      AFrame(acc.afPtrSlots, acc.afInlineSlots, acc.afSlotFields,
             acc.afNArray + leaves.n,
             put(acc.afDecomposed, p.fieldName, acc.afNArray))
  ()  => AFrame(acc.afPtrSlots,
                put(acc.afInlineSlots, p.fieldName, p.fieldName),
                acc.afSlotFields, acc.afNArray, acc.afDecomposed)

fun alPlaced(acc: AFrame, name: String) => contains(acc.afPtrSlots, name)
    || contains(acc.afInlineSlots, name)
    || contains(acc.afDecomposed, name)
    || any(acc.afSlotFields, (f2) => f2.fieldName == name)

fun alCreateStubLaunchFunc(f: CgFunction, stateName, subtype: String|None,
                           layout: AFrame, entryIdx): CgFunction
  let wrappedResult = wrapReturnType(f.fnResult)
  let ops0 = list1<Op>(OpNewObject(stateName, alSvState(), RpInteger(layout.afNArray, 32), false, Dict()))
  # Stub launch stores into its own fresh $sv_state (Python 1053).
  let ops1 = fold(cgFieldsOfOrEmpty(f.fnParams), ops0, (acc, p) =>
               concat(acc, alStoreVar(RpStackVar(p.fieldType, p.fieldName), alSvState(), stateName, layout)))
  let ops2 = concat(ops1, list2(
      OpMove(RpObjectField(CgDataPointer(false), alSvState(), stateName, "my_task", None, false, false),
             RpNullPointer(), false, Dict()),
      OpMove(RpObjectField(CgInt(32), alSvState(), stateName, "idx", None, false, false),
             RpInteger(entryIdx, 32), false, Dict())))
  let ops3 = concat(ops2, alEmitTaskAlloc(alSvTask(), subtype))
  let ops4 = concat(ops3, list3(
      OpMove(RpObjectField(CgDataPointer(false), alSvState(), stateName, "my_task", None, false, false),
             alSvTask(), false, Dict()),
      # The machine's C signature is ($state, $completed_task); the state
      # rides the callee-object slot.
      OpCall(RpGlobalFunction(f.fnName + "$async", alSvState(), false, None, false, false),
             RpNewStruct(list1(RpNamedValue("$completed_task", RpNullPointer()))),
             None, false, false, None, Dict()),
      OpReturn(RpTagTask(alSvTask(), wrappedResult), Dict())))
  # Declare $sv_discard exactly when the ops write it (synthesised-subtype
  # task_init discards through it; the other alloc paths don't).
  let svFields = alOpsWriteDiscard(ops4)
    ? list3(CgField("$sv_state", CgDataPointer(false)), CgField("$sv_task", CgDataPointer(false)),
            CgField("$sv_discard", CgDataPointer(false)))
    : list2(CgField("$sv_state", CgDataPointer(false)), CgField("$sv_task", CgDataPointer(false)))
  ret CgFunction(f.fnName, f.fnParams, wrappedResult, CgStruct(svFields), cgOpsOf(ops4),
                 f.fnComment, f.fnForeignSymbol, f.fnSync, f.fnTail,
                 f.fnBypassAsync, f.fnAlwaysInline,
                 f.fnSourceFile, f.fnSourceLine, f.fnFuture)

fun alOpsWriteDiscard(ops: List<Op>) => any(ops, alWritesDiscard)

fun alWritesDiscard(op) => match(op)
  (m: OpMove) => match(m.moveTarget)
    (sv: RpStackVar) => sv.name == "$sv_discard"
    (o: RParam)       => false
  (o2: Op)     => false

# ── state-machine function ───────────────────────────────────────────────────

# void fn$async($state, $completed_task): dispatch on $state->idx, run the
# body on ORDINARY LOCALS (fields touched only at boundaries), park via the
# per-site cold blocks. Deliberately phi-lowered at the resume joins —
# ssa_validate exempts $async multi-defs.
fun alCreateStateMachineFunc(f: CgFunction, stateName: String, subtype: String|None,
                             bbs: List<ABlock>, layout: AFrame, withEntryCase: Bool): CgFunction
  let nt = alNonTerminalN(bbs)
  let nonTerminal = nt.bs
  let n = nt.n
  # Park stores skip loaded-only vars (loop invariants — their field is
  # already current; the only way in is a dispatch load).
  let bodyDefs = fold(bbs, Set(), (acc, bb) =>
                   fold(bb.abOps, acc, (a, op) =>
                     fold(alWritesOf(op), a, (a2, w) =>
                       add(a2, stackVarName(w)))))
  let idxField = RpObjectField(CgInt(32), alStateParam(), stateName, "idx", None, false, false)
  let myTaskField = RpObjectField(CgDataPointer(false), alStateParam(), stateName, "my_task", None, false, false)
  let dispatch0 = alSmDispatchSwitch(n, withEntryCase, idxField)
  let body = alSmSites(nonTerminal, f, stateName, subtype, layout, bodyDefs,
                       idxField, myTaskField, 0,
                       SmAcc(dispatch0,
                             List(), List()))
  let withTerminal = smBuild(
      SmAcc(concat(body.saOps,
                alConvertReturnsSm(alLastBlock(bbs).abOps,
                                   myTaskField, f.fnResult,
                                   subtype)),
            body.saCold, body.saWrapFields))
  let dispatchTail = alSmDispatchTail(nonTerminal, f, stateName, layout, withEntryCase, bbs)
  let allOps = alPrunePhiSources(concat(concat(withTerminal.smOps, withTerminal.smCold), dispatchTail))
  ret alSmAssemble(f, allOps, bbs, withTerminal.smWrapFields)

class [final] SmOut(smOps: List<Op>, smCold: List<Op>, smWrapFields: List<CgField>)

# The same three lists while they are being BUILT. All three are ordered — the
# body ops, the cold park blocks and the frame's wrap fields — and every
# suspension site used to concat its ops onto everything emitted before it, so
# lowering a state machine was quadratic in its own instruction count. SmOut
# stays plain because the assembler reads it repeatedly; only the walk is
# linear.
class [final] SmAcc(saOps: List<Op>, saCold: List<Op>,
                            saWrapFields: List<CgField>)

fun smBuild(acc: SmAcc) => SmOut(acc.saOps, acc.saCold,
                                 acc.saWrapFields)

# Case 0 is unused; cases 1..n are the suspension sites in index order, and
# the entry case — when there is one — comes after them.
fun alSmDispatchSwitch(n, withEntryCase: Bool, idxField): List<Op>
  let cases = alSmCases(n, 0, List())
  let cases2 = (withEntryCase
    ? append(cases, OpCase(n + 1, "$case$entry"))
    : cases)
  ret withEntryCase
    ? list2(OpSwitchJump(idxField, cases2, Dict()),
            OpLabel("$sm$body", Dict()))
    : list1(OpSwitchJump(idxField, cases2, Dict()))

fun [tail] alSmCases(n, i,
                     acc: List<OpCase>): List<OpCase>
  if i >= n
    ret acc
  ret alSmCases(n, i + 1,
                append(acc, OpCase(i + 1, "$case$" + String(i + 1))))

fun alSmSites(bs: List<ABlock>, f: CgFunction, stateName, subtype: String|None, layout: AFrame,
              bodyDefs: Set<String>, idxField, myTaskField, i, acc) =>
  fold(bs, (i = i, acc = acc),
       (st, x) => alSmSitesStep(st, x, f, stateName, subtype, layout, bodyDefs, idxField, myTaskField)).acc

fun alSmSitesStep(st: (i: Int, acc: SmAcc), x: ABlock, f: CgFunction, stateName,
                  subtype: String|None, layout: AFrame, bodyDefs: Set<String>, idxField, myTaskField) =>
  (i = st.i + 1,
  acc = alSmSite(x, f, stateName, subtype, layout, bodyDefs,
      idxField, myTaskField, st.i, st.acc))

# The state saves for one site, in live order: one builder, not a concat per
# variable.
fun alSmSaves(vs: List<RParam>,
              bodyDefs: Set<String>,
              stateName,
              layout: AFrame,
              acc: List<Op>): List<Op> =>
  fold(vs, acc, (a, x) => contains(bodyDefs, stackVarName(x))
                                 ? concat(a, alStoreVar(x, alStateParam(), stateName, layout))
                                 : a)

fun alSmSite(bb: ABlock, f: CgFunction, stateName, subtype: String|None,
             layout: AFrame, bodyDefs: Set<String>, idxField,
             myTaskField, i, acc)
  let bodyOps = alConvertReturnsSm(dropLastOne(bb.abOps), myTaskField, f.fnResult, subtype)
  # SM saves address the $state parameter (Python 1179).
  let saveStores = alSmSaves(vsSorted(bb.abLive), bodyDefs, stateName, layout,
                                   List())
  ret match(lastOp(bb.abOps))
    (op: Op) => match(op)
      (c: OpCall)          => alSmCall(c, f, idxField, i,
                          SmAcc(concat(acc.saOps,
                                            bodyOps),
                                acc.saCold, acc.saWrapFields),
                          saveStores)
      (aw: OpAwait)        => alSmAwait(aw, f, idxField, i,
                          SmAcc(concat(acc.saOps,
                                            bodyOps),
                                acc.saCold, acc.saWrapFields),
                          saveStores)
      # The last block ends in its own terminator; every other ends in a splitter.
      (x: OpLabel)         => acc
      (x: OpMove)          => acc
      (x: OpJump)          => acc
      (x: OpJumpIf)        => acc
      (x: OpIfTask)        => acc
      (x: OpAssertNotTask) => acc
      (x: OpSwitchJump)    => acc
      (x: OpNewObject)     => acc
      (x: OpReturnVoid)    => acc
      (x: OpAbort)         => acc
      (x: OpReturn)        => acc
      (x: OpPhi)           => acc
      (x: OpProfEnter)     => acc
      (x: OpProfLeave)     => acc
    ()        => acc

# The deferred call ran earlier: park on its task if still running; on the
# sync edge, take the value.
fun alSmAwait(aw: OpAwait, f: CgFunction, idxField, i,
              acc: SmAcc, saveStores: List<Op>): SmAcc
  let asyncLabel = "$async_sm$" + String(i)
  let check = RpRuntimeInvoke("UNLIKELY",
                              RpNewStruct(list1(RpNamedValue("x", alTaskRunning(aw)))),
                              CgInt(32))
  let ops1 = concat(append(acc.saOps, OpJumpIf(asyncLabel, check, false, Dict())),
                     alAwaitValue(aw, "$await_sm$" + String(i)))
  let cold1 = concat(append(acc.saCold, OpLabel(asyncLabel, Dict())), saveStores)
  ret SmAcc(append(ops1, OpLabel("$resume$" + String(i), Dict())),
            concat(cold1, alEmitSuspendToAsync(idxField, i + 1, alAwaitTask(aw), f.fnName)),
            acc.saWrapFields)

fun alSmCall(c, f: CgFunction, idxField, i,
             acc: SmAcc, saveStores: List<Op>) => match(c.callRegister)
  (reg: RParam) => alSmValued(c, reg, f, idxField, i, acc, saveStores)
  ()             => alSmNoReg(c, f, idxField, i, acc, saveStores)

fun alSmNoReg(c, f: CgFunction, idxField, i,
              acc: SmAcc, saveStores: List<Op>) => match(c.callResultType)
  # Discarded non-void: $sm_wrap$<i> register, IS_TASK, no unwrap.
  (dt: CgType) => alSmChecked(c, RpStackVar(wrapReturnType(dt), "$sm_wrap$" + String(i)),
                              wrapReturnType(dt), None, true, f, idxField, i, acc, saveStores)
  # Pure void: no check; resume label directly after the call.
  ()            => SmAcc(append(append(acc.saOps, c),
                             OpLabel("$resume$" + String(i), Dict())),
                         acc.saCold, acc.saWrapFields)

fun alSmValued(c, reg, f: CgFunction, idxField, i,
               acc: SmAcc, saveStores: List<Op>)
  let resultType = rpGetType(reg)
  let wrappedType = wrapReturnType(resultType)
  ret eqCgType(wrappedType, resultType)
    ? alSmChecked(c, reg, wrappedType, None, false, f, idxField, i, acc, saveStores)
    : alSmChecked(c, RpStackVar(wrappedType, "$sm_wrap$" + String(i)), wrappedType,
                  OpMove(reg, unwrapValue(RpStackVar(wrappedType, "$sm_wrap$" + String(i)), resultType),
                         false, Dict()),
                  true, f, idxField, i, acc, saveStores)

# The IS_TASK check + unwrap sit BEFORE $resume$<i> (sync edge only); the
# park path is the ONLY place block i's locals reach the state object.
fun alSmChecked(c: OpCall, svCheck: RParam, checkType: CgType, unwrapOp: Op|None,
                retarget: Bool, f: CgFunction, idxField: RParam, i: Int,
                acc: SmAcc, saveStores: List<Op>): SmAcc
  let callOp = retarget
    ? OpCall(c.callFunction, c.callParameters, svCheck, c.callMusttail, c.callImpure,
             c.callResultType, c.callSavedVars)
    : c
  let check = RpRuntimeInvoke("UNLIKELY",
                              RpNewStruct(list1(RpNamedValue("x", isTaskParam(svCheck, checkType)))),
                              CgInt(32))
  let asyncLabel = "$async_sm$" + String(i)
  let ops1 = append(append(acc.saOps, callOp),
                  OpJumpIf(asyncLabel, check, false, Dict()))
  let ops2 = match(unwrapOp)
    (u: Op) => append(ops1, u)
    ()       => ops1
  let ops3 = append(ops2, OpLabel("$resume$" + String(i), Dict()))
  let untagged = RpRuntimeInvoke("TASK_UNTAG",
                                 RpNewStruct(list1(RpNamedValue("p", taskPtrFrom(svCheck, checkType)))),
                                 CgDataPointer(false))
  let cold1 = concat(append(acc.saCold,
                           OpLabel(asyncLabel, Dict())),
                          saveStores)
  let cold2 = concat(cold1,
                  alEmitSuspendToAsync(idxField, i + 1, untagged,
                                       f.fnName))
  let wraps = retarget
    ? append(acc.saWrapFields,
           CgField(stackVarName(svCheck), checkType))
    : acc.saWrapFields
  ret SmAcc(ops3, cold2, wraps)

# Dispatch cases at the tail: reload the site's live set, extract the
# completed call's result, jump to the resume point.
fun alSmDispatchTail(nonTerminal: List<ABlock>, f: CgFunction, stateName,
                     layout: AFrame, withEntryCase, bbs: List<ABlock>)
  let cases = alSmDtLoop(nonTerminal, f, stateName, layout, 0,
                         List())
  ret (withEntryCase
    ? concat(cases,
          alSmEntryCase(f, stateName, layout, nonTerminal))
    : cases)

fun alSmDtLoop(bs: List<ABlock>,
               f: CgFunction,
               stateName,
               layout: AFrame,
               i,
               acc: List<Op>) =>
  fold(bs, (acc = acc, i = i),
       (st, x) => (acc = alSmDtCase(x, f, stateName, layout, st.i, st.acc), i = st.i + 1)).acc

# One dispatch case: its label, the site's live set reloaded, the completed
# call's result extracted, then the jump to the resume point — in that order.
fun alSmDtCase(bb: ABlock, f: CgFunction, stateName, layout: AFrame,
               i: Int, acc: List<Op>): List<Op>
  let ops1 = alSmDtLoads(vsSorted(bb.abLive), stateName, layout,
                 append(acc, OpLabel("$case$" + String(i + 1),
                                   Dict())))
  let ops2 = concat(ops1, alSmDtResult(bb))
  ret append(ops2, OpJump("$resume$" + String(i), Dict()))

fun alSmDtLoads(vs: List<RParam>,
                stateName: String,
                layout: AFrame,
                acc: List<Op>): List<Op> =>
  fold(vs, acc, (a, x) => concat(a, alLoadVar(x, alStateParam(),
                             stateName, layout)))

fun alSmDtResult(bb: ABlock): List<Op> => match(bb.abResult)
  (reg: RParam) => isUnit(rpGetType(reg))
    ? list1(OpMove(reg, RpZeroOf(rpGetType(reg)), false, Dict()))
    : alSmDtTaskResult(reg)
  ()             => List()

fun alSmDtTaskResult(reg: RParam): List<Op> => match(taskSubtypeName(rpGetType(reg)))
  (st: String) => list1(OpMove(reg,
                    RpObjectField(rpGetType(reg), alCompletedParam(), st, "result", None, false, false),
                    false, Dict()))
  ()            => list1(OpMove(reg, RpNullPointer(), false, Dict()))

# Entry case (stub mode): load params, then every live var not yet loaded
# (the zero-filled field equals the old field-addressed semantics).
fun alSmEntryCase(f: CgFunction, stateName, layout: AFrame,
                  nonTerminal: List<ABlock>)
  let afterParams = alSmEntryParams(cgFieldsOfOrEmpty(f.fnParams),
                        stateName, layout,
                        EntryAcc(append(List(),
                                     OpLabel("$case$entry", Dict())),
                                 Set()))
  let afterLive = alSmEntryBlocks(nonTerminal, stateName, layout,
                                  afterParams)
  ret append(afterLive.eaOps,
                 OpJump("$sm$body", Dict()))

# Every parameter, then every block's live set, each loaded ONCE — first
# occurrence wins and the loads come out in that order. `seen` is asked only
# whether a name has been loaded, so it is a Set; the loads are ordered, so
# they go into a builder, and the two travel together.
class [final] EntryAcc(eaOps: List<Op>, eaSeen: Set<String>)

fun alSmEntryParams(ps: List<CgField>,
                    stateName,
                    layout: AFrame,
                    acc): EntryAcc =>
  fold(ps, acc, (a, x) => EntryAcc(concat(a.eaOps,
                   alLoadVar(RpStackVar(x.fieldType,
                                        x.fieldName),
                             alStateParam(), stateName, layout)),
               add(a.eaSeen, x.fieldName)))

fun alSmEntryBlocks(bs: List<ABlock>,
                    stateName,
                    layout: AFrame,
                    acc): EntryAcc =>
  fold(bs, acc, (a, x) => alSmEntryLive(vsSorted(x.abLive), stateName,
                    layout, a))

fun alSmEntryLive(vs: List<RParam>,
                  stateName: String,
                  layout: AFrame,
                  acc: EntryAcc): EntryAcc =>
  fold(vs, acc, (a, x) => contains(a.eaSeen, stackVarName(x))
    ? a
    : EntryAcc(concat(a.eaOps,
                     alLoadVar(x, alStateParam(), stateName,
                               layout)),
                 add(a.eaSeen, stackVarName(x))))

fun alSmAssemble(f: CgFunction, allOps: List<Op>, bbs: List<ABlock>,
                 wrapFields)
  # Params become plain locals (the SM's own signature is $state/$completed);
  # block result registers not otherwise declared ($musttail$ret$N) too.
  # Parameters become locals, then any block result register not already
  # declared. Both are ordered — these are struct fields — and `seen` answers
  # only membership, so the pair travels as a builder and a Set.
  let declared = Set(map(cgFieldsOfOrEmpty(f.fnStackVars),
                         (fld) => fld.fieldName))
  let withParams = alSmDeclareParams(cgFieldsOfOrEmpty(f.fnParams),
                                     DeclAcc(List(), declared))
  let withResults = alSmDeclareResults(bbs, withParams)
  ret CgFunction(f.fnName + "$async",
                 CgStruct(list2(CgField("$state", CgDataPointer(false)),
                                CgField("$completed_task", CgDataPointer(false)))),
                 CgVoid(),
                 # extra_stack = ($sv_discard,) + sm_wrap_fields — discard FIRST
                 # (Python async_lower.py:1343; declaration order is C order).
                 CgStruct(concat(concat(cgFieldsOfOrEmpty(f.fnStackVars),
                                        withResults.daFields),
                                 prepend(CgField("$sv_discard", CgDataPointer(false)), wrapFields))),
                 cgOpsOf(allOps), f.fnComment, None, false, false, false, false)

class [final] DeclAcc(daFields: List<CgField>,
                             daSeen: Set<String>)

fun alSmDeclareParams(ps: List<CgField>,
                      acc: DeclAcc) =>
  fold(ps, acc, (a, x) => contains(a.daSeen, x.fieldName)
    ? a
    : DeclAcc(append(a.daFields, x),
                  add(a.daSeen, x.fieldName)))

fun alSmDeclareResults(bs: List<ABlock>,
                       acc) =>
  fold(bs, acc, alSmDeclareResult)

fun alSmDeclareResult(acc, bb: ABlock) => match(bb.abResult)
  (reg: RParam) => contains(acc.daSeen, stackVarName(reg))
    ? acc
    : DeclAcc(append(acc.daFields,
                  CgField(stackVarName(reg), rpGetType(reg))),
              add(acc.daSeen, stackVarName(reg)))
  ()             => acc

# Drop Phi sources whose predecessor labels now live in the OTHER function;
# an all-pruned Phi disappears (its target is written elsewhere).
fun alPrunePhiSources(ops: List<Op>)
  let preds = ucPhiEdgesPreds(ops)
  ret alPpsLoop(ops, preds, "", List())

# Label → the labels that can reach it. A Dict of Sets: the only question ever
# asked of it is "is this phi source one of this block's predecessors", which
# is membership on both levels. The list-of-pairs it replaces answered a lookup
# by allocating a filtered copy of itself, and inserting rebuilt the entire
# list once per edge.
fun ucPhiEdgesPreds(ops: List<Op>) => alBpLoop(ops, None, "", Dict())

# The preceding op is CARRIED rather than re-indexed: alBpFall only ever needs
# ops[i-1], and `prev` is None exactly where the index form tested i == 0.
fun alBpLoop(os: List<Op>, prev: Op|None, cur, acc: Dict<String, Set<String>>) =>
  fold(os, (prev = prev, cur = cur, acc = acc),
       alBpLoopStep).acc

fun alBpLoopStep(st: (prev: Op|None, cur: String, acc: Dict<String, Set<String>>),
                 x: Op): (prev: Op|None, cur: String, acc: Dict<String, Set<String>>) => match(x)
  (lb: OpLabel) => (prev = lb, cur = lb.labelName, acc = alBpFall(st.prev, st.cur, lb.labelName, st.acc))
  (o: Op) => (prev = o, cur = st.cur, acc = alBpJumps(o, st.cur, st.acc))

fun alBpFall(prev: Op|None, cur, label: String,
             acc): Dict<String, Set<String>>
  if length(cur) == 0
    ret acc
  ret match(prev)
    (p: Op) => opFallsThrough(p) ? alBpAdd(acc, label, cur) : acc
    ()      => acc

fun alBpJumps(op, cur,
              acc): Dict<String, Set<String>>
  if length(cur) == 0
    ret acc
  ret fold(opBranchTargets(op), acc, (a, target) => alBpAdd(a, target, cur))

fun alBpAdd(acc: Dict<String, Set<String>>, label: String,
            pred) => put(acc, label,
                         add(alBpOf(acc, label), pred))

fun alBpOf(acc: Dict<String, Set<String>>, label: String) => match(get(acc, label))
  (ps: Set<String>) => ps
  ()                 => Set()

fun alPpsLoop(os: List<Op>, preds: Dict<String, Set<String>>, cur, acc: List<Op>) =>
  fold(os, (cur = cur, acc = acc),
       (st, x) => alPpsLoopStep(st, x, preds)).acc

fun alPpsLoopStep(st: (cur: String, acc: List<Op>), x: Op, preds: Dict<String, Set<String>>) => match(x)
  (lb: OpLabel) => (cur = lb.labelName, acc = append(st.acc, x))
  (ph: OpPhi) => (cur = st.cur, acc = alPpsPhi(st.acc, ph, preds, st.cur))
  (o: Op) => (cur = st.cur, acc = append(st.acc, o))

fun alPpsPhi(acc, ph: OpPhi,
             preds: Dict<String, Set<String>>, cur): List<Op>
  if length(cur) == 0
    ret append(acc, ph)
  let blockPreds = alBpOf(preds, cur)
  let kept = filter(ph.phiSources,
                    (s2) => contains(blockPreds,
                                     s2.sourceLabel))
  ret sameLen(kept, ph.phiSources)
    ? append(acc, ph)
    : (isEmpty(kept)
        ? acc
        : append(acc, OpPhi(ph.phiTarget, kept, ph.phiSavedVars)))

# ── per-function orchestrator ────────────────────────────────────────────────

class [final] AlOut(aloFunctions: List<CgFunction>, aloObjects: List<CgObject>)

# The same two lists while they are being ACCUMULATED across every function in
# the program. Both are ordered — they become the app's emission order — and
# merging used to concat the whole collection so far onto each function's small
# contribution, once per function of the program.
class [final] AlAcc(aaFunctions: List<CgFunction>,
                            aaObjects: List<CgObject>)

fun alAccEmpty() => AlAcc(List(), List())

fun alAccBuild(acc: AlAcc) => AlOut(acc.aaFunctions,
                                    acc.aaObjects)

fun alMergeOne(acc: AlAcc, out: AlOut)
  ret AlAcc(concat(acc.aaFunctions,
                        out.aloFunctions),
            concat(acc.aaObjects,
                        out.aloObjects))

fun alConvertFunction(f: CgFunction): AlOut
  if f.fnName == "__entrypoint__" || f.fnBypassAsync
    ret AlOut(list1(f), List())
  let afterTail = alReturnUnparked(alExpandSyncCalls(alDiscoverTailCalls(f)))
  let stateName = f.fnName + "$state"
  let built = alCreateBasicBlocksN(afterTail)
  if !atLeast(built.bs, 2)
    ret AlOut(list1(alSimpleWrap(afterTail)), List())
  ret alConvertMulti(f, afterTail, stateName, built.bs, built.n)

# <2 blocks: only the return type adjusts (Returns brought into its shape).
fun alSimpleWrap(f: CgFunction)
  ret CgFunction(f.fnName, f.fnParams, wrapReturnType(f.fnResult), f.fnStackVars,
                 cgOpsOf(alConvertReturnsHot(cgOpsToList(f.fnOps), f.fnResult)),
                 f.fnComment, f.fnForeignSymbol, f.fnSync,
                 f.fnTail, f.fnBypassAsync, f.fnAlwaysInline,
                 f.fnSourceFile, f.fnSourceLine, f.fnFuture)

fun alConvertMulti(f: CgFunction, afterTail: CgFunction, stateName,
                   bbs: List<ABlock>, nBbs: Int): AlOut
  let subtype = taskSubtypeName(f.fnResult)
  # The SM view (musttail unrolled) defines the authoritative frame layout.
  let smFn = any(afterTail.fnOps, alIsMusttailCall) ? alUnrollMusttail(afterTail) : afterTail
  let smBuilt = any(afterTail.fnOps, alIsMusttailCall)
    ? alCreateBasicBlocksN(smFn)
    : (bbs, nBbs)
  let smBbs = smBuilt.bs
  let layout0 = alComputeFrameLayout(smBbs, bbs, cgOpsToList(alCalculateSavedVars(smFn).fnOps))
  let useStub = !f.fnSync && atLeast(smFn.fnOps, alStubThresholdOps() + 1) && alHasParkingLoop(smFn.fnOps)
  let layout = useStub ? alAugmentLayoutWithParams(layout0, cgFieldsOfOrEmpty(f.fnParams)) : layout0
  let hotFn = useStub
    ? alCreateStubLaunchFunc(afterTail, stateName, subtype, layout, smBuilt.n)
    : alCreateHotPathFunc(afterTail, stateName, subtype, bbs, layout)
  if f.fnSync
    ret AlOut(list1(hotFn), List())
  let stateObj = alCreateStateObject(smFn, stateName, layout)
  let machineFn = alCreateStateMachineFunc(smFn, stateName, subtype, smBbs, layout, useStub)
  ret AlOut(list2(hotFn, machineFn), list1(stateObj))

fun alIsMusttailCall(op) => match(op)
  (c: OpCall) => c.callMusttail
  (o: Op)     => false

# Jump/JumpIf/Switch to an ALREADY-SEEN label = a loop.
# Stub only when a PARK SITE lies inside a loop (Python has_parking_loop): a
# back edge alone is not enough — a compute-only loop never parks at runtime,
# and stubbing it turns a zero-allocation call into a heap state allocation
# per call. Walk once, recording the park count at each label; a jump back to
# a seen label with parks accrued since is a parking loop. Park ops = exactly
# what the basic-block builder splits on (a may-suspend Call, Await).
fun alHasParkingLoop(ops: Segment<Op>|None) => alHplLoop(ops, 0i32, Dict(), 0)

fun [tail] alHplLoop(s: Segment<Op>|None, i, labelParks,
                     parks) => match(s)
  (nil: None)        => false
  (seg: Segment<Op>) => i >= seg.length
    ? alHplLoop(seg.next, 0i32, labelParks, parks)
    : any(opBranchTargets(seg.array(i)), (name) => alHplHit(labelParks, name, parks))
      ? true
      : alHplLoop(s, i + 1i32, alHplLabelParks(seg.array(i), labelParks, parks),
                  alIsSplitter(seg.array(i)) ? parks + 1 : parks)

fun alHplLabelParks(op, labelParks: Dict<String, Int>, parks) => match(op)
  (lb: OpLabel) => put(labelParks, lb.labelName, parks)
  (o: Op)       => labelParks

fun alHplHit(labelParks: Dict<String, Int>, name: String, parks) => match(get(labelParks, name))
  (atLabel: Int) => parks > atLabel
  ()              => false

# ── task-subtype collection ──────────────────────────────────────────────────

# One subtype per distinct non-Void return type + the foreign task object.
# The DRIVER unions these with app objects LETTING APP WIN — lazy_thunks
# pre-registers subtypes under the same names; never flip the union.
# One subtype per distinct name, in first-seen order, with the foreign task
# object last. The names are tracked in a Set: the old shape asked "have I
# made this one already" by scanning every subtype collected so far, once per
# function of the whole program.
class [final] CtsAcc(ctObjs: List<CgObject>,
                             ctSeen: Set<String>)

fun collectTaskSubtypes(a: CgApp)
  let subs = alCtsLoop(appFunctions(a),
                       CtsAcc(List(), Set()))
  ret append(subs.ctObjs, makeTaskForeignObject())

fun alCtsLoop(fs: List<CgFunction>,
              acc) =>
  fold(fs, acc, alCtsOne)

fun alCtsOne(acc, f: CgFunction)
  if alIsVoid(f.fnResult)
    ret acc
  ret match(taskSubtypeName(f.fnResult))
    (name: String) => contains(acc.ctSeen, name)
      ? acc
      : CtsAcc(append(acc.ctObjs,
                   makeTaskSubtypeObject(name, alCtsInner(f.fnResult))),
               add(acc.ctSeen, name))
    ()              => acc

fun alCtsInner(t2) => match(t2)
  (w: CgTaskWrapper) => w.inner
  (o: CgType)         => t2

# ── saved_vars cleared on the way out ───────────────────────────────────────

# `saved_vars` is this pass's liveness, a live-out on EVERY op, not a save.
# Once lowered, what a suspension saves is an explicit store into the state
# object, so the sets mean nothing further — and read as saves they made a
# construction's first store publish its own object (fast_stores.yafl).
fun alWithoutSavedVars(f: CgFunction): CgFunction
  if !any(f.fnOps, (op) => !isEmpty(opSavedVars(op)))
    ret f
  ret cgFunctionWith(f, map(f.fnOps, alOpWithoutSavedVars), f.fnStackVars)

fun alOpWithoutSavedVars(op: Op): Op => isEmpty(opSavedVars(op)) ? op : opWithSavedVars(op, Dict())

# ── zero-init repair for state-saves ─────────────────────────────────────────

# Aggressive IR inlining (-O3) can place a suspension inside a loop whose body
# defines a live range crossing the back-edge: the state-save at the suspension
# then reads the variable BEFORE any write on the first-iteration path (it
# holds a real value only from iteration two). The value saved on that first
# pass is never consumed — but saving indeterminate memory is still wrong, and
# uninit_check rightly rejects it. Zero-init exactly those variables at entry
# so every save stores a DEFINED value. Only STATE-SAVE Moves are repaired —
# a general repair would mask the real read-before-write bugs the checker
# exists for.
fun alZeroInitUnwrittenSaves(f: CgFunction): CgFunction
  let entry = ucComputeEntrySets(f)
  let offenders = alZiusLoop(f.fnOps, 0i32, 0, entry, Dict())
  if isEmpty(offenders)
    ret f
  let inits = map<RParam, Op>(vsSorted(offenders), (v) =>
        OpMove(v, alZeroVal(rpGetType(v)), false, Dict()))
  ret cgFunctionWith(f, build(pushAll(pushAll(seqBuilder(),
                                                  inits),
                                      f.fnOps)),
                     f.fnStackVars)

fun [tail] alZiusLoop(s: Segment<Op>|None, iSeg, i, entry: Dict<Int, InitSet>,
                      acc) => match(s)
  (nil: None)        => acc
  (seg: Segment<Op>) => iSeg < seg.length
    ? alZiusLoop(s, iSeg + 1i32, i + 1, entry,
                 alZiusStep(seg.array(iSeg), ucEntryAt(entry, i), acc))
    : alZiusLoop(seg.next, 0i32, i, entry, acc)

fun alZiusStep(op, e, acc) => match(e)
  (u: IsUnreached) => acc
  (s2: IsSet)      => match(op)
    (m: OpMove) => alZiusMove(m, s2.isNames, acc)
    (o: Op)     => acc

# The Python guard chain: Move target is ObjectField on the `$state` StackVar,
# source is a StackVar missing from the entry set.
fun alZiusMove(m: OpMove, names: Set<String>, acc) => match(m.moveTarget)
  (tf: RpObjectField) => alZiusStateField(tf) ? alZiusSource(m.moveSource, names, acc) : acc
  (o: RParam)          => acc

fun alZiusStateField(tf: RpObjectField) => match(tf.pointer)
  (p: RpStackVar) => p.name == "$state"
  (o: RParam)     => false

# Entry sets key by name (ucKey) — membership must use the same key.
fun alZiusSource(src, names: Set<String>, acc) => match(src)
  (v: RpStackVar) => contains(names, ucKey(src)) ? acc : put(acc, v.name, src)
  (o: RParam)     => acc

# ── the driver ───────────────────────────────────────────────────────────────

fun lowerAsync(a: CgApp)
  let converted = alAccBuild(alConvertAll(appFunctions(a), alAccEmpty()))
  let repaired = map(converted.aloFunctions,
                     (f) => alWithoutSavedVars(alZeroInitUnwrittenSaves(f)))
  let withObjs = fold(converted.aloObjects,
                      appOf(repaired, appObjects(a), appGlobals(a)),
                      appPutObject)
  # Subtypes union: APP WINS on collisions (lazy_thunks pre-registrations).
  ret fold(collectTaskSubtypes(withObjs), withObjs, alPutIfAbsent)

fun alConvertAll(fs: List<CgFunction>,
                 acc: AlAcc) =>
  fold(fs, acc, (a, x) => alMergeOne(a, alConvertFunction(x)))

fun alPutIfAbsent(a, o) => appHasObject(a, o.objName) ? a : appPutObject(a, o)
