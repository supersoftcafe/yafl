# bootstrap/struct_folding.yafl — ported from lowering/struct_folding.py:
# fold field reads of locally-built structs (case-of-known-field). After
# fusion, a former stage boundary packs a NewStruct into a local and reads
# fields off it a few ops later. In SSA the pack is the local's only
# definition (ssa_defs), so `StructField(sv, f)` folds to the packed field's
# value whenever that value is simple enough to duplicate. The bypassed pack
# then falls to deadstores. Runs in the pre-async fixpoint at -O1+.
# Phi-safe: substitution only at read positions, no labels touched; Phi/Call-
# defined locals are unknown by construction.
namespace Bootstrap::Lower::Ir

import System

import Bootstrap::Ir



fun foldStructReads(a: CgApp) => appWithFunctions(a, map(appFunctions(a), sfoFunction))

fun sfoFunction(f: CgFunction)
  let defs = singleDefs(f)
  ret cgFunctionWith(f, map(f.fnOps,
                            (op) => opReplaceParams(op,
                              (p) => sfoReplace(p, defs))),
                     f.fnStackVars)

fun sfoReplace(p, defs: SsaDefs) => match(p)
  (sf: RpStructField) => match(sf.structVal)
    (sv: RpStackVar) => sfoFold(sf, sv, defs)
    (o: RParam)      => p
  (o: RParam)         => p

fun sfoFold(sf, sv, defs: SsaDefs): RParam => match(resolveValue(sv, defs, sdMaxChase()))
  (base: RParam) => match(base)
    (ns: RpNewStruct) => sfoField(ns.values, sf)
    (o: RParam)       => sf
  ()             => sf

fun [tail] sfoField(vs: List<RpNamedValue>, sf: RpStructField) => isEmpty(vs)
  ? sf
  : first(vs).name == sf.field && sdIsDuplicable(first(vs).value)
    ? first(vs).value
    : sfoField(tail(vs), sf)
