# bootstrap/parser.yafl — stage 1 of the self-hosted YAFL compiler: the parser.
#
# Recursive descent over the token stream from tokenizer.yafl, covering the
# full YAFL grammar of compiler/parsing/parser.py: statements (namespace,
# import, fun, let, class, interface, enum, typealias, ret, if/else-if/else,
# action), the colon-precedes-type type grammar (tuples/callables/unions/
# generics with fused `>>`/`>=` closers), and the complete expression ladder
# (postfix call/dot/index, unary, arithmetic, shifts, bitwise, comparison,
# is/!is, the shared ?>/|> level, && , ||, right-associative ternary), plus
# match with multi-literal/range/guarded arms, spread and named tuple
# entries, attributes, generics and where clauses.
#
# Indentation: a statement's BLOCK is the token run from its first token to
# the first token on a LATER line with indent <= the statement's indent —
# exactly parselib.block(). The parse state carries that fence; crossing it
# reads as end-of-input for everything nested.
#
# Validated by tests/test_bootstrap_parser.py: the whole corpus parses with
# zero errors, and the declaration census (kind|line|name, recursively) is
# diffed against the Python parser's output.
namespace Bootstrap

import System

# ══ AST ══════════════════════════════════════════════════════════════════════


# ══ Parse state ══════════════════════════════════════════════════════════════
# `ts` is the remaining tokens; (fline, findent) is the enclosing block fence:
# a token on a later line with indent <= findent reads as end-of-input.

class [final] Ps(ts: Chain<Token>, fline: System::Int, findent: System::Int,
                 srcFile: System::String)

class [final] PFail(hard: System::Bool, msg: System::String,
                    line: System::Int, col: System::Int)

fun softFail(msg: System::String, ps: Ps): PFail
  let t = peek(ps)
  ret PFail(false, msg, t.line, t.col)

fun hardFail(msg: System::String, ps: Ps): PFail
  let t = peek(ps)
  ret PFail(true, msg, t.line, t.col)

# Escalate a soft failure after committing to a construct (parselib.requires).
fun harden(f: PFail, msg: System::String): PFail
  ret f.hard ? f : PFail(true, msg, f.line, f.col)

fun crossesFence(t: Token, ps: Ps): System::Bool
  ret t.line > ps.fline && t.indent <= ps.findent

fun peek(ps: Ps): Token
  ret match(ps.ts)
    (l: ChainLink) => crossesFence(l.value, ps)
      ? Token(KEof(), "", 0, l.value.line, l.value.col)
      : l.value
    ()             => Token(KEof(), "", 0, ps.fline, 1)

fun bump(ps: Ps): Ps
  ret match(ps.ts)
    (l: ChainLink) => crossesFence(l.value, ps) ? ps : Ps(l.next, ps.fline, ps.findent, ps.srcFile)
    ()             => ps

fun isEof(t: Token): System::Bool
  ret match(t.kind)
    (k: KEof) => true
    ()        => false

fun isSymTok(t: Token, s: System::String): System::Bool
  ret match(t.kind)
    (k: KSymbol) => t.text == s
    ()           => false

fun isIdentTok(t: Token): System::Bool
  ret match(t.kind)
    (k: KIdent) => true
    ()          => false

fun atSym(ps: Ps, s: System::String): System::Bool
  ret isSymTok(peek(ps), s)

# Identifier text at the head ("" when not an identifier). Backtick names
# arrive with their backticks; strip them, matching the Python __named().
fun identText(t: Token): System::String
  ret !isIdentTok(t) ? ""
    : System::startsWith(t.text, "`")
      ? t.text
      : t.text

# Closing `>` of a generic list: a fused `>>` or `>=` closer is split, its
# remainder pushed back (parselib.close_angle).
fun closeAngle(ps: Ps): (ok: System::Bool, rest: Ps)
  let t = peek(ps)
  if !isSymTok(t, ">") && !isSymTok(t, ">>") && !isSymTok(t, ">=")
    ret (false, ps)
  if t.text == ">"
    ret (true, bump(ps))
  let remainder = Token(KSymbol(), System::slice(t.text, 1, System::length(t.text)),
                        t.indent, t.line, t.col + 1)
  ret (true, Ps(ChainLink<Token>(remainder, bump(ps).ts), ps.fline, ps.findent, ps.srcFile))

fun lineAt(ps: Ps): PLine
  let t = peek(ps)
  ret PLine(ps.srcFile, t.line, t.col)

# ══ Types ════════════════════════════════════════════════════════════════════

# type = alternative ("|" alternative)*
fun parseType(ps: Ps): (v: Spec|PFail, rest: Ps)
  let lr = lineAt(ps)
  let a = parseTypeOne(ps)
  ret match(a.v)
    (f: PFail) => a
    (t1: Spec)   => typeUnionLoop(t1, push(builder<Spec>(), t1), lr, a.rest)


# ── ListBuilder failure-path helpers ─────────────────────────────────────────
# A ternary may not mix an implicit builder drop with consumption in its
# branches; these consume the abandoned accumulator (dropped at statement
# level, like an unused IO handle) and return the failure tuple.
fun specsFail(b: ListBuilder<Spec>, f: PFail, rest: Ps): (v: List<Spec>|PFail, rest: Ps)
  let _ = discard(b)
  ret (f, rest)

fun unionFail(b: ListBuilder<Spec>, f: PFail, rest: Ps): (v: Spec|PFail, rest: Ps)
  let _ = discard(b)
  ret (f, rest)

fun entriesFail(b: ListBuilder<SEntry>, f: PFail, rest: Ps): (v: List<SEntry>|PFail, rest: Ps)
  let _ = discard(b)
  ret (f, rest)

fun attrsFail(b: ListBuilder<PAttr>, f: PFail, rest: Ps): (v: List<PAttr>|PFail, rest: Ps)
  let _ = discard(b)
  ret (f, rest)

fun attrsClose(b: ListBuilder<PAttr>, rest: Ps): (v: List<PAttr>|PFail, rest: Ps)
  if atSym(rest, "]")
    ret (build(b), bump(rest))
  let _ = discard(b)
  ret (hardFail("expected ',' or ']' in attributes", rest), rest)

fun stmtsFail(b: ListBuilder<PStmt>, f: PFail, rest: Ps): (v: List<PStmt>|PFail, rest: Ps)
  let _ = discard(b)
  ret (f, rest)

fun targetsClose(b: ListBuilder<PStmt>, rest: Ps): (v: List<PStmt>|PFail, rest: Ps)
  if atSym(rest, ")")
    ret (build(b), bump(rest))
  let _ = discard(b)
  ret (hardFail("expected ',' or ')' in binding list", rest), rest)

fun gensFail(b: ListBuilder<PGen>, f: PFail, rest: Ps): (v: List<PGen>|PFail, rest: Ps)
  let _ = discard(b)
  ret (f, rest)

fun argsFail(b: ListBuilder<PTupEnt>, f: PFail, rest: Ps): (v: List<PTupEnt>|PFail, rest: Ps)
  let _ = discard(b)
  ret (f, rest)

fun argsClose(b: ListBuilder<PTupEnt>, rest: Ps): (v: List<PTupEnt>|PFail, rest: Ps)
  if atSym(rest, ")")
    ret (build(b), bump(rest))
  let _ = discard(b)
  ret (hardFail("expected ',' or ')' in argument list", rest), rest)

fun armsFail(b: ListBuilder<PArm>, f: PFail, rest: Ps): (v: PExpr|PFail, rest: Ps)
  let _ = discard(b)
  ret (f, rest)

fun litsFail(b: ListBuilder<PLit>, f: PFail, rest: Ps): (v: List<PLit>|PFail, rest: Ps)
  let _ = discard(b)
  ret (f, rest)

fun litsClose(b: ListBuilder<PLit>, rest: Ps): (v: List<PLit>|PFail, rest: Ps)
  if atSym(rest, ")")
    ret (build(b), bump(rest))
  let _ = discard(b)
  ret (softFail("expected ',' or ')' in literal arm", rest), rest)

fun [tail] typeUnionLoop(first: Spec, acc: ListBuilder<Spec>, lr: PLine, ps: Ps): (v: Spec|PFail, rest: Ps)
  if !atSym(ps, "|")
    let l = build(acc)
    ret match(head(l))
      (only: Spec) => isEmpty(tail(l)) ? (only, ps) : (SCombination(l, lr), ps)
      ()         => (first, ps)
  let n = parseTypeOne(bump(ps))
  ret match(n.v)
    (f: PFail) => unionFail(acc, f, n.rest)
    (t2: Spec)   => typeUnionLoop(first, push(acc, t2), lr, n.rest)

# alternative = tuple/callable | grouped | __builtin_type__<x> | named
fun parseTypeOne(ps: Ps): (v: Spec|PFail, rest: Ps)
  if atSym(ps, "(")
    ret parseTypeParen(bump(ps))
  if atSym(ps, "__builtin_type__")
    ret parseTypeBuiltin(bump(ps))
  ret parseTypeNamed(ps)

fun parseTypeBuiltin(ps: Ps): (v: Spec|PFail, rest: Ps)
  if !atSym(ps, "<")
    ret (hardFail("expected '<' after __builtin_type__", ps), ps)
  let name = peek(bump(ps))
  if !isIdentTok(name)
    ret (hardFail("expected builtin type name", bump(ps)), ps)
  let after = bump(bump(ps))
  ret atSym(after, ">")
    ? (SBuiltin(name.text, lineAt(ps)), bump(after))
    : (hardFail("expected '>' after builtin type name", after), after)

# `(` … `)` — a tuple/callable when the entries fit the colon-precedes-type
# entry grammar, otherwise a grouped type. Tried in that order, backtracking,
# exactly like the Python alternation.
fun parseTypeParen(ps: Ps): (v: Spec|PFail, rest: Ps)
  let t = parseTypeTupleTail(ps)
  ret match(t.v)
    (f: PFail) => f.hard ? (f, t.rest) : parseTypeGroupedTail(ps)
    (ty: Spec)   => t

fun parseTypeTupleTail(ps: Ps): (v: Spec|PFail, rest: Ps)
  let es = parseTypeEntries(ps, builder<SEntry>())
  ret match(es.v)
    (f: PFail)          => (f, es.rest)
    (list: List<SEntry>) => !atSym(es.rest, ")")
      ? (softFail("expected ')'", es.rest), es.rest)
      : typeTupleOrFun(list, lineAt(ps), bump(es.rest))

fun typeTupleOrFun(entries: List<SEntry>, lr: PLine, ps: Ps): (v: Spec|PFail, rest: Ps)
  if !atSym(ps, ":")
    ret (STuple(entries, lr), ps)
  let r = parseType(bump(ps))
  ret match(r.v)
    (f: PFail) => (harden(f, "missing type"), r.rest)
    (ty: Spec)   => (SCallable(STuple(entries, lr), ty, lr), r.rest)

fun parseTypeGroupedTail(ps: Ps): (v: Spec|PFail, rest: Ps)
  let inner = parseType(ps)
  ret match(inner.v)
    (f: PFail) => (harden(f, "incomplete grouped type"), inner.rest)
    (ty: Spec)   => atSym(inner.rest, ")")
      ? (ty, bump(inner.rest))
      : (hardFail("expected ')' after grouped type", inner.rest), inner.rest)

# entry = name [":" type] ["=" expr]  |  ":" type      (colon precedes type)
fun parseTypeEntry(ps: Ps): (v: SEntry|PFail, rest: Ps)
  if atSym(ps, ":")
    let u = parseType(bump(ps))
    ret match(u.v)
      (f: PFail) => (f, u.rest)
      (ty: Spec)   => (SEntry("", ty, None), u.rest)
  let name = peek(ps)
  if !isIdentTok(name)
    ret (softFail("expected tuple entry", ps), ps)
  let afterName = bump(ps)
  let ty = parseMaybeColonType(afterName)
  ret match(ty.v)
    (f: PFail) => (f, ty.rest)
    (opt: Spec|System::None) => typeEntryDefault(name.text, opt, ty.rest)

fun typeEntryDefault(name: System::String, ty: Spec|System::None,
                     ps: Ps): (v: SEntry|PFail, rest: Ps)
  if !atSym(ps, "=")
    ret (SEntry(name, ty, None), ps)
  let d = parseExpr(bump(ps))
  ret match(d.v)
    (f: PFail) => (harden(f, "missing default value"), d.rest)
    (a: PExpr) => (SEntry(name, ty, a), d.rest)

fun [tail] parseTypeEntries(ps: Ps, acc: ListBuilder<SEntry>): (v: List<SEntry>|PFail, rest: Ps)
  let e = parseTypeEntry(ps)
  ret match(e.v)
    (f: PFail)  => f.hard ? entriesFail(acc, f, e.rest) : (build(acc), ps)
    (en: SEntry) => atSym(e.rest, ",")
      ? parseTypeEntries(bump(e.rest), push(acc, en))
      : (build(push(acc, en)), e.rest)

# named = (ident "::")* ident ["<" type-list ">"]
fun parseTypeNamed(ps: Ps): (v: Spec|PFail, rest: Ps)
  let name = peek(ps)
  if !isIdentTok(name)
    ret (softFail("expected type name", ps), ps)
  ret typeNamedPath(name.text, lineAt(ps), bump(ps))

fun [tail] typeNamedPath(path: System::String, lr: PLine, ps: Ps): (v: Spec|PFail, rest: Ps)
  if atSym(ps, "::") && isIdentTok(peek(bump(ps)))
    ret typeNamedPath(path + "::" + peek(bump(ps)).text, lr, bump(bump(ps)))
  if !atSym(ps, "<")
    ret (SNamed(path, List<Spec>(), lr), ps)
  let args = parseTypeArgs(bump(ps), builder<Spec>())
  ret match(args.v)
    (f: PFail)        => f.hard ? (f, args.rest) : (SNamed(path, List<Spec>(), lr), ps)
    (list: List<Spec>) => (SNamed(path, list, lr), args.rest)

# "<" already consumed: type ("," type)* close-angle. A failure before the
# closer is SOFT — `a < b` must fall back to comparison in expressions, and
# the Python `maybe(requires(sym("<"), …))` backtracks the same way.
fun [tail] parseTypeArgs(ps: Ps, acc: ListBuilder<Spec>): (v: List<Spec>|PFail, rest: Ps)
  let t = parseType(ps)
  ret match(t.v)
    (f: PFail) => specsFail(acc, PFail(false, f.msg, f.line, f.col), t.rest)
    (ty: Spec)   => atSym(t.rest, ",")
      ? parseTypeArgs(bump(t.rest), push(acc, ty))
      : typeArgsClose(build(push(acc, ty)), t.rest)

fun typeArgsClose(acc: List<Spec>, ps: Ps): (v: List<Spec>|PFail, rest: Ps)
  let c = closeAngle(ps)
  ret c.ok ? (acc, c.rest) : (softFail("missing '>'", ps), ps)

fun parseMaybeColonType(ps: Ps): (v: Spec|System::None|PFail, rest: Ps)
  if !atSym(ps, ":")
    ret (None, ps)
  let t = parseType(bump(ps))
  ret match(t.v)
    (f: PFail) => (harden(f, "missing type"), t.rest)
    (ty: Spec)   => (ty, t.rest)

# ══ Attributes, targets, generics ════════════════════════════════════════════

# "[" name [= string|int | (args)] ("," …)* "]" — attribute names may be
# keywords (they tokenise as SYMBOLS).
fun parseMaybeAttributes(ps: Ps): (v: List<PAttr>|PFail, rest: Ps)
  if !atSym(ps, "[")
    ret (List<PAttr>(), ps)
  ret parseAttrList(bump(ps), builder<PAttr>())

fun attrNameText(t: Token): System::String
  if isIdentTok(t)
    ret t.text
  ret match(t.text)
    ("where", "let", "fun", "class", "interface", "ret", "import", "namespace") =>
      isSymTok(t, t.text) ? t.text : ""
    () => ""

fun [tail] parseAttrList(ps: Ps, acc: ListBuilder<PAttr>): (v: List<PAttr>|PFail, rest: Ps)
  let name = attrNameText(peek(ps))
  if name == ""
    ret attrsFail(acc, hardFail("expected attribute name", ps), ps)
  let a = parseAttrValue(name, bump(ps))
  ret match(a.v)
    (f: PFail)  => attrsFail(acc, f, a.rest)
    (at: PAttr) => atSym(a.rest, ",")
      ? parseAttrList(bump(a.rest), push(acc, at))
      : attrsClose(push(acc, at), a.rest)

fun parseAttrValue(name: System::String, ps: Ps): (v: PAttr|PFail, rest: Ps)
  if atSym(ps, "=")
    let t = peek(bump(ps))
    let lr = lineAt(bump(ps))
    ret match(t.kind)
      (s2: KString) => attrString(name, t.text, lr, bump(bump(ps)))
      (n2: KNumber) => attrNumber(name, t.text, lr, bump(bump(ps)))
      ()            => (hardFail("expected string or integer attribute value", bump(ps)), ps)
  if atSym(ps, "(")
    let args = parseTupleTerm(ps)
    ret match(args.v)
      (f: PFail)   => (f, args.rest)
      (tup: PExpr) => (PAttr(name, tup), args.rest)
  ret (PAttr(name, None), ps)

fun attrString(name: System::String, lexeme: String, lr: PLine,
               ps: Ps): (v: PAttr|PFail, rest: Ps)
  let body = slice(lexeme, 1, length(lexeme) - 1)
  let u = unescape(body)
  ret u.uErr == ""
    ? (PAttr(name, PeStr(u.uText, lr)), ps)
    : (hardFail(u.uErr, ps), ps)

fun attrNumber(name: System::String, lexeme: String, lr: PLine,
               ps: Ps): (v: PAttr|PFail, rest: Ps)
  let d = decodeInt(lexeme)
  ret d.ilErr == ""
    ? (PAttr(name, PeInt(d.ilValue, d.ilPrecision, lr)), ps)
    : (hardFail(d.ilErr, ps), ps)

# target = attributes (ident | "(" targets ")") [":" type] ["[" ident "]"] ["=" expr]
# A named target mirrors parser.py's __to_let_statement: a LetStatement whose
# unique name is `ident@hash6` of the target's own position. A nested-parts
# target becomes the destructure holder. VERIFY vs contract: which line_ref
# Python hashes (target start vs ident token) — the AST diff adjudicates.
fun parseTarget(ps: Ps): (v: PStmt|PFail, rest: Ps)
  let lr = lineAt(ps)
  let attrs = parseMaybeAttributes(ps)
  ret match(attrs.v)
    (f: PFail)        => (f, attrs.rest)
    (al: List<PAttr>) => parseTargetNamed(al, lr, attrs.rest)

fun parseTargetNamed(attrs: List<PAttr>, lr: PLine,
                     ps: Ps): (v: PStmt|PFail, rest: Ps)
  let t = peek(ps)
  if isIdentTok(t)
    ret parseTargetTail(attrs, t.text, List<PStmt>(), lr, bump(ps))
  if isSymTok(t, "(")
    let subs = parseTargetList(bump(ps), builder<PStmt>())
    ret match(subs.v)
      (f: PFail)        => (f, subs.rest)
      (sl: List<PStmt>) => parseTargetTail(attrs, "", sl, lr, subs.rest)
  ret (softFail("expected binding name", ps), ps)

fun [tail] parseTargetList(ps: Ps, acc: ListBuilder<PStmt>): (v: List<PStmt>|PFail, rest: Ps)
  if atSym(ps, ")")
    ret (build(acc), bump(ps))
  let t = parseTarget(ps)
  ret match(t.v)
    (f: PFail)  => f.hard ? stmtsFail(acc, f, t.rest)
      : atSym(ps, ")") ? (build(acc), bump(ps)) : stmtsFail(acc, harden(f, "expected binding"), ps)
    (pr: PStmt) => atSym(t.rest, ",")
      ? parseTargetList(bump(t.rest), push(acc, pr))
      : targetsClose(push(acc, pr), t.rest)

fun parseTargetTail(attrs: List<PAttr>, name: System::String, subs: List<PStmt>,
                    lr: PLine, ps: Ps): (v: PStmt|PFail, rest: Ps)
  let ty = parseMaybeColonType(ps)
  ret match(ty.v)
    (f: PFail)              => (f, ty.rest)
    (opt: Spec|System::None) => parseTargetArray(attrs, name, subs, opt, lr, ty.rest)

fun parseTargetArray(attrs: List<PAttr>, name: System::String, subs: List<PStmt>,
                     ty: Spec|System::None, lr: PLine,
                     ps: Ps): (v: PStmt|PFail, rest: Ps)
  let mark = atSym(ps, "[") && isIdentTok(peek(bump(ps))) && atSym(bump(bump(ps)), "]")
    ? peek(bump(ps)).text
    : ""
  let after = mark == "" ? ps : bump(bump(bump(ps)))
  if !atSym(after, "=")
    ret (targetStmt(attrs, name, subs, ty, mark, None, lr), after)
  let d = parseExpr(bump(after))
  ret match(d.v)
    (f: PFail) => (harden(f, "missing default value"), d.rest)
    (a: PExpr) => (targetStmt(attrs, name, subs, ty, mark, a, lr), d.rest)

fun targetStmt(attrs: List<PAttr>, name: System::String, subs: List<PStmt>,
               ty: Spec|System::None, mark: System::String,
               dflt: PExpr|System::None, lr: PLine): PStmt
  if name == "" && !isEmpty(subs)
    ret PsDestructure("_", attrs, ty, subs, None, lr)
  ret PsLet(hashName(name, lr), attrs, List<PGen>(), arrayTy(ty, mark, lr), dflt,
            mark, List<Spec>(), lr)

# `name: Elem[lenField]` — the declared type is the trailing-array field type.
fun arrayTy(ty: Spec|System::None, mark: System::String, lr: PLine): Spec|System::None
  if mark == ""
    ret ty
  ret match(ty)
    (el: Spec) => SArrayField(el, mark, lr)
    ()        => ty

# "(" target-list ")"
fun parseParams(ps: Ps): (v: List<PStmt>|PFail, rest: Ps)
  if !atSym(ps, "(")
    ret (softFail("expected '('", ps), ps)
  ret parseTargetList(bump(ps), builder<PStmt>())

# "<" [attrs] ident ("," …)* ">"
fun parseMaybeGenerics(ps: Ps): (v: List<PGen>|PFail, rest: Ps)
  if !atSym(ps, "<")
    ret (List<PGen>(), ps)
  ret parseGenericList(bump(ps), builder<PGen>())

fun parseGenericList(ps: Ps, acc: ListBuilder<PGen>): (v: List<PGen>|PFail, rest: Ps)
  let lr = lineAt(ps)
  let attrs = parseMaybeAttributes(ps)
  ret match(attrs.v)
    (f: PFail)        => gensFail(acc, f, attrs.rest)
    (al: List<PAttr>) => parseGenericName(al, lr, attrs.rest, acc)

# A generic parameter is a TypeAliasStatement named `T@hash6` at the
# attribute-or-name position (parser.py __to_generic_placeholder).
fun parseGenericName(attrs: List<PAttr>, lr: PLine, ps: Ps,
                     acc: ListBuilder<PGen>): (v: List<PGen>|PFail, rest: Ps)
  let t = peek(ps)
  if !isIdentTok(t)
    ret gensFail(acc, hardFail("expected generic parameter name", ps), ps)
  let acc2 = push(acc, PGen(hashName(t.text, lr), attrs, lr))
  let after = bump(ps)
  if atSym(after, ",")
    ret parseGenericList(bump(after), acc2)
  ret atSym(after, ">")
    ? (build(acc2), bump(after))
    : gensFail(acc2, hardFail("expected ',' or '>' in generics", after), after)

# "where" type — the constraint list is one type (usually a union of them).
fun parseMaybeWhere(ps: Ps): (v: List<Spec>|PFail, rest: Ps)
  if !atSym(ps, "where")
    ret (List<Spec>(), ps)
  let t = parseType(bump(ps))
  ret match(t.v)
    (f: PFail) => (harden(f, "missing type constraints"), t.rest)
    (ty: Spec)   => (whereList(ty), t.rest)

fun whereList(ty: Spec): List<Spec>
  ret match(ty)
    (u: SCombination) => u.scTypes
    (other)      => append(List<Spec>(), ty)

# ══ Expressions ══════════════════════════════════════════════════════════════
# The ladder, tightest first, mirroring parser.py's node construction:
# && / || desugar to ternaries over BoolExpression, `is` to a two-arm match,
# unary minus folds into literals, `x[i]` lowers to the `[]` operator call.

fun parseExpr(ps: Ps): (v: PExpr|PFail, rest: Ps)
  let lr = lineAt(ps)
  let c = parseOr(ps)
  ret match(c.v)
    (f: PFail) => c
    (a: PExpr) => atSym(c.rest, "?") ? parseTernaryTail(a, lr, bump(c.rest)) : c

fun parseTernaryTail(cond: PExpr, lr: PLine, ps: Ps): (v: PExpr|PFail, rest: Ps)
  let t = parseExpr(ps)
  ret match(t.v)
    (f: PFail) => (harden(f, "missing ternary true branch"), t.rest)
    (thn: PExpr) => !atSym(t.rest, ":")
      ? (hardFail("expected ':' in ternary", t.rest), t.rest)
      : parseTernaryElse(cond, thn, lr, bump(t.rest))

fun parseTernaryElse(cond: PExpr, thn: PExpr, lr: PLine,
                     ps: Ps): (v: PExpr|PFail, rest: Ps)
  let e = parseExpr(ps)
  ret match(e.v)
    (f: PFail) => (harden(f, "missing ternary false branch"), e.rest)
    (els: PExpr) => (PeTernary(cond, thn, els, exprLine(cond)), e.rest)

# `a || b` => a ? true : b ; `a && b` => a ? b : false — short-circuit sugar,
# at the LEFT operand's line_ref (parser.py __to_logical_*).
fun parseOr(ps: Ps): (v: PExpr|PFail, rest: Ps)
  let a = parseAnd(ps)
  ret match(a.v)
    (f: PFail) => a
    (l: PExpr) => orLoop(l, a.rest)

fun [tail] orLoop(lhs: PExpr, ps: Ps): (v: PExpr|PFail, rest: Ps)
  if !atSym(ps, "||")
    ret (lhs, ps)
  let r = parseAnd(bump(ps))
  ret match(r.v)
    (f: PFail)   => f.hard ? (f, r.rest) : (lhs, ps)
    (rhs: PExpr) => orLoop(PeTernary(lhs, PeBool(true, exprLine(lhs)), rhs,
                                     exprLine(lhs)), r.rest)

fun parseAnd(ps: Ps): (v: PExpr|PFail, rest: Ps)
  let a = parseBind(ps)
  ret match(a.v)
    (f: PFail) => a
    (l: PExpr) => andLoop(l, a.rest)

fun [tail] andLoop(lhs: PExpr, ps: Ps): (v: PExpr|PFail, rest: Ps)
  if !atSym(ps, "&&")
    ret (lhs, ps)
  let r = parseBind(bump(ps))
  ret match(r.v)
    (f: PFail)   => f.hard ? (f, r.rest) : (lhs, ps)
    (rhs: PExpr) => andLoop(PeTernary(lhs, rhs, PeBool(false, exprLine(lhs)),
                                      exprLine(lhs)), r.rest)

# `|>` and `?>` share ONE level so mixed chains fold strictly left-to-right.
# The pipe lives here — LOOSER than the arithmetic/comparison operators (like
# every ML-family pipe), so `n - 1 |> f` pipes `n - 1`, not `1` (Python
# __parse_bind / __to_bind_or_pipeline).
fun parseBind(ps: Ps): (v: PExpr|PFail, rest: Ps)
  let lr = lineAt(ps)
  let a = parseIs(ps)
  ret match(a.v)
    (f: PFail) => a
    (l: PExpr) => bindPipeLoop(l, lr, a.rest)

fun [tail] bindPipeLoop(lhs: PExpr, lr: PLine, ps: Ps): (v: PExpr|PFail, rest: Ps)
  let t = peek(ps)
  let op = match(t.kind)
    (k: KSymbol) => t.text == "?>" || t.text == "|>" ? t.text : ""
    ()           => ""
  if op == ""
    ret (lhs, ps)
  let r = parseIs(bump(ps))
  ret match(r.v)
    (f: PFail)   => f.hard ? (f, r.rest) : (lhs, ps)
    (rhs: PExpr) => bindPipeLoop(op == "|>"
                                   ? pipeStage(lhs, rhs)
                                   : foldBinary("?>", lhs, rhs, lr),
                                 lr, r.rest)

# `L is R` / `L !is R` => match(L) (_: R) => Bool ; () => Bool — no Is node.
fun parseIs(ps: Ps): (v: PExpr|PFail, rest: Ps)
  let a = parseCompare(ps)
  ret match(a.v)
    (f: PFail) => a
    (l: PExpr) => parseIsTail(l, a.rest)

fun parseIsTail(lhs: PExpr, ps: Ps): (v: PExpr|PFail, rest: Ps)
  let neg = atSym(ps, "!")
  let base = neg ? bump(ps) : ps
  let kw = peek(base)
  if !(isIdentTok(kw) && kw.text == "is")
    ret (lhs, ps)
  let t = parseType(bump(base))
  ret match(t.v)
    (f: PFail) => (harden(f, "missing type after is"), t.rest)
    (ty: Spec)  => (isDesugar(lhs, neg, ty), t.rest)

fun isDesugar(lhs: PExpr, neg: Bool, ty: Spec): PExpr
  let lr = exprLine(lhs)
  let arms = append(append(List<PArm>(),
      PArm("", ty, PeBool(!neg, lr), List<PLit>(), None, lr)),
      PArm("", None, PeBool(neg, lr), List<PLit>(), None, lr))
  ret PeMatch(lhs, arms, lr)

# One left-associative binary level over an op set: builds the `` `op` ``
# call (with the andNot fold) via builders.foldBinary.
fun binLevel(ps: Ps, ops: String,
             sub: (:Ps): (v: PExpr|PFail, rest: Ps)): (v: PExpr|PFail, rest: Ps)
  let lr = lineAt(ps)
  let a = sub(ps)
  ret match(a.v)
    (f: PFail) => a
    (l: PExpr) => binLevelLoop(l, lr, a.rest, ops, sub)

fun [tail] binLevelLoop(lhs: PExpr, lr: PLine, ps: Ps, ops: String,
                 sub: (:Ps): (v: PExpr|PFail, rest: Ps)): (v: PExpr|PFail, rest: Ps)
  let t = peek(ps)
  let hit = match(t.kind)
    (k: KSymbol) => contains(ops, " " + t.text + " ")
    ()           => false
  if !hit
    ret (lhs, ps)
  let r = sub(bump(ps))
  ret match(r.v)
    (f: PFail)   => f.hard ? (f, r.rest) : (lhs, ps)
    (rhs: PExpr) => binLevelLoop(foldBinary(t.text, lhs, rhs, lr), lr, r.rest, ops, sub)

fun parseCompare(ps: Ps): (v: PExpr|PFail, rest: Ps)
  ret binLevel(ps, " < == > != <= >= ", parseBitOr)
fun parseBitOr(ps: Ps): (v: PExpr|PFail, rest: Ps)
  ret binLevel(ps, " | ", parseBitXor)
fun parseBitXor(ps: Ps): (v: PExpr|PFail, rest: Ps)
  ret binLevel(ps, " ^ ", parseBitAnd)
fun parseBitAnd(ps: Ps): (v: PExpr|PFail, rest: Ps)
  ret binLevel(ps, " & ", parseShift)
fun parseShift(ps: Ps): (v: PExpr|PFail, rest: Ps)
  ret binLevel(ps, " << >> ", parseAddSub)
fun parseAddSub(ps: Ps): (v: PExpr|PFail, rest: Ps)
  ret binLevel(ps, " + - ", parseDivMul)
fun parseDivMul(ps: Ps): (v: PExpr|PFail, rest: Ps)
  ret binLevel(ps, " % / * ", parseUnary)

# Unary: `-` folds into a literal (negating the stored value), else the
# operator call; `!` and `~` are always operator calls.
fun parseUnary(ps: Ps): (v: PExpr|PFail, rest: Ps)
  let t = peek(ps)
  let op = match(t.kind)
    (k: KSymbol) => t.text == "-" || t.text == "!" || t.text == "~" ? t.text : ""
    ()           => ""
  if op == ""
    ret parsePostfix(ps)
  let lr = lineAt(ps)
  let s = parsePostfix(bump(ps))
  ret match(s.v)
    (f: PFail) => s
    (a: PExpr) => (unaryBuild(op, a, lr), s.rest)

fun unaryBuild(op: String, sub: PExpr, lr: PLine): PExpr
  if op == "-"
    ret match(sub)
      (i: PeInt)   => PeInt(0 - i.value, i.precision, i.peiLine)
      (f: PeFloat) => PeFloat("-" + f.floatText, f.fPrecision, f.pefLine)
      (other)      => callNamed("`-`", oneEntryTuple(sub, lr), lr)
  ret callNamed("`" + op + "`", oneEntryTuple(sub, lr), lr)

# postfix = terminal (call | .name | [index])*
fun parsePostfix(ps: Ps): (v: PExpr|PFail, rest: Ps)
  let t = parseTerminal(ps)
  ret match(t.v)
    (f: PFail) => t
    (a: PExpr) => postfixLoop(a, t.rest)

fun [tail] postfixLoop(base: PExpr, ps: Ps): (v: PExpr|PFail, rest: Ps)
  if atSym(ps, "(")
    let lr = lineAt(bump(ps))
    let args = parseTupleTerm(ps)
    ret match(args.v)
      (f: PFail)    => (f, args.rest)
      (tup: PExpr)  => postfixLoop(PeCall(base, tup, lr), args.rest)
  if atSym(ps, ".")
    let name = peek(bump(ps))
    if !isIdentTok(name)
      ret (hardFail("Must be an identifier", bump(ps)), ps)
    let mlr = PLine(ps.srcFile, name.line, name.col)
    ret postfixLoop(PeDot(base, name.text, mlr), bump(bump(ps)))
  if atSym(ps, "[")
    let lr = lineAt(bump(ps))
    let ix = parseExpr(bump(ps))
    ret match(ix.v)
      (f: PFail)   => (harden(f, "invalid index expression"), ix.rest)
      (idx: PExpr) => !atSym(ix.rest, "]")
        ? (hardFail("expected ']'", ix.rest), ix.rest)
        : postfixLoop(callNamed("`[]`", twoEntryTuple(base, idx, lr), lr),
                      bump(ix.rest))
  ret (base, ps)

# ══ Terminals ════════════════════════════════════════════════════════════════
# Literals decode HERE, as parser.py does: integers via radix/suffix
# (negatives fold in later at unary), strings/regexes unescaped, chars to
# their codepoint as a 32-bit IntegerExpression. Floats keep the lexeme
# (see the parked float-repr contract note).

fun parseTerminal(ps: Ps): (v: PExpr|PFail, rest: Ps)
  let t = peek(ps)
  let lr = lineAt(ps)
  ret match(t.kind)
    (n: KNumber)  => numberTerm(t.text, lr, ps)
    (s2: KString) => stringTerm(t.text, lr, ps)
    (c2: KChar)   => charTerm(t.text, lr, ps)
    (r2: KRegex)  => regexTerm(t.text, lr, ps)
    (i2: KIdent)  => parseNamed(ps)
    (sy: KSymbol) => parseSymbolTerminal(t.text, ps)
    ()            => (softFail("expected expression", ps), ps)

fun isFloatLexeme(s: String): Bool
  if startsWith(s, "0x") || startsWith(s, "0X") || startsWith(s, "0b")
     || startsWith(s, "0B") || startsWith(s, "0o") || startsWith(s, "0O")
    ret false
  ret containsByte(s, '.') || containsByte(s, 'e') || containsByte(s, 'E')
    || endsWith(s, "f32") || endsWith(s, "f64")

fun numberTerm(lexeme: String, lr: PLine, ps: Ps): (v: PExpr|PFail, rest: Ps)
  if isFloatLexeme(lexeme)
    let prec = endsWith(lexeme, "f32") ? 32 : endsWith(lexeme, "f64") ? 64 : 0
    let cut = prec == 0 ? length(lexeme) : length(lexeme) - 3
    ret (PeFloat(slice(lexeme, 0, cut), prec, lr), bump(ps))
  let d = decodeInt(lexeme)
  ret d.ilErr == ""
    ? (PeInt(d.ilValue, d.ilPrecision, lr), bump(ps))
    : (hardFail(d.ilErr, ps), bump(ps))

fun stringTerm(lexeme: String, lr: PLine, ps: Ps): (v: PExpr|PFail, rest: Ps)
  if !endsWith(lexeme, "\"") || length(lexeme) < 2
    ret (hardFail("string missing quote", ps), bump(ps))
  let u = unescape(slice(lexeme, 1, length(lexeme) - 1))
  ret u.uErr == ""
    ? (PeStr(u.uText, lr), bump(ps))
    : (hardFail(u.uErr, ps), bump(ps))

# A char literal is its codepoint as a 32-bit integer (exactly one scalar).
fun charTerm(lexeme: String, lr: PLine, ps: Ps): (v: PExpr|PFail, rest: Ps)
  if length(lexeme) < 2 || !endsWith(lexeme, "'")
    ret (hardFail("char literal missing closing quote", ps), bump(ps))
  let u = unescape(slice(lexeme, 1, length(lexeme) - 1))
  if u.uErr != ""
    ret (hardFail(u.uErr, ps), bump(ps))
  ret match(decode(u.uText, 0))
    (d: (cp: Int32, next: Int)) => d.next == length(u.uText)
      ? (PeInt(Int(d.cp), 32, lr), bump(ps))
      : (hardFail("char literal must be exactly one character", ps), bump(ps))
    ()                          => (hardFail("char literal must be exactly one character", ps), bump(ps))

fun regexTerm(lexeme: String, lr: PLine, ps: Ps): (v: PExpr|PFail, rest: Ps)
  if !endsWith(lexeme, "\"") || length(lexeme) < 4
    ret (hardFail("regex literal missing closing quote", ps), bump(ps))
  ret (PeRegex(slice(lexeme, 3, length(lexeme) - 1), lr), bump(ps))

fun parseSymbolTerminal(sym: String, ps: Ps): (v: PExpr|PFail, rest: Ps)
  if sym == "match"
    ret parseMatch(lineAt(ps), bump(ps))
  if sym == "__builtin_op__"
    ret parseBuiltinOp(lineAt(ps), bump(ps))
  if sym == "__parallel__"
    ret parseParallel(lineAt(ps), bump(ps))
  if sym == "("
    ret parseLambdaOrParen(ps)
  ret (softFail("expected expression", ps), ps)

# name(::name)* [<types>] — one NamedExpression with the joined path.
fun parseNamed(ps: Ps): (v: PExpr|PFail, rest: Ps)
  ret namedPath(peek(ps).text, lineAt(ps), bump(ps))

fun [tail] namedPath(path: String, lr: PLine, ps: Ps): (v: PExpr|PFail, rest: Ps)
  if atSym(ps, "::") && isIdentTok(peek(bump(ps)))
    ret namedPath(path + "::" + peek(bump(ps)).text, lr, bump(bump(ps)))
  if !atSym(ps, "<")
    ret (PeName(path, List<Spec>(), lr), ps)
  let args = parseTypeArgs(bump(ps), builder<Spec>())
  ret match(args.v)
    (f: PFail)        => f.hard ? (f, args.rest) : (PeName(path, List<Spec>(), lr), ps)
    (list: List<Spec>) => (PeName(path, list, lr), args.rest)

# `(` … — a lambda when `(targets) =>` parses, else a tuple expression.
fun parseLambdaOrParen(ps: Ps): (v: PExpr|PFail, rest: Ps)
  let lr = lineAt(ps)
  let pars = parseParams(ps)
  ret match(pars.v)
    (f: PFail)        => parenTerm(ps)
    (pl: List<PStmt>) => !atSym(pars.rest, "=>")
      ? parenTerm(ps)
      : parseLambdaBody(pl, lr, lr, bump(pars.rest))

# `( expr )` as a PRIMARY: a single un-named, non-spread entry collapses to the
# expression itself (parser.py __to_paren_expr); `()`, `(a, b)`, `(n = v)` stay
# tuples. Call/builtin/parallel argument lists never collapse.
fun parenTerm(ps: Ps): (v: PExpr|PFail, rest: Ps)
  let t = parseTupleTerm(ps)
  ret match(t.v)
    (f: PFail)   => t
    (tup: PExpr) => (collapseParen(tup), t.rest)

fun collapseParen(tup: PExpr): PExpr
  ret match(tup)
    (t2: PeTuple) => match(head(t2.exprs))
      (only: PTupEnt) => isEmpty(tail(t2.exprs)) && only.tupName == "" && !only.tupSpread
        ? only.tupValue
        : tup
      ()              => tup
    (other)       => tup

fun parseLambdaBody(pars: List<PStmt>, lr: PLine, inner: PLine,
                    ps: Ps): (v: PExpr|PFail, rest: Ps)
  let b = parseExpr(ps)
  ret match(b.v)
    (f: PFail) => (harden(f, "missing lambda body"), b.rest)
    (a: PExpr) => (PeLambda(PsDestructure("_", List<PAttr>(), None, pars, None, inner),
                            a, lr), b.rest)

fun parseTupleTerm(ps: Ps): (v: PExpr|PFail, rest: Ps)
  if !atSym(ps, "(")
    ret (softFail("expected '('", ps), ps)
  let lr = lineAt(bump(ps))
  let args = parseArgList(bump(ps), builder<PTupEnt>())
  ret match(args.v)
    (f: PFail)            => (f, args.rest)
    (list: List<PTupEnt>) => (PeTuple(list, lr), args.rest)

# "(" already consumed: [name =] expr / *expr, comma separated, to ")".
fun [tail] parseArgList(ps: Ps, acc: ListBuilder<PTupEnt>): (v: List<PTupEnt>|PFail, rest: Ps)
  if atSym(ps, ")")
    ret (build(acc), bump(ps))
  let a = parseArg(ps)
  ret match(a.v)
    (f: PFail)    => argsFail(acc, f, a.rest)
    (ag: PTupEnt) => atSym(a.rest, ",")
      ? parseArgList(bump(a.rest), push(acc, ag))
      : argsClose(push(acc, ag), a.rest)

fun parseArg(ps: Ps): (v: PTupEnt|PFail, rest: Ps)
  if atSym(ps, "*")
    let sp = parseExpr(bump(ps))
    ret match(sp.v)
      (f: PFail) => (f, sp.rest)
      (a: PExpr) => (PTupEnt("", true, a), sp.rest)
  let name = peek(ps)
  if isIdentTok(name) && atSym(bump(ps), "=") && !atSym(bump(bump(ps)), "=")
    let nv = parseExpr(bump(bump(ps)))
    ret match(nv.v)
      (f: PFail) => (f, nv.rest)
      (a: PExpr) => (PTupEnt(name.text, false, a), nv.rest)
  let e = parseExpr(ps)
  ret match(e.v)
    (f: PFail) => (f, e.rest)
    (a: PExpr) => (PTupEnt("", false, a), e.rest)

# __builtin_op__<type>("op", args…): the first tuple entry must be a string;
# the node keeps the op and the REMAINING entries (parser.py trim_left(1)).
fun parseBuiltinOp(kwLr: PLine, ps: Ps): (v: PExpr|PFail, rest: Ps)
  if !(atSym(ps, "<") && isIdentTok(peek(bump(ps))) && atSym(bump(bump(ps)), ">"))
    ret (hardFail("invalid use of __builtin_op__", ps), ps)
  let ty = peek(bump(ps)).text
  let after = bump(bump(bump(ps)))
  let lr = lineAt(ps)
  let args = parseTupleTerm(after)
  ret match(args.v)
    (f: PFail)   => (harden(f, "invalid use of __builtin_op__"), args.rest)
    (tup: PExpr) => builtinFromTuple(ty, tup, lr, args.rest)

fun builtinFromTuple(ty: String, tup: PExpr, lr: PLine,
                     ps: Ps): (v: PExpr|PFail, rest: Ps)
  ret match(tup)
    (t2: PeTuple) => match(head(t2.exprs))
      (first: PTupEnt) => match(first.tupValue)
        (op: PeStr) => (PeBuiltinOp(SBuiltin(ty, lr), first.tupValue,
                                    PeTuple(tail(t2.exprs), t2.petLine), lr), ps)
        ()          => (hardFail("__builtin_op__ first parameter must be a string", ps), ps)
      ()               => (hardFail("__builtin_op__ first parameter must be a string", ps), ps)
    (other)       => (hardFail("invalid use of __builtin_op__", ps), ps)

fun parseParallel(lr: PLine, ps: Ps): (v: PExpr|PFail, rest: Ps)
  let args = parseTupleTerm(ps)
  ret match(args.v)
    (f: PFail)   => (harden(f, "invalid use of __parallel__"), args.rest)
    (tup: PExpr) => (PeParallel(tup, lr), args.rest)

# ══ Match ════════════════════════════════════════════════════════════════════
# Arms mirror MatchArm: a binder arm's name is the destructure target's bare
# name (pre-@hash), '_' meaning unnamed; literal arms carry expression or
# range literals; guards ride the arm.

# The match node's line is its SUBJECT's start (Python's requires-result line).
fun parseMatch(kwLr: PLine, ps: Ps): (v: PExpr|PFail, rest: Ps)
  if !atSym(ps, "(")
    ret (hardFail("invalid match subject", ps), ps)
  let lr = lineAt(bump(ps))
  let subj = parseExpr(bump(ps))
  ret match(subj.v)
    (f: PFail) => (harden(f, "invalid match subject"), subj.rest)
    (a: PExpr) => !atSym(subj.rest, ")")
      ? (hardFail("expected ')' after match subject", subj.rest), subj.rest)
      : parseArms(a, lr, bump(subj.rest), builder<PArm>())

fun [tail] parseArms(subj: PExpr, lr: PLine, ps: Ps,
              acc: ListBuilder<PArm>): (v: PExpr|PFail, rest: Ps)
  let t = peek(ps)
  if !isSymTok(t, "(")
    ret (PeMatch(subj, build(acc), lr), ps)
  let armPs = Ps(ps.ts, t.line, t.indent, ps.srcFile)
  let a = parseArm(armPs)
  ret match(a.v)
    (f: PFail) => armsFail(acc, f, a.rest)
    (arm: PArm) => parseArms(subj, lr, blockExit(a.rest, ps), push(acc, arm))

fun parseArm(ps: Ps): (v: PArm|PFail, rest: Ps)
  let lr = lineAt(ps)
  let lits = parseLiteralArmHead(bump(ps))
  ret match(lits.v)
    (f: PFail)         => f.hard ? (f, lits.rest) : parseDestructureArm(lr, ps)
    (list: List<PLit>) => isEmpty(list)
      ? parseDestructureArm(lr, ps)
      : parseArmTail("", None, list, lr, lits.rest)

fun parseLiteralArmHead(ps: Ps): (v: List<PLit>|PFail, rest: Ps)
  if atSym(ps, ")")
    ret (List<PLit>(), bump(ps))
  ret parseLiteralList(ps, builder<PLit>())

fun [tail] parseLiteralList(ps: Ps, acc: ListBuilder<PLit>): (v: List<PLit>|PFail, rest: Ps)
  let l = parseMatchLiteral(ps)
  ret match(l.v)
    (f: PFail) => litsFail(acc, PFail(false, f.msg, f.line, f.col), l.rest)
    (a: PLit)  => atSym(l.rest, ",")
      ? parseLiteralList(bump(l.rest), push(acc, a))
      : litsClose(push(acc, a), l.rest)

fun parseMatchLiteral(ps: Ps): (v: PLit|PFail, rest: Ps)
  let t = peek(ps)
  let lr = lineAt(ps)
  let isStr = match(t.kind)
    (s2: KString) => true
    ()            => false
  if isStr
    let s = stringTerm(t.text, lr, ps)
    ret match(s.v)
      (f: PFail) => (f, s.rest)
      (a: PExpr) => (PlExpr(a), s.rest)
  let lo = parseMatchBound(ps)
  ret match(lo.v)
    (f: PFail) => (f, lo.rest)
    (a: PExpr) => !atSym(lo.rest, "..")
      ? (PlExpr(a), lo.rest)
      : parseRangeHi(a, lr, bump(lo.rest))

fun parseRangeHi(lo: PExpr, lr: PLine, ps: Ps): (v: PLit|PFail, rest: Ps)
  let hi = parseMatchBound(ps)
  ret match(hi.v)
    (f: PFail) => (harden(f, "missing range upper bound"), hi.rest)
    (a: PExpr) => (PlRange(lo, a, lr), hi.rest)

fun parseMatchBound(ps: Ps): (v: PExpr|PFail, rest: Ps)
  let neg = atSym(ps, "-")
  let base = neg ? bump(ps) : ps
  let t = peek(base)
  let lr = lineAt(base)
  let isNum = match(t.kind)
    (n: KNumber) => true
    (c2: KChar)  => !neg
    ()           => false
  if !isNum
    ret (softFail("expected literal", ps), ps)
  let term = match(t.kind)
    (n: KNumber) => numberTerm(t.text, lr, base)
    ()           => charTerm(t.text, lr, base)
  ret match(term.v)
    (f: PFail) => (f, term.rest)
    (a: PExpr) => (neg ? unaryBuild("-", a, lr) : a, term.rest)

fun parseDestructureArm(lr: PLine, ps: Ps): (v: PArm|PFail, rest: Ps)
  let pars = parseParams(ps)
  ret match(pars.v)
    (f: PFail)        => (harden(f, "invalid match arm"), pars.rest)
    (pl: List<PStmt>) => armFromTargets(pl, lr, pars.rest)

# One binder at most: its bare name (pre-@) and declared type feed the arm;
# `_` means unnamed. Zero binders is the else arm.
fun armFromTargets(pl: List<PStmt>, lr: PLine, ps: Ps): (v: PArm|PFail, rest: Ps)
  ret match(head(pl))
    (only: PStmt) => isEmpty(tail(pl))
      ? armFromBinder(only, lr, ps)
      : (hardFail("match arm must have exactly one parameter", ps), ps)
    ()            => parseArmTail("", None, List<PLit>(), lr, ps)

fun armFromBinder(binder: PStmt, lr: PLine, ps: Ps): (v: PArm|PFail, rest: Ps)
  ret match(binder)
    (l: PsLet) => parseArmTail(bareOf(l.lName) == "_" ? "" : bareOf(l.lName),
                               l.lType, List<PLit>(), lr, ps)
    (other)    => (hardFail("invalid match arm", ps), ps)

fun bareOf(name: String): String
  let at = findByte(name, '@', 0)
  ret at < 0 ? name : slice(name, 0, at)

fun parseArmTail(name: String, ty: Spec|None, lits: List<PLit>, lr: PLine,
                 ps: Ps): (v: PArm|PFail, rest: Ps)
  if atSym(ps, "if")
    let g = parseExpr(bump(ps))
    ret match(g.v)
      (f: PFail)     => (harden(f, "missing guard expression"), g.rest)
      (guard: PExpr) => armBody(name, ty, lits, guard, lr, g.rest)
  ret armBodyNoGuard(name, ty, lits, lr, ps)

fun armBody(name: String, ty: Spec|None, lits: List<PLit>, guard: PExpr,
            lr: PLine, ps: Ps): (v: PArm|PFail, rest: Ps)
  if !atSym(ps, "=>")
    ret (hardFail("expected '=>' in match arm", ps), ps)
  let b = parseExpr(bump(ps))
  ret match(b.v)
    (f: PFail) => (harden(f, "missing match arm body"), b.rest)
    (a: PExpr) => (PArm(name, ty, a, lits, guard, lr), b.rest)

fun armBodyNoGuard(name: String, ty: Spec|None, lits: List<PLit>, lr: PLine,
                   ps: Ps): (v: PArm|PFail, rest: Ps)
  if !atSym(ps, "=>")
    ret (hardFail("expected '=>' in match arm", ps), ps)
  let b = parseExpr(bump(ps))
  ret match(b.v)
    (f: PFail) => (harden(f, "missing match arm body"), b.rest)
    (a: PExpr) => (PArm(name, ty, a, lits, None, lr), b.rest)

# ══ Statements ═══════════════════════════════════════════════════════════════
# Each statement parses inside its own block fence (parselib.block). Named
# declarations take `name@hash6` unique names; function bodies become
# BlockExpressions whose VALUE is a trailing `ret`'s expression (else
# Nothing), mirroring __to_function / __to_function_oneliner.

# Re-fence back to the enclosing block after a nested one.
fun blockExit(inner: Ps, outer: Ps): Ps
  ret Ps(inner.ts, outer.fline, outer.findent, outer.srcFile)

fun [tail] parseStmts(ps: Ps, acc: ListBuilder<PStmt>): (v: List<PStmt>|PFail, rest: Ps)
  let t = peek(ps)
  if isEof(t)
    ret (build(acc), ps)
  let inner = Ps(ps.ts, t.line, t.indent, ps.srcFile)
  let s = parseStmt(inner)
  ret match(s.v)
    (f: PFail)  => stmtsFail(acc, f, s.rest)
    (st: PStmt) => !isEof(peek(s.rest))
      ? stmtsFail(acc, hardFail("extra unexpected characters", s.rest), s.rest)
      : parseStmts(blockExit(s.rest, ps), push(acc, st))

fun parseStmt(ps: Ps): (v: PStmt|PFail, rest: Ps)
  let t = peek(ps)
  let lr = lineAt(ps)
  let post = lineAt(bump(ps))
  let kw = match(t.kind)
    (k: KSymbol) => t.text
    ()           => ""
  if kw == "class"
    ret parseClass(post, bump(ps), false)
  if kw == "interface"
    ret parseClass(post, bump(ps), true)
  if kw == "fun"
    ret parseFun(post, bump(ps))
  if kw == "let"
    ret parseLet(post, bump(ps))
  if kw == "typealias"
    ret parseTypealias(post, bump(ps))
  if kw == "instance"
    ret parseInstance(post, bump(ps))
  if kw == "import"
    ret parsePath(lr, bump(ps), false)
  if kw == "namespace"
    ret parsePath(lr, bump(ps), true)
  if kw == "ret"
    ret parseRet(post, bump(ps))
  if kw == "enum"
    ret parseEnum(post, bump(ps))
  if kw == "if"
    ret parseIf(post, bump(ps), 0)
  if kw == "else"
    ret atSym(bump(ps), "if")
      ? parseIf(lineAt(bump(bump(ps))), bump(bump(ps)), 1)
      : parseElse(post, bump(ps))
  ret parseAction(lr, ps)

# The statement expression's PARSE START. Python's productions carry the
# LEFT-most consumed token's line_ref (parselib `&` keeps left.line_ref, and
# discard keeps the symbol's) — so a leading unary op token IS the start. The
# structural startLine agrees everywhere EXCEPT a folded negative literal
# (`ret -1`): the folded node keeps the DIGIT's line, losing the minus. Peek
# the first token instead when it is a unary op; identical to startLine in
# every other case.
fun stmtExprStart(ps: Ps, x: PExpr): PLine
  let t = peek(ps)
  ret match(t.kind)
    (k: KSymbol) => t.text == "-" || t.text == "!" || t.text == "~"
      ? lineAt(ps)
      : startLine(x)
    ()           => startLine(x)

fun parseAction(lr: PLine, ps: Ps): (v: PStmt|PFail, rest: Ps)
  let e = parseExpr(ps)
  ret match(e.v)
    (f: PFail) => e
    (a: PExpr) => (PsAction(a, stmtExprStart(ps, a)), e.rest)

fun parseRet(lr: PLine, ps: Ps): (v: PStmt|PFail, rest: Ps)
  let e = parseExpr(ps)
  ret match(e.v)
    (f: PFail) => (harden(f, "missing return value"), e.rest)
    (a: PExpr) => (PsRet(a, stmtExprStart(ps, a)), e.rest)

fun parseIf(lr: PLine, ps: Ps, kindSel: Int): (v: PStmt|PFail, rest: Ps)
  let c = parseExpr(ps)
  ret match(c.v)
    (f: PFail)  => (harden(f, "invalid if statement"), c.rest)
    (cond: PExpr) => parseIfBody(cond, kindSel, stmtExprStart(ps, cond), c.rest)

fun parseIfBody(cond: PExpr, kindSel: Int, lr: PLine,
                ps: Ps): (v: PStmt|PFail, rest: Ps)
  let b = parseStmts(ps, builder<PStmt>())
  ret match(b.v)
    (f: PFail)          => (f, b.rest)
    (body: List<PStmt>) => kindSel == 0
      ? (PsIf(cond, body, List<PStmt>(), lr), b.rest)
      : (PsElseIf(cond, body, lr), b.rest)

fun parseElse(lr: PLine, ps: Ps): (v: PStmt|PFail, rest: Ps)
  let b = parseStmts(ps, builder<PStmt>())
  ret match(b.v)
    (f: PFail)          => (f, b.rest)
    (body: List<PStmt>) => (PsElse(body, lr), b.rest)

fun parsePath(lr: PLine, ps: Ps, isNamespace: Bool): (v: PStmt|PFail, rest: Ps)
  let t = peek(ps)
  if !isIdentTok(t)
    ret (hardFail("expected name", ps), ps)
  ret parsePathRest(t.text, lr, bump(ps), isNamespace)

fun [tail] parsePathRest(path: String, lr: PLine, ps: Ps,
                  isNamespace: Bool): (v: PStmt|PFail, rest: Ps)
  if atSym(ps, "::") && isIdentTok(peek(bump(ps)))
    ret parsePathRest(path + "::" + peek(bump(ps)).text, lr, bump(bump(ps)), isNamespace)
  ret isNamespace ? (PsNamespace(path, lr), ps) : (PsImport(path, lr), ps)

fun parseTypealias(lr: PLine, ps: Ps): (v: PStmt|PFail, rest: Ps)
  let attrs = parseMaybeAttributes(ps)
  ret match(attrs.v)
    (f: PFail)        => (f, attrs.rest)
    (al: List<PAttr>) => parseTypealiasNamed(al, lr, attrs.rest)

fun parseTypealiasNamed(attrs: List<PAttr>, lr: PLine,
                        ps: Ps): (v: PStmt|PFail, rest: Ps)
  let t = peek(ps)
  if !isIdentTok(t)
    ret (hardFail("invalid typealias statement", ps), ps)
  let gen = parseMaybeGenerics(bump(ps))
  ret match(gen.v)
    (f: PFail)       => (f, gen.rest)
    (gl: List<PGen>) => parseTypealiasTy(attrs, t.text, gl, lr, gen.rest)

# A typealias is purely a name for a type: no `where` clause (the old
# `typealias [where]` conditional-instance channel was replaced by
# `instance [ambient]`).
fun parseTypealiasTy(attrs: List<PAttr>, name: String, gen: List<PGen>,
                     lr: PLine, ps: Ps): (v: PStmt|PFail, rest: Ps)
  if !atSym(ps, ":")
    ret (hardFail("expected ':' in typealias", ps), ps)
  let ty = parseType(bump(ps))
  ret match(ty.v)
    (f: PFail) => (harden(f, "invalid typealias statement"), ty.rest)
    (t2: Spec)  => (PsTypealias(hashName(name, lr), attrs, gen, t2,
                                List<Spec>(), lr),
                    ty.rest)

fun parseLet(lr: PLine, ps: Ps): (v: PStmt|PFail, rest: Ps)
  let attrs = parseMaybeAttributes(ps)
  ret match(attrs.v)
    (f: PFail)        => (f, attrs.rest)
    (al: List<PAttr>) => parseLetNamed(al, lr, attrs.rest)

fun parseLetNamed(attrs: List<PAttr>, lr: PLine,
                  ps: Ps): (v: PStmt|PFail, rest: Ps)
  let t = peek(ps)
  if isIdentTok(t)
    let gen = parseMaybeGenerics(bump(ps))
    ret match(gen.v)
      (f: PFail)       => (f, gen.rest)
      (gl: List<PGen>) => parseLetTail(attrs, t.text, gl, lr, gen.rest)
  if isSymTok(t, "(")
    let subs = parseTargetList(bump(ps), builder<PStmt>())
    ret match(subs.v)
      (f: PFail)        => (harden(f, "invalid let statement"), subs.rest)
      (sl: List<PStmt>) => parseDestructureLet(attrs, sl, lr, subs.rest)
  ret (hardFail("invalid let statement", ps), ps)

fun parseDestructureLet(attrs: List<PAttr>, subs: List<PStmt>, lr: PLine,
                        ps: Ps): (v: PStmt|PFail, rest: Ps)
  let ty = parseMaybeColonType(ps)
  ret match(ty.v)
    (f: PFail)              => (f, ty.rest)
    (opt: Spec|None) => parseDestructureInit(attrs, subs, opt, lr, ty.rest)

fun parseDestructureInit(attrs: List<PAttr>, subs: List<PStmt>,
                         ty: Spec|None, lr: PLine,
                         ps: Ps): (v: PStmt|PFail, rest: Ps)
  if !atSym(ps, "=")
    ret (PsDestructure("_", attrs, ty, subs, None, lr), ps)
  let d = parseExpr(bump(ps))
  ret match(d.v)
    (f: PFail) => (harden(f, "missing default value"), d.rest)
    (a: PExpr) => (destructureWith(attrs, subs, ty, a, lr), d.rest)

# A destructuring let with an initialiser: the holder carries the value
# (DestructureStatement.default_value), the targets destructure it.
fun destructureWith(attrs: List<PAttr>, subs: List<PStmt>, ty: Spec|None,
                    value: PExpr, lr: PLine): PStmt
  ret PsDestructure("_", attrs, ty, subs, value, lr)

fun parseLetTail(attrs: List<PAttr>, name: String, gen: List<PGen>,
                 lr: PLine, ps: Ps): (v: PStmt|PFail, rest: Ps)
  let tgt = parseTargetTail(attrs, name, List<PStmt>(), lr, ps)
  ret match(tgt.v)
    (f: PFail)  => (harden(f, "invalid let statement"), tgt.rest)
    (pr: PStmt) => parseLetWhere(gen, pr, lr, tgt.rest)

fun parseLetWhere(gen: List<PGen>, target: PStmt, lr: PLine,
                  ps: Ps): (v: PStmt|PFail, rest: Ps)
  let w = parseMaybeWhere(ps)
  ret match(w.v)
    (f: PFail)      => (f, w.rest)
    (wl: List<Spec>) => (letWith(gen, target, wl), w.rest)

fun letWith(gen: List<PGen>, target: PStmt, wl: List<Spec>): PStmt
  ret match(target)
    (l: PsLet) => PsLet(l.lName, l.lAttrs, gen, l.lType, l.lDefault,
                        l.lArrayLen, wl, l.pslLine)
    (other)    => target

fun parseFun(lr: PLine, ps: Ps): (v: PStmt|PFail, rest: Ps)
  let attrs = parseMaybeAttributes(ps)
  ret match(attrs.v)
    (f: PFail)        => (f, attrs.rest)
    (al: List<PAttr>) => parseFunNamed(al, lr, attrs.rest)

fun parseFunNamed(attrs: List<PAttr>, lr: PLine,
                  ps: Ps): (v: PStmt|PFail, rest: Ps)
  let t = peek(ps)
  if !isIdentTok(t)
    ret (hardFail("invalid function statement", ps), ps)
  let gen = parseMaybeGenerics(bump(ps))
  ret match(gen.v)
    (f: PFail)       => (f, gen.rest)
    (gl: List<PGen>) => parseFunParams(attrs, t.text, gl, lr, gen.rest)

fun parseFunParams(attrs: List<PAttr>, name: String, gen: List<PGen>,
                   lr: PLine, ps: Ps): (v: PStmt|PFail, rest: Ps)
  let pars = parseParams(ps)
  ret match(pars.v)
    (f: PFail)        => (harden(f, "invalid function statement"), pars.rest)
    (pl: List<PStmt>) => parseFunRet(attrs, name, gen, pl, lr, pars.rest)

fun parseFunRet(attrs: List<PAttr>, name: String, gen: List<PGen>,
                pars: List<PStmt>, lr: PLine, ps: Ps): (v: PStmt|PFail, rest: Ps)
  let ty = parseMaybeColonType(ps)
  ret match(ty.v)
    (f: PFail)              => (f, ty.rest)
    (opt: Spec|None) => parseFunWhere(attrs, name, gen, pars, opt, lr, ty.rest)

fun parseFunWhere(attrs: List<PAttr>, name: String, gen: List<PGen>,
                  pars: List<PStmt>, retTy: Spec|None, lr: PLine,
                  ps: Ps): (v: PStmt|PFail, rest: Ps)
  let w = parseMaybeWhere(ps)
  ret match(w.v)
    (f: PFail)      => (f, w.rest)
    (wl: List<Spec>) => parseFunBody(attrs, name, gen, pars, retTy, wl, lr, w.rest)

fun funParamsStmt(pars: List<PStmt>, lr: PLine): PStmt
  ret PsDestructure("_", List<PAttr>(), None, pars, None, lr)

fun parseFunBody(attrs: List<PAttr>, name: String, gen: List<PGen>,
                 pars: List<PStmt>, retTy: Spec|None, wl: List<Spec>,
                 lr: PLine, ps: Ps): (v: PStmt|PFail, rest: Ps)
  if atSym(ps, "=>")
    let e = parseExpr(bump(ps))
    ret match(e.v)
      (f: PFail) => (harden(f, "invalid function statement"), e.rest)
      (a: PExpr) => (PsFun(hashName(name, lr), attrs, gen, funParamsStmt(pars, lr),
                           PeBlock(List<PStmt>(), a, "", lr), retTy, wl, lr), e.rest)
  let b = parseStmts(ps, builder<PStmt>())
  ret match(b.v)
    (f: PFail)          => (f, b.rest)
    (body: List<PStmt>) => (PsFun(hashName(name, lr), attrs, gen,
                                  funParamsStmt(pars, lr),
                                  funBlock(body, lr), retTy, wl, lr), b.rest)

# __to_function: a trailing ReturnStatement becomes the block VALUE; any other
# ending gives a Nothing value; an EMPTY body means no body at all (interface
# member) — represented by an empty block whose value is Nothing here and
# filtered by the class builder when mirroring `body = None`.
fun funBlock(body: List<PStmt>, lr: PLine): PExpr|None
  if isEmpty(body)
    ret None
  ret match(last(body))
    (st: PStmt) => match(st)
      (r: PsRet) => PeBlock(take(body, listLen(body) - 1), r.retValue, "", lr)
      (other)    => PeBlock(body, PeNothing(lr), "", lr)
    ()          => PeBlock(body, PeNothing(lr), "", lr)

fun listLen<T>(l: List<T>): Int
  ret chainLength(chain(l))

# `instance [ambient]<T> Iface<Pattern> where C` + member funs — anonymous;
# builds the PsInstance marker the fixup expands (parser.py __parse_instance).
fun parseInstance(lr: PLine, ps: Ps): (v: PStmt|PFail, rest: Ps)
  let attrs = parseMaybeAttributes(ps)
  ret match(attrs.v)
    (f: PFail)        => (f, attrs.rest)
    (al: List<PAttr>) => parseInstanceGens(al, lr, attrs.rest)

fun parseInstanceGens(attrs: List<PAttr>, lr: PLine,
                      ps: Ps): (v: PStmt|PFail, rest: Ps)
  let gen = parseMaybeGenerics(ps)
  ret match(gen.v)
    (f: PFail)       => (f, gen.rest)
    (gl: List<PGen>) => parseInstancePattern(attrs, gl, lr, gen.rest)

fun parseInstancePattern(attrs: List<PAttr>, gen: List<PGen>, lr: PLine,
                         ps: Ps): (v: PStmt|PFail, rest: Ps)
  let ty = parseType(ps)
  ret match(ty.v)
    (f: PFail)  => (hardFail("invalid instance statement", ps), ps)
    (t2: Spec)  => parseInstanceWhere(attrs, gen, t2, lr, ty.rest)

fun parseInstanceWhere(attrs: List<PAttr>, gen: List<PGen>, pattern: Spec,
                       lr: PLine, ps: Ps): (v: PStmt|PFail, rest: Ps)
  let w = parseMaybeWhere(ps)
  ret match(w.v)
    (f: PFail)       => (f, w.rest)
    (wl: List<Spec>) => parseInstanceBody(attrs, gen, pattern, wl, lr, w.rest)

fun parseInstanceBody(attrs: List<PAttr>, gen: List<PGen>, pattern: Spec,
                      wl: List<Spec>, lr: PLine,
                      ps: Ps): (v: PStmt|PFail, rest: Ps)
  let b = parseStmts(ps, builder<PStmt>())
  ret match(b.v)
    (f: PFail)          => (f, b.rest)
    (body: List<PStmt>) => (PsInstance(attrs, gen, pattern, wl, body, lr),
                            b.rest)

fun parseClass(lr: PLine, ps: Ps, isInterface: Bool): (v: PStmt|PFail, rest: Ps)
  let attrs = parseMaybeAttributes(ps)
  ret match(attrs.v)
    (f: PFail)        => (f, attrs.rest)
    (al: List<PAttr>) => parseClassNamed(al, isInterface, lr, attrs.rest)

fun parseClassNamed(attrs: List<PAttr>, isInterface: Bool, lr: PLine,
                    ps: Ps): (v: PStmt|PFail, rest: Ps)
  let t = peek(ps)
  if !isIdentTok(t)
    ret (hardFail("invalid class statement", ps), ps)
  let gen = parseMaybeGenerics(bump(ps))
  ret match(gen.v)
    (f: PFail)       => (f, gen.rest)
    (gl: List<PGen>) => parseClassParams(attrs, t.text, gl, isInterface, lr, gen.rest)

fun parseClassParams(attrs: List<PAttr>, name: String, gen: List<PGen>,
                     isInterface: Bool, lr: PLine,
                     ps: Ps): (v: PStmt|PFail, rest: Ps)
  if isInterface || !atSym(ps, "(")
    ret parseClassParents(attrs, name, gen, List<PStmt>(), isInterface, lr, ps)
  let pars = parseParams(ps)
  ret match(pars.v)
    (f: PFail)        => (f, pars.rest)
    (pl: List<PStmt>) => parseClassParents(attrs, name, gen, pl, isInterface, lr, pars.rest)

fun parseClassParents(attrs: List<PAttr>, name: String, gen: List<PGen>,
                      pars: List<PStmt>, isInterface: Bool, lr: PLine,
                      ps: Ps): (v: PStmt|PFail, rest: Ps)
  let ty = parseMaybeColonType(ps)
  ret match(ty.v)
    (f: PFail)              => (f, ty.rest)
    (opt: Spec|None) => parseClassWhere(attrs, name, gen, pars,
                                       parentList(opt), isInterface, lr, ty.rest)

fun parentList(opt: Spec|None): List<Spec>
  ret match(opt)
    (t2: Spec) => whereList(t2)
    ()        => List<Spec>()

fun parseClassWhere(attrs: List<PAttr>, name: String, gen: List<PGen>,
                    pars: List<PStmt>, parents: List<Spec>, isInterface: Bool,
                    lr: PLine, ps: Ps): (v: PStmt|PFail, rest: Ps)
  let w = parseMaybeWhere(ps)
  ret match(w.v)
    (f: PFail)      => (f, w.rest)
    (wl: List<Spec>) => parseClassBody(attrs, name, gen, pars, parents, wl,
                                      isInterface, lr, w.rest)

fun parseClassBody(attrs: List<PAttr>, name: String, gen: List<PGen>,
                   pars: List<PStmt>, parents: List<Spec>, wl: List<Spec>,
                   isInterface: Bool, lr: PLine,
                   ps: Ps): (v: PStmt|PFail, rest: Ps)
  let b = parseStmts(ps, builder<PStmt>())
  ret match(b.v)
    (f: PFail)          => (f, b.rest)
    (body: List<PStmt>) => (PsClass(hashName(name, lr), attrs, gen,
                                    funParamsStmt(pars, lr), parents, wl, body,
                                    isInterface, lr), b.rest)

fun parseEnum(lr: PLine, ps: Ps): (v: PStmt|PFail, rest: Ps)
  let t = peek(ps)
  if !isIdentTok(t)
    ret (hardFail("invalid enum statement", ps), ps)
  let gen = parseMaybeGenerics(bump(ps))
  ret match(gen.v)
    (f: PFail)       => (f, gen.rest)
    (gl: List<PGen>) => parseEnumParams(t.text, gl, lr, gen.rest)

fun parseEnumParams(name: String, gen: List<PGen>, lr: PLine,
                    ps: Ps): (v: PStmt|PFail, rest: Ps)
  if !atSym(ps, "(")
    ret parseEnumVariants(name, gen, false, List<PStmt>(), lr, ps)
  let pars = parseParams(ps)
  ret match(pars.v)
    (f: PFail)        => (f, pars.rest)
    (pl: List<PStmt>) => parseEnumVariants(name, gen, true, pl, lr, pars.rest)

fun parseEnumVariants(name: String, gen: List<PGen>, hasParams: Bool,
                      pars: List<PStmt>, lr: PLine,
                      ps: Ps): (v: PStmt|PFail, rest: Ps)
  let vs = parseVariantList(ps, builder<PStmt>())
  ret match(vs.v)
    (f: PFail)        => (f, vs.rest)
    (vl: List<PStmt>) => (PsEnum(hashName(name, lr), gen,
                                 funParamsStmt(pars, lr), vl, hasParams, lr), vs.rest)

fun [tail] parseVariantList(ps: Ps, acc: ListBuilder<PStmt>): (v: List<PStmt>|PFail, rest: Ps)
  let t = peek(ps)
  if !isSymTok(t, "enum")
    ret (build(acc), ps)
  let inner = Ps(ps.ts, t.line, t.indent, ps.srcFile)
  let v = parseEnum(lineAt(bump(inner)), bump(inner))
  ret match(v.v)
    (f: PFail)  => stmtsFail(acc, f, v.rest)
    (st: PStmt) => !isEof(peek(v.rest))
      ? stmtsFail(acc, hardFail("extra unexpected characters", v.rest), v.rest)
      : parseVariantList(blockExit(v.rest, ps), push(acc, st))

# ══ Top level ════════════════════════════════════════════════════════════════

fun parseProgram(src: String, filename: String): List<PStmt>|PFail
  let toks = tokenize(src)
  let r = parseStmts(Ps(chain(toks), 0, -1, filename), builder<PStmt>())
  ret match(r.v)
    (f: PFail)           => f
    (stmts: List<PStmt>) => fixupProgram(stmts)
