# bootstrap/main.yafl — driver for the self-hosted compiler's pipeline stages.
#
#   ybootstrap tokens < src.yafl    token dump  (KIND|indent|line|col|text)
#   ybootstrap census < src.yafl    declaration census (KIND|line|name)
#
# Each mode reads one source file on stdin and prints a dump that the Python
# test harnesses diff against the reference compiler's own output.
namespace Bootstrap

import System
import System::IO

fun [tail] dumpTokens(ts: Chain<Token>, sb: StringBuilder): StringBuilder
  ret match(ts)
    (nil: ChainEnd) => sb
    (l: ChainLink)  => dumpTokens(l.next,
        append(append(append(append(append(append(append(append(append(
          sb, kindName(l.value.kind)), "|"),
          l.value.indent), "|"),
          l.value.line), "|"),
          l.value.col), "|"),
          l.value.text + "\n"))

fun tokensMode(text: System::String): (out: System::String, code: System::Int)
  ret (toString(dumpTokens(chain(tokenize(text)), StringBuilder())), 0)

# hash6 mode: each stdin line `file|line|col` prints its hash6 — diffed
# against the Python LineRef.hash6 by tests/test_bootstrap_hash6.py.
fun hash6Mode(text: System::String): (out: System::String, code: System::Int)
  ret (hash6Lines(chain(splitLines(text)), StringBuilder())
       |> (sb: StringBuilder) => toString(sb), 0)

fun [tail] hash6Lines(lines: Chain<System::String>, sb: StringBuilder): StringBuilder
  ret match(lines)
    (nil: ChainEnd) => sb
    (l: ChainLink)  => hash6Lines(l.next, hash6Line(l.value, sb))

fun hash6Line(line: System::String, sb: StringBuilder): StringBuilder
  let p1 = System::findByte(line, '|', 0)
  let p2 = p1 < 0 ? -1 : System::findByte(line, '|', p1 + 1)
  if p2 < 0
    ret sb
  let file = System::slice(line, 0, p1)
  let ln = System::parseInt(System::slice(line, p1 + 1, p2))
  let col = System::parseInt(System::slice(line, p2 + 1, System::length(line)))
  ret match(ln)
    (a: System::Int) => match(col)
      (b: System::Int) => append(sb, hash6(file, a, b) + "\n")
      ()               => sb
    ()               => sb

# sha1 mode: each stdin line prints its sha1 hexdigest — diffed against
# hashlib.sha1 by tests/test_bootstrap_sha1.py (irMangle's struct hashing).
fun sha1Mode(text: System::String): (out: System::String, code: System::Int)
  ret (sha1Lines(chain(splitLines(text)), StringBuilder())
       |> (sb: StringBuilder) => toString(sb), 0)

# Empty segments are skipped: splitLines yields a trailing one after the
# final newline, which must not hash.
fun [tail] sha1Lines(lines: Chain<System::String>, sb: StringBuilder): StringBuilder
  ret match(lines)
    (nil: ChainEnd) => sb
    (l: ChainLink)  => sha1Lines(l.next, length(l.value) == 0
                                   ? sb
                                   : append(sb, sha1Hex(l.value) + "\n"))

fun unescMode(text: String): (out: String, code: Int)
  ret (unescDump(chain(splitLines(text)), StringBuilder()) |> (sb) => toString(sb), 0)

fun [tail] unescDump(lines: Chain<String>, sb: StringBuilder): StringBuilder
  ret match(lines)
    (nil: ChainEnd) => sb
    (l: ChainLink)  => unescDump(l.next, unescLine(l.value, sb))

fun unescLine(line: String, sb: StringBuilder): StringBuilder
  let u = unescape(line)
  ret append(append(append(append(append(append(sb, "in="), String(length(line))),
              " out="), String(length(u.uText))), " err=" + u.uErr + " val="), u.uText + "\n")

# specs mode: each stdin line is a spec-algebra case; the answer is printed
# for diffing against the Python typespec (tests/test_bootstrap_specs.py).
#   uid <spec>
#   meet <spec> <spec>
#   unify <names> <spec> <spec>
#   bind <declared-entries> <supplied-names>
fun specsMode(text: String): (out: String, code: Int)
  ret (toString(specLines(chain(splitLines(text)), StringBuilder())), 0)

fun [tail] specLines(lines: Chain<String>, sb: StringBuilder): StringBuilder
  ret match(lines)
    (nil: ChainEnd) => sb
    (l: ChainLink)  => specLines(l.next, specLine(l.value, sb))

fun specLine(line: String, sb: StringBuilder): StringBuilder
  if line == ""
    ret sb
  let sp = findByte(line, ' ', 0)
  if sp < 0
    ret sb
  let op = slice(line, 0, sp)
  let rest = slice(line, sp + 1, length(line))
  ret append(sb, evalCase(op, rest) + "\n")

fun evalCase(op: String, rest: String): String
  if op == "uid"
    ret parseSpecText(rest) |> (r) => uidOf(r)
  if op == "meet"
    ret meetCase(rest)
  if op == "bind"
    ret bindCase(rest)
  ret "?"

fun uidOf(r: Spec|None): String
  ret match(r)
    (s2: Spec) => uid(s2) == "" ? "-" : uid(s2)
    ()         => "!"

fun meetCase(rest: String): String
  let bar = indexOf(rest, " ;; ", 0)
  if bar < 0
    ret "!"
  let a = parseSpecText(slice(rest, 0, bar))
  let b = parseSpecText(slice(rest, bar + 4, length(rest)))
  ret match(a)
    (sa: Spec) => match(b)
      (sb: Spec) => meetResult(meet(sa, sb))
      ()         => "!"
    ()         => "!"

fun meetResult(m: Meet): String
  ret match(m)
    (ms: MSpec)     => uid(ms.mSpec) == "" ? "-" : uid(ms.mSpec)
    (mc: MConflict) => "CONFLICT"
    ()              => "NONE"

fun bindCase(rest: String): String
  let bar = indexOf(rest, " ;; ", 0)
  if bar < 0
    ret "!"
  let decl = parseEntriesText(slice(rest, 0, bar))
  let sup = splitNames(slice(rest, bar + 4, length(rest)))
  ret match(bindTupleEntries(decl, sup))
    (b2: List<Int>) => joinInts(chain(b2), "")
    ()              => "NONE"

fun [tail] joinInts(is: Chain<Int>, acc: String): String
  ret match(is)
    (nil: ChainEnd) => acc == "" ? "()" : acc
    (l: ChainLink)  => joinInts(l.next, acc + (acc == "" ? "" : ",") + String(l.value))

fun splitNames(s: String): List<String>
  ret map(split(s, ","), (n: String) => n == "_" ? "" : n)

# resolve mode: parse the source on stdin, build the statement index, then
# answer the queries that follow a "?" line — `data <name>` / `type <name>` —
# printing `count|scope|uniquename,...` for diffing against pyast/resolver.py.
fun resolveMode(text: String): (out: String, code: Int)
  let cut = indexOf(text, "\n?\n", 0)
  if cut < 0
    ret ("no query section\n", 1)
  let srcPart = slice(text, 0, cut + 1)
  let queries = slice(text, cut + 3, length(text))
  ret match(parseProgram(srcPart, "x"))
    (f: PFail)           => ("parse error\n", 1)
    (stmts: List<PStmt>) => (answerAll(buildStatements(stmts),
                                       chain(splitLines(queries))), 0)

fun answerAll(idx: Statements, qs: Chain<String>): String
  ret toString(answerLoop(idx, qs, StringBuilder()))

fun [tail] answerLoop(idx: Statements, qs: Chain<String>,
                      sb: StringBuilder): StringBuilder
  ret match(qs)
    (nil: ChainEnd) => sb
    (l: ChainLink)  => answerLoop(idx, l.next, answerOne(idx, l.value, sb))

fun answerOne(idx: Statements, q: String, sb: StringBuilder): StringBuilder
  if q == ""
    ret sb
  let sp = findByte(q, ' ', 0)
  if sp < 0
    ret sb
  let kind = slice(q, 0, sp)
  let name = slice(q, sp + 1, length(q))
  let r = RRoot(idx)
  let bag = kind == "type" ? findType(r, name) : findData(r, name)
  ret append(sb, String(bagSize(bag)) + "|" + foundNames(chain(bag.bItems), "") + "\n")

fun [tail] foundNames(fs: Chain<Found>, acc: String): String
  ret match(fs)
    (nil: ChainEnd) => acc
    (l: ChainLink)  => foundNames(l.next,
                                  acc + (acc == "" ? "" : ",") + l.value.fName)

fun convertMode(text: String): (out: String, code: Int)
  let cut = indexOf(text, "\n?\n", 0)
  if cut < 0
    ret ("no query section\n", 1)
  let srcPart = slice(text, 0, cut + 1)
  let cases = slice(text, cut + 3, length(text))
  ret match(parseProgram(srcPart, "x"))
    (f: PFail)           => ("parse error\n", 1)
    (stmts: List<PStmt>) => (convertAll(RRoot(buildStatements(stmts)),
                                        chain(splitLines(cases))), 0)

fun convertAll(r: Resolver, cs: Chain<String>): String
  ret toString(convertLoop(r, cs, StringBuilder()))

fun [tail] convertLoop(r: Resolver, cs: Chain<String>,
                       sb: StringBuilder): StringBuilder
  ret match(cs)
    (nil: ChainEnd) => sb
    (l: ChainLink)  => convertLoop(r, l.next, convertOne(r, l.value, sb))

# `SOURCE ;; TARGET` → Y when representing the source value as the target needs
# a representation change, N when it does not.
fun convertOne(r: Resolver, c: String, sb: StringBuilder): StringBuilder
  if c == ""
    ret sb
  let bar = indexOf(c, " ;; ", 0)
  if bar < 0
    ret sb
  let a = parseSpecText(slice(c, 0, bar))
  let b = parseSpecText(slice(c, bar + 4, length(c)))
  ret append(sb, (needsConversion(r, a, b) ? "Y" : "N") + "\n")

fun assignMode(text: String): (out: String, code: Int)
  let cut = indexOf(text, "\n?\n", 0)
  if cut < 0
    ret ("no query section\n", 1)
  let srcPart = slice(text, 0, cut + 1)
  let cases = slice(text, cut + 3, length(text))
  ret match(parseProgram(srcPart, "x"))
    (f: PFail)           => ("parse error\n", 1)
    (stmts: List<PStmt>) => (assignAll(RRoot(buildStatements(stmts)),
                                       chain(splitLines(cases))), 0)

fun assignAll(r: Resolver, cs: Chain<String>): String
  ret toString(assignLoop(r, cs, StringBuilder()))

fun [tail] assignLoop(r: Resolver, cs: Chain<String>,
                      sb: StringBuilder): StringBuilder
  ret match(cs)
    (nil: ChainEnd) => sb
    (l: ChainLink)  => assignLoop(r, l.next, assignOne(r, l.value, sb))

fun assignOne(r: Resolver, c: String, sb: StringBuilder): StringBuilder
  if c == ""
    ret sb
  let bar = indexOf(c, " ;; ", 0)
  if bar < 0
    ret sb
  let a = parseSpecText(slice(c, 0, bar))
  let b = parseSpecText(slice(c, bar + 4, length(c)))
  ret append(sb, assignAnswer(r, a, b) + "\n")

# The three-valued answer, spelled T / F / ? — `?` is UNDECIDED, and the
# contract cares about it as much as about T and F.
fun assignAnswer(r: Resolver, a: Spec|None, b: Spec|None): String
  ret match(a)
    (sa: Spec) => match(b)
      (sb2: Spec) => triStr(assignableEq(r, sa, sb2))
      ()          => "!"
    ()         => "!"

fun triStr(x: Tri): String
  ret match(x)
    (b: Bool) => b ? "T" : "F"
    ()        => "?"

# converge mode: run the compile fixpoint, then dump the CONVERGED tree. The
# same dump the `ast` mode emits, so the contract is a straight diff against the
# Python compiler's converged AST — the whole of inference, checked at once.
fun convergeMode(text: String): (out: String, code: Int)
  ret match(parseProgram(text, "x"))
    (f: PFail)           => ("parse error at " + String(f.line) + ":" + String(f.col)
                             + ": " + f.msg + "\n", 1)
    (stmts: List<PStmt>) => convergeDump(converge(stmts))

fun convergeDump(c: Converged): (out: String, code: Int)
  ret match(c)
    (ok: CvOk)       => (dumpProgram(ok.cvStatements), 0)
    (d: CvDiverged)  => ("compile loop did not converge — a compile() pass is "
                         + "not idempotent (compiler bug)\n", 2)

# passes mode: just the pass COUNT, so the contract can pin that the port takes
# the same number of iterations to settle as Python does.
fun passesMode(text: String): (out: String, code: Int)
  ret match(parseProgram(text, "x"))
    (f: PFail)           => ("parse error\n", 1)
    (stmts: List<PStmt>) => match(converge(stmts))
      (ok: CvOk)      => (String(ok.cvPasses) + "\n", 0)
      (d: CvDiverged) => ("diverged\n", 2)

# check mode: parse, converge, run the post-convergence diagnostic phases and
# print sorted(set(errors)) — the check contract diffs this byte for byte.
fun checkMode(text: String): (out: String, code: Int)
  ret match(parseProgram(text, "x"))
    (f: PFail)           => ("parse error\n", 1)
    (stmts: List<PStmt>) => match(converge(stmts))
      (ok: CvOk)      => (checkOutput(ok.cvStatements), 0)
      (d: CvDiverged) => ("diverged\n", 2)

# Mirrors the driver order exactly: converge → lambda_globals → drops (ONE
# re-convergence when it inserted) → diagnostics → linearity.
fun checkOutput(stmts0: List<PStmt>): String
  let lowered = lowerLambdaGlobals(stmts0)
  let d0 = insertDrops(lowered, RRoot(buildStatements(lowered)))
  ret match(d0.dsChanged ? converge(d0.dsStmts) : CvOk(d0.dsStmts, 0))
    (ok: CvOk)      => checkedOutput(ok.cvStatements)
    (dv: CvDiverged) => "diverged\n"

fun checkedOutput(stmts: List<PStmt>): String
  let r = RRoot(buildStatements(stmts), collectParamSuggestions(stmts))
  let d = collectDiagnostics(stmts, r)
  if !isEmpty(d.dFails)
    ret printedDiagnostics(d.dFails)
  # Linearity runs only on a clean check phase; its errors return ALONE.
  let lin = checkLinearity(stmts, r)
  ret printedDiagnostics(isEmpty(lin) ? d.dWarns : lin)

# generics mode: the first LOWERING contract. Mirrors the driver order up to
# and including monomorphisation — converge → lambda_globals → drops (ONE
# re-convergence when it inserted) → convert_generic_to_concrete → the
# unresolved-generic-call guard — then dumps the monomorphised tree. Errors
# from either generics phase print as sorted(set(errors)) instead, so the
# polymorphic-recursion messages are pinned by the same contract.
fun genericsMode(text: String): (out: String, code: Int)
  ret match(parseProgram(text, "x"))
    (f: PFail)           => ("parse error\n", 1)
    (stmts: List<PStmt>) => match(converge(stmts))
      (ok: CvOk)      => genericsOutput(ok.cvStatements)
      (d: CvDiverged) => ("diverged\n", 2)

fun genericsOutput(stmts0: List<PStmt>): (out: String, code: Int)
  let lowered = lowerLambdaGlobals(stmts0)
  let d0 = insertDrops(lowered, RRoot(buildStatements(lowered)))
  ret match(d0.dsChanged ? converge(d0.dsStmts) : CvOk(d0.dsStmts, 0))
    (ok: CvOk)       => genericsDump(ok.cvStatements)
    (dv: CvDiverged) => ("diverged\n", 2)

fun genericsDump(stmts: List<PStmt>): (out: String, code: Int)
  let it = convertGenericToConcrete(stmts)
  if !isEmpty(it.giErrs)
    ret (printedDiagnostics(it.giErrs), 0)
  let unresolved = reportUnresolvedGenericCalls(it.giStmts)
  ret isEmpty(unresolved)
    ? (dumpProgram(it.giStmts), 0)
    : (printedDiagnostics(unresolved), 0)

# postmono mode: the generics pipeline, then the post-monomorphisation
# re-convergence (each freshly-instantiated body places its own conversions
# now that its types are concrete), then mark_complex_enums and
# inline_constants — the driver's exact order up to the tail-loop boundary
# (compiler.py:588-590).
# The postmono pipeline as a reusable result, so later stage modes telescope
# on it without repeating the segment.
enum PmRes
  enum PmOk(pmStmts: List<PStmt>)
  enum PmText(pmOut: String, pmCode: Int)

fun postmonoRes(text: String): PmRes
  ret match(parseProgram(text, "x"))
    (fp: PFail)          => PmText("parse error\n", 1)
    (stmts: List<PStmt>) => match(converge(stmts))
      (ok: CvOk)      => postmonoRes2(ok.cvStatements)
      (d: CvDiverged) => PmText("diverged\n", 2)

fun postmonoRes2(stmts0: List<PStmt>): PmRes
  let lowered = lowerLambdaGlobals(stmts0)
  let d0 = insertDrops(lowered, RRoot(buildStatements(lowered)))
  ret match(d0.dsChanged ? converge(d0.dsStmts) : CvOk(d0.dsStmts, 0))
    (ok: CvOk)       => postmonoRes3(ok.cvStatements)
    (dv: CvDiverged) => PmText("diverged\n", 2)

fun postmonoRes3(stmts: List<PStmt>): PmRes
  let it = convertGenericToConcrete(stmts)
  if !isEmpty(it.giErrs)
    ret PmText(printedDiagnostics(it.giErrs), 0)
  let unresolved = reportUnresolvedGenericCalls(it.giStmts)
  if !isEmpty(unresolved)
    ret PmText(printedDiagnostics(unresolved), 0)
  ret match(converge(it.giStmts))
    (ok: CvOk)       => PmOk(inlineConstants(markComplexEnums(
                                               ok.cvStatements)))
    (dv: CvDiverged) => PmText("diverged\n", 2)

fun postmonoMode(text: String): (out: String, code: Int)
  ret match(postmonoRes(text))
    (ok: PmOk)   => (dumpProgram(ok.pmStmts), 0)
    (tx: PmText) => (tx.pmOut, tx.pmCode)

# tail mode: postmono, then lambda_lift → hoist_nested → tail_loop — the
# driver's exact order (compiler.py:602-611). Tail errors print as
# sorted(set(errors)).
fun tailMode(text: String): (out: String, code: Int)
  ret match(postmonoRes(text))
    (ok: PmOk)   => tailStageDump(ok.pmStmts)
    (tx: PmText) => (tx.pmOut, tx.pmCode)

fun tailStageDump(stmts: List<PStmt>): (out: String, code: Int)
  let tl = lowerTailLoops(hoistNestedFunctions(liftCapturedCalls(stmts)))
  ret isEmpty(tl.tlErrs)
    ? (dumpProgram(tl.tlStmts), 0)
    : (printedDiagnostics(tl.tlErrs), 0)

# inline mode: the tail pipeline, then the AST inliner to fixpoint — the
# driver's compiler.py:612 (optimisation level does not affect this pass;
# the contract pins -O1, the bootstrap's own build level).
fun inlineMode(text: String): (out: String, code: Int)
  ret match(postmonoRes(text))
    (ok: PmOk)   => inlineStageDump(ok.pmStmts)
    (tx: PmText) => (tx.pmOut, tx.pmCode)

fun inlineStageDump(stmts: List<PStmt>): (out: String, code: Int)
  let tl = lowerTailLoops(hoistNestedFunctions(liftCapturedCalls(stmts)))
  ret isEmpty(tl.tlErrs)
    ? (dumpProgram(inlineAst(tl.tlStmts)), 0)
    : (printedDiagnostics(tl.tlErrs), 0)

# literals mode: inline, then string and bigint literal hoisting — the
# driver's compiler.py:613-614.
fun literalsMode(text: String): (out: String, code: Int)
  ret match(postmonoRes(text))
    (ok: PmOk)   => literalsStageDump(ok.pmStmts)
    (tx: PmText) => (tx.pmOut, tx.pmCode)

fun literalsStageDump(stmts: List<PStmt>): (out: String, code: Int)
  let tl = lowerTailLoops(hoistNestedFunctions(liftCapturedCalls(stmts)))
  ret isEmpty(tl.tlErrs)
    ? (dumpProgram(fixGlobalIntegers(fixGlobalStrings(
                     inlineAst(tl.tlStmts)))), 0)
    : (printedDiagnostics(tl.tlErrs), 0)

# lazy mode: literals, then the [lazy] forward-ref check (errors print
# sorted) and the deferred-init lowering — driver compiler.py:618-624.
fun lazyMode(text: String): (out: String, code: Int)
  ret match(postmonoRes(text))
    (ok: PmOk)   => lazyStageDump(ok.pmStmts)
    (tx: PmText) => (tx.pmOut, tx.pmCode)

fun lazyStageDump(stmts: List<PStmt>): (out: String, code: Int)
  let tl = lowerTailLoops(hoistNestedFunctions(liftCapturedCalls(stmts)))
  if !isEmpty(tl.tlErrs)
    ret (printedDiagnostics(tl.tlErrs), 0)
  let lowered = fixGlobalIntegers(fixGlobalStrings(inlineAst(tl.tlStmts)))
  let fwd = checkLazyForwardRefs(lowered)
  ret isEmpty(fwd)
    ? (dumpProgram(lowerLazyLets(lowered)), 0)
    : (printedDiagnostics(fwd), 0)

# lambdas mode: lazy, then closure conversion — every LambdaExpression
# becomes a top-level function (or a [final] closure class + constructor call
# when it captures) — driver compiler.py:625.
fun lambdasMode(text: String): (out: String, code: Int)
  ret match(postmonoRes(text))
    (ok: PmOk)   => lambdasStageDump(ok.pmStmts)
    (tx: PmText) => (tx.pmOut, tx.pmCode)

fun lambdasStageDump(stmts: List<PStmt>): (out: String, code: Int)
  let tl = lowerTailLoops(hoistNestedFunctions(liftCapturedCalls(stmts)))
  if !isEmpty(tl.tlErrs)
    ret (printedDiagnostics(tl.tlErrs), 0)
  let lowered = fixGlobalIntegers(fixGlobalStrings(inlineAst(tl.tlStmts)))
  let fwd = checkLazyForwardRefs(lowered)
  ret isEmpty(fwd)
    ? (dumpProgram(convertLambdasToFunctions(lowerLazyLets(lowered))), 0)
    : (printedDiagnostics(fwd), 0)

# simple mode: lambdas, then flat-struct lowering — qualifying classes become
# bare tuples + free functions — driver compiler.py:626.
fun simpleMode(text: String): (out: String, code: Int)
  ret match(postmonoRes(text))
    (ok: PmOk)   => simpleStageDump(ok.pmStmts)
    (tx: PmText) => (tx.pmOut, tx.pmCode)

fun simpleStageDump(stmts: List<PStmt>): (out: String, code: Int)
  let tl = lowerTailLoops(hoistNestedFunctions(liftCapturedCalls(stmts)))
  if !isEmpty(tl.tlErrs)
    ret (printedDiagnostics(tl.tlErrs), 0)
  let lowered = fixGlobalIntegers(fixGlobalStrings(inlineAst(tl.tlStmts)))
  let fwd = checkLazyForwardRefs(lowered)
  ret isEmpty(fwd)
    ? (dumpProgram(lowerSimpleClasses(convertLambdasToFunctions(lowerLazyLets(lowered)))), 0)
    : (printedDiagnostics(fwd), 0)

fun exitsMode(text: String): (out: String, code: Int)
  ret match(postmonoRes(text))
    (ok: PmOk)   => exitsStageDump(ok.pmStmts)
    (tx: PmText) => (tx.pmOut, tx.pmCode)

fun exitsStageDump(stmts: List<PStmt>): (out: String, code: Int)
  let tl = lowerTailLoops(hoistNestedFunctions(liftCapturedCalls(stmts)))
  if !isEmpty(tl.tlErrs)
    ret (printedDiagnostics(tl.tlErrs), 0)
  let lowered = fixGlobalIntegers(fixGlobalStrings(inlineAst(tl.tlStmts)))
  let fwd = checkLazyForwardRefs(lowered)
  ret isEmpty(fwd)
    ? (dumpProgram(assignBlockExits(lowerSimpleClasses(convertLambdasToFunctions(lowerLazyLets(lowered))))), 0)
    : (printedDiagnostics(fwd), 0)

# `c` mode: the full -O0 pipeline to C text — the byte contract diffs it
# against Python __create_c_code output (PYTHONHASHSEED=0) per corpus file.
# stdin may be a MULTI-FILE stream — each part preceded by a `#FILE# <name>`
# line — so the contract compiles stdlib + target as a whole program; a
# stream without markers is a single file named "x" (the stage convention).
fun cMode(text: String, optLevel: Int): (out: String, code: Int)
  ret match(parseMulti(text))
    (stmts: List<PStmt>) => match(convergeToPostmono(stmts))
      (ok: PmOk)   => cStage(ok.pmStmts, optLevel)
      (tx: PmText) => (tx.pmOut, tx.pmCode)
    ()                    => ("parse error\n", 1)

fun convergeToPostmono(stmts: List<PStmt>): PmRes
  ret match(converge(stmts))
    (ok: CvOk)      => postmonoRes2(ok.cvStatements)
    (d: CvDiverged) => PmText("diverged\n", 2)

fun parseMulti(text: String): List<PStmt>|None
  if !startsWith(text, "#FILE# ")
    ret parseSingle(text)
  ret parseParts(text, 0, List<PStmt>())

fun parseSingle(text: String): List<PStmt>|None
  ret match(parseProgram(text, "x"))
    (fp: PFail)          => None
    (stmts: List<PStmt>) => stmts

# Each part: `#FILE# <name>\n` then content up to the next marker (markers
# sit at line starts — search for `\n#FILE# `).
fun [tail] parseParts(text: String, at: Int, acc: List<PStmt>): List<PStmt>|None
  let nameEnd = findByte(text, '\n', at + 7)
  if nameEnd < 0
    ret acc
  let name = slice(text, at + 7, nameEnd)
  let nextMark = indexOf(text, "\n#FILE# ", nameEnd)
  let contentEnd = nextMark < 0 ? length(text) : nextMark + 1
  ret match(parseProgram(slice(text, nameEnd + 1, contentEnd), name))
    (fp: PFail)          => None
    (stmts: List<PStmt>) => nextMark < 0
      ? concat(acc, stmts)
      : parseParts(text, nextMark + 1, concat(acc, stmts))

fun cStage(stmts: List<PStmt>, optLevel: Int): (out: String, code: Int)
  let tl = lowerTailLoops(hoistNestedFunctions(liftCapturedCalls(stmts)))
  if !isEmpty(tl.tlErrs)
    ret (printedDiagnostics(tl.tlErrs), 1)
  let lowered = fixGlobalIntegers(fixGlobalStrings(inlineAst(tl.tlStmts)))
  let fwd = checkLazyForwardRefs(lowered)
  if !isEmpty(fwd)
    ret (printedDiagnostics(fwd), 1)
  let low1 = lowerLazyLets(lowered)
  let low2 = convertLambdasToFunctions(low1)
  let low3 = lowerSimpleClasses(low2)
  let final2 = assignBlockExits(low3)
  ret match(cFindMain(chain(final2)))
    (nm: System::String) => cEmit(final2, nm, optLevel)
    ()                    => ("No main function found\n", 1)

# __is_main_function: the name must contain a NAMESPACED "::main@" (a bare
# `main` in no namespace is not a main), the return type must be the bigint
# builtin, and the parameter tuple must be empty.
fun [tail] cFindMain(ss: Chain<PStmt>): System::String|None
  ret match(ss)
    (nil: ChainEnd) => None
    (l: ChainLink)  => match(l.value)
      (f: PsFun) => cIsMainFunction(f) ? f.fName : cFindMain(l.next)
      (o: PStmt) => cFindMain(l.next)

fun cIsMainFunction(f: PsFun): Bool
  if !contains(f.fName, "::main@")
    ret false
  if !cIsBigintRet(f.fRet)
    ret false
  ret match(paramsTupleOf(f.fParams))
    (tp: STuple) => isEmpty(tp.stEntries)
    (o: Spec)    => false

fun cIsBigintRet(ret2: Spec|None): Bool
  ret match(ret2)
    (sp: Spec) => match(sp)
      (b: SBuiltin) => b.sbName == "bigint"
      (o: Spec)     => false
    ()          => false

fun cEmit(stmts: List<PStmt>, mainName: System::String,
          optLevel: Int): (out: String, code: Int)
  let out = createCCode(stmts, mainName, optLevel,
                        append(List<System::String>(), "yafl.h"))
  ret isEmpty(out.ccErrors)
    ? (out.ccText, 0)
    : (join(out.ccErrors, "\n") + "\n", 1)

fun astMode(text: String): (out: String, code: Int)
  ret match(parseProgram(text, "x"))
    (f: PFail)           => ("parse error at " + String(f.line) + ":" + String(f.col)
                             + ": " + f.msg + "\n", 1)
    (stmts: List<PStmt>) => (dumpProgram(stmts), 0)

# `eq`: the N×N structural-equality matrix over the file's top-level
# statements, one row per line. Python's dataclass `__eq__` must produce the
# same matrix — a field the port forgot to compare shows up as a 1 where
# Python says 0.
fun eqMode(text: String): (out: String, code: Int)
  ret match(parseProgram(text, "x"))
    (f: PFail)           => ("parse error at " + String(f.line) + ":" + String(f.col)
                             + ": " + f.msg + "\n", 1)
    (stmts: List<PStmt>) => (eqMatrix(stmts), 0)

fun eqMatrix(stmts: List<PStmt>): String
  ret toString(eqRows(stmts, chain(stmts), StringBuilder()))

fun [tail] eqRows(all: List<PStmt>, rows: Chain<PStmt>,
                  sb: StringBuilder): StringBuilder
  ret match(rows)
    (nil: ChainEnd) => sb
    (l: ChainLink)  => eqRows(all, l.next,
                              append(eqRow(l.value, chain(all), sb), "\n"))

fun [tail] eqRow(row: PStmt, cols: Chain<PStmt>,
                 sb: StringBuilder): StringBuilder
  ret match(cols)
    (nil: ChainEnd) => sb
    (l: ChainLink)  => eqRow(row, l.next,
                             append(sb, eqStmt(row, l.value) ? "1" : "0"))

fun modeOf(argv: List<System::String>): System::String
  ret match(head(argv))
    (m: System::String) => m
    ()                  => "census"

fun run(text: System::String, i: IO): System::Int
  let mode = modeOf(args())
  let r = mode == "tokens" ? tokensMode(text)
        : mode == "hash6" ? hash6Mode(text)
        : mode == "sha1" ? sha1Mode(text)
        : mode == "unesc" ? unescMode(text)
        : mode == "specs" ? specsMode(text)
        : mode == "resolve" ? resolveMode(text)
        : mode == "eq" ? eqMode(text)
        : mode == "assign" ? assignMode(text)
        : mode == "convert" ? convertMode(text)
        : mode == "converge" ? convergeMode(text)
        : mode == "passes" ? passesMode(text)
        : mode == "check" ? checkMode(text)
        : mode == "generics" ? genericsMode(text)
        : mode == "postmono" ? postmonoMode(text)
        : mode == "tail" ? tailMode(text)
        : mode == "inline" ? inlineMode(text)
        : mode == "literals" ? literalsMode(text)
        : mode == "lazy" ? lazyMode(text)
        : mode == "lambdas" ? lambdasMode(text)
        : mode == "simple" ? simpleMode(text)
        : mode == "exits" ? exitsMode(text)
        : mode == "c" ? cMode(text, 0)
        : mode == "c1" ? cMode(text, 1)
        : astMode(text)
  let w = writeAll(stdout(), r.out)
  let code = w.v is IOError ? 1 : r.code
  ret (w.io.close(), i.close(), code) |> (c1, c2, result) => result

fun main(): System::Int
  ret stdin().asStream()
    |> (i, s) => (System::collect(s), i)
    |> (src, i) => match(src)
      (text: System::String) => run(text, i)
      (e: IOError) => (i.close(), 1) |> (c, code) => code
