# bootstrap/main.yafl — driver for the self-hosted compiler's pipeline stages.
#
#   ybootstrap tokens < src.yafl    token dump  (KIND|indent|line|col|text)
#   ybootstrap census < src.yafl    declaration census (KIND|line|name)
#
# Each mode reads one source file on stdin and prints a dump that the Python
# test harnesses diff against the reference compiler's own output.
namespace Bootstrap

import System
import System::IO

fun [tail] dumpTokens(ts: Chain<Token>, sb: StringBuilder): StringBuilder
  ret match(ts)
    (nil: ChainEnd) => sb
    (l: ChainLink)  => dumpTokens(l.next,
        append(append(append(append(append(append(append(append(append(
          sb, kindName(l.value.kind)), "|"),
          l.value.indent), "|"),
          l.value.line), "|"),
          l.value.col), "|"),
          l.value.text + "\n"))

fun tokensMode(text: System::String): (out: System::String, code: System::Int)
  ret (toString(dumpTokens(chain(tokenize(text)), StringBuilder())), 0)

# hash6 mode: each stdin line `file|line|col` prints its hash6 — diffed
# against the Python LineRef.hash6 by tests/test_bootstrap_hash6.py.
fun hash6Mode(text: System::String): (out: System::String, code: System::Int)
  ret (hash6Lines(chain(splitLines(text)), StringBuilder())
       |> (sb: StringBuilder) => toString(sb), 0)

fun [tail] hash6Lines(lines: Chain<System::String>, sb: StringBuilder): StringBuilder
  ret match(lines)
    (nil: ChainEnd) => sb
    (l: ChainLink)  => hash6Lines(l.next, hash6Line(l.value, sb))

fun hash6Line(line: System::String, sb: StringBuilder): StringBuilder
  let p1 = System::findByte(line, '|', 0)
  let p2 = p1 < 0 ? -1 : System::findByte(line, '|', p1 + 1)
  if p2 < 0
    ret sb
  let file = System::slice(line, 0, p1)
  let ln = System::parseInt(System::slice(line, p1 + 1, p2))
  let col = System::parseInt(System::slice(line, p2 + 1, System::length(line)))
  ret match(ln)
    (a: System::Int) => match(col)
      (b: System::Int) => append(sb, hash6(file, a, b) + "\n")
      ()               => sb
    ()               => sb

fun unescMode(text: String): (out: String, code: Int)
  ret (unescDump(chain(splitLines(text)), StringBuilder()) |> (sb) => toString(sb), 0)

fun [tail] unescDump(lines: Chain<String>, sb: StringBuilder): StringBuilder
  ret match(lines)
    (nil: ChainEnd) => sb
    (l: ChainLink)  => unescDump(l.next, unescLine(l.value, sb))

fun unescLine(line: String, sb: StringBuilder): StringBuilder
  let u = unescape(line)
  ret append(append(append(append(append(append(sb, "in="), String(length(line))),
              " out="), String(length(u.uText))), " err=" + u.uErr + " val="), u.uText + "\n")

# specs mode: each stdin line is a spec-algebra case; the answer is printed
# for diffing against the Python typespec (tests/test_bootstrap_specs.py).
#   uid <spec>
#   meet <spec> <spec>
#   unify <names> <spec> <spec>
#   bind <declared-entries> <supplied-names>
fun specsMode(text: String): (out: String, code: Int)
  ret (toString(specLines(chain(splitLines(text)), StringBuilder())), 0)

fun [tail] specLines(lines: Chain<String>, sb: StringBuilder): StringBuilder
  ret match(lines)
    (nil: ChainEnd) => sb
    (l: ChainLink)  => specLines(l.next, specLine(l.value, sb))

fun specLine(line: String, sb: StringBuilder): StringBuilder
  if line == ""
    ret sb
  let sp = findByte(line, ' ', 0)
  if sp < 0
    ret sb
  let op = slice(line, 0, sp)
  let rest = slice(line, sp + 1, length(line))
  ret append(sb, evalCase(op, rest) + "\n")

fun evalCase(op: String, rest: String): String
  if op == "uid"
    ret parseSpecText(rest) |> (r) => uidOf(r)
  if op == "meet"
    ret meetCase(rest)
  if op == "bind"
    ret bindCase(rest)
  ret "?"

fun uidOf(r: Spec|None): String
  ret match(r)
    (s2: Spec) => uid(s2) == "" ? "-" : uid(s2)
    ()         => "!"

fun meetCase(rest: String): String
  let bar = indexOf(rest, " ;; ", 0)
  if bar < 0
    ret "!"
  let a = parseSpecText(slice(rest, 0, bar))
  let b = parseSpecText(slice(rest, bar + 4, length(rest)))
  ret match(a)
    (sa: Spec) => match(b)
      (sb: Spec) => meetResult(meet(sa, sb))
      ()         => "!"
    ()         => "!"

fun meetResult(m: Meet): String
  ret match(m)
    (ms: MSpec)     => uid(ms.mSpec) == "" ? "-" : uid(ms.mSpec)
    (mc: MConflict) => "CONFLICT"
    ()              => "NONE"

fun bindCase(rest: String): String
  let bar = indexOf(rest, " ;; ", 0)
  if bar < 0
    ret "!"
  let decl = parseEntriesText(slice(rest, 0, bar))
  let sup = splitNames(slice(rest, bar + 4, length(rest)))
  ret match(bindTupleEntries(decl, sup))
    (b2: List<Int>) => joinInts(chain(b2), "")
    ()              => "NONE"

fun [tail] joinInts(is: Chain<Int>, acc: String): String
  ret match(is)
    (nil: ChainEnd) => acc == "" ? "()" : acc
    (l: ChainLink)  => joinInts(l.next, acc + (acc == "" ? "" : ",") + String(l.value))

fun splitNames(s: String): List<String>
  ret map(split(s, ","), (n: String) => n == "_" ? "" : n)

# resolve mode: parse the source on stdin, build the statement index, then
# answer the queries that follow a "?" line — `data <name>` / `type <name>` —
# printing `count|scope|uniquename,...` for diffing against pyast/resolver.py.
fun resolveMode(text: String): (out: String, code: Int)
  let cut = indexOf(text, "\n?\n", 0)
  if cut < 0
    ret ("no query section\n", 1)
  let srcPart = slice(text, 0, cut + 1)
  let queries = slice(text, cut + 3, length(text))
  ret match(parseProgram(srcPart, "x"))
    (f: PFail)           => ("parse error\n", 1)
    (stmts: List<PStmt>) => (answerAll(buildStatements(stmts),
                                       chain(splitLines(queries))), 0)

fun answerAll(idx: Statements, qs: Chain<String>): String
  ret toString(answerLoop(idx, qs, StringBuilder()))

fun [tail] answerLoop(idx: Statements, qs: Chain<String>,
                      sb: StringBuilder): StringBuilder
  ret match(qs)
    (nil: ChainEnd) => sb
    (l: ChainLink)  => answerLoop(idx, l.next, answerOne(idx, l.value, sb))

fun answerOne(idx: Statements, q: String, sb: StringBuilder): StringBuilder
  if q == ""
    ret sb
  let sp = findByte(q, ' ', 0)
  if sp < 0
    ret sb
  let kind = slice(q, 0, sp)
  let name = slice(q, sp + 1, length(q))
  let r = RRoot(idx)
  let bag = kind == "type" ? findType(r, name) : findData(r, name)
  ret append(sb, String(bagSize(bag)) + "|" + foundNames(chain(bag.bItems), "") + "\n")

fun [tail] foundNames(fs: Chain<Found>, acc: String): String
  ret match(fs)
    (nil: ChainEnd) => acc
    (l: ChainLink)  => foundNames(l.next,
                                  acc + (acc == "" ? "" : ",") + l.value.fName)

fun convertMode(text: String): (out: String, code: Int)
  let cut = indexOf(text, "\n?\n", 0)
  if cut < 0
    ret ("no query section\n", 1)
  let srcPart = slice(text, 0, cut + 1)
  let cases = slice(text, cut + 3, length(text))
  ret match(parseProgram(srcPart, "x"))
    (f: PFail)           => ("parse error\n", 1)
    (stmts: List<PStmt>) => (convertAll(RRoot(buildStatements(stmts)),
                                        chain(splitLines(cases))), 0)

fun convertAll(r: Resolver, cs: Chain<String>): String
  ret toString(convertLoop(r, cs, StringBuilder()))

fun [tail] convertLoop(r: Resolver, cs: Chain<String>,
                       sb: StringBuilder): StringBuilder
  ret match(cs)
    (nil: ChainEnd) => sb
    (l: ChainLink)  => convertLoop(r, l.next, convertOne(r, l.value, sb))

# `SOURCE ;; TARGET` → Y when representing the source value as the target needs
# a representation change, N when it does not.
fun convertOne(r: Resolver, c: String, sb: StringBuilder): StringBuilder
  if c == ""
    ret sb
  let bar = indexOf(c, " ;; ", 0)
  if bar < 0
    ret sb
  let a = parseSpecText(slice(c, 0, bar))
  let b = parseSpecText(slice(c, bar + 4, length(c)))
  ret append(sb, (needsConversion(r, a, b) ? "Y" : "N") + "\n")

fun assignMode(text: String): (out: String, code: Int)
  let cut = indexOf(text, "\n?\n", 0)
  if cut < 0
    ret ("no query section\n", 1)
  let srcPart = slice(text, 0, cut + 1)
  let cases = slice(text, cut + 3, length(text))
  ret match(parseProgram(srcPart, "x"))
    (f: PFail)           => ("parse error\n", 1)
    (stmts: List<PStmt>) => (assignAll(RRoot(buildStatements(stmts)),
                                       chain(splitLines(cases))), 0)

fun assignAll(r: Resolver, cs: Chain<String>): String
  ret toString(assignLoop(r, cs, StringBuilder()))

fun [tail] assignLoop(r: Resolver, cs: Chain<String>,
                      sb: StringBuilder): StringBuilder
  ret match(cs)
    (nil: ChainEnd) => sb
    (l: ChainLink)  => assignLoop(r, l.next, assignOne(r, l.value, sb))

fun assignOne(r: Resolver, c: String, sb: StringBuilder): StringBuilder
  if c == ""
    ret sb
  let bar = indexOf(c, " ;; ", 0)
  if bar < 0
    ret sb
  let a = parseSpecText(slice(c, 0, bar))
  let b = parseSpecText(slice(c, bar + 4, length(c)))
  ret append(sb, assignAnswer(r, a, b) + "\n")

# The three-valued answer, spelled T / F / ? — `?` is UNDECIDED, and the
# contract cares about it as much as about T and F.
fun assignAnswer(r: Resolver, a: Spec|None, b: Spec|None): String
  ret match(a)
    (sa: Spec) => match(b)
      (sb2: Spec) => triStr(assignableEq(r, sa, sb2))
      ()          => "!"
    ()         => "!"

fun triStr(x: Tri): String
  ret match(x)
    (b: Bool) => b ? "T" : "F"
    ()        => "?"

# converge mode: run the compile fixpoint, then dump the CONVERGED tree. The
# same dump the `ast` mode emits, so the contract is a straight diff against the
# Python compiler's converged AST — the whole of inference, checked at once.
fun convergeMode(text: String): (out: String, code: Int)
  ret match(parseProgram(text, "x"))
    (f: PFail)           => ("parse error at " + String(f.line) + ":" + String(f.col)
                             + ": " + f.msg + "\n", 1)
    (stmts: List<PStmt>) => convergeDump(converge(stmts))

fun convergeDump(c: Converged): (out: String, code: Int)
  ret match(c)
    (ok: CvOk)       => (dumpProgram(ok.cvStatements), 0)
    (d: CvDiverged)  => ("compile loop did not converge — a compile() pass is "
                         + "not idempotent (compiler bug)\n", 2)

# passes mode: just the pass COUNT, so the contract can pin that the port takes
# the same number of iterations to settle as Python does.
fun passesMode(text: String): (out: String, code: Int)
  ret match(parseProgram(text, "x"))
    (f: PFail)           => ("parse error\n", 1)
    (stmts: List<PStmt>) => match(converge(stmts))
      (ok: CvOk)      => (String(ok.cvPasses) + "\n", 0)
      (d: CvDiverged) => ("diverged\n", 2)

fun astMode(text: String): (out: String, code: Int)
  ret match(parseProgram(text, "x"))
    (f: PFail)           => ("parse error at " + String(f.line) + ":" + String(f.col)
                             + ": " + f.msg + "\n", 1)
    (stmts: List<PStmt>) => (dumpProgram(stmts), 0)

# `eq`: the N×N structural-equality matrix over the file's top-level
# statements, one row per line. Python's dataclass `__eq__` must produce the
# same matrix — a field the port forgot to compare shows up as a 1 where
# Python says 0.
fun eqMode(text: String): (out: String, code: Int)
  ret match(parseProgram(text, "x"))
    (f: PFail)           => ("parse error at " + String(f.line) + ":" + String(f.col)
                             + ": " + f.msg + "\n", 1)
    (stmts: List<PStmt>) => (eqMatrix(stmts), 0)

fun eqMatrix(stmts: List<PStmt>): String
  ret toString(eqRows(stmts, chain(stmts), StringBuilder()))

fun [tail] eqRows(all: List<PStmt>, rows: Chain<PStmt>,
                  sb: StringBuilder): StringBuilder
  ret match(rows)
    (nil: ChainEnd) => sb
    (l: ChainLink)  => eqRows(all, l.next,
                              append(eqRow(l.value, chain(all), sb), "\n"))

fun [tail] eqRow(row: PStmt, cols: Chain<PStmt>,
                 sb: StringBuilder): StringBuilder
  ret match(cols)
    (nil: ChainEnd) => sb
    (l: ChainLink)  => eqRow(row, l.next,
                             append(sb, eqStmt(row, l.value) ? "1" : "0"))

fun modeOf(argv: List<System::String>): System::String
  ret match(head(argv))
    (m: System::String) => m
    ()                  => "census"

fun run(text: System::String, i: IO): System::Int
  let mode = modeOf(args())
  let r = mode == "tokens" ? tokensMode(text)
        : mode == "hash6" ? hash6Mode(text)
        : mode == "unesc" ? unescMode(text)
        : mode == "specs" ? specsMode(text)
        : mode == "resolve" ? resolveMode(text)
        : mode == "eq" ? eqMode(text)
        : mode == "assign" ? assignMode(text)
        : mode == "convert" ? convertMode(text)
        : mode == "converge" ? convergeMode(text)
        : mode == "passes" ? passesMode(text)
        : astMode(text)
  let w = writeAll(stdout(), r.out)
  let code = w.v is IOError ? 1 : r.code
  ret (w.io.close(), i.close(), code) |> (c1, c2, result) => result

fun main(): System::Int
  ret stdin().asStream()
    |> (i, s) => (System::collect(s), i)
    |> (src, i) => match(src)
      (text: System::String) => run(text, i)
      (e: IOError) => (i.close(), 1) |> (c, code) => code
