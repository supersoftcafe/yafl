# bootstrap/check_expr.yafl — Expression.check per kind, ported from the
# check() methods in compiler/pyast/expression/. Message strings VERBATIM.
#
# LAYOUT: each node kind's own check lives with the rest of that node in
# bootstrap/nodes/ (one file per kind, as pyast/); this file keeps the
# helpers several node kinds share.
namespace Bootstrap::Frontend

import System
import System::Containers

import Bootstrap::Ast
import Bootstrap::Parse
import Bootstrap::Resolve
import Bootstrap::StdlibCandidates
import Bootstrap::Types
import Bootstrap::Nodes


# ── NamedExpression ─────────────────────────────────────────────────────────
# Duplicate-route resolutions of one statement are ONE candidate here (only in
# check — compile/get_type keep the raw multiplicity as an unresolved signal).

fun dedupeStrs(ss: List<String>) => ddsLoop(ss, List())

fun ddsLoop(ss: List<String>, acc: List<String>) =>
  fold(ss, acc, addNameOnce)

# ── DotExpression ───────────────────────────────────────────────────────────

fun checkDot(d: PeDot, r) => match(exprType(d.base, r))
  (t2: STuple) => tupleFieldExists(t2.stEntries, d.member)
    ? noErrs()
    : oneErr(d.pedLine, "Could not find field " + d.member)
  (c2: SClass) => checkClassDot(d, c2, r)
  (e2: SEnum)  => checkEnumDot(d, e2, r)
  ()           => noErrs()

fun tupleFieldExists(es: List<SEntry>, name: String) => any(es, (x) => x.seName == name)

fun checkClassDot(d: PeDot, c2: SClass, r) => match(soleItem(findType(r, c2.scName)))
  (f: Found) => match(f.fStmt)
    (cs: PsClass) => classDotErrs(d, classFindData(cs, r, d.member))
    (o: PStmt)    => noErrs()
  ()         => noErrs()

fun classDotErrs(d: PeDot, datas: List<Found>)
  if isEmpty(datas)
    ret oneErr(d.pedLine, "Could not find a field named " + d.member)
  if sizeAtLeast(datas, 2)
    ret oneErr(d.pedLine, "Ambiguous reference to field named " + d.member)
  ret noErrs()

fun checkEnumDot(d: PeDot, e2: SEnum, r)
  ret match(enumMember(r, e2, d.member))
    (h: NfHit)        => noErrs()
    (a2: NfAmbiguous) => oneErr(d.pedLine, "Ambiguous reference to field named " + d.member)
    (m: NfMiss)       => oneErr(d.pedLine, "Could not find field " + d.member)

# ── CallExpression ──────────────────────────────────────────────────────────
# The argument tuple checks against the RESOLVED parameter shape; sub-errors
# short-circuit the call's own diagnostics — EXCEPT when the only sub-error is
# the callee failing to narrow to one callable. The name on its own can say no
# more than "Ambiguous — qualify it", which tells the author to disambiguate;
# when NO overload accepts what they passed, qualifying is impossible and that
# message sends them the wrong way. This node knows the argument types, so it
# reports which arguments failed and what the candidates take. Only when
# nothing accepts them: two candidates that both fit ARE ambiguous.

# _type_str: a source-shaped rendering for diagnostics — never the internal
# spec name.
fun typeStr(ts: Spec|None) => match(ts)
  (t2: Spec) => typeStrOf(t2)
  ()         => "unknown"

fun typeStr2(ts) => typeStrOf(ts)

fun typeStrOf(t2) => match(t2)
  (b: SBuiltin)      => builtinStr(b.sbName)
  (n: SNamed)        => specName(n.snName, n.snParams)
  (tp: STuple)       => "(" + joinTypeStrs(tp.stEntries, "") + ")"
  (cm: SCombination) => joinMemberStrs(cm.scTypes, "")
  (cl: SCallable)    => typeStr(cl.scParams2) + ": " + typeStr(cl.scResult)
  (c: SClass)        => specName(c.scName, c.scParams)
  (g2: SGeneric)     => bareOfUnique(g2.sgName)
  # Without the root name an enum rendered as the literal "EnumSpec" — the
  # internal class name these strings exist to avoid. List, Option and
  # Result are all enums, so it was the common case.
  (e2: SEnum)        => specName(e2.seRoot, e2.seParams)
  (af: SArrayField)  => "ArrayFieldSpec"
  (ls: SLazyStub)    => "LazyStubSpec"

# A declared type's name as the author would write it: no namespace, no
# unique-name hash, and a monomorphised specialisation shown with its argument
# list rather than the `$generic$` mangling it carries internally.
fun specName(name, params: List<Spec>)
  let bare = bareOfUnique(name)
  let gi = find(bare, "$generic$")
  let head2 = beforeHash(gi < 0 ? bare : slice(bare, 0, gi))
  let args = isEmpty(params)
    ? (gi < 0 ? "" : joinMangledArgs(split(slice(bare, gi + 9,
                                                       length(bare)), "_"), ""))
    : joinArgStrs(params, "")
  ret args == "" ? head2 : head2 + "<" + args + ">"

fun beforeHash(s2) => find(s2, "@") < 0 ? s2 : slice(s2, 0, find(s2, "@"))

fun joinArgStrs(ps: List<Spec>, acc) =>
  fold(ps, acc, (a, x) => a == "" ? typeStrOf(x) : a + ", " + typeStrOf(x))

fun joinMangledArgs(as2: List<String>, acc) =>
  fold(as2, acc, (a, x) => x == ""
    ? a
    : (a == ""
                        ? builtinStr(beforeHash(x))
                        : a + ", " + builtinStr(beforeHash(x))))

fun builtinStr(name) => name == "bigint" ? "Int"
  : name == "int8" ? "Int8"
  : name == "int16" ? "Int16"
  : name == "int32" ? "Int32"
  : name == "int64" ? "Int64"
  : name == "float32" ? "Float32"
  : name == "float64" ? "Float64"
  : name == "bool" ? "Bool"
  : name == "str" ? "String"
  : name

fun joinTypeStrs(es: List<SEntry>, acc) =>
  fold(es, acc, (a, x) => a == "" ? typeStr(x.seType) : a + ", " + typeStr(x.seType))

fun joinMemberStrs(ms: List<Spec>, acc) =>
  fold(ms, acc, (a, x) => a == "" ? typeStrOf(x) : a + " | " + typeStrOf(x))

# ── the rest ────────────────────────────────────────────────────────────────

# Declaration order, which is the order the shadowing check reports in.
fun bindingLets(ss: List<PStmt>, acc: List<PStmt>) =>
  fold(ss, acc, bindingLetsStep)

fun bindingLetsStep(a: List<PStmt>, x: PStmt) => match(x)
  (d: PsDestructure) => concat(a, flattenParams(x))
  (let2: PsLet) => append(a, x)
  (o: PStmt) => a

# ── multi-subject arity ─────────────────────────────────────────────────────
# Arity is a pure AST property — one pattern per subject — so it is checked
# here, where the subject count is known and the grammar's could not be.
#
# POSITION SUPPORT (can this repr test this pattern?) is checked here too, as
# MatchExpression.check does: it must run in the match's own scope, where the
# subjects have types. (Asked at codegen, from the global scope, a subject
# that is a parameter had no type and the check silently passed.)

fun countOf(es: List<PExpr>) => fold(es, 0, (n, e2) => n + 1)

fun isPrimitiveMatchType(name)
  ret name == "str" || name == "bigint" || name == "int8" || name == "int16"
      || name == "int32" || name == "int64" || name == "float32"
      || name == "float64"

fun hasGuard(a: PArm) => match(a.armGuard)
  (g2: PExpr) => true
  ()          => false

# Every name a NamedExpression references anywhere inside (referenced_names):
# a structural scan, one callback. A name set, membership-tested by its reader.
fun referencedNames(x: PExpr, acc: List<String>): List<String> =>
  walkExpr(x, emptyResolverGlobal, acc, referencedNamesWalk()).s

fun referencedInStmt(st: PStmt, acc: List<String>): List<String> =>
  walkStmt(st, emptyResolverGlobal, acc, referencedNamesWalk()).s

fun referencedNamesWalk(): Walk<List<String>> =>
  Walk<List<String>>((a, _r, x) => (s = referencedName(x, a), r = None),
                     wkNoStmt<List<String>>, wkNoSpec<List<String>>)

fun referencedName(x: PExpr, acc: List<String>): List<String> => match(x)
  (nm: PeName) => prepend(nm.refName, acc)
  (o: PExpr)   => acc

# ── `with` — only reached when the frontend could not expand it ─────────────
# Mirrors WithExpression.check byte for byte (parity of diagnostics).

# ── __builtin_pin_set__ (pyast PinSetExpression.check) ──────────────────────
# A name, then a field of it, in a class that admits a late write; the field
# holds a heap object or None; the value fits the field.
