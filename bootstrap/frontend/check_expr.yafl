# bootstrap/check_expr.yafl — Expression.check per kind, ported from the
# check() methods in compiler/pyast/expression/. Message strings VERBATIM.
namespace Bootstrap::Frontend

import System

import Bootstrap::Ast
import Bootstrap::Parse
import Bootstrap::Resolve
import Bootstrap::Types



fun [tail] checkRecurArgs(as2: Chain<PExpr>, r: Resolver,
                          acc: Set<PErr>): Set<PErr>
  ret match(as2)
    (nil: ChainEnd) => acc
    (l: ChainLink)  => checkRecurArgs(l.next, r,
                                      union(acc, checkExpr(l.value, r,
                                                            None)))

fun checkExpr(x: PExpr, r: Resolver, expected: Spec|None): Set<PErr>
  ret match(x)
    (i: PeInt)      => noErrs()
    (f: PeFloat)    => noErrs()
    (b: PeBool)     => noErrs()
    (s2: PeStr)     => noErrs()
    (rx: PeRegex)   => noErrs()
    (ng: PeNothing) => noErrs()
    (nm: PeName)    => checkName(nm, r)
    (d: PeDot)      => checkDot(d, r)
    (c: PeCall)     => checkCall(c, r)
    (tp: PeTuple)   => checkTupleExpr(tp, r, expected)
    (te: PeTernary) => checkTernary(te, r, expected)
    (lm: PeLambda)  => checkLambda(lm, r, expected)
    (bk: PeBlock)   => checkBlock(bk, r, expected)
    (mt: PeMatch)   => checkMatch(mt, r, expected)
    (op: PeBuiltinOp) => checkExpr(op.opParams, r, None)
    (nw: PeNew)     => checkNew(nw, r)
    (ne: PeNewEnum) => fold(ne.fieldArgs, noErrs(), (a2: Set<PErr>, fa: PFieldArg) =>
                            union(a2, checkExpr(fa.faValue, r, None)))
    (ar: PeArrayRead) => union(checkExpr(ar.arrObj, r, None),
                                checkExpr(ar.arrIndex, r, None))
    (pl: PeParallel) => checkExpr(pl.parParams, r, None)
    (wx: PeWith)   => checkWith(wx, r)
    (cv: PeConvert) => checkExpr(cv.convInner, r, None)
    # tail_loop lowering only — never present at check time; mirrored from
    # loop.py's check methods for completeness.
    (lp: PeLoop)    => checkExpr(lp.loopBody, r, expected)
    (rc: PeRecur)   => checkRecurArgs(chain(rc.recArgs), r, noErrs())
    (lz: PeLazy)    => noErrs()

# ── NamedExpression ─────────────────────────────────────────────────────────
# Duplicate-route resolutions of one statement are ONE candidate here (only in
# check — compile/get_type keep the raw multiplicity as an unresolved signal).

fun checkName(nm: PeName, r: Resolver): Set<PErr>
  let tpErrs = checkSpecs(chain(nm.refTypeParams), r, noErrs())
  let datas = traitFiltered(distinctFinds(findData(r, nm.refName).bItems),
                            nm.penTrait)
  if isEmpty(datas)
    ret union(oneErr(nm.penLine, "Failed to resolve " + nm.refName), tpErrs)
  ret match(soleOf(datas))
    # A generic AMBIENT instance member that never committed a solved scope:
    # the use site could not bind the instance's placeholders — ambience
    # applies to concrete types only, so a name-match alone is NOT a
    # resolution (without this the template dies later, deep in codegen).
    (f: Found) => unresolvedAmbient(nm, f)
      ? union(oneErr(nm.penLine,
                      "Failed to resolve " + bareOfUnique(nm.refName)
                      + ": the ambient instance applies to concrete types"
                      + " only — generic code needs its own `where` clause"),
               tpErrs)
      : union(callerTypeParamErrs(f.fStmt, nm.refTypeParams,
                                   nm.penLine, r),
               tpErrs)
    ()         => union(oneErr(nm.penLine,
                    "Ambiguous reference '" + nm.refName
                    + "' — qualify it. Candidates: "
                    + join(sort(dedupeStrs(foundNames(chain(datas),
                                                      List<String>()))),
                           ", ")),
             tpErrs)

fun unresolvedAmbient(nm: PeName, f: Found): Bool
  ret match(f.fInstanceParams)
    (own: List<String>) => !isEmpty(own) && match(nm.penTrait)
      (c: Spec) => false
      ()        => true
    ()                  => false

fun foundNames(ds: Chain<Found>, acc: List<String>): List<String>
  ret build<String >(foundNamesB(ds, _pushChain<String >(builder<String >(), chain<String >(acc))))

fun [tail] foundNamesB(ds: Chain<Found>, [terminal] acc: ListBuilder<String >): ListBuilder<String >
  ret match(ds)
    (nil: ChainEnd) => acc
    (l: ChainLink)  => foundNamesB(l.next, push<String >(acc, l.value.fName))

fun dedupeStrs(ss: List<String>): List<String>
  ret ddsLoop(chain(ss), List<String>())

fun [tail] ddsLoop(ss: Chain<String>, acc: List<String>): List<String>
  ret match(ss)
    (nil: ChainEnd) => acc
    (l: ChainLink)  => ddsLoop(l.next, addNameOnce(acc, l.value))

# _distinct_resolutions: several ROUTES to one statement are one candidate.
fun distinctFinds(ds: List<Found>): List<Found>
  ret dfLoop(chain(ds), List<Found>(), List<String>())

fun dfLoop(ds: Chain<Found>, acc: List<Found>,
                  seen: List<String>): List<Found>
  ret build<Found >(dfLoopB(ds, _pushChain<Found >(builder<Found >(), chain<Found >(acc)), seen))

fun [tail] dfLoopB(ds: Chain<Found>, [terminal] acc: ListBuilder<Found >,
                  seen: List<String>): ListBuilder<Found >
  ret match(ds)
    (nil: ChainEnd) => acc
    (l: ChainLink)  => contains2(seen, l.value.fName)
      ? dfLoopB(l.next, acc, seen)
      : dfLoopB(l.next, push<Found >(acc, l.value), append(seen, l.value.fName))

# ── DotExpression ───────────────────────────────────────────────────────────

fun checkDot(d: PeDot, r: Resolver): Set<PErr>
  ret match(exprType(d.base, r))
    (bt: Spec) => match(bt)
      (t2: STuple) => tupleFieldExists(chain(t2.stEntries), d.member)
        ? noErrs()
        : oneErr(d.pedLine, "Could not find field " + d.member)
      (c2: SClass) => checkClassDot(d, c2, r)
      (e2: SEnum)  => checkEnumDot(d, e2, r)
      (o: Spec)    => noErrs()
    ()         => noErrs()

fun [tail] tupleFieldExists(es: Chain<SEntry>, name: String): Bool
  ret match(es)
    (nil: ChainEnd) => false
    (l: ChainLink)  => l.value.seName == name ? true : tupleFieldExists(l.next, name)

fun checkClassDot(d: PeDot, c2: SClass, r: Resolver): Set<PErr>
  ret match(soleItem(findType(r, c2.scName)))
    (f: Found) => match(f.fStmt)
      (cs: PsClass) => classDotErrs(d, classFindData(cs, r, d.member))
      (o: PStmt)    => noErrs()
    ()         => noErrs()

fun classDotErrs(d: PeDot, datas: List<Found>): Set<PErr>
  if isEmpty(datas)
    ret oneErr(d.pedLine, "Could not find a field named " + d.member)
  if atLeast(chain(datas), 2)
    ret oneErr(d.pedLine, "Ambiguous reference to field named " + d.member)
  ret noErrs()

fun checkEnumDot(d: PeDot, e2: SEnum, r: Resolver): Set<PErr>
  if hasFieldNamed(chain(enumFieldsVia(r, e2.seRoot)), d.member)
    ret noErrs()                       # already resolved to a unique field name
  ret match(narrowedEnumField(r, e2, d.member))
    (h: NfHit)       => noErrs()
    (a2: NfAmbiguous) => oneErr(d.pedLine,
                                "field '" + d.member
                                + "' is declared by more than one possible "
                                + "variant here — match on the specific variant first")
    (m: NfMiss)      => oneErr(d.pedLine, "Could not find field " + d.member)

# ── CallExpression ──────────────────────────────────────────────────────────
# The argument tuple checks against the RESOLVED parameter shape; sub-errors
# short-circuit the call's own diagnostics.

fun checkCall(c: PeCall, r: Resolver): Set<PErr>
  let calleeParams = paramShapeOf(exprType(c.function, r))
  let sub = union(checkExpr(c.function, r, None),
                   checkExpr(c.parameter, r, calleeParams))
  if !isEmpty(sub)
    ret sub
  ret match(exprType(c.parameter, r))
    (pt: Spec) => match(pt)
      (tp: STuple) => callShapeErrs(c, tp, r)
      (o: Spec)    => oneErr(c.pecLine, "parameter expression must be of TupleType")
    ()         => oneErr(c.pecLine, "parameter expression must be of TupleType")

fun callShapeErrs(c: PeCall, ptype: STuple, r: Resolver): Set<PErr>
  ret match(exprType(c.function, r))
    (ft: Spec) => match(ft)
      (cl: SCallable) => triFalse(assignableFrom(r, cl.scParams2, ptype))
        ? oneErr(c.pecLine, "Parameters are not assignment compatible")
        : noErrs()
      (o: Spec)       => add(noErrs(), unresolvedCallError(c, ptype, ft, r))
    ()         => add(noErrs(), unresolvedCallError2(c, ptype, r))

# The callee didn't resolve to a single callable. Say WHY in the author's
# terms: the called name, the argument types, the candidate signatures.
fun unresolvedCallError2(c: PeCall, ptype: STuple, r: Resolver): PErr
  ret match(c.function)
    (nm: PeName) => namedCallError(c, nm, ptype, r)
    (o: PExpr)   => PErr(c.pecLine,
                         "the value being called is not a function (its type is unknown)")

fun unresolvedCallError(c: PeCall, ptype: STuple, ft: Spec, r: Resolver): PErr
  ret match(c.function)
    (nm: PeName) => namedCallError(c, nm, ptype, r)
    (o: PExpr)   => PErr(c.pecLine,
                         "the value being called is not a function (its type is "
                         + typeStr(ft) + ")")

fun namedCallError(c: PeCall, nm: PeName, ptype: STuple, r: Resolver): PErr
  let name = backTicked(bareOfUnique(nm.refName))
  let cands = findData(r, nm.refName).bItems
  if isEmpty(cands)
    ret PErr(c.pecLine, "no function named " + name + " is in scope")
  let sigs = candidateSigs(chain(cands), List<String>())
  if isEmpty(sigs)
    ret match(firstNonCallable(chain(cands)))
      (t2: Spec) => PErr(c.pecLine, name + " is not a function — it is a "
                                    + typeStr(t2))
      ()         => PErr(c.pecLine,
                         "no " + name + " accepts arguments "
                         + typeStr2(ptype) + " — candidates: ")
  ret PErr(c.pecLine,
           "no " + name + " accepts arguments " + typeStr2(ptype)
           + " — candidates: " + join(sort(dedupeStrs(sigs)), "; "))

fun backTicked(raw: String): String
  ret startsWith(raw, "`") ? raw : "`" + raw + "`"

fun candidateSigs(cs: Chain<Found>, acc: List<String>): List<String>
  ret build<String >(candidateSigsB(cs, _pushChain<String >(builder<String >(), chain<String >(acc))))

fun [tail] candidateSigsB(cs: Chain<Found>, [terminal] acc: ListBuilder<String >): ListBuilder<String >
  ret match(cs)
    (nil: ChainEnd) => acc
    (l: ChainLink)  => match(stmtType(l.value.fStmt))
      (ty: Spec) => match(ty)
        (cl: SCallable) => candidateSigsB(l.next, push<String >(acc, typeStr(ty)))
        (o: Spec)       => candidateSigsB(l.next, acc)
      ()         => candidateSigsB(l.next, acc)

fun [tail] firstNonCallable(cs: Chain<Found>): Spec|None
  ret match(cs)
    (nil: ChainEnd) => None
    (l: ChainLink)  => match(stmtType(l.value.fStmt))
      (ty: Spec) => match(ty)
        (cl: SCallable) => firstNonCallable(l.next)
        (o: Spec)       => ty
      ()         => firstNonCallable(l.next)

# _type_str: a source-shaped rendering for diagnostics — never the internal
# spec name.
fun typeStr(ts: Spec|None): String
  ret match(ts)
    (t2: Spec) => typeStrOf(t2)
    ()         => "unknown"

fun typeStr2(ts: STuple): String
  ret typeStrOf(ts)

fun typeStrOf(t2: Spec): String
  ret match(t2)
    (b: SBuiltin)      => builtinStr(b.sbName)
    (n: SNamed)        => bareOfUnique(n.snName)
    (tp: STuple)       => "(" + joinTypeStrs(chain(tp.stEntries), "") + ")"
    (cm: SCombination) => joinMemberStrs(chain(cm.scTypes), "")
    (cl: SCallable)    => typeStr(cl.scParams2) + ": " + typeStr(cl.scResult)
    (c: SClass)        => bareOfUnique(c.scName)
    (g2: SGeneric)     => bareOfUnique(g2.sgName)
    (e2: SEnum)        => "EnumSpec"
    (af: SArrayField)  => "ArrayFieldSpec"
    (ls: SLazyStub)    => "LazyStubSpec"

fun builtinStr(name: String): String
  ret name == "bigint" ? "Int"
    : name == "int8" ? "Int8"
    : name == "int16" ? "Int16"
    : name == "int32" ? "Int32"
    : name == "int64" ? "Int64"
    : name == "float32" ? "Float32"
    : name == "float64" ? "Float64"
    : name == "bool" ? "Bool"
    : name == "str" ? "String"
    : name

fun [tail] joinTypeStrs(es: Chain<SEntry>, acc: String): String
  ret match(es)
    (nil: ChainEnd) => acc
    (l: ChainLink)  => joinTypeStrs(l.next,
                                    acc == ""
                                      ? typeStr(l.value.seType)
                                      : acc + ", " + typeStr(l.value.seType))

fun [tail] joinMemberStrs(ms: Chain<Spec>, acc: String): String
  ret match(ms)
    (nil: ChainEnd) => acc
    (l: ChainLink)  => joinMemberStrs(l.next,
                                      acc == ""
                                        ? typeStrOf(l.value)
                                        : acc + " | " + typeStrOf(l.value))

# ── the rest ────────────────────────────────────────────────────────────────

fun checkTernary(te: PeTernary, r: Resolver, expected: Spec|None): Set<PErr>
  let condErr = checkExpr(te.condition, r, SBuiltin("bool", PLine("none", 0, 0)))
  let trueErr = checkExpr(te.trueResult, r, expected)
  let falseErr = checkExpr(te.falseResult, r, expected)
  let selfErr = match(exprType(te, r))
    (t2: Spec) => noErrs()
    ()         => oneErr(te.pety, "Failed to resolve type of ternery expression")
  ret union(condErr, union(trueErr, union(falseErr, selfErr)))

fun checkNew(nw: PeNew, r: Resolver): Set<PErr>
  let sub = union(checkSpec(nw.newType, r), checkExpr(nw.newParam, r, None))
  if !isEmpty(sub)
    ret sub
  ret match(exprType(nw.newParam, r))
    (pt: Spec) => match(pt)
      (tp: STuple) => match(nw.newType)
        (c2: SClass) => noErrs()
        (o: Spec)    => oneErr(nw.penwLine, "type must be ClassSpec")
      (o2: Spec)   => oneErr(nw.penwLine, "parameter expression must be of TupleType")
    ()         => oneErr(nw.penwLine, "parameter expression must be of TupleType")

fun checkTupleExpr(tp: PeTuple, r: Resolver, expected: Spec|None): Set<PErr>
  ret checkTupEnts2(chain(tp.exprs), r, noErrs())

fun [tail] checkTupEnts2(es: Chain<PTupEnt>, r: Resolver,
                         acc: Set<PErr>): Set<PErr>
  ret match(es)
    (nil: ChainEnd) => acc
    (l: ChainLink)  => checkTupEnts2(l.next, r,
                                     union(acc, checkExpr(l.value.tupValue, r,
                                                           None)))

fun checkLambda(lm: PeLambda, r0: Resolver, expected: Spec|None): Set<PErr>
  let r = localScope(paramLets(lm.lamParams), r0)
  let sub = expectedResult(expected)
  let prmErr = checkStmt2(lm.lamParams, r, None)
  let bodyErr = checkExpr(lm.lamBody, r, sub)
  let retErr = match(lm.lamRet)
    (t2: Spec) => checkSpec(t2, r)
    ()         => oneErr(lm.pelLine, "Lambda return type is unknown")
  ret union(prmErr, union(bodyErr, retErr))

fun checkBlock(bk: PeBlock, r0: Resolver, expected: Spec|None): Set<PErr>
  let r = blockScope(bk.blockStmts, r0)
  let stmtErrs = blockStmtChecks(chain(bk.blockStmts), r, expected, noErrs())
  let valErrs = checkExpr(bk.blockValue, r, expected)
  let typeErr = blockTypeErr(bk, r, expected, valErrs)
  ret union(stmtErrs, union(valErrs, union(typeErr, unusedBindings(bk, r))))

fun [tail] blockStmtChecks(ss: Chain<PStmt>, r: Resolver, expected: Spec|None,
                           acc: Set<PErr>): Set<PErr>
  ret match(ss)
    (nil: ChainEnd) => acc
    (l: ChainLink)  => blockStmtChecks(l.next, r, expected,
                                       union(acc, checkStmt2(l.value, r,
                                                              expected)))

fun blockTypeErr(bk: PeBlock, r: Resolver, expected: Spec|None,
                 valErrs: Set<PErr>): Set<PErr>
  if !isEmpty(valErrs)
    ret noErrs()
  ret match(expected)
    (want: Spec) => match(exprType(bk.blockValue, r))
      (xt: Spec) => triFalse(assignableEq(r, want, xt))
        ? oneErr(exprLine(bk.blockValue), "Incorrect type")
        : noErrs()
      ()         => noErrs()
    ()           => noErrs()

# No value vanishes silently: a block-local binding never read discards its
# value. A `_`-prefixed name is the explicit opt-out.
fun unusedBindings(bk: PeBlock, r: Resolver): Set<PErr>
  let declared = bindingLets(chain(bk.blockStmts), List<PStmt>())
  if isEmpty(declared)
    ret noErrs()
  let referenced = referencedInStmts(chain(bk.blockStmts),
                                     referencedNames(bk.blockValue,
                                                     List<String>()))
  ret unusedWarns(chain(declared), referenced, noErrs())

fun [tail] bindingLets(ss: Chain<PStmt>, acc: List<PStmt>): List<PStmt>
  ret match(ss)
    (nil: ChainEnd) => acc
    (l: ChainLink)  => match(l.value)
      (d: PsDestructure) => bindingLets(l.next,
                                        concat(acc, flattenParams(l.value)))
      (let2: PsLet)      => bindingLets(l.next, append(acc, l.value))
      (o: PStmt)         => bindingLets(l.next, acc)


fun [tail] unusedWarns(ls: Chain<PStmt>, referenced: List<String>,
                       acc: Set<PErr>): Set<PErr>
  ret match(ls)
    (nil: ChainEnd) => acc
    (l: ChainLink)  => match(l.value)
      (let2: PsLet) => startsWith(bareOfUnique(let2.lName), "_")
                       || contains2(referenced, let2.lName)
        ? unusedWarns(l.next, referenced, acc)
        : unusedWarns(l.next, referenced,
                      add(acc, PErr(let2.pslLine,
                                       "'" + bareOfUnique(let2.lName)
                                       + "' is never used", true)))
      (o: PStmt)    => unusedWarns(l.next, referenced, acc)

# The subject is checked first; a subject whose TYPE is unknowable
# short-circuits everything below (its own errors are all there is). Literal
# arms need a primitive variant in the subject; type-arm matches need a
# union-ish subject; the else arm stays guard-free (totality).
fun checkMatch(mt: PeMatch, r: Resolver, expected: Spec|None): Set<PErr>
  let subjectErr = checkExpr(mt.subject, r, None)
  ret match(exprType(mt.subject, r))
    (st: Spec) => checkMatchTyped(mt, st, r, expected, subjectErr)
    ()         => subjectErr

fun checkMatchTyped(mt: PeMatch, st: Spec, r: Resolver, expected: Spec|None,
                    subjectErr: Set<PErr>): Set<PErr>
  let hasLit = anyArmLiterals(chain(mt.arms))
  if hasLit && !(isPrimitiveSubject(st) || unionHasPrimitive(st))
    ret union(subjectErr,
               oneErr(mt.pemLine,
                      "literal match arms require a subject with a primitive (Int or String) variant"))
  if !hasLit && !isEnumOrUnion(st)
    ret union(subjectErr,
               oneErr(mt.pemLine,
                      "match subject must be a union type, or use literal "
                      + "patterns on an Int/String subject"))
  # NOT PORTED YET: __check_literal_arms / __check_exhaustiveness (coverage,
  # duplicate literals, unreachable arms) — the contract's next diff will
  # demand them.
  ret matchArmChecks(chain(mt.arms), r, expected, subjectErr)

fun [tail] anyArmLiterals(as2: Chain<PArm>): Bool
  ret match(as2)
    (nil: ChainEnd) => false
    (l: ChainLink)  => isEmpty(l.value.armLiterals) ? anyArmLiterals(l.next) : true

fun isPrimitiveSubject(st: Spec): Bool
  ret match(st)
    (b: SBuiltin) => isPrimitiveMatchType(b.sbName)
    (o: Spec)     => false

fun isPrimitiveMatchType(name: String): Bool
  ret name == "str" || name == "bigint" || name == "int8" || name == "int16"
      || name == "int32" || name == "int64" || name == "float32"
      || name == "float64"

fun unionHasPrimitive(st: Spec): Bool
  ret match(st)
    (cm: SCombination) => anyPrimMember(chain(cm.scTypes))
    (o: Spec)          => false

fun [tail] anyPrimMember(ms: Chain<Spec>): Bool
  ret match(ms)
    (nil: ChainEnd) => false
    (l: ChainLink)  => match(l.value)
      (b: SBuiltin) => b.sbName == "bigint" || b.sbName == "str"
        ? true
        : anyPrimMember(l.next)
      (o: Spec)     => anyPrimMember(l.next)

fun isEnumOrUnion(st: Spec): Bool
  ret match(st)
    (e2: SEnum)        => true
    (cm: SCombination) => true
    (o: Spec)          => false

fun [tail] matchArmChecks(as2: Chain<PArm>, r: Resolver, expected: Spec|None,
                          acc: Set<PErr>): Set<PErr>
  ret match(as2)
    (nil: ChainEnd) => acc
    (l: ChainLink)  => matchArmChecks(l.next, r, expected,
                                      union(acc, checkArm(l.value, r, expected)))

fun checkArm(a: PArm, r: Resolver, expected: Spec|None): Set<PErr>
  let bodyR = bindingScope(a, a.armType, r)
  let typeErr = checkSpecOpt(a.armType, r)
  let bodyErr = checkExpr(a.armBody, bodyR, expected)
  let guardErr = armGuardErrs(a, bodyR, r)
  ret union(typeErr,
      union(bodyErr,
      union(guardErr, union(elseGuardErr(a), mixedKindErr(a)))))

# The else arm must stay TOTAL — the match's coverage guarantee rests on it.
fun elseGuardErr(a: PArm): Set<PErr>
  ret hasGuard(a) && armIsElse(a)
    ? oneErr(a.parmLine,
             "a guard is not allowed on the else arm — put the guarded case "
             + "in its own arm before it")
    : noErrs()

fun hasGuard(a: PArm): Bool
  ret match(a.armGuard)
    (g2: PExpr) => true
    ()          => false

fun armIsElse(a: PArm): Bool
  ret isEmpty(a.armLiterals) && armHasNoType(a)

fun armHasNoType(a: PArm): Bool
  ret match(a.armType)
    (t2: Spec) => false
    ()         => true

# One arm, one literal KIND (a range counts as its lo's kind).
fun mixedKindErr(a: PArm): Set<PErr>
  if atMost(chain(a.armLiterals), 1)
    ret noErrs()
  let kinds = litKinds(chain(a.armLiterals), List<String>())
  ret atLeast(chain(kinds), 2)
    ? oneErr(a.parmLine,
             "all literals in one arm must be the same kind (integers, floats or strings)")
    : noErrs()

fun [tail] litKinds(ls: Chain<PLit>, acc: List<String>): List<String>
  ret match(ls)
    (nil: ChainEnd) => acc
    (l: ChainLink)  => litKinds(l.next, addNameOnce(acc, litKind(l.value)))

fun litKind(l: PLit): String
  ret match(l)
    (e2: PlExpr)  => exprKind(e2.litExpr)
    (rg: PlRange) => exprKind(rg.rangeLo)

fun exprKind(x: PExpr): String
  ret match(x)
    (s2: PeStr)   => "str"
    (f: PeFloat)  => "float"
    (o: PExpr)    => "int"

fun armGuardErrs(a: PArm, bodyR: Resolver, r: Resolver): Set<PErr>
  ret match(a.armGuard)
    (g2: PExpr) => union(checkExpr(g2, bodyR, None),
                          guardBoolErr(a, g2, bodyR))
    ()          => noErrs()

fun guardBoolErr(a: PArm, g2: PExpr, bodyR: Resolver): Set<PErr>
  ret match(exprType(g2, bodyR))
    (t2: Spec) => match(t2)
      (b: SBuiltin) => b.sbName == "bool"
        ? noErrs()
        : oneErr(a.parmLine, "a match guard must be a Bool")
      (o: Spec)     => oneErr(a.parmLine, "a match guard must be a Bool")
    ()         => noErrs()

# Every name a NamedExpression references anywhere inside (referenced_names).
fun referencedNames(x: PExpr, acc: List<String>): List<String>
  ret match(x)
    (nm: PeName)   => append(acc, nm.refName)
    (d: PeDot)     => referencedNames(d.base, acc)
    (c: PeCall)    => referencedNames(c.parameter, referencedNames(c.function, acc))
    (tp: PeTuple)  => refEntries(chain(tp.exprs), acc)
    (te: PeTernary) => referencedNames(te.falseResult,
                        referencedNames(te.trueResult,
                          referencedNames(te.condition, acc)))
    (lm: PeLambda) => referencedNames(lm.lamBody, refStmt(lm.lamParams, acc))
    (bk: PeBlock)  => referencedNames(bk.blockValue,
                                      referencedInStmts(chain(bk.blockStmts), acc))
    (mt: PeMatch)  => refArms(chain(mt.arms), referencedNames(mt.subject, acc))
    (op: PeBuiltinOp) => referencedNames(op.opParams, acc)
    (nw: PeNew)    => referencedNames(nw.newParam, acc)
    (ar: PeArrayRead) => referencedNames(ar.arrIndex,
                                         referencedNames(ar.arrObj, acc))
    (cv: PeConvert) => referencedNames(cv.convInner, acc)
    # A NewEnum's references live in its field-arg VALUE expressions.
    (wx: PeWith)   => referencedNames(wx.withRepls,
                                      referencedNames(wx.withSubject, acc))
    (ne: PeNewEnum) => fold(ne.fieldArgs, acc, (a2: List<String>, fa: PFieldArg) =>
                            referencedNames(fa.faValue, a2))
    (pl: PeParallel) => referencedNames(pl.parParams, acc)
    (o: PExpr)     => acc

fun [tail] refEntries(es: Chain<PTupEnt>, acc: List<String>): List<String>
  ret match(es)
    (nil: ChainEnd) => acc
    (l: ChainLink)  => refEntries(l.next, referencedNames(l.value.tupValue, acc))

fun [tail] refArms(as2: Chain<PArm>, acc: List<String>): List<String>
  ret match(as2)
    (nil: ChainEnd) => acc
    (l: ChainLink)  => refArms(l.next,
                               refOpt(l.value.armGuard,
                                      referencedNames(l.value.armBody, acc)))

fun refOpt(x: PExpr|None, acc: List<String>): List<String>
  ret match(x)
    (e2: PExpr) => referencedNames(e2, acc)
    ()          => acc

fun [tail] referencedInStmts(ss: Chain<PStmt>, acc: List<String>): List<String>
  ret match(ss)
    (nil: ChainEnd) => acc
    (l: ChainLink)  => referencedInStmts(l.next, refStmt(l.value, acc))

fun refStmt(st: PStmt, acc: List<String>): List<String>
  ret match(st)
    (f: PsFun)         => refOpt(f.fBody, acc)
    (l: PsLet)         => refOpt(l.lDefault, acc)
    (d: PsDestructure) => referencedInStmts(chain(d.dTargets),
                                            refOpt(d.dDefault, acc))
    (rt: PsRet)        => referencedNames(rt.retValue, acc)
    (a: PsAction)      => referencedNames(a.action, acc)
    (i: PsIf)          => referencedInStmts(chain(i.ifFalse),
                            referencedInStmts(chain(i.ifTrue),
                              referencedNames(i.ifCond, acc)))
    (ei: PsElseIf)     => referencedInStmts(chain(ei.eiStmts),
                                            referencedNames(ei.eiCond, acc))
    (el: PsElse)       => referencedInStmts(chain(el.elStmts), acc)
    (o: PStmt)         => acc


# ── `with` — only reached when the frontend could not expand it ─────────────
# Mirrors WithExpression.check byte for byte (parity of diagnostics).

fun checkWith(wx: PeWith, r: Resolver): Set<PErr>
  let sub = checkExpr(wx.withSubject, r, None)
  if !isEmpty(sub)
    ret sub
  let reps = checkExpr(wx.withRepls, r, None)
  if !isEmpty(reps)
    ret reps
  let shape = withShapeError(wx)
  if shape != ""
    ret add(Set<PErr>(),PErr(wx.pewLine, shape))
  ret match(exprType(wx.withSubject, r))
    (sp: Spec) => match(sp)
      (c: SClass) => checkWithFields(wx, r)
      (e2: SEnum) => checkWithFields(wx, r)
      (o: Spec)   => add(Set<PErr>(),PErr(wx.pewLine,
        "the subject of `with` must be a class- or enum-typed expression"))
    ()         => add(Set<PErr>(),PErr(wx.pewLine,
      "the subject type of `with` did not resolve"))

fun withShapeError(wx: PeWith): String
  ret match(wx.withRepls)
    (tp: PeTuple) => isEmpty(tp.exprs)
      ? "a `with` expression needs at least one replacement — `with x()` copies nothing and means nothing"
      : withEntriesError(chain(tp.exprs), List<String>())
    (o: PExpr)    => "a `with` expression needs at least one replacement — `with x()` copies nothing and means nothing"

fun [tail] withEntriesError(es: Chain<PTupEnt>, seen: List<String>): String
  ret match(es)
    (nil: ChainEnd) => ""
    (l: ChainLink)  => l.value.tupSpread
      ? "a `with` replacement cannot be a spread"
      : l.value.tupName == ""
        ? "`with` replacements must be named — `with x(field = value)`"
        : contains2(seen, l.value.tupName)
          ? "a `with` expression replaces each field at most once"
          : withEntriesError(l.next, append(seen, l.value.tupName))

fun checkWithFields(wx: PeWith, r: Resolver): Set<PErr>
  let visible = withVisibleFields(wx, r)
  ret match(wx.withRepls)
    (tp: PeTuple) => withNamesKnown(chain(tp.exprs), visible, wx.pewLine)
    (o: PExpr)    => Set<PErr>()

fun [tail] withNamesKnown(es: Chain<PTupEnt>, visible: List<String>,
                          lr: PLine): Set<PErr>
  ret match(es)
    (nil: ChainEnd) => Set<PErr>()
    (l: ChainLink)  => contains2(visible, l.value.tupName)
      ? withNamesKnown(l.next, visible, lr)
      : add(Set<PErr>(),PErr(lr,
          "`" + l.value.tupName + "`" + " is not a field visible on the subject's type — `with` can only replace fields the static type guarantees"))

fun withVisibleFields(wx: PeWith, r: Resolver): List<String>
  ret match(exprType(wx.withSubject, r))
    (sp: Spec) => match(sp)
      (c: SClass) => match(soleItem(findType(r, c.scName)))
        (f: Found) => match(f.fStmt)
          (cls: PsClass) => withBareNames(chain(flattenParams(cls.cParams)),
                                          List<String>())
          (o: PStmt)     => List<String>()
        ()         => List<String>()
      (e2: SEnum) => match(soleItem(findType(r, e2.seRoot)))
        (f: Found) => match(f.fStmt)
          (en: PsEnum) => withCoverBares(chain(coveringFields(en, e2.seValidLeaves)),
                                         List<String>())
          (o: PStmt)   => List<String>()
        ()         => List<String>()
      (o2: Spec)  => List<String>()
    ()         => List<String>()

fun withBareNames(fs: Chain<PStmt>, acc: List<String>): List<String>
  ret build<String >(withBareNamesB(fs, _pushChain<String >(builder<String >(), chain<String >(acc))))

fun [tail] withBareNamesB(fs: Chain<PStmt>, [terminal] acc: ListBuilder<String >): ListBuilder<String >
  ret match(fs)
    (nil: ChainEnd) => acc
    (l: ChainLink)  => match(l.value)
      (p: PsLet) => withBareNamesB(l.next, push<String >(acc, bareName(p.lName)))
      (o: PStmt) => withBareNamesB(l.next, acc)

fun withCoverBares(fs: Chain<SField>, acc: List<String>): List<String>
  ret build<String >(withCoverBaresB(fs, _pushChain<String >(builder<String >(), chain<String >(acc))))

fun [tail] withCoverBaresB(fs: Chain<SField>, [terminal] acc: ListBuilder<String >): ListBuilder<String >
  ret match(fs)
    (nil: ChainEnd) => acc
    (l: ChainLink)  => withCoverBaresB(l.next, push<String >(acc, bareName(l.value.sfName)))
