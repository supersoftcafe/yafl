# bootstrap/checks.yafl — the post-convergence DIAGNOSTIC phases, ported from
# compiler.py::__collect_diagnostics (and the Error print/sort contract from
# parselib). Phase order is the driver's:
#
#   1. uninferable untyped parameters (with call-site clues);
#   2. `[future]` on a global let — rejected;
#   3. every statement's check() under its own scope, plus the main count;
#   4. warnings split out — they never fail the build; on failure EVERYTHING
#      returns (errors and warnings print together);
#   5. only when clean: the unresolved-NamedSpec scan (returns ALONE).
#
# Printing: `sorted(set(errors))` — dedupe, then order by
# ((filename, line, col), message, severity); "{basename}[{line}:{col}] -
# {warning: ?}{message}" per line.
namespace Bootstrap::Frontend

import System
import System::Containers

import Bootstrap::Ast
import Bootstrap::Driver
import Bootstrap::Parse
import Bootstrap::Resolve
import Bootstrap::Types



class [final] Diag(dFails: Set<PErr>, dWarns: Set<PErr>)

# compiler.py's __collect_diagnostics, the main check included: a program
# with no main (or two) fails here, with every other diagnostic beside it.
fun collectDiagnostics(statements: List<PStmt>, r, enabledWarnings: Set<String>): Diag
  let untyped = untypedParamErrors(statements, r)
  if !isEmpty(untyped)
    ret Diag(untyped, noErrs())
  let future = futureGlobalErrors(statements, noErrs())
  if !isEmpty(future)
    ret Diag(future, noErrs())
  let checks0 = stmtChecks(statements, r, noErrs())
  # A disabled warning category (see warnings.yafl) never enters the
  # diagnostic stream at all — not on success, not folded into a failure's
  # combined error+warning printout either. Mirrors compiler.py's
  # __collect_diagnostics, the single choke point every diagnostic passes
  # through there too.
  let checks = filter(checks0, (e2) => !e2.errWarn || contains(enabledWarnings, e2.errCategory))
  let diagnostics = withMainCount(statements, checks)
  let warnings = filter(diagnostics, (e2) => e2.errWarn)
  # "not every diagnostic is a warning" — i.e. at least one real error. This
  # used to build the warning subset and compare LENGTHS, which needed a walk
  # of an unordered collection; asking the question directly says what it
  # means and stops at the first counter-example.
  if !all(diagnostics, (e2) => e2.errWarn)
    ret Diag(diagnostics, warnings)          # some real error: fail with all
  let named = namedSpecErrors(statements)
  ret isEmpty(named) ? Diag(noErrs(), warnings) : Diag(named, warnings)

fun stmtChecks(ss: List<PStmt>, r: Resolver, acc: Set<PErr>): Set<PErr> =>
  fold(ss, acc, (a, x) => union(a, checkStmt2(x, scopeResolver(x, r), None)))

fun withMainCount(statements: List<PStmt>, acc): Set<PErr>
  let mains = countMains(statements, 0)
  if mains == 0
    ret add(acc, PErr(PLine("none", 0, 0), "No main function found"))
  if mains > 1
    ret add(acc, PErr(PLine("none", 0, 0), "Too many main functions defined"))
  ret acc

fun countMains(ss: List<PStmt>, n) =>
  fold(ss, n, (a, x) => isMainFunction(x) ? a + 1 : a)

fun isMainFunction(st) => match(st)
  (f: PsFun) => contains(f.fName, "::main@")
                && retIsBigint(f.fRet)
                && isEmpty(paramLets(f.fParams))
  (o: PStmt) => false

fun retIsBigint(sp: Spec|None) => match(sp)
  (s2: Spec) => match(s2)
    (b: SBuiltin) => b.sbName == "bigint"
    (o: Spec)     => false
  ()         => false


fun untypedParamErrors(statements: List<PStmt>, r) => hasAnyUntyped(statements)
  ? untypedLoop(statements, r, noErrs())
  : noErrs()

fun hasAnyUntyped(ss: List<PStmt>) => any(ss, hasAnyUntypedStep)

fun hasAnyUntypedStep(x: PStmt) => match(x)
  (f: PsFun) => anyUntypedTarget(paramLets(f.fParams))
  (o: PStmt) => false

fun anyUntypedTarget(ts: List<PStmt>) => any(ts, anyUntypedTargetStep)

fun anyUntypedTargetStep(x: PStmt) => match(x)
  (let2: PsLet) => match(let2.lType)
    (t2: Spec) => false
    () => true
  (o: PStmt) => false

fun untypedLoop(ss: List<PStmt>, r: Resolver, acc: Set<PErr>): Set<PErr> =>
  fold(ss, acc, (a, x) => untypedLoopStep(a, x, r))

fun untypedLoopStep(a: Set<PErr>, x: PStmt, r: Resolver) => match(x)
  (f: PsFun) => funUntypedErrors(f, paramBodyScope(f, scopeResolver(f, r)), a)
  (o: PStmt) => a

# The clue comes from the BODY's hints: the converged body compiles once more.
fun funUntypedErrors(f: PsFun, bodyR, acc: Set<PErr>)
  if !anyUntypedTarget(paramLets(f.fParams))
    ret acc
  let hints = hintsOf(compileExprOpt(f.fBody, bodyR, f.fRet))
  ret funUntyped(f, paramLets(f.fParams), bodyR, hints, acc)

fun funUntyped(f: PsFun, ts: List<PStmt>, bodyR, hints: Dict<String, List<Hint>>, acc: Set<PErr>) =>
  fold(ts, acc, (a, x) => funUntypedStep(a, x, f, bodyR, hints))

fun funUntypedStep(a: Set<PErr>, x: PStmt, f: PsFun, bodyR, hints: Dict<String, List<Hint>>) => match(x)
  (let2: PsLet) => match(let2.lType)
    (t2: Spec) => a
    () => add(a, untypedError(f, let2, bodyR, hints))
  (o: PStmt) => a

fun untypedError(f: PsFun, tgt: PsLet, bodyR,
                 hints: Dict<String, List<Hint>>)
  let clue = isUnsettled(hints)
    ? unresolvedClue()
    : match(hintVerdict(hintsFor(hints, tgt.lName), bodyR).vClue)
      (c: String) => c
      ()          => "None"
  ret PErr(tgt.pslLine,
           "Parameter '" + simpleName(tgt.lName) + "' of '"
           + simpleName(f.fName)
           + "' has no type and could not be inferred — " + clue)

fun nthOf<T>(l: List<T>, idx): T|None => head(drop(l, idx))

# ── phase 2: [future] on a global let ───────────────────────────────────────


fun futureGlobalErrors(ss: List<PStmt>, acc: Set<PErr>) =>
  fold(ss, acc, futureGlobalErrorsStep)

fun futureGlobalErrorsStep(a2: Set<PErr>, x: PStmt) => match(x)
  (let2: PsLet) => hasAttr(let2.lAttrs, "future")
    ? add(a2, PErr(let2.pslLine,
                   "[future] is not supported on a global let — "
                   + "it initialises at startup; use [lazy]"))
    : a2
  (o: PStmt) => a2

# ── phase 3 dispatch ────────────────────────────────────────────────────────

fun checkStmt2(st, r, retTy: Spec|None): Set<PErr> => checkStmtKind(st, r, retTy)

fun checkExprOpt(x: PExpr|None, r, expected: Spec|None) => match(x)
  (e2: PExpr) => checkExpr(e2, r, expected)
  ()          => noErrs()

# ── phase 5: the unresolved-NamedSpec scan ──────────────────────────────────
# Mirrors search_and_replace's reach: every compound spec recurses, a NamedSpec
# is a LEAF (its own type args are not walked — the outer name IS the error).

fun namedSpecErrors(statements: List<PStmt>) => nsStmts(statements, noErrs())

fun nsStmts(ss: List<PStmt>, acc: Set<PErr>) =>
  fold(ss, acc, (a, x) => nsStmt(x, a))

fun nsStmt(st, acc): Set<PErr> => match(st)
  (f: PsFun)         => nsExprOpt(f.fBody,
                          nsSpecs(f.fWheres,
                            nsSpecOpt(f.fRet, nsStmt(f.fParams, acc))))
  (l: PsLet)         => nsExprOpt(l.lDefault, nsSpecOpt(l.lType, acc))
  (d: PsDestructure) => nsStmts(d.dTargets,
                          nsExprOpt(d.dDefault, nsSpecOpt(d.dType, acc)))
  (c: PsClass)       => nsSpecsOpt(c.cAllParents,
                          nsStmts(c.cMembers,
                            nsSpecs(c.cWheres,
                              nsSpecs(c.cImplements,
                                nsStmt(c.cParams, acc)))))
  (e2: PsEnum)       => nsStmts(e2.eVariants, nsStmt(e2.eParams, acc))
  (ta: PsTypealias)  => nsSpecs(ta.taWheres, nsSpec(ta.taType, acc))
  (rt: PsRet)        => nsExpr(rt.retValue, acc)
  (a: PsAction)      => nsExpr(a.action, acc)
  (fa: PsFieldAssign) => nsExpr(fa.faValue, nsExpr(fa.faTarget, acc))
  (i: PsIf)          => nsStmts(i.ifFalse,
                          nsStmts(i.ifTrue, nsExpr(i.ifCond, acc)))
  (ei: PsElseIf)     => nsStmts(ei.eiStmts, nsExpr(ei.eiCond, acc))
  (el: PsElse)       => nsStmts(el.elStmts, acc)
  (o: PStmt)         => acc

fun nsExpr(x, acc): Set<PErr> => match(x)
  (nm: PeName)   => nsSpecOpt(nm.penTrait, nsSpecs(nm.refTypeParams, acc))
  (d: PeDot)     => nsExpr(d.base, acc)
  (c: PeCall)    => nsExpr(c.parameter, nsExpr(c.function, acc))
  (tp: PeTuple)  => nsEntries(tp.exprs, acc)
  (te: PeTernary) => nsExpr(te.falseResult,
                      nsExpr(te.trueResult, nsExpr(te.condition, acc)))
  (lm: PeLambda) => nsSpecOpt(lm.lamRet,
                      nsExpr(lm.lamBody, nsStmt(lm.lamParams, acc)))
  (bk: PeBlock)  => nsExpr(bk.blockValue, nsStmts(bk.blockStmts, acc))
  (mt: PeMatch)  => nsArms(mt.arms, nsExpr(mt.subject, acc))
  (op: PeBuiltinOp) => nsExpr(op.opParams, nsSpec(op.opType, acc))
  (ps: PePinSet) => nsExpr(ps.psValue, nsExpr(ps.psTarget, nsExpr(ps.psSubject, acc)))
  (nw: PeNew)    => nsExpr(nw.newParam, nsSpec(nw.newType, acc))
  (ar: PeArrayRead) => nsExpr(ar.arrIndex, nsExpr(ar.arrObj, acc))
  (cv: PeConvert) => nsSpec(cv.convTarget, nsExpr(cv.convInner, acc))
  (qq: PeCoalesce) => nsExpr(qq.qqFallback, nsExpr(qq.qqSubject, acc))
  (wx: PeWith)   => nsExpr(wx.withRepls, nsExpr(wx.withSubject, acc))
  (ne: PeNewEnum) => nsSpecs(ne.neTypeParams,
                              fold(ne.fieldArgs, acc, (a2, fa) =>
                                nsExpr(fa.faValue, a2)))
  (o: PeLiteral) => acc
  (o: PeLowered) => acc

fun nsEntries(es: List<PTupEnt>, acc): Set<PErr> =>
  fold(es, acc, (a, x) => nsExpr(x.tupValue, a))

fun nsArms(as2: List<PArm>, acc): Set<PErr> =>
  fold(as2, acc, (a, x) => nsExprOpt(x.armGuard, nsExpr(x.armBody, nsSpecOpt(x.armType, a))))

fun nsExprOpt(x: PExpr|None, acc): Set<PErr> => match(x)
  (e2: PExpr) => nsExpr(e2, acc)
  ()          => acc

fun nsSpec(sp, acc): Set<PErr> => match(sp)
  (n: SNamed)        => add(acc, PErr(n.snLine,
                                         "Failed to resolve type '"
                                         + n.snName + "'"))
  (c: SClass)        => nsSpecList(c.scParams, acc)
  (e2: SEnum)        => nsSpecList(e2.seParams, acc)
  (cl: SCallable)    => nsSpecOpt(cl.scResult, nsSpec(cl.scParams2, acc))
  (cm: SCombination) => nsSpecList(cm.scTypes, acc)
  (t2: STuple)       => nsSpecEntries(t2.stEntries, acc)
  (af: SArrayField)  => nsSpec(af.safElem, acc)
  (ls: SLazyStub)    => nsSpecOpt(ls.slsTarget, acc)
  (o: Spec)          => acc

fun nsSpecList(ss: List<Spec>, acc: Set<PErr>) =>
  fold(ss, acc, (a, x) => nsSpec(x, a))

fun nsSpecEntries(es: List<SEntry>, acc): Set<PErr> =>
  fold(es, acc, (a, x) => nsExprOpt(x.seDefault, nsSpecOpt(x.seType, a)))

fun nsSpecOpt(sp: Spec|None, acc): Set<PErr> => match(sp)
  (s2: Spec) => nsSpec(s2, acc)
  ()         => acc

fun nsSpecs(ss, acc): Set<PErr> => nsSpecList(ss, acc)

fun nsSpecsOpt(ss: List<Spec>|None, acc): Set<PErr> => match(ss)
  (l: List<Spec>) => nsSpecList(l, acc)
  ()              => acc

# ── printing: sorted(set(errors)) ───────────────────────────────────────────

# A Set is deduped BY CONSTRUCTION, so there is no dedupe stage to run — the
# only step left is naming an ordering, exactly as Python's
# `sorted(set(errors))` does. errLess matches Python's dataclass field order
# (file, line, col, message, severity).
fun printedDiagnostics(es: Set<PErr>) => printLoop(sortBy(es, errLess), "")

fun printLoop(es: List<PErr>, acc) =>
  fold(es, acc, (a, x) => a + errStr(x) + "\n")

fun errStr(e2: PErr) => e2.errLine.plFile + "[" + String(e2.errLine.plLine) + ":"
    + String(e2.errLine.plCol) + "] - "
    + (e2.errWarn ? "warning: " : "") + e2.errMsg

fun errLess(a: PErr, b: PErr)
  if a.errLine.plFile != b.errLine.plFile
    ret a.errLine.plFile < b.errLine.plFile
  if a.errLine.plLine != b.errLine.plLine
    ret a.errLine.plLine < b.errLine.plLine
  if a.errLine.plCol != b.errLine.plCol
    ret a.errLine.plCol < b.errLine.plCol
  if a.errMsg != b.errMsg
    ret a.errMsg < b.errMsg
  ret severityOf(a) < severityOf(b)

fun severityOf(e2: PErr) => e2.errWarn ? "warning" : "error"
