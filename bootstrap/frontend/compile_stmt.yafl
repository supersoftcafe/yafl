# bootstrap/compile_stmt.yafl — Statement.compile, ported from the compile()
# methods in compiler/pyast/statement/.
#
# This is where INFERENCE happens, and the whole of it is one distinction:
#
#   a DECLARED type is FIXED — refine only fills its holes, never overwrites it;
#   an INFERRED type CONVERGES on its source, and must be free to WIDEN.
#
# The second half is the subtle one. A branch broadens its arms to their least
# upper bound, and that grows as arms resolve late (`A`, then `A|None`). Plain
# refine latches the first concrete view and then rejects the wider one as a
# conflict, freezing the narrow type. So an undeclared return, an untyped let
# and a destructure target all go through refineWidening (algebra.yafl), which
# adopts a fresh view only when it is a STRICT superset — so the type can only
# grow, and the fixpoint still terminates.
#
# `inferred` is tracked as a FLAG rather than re-derived, because "declared"
# and "inferred-and-now-concrete" look identical afterwards. It is excluded from
# equality (equality.yafl) — it is a note about how we got here, not part of the
# program.
namespace Bootstrap::Frontend

import System

import Bootstrap::Ast
import Bootstrap::Parse
import Bootstrap::Resolve
import Bootstrap::Types



class [final] StmtOut(soStmt: PStmt|None, soExtra: List<PStmt>,
                      soHints: Dict<String, List<Hint>>)

fun compileStmt(st, r, retType): StmtOut => match(st)
  (l: PsLet)         => compileLet(l, r)
  (d: PsDestructure) => compileDestructure(d, r)
  (f: PsFun)         => compileFun(f, r)
  (ta: PsTypealias)  => compileTypealias(ta, r)
  (c: PsClass)       => compileClass(c, r)
  (e: PsEnum)        => compileEnum(e, r)
  (rt: PsRet)        => compileRet(rt, r, retType)
  (a: PsAction)      => compileAction(a, r)
  (i: PsIf)          => compileIf(i, r, retType)
  # An else-if / else reaching here is an ORPHAN (collapseElseIf folds the
  # proper ones into their if at both fold sites); it passes through
  # unchanged and check reports it. Imports and namespaces carry no
  # behaviour of their own.
  (ei: PsElseIf)     => StmtOut(st, List(), noHints())
  (el: PsElse)       => StmtOut(st, List(), noHints())
  (im: PsImport)     => StmtOut(st, List(), noHints())
  (ns: PsNamespace)  => StmtOut(st, List(), noHints())
  (inst: PsTraitInstance) => compileTraitInstance(inst, r)

# ── the inference core ──────────────────────────────────────────────────────

# A let: compile the initialiser against the declared type (so the RHS knows
# what it is converging toward), compile the type, then EITHER refine a declared
# type (holes only) OR widen an inferred one. The gen/trait scope of a TOP-LEVEL
# let is supplied by the caller (scopeResolver — Python's _initialiser_resolver);
# a block-scoped let adds none, exactly as LetStatement.compile adds none.
fun compileLet(l: PsLet, r)
  let ty = compileSpecOpt(l.lType, r)
  let declaredTy = specOf(ty)
  let init = compileExprOpt(l.lDefault, r, declaredTy)
  let wheres = compileParams(l.lWheres, r)
  let declared = hasDeclaredType(l)
  # A value that cannot say all it will yet (a name in it did not resolve
  # this pass) must not be stored: its type is only the part that did, and
  # refinement only ever widens, so it would latch.
  let settled = !isUnsettled(hintsOf(init))
  let inferredNow = settled ? (declared ? l.lTypeInferred : true) : l.lTypeInferred
  let finalTy = settled ? inferType(declaredTy, initType(init, r), declared, r) : declaredTy
  ret StmtOut(PsLet(l.lName, l.lAttrs, l.lGens, finalTy, exprOf(init),
                    l.lArrayLen, wheres.psSpecs, l.pslLine, inferredNow,
                    l.lImports),
              concat(globalsOf(init), concat(globalsOfSpec(ty), wheres.psGlobals)),
              hintsOf(init))

# DECLARED means: the source wrote a type, and inference has not since claimed
# it. Once inference owns the slot the flag stays set, so a type that has become
# concrete is not mistaken for a declaration on the next pass.
fun hasDeclaredType(l: PsLet) => match(l.lType)
  (t2: Spec) => !l.lTypeInferred
  ()         => false

fun inferType(current, fresh: Spec|None, declared: Bool,
              r): Spec|None => match(fresh)
  (f: Spec) => declared
    ? refine(current, r, fresh)           # holes fill; the declaration stands
    : refineWidening(current, fresh, r)   # converge, and stay free to widen
  ()        => current                    # no initialiser: nothing to infer from

fun initType(init: ExprOut|None, r) => match(init)
  (i: ExprOut) => exprType(i.eoExpr, r)
  ()           => None

# A destructure propagates the parent tuple's entry types onto its targets: a
# target with no annotation ADOPTS the entry's type and is thereafter inferred
# (so it keeps tracking a late widening); one with its own annotation keeps it,
# refined but never overwritten.
fun compileDestructure(d: PsDestructure, r)
  # The inherited LetStatement.compile half first: the RHS's sink is the
  # TARGETS' tuple type (_rhs_expected override — lets.py:50), and an untyped
  # destructure converges on the RHS like any let (refine when declared,
  # refine-widening when inferred).
  let init = compileExprOpt(d.dDefault, r, destructureType(d))
  let ty = compileSpecOpt(d.dType, r)
  let declaredTy = specOf(ty)
  let dDeclared = destructureDeclared(d)
  # An initialiser that cannot say all it will yet is not stored (compileLet).
  let hasInit2 = match(init)
    (i: ExprOut) => !isUnsettled(i.eoHints)
    ()           => false
  let finalTy = hasInit2 ? inferType(declaredTy, initType(init, r),
                                     dDeclared, r)
                         : declaredTy
  let inferredNow = hasInit2 ? (dDeclared ? d.dTypeInferred : true)
                             : d.dTypeInferred
  # THEN propagate the parent tuple's entry types onto the RAW targets, and
  # only then compile them — Python refines first (lets.py:518-534).
  let refined = propagate(finalTy, d.dTargets, r)
  let compiled = compileStmts(chain(refined), r, None, builder(),
                              List())
  ret StmtOut(PsDestructure(d.dName, d.dAttrs, finalTy, compiled.slStmts,
                            exprOf(init), d.psdLine, inferredNow),
              concat(globalsOf(init),
                     concat(globalsOfSpec(ty), compiled.slGlobals)),
              mergeHints(hintsOf(init), compiled.slHints))

fun destructureDeclared(d: PsDestructure) => match(d.dType)
  (t2: Spec) => !d.dTypeInferred
  ()         => false

fun propagate(parentTy: Spec|None, targets,
              r) => match(parentTy)
  (p: Spec) => match(p)
    (st: STuple) => sameLen(chain(st.stEntries), chain(targets))
      ? propagateLoop(chain(targets), chain(st.stEntries), r, List())
      : targets
    (o: Spec)    => targets
  ()        => targets

fun propagateLoop(ts, es, r,
                         acc: List<PStmt>): List<PStmt>
  ret build(propagateLoopB(ts, es, r, builderFrom(acc)))

fun [tail] propagateLoopB(ts: Chain<PStmt>, es: Chain<SEntry>, r,
                         [terminal] acc: ListBuilder<PStmt>) => match(ts)
  (nil: ChainEnd) => acc
  (t2: ChainLink) => match(es)
    (nil2: ChainEnd) => acc
    (e: ChainLink)   => propagateLoopB(t2.next, e.next, r,
                                      push(acc, adopt(t2.value,
                                                e.value.seType, r)))

fun adopt(target, entryTy: Spec|None, r) => match(target)
  (l: PsLet) => adoptLet(l, entryTy, r)
  (o: PStmt) => target

fun adoptLet(l: PsLet, entryTy: Spec|None, r)
  let declared = hasDeclaredType(l)
  let ty = inferType(l.lType, entryTy, declared, r)
  ret PsLet(l.lName, l.lAttrs, l.lGens, ty, l.lDefault, l.lArrayLen,
            l.lWheres, l.pslLine, declared ? l.lTypeInferred : true)

# ── functions ───────────────────────────────────────────────────────────────
# The body compiles against the CURRENT return type each pass (a generic
# combinator's body grounds off it), and an undeclared return then converges on
# the body — widening, for the same reason an untyped let does.

# The SIGNATURE (return type, parameters, wheres) resolves in the generic scope
# WITHOUT the trait layer (Python compiles them against `resolver` before
# __body_resolver runs); the BODY additionally sees the trait/operator scope —
# for a TOP-LEVEL function only, an inner one inherits its owner's lexically —
# and its parameters as locals.
fun compileFun(f: PsFun, r0): StmtOut
  let r = genScope(f.fGens, f.fWheres, r0)
  let ret2 = compileSpecOpt(f.fRet, r)
  let declaredRet = specOf(ret2)
  let params = compileStmt(f.fParams, r, None)
  let wheres = compileParams(f.fWheres, r)
  # The body scope reads the PASS-INPUT parameters (Python's __body_resolver
  # closes over self.parameters) — a type the params resolved THIS pass only
  # becomes visible to the body on the NEXT pass, and the fixpoint's pass
  # count depends on it.
  let bodyR = localScope(paramLets(f.fParams),
                         f.fNested ? r : traitScope(f.fWheres, r))
  # The body converges on the PASS-INPUT return type (Python's self.return_type).
  let body = compileExprOpt(f.fBody, bodyR, f.fRet)
  # An un-annotated parameter takes its type from the body's hints.
  let compiledParams = stmtOr(params, f.fParams)
  let finalParams = hasBody(f)
    ? inferredParams(compiledParams, hintsOf(body), bodyR)
    : compiledParams
  let declared = hasDeclaredRet(f)
  # As for the parameters: a body that cannot say all it will yet (a name in
  # it did not resolve this pass) leaves the return as it is — its type now
  # is only the part that resolved, and refinement only ever widens.
  let settled = !isUnsettled(hintsOf(body))
  let inferredNow = declared || !settled ? f.fRetInferred : hasBody(f)
  let finalRet = match(body)
    # The body's own type is derived in the BODY's scope — its parameters must
    # resolve there too, not just inside its compile.
    (b: ExprOut) => settled
      ? inferType(declaredRet, exprType(b.eoExpr, bodyR), declared, r)
      : declaredRet
    ()           => declaredRet
  ret StmtOut(PsFun(f.fName, f.fAttrs, f.fGens, finalParams,
                    exprOf(body), finalRet, wheres.psSpecs, f.psfLine,
                    inferredNow, f.fNested, f.fImports),
              concat(globalsOf(body),
                     concat(globalsOfSpec(ret2),
                            concat(params.soExtra, wheres.psGlobals))),
              hintsWithout(hintsOf(body), letNames(flattenParams(f.fParams)),
                           Set(map(f.fGens, (g) => g.genName))))

# Type each un-annotated parameter from its hints. The inferred type is
# re-read every pass and may change; nothing is read while a name in the body
# has not resolved. A declared type always stands.
fun inferredParams(params, hints: Dict<String, List<Hint>>, r)
  if isUnsettled(hints)
    ret params
  ret match(params)
    (d: PsDestructure) => with d(dTargets = map(d.dTargets,
                                                (p) => inferredParam(p, hints, r)))
    (o: PStmt)         => params

fun inferredParam(p, hints: Dict<String, List<Hint>>, r) => match(p)
  (l: PsLet) => hasDeclaredType(l)
    ? p
    : inferredLet(l, hintVerdict(hintsFor(hints, l.lName), r).vType)
  (o: PStmt) => p

fun inferredLet(l: PsLet, fresh: Spec|None) => match(fresh)
  (t2: Spec) => with l(lType = t2, lTypeInferred = true)
  ()         => l

fun letNames(lets: List<PStmt>) => fold(lets, Set(), (acc, p) => addLetName(acc, p))

fun addLetName(acc: Set<String>, p) => match(p)
  (l: PsLet) => add(acc, l.lName)
  (o: PStmt) => acc

fun withoutLocals(hints: Dict<String, List<Hint>>,
                  stmts: List<PStmt>)
  ret hintsWithout(hints, letNames(build(bindingLets(chain(stmts), builder()))),
                   Set())

fun hasDeclaredRet(f: PsFun) => match(f.fRet)
  (t2: Spec) => !f.fRetInferred
  ()         => false

fun hasBody(f: PsFun) => match(f.fBody)
  (b: PExpr) => true
  ()         => false

# ── the declarations ────────────────────────────────────────────────────────

fun compileTypealias(ta: PsTypealias, r0)
  let r = typealiasScope(ta, r0)
  let ty = compileSpec(ta.taType, r)
  let wheres = compileParams(ta.taWheres, r)
  ret StmtOut(PsTypealias(ta.taName, ta.taAttrs, ta.taGens, ty.soSpec,
                          wheres.psSpecs, ta.pstLine, ta.taImports),
              concat(ty.soGlobals, wheres.psGlobals), noHints())

# Resolve the inherited types (find_classes_or_error) — the resolved specs ARE
# the new implements list; build the SLOT TABLE (own callable members absorb
# the parent slots they override) and the TRANSITIVE parent set with type
# params substituted through (Foo : Bar<Int> where Bar<T> : Baz<T> records
# Baz<Int>). Both tables ground one inheritance level per PASS — a parent's
# own tables settled on an earlier pass — and both are program identity, so
# the fixpoint is not done until they are.
fun compileClass(c, r0): StmtOut
  let r = classScope(c, r0)
  let inh = findClassesOrError(c.cImplements, r)
  let allSlots = overrideInheritedSlots(r0, createSlotsFromMembers(c),
                                        parentSlotsOf(chain(inh), List()))
  let allParents = buildAllParents(chain(inh), r, List())
  let params = compileStmt(c.cParams, r, None)
  let wheres = compileParams(c.cWheres, r)
  # Members compile in the class-BODY scope: the class's fields and methods
  # (MEMBER-scoped) plus `this`, under the generic type params. Each member
  # fn compiles under a TRANSIENT copy carrying the owner's `where` clause
  # (a member declares no generics/wheres of its own — vtable slots have
  # fixed signatures); the stored statement keeps none.
  let members = compileStmts(chain(withOwnerWheres(c.cMembers, c.cWheres)),
                             genScope(c.cGens, c.cWheres, RClassBody(c, r0)), None,
                             builder(), List())
  ret StmtOut(PsClass(c.cName, c.cAttrs, c.cGens, stmtOr(params, c.cParams),
                      resolvedImplements(chain(inh), List()),
                      wheres.psSpecs, stripOwnerWheres(members.slStmts, c.cWheres),
                      c.cIsInterface, c.pscLine, allParents, allSlots,
                      c.cImports),
              concat(params.soExtra,
                     concat(wheres.psGlobals, members.slGlobals)),
              noHints())

# TraitInstanceStatement.compile: pattern + wheres under the instance's
# generic scope; member bodies under a transient copy of the owner's clause
# (stored statements keep none — a member is a vtable slot).
fun compileTraitInstance(inst: PsTraitInstance, r0): StmtOut
  let r = genScope(inst.tiGens, inst.tiWheres, r0)
  let pat = compileSpecOpt(inst.tiPattern, r)
  let wheres = compileParams(inst.tiWheres, r)
  let members = compileStmts(chain(withOwnerWheres(inst.tiMembers,
                                                   inst.tiWheres)),
                             r, None, builder(), List())
  ret StmtOut(PsTraitInstance(inst.tiName, inst.tiAttrs, inst.tiAmbient,
                              inst.tiGens,
                              specOr(pat, inst.tiPattern), wheres.psSpecs,
                              stripOwnerWheres(members.slStmts,
                                               inst.tiWheres),
                              inst.pstiLine, inst.tiImports),
              concat(globalsOfSpec(pat),
                     concat(wheres.psGlobals, members.slGlobals)),
              noHints())

fun specOr(out: SpecOut|None, orig) => match(specOf(out))
  (s2: Spec) => s2
  ()         => orig

# Every member is marked NOT GLOBAL; the owner's clause is grafted on as well
# when it has one. The marking is unconditional because the rule it feeds —
# only a global function declares type parameters — does not depend on whether
# the owner happens to carry a `where`.
fun withOwnerWheres(ms: List<PStmt>, wheres: List<Spec>): List<PStmt>
  ret map(ms, (m) => ownerWhereFn(m, wheres))

fun ownerWhereFn(m, wheres) => match(m)
  (f: PsFun) => PsFun(f.fName, f.fAttrs, f.fGens, f.fParams, f.fBody,
                      f.fRet, isEmpty(wheres) ? f.fWheres : wheres,
                      f.psfLine, f.fRetInferred, f.fNested,
                      f.fImports, false)
  (o: PStmt) => m

fun stripOwnerWheres(ms, wheres: List<Spec>): List<PStmt>
  ret isEmpty(wheres) ? ms : map(ms, (m) => strippedWhereFn(m))

fun strippedWhereFn(m) => match(m)
  (f: PsFun) => PsFun(f.fName, f.fAttrs, f.fGens, f.fParams, f.fBody,
                      f.fRet, List(), f.psfLine, f.fRetInferred,
                      f.fNested, f.fImports)
  (o: PStmt) => m

fun resolvedImplements(fs: Chain<FoundClass>, acc: List<Spec>)
  ret build(resolvedImplementsB(fs, builderFrom(acc)))

fun [tail] resolvedImplementsB(fs: Chain<FoundClass>, [terminal] acc): ListBuilder<Spec>
  ret match(fs)
    (nil: ChainEnd) => acc
    (l: ChainLink)  => resolvedImplementsB(l.next, push(acc, l.value.fcSpec))

fun [tail] parentSlotsOf(fs: Chain<FoundClass>, acc) => match(fs)
  (nil: ChainEnd) => acc
  (l: ChainLink)  => match(l.value.fcClass)
    (cs: PsClass) => parentSlotsOf(l.next, concat(acc, slotsOr(cs.cAllSlots)))
    ()            => parentSlotsOf(l.next, acc)

fun slotsOr(slots: List<Slot>|None) => match(slots)
  (ss: List<Slot>) => ss
  ()               => List()

# Each resolved parent joins the set, then its OWN transitive parents join —
# substituted through this instantiation's type args when both sides carry
# them, so monomorphisation and trait lookup see the concrete spelling.
fun [tail] buildAllParents(fs: Chain<FoundClass>, r: Resolver,
                           acc) => match(fs)
  (nil: ChainEnd) => acc
  (l: ChainLink)  => match(l.value.fcClass)
    (cs: PsClass) => buildAllParents(l.next, r,
                                     parentClosure(l.value.fcSpec, cs, r,
                                                   addSpecOnce(acc,
                                                               l.value.fcSpec)))
    ()            => buildAllParents(l.next, r, acc)

fun parentClosure(spec, cs: PsClass, r: Resolver,
                  acc) => match(cs.cAllParents)
  (ps: List<Spec>) => closureNeedsMapping(spec, cs)
    ? addSubstituted(chain(ps), paramMapping(cs.cGens, specArgsOf(spec)), acc)
    : addSpecsOnce(acc, chain(ps))
  ()               => acc

fun closureNeedsMapping(spec, cs: PsClass) => !isEmpty(cs.cGens) && !isEmpty(specArgsOf(spec))

fun specArgsOf(spec) => match(spec)
  (c: SClass) => c.scParams
  (o: Spec)   => List()

fun [tail] addSubstituted(ps: Chain<Spec>, mapping: List<Binding>,
                          acc) => match(ps)
  (nil: ChainEnd) => acc
  (l: ChainLink)  => addSubstituted(l.next, mapping,
                                    addSpecOnce(acc, substitute(l.value,
                                                                mapping)))

# The enum's LAYOUT is assigned here (_assign_specs): the root's name threads
# down to every variant, the leaf sets are collected, and the field list is
# `$tag` plus every data field any variant declares (deduplicated by name).
# Each node — root and variants alike — gets an EnumSpec whose valid leaves
# are ITS OWN subtree's. Both derived caches are compare=False metadata:
# equality ignores them, so the layout settling never keeps the loop spinning.
fun compileEnum(e: PsEnum, r0): StmtOut
  let r = enumScope(e, r0)
  let params = compileStmt(e.eParams, r, None)
  let variants = compileStmts(chain(e.eVariants), r, None, builder(),
                              List())
  let glb = concat(params.soExtra, variants.slGlobals)
  # Derived equality: a qualifying enum brings its BasicEquality instance
  # with it, placed right after it — once, since an enum that has an
  # instance no longer qualifies. Synthesis reads only names and leaves,
  # which compiling does not change.
  let derived = derivesEquality(r, e.eName)
    ? prepend(Bootstrap::Lower::Ast::derivedInstance(e), List<PStmt>())
    : List<PStmt>()
  # The constructor returns the ROOT statement type — narrow back to the
  # variant to run the layout over the freshly compiled node.
  ret StmtOut(layoutEnum(PsEnum(e.eName, e.eAttrs, e.eGens,
                                stmtOr(params, e.eParams),
                                variants.slStmts, e.eHasParams, e.pseLine,
                                None, None, e.eImports)),
              concat(glb, derived), noHints())

fun layoutEnum(t2: PsEnum)
  let allLeaves = collectLeafNames(t2)
  ret assignSpecs(t2, t2.eName, allLeaves)

# The enum's all_fields, DERIVED from the statement as it currently stands —
# the tag plus every variant's data fields, root-down. State is derived,
# never stored (identity vs state, user ruling 08-08): a reader that derives
# from the CURRENT statement can never see a stale copy. Mirror of Python's
# EnumStatement.derive_all_fields.
fun deriveAllFields(e: PsEnum) => prepend(SField("$tag", SBuiltin("int32", e.pseLine)),
                                          collectDataFields(e))

# The per-pass fields provider: root name -> derived fields, memoized for the
# pass's lifetime (the cache lives in the returned closure — the same scoping
# as every per-pass cache, and THE System::memoize parity site: Python's
# lowering/enum_fields.fields_provider is the mirror). A root with no
# statement (a stale reference to a pruned generic) derives EMPTY fields:
# such a spec is only ever a pointer; its layout is never asked for.
fun enumFieldsProvider(statements: List<PStmt>): (:String): List<SField>
  let reg = efRegistry(chain(statements), Dict())
  ret memoize((root) => efDerive(reg, root))

fun efDerive(reg: Dict<String, PsEnum>, root: String) => match(get(reg, root))
  (e: PsEnum) => deriveAllFields(e)
  ()          => List()

fun [tail] efRegistry(ss: Chain<PStmt>,
                      acc) => match(ss)
  (nil: ChainEnd) => acc
  (l: ChainLink)  => match(l.value)
    (e: PsEnum) => efIsRoot(e)
      ? efRegistry(l.next, put(acc, e.eName, e))
      : efRegistry(l.next, acc)
    (o: PStmt)  => efRegistry(l.next, acc)

fun efIsRoot(e: PsEnum) => match(e.eRootName)
  (r: String) => r == e.eName
  ()          => false

# Resolver-based derivation for compile/check-phase readers (mirror of
# Python access.py's _enum_fields): the statement is the current truth; an
# unreachable root (pruned) has no fields to resolve against. The root's
# per-pass provider serves the hot path (~938k derivations per self-compile
# otherwise — Python memoises the same way in ResolverRoot.get_enum_fields);
# a root without one derives per query as before.
fun enumFieldsVia(r, root) => match(enumFieldsHook(r, root))
  (fs: List<SField>) => fs
  ()                 => enumFieldsDerive(r, root)

fun enumFieldsDerive(r, root) => match(soleItem(findType(r, root)))
  (f: Found) => match(f.fStmt)
    (e: PsEnum) => deriveAllFields(e)
    (o: PStmt)  => List()
  ()         => List()

# _collect_leaf_names: a node with no variants IS a leaf — unless it also has
# no parameter list, which is the uninhabited empty type (`enum Never`).
fun collectLeafNames(e: PsEnum) => isEmpty(e.eVariants)
  ? (e.eHasParams ? prepend(e.eName, List()) : List())
  : leafLoop(chain(e.eVariants), List())

fun [tail] leafLoop(vs: Chain<PStmt>, acc: List<String>) => match(vs)
  (nil: ChainEnd) => acc
  (l: ChainLink)  => match(l.value)
    (v: PsEnum) => leafLoop(l.next, concat(acc, collectLeafNames(v)))
    (o: PStmt)  => leafLoop(l.next, acc)

# _collect_data_fields: every TYPED constructor field in the whole tree, first
# declaration wins (deduplicated by name). Mirrors Python's seen-set + append
# (types.py _collect_data_fields): the dedup reads the SET, so the fields ride
# ONE builder in declaration order — the old per-add list rebuild cost 1.4e9
# pushes per self-compile (fields are DERIVED per read, so this path is hot).
class [linear, final] FieldAcc(faSeen: Set<String>, faOut: ListBuilder<SField>)

fun collectDataFields(e: PsEnum)
  ret build(dfVariants(chain(e.eVariants),
            dfParams(chain(flattenParams(e.eParams)),
                     FieldAcc(Set(), builder()))).faOut)

fun dfVariants(vs: Chain<PStmt>, [terminal] acc: FieldAcc) => match(vs)
  (nil: ChainEnd) => acc
  (l: ChainLink)  => match(l.value)
    (v: PsEnum) => dfVariants(l.next,
                              dfVariants(chain(v.eVariants),
                                         dfParams(chain(flattenParams(v.eParams)),
                                                  acc)))
    (o: PStmt)  => dfVariants(l.next, acc)

fun [tail] dfParams(ls: Chain<PStmt>, [terminal] acc: FieldAcc) => match(ls)
  (nil: ChainEnd) => acc
  (l: ChainLink)  => match(l.value)
    (let2: PsLet) => match(let2.lType)
      (ty: Spec) => dfParams(l.next, addFieldOnce(acc, let2.lName, ty))
      ()         => dfParams(l.next, acc)
    (o: PStmt)    => dfParams(l.next, acc)

fun addFieldOnce([terminal] acc: FieldAcc, name, ty)
  let seen = acc.faSeen
  let out = acc.faOut
  ret contains(seen, name)
    ? FieldAcc(seen, out)
    : FieldAcc(add(seen, name), push(out, SField(name, ty)))

fun [tail] hasFieldNamed(fs: Chain<SField>, name: String) => match(fs)
  (nil: ChainEnd) => false
  (l: ChainLink)  => l.value.sfName == name ? true : hasFieldNamed(l.next, name)

# _assign_specs: root name, the SHARED all-leaves, and each node's OWN
# valid-leaf subset, recursively onto every variant. Fields are DERIVED —
# never assigned (identity vs state).
fun assignSpecs(e: PsEnum, root, allLeaves)
  ret PsEnum(e.eName, e.eAttrs, e.eGens, e.eParams,
             assignAllSpecs(chain(e.eVariants), root, allLeaves,
                            List()),
             e.eHasParams, e.pseLine, root,
             SEnum(root, collectLeafNames(e), allLeaves, List(),
                   e.pseLine),
             e.eImports)

fun assignAllSpecs(vs, root,
                          allLeaves,
                          acc: List<PStmt>): List<PStmt>
  ret build(assignAllSpecsB(vs, root, allLeaves, builderFrom(acc)))

fun [tail] assignAllSpecsB(vs: Chain<PStmt>, root,
                          allLeaves,
                          [terminal] acc: ListBuilder<PStmt>) => match(vs)
  (nil: ChainEnd) => acc
  (l: ChainLink)  => match(l.value)
    (v: PsEnum) => assignAllSpecsB(l.next, root, allLeaves,
                                  push(acc, assignSpecs(v, root,
                                                  allLeaves)))
    (o: PStmt)  => assignAllSpecsB(l.next, root, allLeaves,
                                  push(acc, l.value))

# ── control ─────────────────────────────────────────────────────────────────

# A return converges on the FUNCTION's return type — that is how the expected
# type reaches every tail of the body.
fun compileRet(rt: PsRet, r, retType)
  let v = compileExpr(rt.retValue, r, retType)
  ret StmtOut(PsRet(v.eoExpr, rt.psrLine), v.eoGlobals, v.eoHints)

fun compileAction(a: PsAction, r)
  let v = compileExpr(a.action, r, None)
  ret StmtOut(PsAction(v.eoExpr, a.psaLine), v.eoGlobals, v.eoHints)

# Each branch folds its OWN else-if chain before compiling (the second fold
# site — a block's statement list is the first).
fun compileIf(i: PsIf, r, retType): StmtOut
  let cond = compileExpr(i.ifCond, r, SBuiltin("bool", i.psifLine))
  let t0 = collapseElseIf(i.ifTrue)
  let f0 = collapseElseIf(i.ifFalse)
  let t2 = compileStmts(chain(t0), blockScope(t0, r), retType,
                        builder(), List())
  let f = compileStmts(chain(f0), blockScope(f0, r), retType,
                       builder(), List())
  ret StmtOut(PsIf(cond.eoExpr, t2.slStmts, f.slStmts, i.psifLine),
              concat(cond.eoGlobals, concat(t2.slGlobals, f.slGlobals)),
              mergeHints(cond.eoHints,
                         mergeHints(withoutLocals(t2.slHints, t2.slStmts),
                                    withoutLocals(f.slHints, f.slStmts))))

# ── collapse_else_if ─────────────────────────────────────────────────────────
# Fold an IfStatement followed by zero or more ElseIfStatements and at most
# one ElseStatement into a single RIGHT-NESTED IfStatement. An orphan else-if
# / else (no preceding if) passes through unchanged; check reports it.
#
# Idempotent: an if with no trailing arms passes through untouched, preserving
# the false branch a previous pass folded in.

fun collapseElseIf(stmts: List<PStmt>) => ceiLoop(chain(stmts), List())

fun ceiLoop(ss, acc: List<PStmt>): List<PStmt> => build(ceiLoopB(ss, builderFrom(acc)))

fun [tail] ceiLoopB(ss: Chain<PStmt>, [terminal] acc: ListBuilder<PStmt>) => match(ss)
  (nil: ChainEnd) => acc
  (l: ChainLink)  => match(l.value)
    (i: PsIf)  => foldChain(i, l.next)
      |> (fc) => ceiLoopB(fc.fcRest, push(acc, fc.fcIf))
    (o: PStmt) => ceiLoopB(l.next, push(acc, l.value))

class [final] FoldedChain(fcIf: PStmt, fcRest: Chain<PStmt>)

# Gather the trailing else-if siblings; an else CONSUMES and stops, anything
# else stops without consuming.
fun foldChain(i, rest) => gatherArms(rest, List(), i)

# Arms accumulate INNERMOST-FIRST (prepend), which is the order nestArms
# consumes them in — so nothing is reversed. Python builds them in source order
# and walks back with `reversed(chain)` (control.py), which is free over a
# native list; a singly-linked Chain has no backward walk, so the port would
# have to materialise the reversal. Building backwards instead costs nothing
# and keeps the list FRONT-NORMAL: prepend conses onto the front, so the rear
# stays empty and no chain reversal is ever triggered downstream either.
fun [tail] gatherArms(ss, arms, i) => match(ss)
  (nil: ChainEnd) => finishFold(i, arms, None, ss)
  (l: ChainLink)  => match(l.value)
    (ei: PsElseIf) => gatherArms(l.next, prepend(l.value, arms), i)
    (el: PsElse)   => finishFold(i, arms, el.elStmts, l.next)
    (o: PStmt)     => finishFold(i, arms, None, ss)

fun finishFold(i, arms: List<PStmt>, elseBody: List<PStmt>|None,
               rest) => isEmpty(arms) && elseBody is None
  ? FoldedChain(i, rest)
  : FoldedChain(PsIf(i.ifCond, i.ifTrue,
                     nestArms(chain(arms), elseTail(elseBody)),
                     i.psifLine),
                rest)

fun elseTail(elseBody: List<PStmt>|None) => match(elseBody)
  (b: List<PStmt>) => b
  ()               => List()

# Right-nest the arms, innermost first: each else-if becomes an If whose false
# branch is everything folded so far.
fun [tail] nestArms(armsRev: Chain<PStmt>, tail2) => match(armsRev)
  (nil: ChainEnd) => tail2
  (l: ChainLink)  => match(l.value)
    (ei: PsElseIf) => nestArms(l.next,
                               prepend(PsIf(ei.eiCond, ei.eiStmts, tail2,
                                           ei.pseiLine), List()))
    (o: PStmt)     => nestArms(l.next, tail2)

# ── lists ───────────────────────────────────────────────────────────────────

class [final] StmtsOut(slStmts: List<PStmt>, slGlobals: List<PStmt>,
                       slHints: Dict<String, List<Hint>>)

fun compileStmts(ss: Chain<PStmt>, r: Resolver, retType: Spec|None,
                 [terminal] acc: ListBuilder<PStmt>,
                 glb: List<PStmt>): StmtsOut => compileStmtsB(ss, r, retType, acc, glb, noHints())

fun [tail] compileStmtsB(ss: Chain<PStmt>, r, retType,
                         [terminal] acc,
                         glb,
                         hints) => match(ss)
  (nil: ChainEnd) => StmtsOut(build(acc), glb, hints)
  (l: ChainLink)  => compileStmt(l.value, r, retType)
    |> (one) => compileStmtsB(l.next, r, retType, addStmt(acc, one.soStmt),
                              concat(glb, one.soExtra),
                              mergeHints(hints, one.soHints))

fun addStmt([terminal] acc, st: PStmt|None): ListBuilder<PStmt> => match(st)
  (x: PStmt) => push(acc, x)
  ()         => acc

# ── small helpers ───────────────────────────────────────────────────────────

fun compileExprOpt(x: PExpr|None, r, expected): ExprOut|None => match(x)
  (e: PExpr) => compileExpr(e, r, expected)
  ()         => None

fun exprOf(o: ExprOut|None): PExpr|None => match(o)
  (e: ExprOut) => e.eoExpr
  ()           => None

fun globalsOf(o: ExprOut|None) => match(o)
  (e: ExprOut) => e.eoGlobals
  ()           => List()

fun hintsOf(o: ExprOut|None) => match(o)
  (e: ExprOut) => e.eoHints
  ()           => noHints()

fun specOf(o: SpecOut|None): Spec|None => match(o)
  (s2: SpecOut) => s2.soSpec
  ()            => None

fun globalsOfSpec(o: SpecOut|None) => match(o)
  (s2: SpecOut) => s2.soGlobals
  ()            => List()

fun stmtOr(o: StmtOut, fallback) => match(o.soStmt)
  (x: PStmt) => x
  ()         => fallback
