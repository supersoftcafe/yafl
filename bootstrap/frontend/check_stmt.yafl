# bootstrap/check_stmt.yafl — Statement.check per kind, ported from the
# check() methods in compiler/pyast/statement/. Message strings VERBATIM.
namespace Bootstrap::Frontend

import System

import Bootstrap::Ast
import Bootstrap::Parse
import Bootstrap::Resolve
import Bootstrap::Types



fun checkStmtKind(st, r, retTy: Spec|None) => match(st)
  (f: PsFun)         => checkFun2(f, r)
  (l: PsLet)         => checkLet2(l, r)
  (d: PsDestructure) => checkDestructure2(d, r)
  (c: PsClass)       => checkClass2(c, r)
  (e2: PsEnum)       => checkEnum2(e2, r)
  (ta: PsTypealias)  => checkTypealias2(ta, r)
  (rt: PsRet)        => checkRet2(rt, r, retTy)
  (a: PsAction)      => checkAction2(a, r)
  (i: PsIf)          => checkIf2(i, r, retTy)
  (ei: PsElseIf)     => oneErr(ei.pseiLine,
                               "`else if` without a matching preceding `if`")
  (el: PsElse)       => oneErr(el.pselLine,
                               "`else` without a matching preceding `if`")
  (im: PsImport)     => noErrs()
  (ns: PsNamespace)  => noErrs()
  (inst: PsTraitInstance) => checkTraitInstance(inst, r)

# ── TraitInstanceStatement ──────────────────────────────────────────────────
# Pattern + wheres under the generic scope; members under the transient
# owner-wheres copy; the pattern must name an INTERFACE.

fun checkTraitInstance(inst: PsTraitInstance, r0): Set<PErr>
  let r = genScope(inst.tiGens, inst.tiWheres, r0)
  let e1 = checkSpecOpt(inst.tiPattern, r)
  let e2 = checkSpecs(inst.tiWheres, r, noErrs())
  let e3 = branchChecks((withOwnerWheres(inst.tiMembers, inst.tiWheres)),
                        r, None, noErrs())
  ret union(e1, union(e2, union(e3,
      union(instancePatternErrs(inst, r),
             attrErrs(inst.tiAttrs, isKnownInstanceAttr, inst.pstiLine,
                      "an instance")))))

fun instancePatternErrs(inst: PsTraitInstance, r) => match(inst.tiPattern)
  (c: SClass) => match(soleItem(findType(r, c.scName)))
    (f: Found) => match(f.fStmt)
      (cls: PsClass) => cls.cIsInterface
        ? noErrs()
        : oneErr(inst.pstiLine,
                 "an instance implements an interface, not a class")
      (o: PStmt)     => noErrs()
    ()         => noErrs()
  (o: Spec)   => noErrs()

# ── FunctionStatement ───────────────────────────────────────────────────────

fun checkFun2(f: PsFun, r0): Set<PErr>
  let r = genScope(f.fGens, f.fWheres, r0)
  let bodyR = localScope(paramLets(f.fParams),
                         f.fNested ? r : traitScope(f.fWheres, r))
  let err1 = checkSpecOpt(f.fRet, r)
  let err2 = checkStmt2(f.fParams, r, None)
  let err3 = match(f.fBody)
    (b: PExpr) => checkExpr(b, bodyR, f.fRet)
    ()         => noErrs()
  let err4 = checkSpecs(f.fWheres, r, noErrs())
  ret union(err1,
      union(err2,
      union(err3,
      union(err4,
      union(funAttrErrs(f),
      union(paramDefaultErrs(flattenParams(f.fParams), r, noErrs()),
      union(missingRetErrs(f, bodyR),
      # A top-level function's are reported before the check phase.
      union(f.fGlobal ? noErrs() : funUntypedErrors(f, bodyR, noErrs()),
      union(attrErrs(f.fAttrs, isKnownFunAttr, f.psfLine, "a function"),
             unusedParamWarns(f))))))))))

# A declared result must actually be produced: a body that type-checks to no
# value (no `ret` reaches the function block and no trailing value) would
# generate `Return(None)` and crash codegen — a bare tail-call STATEMENT where
# `ret f(...)` was meant.
fun missingRetErrs(f: PsFun, bodyR): Set<PErr> => match(f.fBody)
  (b: PExpr) => hasDeclaredRet(f)
    ? (exprType(b, bodyR) is None
        ? oneErr(f.psfLine, "function '" + bareOfUnique(f.fName)
                            + "' declares a result but its body never returns a value — missing `ret`?")
        : noErrs())
    : (f.fRet is None || exprType(b, bodyR) is None
        ? oneErr(f.psfLine, "Return type of '" + bareOfUnique(f.fName)
                            + "' could not be inferred — declare it")
        : noErrs())
  ()         => noErrs()

fun funAttrErrs(f: PsFun) => union(foreignErrs(f),
                             union(noArgAttr(f, "impure", "[impure] takes no arguments"),
                             union(noArgAttr(f, "sync", "[sync] takes no arguments"),
                             union(tailErrs(f),
                             union(noArgAttr(f, "terminal", "[terminal] takes no arguments"),
                             union(testErrs(f),
                                    innerWhereErrs(f)))))))

# ── unknown attributes ──────────────────────────────────────────────────────
# Attributes parse as an OPEN `[name]` / `[name(expr)]` list, so without this
# every kind silently ignored any attribute it did not happen to consult:
# `[tset]` compiled clean and did nothing. Each kind declares the set it
# honours; anything else is a CHECK error, not a no-op. Walked in SOURCE order
# so a declaration carrying two unknown attributes reports them in the same
# order as the Python side (base.py `unknown_attribute_errors`).

fun [tail] unknownAttrErrs(as2: List<PAttr>, known: (:String): Bool,
                           lr, kind, acc): Set<PErr> => isEmpty(as2)
  ? acc
  : known(first(as2).attrName)
    ? unknownAttrErrs(tail(as2), known, lr, kind, acc)
    : unknownAttrErrs(tail(as2), known, lr, kind,
        add(acc, PErr(lr, "unknown attribute [" + first(as2).attrName
                          + "] on " + kind)))

fun attrErrs(attrs: List<PAttr>, known: (:String): Bool, lr,
             kind): Set<PErr> => unknownAttrErrs(attrs, known, lr, kind, noErrs())

fun isKnownFunAttr(n) => n == "foreign" || n == "impure" || n == "sync" || n == "tail"
 || n == "terminal" || n == "inline" || n == "hashed" || n == "refeq"
 || n == "linear" || n == "lazy" || n == "final" || n == "future"
 || n == "pinnable" || n == "test"

fun isKnownClassAttr(n) => n == "final" || n == "linear" || n == "foreign" || n == "pinnable"
 || n == "hashed" || n == "refeq" || n == "mutable"

fun isKnownLetAttr(n) => n == "terminal" || n == "const" || n == "lazy" || n == "trait"
 || n == "future" || n == "linear" || n == "final" || n == "mutable"
 || n == "ambient" || n == "pinnable"

fun isKnownEnumAttr(n) => n == "hashed" || n == "refeq" || n == "linear" || n == "final"

fun isKnownTypealiasAttr(n) => n == "linear"

fun isKnownInstanceAttr(n) => n == "ambient" || n == "trait"

fun attrValueOf(attrs: List<PAttr>, name: String) => avLoop(attrs, name)

fun [tail] avLoop(as2: List<PAttr>, name: String) => isEmpty(as2)
  ? None
  : first(as2).attrName == name
    ? first(as2).attrValue
    : avLoop(tail(as2), name)

fun noArgAttr(f: PsFun, name: String, msg)
  if !hasAttr(f.fAttrs, name)
    ret noErrs()
  ret match(attrValueOf(f.fAttrs, name))
    (v: PExpr) => oneErr(f.psfLine, msg)
    ()         => noErrs()

fun foreignErrs(f: PsFun)
  if !hasAttr(f.fAttrs, "foreign")
    ret noErrs()
  if !isOneStringArg(attrValueOf(f.fAttrs, "foreign"))
    ret oneErr(f.psfLine,
               "[foreign] requires exactly one string argument: [foreign(\"symbol\")]")
  ret match(f.fBody)
    (b: PExpr) => oneErr(f.psfLine, "[foreign] functions must have no body")
    ()         => noErrs()

# [test] — the unit-test annotation (docs/testing-proposal.md). The optional
# argument is the description. The RETURN TYPE is deliberately not checked
# here: `--test` puts the function in a TestCase whose `body` field is typed
# `(): System::None|TestFailure`, so a wrong return type is caught there by
# ordinary type checking rather than by a rule restated in two compilers.
fun testErrs(f: PsFun)
  if !hasAttr(f.fAttrs, "test")
    ret noErrs()
  let argErr = testArgErr(f)
  let bodyErr = match(f.fBody)
    (b: PExpr) => noErrs()
    ()         => oneErr(f.psfLine,
                         "[test] cannot be applied to a foreign function")
  let paramErr = isEmpty(flattenParams(f.fParams))
    ? noErrs()
    : oneErr(f.psfLine, "[test] functions take no parameters")
  ret union(argErr, union(bodyErr, paramErr))

# Absent is fine (the description is optional); present must be one string.
fun testArgErr(f: PsFun) => match(attrValueOf(f.fAttrs, "test"))
  (v: PExpr) => isOneStringArg(v)
    ? noErrs()
    : oneErr(f.psfLine,
             "[test] takes one optional string argument: [test(\"description\")]")
  ()         => noErrs()

fun isOneStringArg(v: PExpr|None) => match(v)
  (x: PExpr) => match(x)
    (tp: PeTuple) => exactly(tp.exprs, 1) && firstIsString(head(tp.exprs))
    (o: PExpr)    => false
  ()         => false

fun firstIsString(en: PTupEnt|None) => match(en)
  (e2: PTupEnt) => match(e2.tupValue)
    (s2: PeStr) => true
    (o: PExpr)  => false
  ()            => false

fun tailErrs(f: PsFun)
  if !hasAttr(f.fAttrs, "tail")
    ret noErrs()
  let argErr = noArgAttr(f, "tail", "[tail] takes no arguments")
  ret match(f.fBody)
    (b: PExpr) => argErr
    ()         => union(argErr,
                         oneErr(f.psfLine,
                                "[tail] cannot be applied to a foreign function"))

# An inner function declares neither a `where` nor type parameters: it has no
# scope of its own but inherits its owner's, so a `where` here would silently do
# nothing and a type parameter would rebind a name that is already bound — a
# restated `<T>` resolves ambiguously, a fresh `<X>` is not in scope inside its
# own body.
fun innerWhereErrs(f: PsFun) => union(!f.fGlobal && !isEmpty(f.fGens)
                                        ? oneErr(f.psfLine,
                                                 "only a global function declares type parameters — an inner function inherits the enclosing function's, a member function its class or instance's")
                                        : noErrs(),
                                      f.fNested && !isEmpty(f.fWheres)
                                        ? oneErr(f.psfLine,
                                                 "`where` is not allowed on an inner function — move it to a top-level function")
                                        : noErrs())

fun [tail] paramDefaultErrs(ls: List<PStmt>, r,
                            acc: Set<PErr>) => isEmpty(ls)
  ? acc
  : match(first(ls))
    (let2: PsLet) => paramDefaultErrs(tail(ls), r,
                       union(acc, defaultValueErrors(let2.lDefault, r,
                                                      let2.pslLine,
                                                      "parameter")))
    (o: PStmt)    => paramDefaultErrs(tail(ls), r, acc)

# No value vanishes silently: a parameter the body never reads. `this` is
# implicit; a `_` prefix is the opt-out; [terminal] params are consumed on
# arrival.
fun unusedParamWarns(f: PsFun): Set<PErr> => match(f.fBody)
  (b: PExpr) => unusedParamLoop(flattenParams(f.fParams),
                                referencedNames(b, List()), noErrs())
  ()         => noErrs()


fun [tail] unusedParamLoop(ls: List<PStmt>, referenced: List<String>,
                           acc: Set<PErr>) => isEmpty(ls)
  ? acc
  : match(first(ls))
    (let2: PsLet) => skipParamWarn(let2, referenced)
      ? unusedParamLoop(tail(ls), referenced, acc)
      : unusedParamLoop(tail(ls), referenced,
          add(acc, PErr(let2.pslLine,
                           "parameter '" + bareOfUnique(let2.lName)
                           + "' is never used", true, "unused-parameter")))
    (o: PStmt)    => unusedParamLoop(tail(ls), referenced, acc)

fun skipParamWarn(let2: PsLet, referenced: List<String>)
  ret startsWith(bareOfUnique(let2.lName), "_")
      || bareOfUnique(let2.lName) == "this"
      || hasAttr(let2.lAttrs, "terminal")
      || contains2(referenced, let2.lName)

# ── LetStatement / DestructureStatement ─────────────────────────────────────

fun checkLet2(l: PsLet, r)
  let bad = letTypeErr(l, r)
  ret isEmpty(bad) ? letSubErrs(l, r) : bad

fun letTypeErr(l: PsLet, r) => match(l.lDefault)
  (d: PExpr) => match(l.lType)
    (want: Spec) => match(exprType(d, r))
      (xt: Spec) => triFalse(assignableEq(r, want, xt))
        ? oneErr(l.pslLine, "Incorrect type")
        : noErrs()
      ()         => noErrs()
    ()           => noErrs()
  ()         => noErrs()

fun letSubErrs(l: PsLet, r)
  let err1 = match(l.lDefault)
    (d: PExpr) => checkExpr(d, r, l.lType)
    ()         => noErrs()
  let err2 = checkSpecOpt(l.lType, r)
  let whereErr = checkSpecs(l.lWheres, r, noErrs())
  ret union(err1, union(err2, union(letAttrErrs(l, r), whereErr)))

fun letAttrErrs(l: PsLet, r: Resolver)
  ret union(constErrs(l),
      union(lazyFutureErrs(l),
             attrErrs(l.lAttrs, isKnownLetAttr, l.pslLine, "a let")))

fun constErrs(l: PsLet)
  if !hasAttr(l.lAttrs, "const")
    ret noErrs()
  let argErr = letAttrArgErr(l, "const", "[const] takes no arguments")
  ret isConstLiteral(l.lDefault)
    ? argErr
    : union(argErr, oneErr(l.pslLine, "[const] requires a literal value"))

fun letAttrArgErr(l: PsLet, name: String, msg) => match(attrValueOf(l.lAttrs, name))
  (v: PExpr) => oneErr(l.pslLine, msg)
  ()         => noErrs()

fun hasInit(l: PsLet) => match(l.lDefault)
  (d: PExpr) => true
  ()         => false

fun isConstLiteral(d: PExpr|None) => match(d)
  (x: PExpr) => isLiteralValue(x)
  ()         => false

fun lazyFutureErrs(l: PsLet) => union(lazyErrs(l), futureErrs(l))

fun lazyErrs(l: PsLet)
  if !hasAttr(l.lAttrs, "lazy")
    ret noErrs()
  let argErr = letAttrArgErr(l, "lazy", "[lazy] takes no arguments")
  ret hasInit(l)
    ? argErr
    : union(argErr, oneErr(l.pslLine, "[lazy] requires an initialiser"))

fun futureErrs(l: PsLet)
  if !hasAttr(l.lAttrs, "future")
    ret noErrs()
  let argErr = letAttrArgErr(l, "future", "[future] takes no arguments")
  let initErr = hasInit(l)
    ? noErrs()
    : oneErr(l.pslLine, "[future] requires an initialiser")
  let bothErr = hasAttr(l.lAttrs, "lazy")
    ? oneErr(l.pslLine,
             "[lazy] and [future] are mutually exclusive — a future IS "
             + "lazy when the worker pool is busy; pick one")
    : noErrs()
  ret union(argErr, union(initErr, bothErr))

# A destructure inherits the let rules (Python: DestructureStatement extends
# LetStatement and does not override check).
fun checkDestructure2(d: PsDestructure, r)
  let typeErr = match(d.dDefault)
    (x: PExpr) => match(d.dType)
      (want: Spec) => match(exprType(x, r))
        (xt: Spec) => triFalse(assignableEq(r, want, xt))
          ? oneErr(d.psdLine, "Incorrect type")
          : noErrs()
        ()         => noErrs()
      ()           => noErrs()
    ()         => noErrs()
  if !isEmpty(typeErr)
    ret typeErr
  let err1 = match(d.dDefault)
    (x: PExpr) => checkExpr(x, r, d.dType)
    ()         => noErrs()
  ret union(err1, checkSpecOpt(d.dType, r))

# ── control ─────────────────────────────────────────────────────────────────

fun checkRet2(rt: PsRet, r, retTy: Spec|None) => match(exprType(rt.retValue, r))
  (xt: Spec) if triFalse(assignableEq(r, retTy, xt)) =>
      oneErr(rt.psrLine, "Incorrect return type")
  ()         => checkExpr(rt.retValue, r, retTy)

# No value vanishes silently: a statement-position expression discards its
# result. Unit carries nothing and is fine; anything else warns.
fun checkAction2(a: PsAction, r)
  let errs = checkExpr(a.action, r, None)
  ret match(exprType(a.action, r))
    (xt: Spec) => isUnitType(xt)
      ? errs
      : add(errs, PErr(a.psaLine,
                          "statement value is discarded — bind it to '_' to "
                          + "discard explicitly", true, "discarded-value"))
    ()         => errs

fun isUnitType(xt) => match(xt)
  (tp: STuple) => isEmpty(tp.stEntries)
  (o: Spec)    => false

fun checkIf2(i: PsIf, r, retTy: Spec|None): Set<PErr>
  let condErr = checkExpr(i.ifCond, r, SBuiltin("bool", i.psifLine))
  let boolErr = match(exprType(i.ifCond, r))
    (ct: Spec) => triTrue(assignableEq(r, SBuiltin("bool", i.psifLine), ct))
      ? noErrs()
      : oneErr(exprLine(i.ifCond), "if condition must be Bool")
    ()         => noErrs()
  ret union(condErr,
      union(boolErr,
      union(branchChecks(i.ifTrue, blockScope(i.ifTrue, r), retTy,
                          noErrs()),
             branchChecks(i.ifFalse, blockScope(i.ifFalse, r), retTy,
                          noErrs()))))

fun [tail] branchChecks(ss: List<PStmt>, r: Resolver, retTy: Spec|None,
                        acc: Set<PErr>): Set<PErr> => isEmpty(ss)
  ? acc
  : branchChecks(tail(ss), r, retTy,
                                  union(acc, checkStmt2(first(ss), r, retTy)))

# ── classes / enums / typealiases ───────────────────────────────────────────

fun checkClass2(c, r0) => match(c.cAllParents)
  (ps: List<Spec>) => classChecks(c, r0)
  ()               => oneErr(c.pscLine, "Missed compile step")

# NOT PORTED YET: the [foreign]-class rules and the slot multi-override /
# no-implementation checks (classdef.py:235-260, needs invert_and_merge_slots)
# — the check contract's first-diff will demand them when a corpus case does.
fun classChecks(c, r0): Set<PErr>
  let inh = findClassesOrError(c.cImplements, r0)
  let implErr = implErrors(c.cImplements, r0, noErrs())
  let pureErr = allPureInterfaces(inh)
    ? noErrs()
    : oneErr(c.pscLine, "Must only inherit from pure interfaces")
  let finalErr = finalParentErrs(c, inh, noErrs())
  let fragile = fragileWarns(c, inh, r0)
  let prmErr = checkStmt2(c.cParams, genScope(c.cGens, c.cWheres, r0), None)
  # Member fns CHECK under the same transient owner-wheres copy they
  # compiled under (compile_stmt withOwnerWheres).
  let stmErr = branchChecks((withOwnerWheres(c.cMembers, c.cWheres)),
                            genScope(c.cGens, c.cWheres, RClassBody(c, r0)), None,
                            noErrs())
  ret union(implErr,
      union(pureErr,
      union(finalErr,
      union(fragile,
      union(prmErr,
      union(stmErr,
      union(arrayFieldErrs(c, r0),
             attrErrs(c.cAttrs, isKnownClassAttr, c.pscLine,
                      c.cIsInterface ? "an interface" : "a class"))))))))

# The trailing array field: at most one, the class [final], and its length
# field an Int32 sibling.
fun arrayFieldErrs(c: PsClass, r: Resolver)
  let fields = classFields(c)
  let arrays = arrayFieldsOf(fields, List())
  if isEmpty(arrays)
    ret noErrs()
  let countErr = atLeast(arrays, 2)
    ? oneErr(c.pscLine, "a class may have at most one array field")
    : noErrs()
  let finalErr2 = hasAttr(c.cAttrs, "final")
    ? noErrs()
    : oneErr(c.pscLine, "a class with an array field must be [final]")
  ret union(countErr,
             union(finalErr2, lenFieldErrs(arrays, fields, noErrs())))

fun classFields(c: PsClass)
  ret concat(flattenParams(c.cParams), letMembers(c.cMembers,
                                                  List()))

fun letMembers(ms, acc: List<PStmt>): List<PStmt> => (letMembersB(ms, acc))

fun [tail] letMembersB(ms: List<PStmt>, [terminal] acc: List<PStmt>) => isEmpty(ms)
  ? acc
  : match(first(ms))
    (let2: PsLet) => letMembersB(tail(ms), append(acc, first(ms)))
    (o: PStmt)    => letMembersB(tail(ms), acc)

fun arrayFieldsOf(fs, acc: List<PStmt>): List<PStmt> => (arrayFieldsOfB(fs, acc))

fun [tail] arrayFieldsOfB(fs: List<PStmt>, [terminal] acc: List<PStmt>) => isEmpty(fs)
  ? acc
  : isArrayStorage(first(fs))
    ? arrayFieldsOfB(tail(fs), append(acc, first(fs)))
    : arrayFieldsOfB(tail(fs), acc)

fun [tail] lenFieldErrs(as2: List<PStmt>, fields: List<PStmt>,
                        acc: Set<PErr>) => isEmpty(as2)
  ? acc
  : match(first(as2))
    (af: PsLet) => lenFieldErrs(tail(as2), fields,
                                union(acc, oneLenErr(af, fields)))
    (o: PStmt)  => lenFieldErrs(tail(as2), fields, acc)

fun oneLenErr(af: PsLet, fields: List<PStmt>)
  let lenName = arrayLenName(af.lType)
  ret match(fieldNamed2(fields, lenName))
    (m: PsLet) => isInt32Field(m)
      ? noErrs()
      : oneErr(af.pslLine, "array length field '" + lenName
                           + "' must be of type Int32")
    ()         => oneErr(af.pslLine, "array length field '" + lenName
                                     + "' is not a field of this class")

fun arrayLenName(ty: Spec|None) => match(ty)
  (t2: Spec) => match(t2)
    (af: SArrayField) => af.safLenField
    (o: Spec)         => ""
  ()         => ""

fun [tail] fieldNamed2(fs: List<PStmt>, name) => isEmpty(fs)
  ? None
  : match(first(fs))
    (let2: PsLet) => matchName(let2.lName, name)
      ? let2
      : fieldNamed2(tail(fs), name)
    (o: PStmt)    => fieldNamed2(tail(fs), name)

fun isInt32Field(m: PsLet) => match(m.lType)
  (t2: Spec) => match(t2)
    (b: SBuiltin) => b.sbName == "int32"
    (o: Spec)     => false
  ()         => false

# find_classes_or_error's ERROR half, reconstructed with the same messages.
fun [tail] implErrors(ts: List<Spec>, r,
                      acc) => isEmpty(ts)
  ? acc
  : implErrors(tail(ts), r, union(acc, implError(first(ts), r)))

fun implError(xtype, r) => match(xtype)
  (n: SNamed) => implNameError(n.snName, ctSpecLine(xtype), r)
  (c: SClass) => implNameError(c.scName, ctSpecLine(xtype), r)
  (o: Spec)   => oneErr(ctSpecLine(xtype),
                        "Class cannot inherit from this type \"<class 't'>\"")

fun implNameError(name, lr, r)
  let found = findType(r, name)
  if isEmpty(found.bItems)
    ret oneErr(lr, "Could not find class named \"" + name + "\"")
  if atLeast(found.bItems, 2)
    ret oneErr(lr, "Found too many classes named \"" + name + "\"")
  ret match(soleItem(found))
    (f: Found) => match(f.fStmt)
      (cs: PsClass) => noErrs()
      (o: PStmt)    => oneErr(lr, "Found non-class named \"" + name + "\"")
    ()         => noErrs()

fun [tail] allPureInterfaces(fs: List<FoundClass>) => isEmpty(fs)
  ? true
  : match(first(fs).fcClass)
    (cs: PsClass) => cs.cIsInterface ? allPureInterfaces(tail(fs)) : false
    ()            => allPureInterfaces(tail(fs))


fun [tail] finalParentErrs(c: PsClass, fs: List<FoundClass>,
                           acc): Set<PErr> => isEmpty(fs)
  ? acc
  : match(first(fs).fcClass)
    (cs: PsClass) => hasAttr(cs.cAttrs, "final")
      ? finalParentErrs(c, tail(fs),
          add(acc, PErr(c.pscLine,
                           "Cannot inherit from final class '" + cs.cName
                           + "'")))
      : finalParentErrs(c, tail(fs), acc)
    ()            => finalParentErrs(c, tail(fs), acc)

# Fragile-base warning: one method overriding several similar methods of a
# SINGLE immediate parent.
fun fragileWarns(c: PsClass, inh: List<FoundClass>, r)
  ret fbLoop(createSlotsFromMembers(c), c, inh, r, noErrs())

fun [tail] fbLoop(bs: List<Slot>, c: PsClass, inh: List<FoundClass>,
                  r, acc: Set<PErr>) => isEmpty(bs)
  ? acc
  : fbLoop(tail(bs), c, inh, r,
                            fbParents(first(bs), inh, c, r, acc))

fun [tail] fbParents(slot: Slot, fs: List<FoundClass>, c: PsClass,
                     r, acc): Set<PErr> => isEmpty(fs)
  ? acc
  : match(first(fs).fcClass)
    (p: PsClass) => fbParents(slot, tail(fs), c, r,
                              fbOne(slot, p, c, r, acc))
    ()           => fbParents(slot, tail(fs), c, r, acc)

fun fbOne(slot: Slot, p: PsClass, c: PsClass, r,
          acc): Set<PErr>
  let nCaptured = capturedCount(createSlotsFromMembers(p), slot, r,
                                List(), 0)
  ret nCaptured > 1
    ? add(acc, PErr(c.pscLine,
                       "`" + bareOfUnique(slot.slotName) + "` overrides "
                       + String(nCaptured) + " similar methods of `"
                       + bareOfUnique(p.cName)
                       + "` at once — a broad override silently captures "
                       + "them; give it a narrower signature or override "
                       + "each explicitly", true, "fragile-base"))
    : acc

# The deduped capture count, taken on the SAME walk that dedups — the names
# exist only to dedup; the diagnostic needs the count (no-length ruling).
fun [tail] capturedCount(ps: List<Slot>, slot: Slot, r,
                         seen: List<String>, n) => isEmpty(ps)
  ? n
  : matchMemberName(slot.slotName, first(ps).slotName)
                     && triTrue(assignableEq(r, first(ps).slotType,
                                             slot.slotType))
                     && !contains2(seen, first(ps).slotName)
    ? capturedCount(tail(ps), slot, r, prepend(first(ps).slotName, seen), n + 1)
    : capturedCount(tail(ps), slot, r, seen, n)

fun checkEnum2(e2: PsEnum, r) => match(e2.eSpec)
  (sp: Spec) => union(checkStmt2(e2.eParams, r, None),
                union(branchChecks(e2.eVariants, r, None, noErrs()),
                union(linearGenErrs(e2, e2.eGens, noErrs()),
                       attrErrs(e2.eAttrs, isKnownEnumAttr, e2.pseLine,
                                "an enum"))))
  ()         => oneErr(e2.pseLine, "Missed compile step")


fun [tail] linearGenErrs(e2: PsEnum, gs: List<PGen>,
                         acc): Set<PErr> => isEmpty(gs)
  ? acc
  : hasAttr(first(gs).genAttrs, "linear")
    ? linearGenErrs(e2, tail(gs),
        add(acc, PErr(e2.pseLine,
                         "[linear] type parameters are only supported on functions")))
    : linearGenErrs(e2, tail(gs), acc)

fun checkTypealias2(ta: PsTypealias, r0): Set<PErr>
  let r = isEmpty(ta.taGens) && isEmpty(ta.taWheres)
    ? r0
    : genScope(ta.taGens, ta.taWheres, r0)
  ret union(checkSpec(ta.taType, r),
      union(checkSpecs(ta.taWheres, r, noErrs()),
             attrErrs(ta.taAttrs, isKnownTypealiasAttr, ta.pstLine,
                      "a typealias")))
