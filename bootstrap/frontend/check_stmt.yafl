# bootstrap/check_stmt.yafl — Statement.check per kind, ported from the
# check() methods in compiler/pyast/statement/. Message strings VERBATIM.
#
# LAYOUT: each node kind's own check lives with the rest of that node in
# bootstrap/nodes/ (one file per kind, as pyast/); this file keeps the
# helpers several node kinds share.
namespace Bootstrap::Frontend

import System
import System::Containers

import Bootstrap::Ast
import Bootstrap::Parse
import Bootstrap::Resolve
import Bootstrap::Types
import Bootstrap::StdlibCandidates
import Bootstrap::Ir
import Bootstrap::Nodes


# ── TraitInstanceStatement ──────────────────────────────────────────────────
# Pattern + wheres under the generic scope; members under the transient
# owner-wheres copy; the pattern must name an INTERFACE.

# ── FunctionStatement ───────────────────────────────────────────────────────

# ── unknown attributes ──────────────────────────────────────────────────────
# Attributes parse as an OPEN `[name]` / `[name(expr)]` list, so without this
# every kind silently ignored any attribute it did not happen to consult:
# `[tset]` compiled clean and did nothing. Each kind declares the set it
# honours; anything else is a CHECK error, not a no-op. Walked in SOURCE order
# so a declaration carrying two unknown attributes reports them in the same
# order as the Python side (base.py `unknown_attribute_errors`).

fun unknownAttrErrs(as2: List<PAttr>, known: (:String): Bool, lr, kind, acc): Set<PErr> =>
  fold(as2, acc, (a, x) => known(x.attrName)
    ? a
    : add(a, PErr(lr, "unknown attribute [" + x.attrName
                          + "] on " + kind)))

fun attrErrs(attrs: List<PAttr>, known: (:String): Bool, lr,
             kind): Set<PErr> => unknownAttrErrs(attrs, known, lr, kind, noErrs())

fun attrValueOf(attrs: List<PAttr>, name: String) => avLoop(attrs, name)

fun avLoop(as2: List<PAttr>, name: String) => match(firstWhere(as2, (x) => x.attrName == name))
  (x: PAttr) => x.attrValue
  ()  => None

# The `[inline]` attribute (Python FunctionStatement.inline_mode): InlineAuto
# unmarked, InlineEarly for `[inline]`, InlineAlways for `[inline(always)]`,
# InlineNever for `[inline(never)]` — and None for any other argument, which
# inlineErrs reports.
fun funInlineMode(f: PsFun): InlineMode|None
  if !hasAttr(f.fAttrs, "inline")
    ret InlineAuto()
  ret match(attrValueOf(f.fAttrs, "inline"))
    (v: PExpr) => inlineArgMode(v)
    ()         => InlineEarly()

fun inlineArgMode(v: PExpr): InlineMode|None => match(v)
  (t2: PeTuple) => isEmpty(dropOne(t2.exprs)) ? inlineWordMode(head(t2.exprs)) : None
  (o: PExpr)    => None

fun inlineWordMode(en: PTupEnt|None): InlineMode|None => match(en)
  (e2: PTupEnt) => e2.tupName != "" || e2.tupSpread ? None : match(e2.tupValue)
    (n: PeName) => !isEmpty(n.refTypeParams) ? None
      : n.refName == "always" ? InlineAlways()
      : n.refName == "never"  ? InlineNever()
      : None
    (o: PExpr)  => None
  ()            => None

# `[test]`'s argument as its description and expected stdout, or None when it
# is not one of `[test]`, `[test("d")]`, `[test("d", stdout = "s")]`,
# `[test(stdout = "s")]`: the description unnamed and first, every value a
# string literal. Mirrors function.py's test_attribute_parts.
class [final] TestAttr(taDescription: String, taStdout: String|None)

fun testAttrParts(v: PExpr|None): TestAttr|None => match(v)
  (tp: PeTuple) => testAttrEntries(tp.exprs)
  (o: PExpr)    => None
  ()            => TestAttr("", None)

fun testAttrEntries(es: List<PTupEnt>): TestAttr|None => match(head(es))
  (first: PTupEnt) => first.tupName == ""
    ? match(first.tupValue)
      (d: PeStr) => testAttrStdout(d.strValue, dropOne(es))
      (o: PExpr) => None
    : testAttrStdout("", es)
  ()               => TestAttr("", None)

fun testAttrStdout(description: String, rest: List<PTupEnt>): TestAttr|None => match(head(rest))
  (en: PTupEnt) => !isEmpty(dropOne(rest)) || en.tupName != "stdout" || en.tupSpread
    ? None
    : match(en.tupValue)
      (s2: PeStr) => TestAttr(description, s2.strValue)
      (o: PExpr)  => None
  ()            => TestAttr(description, None)

# ── LetStatement / DestructureStatement ─────────────────────────────────────

# ── control ─────────────────────────────────────────────────────────────────

# A [capacity] field (classdef capacity_field).
fun isCapacityField(st: PStmt) => match(st)
  (l: PsLet) => hasAttr(l.lAttrs, "capacity")
  (o: PStmt) => false

# The class of the field `d` names, for a write after construction (`what` is
# the form, for the message), or the error (control.py written_field). Only a
# field of a class-typed subject can be written.
fun writtenField(d: PeDot, what: String, r): PsClass|String => match(exprType(d.base, r))
  (c2: SClass) => match(soleItem(findType(r, c2.scName)))
    (f: Found) => match(f.fStmt)
      (cs: PsClass) => writtenData(d, cs, classFindData(cs, r, d.member))
      (o: PStmt)    => what + " assigns a field of a class instance"
    ()         => what + " assigns a field of a class instance"
  (o: Spec)    => what + " assigns a field of a class instance"
  ()           => what + " assigns a field of a class instance"

fun writtenData(d: PeDot, cs: PsClass, datas: List<Found>): PsClass|String
  if isEmpty(datas)
    ret "Could not find a field named " + d.member
  if sizeAtLeast(datas, 2)
    ret "Ambiguous reference to field named " + d.member
  ret match(head(datas))
    (f: Found) => match(f.fStmt)
      (fn: PsFun) => "'" + d.member + "' is a method, not a field"
      (o: PStmt)  => cs
    ()         => cs

# A write after construction needs a class that admits one (control.py
# late_write_errors).
fun lateWriteErrors(lr: PLine, cs: PsClass, what: String)
  ret hasAttr(cs.cAttrs, "pinnable") || hasAttr(cs.cAttrs, "mutable")
    ? noErrs()
    : oneErr(lr,
             what + " writes a field after construction, so it needs a [pinnable] or "
             + "[mutable] class; '" + bareOfUnique(cs.cName) + "' is neither")

fun isUnitType(xt) => match(xt)
  (tp: STuple) => isEmpty(tp.stEntries)
  (o: Spec)    => false

fun branchChecks(ss: List<PStmt>, r: Resolver, retTy: Spec|None, acc: Set<PErr>): Set<PErr> =>
  fold(ss, acc, (a, x) => union(a, checkStmt2(x, r, retTy)))

# ── classes / enums / typealiases ───────────────────────────────────────────

fun classFields(c: PsClass)
  ret concat(flattenParams(c.cParams), letMembers(c.cMembers,
                                                  List()))

fun letMembers(ms: List<PStmt>, acc: List<PStmt>) =>
  fold(ms, acc, letMembersStep)

fun letMembersStep(a: List<PStmt>, x: PStmt) => match(x)
  (let2: PsLet) => append(a, x)
  (o: PStmt) => a

fun arrayFieldsOf(fs: List<PStmt>, acc: List<PStmt>) =>
  fold(fs, acc, (a, x) => isArrayStorage(x) ? append(a, x) : a)

fun fieldNamed2(fs: List<PStmt>, name) => match(firstWhere(fs, (f) => letMatchesName(f, name)))
  (let2: PsLet) => let2
  ()            => None

fun letMatchesName(st: PStmt, name) => match(st)
  (let2: PsLet) => matchName(let2.lName, name)
  (o: PStmt)    => false

# A field may not reuse the name of a field declared at a parent level: a
# value would then carry two different fields of that name. `above` maps each
# field name declared above this level to its level.
fun redeclaredFieldErrs(node: PsEnum, above: Dict<String, String>, acc: Set<PErr>): Set<PErr>
  let lets = flattenParams(node.eParams)
  let errs = fold(lets, acc, (a, x) => redeclaredFieldErr(a, x, above))
  let here = fold(lets, above, (d, x) => declareFieldAt(d, x, node.eName))
  ret fold(node.eVariants, errs, (a, v) => redeclaredInVariant(a, v, here))

fun redeclaredInVariant(acc: Set<PErr>, v: PStmt, above: Dict<String, String>): Set<PErr> => match(v)
  (ve: PsEnum) => redeclaredFieldErrs(ve, above, acc)
  (o: PStmt)   => acc

fun redeclaredFieldErr(acc: Set<PErr>, x: PStmt, above: Dict<String, String>): Set<PErr> => match(x)
  (l: PsLet) => match(get(above, simpleName(l.lName)))
    (level: String) => add(acc, PErr(l.pslLine, "Field '" + bareOfUnique(l.lName)
                                                + "' is already declared on " + bareOfUnique(level)))
    ()              => acc
  (o: PStmt) => acc

fun declareFieldAt(d: Dict<String, String>, x: PStmt, level: String): Dict<String, String> => match(x)
  (l: PsLet) => put(d, simpleName(l.lName), level)
  (o: PStmt) => d
