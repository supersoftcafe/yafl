# bootstrap/frontend/warnings.yafl — the -W flag registry, ported from
# compiler/warning_flags.py. Keep the two in sync: same names, same defaults,
# same left-to-right resolution rule (-Wall enables every known warning,
# -Wname enables one, -Wno-name disables one, starting from the default set).
namespace Bootstrap::Frontend

import System
import System::Containers
import Bootstrap::StdlibCandidates


# Existence checks only, never iterated in a chosen order — Set, not List.
let knownWarnings: Set<String> = Set(prepend("unused-parameter",
  prepend("unused-variable", prepend("discarded-value",
    prepend("fragile-base", List())))))

# unused-parameter is noisy for trait-constrained signatures, so it alone
# defaults off; everything else defaults on.
fun defaultOnWarning(name: String): Bool => name != "unused-parameter"

fun isKnownWarning(name: String): Bool => contains(knownWarnings, name)

let defaultEnabledWarnings: Set<String> = filter(knownWarnings, defaultOnWarning)

# `flags` are the raw -W tokens with the leading "-W" stripped (e.g. "all",
# "unused-parameter", "no-fragile-base"), in argv order, applied left to
# right starting from the default set. An unknown name resolves to `WrErr`.
fun resolveEnabledWarnings(flags: List<String>): WarnResolve =>
  foldWhile<String, WarnResolve>(flags, WrOk(defaultEnabledWarnings), resolveFlag, (r) => r is WrOk)

# One flag applied to the set so far; the first error stops the walk.
fun resolveFlag(acc: WarnResolve, flag: String): WarnResolve => match(acc)
  (ok: WrOk) => flag == "all"
    ? WrOk(knownWarnings)
    : startsWith(flag, "no-")
      ? resolveDisable(ok.wrEnabled, dropPrefix(flag, 3))
      : resolveEnable(ok.wrEnabled, flag)
  (e: WrErr) => e

fun resolveEnable(enabled: Set<String>, name: String): WarnResolve =>
  isKnownWarning(name)
    ? WrOk(add(enabled, name))
    : WrErr("unknown warning '-W" + name + "'")

fun resolveDisable(enabled: Set<String>, name: String): WarnResolve =>
  isKnownWarning(name)
    ? WrOk(remove(enabled, name))
    : WrErr("unknown warning '-Wno-" + name + "'")

fun dropPrefix(s: String, n) => slice(s, n, length(s))

# The mode word is argv's head (see main.yafl's modeOf); this CLI's entire
# flag surface is everything after it, so every remaining token must be a
# `-Wname` token — mirrors main.py's argparse `-W` short-option
# attached-value parsing (`-Wall` -> W="all").
fun resolveEnabledWarningsFromArgv(argvTail: List<String>): WarnResolve =>
  match(firstWhere(argvTail, (t) => !startsWith(t, "-W")))
    (bad: String) => WrErr("unrecognised argument '" + bad + "'")
    ()            => resolveEnabledWarnings(map(argvTail, (t) => dropPrefix(t, 2)))

enum WarnResolve
  enum WrOk(wrEnabled: Set<String>)
  enum WrErr(wrMessage: String)
