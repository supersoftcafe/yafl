# bootstrap/compile_expr.yafl — Expression.compile, ported from the compile()
# methods in compiler/pyast/expression/.
#
# One pass of the fixpoint over an expression. Each node:
#   1. compiles its CHILDREN, threading down the type its receiver expects;
#   2. rebuilds itself from the results;
#   3. wraps ITSELF in a conversion if representing its value as the receiver's
#      type needs one.
#
# Step 3 is the rule that must not be softened: EVERY node owns its own
# conversion (conversions.py::converted). Codegen never converts — a conversion
# still needed at generate time is a bug, and one inserted that was not needed
# is a silent miscompile. `converted` is IDENTITY while either side is not
# ground yet, so inserting is idempotent across passes and the fixpoint still
# settles.
#
# A compile also yields any GLOBAL statements it created (a lambda becomes a
# top-level function, a literal becomes an interned global): they flow up to
# the driver, which adds them to the statement set for the next pass.
#
# LAYOUT: each node kind's own compile lives with the rest of that node in
# bootstrap/nodes/ (one file per kind, as pyast/); this file keeps the
# helpers several node kinds share.
namespace Bootstrap::Frontend

import System
import System::Containers

import Bootstrap::Ast
import Bootstrap::Codegen
import Bootstrap::Parse
import Bootstrap::Resolve
import Bootstrap::StdlibCandidates
import Bootstrap::Types
import Bootstrap::Nodes


# The result of compiling an expression: the rewritten node, the globals its
# compilation created, and the hints it learned (hints.yafl).
class [final] ExprOut(eoExpr: PExpr, eoGlobals: List<PStmt>,
                      eoHints: Dict<String, List<Hint>>)

fun noGlobals(x) => ExprOut(x, List(), noHints())

# ── the conversion wrap ─────────────────────────────────────────────────────
# THE compile-side insertion point. Identity when the receiver expects nothing,
# and when no representation change is needed.

fun converted(x, expected: Spec|None, r) => match(expected)
  (want: Spec) if needsConversion(r, exprType(x, r), want) => PeConvert(x, want, exprLine(x))
  ()           => x

fun convertedOut(out: ExprOut, expected: Spec|None, r)
  ret ExprOut(converted(out.eoExpr, expected, r), out.eoGlobals, out.eoHints)

# ── `??`: ending an option ───────────────────────────────────────────────────
# PeCoalesce lives only until the subject's type is ground, then becomes the
# match it means. Mirrors pyast/expression/coalesce.py; see nodes.yafl for why
# this cannot be parse-time sugar.

# ── the pass ────────────────────────────────────────────────────────────────

fun nameHint(f: Found, name: String, expected: Spec|None) => match(expected)
  (e2: Spec) => registersHint(f, expected) ? hintOf(name, e2, false) : noHints()
  ()         => noHints()

# ── the enum member ─────────────────────────────────────────────────────────
# _enum_member: resolve a bare field name against a value of enum type e2 —
# only the fields declared at its level or a parent level are members; two
# levels on the path declaring the same name is ambiguous.
fun enumMember(r, e2: SEnum, bare)
  let cands = fieldsMatching(enumMembers(r, e2), bare, List())
  if isEmpty(cands)
    ret NfMiss()
  ret exactly(cands, 1) ? hitOf(cands) : NfAmbiguous()

# _enum_members: the fields a value of type e2 has, DERIVED from the
# statement; none while the root does not resolve.
fun enumMembers(r, e2: SEnum) => match(soleItem(findType(r, e2.seRoot)))
  (f: Found) => match(f.fStmt)
    (en: PsEnum) => visibleFields(en, e2.sePath)
    (o: PStmt)   => List<SField>()
  ()         => List<SField>()

fun fieldsMatching(fs: List<SField>, bare, acc: List<SField>) =>
  fold(fs, acc, (a, x) => matchName(x.sfName, bare) ? append(a, x) : a)

fun hitOf(cands: List<SField>) => match(head(cands))
  (f: SField) => NfHit(f.sfName, f.sfType)
  ()          => NfMiss()

# _substitute_enum_type_params: a generic enum's fields are stored against the
# declaration's placeholders (`value: T`); a read off a concrete instantiation
# (Chain<String>) maps them through the receiver's type arguments.
fun substituteEnumTypeParams(r, receiver: SEnum,
                             fieldType) => match(fieldType)
  (ft: Spec) => isEmpty(receiver.seParams)
    ? fieldType
    : mapEnumField(r, receiver, ft)
  ()         => None

fun mapEnumField(r, receiver: SEnum, ft) => match(soleItem(findType(r, receiver.seRoot)))
  (f: Found) => match(f.fStmt)
    (en: PsEnum) => sameLen(en.eGens, receiver.seParams)
      ? substitute(ft, paramMapping(en.eGens, receiver.seParams))
      : ft
    (o: PStmt)   => ft
  ()         => ft

# A tuple converges FIELD-WISE against a tuple receiver: each entry compiles
# toward the field it BINDS (positionally, or by NAME — `f(5, bias = 7)`
# converges its second entry toward `bias`, not toward index 1), and the whole
# tuple then owns any box into a union.
fun compileTuple(tp, r, expected: Spec|None)
  if any(tp.exprs, (en) => en.tupSpread)
    ret expandSpreads(tp, r, expected)
  let slots = entrySlots(tp, r, expected)
  let es = compileTupEnts(tp.exprs, r, slots, 0, List(),
                          List(), noHints())
  let out = PeTuple(es.teEntries, tp.petLine)
  ret ExprOut(converted(out, expected, r), es.teGlobals, es.teHints)

# `*x` splices a tuple's fields in, positionally (names never travel through a
# spread). Each spread value binds ONCE through a destructure, and the rebuilt
# literal lists the bound fields in its place:
#
#     (1, *pair)   =>   { let _ = pair -> ($spread1$f0, $spread1$f1); (1, $spread1$f0, $spread1$f1) }
#
# Deferred — returned with its entries compiled but the spread kept — until
# every spread value's tuple arity is known; the fixpoint retries.
fun expandSpreads(tp: PeTuple, r, expected: Spec|None): ExprOut
  let es = compileTupEnts(tp.exprs, r, List(), 0, List(), List(), noHints())
  if any(es.teEntries, (en) => en.tupSpread && !isTupleSpec(exprType(en.tupValue, r)))
    ret ExprOut(PeTuple(es.teEntries, tp.petLine), es.teGlobals, es.teHints)
  let sp = spreadParts(es.teEntries, r, 0, List(), List())
  let block = PeBlock(sp.spBinders, PeTuple(sp.spEntries, tp.petLine), "", tp.petLine)
  let out = compileExpr(block, r, expected)
  ret ExprOut(out.eoExpr, concat(es.teGlobals, out.eoGlobals), out.eoHints)

# Two levels: a Spec VARIANT cannot be an arm of `Spec|None` directly.
fun isTupleSpec(t2: Spec|None) => match(t2)
  (st: STuple) => true
  ()           => false

fun tupleArity(t2: Spec|None): Int => match(t2)
  (st: STuple) => fold(st.stEntries, 0, (n, e) => n + 1)
  ()           => 0

class [final] SpreadParts(spBinders: List<PStmt>, spEntries: List<PTupEnt>)

fun spreadParts(es: List<PTupEnt>, r, idx: Int, binders: List<PStmt>, entries: List<PTupEnt>): SpreadParts =>
  fold(es, (idx = idx, binders = binders, entries = entries), (st, x) => spreadPartsStep(st, x, r))
    |> (r2) => SpreadParts(r2.binders, r2.entries)

fun spreadPartsStep(st: (idx: Int, binders: List<PStmt>, entries: List<PTupEnt>), x: PTupEnt, r) =>
  !x.tupSpread
  ? (idx = st.idx + 1, binders = st.binders, entries = append(st.entries, x))
  : spreadOne(x.tupValue, spreadNames(x.tupValue, r, st.idx))
    |> (binder, refs) => (idx = st.idx + 1, binders = append(st.binders, binder), entries = concat(st.entries, refs))

# `$spread<idx>$f<i>@<hash6 of the value's line>` — one per field.
fun spreadNames(v: PExpr, r, idx: Int): List<String>
  let lr = exprLine(v)
  # expandSpreads has checked every spread value is a tuple.
  let n = tupleArity(exprType(v, r))
  ret fieldNames("$spread" + String(idx) + "$f", "@" + hash6(lr.plFile, lr.plLine, lr.plCol),
                  0, n, List())

fun [tail] fieldNames(prefix: String, suffix: String, i: Int, n: Int,
                      acc: List<String>): List<String>
  ret i >= n ? acc : fieldNames(prefix, suffix, i + 1, n, append(acc, prefix + String(i) + suffix))

fun spreadOne(v: PExpr, names: List<String>): (binder: PStmt, refs: List<PTupEnt>)
  let lr = exprLine(v)
  ret (PsDestructure("_", List(), None,
                     map(names, (nm) => PsLet(nm, List(), List(), None, None, "", List(), lr)),
                     v, lr),
       map(names, (nm) => PTupEnt("", false, PeName(nm, List(), lr, None))))

class [final] TupEntsOut(teEntries: List<PTupEnt>, teGlobals: List<PStmt>,
                         teHints: Dict<String, List<Hint>>)

fun compileTupEnts(es: List<PTupEnt>, r, slots: List<SEntry>, i, acc, glb, hints) =>
  fold(es, (i = i, acc = acc, glb = glb, hints = hints),
       (st, x) => compileTupEntsStep(st, x, r, slots))
    |> (r2) => TupEntsOut(r2.acc, r2.glb, r2.hints)

fun compileTupEntsStep(st: (i: Int, acc: List<PTupEnt>, glb: List<PStmt>, hints: Dict<String, List<Hint>>),
                       x: PTupEnt, r, slots: List<SEntry>) =>
  compileExpr(x.tupValue, r, entryAt(slots, st.i))
  |> (v) => (i = st.i + 1,
    acc = append(st.acc, PTupEnt(x.tupName, x.tupSpread, v.eoExpr)),
    glb = concat(st.glb, v.eoGlobals),
    hints = mergeHints(st.hints, v.eoHints))

# The receiver's entries, ORDERED to match this tuple's entries via the shared
# binding. A union receiver first narrows to the tuple variant this value fits.
fun entrySlots(tp, r, expected: Spec|None) => match(effectiveTarget(tp, r, expected))
  (st: STuple) => boundSlots(st, tp)
  ()           => List()

fun effectiveTarget(tp, r, expected: Spec|None) => match(expected)
  (want: Spec) => isUnion(want)
    ? tupleVariantOf(tp, r, want)
    : want
  ()           => None

fun tupleVariantOf(tp, r, want) => match(exprType(tp, r))
  (actual: Spec) if isConcrete(actual) => matchingTupleVariant(r, actual, want)
  ()             => None

fun boundSlots(st: STuple, tp: PeTuple) => match(bindTupleEntries(st.stEntries, tupNames(tp)))
  (b: List<Int>) => slotsFor(st.stEntries, b, tp)
  ()             => List()

fun tupNames(tp: PeTuple) => nameOfEnts(tp.exprs, List())

fun nameOfEnts(es: List<PTupEnt>, acc): List<String> =>
  fold(es, acc, (a, x) => append(a, x.tupName))

# bindTupleEntries answers "which SUPPLIED entry fills declared slot i" — this
# inverts it into "which declared slot does supplied entry j fill", which is
# what each entry needs to converge toward.
fun slotsFor(declared: List<SEntry>, binding: List<Int>,
             tp: PeTuple) => invertLoop(declared, binding,
                                        emptySlots(tp.exprs, List()))

# One blank slot per supplied entry — sized by the walk, never by a count.
fun emptySlots(es: List<PTupEnt>, acc): List<SEntry> =>
  fold(es, acc, (a, x) => append(a, SEntry("", None, None)))

# setAt walks structurally, so an out-of-range index rebuilds unchanged —
# the old `< n` guard is subsumed.
fun invertLoop(ds: List<SEntry>, bs: List<Int>, acc: List<SEntry>) =>
  zipFold(ds, bs, acc, (a, d, b) => b >= 0 ? setAt(a, b, d) : a)

# `es` with the entry at `i` replaced by `v`.
fun setAt(es: List<SEntry>, i: Int, v: SEntry) =>
  fold(es, (acc = List<SEntry>(), at = 0),
    (st, x) => (acc = append(st.acc, st.at == i ? v : x), at = st.at + 1)).acc

# The subject compiles first (no expectation). Its type is the bound ELSE
# arm's binding type — only this level knows it — and, when its type arguments
# are RESOLVED, they propagate onto each variant arm that didn't spell them
# out. A concrete arg always qualifies; a placeholder arg qualifies when it
# resolves in scope — the enclosing generic's own param passing through
# (List<B> inside zipFold<A, B, U> stamps its arms _ListEmpty<B>/_ListFull<B>),
# which monomorphisation then substitutes exactly. Leaving such an arm BARE is
# not an option: mono's identity completion falls back to matching the enum
# template's formal names against the host's params, so both of a two-param
# host's matches latched the instantiation whose param happened to share the
# enum formal's spelling — a silent runtime abort. An unresolved NamedSpec or
# a FREE placeholder (another declaration's blank) stays deferred; the
# fixpoint fires the propagation once it grounds.
fun compileMatch(mt: PeMatch, r, expected): ExprOut
  let subj = compileExpr(mt.subject, r, None)
  let subjTy = exprType(subj.eoExpr, r)
  # Subjects after the first compile the same way; their arm patterns are
  # plain type dispatch, so nothing threads down to them.
  let ex = compileExprs(mt.matchExtra, r, List(), List())
  let arms = compileArms(mt.arms, r, subjTy, expected,
                         List(), List(), ex.ceTypes, noHints())
  ret ExprOut(with mt(subject = subj.eoExpr, arms = arms.aoArms,
                      matchExtra = ex.ceExprs),
              concat(subj.eoGlobals, concat(ex.ceGlobals, arms.aoGlobals)),
              mergeHints(mergeHints(subj.eoHints, ex.ceHints),
                         mergeHints(arms.aoHints,
                                    armHints(r, subj.eoExpr, arms.aoArms))))

# A match over an untyped name: each arm type is a LOWER hint for it. An else
# arm, a bare generic arm, or an arm not resolved yet says nothing.
fun armHints(r, subject, arms: List<PArm>): Dict<String, List<Hint>> => match(subject)
  (nm: PeName) => match(soleItem(findData(r, nm.refName)))
    (f: Found) => isUntypedLet(f.fStmt) && !any(arms, isBareElse)
      ? lowerHints(f.fName, armLowerTypes(arms, r), r)
      : noHints()
    ()         => noHints()
  (o: PExpr)   => noHints()

fun isBareElse(a: PArm) => a.armType is None && isEmpty(a.armLiterals)

# Typed arms first, then every literal arm's literals.
fun armLowerTypes(arms: List<PArm>, r)
  let typed = map(filter(arms, (a) => !(a.armType is None)), (a) => a.armType)
  let lits = flatMapLits(filter(arms, (a) => a.armType is None), r,
                         List())
  ret concat(typed, lits)

fun flatMapLits(as2: List<PArm>, r, acc: List<Spec|None>) =>
  fold(as2, acc, (a, x) => concat(a, map(x.armLiterals, (lit) => litType(lit, r))))

fun litType(lit, r) => match(lit)
  (e2: PlExpr)  => exprType(e2.litExpr, r)
  (rg: PlRange) => exprType(rg.rangeLo, r)

fun lowerHints(name: String, types: List<Spec|None>, r)
  let usable = map(types, (ty) => usableLower(r, ty))
  if any(usable, (u) => u is None)
    ret unsettled()
  ret all(usable, isYes)
    ? fold(types, noHints(), (acc, ty) => mergeHints(acc, lowerHint(name, ty)))
    : noHints()

fun lowerHint(name: String, ty: Spec|None) => match(ty)
  (t2: Spec) => hintOf(name, t2, true)
  ()         => noHints()

fun isYes(u: Bool|None) => match(u)
  (b: Bool) => b
  ()        => false

# A resolved arm type that carries its type arguments; None while it has not
# resolved.
fun usableLower(r, ty: Spec|None) => match(ty)
  (n: SNamed) => None
  (e2: SEnum) => isEmpty(e2.seParams) ? nonGenericRoot(r, e2.seRoot) : true
  (o: Spec)   => true
  ()          => None

fun nonGenericRoot(r, root)
  let found = findType(r, root)
  if !found.bComplete
    ret None
  ret match(soleItem(found))
    (f: Found) => match(f.fStmt)
      (en: PsEnum) => isEmpty(en.eGens)
      (o: PStmt)   => true
    ()         => None

class [final] CompiledExprs(ceExprs: List<PExpr>, ceGlobals: List<PStmt>,
                            ceTypes: List<Spec|None>,
                            ceHints: Dict<String, List<Hint>>)

fun compileExprs(es, r, acc: List<PExpr>, glb) => compileExprsB(es, r, acc, glb, List(), noHints())

fun compileExprsB(es: List<PExpr>, r, acc, glb, tys, hints) =>
  fold(es, (acc = acc, glb = glb, tys = tys, hints = hints), (st, x) => compileExprsStep(st, x, r))
    |> (r2) => CompiledExprs(r2.acc, r2.glb, r2.tys, r2.hints)

fun compileExprsStep(st: (acc: List<PExpr>, glb: List<PStmt>, tys: List<Spec | ()>, hints: Dict<String, List<Hint>>),
                      x: PExpr, r) =>
  compileExpr(x, r, None)
  |> (o) => (acc = append(st.acc, o.eoExpr), glb = concat(st.glb, o.eoGlobals), tys = appendSpecOpt(st.tys, exprType(o.eoExpr, r)), hints = mergeHints(st.hints, o.eoHints))

fun appendSpecOpt(acc: List<Spec|None>, sp: Spec|None) => append(acc, sp)

class [final] ArmsOut(aoArms: List<PArm>, aoGlobals: List<PStmt>,
                      aoHints: Dict<String, List<Hint>>)

fun compileArms(as2: List<PArm>, r, subjTy: Spec|None, expected, acc, glb,
                extraTys: List<Spec|None>, hints) =>
  fold(as2, (acc = acc, glb = glb, hints = hints),
       (st, x) => compileArmsStep(st, x, r, subjTy, expected, extraTys))
    |> (r2) => ArmsOut(r2.acc, r2.glb, r2.hints)

fun compileArmsStep(st: (acc: List<PArm>, glb: List<PStmt>, hints: Dict<String, List<Hint>>),
                    x: PArm, r, subjTy: Spec|None, expected, extraTys: List<Spec|None>) =>
  compileArm(x, r, subjTy, expected, extraTys)
  |> (a) => (acc = append(st.acc, a.a1Arm), glb = concat(st.glb, a.a1Globals), hints = mergeHints(st.hints, a.a1Hints))

class [final] ArmOut(a1Arm: PArm, a1Globals: List<PStmt>,
                     a1Hints: Dict<String, List<Hint>>)

# `chain` over a List<Spec|None> — a distinct name, since `chain` on a union
# element type needs its own instantiation.
fun chain2(l: List<Spec|None>) => l

# One scope per extra position, over the arm's own. A position with no name or
# no type binds nothing, exactly as position 0 does.
fun extraScope(ps: List<PPos>, tys: List<Spec|None>, r) =>
  fold(ps, (tys = tys, r = r),
       (st, x) => (tys = dropOne(st.tys), r = posScope(x, head(st.tys), st.r))).r

# What an arm's body and guard see: position 0's binding plus one for every
# extra position, each at its declared type (match.py MatchArm.body_resolver).
# Every pass that walks an arm body with a scope builds it here.
fun armBodyScope(a: PArm, r) => extraScope(a.armExtra, chain2(List<Spec|None>()), bindingScope(a, a.armType, r))

fun posScope(p: PPos, subjTy, r): Resolver => p.posName == "" || p.posName == "_"
  ? r
  : match(posBindType(p, subjTy))
    (t2: Spec) => RData(prepend(Found(posUniqueName(p), posBinderLet(p, t2),
                                      ScLocal()),
                                List()),
                        r)
    ()         => r

fun renamePositions(ps: List<PPos>, tys: List<Spec|None>, r, acc: List<PPos>) =>
  fold(ps, (tys = tys, acc = acc), (st, x) => renamePositionsStep(st, x, r)).acc

fun renamePositionsStep(st: (tys: List<Spec|None>, acc: List<PPos>), x: PPos, r) =>
  (tys = dropOne(st.tys),
  acc = appendPosOut(st.acc,
      with x(posName = posUniqueName(x),
                   posType = specOf(compileSpecOpt(x.posType, r)))))

fun appendPosOut(acc: List<PPos>, p: PPos) => append(acc, p)

fun posBindType(p: PPos, subjTy): Spec|None => match(p.posType)
  (t2: Spec) => p.posType
  ()         => subjTy

fun posUniqueName(p: PPos) => p.posName == "" || p.posName == "_" || contains(p.posName, "@arm")
  ? p.posName
  : p.posName + "@arm" + hash6(p.pposLine.plFile, p.pposLine.plLine,
                               p.pposLine.plCol)

fun posBinderLet(p: PPos, ty) => PsLet(posUniqueName(p), List(), List(), ty, None, "",
                                       List(), p.pposLine)

# The arm's bound name resolves to a LOCAL let of the arm's own type (a bound
# else arm: of the subject's type) under a per-arm UNIQUE name — two arms may
# bind the same identifier at different types. The body and the guard see the
# binding; the arm is renamed in the same pass so it stays in sync with the
# body's rewritten names.
fun compileArm(a0, r, subjTy,
               expected, extraTys: List<Spec|None>): ArmOut
  let a = propagateSubjParams(a0, subjTy, r)
  # Every position binds: position 0 through the arm, the rest through their
  # own PPos. Positions are independent, so the chaining order is immaterial.
  let bodyR = extraScope(a.armExtra, chain2(extraTys),
                         bindingScope(a, armBindType(a, subjTy), r))
  let body = compileExpr(a.armBody, bodyR, expected)
  let ty = compileSpecOpt(a.armType, r)
  let lits = compileLits(a.armLiterals, r, List(), List(), noHints())
  let guard = compileExprOpt(a.armGuard, bodyR, None)
  # Every position takes its UNIQUE name, not just position 0: the body was
  # compiled against a scope registering the unique names, so leaving the
  # extras bare desynchronises the binder from the body's references.
  let extras = renamePositions(a.armExtra, chain2(extraTys), r, List())
  let binders = add(Set(map(extras, (p) => p.posName)), armUniqueName(a))
  ret ArmOut(with a(armName = armUniqueName(a), armType = specOf(ty), armBody = body.eoExpr, armLiterals = lits.loLits, armGuard = exprOf(guard), armExtra = extras),
             concat(body.eoGlobals,
                    concat(globalsOfSpec(ty),
                           concat(lits.loGlobals, globalsOf(guard)))),
             hintsWithout(mergeHints(body.eoHints,
                                     mergeHints(lits.loHints, hintsOf(guard))),
                          binders, Set()))

fun armBindType(a: PArm, subjTy): Spec|None => match(a.armType)
  (t2: Spec) => a.armType
  ()         => subjTy

# _arm_unique_name: idempotent per-arm rename, derived from the line ref so it
# is deterministic across runs and stable across passes. No name, `_`, or an
# already-suffixed name returns verbatim.
fun armUniqueName(a: PArm): String
  ret a.armName == "" || a.armName == "_" || contains(a.armName, "@arm")
    ? a.armName
    : a.armName + "@arm" + hash6(a.parmLine.plFile, a.parmLine.plLine,
                                 a.parmLine.plCol)

fun bindingScope(a: PArm, ty: Spec|None, r): Resolver => a.armName == "" || a.armName == "_"
  ? r
  : match(ty)
    # One binder in a fresh scope.
    (t2: Spec) => RData(prepend(Found(armUniqueName(a), armBinderLet(a, t2),
                                      ScLocal()),
                                List()),
                        r)
    ()         => r

fun armBinderLet(a: PArm, ty) => PsLet(armUniqueName(a), List(), List(), ty, None, "",
                                       List(), a.parmLine)

fun propagateSubjParams(a, subjTy: Spec|None, r): PArm => match(subjTy)
  (st: Spec) if resolvedParams(typeParamsOf(st), r) => withSubjParams(a, typeParamsOf(st))
  ()         => a

fun withSubjParams(a, params): PArm => match(a.armType)
  (t2: Spec) => withArmSpecParams(a, t2, params)
  ()         => a

fun withArmSpecParams(a, t2, params): PArm => match(t2)
  (n: SNamed) => isEmpty(n.snParams)
    ? with a(armType = SNamed(n.snName, params, n.snLine))
    : a
  (e2: SEnum) => isEmpty(e2.seParams)
    ? with a(armType = SEnum(e2.seRoot, e2.seValidLeaves, e2.seAllLeaves,
                            params, e2.seLine, e2.sePath))
    : a
  (o: Spec)   => a

fun typeParamsOf(sp) => match(sp)
  (n: SNamed) => n.snParams
  (c: SClass) => c.scParams
  (e2: SEnum) => e2.seParams
  (o: Spec)   => List()

# Resolved = non-empty, no unresolved NamedSpec arg, and no FREE placeholder —
# a placeholder that resolves in scope is the host's own param and latches.
fun resolvedParams(ps: List<Spec>, r) => !isEmpty(ps) && !anyHoleParam(ps, r)

fun anyHoleParam(ps: List<Spec>, r) => any(ps, (p) => isHoleParam(p, r))

fun isHoleParam(p: Spec, r) => match(p)
  (n: SNamed) => true
  (o: Spec)   => hasFreePlaceholders(p, r)

class [final] LitsOut(loLits: List<PLit>, loGlobals: List<PStmt>,
                      loHints: Dict<String, List<Hint>>)

class [final] LitOut(l1Lit: PLit, l1Globals: List<PStmt>,
                     l1Hints: Dict<String, List<Hint>>)

fun compileLits(ls: List<PLit>, r, acc, glb, hints) =>
  fold(ls, (acc = acc, glb = glb, hints = hints), (st, x) => compileLitsStep(st, x, r))
    |> (r2) => LitsOut(r2.acc, r2.glb, r2.hints)

fun compileLitsStep(st: (acc: List<PLit>, glb: List<PStmt>, hints: Dict<String, List<Hint>>),
                    x: PLit, r) =>
  compileLit(x, r)
  |> (o) => (acc = append(st.acc, o.l1Lit), glb = concat(st.glb, o.l1Globals), hints = mergeHints(st.hints, o.l1Hints))

fun compileLit(l, r) => match(l)
  (e2: PlExpr)  => litExprOut(compileExpr(e2.litExpr, r, None))
  (rg: PlRange) => litRangeOut(rg, compileExpr(rg.rangeLo, r, None),
                               compileExpr(rg.rangeHi, r, None))

fun litExprOut(o: ExprOut) => LitOut(PlExpr(o.eoExpr), o.eoGlobals, o.eoHints)

fun litRangeOut(rg: PlRange, lo: ExprOut, hi: ExprOut)
  ret LitOut(PlRange(lo.eoExpr, hi.eoExpr, rg.plrLine),
             concat(lo.eoGlobals, hi.eoGlobals),
             mergeHints(lo.eoHints, hi.eoHints))

fun opName(x) => match(x)
  (s2: PeStr) => s2.strValue
  (o: PExpr)  => None

# ── `with subject(name = value, …)` — EXPANDS here once types resolve ───────
# Mirror of WithExpression.__expand, name for name (tags from the with's own
# line hash, so both compilers synthesise byte-identical trees):
#
#   Block[ let $ws = subject; let $w0 = v0; … ]
#     Ternary( yafl_same($w0, $ws.f0) && …,
#              $ws,
#              match($ws) (x: Leaf) => Leaf(…) … )     [or a direct ctor]
#
# Shape/visibility problems leave the node UNEXPANDED; checkWith reports.

# (leaf unique name, fields root-down), declaration order.
fun withLeaves(st: PsEnum, inherited: List<PStmt>,
               acc): (names: List<String>, sets: List<List<PStmt>>)
  let own = concat(inherited, flattenParams(st.eParams))
  if isEmpty(st.eVariants)
    # Leaf name and its field set, POSITIONALLY paired.
    ret st.eHasParams
      ? (append(acc.names, st.eName),
         append(acc.sets, own))
      : acc
  ret withLeavesLoop(st.eVariants, own, acc)

fun withLeavesLoop(vs: List<PStmt>, own: List<PStmt>,
                   acc: (names: List<String>, sets: List<List<PStmt>>)): (names: List<String>, sets: List<List<PStmt>>) =>
  fold(vs, acc, (a, x) => withLeavesLoopStep(a, x, own))

fun withLeavesLoopStep(a: (names: List<String>, sets: List<List<PStmt>>), x: PStmt, own: List<PStmt>) => match(x)
  (v: PsEnum) => withLeaves(v, own, a)
  (o: PStmt) => a
