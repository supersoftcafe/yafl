# bootstrap/compile_expr.yafl — Expression.compile, ported from the compile()
# methods in compiler/pyast/expression/.
#
# One pass of the fixpoint over an expression. Each node:
#   1. compiles its CHILDREN, threading down the type its receiver expects;
#   2. rebuilds itself from the results;
#   3. wraps ITSELF in a conversion if representing its value as the receiver's
#      type needs one.
#
# Step 3 is the rule that must not be softened: EVERY node owns its own
# conversion (conversions.py::converted). Codegen never converts — a conversion
# still needed at generate time is a bug, and one inserted that was not needed
# is a silent miscompile. `converted` is IDENTITY while either side is not
# ground yet, so inserting is idempotent across passes and the fixpoint still
# settles.
#
# A compile also yields any GLOBAL statements it created (a lambda becomes a
# top-level function, a literal becomes an interned global): they flow up to
# the driver, which adds them to the statement set for the next pass.
namespace Bootstrap::Frontend

import System

import Bootstrap::Ast
import Bootstrap::Codegen
import Bootstrap::Parse
import Bootstrap::Resolve
import Bootstrap::StdlibCandidates
import Bootstrap::Types



# The result of compiling an expression: the rewritten node, plus the globals
# its compilation created.
class [final] ExprOut(eoExpr: PExpr, eoGlobals: List<PStmt>)

fun noGlobals(x: PExpr): ExprOut
  ret ExprOut(x, List<PStmt>())

# ── the conversion wrap ─────────────────────────────────────────────────────
# THE compile-side insertion point. Identity when the receiver expects nothing,
# and when no representation change is needed.

fun converted(x: PExpr, expected: Spec|None, r: Resolver): PExpr
  ret match(expected)
    (want: Spec) => needsConversion(r, exprType(x, r), want)
      ? PeConvert(x, want, exprLine(x))
      : x
    ()           => x

fun convertedOut(out: ExprOut, expected: Spec|None, r: Resolver): ExprOut
  ret ExprOut(converted(out.eoExpr, expected, r), out.eoGlobals)

# A Convert node RE-COMPILES its inner every pass (Python conversion.py:56):
# the inner compiles with NO expected type — this node is the adapter to the
# receiver, and feeding the receiver's type back down would make the inner
# wrap itself again. The wrap is inserted over ground TYPES, but a NAME inside
# may still be waiting on its unique spelling — freezing the subtree here
# would strand it bare forever (the whole-program corpus caught exactly that:
# `Err("bad", st.pos)` in a union slot kept `pos` unresolved). The receiver's
# view wins: a ground expected that differs from our target means the receiver
# WIDENED since this wrap was inserted — retarget to it. The wrap dissolves
# when no conversion remains.
fun compileConvert(cv: PeConvert, r: Resolver, expected: Spec|None): ExprOut
  let inner = compileExpr(cv.convInner, r, None)
  let spec = compileSpec(cv.convTarget, r)
  let target = retargeted(spec.soSpec, expected)
  ret needsConversion(r, exprType(inner.eoExpr, r), target)
    ? ExprOut(PeConvert(inner.eoExpr, target, cv.pecvLine),
              concat(inner.eoGlobals, spec.soGlobals))
    : ExprOut(inner.eoExpr, concat(inner.eoGlobals, spec.soGlobals))

fun retargeted(target: Spec, expected: Spec|None): Spec
  ret match(expected)
    (e2: Spec) => isConcrete(e2) && uid(e2) != "" && uid(e2) != uid(target)
      ? e2
      : target
    ()         => target

# ── the pass ────────────────────────────────────────────────────────────────

fun compileExpr(x: PExpr, r: Resolver, expected: Spec|None): ExprOut
  ret match(x)
    # A literal's ONLY conversion is boxing into a union slot.
    (i: PeInt)     => noGlobals(converted(x, expected, r))
    (f: PeFloat)   => noGlobals(converted(x, expected, r))
    (b: PeBool)    => noGlobals(converted(x, expected, r))
    (st: PeStr)    => noGlobals(converted(x, expected, r))
    (rx: PeRegex)  => noGlobals(converted(x, expected, r))
    (ng: PeNothing) => noGlobals(x)          # nothing has no type to convert
    # tail_loop lowering only — never present during the fixpoint; Python's
    # compile returns (self, []) for both.
    (lp: PeLoop)    => noGlobals(x)
    (rc: PeRecur)   => noGlobals(x)
    (lz: PeLazy)    => noGlobals(x)
    (nm: PeName)   => compileName(nm, r, expected)
    (d: PeDot)     => compileDot(d, r, expected)
    (c: PeCall)    => compileCall(c, r, expected)
    (tp: PeTuple)  => compileTuple(tp, r, expected)
    (te: PeTernary) => compileTernary(te, r, expected)
    (bk: PeBlock)  => compileBlock(bk, r, expected)
    (mt: PeMatch)  => compileMatch(mt, r, expected)
    (op: PeBuiltinOp) => compileBuiltinOp(op, r, expected)
    (nw: PeNew)    => compileNew(nw, r, expected)
    (ne: PeNewEnum) => compileNewEnum(ne, r, expected)
    (ar: PeArrayRead) => compileArrayRead(ar, r, expected)
    (pl: PeParallel) => compileParallel(pl, r)
    (lm: PeLambda) => compileLambda(lm, r, expected)
    (wx: PeWith)   => compileWith(wx, r, expected)
    (cv: PeConvert) => compileConvert(cv, r, expected)

# A name RESOLVES: once its declaration is known the node carries the unique
# (hashed) name. Never commit against an INCOMPLETE search — the candidate
# that should win may not be visible yet; overloads disambiguate by the
# EXPECTED SHAPE (resolveOverloads); a MEMBER-scoped hit rewrites to
# `this.field`; a TRAIT hit records which interface instantiation won (the
# disambiguation cache — excluded from identity). An unresolved name returns
# UNTOUCHED: no type-param compile, no conversion.
fun compileName(nm: PeName, r: Resolver, expected: Spec|None): ExprOut
  let bag = findData(r, nm.refName)
  ret contains(nm.refName, "@")
    ? hashedName(nm, bag, r, expected)
    : unhashedName(nm, bag, r, expected)

# Already committed: the ambiguity check is skipped, but the type-param step
# below still reruns (inference may only ground on a later pass).
fun hashedName(nm: PeName, bag: Bag, r: Resolver, expected: Spec|None): ExprOut
  ret match(soleItem(bag))
    (f: Found) => finishName(nm, f.fStmt, nm.refName, nm.penTrait, r, expected)
    ()         => noGlobals(nm)

fun unhashedName(nm: PeName, bag: Bag, r: Resolver,
                 expected: Spec|None): ExprOut
  if !bag.bComplete
    ret noGlobals(nm)
  ret match(soleOf(resolveOverloads(r, expected, bag.bItems)))
    (f: Found) => match(f.fScope)
      (m: ScMember) => memberRewrite(nm, f)
      (o: RScope)   => traitCommit(nm, f, r, expected)
    ()         => noGlobals(nm)

# A generic ambient instance's member commits only once the use site binds
# every instance placeholder (the SOLVED scope is what the node records);
# until then leave the use unresolved and let a later pass retry.
fun traitCommit(nm: PeName, f: Found, r: Resolver,
                expected: Spec|None): ExprOut
  ret match(f.fInstanceParams)
    (own: List<String>) => isEmpty(own)
      ? finishName(nm, f.fStmt, f.fName, wonTraitScope(f), r, expected)
      : traitCommitSolved(nm, f, solveInstanceScope(f, own, expected, r), r,
                          expected)
    ()                  => finishName(nm, f.fStmt, f.fName, wonTraitScope(f),
                                      r, expected)

fun traitCommitSolved(nm: PeName, f: Found, solved: Spec|None, r: Resolver,
                      expected: Spec|None): ExprOut
  ret match(solved)
    (sc: Spec) => finishName(nm, f.fStmt, f.fName, classTraitScope(solved),
                             r, expected)
    ()         => noGlobals(nm)

# A MEMBER hit becomes `this.field`, returned BARE — the dot compiles in full
# on the next visit.
fun memberRewrite(nm: PeName, f: Found): ExprOut
  ret noGlobals(PeDot(PeName("this", List<Spec>(), nm.penLine),
                      f.fName, nm.penLine))

fun wonTraitScope(f: Found): Spec|None
  ret match(f.fScope)
    (t2: ScTrait) => classTraitScope(f.fTraitScope)
    (o: RScope)   => None

fun classTraitScope(ts: Spec|None): Spec|None
  ret match(ts)
    (t2: Spec) => match(t2)
      (c: SClass) => ts
      (o: Spec)   => None
    ()         => None

# Fill or refresh this use's type arguments from the enclosing call's expected
# type (use_site_type_params) — runs while any supplied argument still carries
# a hole, keeping a partial result's placeholders for a later pass — then
# compile them like any spelled type params.
fun finishName(nm: PeName, decl: PStmt, newName: String,
               traitScope: Spec|None, r: Resolver,
               expected: Spec|None): ExprOut
  let inferred = useSiteTypeParams(decl, nm.refTypeParams, expected, r)
  let tps = compileParams(inferred, r)
  let out = PeName(newName, tps.psSpecs, nm.penLine, traitScope)
  ret ExprOut(converted(out, expected, r), tps.psGlobals)

# A lambda: its parameters join the scope; UNTYPED parameters adopt the
# expected callable's parameter types (re-threaded EVERY pass — the expected
# signature can arrive empty before it arrives concrete, so a one-shot gate
# would lock in the empty one; two guards: matching arity, and CONCRETENESS —
# a callee generic param not yet substituted would resolve to nothing here).
# The lambda's own type is rebuilt each pass: the parameters as actually
# compiled (only when fully ground — a placeholder mid-resolution keeps the
# original), and the result preferring the call site's expected type so a
# narrower body widens via boxing.
fun compileLambda(lm: PeLambda, r0: Resolver, expected: Spec|None): ExprOut
  let r = localScope(paramLets(lm.lamParams), r0)
  let params0 = threadExpected(lm.lamParams, expected)
  let prm = compileStmt(params0, r, None)
  let subExpected = expectedResult(expected)
  let body = compileExpr(lm.lamBody, r, subExpected)
  let newParams = stmtOr(prm, params0)
  ret ExprOut(PeLambda(newParams, body.eoExpr, lm.pelLine,
                       SCallable(reportedParams(newParams, lm.lamParams),
                                 lambdaResult(subExpected,
                                              exprType(body.eoExpr, r), r),
                                 lm.pelLine)),
              concat(prm.soExtra, body.eoGlobals))

fun threadExpected(params: PStmt, expected: Spec|None): PStmt
  ret match(expected)
    (e2: Spec) => match(e2)
      (c: SCallable) => match(c.scParams2)
        (tp: STuple) => threadTuple(params, tp)
        (o: Spec)    => params
      (o2: Spec)     => params
    ()         => params

fun threadTuple(params: PStmt, tp: STuple): PStmt
  ret match(params)
    (d: PsDestructure) => isConcrete(tp)
                          && listLen(tp.stEntries) == listLen(d.dTargets)
      ? PsDestructure(d.dName, d.dAttrs, tp, d.dTargets, d.dDefault,
                      d.psdLine, d.dTypeInferred)
      : params
    (o: PStmt)         => params

fun expectedResult(expected: Spec|None): Spec|None
  ret match(expected)
    (e2: Spec) => match(e2)
      (c: SCallable) => c.scResult
      (o: Spec)      => None
    ()         => None

# Prefer the expected result when the body's type fits it — the lambda widens
# via boxing and the call's parameter check sees matching types.
fun lambdaResult(subExpected: Spec|None, bodyTy: Spec|None,
                 r: Resolver): Spec|None
  ret match(subExpected)
    (se: Spec) => match(bodyTy)
      (bt: Spec) => isConcrete(se) && triTrue(assignableFrom(r, se, bt))
        ? subExpected
        : bodyTy
      ()         => bodyTy
    ()         => bodyTy

# The parameter types the body was ACTUALLY compiled against — but only when
# fully ground; otherwise the original spelling (avoids reporting an
# unresolved generic mid-resolution).
fun reportedParams(compiled: PStmt, original: PStmt): Spec
  let threaded = paramsTupleOf(compiled)
  ret uid(threaded) != "" ? threaded : paramsTupleOf(original)

# A field read: the base compiles with NO expectation (it is not the value the
# receiver wants), then the read owns its own conversion. An ENUM-typed base
# resolves a bare member through the enum's NARROWING (below).
fun compileDot(d: PeDot, r: Resolver, expected: Spec|None): ExprOut
  let base = compileExpr(d.base, r, None)
  let out = PeDot(base.eoExpr, dotMemberName(d, base.eoExpr, r, expected),
                  d.pedLine)
  ret ExprOut(converted(out, expected, r), base.eoGlobals)

fun dotMemberName(d: PeDot, base: PExpr, r: Resolver,
                  expected: Spec|None): String
  ret match(exprType(base, r))
    (bt: Spec) => match(bt)
      (e2: SEnum) => contains(d.member, "@")
        ? d.member
        : narrowedName(narrowedEnumField(r, e2, d.member), d.member)
      # A CLASS member resolves on the DECLARATION — constructor params and
      # body statements, then implemented interfaces — disambiguated by the
      # expected shape.
      (c2: SClass) => classDotName(d, c2, r, expected)
      (o2: Spec)  => d.member
    ()         => d.member

fun classDotName(d: PeDot, c2: SClass, r: Resolver,
                 expected: Spec|None): String
  ret match(soleItem(findType(r, c2.scName)))
    (f: Found) => match(f.fStmt)
      (cs: PsClass) => match(soleOf(resolveOverloads(r, expected,
                                                     classFindData(cs, r,
                                                                   d.member))))
        (m: Found) => m.fName
        ()         => d.member
      (o: PStmt)    => d.member
    ()         => d.member

fun narrowedName(n: Narrowed, fallback: String): String
  ret match(n)
    (h: NfHit)    => h.nfName
    (o: Narrowed) => fallback

# ── the narrowed enum field ──────────────────────────────────────────────────
# _narrowed_enum_field: resolve a bare field name against an enum subject,
# honouring its narrowing. A single enum-wide match resolves directly; when
# several variants declare the same bare name, only a field the narrowed value
# is GUARANTEED to carry (declared at a node covering every possible leaf) may
# win — reading any other would be reading a sibling variant's slot.


fun narrowedEnumField(r: Resolver, e2: SEnum, bare: String): Narrowed
  let cands = fieldsMatching(chain(enumFieldsVia(r, e2.seRoot)), bare,
                             List<SField>())
  if listLen(cands) == 1
    ret hitOf(cands)
  if isEmpty(cands)
    ret NfMiss()
  ret match(soleItem(findType(r, e2.seRoot)))
    (f: Found) => match(f.fStmt)
      (en: PsEnum) => ownedHit(cands, coveringFields(en, e2.seValidLeaves))
      (o: PStmt)   => NfMiss()
    # Root not resolved yet: retry next pass.
    ()         => NfMiss()

fun [tail] fieldsMatching(fs: Chain<SField>, bare: String,
                          acc: List<SField>): List<SField>
  ret match(fs)
    (nil: ChainEnd) => acc
    (l: ChainLink)  => matchName(l.value.sfName, bare)
      ? fieldsMatching(l.next, bare, append(acc, l.value))
      : fieldsMatching(l.next, bare, acc)

fun hitOf(cands: List<SField>): Narrowed
  ret match(head(cands))
    (f: SField) => NfHit(f.sfName, f.sfType)
    ()          => NfMiss()

fun ownedHit(cands: List<SField>, covering: List<SField>): Narrowed
  let owned = fieldsCovered(chain(cands), covering, List<SField>())
  ret listLen(owned) == 1 ? hitOf(owned) : NfAmbiguous()

fun [tail] fieldsCovered(cs: Chain<SField>, covering: List<SField>,
                         acc: List<SField>): List<SField>
  ret match(cs)
    (nil: ChainEnd) => acc
    (l: ChainLink)  => hasFieldNamed(chain(covering), l.value.sfName)
      ? fieldsCovered(l.next, covering, append(acc, l.value))
      : fieldsCovered(l.next, covering, acc)

# covering_fields: the typed fields a value narrowed to `valid` is GUARANTEED
# to carry — fields declared at nodes whose OWN leaf set covers every valid
# leaf.
fun coveringFields(root: PsEnum, valid: List<String>): List<SField>
  ret coverNode(root, valid, List<SField>())

fun coverNode(node: PsEnum, valid: List<String>, acc: List<SField>): List<SField>
  let acc2 = strsSubset(chain(valid), collectLeafNames(node))
    ? typedFieldsOf(chain(flattenParams(node.eParams)), acc)
    : acc
  ret coverVariants(chain(node.eVariants), valid, acc2)

fun [tail] coverVariants(vs: Chain<PStmt>, valid: List<String>,
                         acc: List<SField>): List<SField>
  ret match(vs)
    (nil: ChainEnd) => acc
    (l: ChainLink)  => match(l.value)
      (v: PsEnum) => coverVariants(l.next, valid, coverNode(v, valid, acc))
      (o: PStmt)  => coverVariants(l.next, valid, acc)

fun [tail] typedFieldsOf(ls: Chain<PStmt>, acc: List<SField>): List<SField>
  ret match(ls)
    (nil: ChainEnd) => acc
    (l: ChainLink)  => match(l.value)
      (let2: PsLet) => match(let2.lType)
        (ty: Spec) => typedFieldsOf(l.next, append(acc, SField(let2.lName, ty)))
        ()         => typedFieldsOf(l.next, acc)
      (o: PStmt)    => typedFieldsOf(l.next, acc)

# _substitute_enum_type_params: a generic enum's fields are stored against the
# declaration's placeholders (`value: T`); a read off a concrete instantiation
# (Chain<String>) maps them through the receiver's type arguments.
fun substituteEnumTypeParams(r: Resolver, receiver: SEnum,
                             fieldType: Spec|None): Spec|None
  ret match(fieldType)
    (ft: Spec) => isEmpty(receiver.seParams)
      ? fieldType
      : mapEnumField(r, receiver, ft)
    ()         => None

fun mapEnumField(r: Resolver, receiver: SEnum, ft: Spec): Spec|None
  ret match(soleItem(findType(r, receiver.seRoot)))
    (f: Found) => match(f.fStmt)
      (en: PsEnum) => listLen(en.eGens) == listLen(receiver.seParams)
        ? substitute(ft, paramMapping(en.eGens, receiver.seParams))
        : ft
      (o: PStmt)   => ft
    ()         => ft

# A call compiles its ARGUMENT first: the argument may itself be a generic
# call whose result type only grounds once compiled — inferring the callee's
# type params from the un-compiled argument would bind them to a placeholder-
# bearing type that never monomorphises. While the argument's type has not
# settled to a tuple, the callee is NOT recompiled and the call does not wrap
# itself: retry next pass. Once it has, the CALLEE compiles against the full
# shape this call site needs — CallableSpec(argument tuple, expected result).
# NewEnumExpression.compile (new.py:185-210): thread each construction
# argument's declared FIELD type down — the argument node owns any boxing
# toward it; the constructed value owns its conversion to the receiver.
fun compileNewEnum(ne: PeNewEnum, r: Resolver, expected: Spec|None): ExprOut
  let leafFields = cneLeafFields(ne, r)
  let out = cneArgs(chain(ne.fieldArgs), leafFields, r, List<PFieldArg>(),
                    List<PStmt>())
  let e2 = PeNewEnum(ne.rootName, ne.leafName, out.cneFas, ne.neTypeParams,
                     ne.penewLine)
  ret ExprOut(converted(e2, expected, r), out.cneGlobals)

fun cneLeafFields(ne: PeNewEnum, r: Resolver): List<PStmt>
  ret match(soleItem(findType(r, ne.rootName)))
    (f: Found) => match(f.fStmt)
      (root: PsEnum) => cneLeafFieldsOf(ne, root)
      (o: PStmt)     => List<PStmt>()
    ()          => List<PStmt>()

fun cneLeafFieldsOf(ne: PeNewEnum, root: PsEnum): List<PStmt>
  ret match(asEnumVariant(root.eSpec))
    (sp: SEnum) => contains2(sp.seAllLeaves, ne.leafName)
      ? forceNth(collectLeafFieldSets(root, List<PStmt>()),
                 indexOfString(sp.seAllLeaves, ne.leafName, 0))
      : List<PStmt>()
    ()           => List<PStmt>()

class [final] CneOut(cneFas: List<PFieldArg>, cneGlobals: List<PStmt>)

fun [tail] cneArgs(fas: Chain<PFieldArg>, leafFields: List<PStmt>, r: Resolver,
                   acc: List<PFieldArg>, globals2: List<PStmt>): CneOut
  ret match(fas)
    (nil: ChainEnd) => CneOut(acc, globals2)
    (l: ChainLink)  => compileExpr(l.value.faValue, r,
                                   letTypeOf(letNamed(leafFields,
                                                      l.value.faName)))
      |> (o) => cneArgs(l.next, leafFields, r,
                        append(acc, PFieldArg(l.value.faName, o.eoExpr)),
                        concat(globals2, o.eoGlobals))

fun compileCall(c: PeCall, r: Resolver, expected: Spec|None): ExprOut
  let arg = compileExpr(c.parameter, r, paramShapeOf(exprType(c.function, r)))
  ret match(exprType(arg.eoExpr, r))
    (pt: Spec) => match(pt)
      (tp: STuple) => callWithShape(c, r, arg, tp, expected)
      (o: Spec)    => partialCall(c, arg)
    ()         => partialCall(c, arg)

fun partialCall(c: PeCall, arg: ExprOut): ExprOut
  ret ExprOut(PeCall(c.function, arg.eoExpr, c.pecLine), arg.eoGlobals)

fun callWithShape(c: PeCall, r: Resolver, arg: ExprOut, tp: STuple,
                  expected: Spec|None): ExprOut
  let fn = compileExpr(c.function, r, SCallable(tp, expected, c.pecLine))
  ret ExprOut(converted(PeCall(fn.eoExpr, arg.eoExpr, c.pecLine), expected, r),
              concat(fn.eoGlobals, arg.eoGlobals))

fun paramShapeOf(ft: Spec|None): Spec|None
  ret match(ft)
    (f: Spec) => match(f)
      (cl: SCallable) => cl.scParams2
      (o: Spec)       => None
    ()        => None

# A tuple converges FIELD-WISE against a tuple receiver: each entry compiles
# toward the field it BINDS (positionally, or by NAME — `f(5, bias = 7)`
# converges its second entry toward `bias`, not toward index 1), and the whole
# tuple then owns any box into a union.
fun compileTuple(tp: PeTuple, r: Resolver, expected: Spec|None): ExprOut
  let slots = entrySlots(tp, r, expected)
  let es = compileTupEnts(chain(tp.exprs), r, slots, 0, List<PTupEnt>(),
                          List<PStmt>())
  let out = PeTuple(es.teEntries, tp.petLine)
  ret ExprOut(converted(out, expected, r), es.teGlobals)

class [final] TupEntsOut(teEntries: List<PTupEnt>, teGlobals: List<PStmt>)

fun [tail] compileTupEnts(es: Chain<PTupEnt>, r: Resolver, slots: List<SEntry>,
                          i: Int, acc: List<PTupEnt>,
                          glb: List<PStmt>): TupEntsOut
  ret match(es)
    (nil: ChainEnd) => TupEntsOut(acc, glb)
    (l: ChainLink)  => compileExpr(l.value.tupValue, r, entryAt(slots, i))
      |> (v) => compileTupEnts(l.next, r, slots, i + 1,
                               append(acc, PTupEnt(l.value.tupName,
                                                   l.value.tupSpread,
                                                   v.eoExpr)),
                               concat(glb, v.eoGlobals))

# The receiver's entries, ORDERED to match this tuple's entries via the shared
# binding. A union receiver first narrows to the tuple variant this value fits.
fun entrySlots(tp: PeTuple, r: Resolver, expected: Spec|None): List<SEntry>
  ret match(effectiveTarget(tp, r, expected))
    (t2: Spec) => match(t2)
      (st: STuple) => boundSlots(st, tp)
      (o: Spec)    => List<SEntry>()
    ()         => List<SEntry>()

fun effectiveTarget(tp: PeTuple, r: Resolver, expected: Spec|None): Spec|None
  ret match(expected)
    (want: Spec) => isUnion(want)
      ? tupleVariantOf(tp, r, want)
      : want
    ()           => None

fun tupleVariantOf(tp: PeTuple, r: Resolver, want: Spec): Spec|None
  ret match(exprType(tp, r))
    (actual: Spec) => isConcrete(actual)
      ? matchingTupleVariant(r, actual, want)
      : None
    ()             => None

fun boundSlots(st: STuple, tp: PeTuple): List<SEntry>
  ret match(bindTupleEntries(st.stEntries, tupNames(tp)))
    (b: List<Int>) => slotsFor(st.stEntries, b, tp)
    ()             => List<SEntry>()

fun tupNames(tp: PeTuple): List<String>
  ret nameOfEnts(chain(tp.exprs), List<String>())

fun [tail] nameOfEnts(es: Chain<PTupEnt>, acc: List<String>): List<String>
  ret match(es)
    (nil: ChainEnd) => acc
    (l: ChainLink)  => nameOfEnts(l.next, append(acc, l.value.tupName))

# bindTupleEntries answers "which SUPPLIED entry fills declared slot i" — this
# inverts it into "which declared slot does supplied entry j fill", which is
# what each entry needs to converge toward.
fun slotsFor(declared: List<SEntry>, binding: List<Int>,
             tp: PeTuple): List<SEntry>
  ret invertLoop(chain(declared), chain(binding), listLen(tp.exprs),
                 emptySlots(listLen(tp.exprs), List<SEntry>()))

fun [tail] emptySlots(n: Int, acc: List<SEntry>): List<SEntry>
  ret n <= 0 ? acc : emptySlots(n - 1, append(acc, SEntry("", None, None)))

fun [tail] invertLoop(ds: Chain<SEntry>, bs: Chain<Int>, n: Int,
                      acc: List<SEntry>): List<SEntry>
  ret match(ds)
    (nil: ChainEnd) => acc
    (d: ChainLink)  => match(bs)
      (nil2: ChainEnd) => acc
      (b: ChainLink)   => invertLoop(d.next, b.next, n,
                                     b.value >= 0 && b.value < n
                                       ? setAt(acc, b.value, d.value)
                                       : acc)

fun setAt(es: List<SEntry>, i: Int, v: SEntry): List<SEntry>
  ret setLoop(chain(es), i, v, 0, List<SEntry>())

fun [tail] setLoop(es: Chain<SEntry>, i: Int, v: SEntry, at: Int,
                   acc: List<SEntry>): List<SEntry>
  ret match(es)
    (nil: ChainEnd) => acc
    (l: ChainLink)  => setLoop(l.next, i, v, at + 1,
                               append(acc, at == i ? v : l.value))

# A branch threads the receiver's type into BOTH sides — each arm owns its own
# conversion — while the branch's own type stays the honest JOIN of its arms.
fun compileTernary(te: PeTernary, r: Resolver, expected: Spec|None): ExprOut
  let cond = compileExpr(te.condition, r, SBuiltin("bool", te.pety))
  let t2 = compileExpr(te.trueResult, r, expected)
  let f = compileExpr(te.falseResult, r, expected)
  ret ExprOut(PeTernary(cond.eoExpr, t2.eoExpr, f.eoExpr, te.pety),
              concat(cond.eoGlobals, concat(t2.eoGlobals, f.eoGlobals)))

# The subject compiles first (no expectation). Its type is the bound ELSE
# arm's binding type — only this level knows it — and, when it is a CONCRETE
# generic-enum instantiation, its type arguments propagate onto each variant
# arm that didn't spell them out. In generic context the args are still
# placeholders/unresolved and correctly stay put; the fixpoint fires the
# propagation once they ground.
fun compileMatch(mt: PeMatch, r: Resolver, expected: Spec|None): ExprOut
  let subj = compileExpr(mt.subject, r, None)
  let subjTy = exprType(subj.eoExpr, r)
  let arms = compileArms(chain(mt.arms), r, subjTy, expected,
                         List<PArm>(), List<PStmt>())
  ret ExprOut(PeMatch(subj.eoExpr, arms.aoArms, mt.pemLine),
              concat(subj.eoGlobals, arms.aoGlobals))

class [final] ArmsOut(aoArms: List<PArm>, aoGlobals: List<PStmt>)

fun [tail] compileArms(as2: Chain<PArm>, r: Resolver, subjTy: Spec|None,
                       expected: Spec|None, acc: List<PArm>,
                       glb: List<PStmt>): ArmsOut
  ret match(as2)
    (nil: ChainEnd) => ArmsOut(acc, glb)
    (l: ChainLink)  => compileArm(l.value, r, subjTy, expected)
      |> (a) => compileArms(l.next, r, subjTy, expected, append(acc, a.a1Arm),
                            concat(glb, a.a1Globals))

class [final] ArmOut(a1Arm: PArm, a1Globals: List<PStmt>)

# The arm's bound name resolves to a LOCAL let of the arm's own type (a bound
# else arm: of the subject's type) under a per-arm UNIQUE name — two arms may
# bind the same identifier at different types. The body and the guard see the
# binding; the arm is renamed in the same pass so it stays in sync with the
# body's rewritten names.
fun compileArm(a0: PArm, r: Resolver, subjTy: Spec|None,
               expected: Spec|None): ArmOut
  let a = propagateSubjParams(a0, subjTy)
  let bodyR = bindingScope(a, armBindType(a, subjTy), r)
  let body = compileExpr(a.armBody, bodyR, expected)
  let ty = compileSpecOpt(a.armType, r)
  let lits = compileLits(chain(a.armLiterals), r, List<PLit>(), List<PStmt>())
  let guard = compileExprOpt(a.armGuard, bodyR, None)
  ret ArmOut(PArm(armUniqueName(a), specOf(ty), body.eoExpr, lits.loLits,
                  exprOf(guard), a.parmLine),
             concat(body.eoGlobals,
                    concat(globalsOfSpec(ty),
                           concat(lits.loGlobals, globalsOf(guard)))))

fun armBindType(a: PArm, subjTy: Spec|None): Spec|None
  ret match(a.armType)
    (t2: Spec) => a.armType
    ()         => subjTy

# _arm_unique_name: idempotent per-arm rename, derived from the line ref so it
# is deterministic across runs and stable across passes. No name, `_`, or an
# already-suffixed name returns verbatim.
fun armUniqueName(a: PArm): String
  ret a.armName == "" || a.armName == "_" || contains(a.armName, "@arm")
    ? a.armName
    : a.armName + "@arm" + hash6(a.parmLine.plFile, a.parmLine.plLine,
                                 a.parmLine.plCol)

fun bindingScope(a: PArm, ty: Spec|None, r: Resolver): Resolver
  ret a.armName == "" || a.armName == "_"
    ? r
    : match(ty)
      (t2: Spec) => RData(append(List<Found>(),
                                 Found(armUniqueName(a), armBinderLet(a, t2),
                                       ScLocal())),
                          r)
      ()         => r

fun armBinderLet(a: PArm, ty: Spec): PStmt
  ret PsLet(armUniqueName(a), List<PAttr>(), List<PGen>(), ty, None, "",
            List<Spec>(), a.parmLine)

fun propagateSubjParams(a: PArm, subjTy: Spec|None): PArm
  ret match(subjTy)
    (st: Spec) => concreteParams(typeParamsOf(st))
      ? withSubjParams(a, typeParamsOf(st))
      : a
    ()         => a

fun withSubjParams(a: PArm, params: List<Spec>): PArm
  ret match(a.armType)
    (t2: Spec) => withArmSpecParams(a, t2, params)
    ()         => a

fun withArmSpecParams(a: PArm, t2: Spec, params: List<Spec>): PArm
  ret match(t2)
    (n: SNamed) => isEmpty(n.snParams)
      ? PArm(a.armName, SNamed(n.snName, params, n.snLine), a.armBody,
             a.armLiterals, a.armGuard, a.parmLine)
      : a
    (e2: SEnum) => isEmpty(e2.seParams)
      ? PArm(a.armName, SEnum(e2.seRoot, e2.seValidLeaves, e2.seAllLeaves,
                              params, e2.seLine, e2.seComplex),
             a.armBody, a.armLiterals, a.armGuard, a.parmLine)
      : a
    (o: Spec)   => a

fun typeParamsOf(sp: Spec): List<Spec>
  ret match(sp)
    (n: SNamed) => n.snParams
    (c: SClass) => c.scParams
    (e2: SEnum) => e2.seParams
    (o: Spec)   => List<Spec>()

# Concrete = non-empty and free of NamedSpec / placeholder args.
fun concreteParams(ps: List<Spec>): Bool
  ret !isEmpty(ps) && !anyHoleParam(chain(ps))

fun [tail] anyHoleParam(ps: Chain<Spec>): Bool
  ret match(ps)
    (nil: ChainEnd) => false
    (l: ChainLink)  => match(l.value)
      (n: SNamed)   => true
      (g: SGeneric) => true
      (o: Spec)     => anyHoleParam(l.next)

class [final] LitsOut(loLits: List<PLit>, loGlobals: List<PStmt>)
class [final] LitOut(l1Lit: PLit, l1Globals: List<PStmt>)

fun [tail] compileLits(ls: Chain<PLit>, r: Resolver, acc: List<PLit>,
                       glb: List<PStmt>): LitsOut
  ret match(ls)
    (nil: ChainEnd) => LitsOut(acc, glb)
    (l: ChainLink)  => compileLit(l.value, r)
      |> (o) => compileLits(l.next, r, append(acc, o.l1Lit),
                            concat(glb, o.l1Globals))

fun compileLit(l: PLit, r: Resolver): LitOut
  ret match(l)
    (e2: PlExpr)  => litExprOut(compileExpr(e2.litExpr, r, None))
    (rg: PlRange) => litRangeOut(rg, compileExpr(rg.rangeLo, r, None),
                                 compileExpr(rg.rangeHi, r, None))

fun litExprOut(o: ExprOut): LitOut
  ret LitOut(PlExpr(o.eoExpr), o.eoGlobals)

fun litRangeOut(rg: PlRange, lo: ExprOut, hi: ExprOut): LitOut
  ret LitOut(PlRange(lo.eoExpr, hi.eoExpr, rg.plrLine),
             concat(lo.eoGlobals, hi.eoGlobals))

# A block defers to its VALUE: the receiver's type threads through to it, and
# the block's own type is the value's.
# A block's own lets are in scope for its statements AND for its value.
fun compileBlock(bk: PeBlock, r0: Resolver, expected: Spec|None): ExprOut
  # A block is never top level, so every function declared in it is an INNER
  # function: mark it (idempotent), so it establishes no trait scope of its
  # own. Then fold any else-if chains among the statements (the first of the
  # two fold sites; each if's branches fold their own).
  let stmts = collapseElseIf(markInner(chain(bk.blockStmts), List<PStmt>()))
  let r = blockScope(stmts, r0)
  # Every statement receives the block's EXPECTED type (Python threads
  # expected_type to each) — that is how a `ret` inside an if branch sees the
  # function's return type and its value converges toward it.
  let ss = compileStmts(chain(stmts), r, expected, List<PStmt>(), List<PStmt>())
  let v = compileExpr(bk.blockValue, r, expected)
  ret ExprOut(PeBlock(ss.slStmts, v.eoExpr, bk.blockTag, bk.pebkLine),
              concat(ss.slGlobals, v.eoGlobals))

fun [tail] markInner(ss: Chain<PStmt>, acc: List<PStmt>): List<PStmt>
  ret match(ss)
    (nil: ChainEnd) => acc
    (l: ChainLink)  => markInner(l.next, append(acc, markOne(l.value)))

fun markOne(st: PStmt): PStmt
  ret match(st)
    (f: PsFun) => f.fNested
      ? st
      : PsFun(f.fName, f.fAttrs, f.fGens, f.fParams, f.fBody, f.fRet,
              f.fWheres, f.psfLine, f.fRetInferred, true, f.fImports)
    (o: PStmt) => st

# A primitive op owns its conversion — its result boxing into a union slot —
# EXCEPT when it folds: an integer comparison of two bigint literals (the body
# of Int's ==/</>) collapses to a Bool literal. The language has no true/false
# token, so this fold is what lets a constant Bool become a literal and inline.
fun compileBuiltinOp(op: PeBuiltinOp, r: Resolver, expected: Spec|None): ExprOut
  let ps = compileExpr(op.opParams, r, None)
  let out = PeBuiltinOp(op.opType, op.opName, ps.eoExpr, op.peboLine)
  ret match(foldConstCompare(out))
    (b: PExpr) => ExprOut(b, ps.eoGlobals)
    ()         => ExprOut(converted(out, expected, r), ps.eoGlobals)

# Takes the ROOT type: an enum-variant constructor yields the root, so a caller
# that has just built a PeBuiltinOp cannot pass it as one.
fun foldConstCompare(x: PExpr): PExpr|None
  ret match(x)
    (op: PeBuiltinOp) => foldOp(op)
    (o: PExpr)        => None

fun foldOp(op: PeBuiltinOp): PExpr|None
  if !isBoolBuiltin(op.opType)
    ret None
  ret match(opName(op.opName))
    (nm: String) => foldWith(nm, op)
    ()           => None

fun isBoolBuiltin(sp: Spec): Bool
  ret match(sp)
    (b: SBuiltin) => b.sbName == "bool"
    (o: Spec)     => false

fun opName(x: PExpr): String|None
  ret match(x)
    (s2: PeStr) => s2.strValue
    (o: PExpr)  => None

fun foldWith(nm: String, op: PeBuiltinOp): PExpr|None
  if nm != "integer_test_eq" && nm != "integer_test_lt" && nm != "integer_test_gt"
    ret None
  ret match(twoBigints(op.opParams))
    (p: IntPair) => PeBool(compareInts(nm, p.ipLeft, p.ipRight), op.peboLine)
    ()           => None

class [final] IntPair(ipLeft: Int, ipRight: Int)

# Both operands must be UNSUFFIXED (precision 0) integer literals — a sized
# literal is a different type and does not fold here.
fun twoBigints(params: PExpr): IntPair|None
  ret match(params)
    (tp: PeTuple) => listLen(tp.exprs) == 2 ? pairOf(tp) : None
    (o: PExpr)    => None

fun pairOf(tp: PeTuple): IntPair|None
  ret match(bigintAt(tp.exprs, 0))
    (a: Int) => match(bigintAt(tp.exprs, 1))
      (b: Int) => IntPair(a, b)
      ()       => None
    ()       => None

fun bigintAt(es: List<PTupEnt>, i: Int): Int|None
  ret match(entAt(chain(es), i))
    (en: PTupEnt) => bigintOf(en.tupValue)
    ()            => None

fun [tail] entAt(es: Chain<PTupEnt>, i: Int): PTupEnt|None
  ret match(es)
    (nil: ChainEnd) => None
    (l: ChainLink)  => i <= 0 ? l.value : entAt(l.next, i - 1)

fun bigintOf(x: PExpr): Int|None
  ret match(x)
    (i: PeInt) => i.precision == 0 ? i.value : None
    (o: PExpr) => None

fun compareInts(nm: String, a: Int, b: Int): Bool
  ret nm == "integer_test_eq" ? a == b
    : nm == "integer_test_lt" ? a < b
    : a > b

fun compileNew(nw: PeNew, r: Resolver, expected: Spec|None): ExprOut
  let ty = compileSpec(nw.newType, r)
  let arg = compileExpr(nw.newParam, r, paramsTupleOfSpec(ty.soSpec))
  let out = PeNew(ty.soSpec, arg.eoExpr, nw.penwLine)
  ret ExprOut(converted(out, expected, r),
              concat(ty.soGlobals, arg.eoGlobals))

fun paramsTupleOfSpec(sp: Spec): Spec|None
  ret match(sp)
    (t2: STuple) => t2
    (o: Spec)    => None

fun compileArrayRead(ar: PeArrayRead, r: Resolver, expected: Spec|None): ExprOut
  let obj = compileExpr(ar.arrObj, r, None)
  let idx = compileExpr(ar.arrIndex, r, SBuiltin("int32", ar.pearLine))
  let out = PeArrayRead(obj.eoExpr, idx.eoExpr, ar.pearLine)
  ret ExprOut(converted(out, expected, r),
              concat(obj.eoGlobals, idx.eoGlobals))

fun compileParallel(pl: PeParallel, r: Resolver): ExprOut
  let ps = compileExpr(pl.parParams, r, None)
  ret ExprOut(PeParallel(ps.eoExpr, pl.pepLine), ps.eoGlobals)


# ── `with subject(name = value, …)` — EXPANDS here once types resolve ───────
# Mirror of WithExpression.__expand, name for name (tags from the with's own
# line hash, so both compilers synthesise byte-identical trees):
#
#   Block[ let $ws = subject; let $w0 = v0; … ]
#     Ternary( yafl_same($w0, $ws.f0) && …,
#              $ws,
#              match($ws) (x: Leaf) => Leaf(…) … )     [or a direct ctor]
#
# Shape/visibility problems leave the node UNEXPANDED; checkWith reports.

fun compileWith(wx: PeWith, r: Resolver, expected: Spec|None): ExprOut
  let subj = compileExpr(wx.withSubject, r, None)
  let reps = compileExpr(wx.withRepls, r, None)
  let node: PExpr = PeWith(subj.eoExpr, reps.eoExpr, wx.pewLine)
  let glb = concat(subj.eoGlobals, reps.eoGlobals)
  ret match(node)
    (nw: PeWith) => withShapeError(nw) != ""
      ? ExprOut(node, glb)
      : match(withExpand(nw, r))
        (x: PExpr) => ExprOut(converted(x, expected, r), glb)
        ()         => ExprOut(node, glb)
    (o: PExpr)   => ExprOut(node, glb)   # unreachable: node is built above

fun withExpand(wx: PeWith, r: Resolver): PExpr|None
  ret match(exprType(wx.withSubject, r))
    (sp: Spec) => match(sp)
      (c: SClass) => withExpandClass(wx, c, r)
      (e2: SEnum) => withExpandEnum(wx, e2, r)
      (o: Spec)   => None
    ()         => None

fun withTag(lr: PLine): String
  ret hash6(lr.plFile, lr.plLine, lr.plCol)

fun withEntryList(wx: PeWith): List<PTupEnt>
  ret match(wx.withRepls)
    (tp: PeTuple) => tp.exprs
    (o: PExpr)    => List<PTupEnt>()

# The subject and each replacement bind ONCE; replacements are referred to by
# their $w{i} names thereafter.
fun withLets(wx: PeWith, tag: String): List<PStmt>
  let lr = wx.pewLine
  let base = list1<PStmt>(PsLet("$ws@" + tag, List<PAttr>(), List<PGen>(),
                                None, wx.withSubject, "", List<Spec>(), lr))
  ret withReplLets(chain(withEntryList(wx)), 0, tag, lr, base)

fun [tail] withReplLets(es: Chain<PTupEnt>, i: Int, tag: String, lr: PLine,
                        acc: List<PStmt>): List<PStmt>
  ret match(es)
    (nil: ChainEnd) => acc
    (l: ChainLink)  => withReplLets(l.next, i + 1, tag, lr,
                        append<PStmt>(acc,
                          PsLet("$w" + String(i) + "@" + tag, List<PAttr>(),
                                List<PGen>(), None, l.value.tupValue, "",
                                List<Spec>(), lr)))

fun withReplRef(name: String, es: List<PTupEnt>, lr: PLine): PExpr|None
  ret withReplRefLoop(chain(es), name, 0, lr)

fun [tail] withReplRefLoop(es: Chain<PTupEnt>, name: String, i: Int,
                           lr: PLine): PExpr|None
  ret match(es)
    (nil: ChainEnd) => None
    (l: ChainLink)  => l.value.tupName == name
      ? PeName("$w" + String(i), List<Spec>(), lr)
      : withReplRefLoop(l.next, name, i + 1, lr)

# SAME guard: every replacement bit-identical to the current field.
fun withGuard(wx: PeWith, lr: PLine): PExpr
  ret withGuardLoop(chain(withEntryList(wx)), 0, None, lr)

fun [tail] withGuardLoop(es: Chain<PTupEnt>, i: Int, acc: PExpr|None,
                         lr: PLine): PExpr
  ret match(es)
    (nil: ChainEnd) => match(acc)
      (a: PExpr) => a
      ()         => PeBool(true, lr)   # unreachable: shape demands entries
    (l: ChainLink)  => withGuardLoop(l.next, i + 1,
        withAnd(acc,
                PeBuiltinOp(SBuiltin("bool", lr), PeStr("yafl_same", lr),
                            PeTuple(append(list1(PTupEnt("", false,
                                     PeName("$w" + String(i), List<Spec>(), lr))),
                                    PTupEnt("", false,
                                     PeDot(PeName("$ws", List<Spec>(), lr),
                                           l.value.tupName, lr))), lr), lr),
                lr),
        lr)

fun withAnd(acc: PExpr|None, one: PExpr, lr: PLine): PExpr
  ret match(acc)
    (a: PExpr) => PeTernary(a, one, PeBool(false, lr), lr)
    ()         => one

# Constructor call mixing carried fields with replacements.
fun withConstruct(ctorName: String, fields: List<PStmt>, repls: List<PTupEnt>,
                  carrier: String, lr: PLine): PExpr
  ret PeCall(PeName(ctorName, List<Spec>(), lr),
             PeTuple(withCtorArgs(chain(fields), repls, carrier, lr,
                                  List<PTupEnt>()), lr), lr)

fun [tail] withCtorArgs(fs: Chain<PStmt>, repls: List<PTupEnt>,
                        carrier: String, lr: PLine,
                        acc: List<PTupEnt>): List<PTupEnt>
  ret match(fs)
    (nil: ChainEnd) => acc
    (l: ChainLink)  => match(l.value)
      (p: PsLet) => withCtorArgs(l.next, repls, carrier, lr,
          append(acc, PTupEnt("", false,
                              withCtorArg(bareName(p.lName), repls, carrier,
                                          lr))))
      (o: PStmt) => withCtorArgs(l.next, repls, carrier, lr, acc)

fun withCtorArg(bare: String, repls: List<PTupEnt>, carrier: String,
                lr: PLine): PExpr
  ret match(withReplRef(bare, repls, lr))
    (rr: PExpr) => rr
    ()          => PeDot(PeName(carrier, List<Spec>(), lr), bare, lr)

fun withExpandClass(wx: PeWith, c: SClass, r: Resolver): PExpr|None
  ret match(soleItem(findType(r, c.scName)))
    (f: Found) => match(f.fStmt)
      (cls: PsClass) => withNamesOk(wx, withBareNames(chain(flattenParams(cls.cParams)), List<String>()))
        ? withAssemble(wx,
            withConstruct(cls.cName, flattenParams(cls.cParams),
                          withEntryList(wx), "$ws", wx.pewLine))
        : None
      (o: PStmt)     => None
    ()         => None

fun withNamesOk(wx: PeWith, visible: List<String>): Bool
  ret withNamesOkLoop(chain(withEntryList(wx)), visible)

fun [tail] withNamesOkLoop(es: Chain<PTupEnt>, visible: List<String>): Bool
  ret match(es)
    (nil: ChainEnd) => true
    (l: ChainLink)  => contains2(visible, l.value.tupName)
      ? withNamesOkLoop(l.next, visible)
      : false

fun withExpandEnum(wx: PeWith, e2: SEnum, r: Resolver): PExpr|None
  ret match(soleItem(findType(r, e2.seRoot)))
    (f: Found) => match(f.fStmt)
      (en: PsEnum) => withNamesOk(wx,
                        withCoverBares(chain(coveringFields(en, e2.seValidLeaves)),
                                       List<String>()))
        ? withEnumCopy(wx, en, e2)
        : None
      (o: PStmt)   => None
    ()         => None

fun withEnumCopy(wx: PeWith, en: PsEnum, e2: SEnum): PExpr|None
  let lr = wx.pewLine
  let tag = withTag(lr)
  let leaves = withLeaves(en, List<PStmt>(),
                          (List<String>(), List<List<PStmt>>()))
  let valid = withValidLeaves(chain(leaves.names), e2.seValidLeaves)
  if isEmpty(valid)
    ret None
  if listLen(valid) == 1
    # A single valid leaf needs no dispatch — carried fields read through the
    # binder-free subject, exactly as Python's single-arm special case.
    ret withAssemble(wx,
          withSingleLeaf(chain(leaves.names), chain(leaves.sets),
                         wx, e2, lr))
  ret withAssemble(wx,
        PeMatch(PeName("$ws", List<Spec>(), lr),
                withArms(chain(leaves.names), chain(leaves.sets), 0, tag,
                         wx, e2, List<PArm>()),
                lr))

fun withValidLeaves(ns: Chain<String>, valid: List<String>): List<String>
  ret withValidLoop(ns, valid, List<String>())

fun [tail] withValidLoop(ns: Chain<String>, valid: List<String>,
                         acc: List<String>): List<String>
  ret match(ns)
    (nil: ChainEnd) => acc
    (l: ChainLink)  => contains2(valid, l.value)
      ? withValidLoop(l.next, valid, append(acc, l.value))
      : withValidLoop(l.next, valid, acc)

fun [tail] withSingleLeaf(ns: Chain<String>, sets: Chain<List<PStmt>>,
                          wx: PeWith, e2: SEnum, lr: PLine): PExpr
  ret match(ns)
    (nil: ChainEnd) => PeName("$ws", List<Spec>(), lr)  # unreachable
    (n: ChainLink)  => match(sets)
      (nil2: ChainEnd) => PeName("$ws", List<Spec>(), lr)  # unreachable
      (l: ChainLink)   => contains2(e2.seValidLeaves, n.value)
        ? withConstruct(n.value, l.value, withEntryList(wx), "$ws", lr)
        : withSingleLeaf(n.next, l.next, wx, e2, lr)

fun [tail] withArms(ns: Chain<String>, sets: Chain<List<PStmt>>, i: Int,
                    tag: String, wx: PeWith, e2: SEnum,
                    acc: List<PArm>): List<PArm>
  ret match(ns)
    (nil: ChainEnd) => acc
    (n: ChainLink)  => match(sets)
      (nil2: ChainEnd) => acc
      (l: ChainLink)   => !contains2(e2.seValidLeaves, n.value)
        ? withArms(n.next, l.next, i + 1, tag, wx, e2, acc)
        : withArms(n.next, l.next, i + 1, tag, wx, e2,
            append(acc, PArm("$wx" + String(i) + "@" + tag,
                             SNamed(n.value, List<Spec>(), wx.pewLine),
                             withConstruct(n.value, l.value, withEntryList(wx),
                                           "$wx" + String(i), wx.pewLine),
                             List<PLit>(), None, wx.pewLine)))

fun withAssemble(wx: PeWith, copy: PExpr): PExpr
  let lr = wx.pewLine
  ret PeBlock(withLets(wx, withTag(lr)),
              PeTernary(withGuard(wx, lr),
                        PeName("$ws", List<Spec>(), lr), copy, lr),
              "", lr)

# (leaf unique name, fields root-down), declaration order.
fun withLeaves(st: PsEnum, inherited: List<PStmt>,
               acc: (names: List<String>, sets: List<List<PStmt>>)): (names: List<String>, sets: List<List<PStmt>>)
  let own = concat(inherited, flattenParams(st.eParams))
  if isEmpty(st.eVariants)
    ret st.eHasParams
      ? (append(acc.names, st.eName), append(acc.sets, own))
      : acc
  ret withLeavesLoop(chain(st.eVariants), own, acc)

fun [tail] withLeavesLoop(vs: Chain<PStmt>, own: List<PStmt>,
                          acc: (names: List<String>, sets: List<List<PStmt>>)): (names: List<String>, sets: List<List<PStmt>>)
  ret match(vs)
    (nil: ChainEnd) => acc
    (l: ChainLink)  => match(l.value)
      (v: PsEnum) => withLeavesLoop(l.next, own, withLeaves(v, own, acc))
      (o: PStmt)  => withLeavesLoop(l.next, own, acc)
