# bootstrap/resolver.yafl — name resolution, ported from
# compiler/pyast/resolver.py.
#
# The two ideas that matter:
#  * A BAG is a found set PLUS whether the search was COMPLETE. A name is only
#    ever committed against a complete bag: an incomplete one may still be
#    missing the candidate that should win, once whatever blocked the search
#    (a NamedSpec along the way) resolves on a
#    later pass. Combining bags unions the items and ANDs completeness.
#  * A resolver is a CHAIN of scopes over one immutable statement index; each
#    layer answers what it knows and delegates the rest outward.
namespace Bootstrap::Resolve

import System

import Bootstrap::Ast
import Bootstrap::Parse
import Bootstrap::Types



# ── names ───────────────────────────────────────────────────────────────────
# A unique name is `path::name@hash`; queries are written without the hash.

fun simpleName(name: String): String
  let at = lastIndexOf(name, '@')
  ret at < 0 ? name : slice(name, 0, at)

# The unqualified simple name: hash suffix AND namespace path both stripped.
fun bareOfUnique(name: String): String
  let s = simpleName(name)
  let ix = lastSep(s, 0, -1)
  ret ix < 0 ? s : slice(s, ix + 2, length(s))

fun [tail] lastSep(s: String, at: Int, best: Int): Int
  if at + 1 >= length(s)
    ret best
  ret lastSep(s, at + 1,
              byteAt(s, at) == ':' && byteAt(s, at + 1) == ':' ? at : best)

fun matchName(left: String, right: String): Bool
  ret simpleName(left) == simpleName(right)

# A candidate matches a query when identical, or when it is the query's
# fully-qualified form (`query@hash`).
fun nameMatches(candidate: String, query: String): Bool
  ret candidate == query || startsWith(candidate, query + "@")

fun lastIndexOf(s: String, c: Int32): Int
  ret lastIndexLoop(s, 0, -1, c)

fun [tail] lastIndexLoop(s: String, at: Int, best: Int, c: Int32): Int
  ret at >= length(s)
    ? best
    : lastIndexLoop(s, at + 1, byteAt(s, at) == c ? at : best, c)

# Every prefix of a name at its `@` boundaries — the index keys, so a
# prefix-match lookup is a plain hit rather than a scan.
fun namePrefixes(name: String): List<String>
  ret prefixLoop(chain(split(name, "@")), "", List<String>())

fun prefixLoop(ps: Chain<String>, acc: String,
                      out: List<String>): List<String>
  ret build<String >(prefixLoopB(ps, acc, _pushChain<String >(builder<String >(), chain<String >(out))))

fun [tail] prefixLoopB(ps: Chain<String>, acc: String,
                      [terminal] out: ListBuilder<String >): ListBuilder<String >
  ret match(ps)
    (nil: ChainEnd) => out
    (l: ChainLink)  => acc == ""
      ? prefixLoopB(l.next, l.value, push<String >(out, l.value))
      : prefixLoopB(l.next, acc + "@" + l.value,
                   push<String >(out, acc + "@" + l.value))

# ── bags ────────────────────────────────────────────────────────────────────

enum RScope
  enum ScGlobal()
  enum ScLocal()
  enum ScMember()
  enum ScTrait()

# fTraitScope / fOwner: for a TRAIT-scoped find, the interface INSTANTIATION
# the member came through (Plus<Int>) and the interface's own declaration —
# overload resolution substitutes the instantiation's type args through the
# member's type (Resolved.trait_scope / owner_class).
# fInstanceParams: placeholder names owned by the GENERIC `[ambient]`
# instance whose interface pattern produced this candidate — the use site may
# bind them (the generic-function-candidate rule); empty for every other
# provenance (Resolved.instance_params in Python).
class [final] Found(fName: String, fStmt: PStmt, fScope: RScope,
                    fTraitScope: Spec|None = None, fOwner: PStmt|None = None,
                    fInstanceParams: List<String>|None = None)

class [final] Findings(bItems: List<Found>, bComplete: Bool)

fun emptyFindings(): Findings
  ret Findings(List<Found>(), true)

# Nothing found YET: the search was blocked, so absence proves nothing.
fun incompleteFindings(): Findings
  ret Findings(List<Found>(), false)

fun addFindings(a: Findings, b: Findings): Findings
  ret Findings(concat(a.bItems, b.bItems), a.bComplete && b.bComplete)

fun soleItem(b: Findings): Found|None
  ret exactly(chain(b.bItems), 1) ? head(b.bItems) : None

# ── the statement index ─────────────────────────────────────────────────────
# Built ONCE per statement set: name-prefix → statements, plus the two
# collection-wide scans the resolver needs. A changed statement set is a NEW
# index, so there is never a stale one to reason about across passes.

# stAmbient/stAmbientBlocked: the `instance [ambient]` PATTERNS — (own
# namespace, interface spec, instance-owned placeholder names) — plus whether
# any witness is still unresolved, PRECOMPUTED once per pass here. Rebuilding
# witness lookups per QUERY made resolution cost scale with the instance
# count (self-compile 18→47 min before this memo).
class [final] AmbEntry(amNs: List<String>, amSpec: Spec, amOwn: List<String>)

# stTypesIdx/stDataIdx: the root's find answers PREBUILT once per index build
# (Python Statements._types_index/_data_index) — the same bucket walk
# globalFindings did per query, paid once instead of ~176M times per
# self-compile. Bucket order is preserved, so candidates and their order are
# byte-identical to the per-query construction; empty kinds are omitted and
# misses answer the shared empty.
# stBareTypes/stBareData: the bare-name view of the SAME kind answers —
# bare -> namespace -> the Findings the "ns::bare" key holds (Python
# Statements._bare_*), so an in-scope lookup is two dict hits instead of one
# root query per namespace. Hashed spellings are never scope-retried, so
# only @-free keys are viewed.
# stMembers: per-class member index — class name -> (the class statement,
# member key -> matching members in declaration order), the port twin of
# Python ClassStatement.member_index() ("the by-name index is a dict hit",
# base.py). Keys follow namePrefixes, so nameMatches semantics are a bucket
# hit, exactly like the global index.
class [final] MemberIdx(miClass: PsClass,
                        miByKey: Dict<String, List<PStmt> >)

class [final] Statements(stOrdered: List<PStmt>,
                         stIndex: Dict<String, List<PStmt> >,
                         stTraits: List<PStmt>,
                         stInstances: List<PStmt>,
                         stAmbient: List<AmbEntry>,
                         stAmbientBlocked: Bool,
                         stTypesIdx: Dict<String, Findings >,
                         stDataIdx: Dict<String, Findings >,
                         stBareTypes: Dict<String, Dict<String, Findings> >,
                         stBareData: Dict<String, Dict<String, Findings> >,
                         stMembers: Dict<String, MemberIdx >)

fun buildStatements(stmts: List<PStmt>): Statements
  ret withKindIndexes(withAmbient(indexLoop(chain(stmts),
                            Statements(stmts, Dict<String, List<PStmt> >(),
                                       List<PStmt>(), List<PStmt>(),
                                       List<AmbEntry>(), false,
                                       Dict<String, Findings >(),
                                       Dict<String, Findings >(),
                                       Dict<String, Dict<String, Findings> >(),
                                       Dict<String, Dict<String, Findings> >(),
                                       Dict<String, MemberIdx >()))))

fun withKindIndexes(base: Statements): Statements
  # keys() answers a Set; sorted once into a walkable list (the walk order is
  # unobservable — the kind dicts are only ever queried by key).
  let ks = sort(keys(base.stIndex))
  let types2 = kindLoop(chain(ks), base.stIndex, true, Dict<String, Findings >())
  let data2 = kindLoop(chain(ks), base.stIndex, false, Dict<String, Findings >())
  ret Statements(base.stOrdered, base.stIndex, base.stTraits,
                 base.stInstances, base.stAmbient, base.stAmbientBlocked,
                 types2, data2,
                 bareView(chain(ks), types2,
                          Dict<String, Dict<String, Findings> >()),
                 bareView(chain(ks), data2,
                          Dict<String, Dict<String, Findings> >()),
                 memberIndex(chain(base.stOrdered), Dict<String, MemberIdx >()))

fun [tail] bareView(ks: Chain<String>, kind: Dict<String, Findings >,
                    acc: Dict<String, Dict<String, Findings> >): Dict<String, Dict<String, Findings> >
  ret match(ks)
    (nil: ChainEnd) => acc
    (l: ChainLink)  => contains(l.value, "@")
      ? bareView(l.next, kind, acc)
      : bareView(l.next, kind, bareViewAdd(acc, kind, l.value))

fun bareViewAdd(acc: Dict<String, Dict<String, Findings> >,
                kind: Dict<String, Findings >,
                key: String): Dict<String, Dict<String, Findings> >
  ret match(get(kind, key))
    (f: Findings) => bareViewPut(acc, bareOfUnique(key), namespacePart(key), f)
    ()            => acc

fun bareViewPut(acc: Dict<String, Dict<String, Findings> >, bare: String,
                ns: String, f: Findings): Dict<String, Dict<String, Findings> >
  ret match(get(acc, bare))
    (inner: Dict<String, Findings>) => put(acc, bare, put(inner, ns, f))
    ()                               => put(acc, bare,
                                            put(Dict<String, Findings >(), ns, f))

fun [tail] memberIndex(ss: Chain<PStmt>,
                       acc: Dict<String, MemberIdx >): Dict<String, MemberIdx >
  ret match(ss)
    (nil: ChainEnd) => acc
    (l: ChainLink)  => match(l.value)
      (cs: PsClass) => memberIndex(l.next,
          put(acc, cs.cName,
              MemberIdx(cs, memberKeys(chain(concat(flattenParams(cs.cParams),
                                                    cs.cMembers)),
                                       Dict<String, List<PStmt> >()))))
      (o: PStmt)    => memberIndex(l.next, acc)

# member_index: ctor params (flattened to leaf lets) PLUS body statements, in
# declaration order — the order memberMatchesB walked. addKeys is the same
# helper the global index uses, so bucket semantics match nameMatches.
fun [tail] memberKeys(ms: Chain<PStmt>,
                      acc: Dict<String, List<PStmt> >): Dict<String, List<PStmt> >
  ret match(ms)
    (nil: ChainEnd) => acc
    (l: ChainLink)  => stmtName(l.value) == ""
      ? memberKeys(l.next, acc)
      : memberKeys(l.next, addKeys(acc, chain(namePrefixes(stmtName(l.value))),
                                   l.value))

# The per-pass member index, when the root carries one; a miss (direct RRoot
# builder, or a class spelling the canonical key does not cover) derives per
# query as before.
fun [tail] memberIdxHook(r: Resolver, className: String): MemberIdx|None
  ret match(r)
    (root: RRoot)    => get(root.rrStmts.stMembers, className)
    (sc: RScopes)    => memberIdxHook(sc.rsParent, className)
    (d: RData)       => memberIdxHook(d.rdParent, className)
    (t2: RTypes)     => memberIdxHook(t2.rtParent, className)
    (tr: RTraits)    => memberIdxHook(tr.rtrParent, className)
    (cb: RClassBody) => memberIdxHook(cb.rcbParent, className)
    (rg: RGen)       => memberIdxHook(rg.rgParent, className)

# Per key, the kind walk REUSES globalLoop — the exact per-query filter — so
# the prebuilt answers cannot diverge from what the query path produced.
fun [tail] kindLoop(ks: Chain<String>, index: Dict<String, List<PStmt> >,
                    wantType: Bool,
                    acc: Dict<String, Findings >): Dict<String, Findings >
  ret match(ks)
    (nil: ChainEnd) => acc
    (l: ChainLink)  => kindLoop(l.next, index, wantType,
                                kindPut(acc, l.value, get(index, l.value),
                                        wantType))

fun kindPut(acc: Dict<String, Findings >, key: String,
            bucket: List<PStmt>|None, wantType: Bool): Dict<String, Findings >
  let found = match(bucket)
    (b: List<PStmt>) => globalLoop(chain(b), wantType, List<Found>())
    ()               => List<Found>()
  ret isEmpty(found) ? acc : put(acc, key, Findings(found, true))

fun withAmbient(base: Statements): Statements
  let amb = buildAmbient(chain(base.stInstances),
                         builder<AmbEntry>(), false)
  ret Statements(base.stOrdered, base.stIndex, base.stTraits,
                 base.stInstances,
                 dedupeAmb(chain(amb.abEntries), List<AmbEntry>()),
                 amb.abBlocked, base.stTypesIdx, base.stDataIdx,
                 base.stBareTypes, base.stBareData, base.stMembers)

# (spec, own) dedupe, once per pass — two identical instances collapse to
# ONE search entry (Python's per-query `add` set), whichever namespaces they
# came from: the entry keeps the UNION of namespaces and is in scope when
# any of them is imported.
fun [tail] dedupeAmb(es: Chain<AmbEntry>, acc: List<AmbEntry>): List<AmbEntry>
  ret match(es)
    (nil: ChainEnd) => acc
    (l: ChainLink)  => dedupeAmb(l.next, mergeAmb(chain(acc), l.value,
                                                 builder<AmbEntry >(), false))

# Entries keep their order: it is the order the "Candidates:" message lists
# them in. An unmerged entry goes on the end.
fun [tail] mergeAmb(es: Chain<AmbEntry>, x: AmbEntry,
                    [terminal] out: ListBuilder<AmbEntry >,
                    merged: Bool): List<AmbEntry>
  ret match(es)
    (nil: ChainEnd) => build<AmbEntry >(merged
      ? out
      : push<AmbEntry >(out, x))
    (l: ChainLink)  => eqSpec(l.value.amSpec, x.amSpec)
                       && eqNameList(chain(l.value.amOwn), chain(x.amOwn))
      ? mergeAmb(l.next, x,
                 push<AmbEntry >(out, AmbEntry(mergeNames(l.value.amNs,
                                                          chain(x.amNs)),
                                               l.value.amSpec,
                                               l.value.amOwn)),
                 true)
      : mergeAmb(l.next, x, push<AmbEntry >(out, l.value), merged)

class [final] AmbBuilt(abEntries: List<AmbEntry>, abBlocked: Bool)

fun buildAmbient(ts: Chain<PStmt>,
                 acc: ListBuilder<AmbEntry>, blocked: Bool): AmbBuilt
  ret match(ts)
    (nil: ChainEnd) => AmbBuilt(build(acc), blocked)
    (l: ChainLink)  => match(l.value)
      (ti: PsTraitInstance) => ti.tiAmbient
        ? buildAmbientOne(ti, l.next, acc, blocked)
        : buildAmbient(l.next, acc, blocked)
      (o: PStmt)    => buildAmbient(l.next, acc, blocked)

# First-class instances carry the pattern DIRECTLY — no witness lookup,
# no parent substitution (TraitInstanceStatement, __build_ambient_patterns).
fun buildAmbientOne(ti: PsTraitInstance, rest: Chain<PStmt>,
                    acc: ListBuilder<AmbEntry>, blocked: Bool): AmbBuilt
  ret match(ti.tiPattern)
    (n: SNamed) => buildAmbient(rest, acc, true)
    (c: SClass) => anyNamed(chain(c.scParams))
      ? buildAmbient(rest, acc, true)
      : buildAmbient(rest,
                     push(acc, AmbEntry(prepend(namespacePart(ti.tiName),
                                                List<String>()),
                                        ti.tiPattern,
                                        genNames(chain(ti.tiGens),
                                                 builder<String>()))),
                     blocked)
    (o: Spec)   => buildAmbient(rest, acc, blocked)

fun [tail] indexLoop(ss: Chain<PStmt>, acc: Statements): Statements
  ret match(ss)
    (nil: ChainEnd) => acc
    (l: ChainLink)  => indexLoop(l.next, indexOne(acc, l.value))

fun indexOne(acc: Statements, st: PStmt): Statements
  let name = stmtName(st)
  if name == ""
    ret acc                              # imports/namespaces carry no name
  let withName = addPrefixes(acc, name, st)
  ret classify(withName, st, name)

fun addPrefixes(acc: Statements, name: String, st: PStmt): Statements
  ret Statements(acc.stOrdered,
                 addKeys(acc.stIndex, chain(namePrefixes(name)), st),
                 acc.stTraits, acc.stInstances, acc.stAmbient,
                 acc.stAmbientBlocked, acc.stTypesIdx, acc.stDataIdx,
                 acc.stBareTypes, acc.stBareData, acc.stMembers)

fun [tail] addKeys(d: Dict<String, List<PStmt> >, ks: Chain<String>,
                   st: PStmt): Dict<String, List<PStmt> >
  ret match(ks)
    (nil: ChainEnd) => d
    (l: ChainLink)  => addKeys(putUnder(d, l.value, st), l.next, st)

fun putUnder(d: Dict<String, List<PStmt> >, key: String,
             st: PStmt): Dict<String, List<PStmt> >
  ret match(get(d, key))
    # Declaration order within a bucket: it is the candidate order overload
    # resolution and the "Candidates:" message both see.
    (prev: List<PStmt>) => put(d, key, build<PStmt >(push<PStmt >(_pushChain<PStmt >(builder<PStmt >(), chain<PStmt>(prev)), st)))
    ()                  => put(d, key, prepend(st, List<PStmt>()))

# Enum VARIANTS are indexed too (a variant name resolves) but are not part of
# iteration; `[trait]` lets are precomputed.
fun classify(acc: Statements, st: PStmt, name: String): Statements
  ret match(st)
    (e: PsEnum) => indexVariants(acc, chain(e.eVariants))
    (l: PsLet)  => hasAttr(l.lAttrs, "trait")
      ? Statements(acc.stOrdered, acc.stIndex,
                   build<PStmt >(push<PStmt >(_pushChain<PStmt >(builder<PStmt >(), chain<PStmt>(acc.stTraits)), st)),
                   acc.stInstances, acc.stAmbient, acc.stAmbientBlocked,
                   acc.stTypesIdx, acc.stDataIdx, acc.stBareTypes, acc.stBareData,
                   acc.stMembers)
      : acc
    (ti: PsTraitInstance) => Statements(acc.stOrdered, acc.stIndex,
                                        acc.stTraits,
                                        build<PStmt >(push<PStmt >(_pushChain<PStmt >(builder<PStmt >(), chain<PStmt>(acc.stInstances)), st)),
                                        acc.stAmbient, acc.stAmbientBlocked,
                                        acc.stTypesIdx, acc.stDataIdx,
                                        acc.stBareTypes, acc.stBareData,
                                        acc.stMembers)
    (o: PStmt)  => acc

fun [tail] indexVariants(acc: Statements, vs: Chain<PStmt>): Statements
  ret match(vs)
    (nil: ChainEnd) => acc
    (l: ChainLink)  => indexVariants(indexVariant(acc, l.value), l.next)

fun indexVariant(acc: Statements, v: PStmt): Statements
  ret match(v)
    (e: PsEnum) => indexVariants(addPrefixes(acc, e.eName, v), chain(e.eVariants))
    (o: PStmt)  => acc

fun hasAttr(attrs: List<PAttr>, name: String): Bool
  ret attrLoop(chain(attrs), name)

fun [tail] attrLoop(as2: Chain<PAttr>, name: String): Bool
  ret match(as2)
    (nil: ChainEnd) => false
    (l: ChainLink)  => l.value.attrName == name ? true : attrLoop(l.next, name)

fun lookup(idx: Statements, query: String): List<PStmt>
  ret match(get(idx.stIndex, query))
    (found: List<PStmt>) => found
    ()                   => List<PStmt>()

# ── the resolver chain ──────────────────────────────────────────────────────
# Each layer answers what it knows and delegates outward. The root holds the
# statement index; scopes stack over it.

enum Resolver
  # rrSuggest: {function unique-name → suggested param TupleSpec}, computed
  # once per compile pass from the previous pass's call sites (path 3).
  # rrDiscriminators / rrOptLevel: GENERATE-only config (ResolverDiscriminators
  # in Python), read by union_repr/generate through getDiscriminators/getOptLevel
  # in generate_expr.yafl. Carried on the root (rather than as a wrapping layer,
  # as Python does) because generate always starts from a fresh root built for
  # that one codegen run — there is no nested rebinding to support.
  # rrEnumFields: the per-pass derived-enum-fields table (Python
  # ResolverRoot.get_enum_fields' memo, precomputed eagerly here like
  # stAmbient). None on direct RRoot builders, whose readers derive per
  # query exactly as before.
  # rrBoxedLeaves: the per-leaf value-struct-threshold analysis (Python
  # ResolverRoot.is_boxed_leaf's lazy set), keyed boxedLeafKey(root, leaf).
  # GENERATE-only, like rrDiscriminators: only createCCode's root supplies
  # it; every other builder leaves None (nothing boxes).
  enum RRoot(rrComplex: (:String): Bool,
             rrStmts: Statements, rrSuggest: Dict<String, Spec>|None = None,
             rrDiscriminators: Dict<String, Int>|None = None, rrOptLevel: Int = 0,
             rrEnumFields: Dict<String, List<SField> >|None = None,
             rrBoxedLeaves: Dict<String, Bool>|None = None)
  enum RData(rdNames: List<Found>, rdParent: Resolver)     # locals in scope
  enum RTypes(rtNames: List<Found>, rtParent: Resolver)    # generic params
  # In-scope NAMESPACES (the imports, plus the statement's own): an unqualified
  # name is ALSO looked up under each of them, which is how `print` finds
  # `System::print@hash`. Only a name that is neither qualified nor already
  # hashed is retried this way.
  enum RScopes(rsNames: List<String>, rsParent: Resolver)
  # The `where`-supplied trait/interface operators. They JOIN the scope (only a
  # local shadows them), and — the part that matters — they report INCOMPLETE
  # while a trait param has not grounded.
  # rtEntries/rtBlocked: the DEDUPLICATED trait-search entries (where-clause
  # specs + ambient patterns), built ONCE at traitScope construction — per
  # QUERY construction paid an O(entries²) structural dedupe on every name.
  enum RTraits(rtWheres: List<Spec>, rtEntries: List<TraitEntry>,
               rtBlocked: Bool, rtrParent: Resolver)
  # A class BODY's scope (ClassStatement.__find_locals): the class's own
  # members — fields and methods, MEMBER-scoped — plus `this`, SHADOWING the
  # enclosing scope like any local layer. No trait data here: each method
  # establishes its own in its body resolver.
  enum RClassBody(rcbClass: PsClass, rcbParent: Resolver)
  # GENERATE-only: carries the innermost in-progress [tail] loop's or
  # BlockExpression's (immutable) frame — ResolverLoop/ResolverBlock in Python.
  # `rgFrame` is a GenFrame (defined in generate_expr.yafl); read via
  # getLoopFrame/getBlockFrame there, never interpreted here. One variant
  # serves both roles (mirrors DelegatingResolver's default pass-through: a
  # loop frame leaves get_block_frame to fall through to the parent, and vice
  # versa) so this file need not carry two near-identical cases.
  enum RGen(rgFrame: GenFrame, rgParent: Resolver)

fun findData(r: Resolver, query: String): Findings
  ret match(r)
    (root: RRoot) => globalFindings(root.rrStmts, query, false)
    (rg: RGen)    => findData(rg.rgParent, query)
    # Lexical SHADOWING (ResolverData): a name bound at this scope hides the
    # same name in every enclosing scope — the parent is consulted only on a
    # miss. Merging instead would poison a complete local hit with an
    # enclosing trait layer's INCOMPLETE, or read as ambiguity.
    (d: RData)    => localsFirst(matchingFound(d.rdNames, query),
                                 d.rdParent, query)
    (t2: RTypes)  => findData(t2.rtParent, query)
    (sc: RScopes) => scopedFindings(sc, query, false)
    (tr: RTraits) => addFindings(traitFindings(tr, query, tr.rtrParent),
                             findData(tr.rtrParent, query))
    (cb: RClassBody) => classBodyFindings(cb, query)

fun findType(r: Resolver, query: String): Findings
  ret match(r)
    (root: RRoot) => globalFindings(root.rrStmts, query, true)
    (rg: RGen)    => findType(rg.rgParent, query)
    (d: RData)    => findType(d.rdParent, query)
    (t2: RTypes)  => addFindings(matchingFound(t2.rtNames, query),
                             findType(t2.rtParent, query))
    (sc: RScopes) => scopedFindings(sc, query, true)
    (tr: RTraits) => findType(tr.rtrParent, query)
    (cb: RClassBody) => findType(cb.rcbParent, query)

# ── implicit [where] specs ──────────────────────────────────────────────────
# get_implicit_where_specs: each namespace-scope layer MERGES its names on the
# way down; the root filters the `[where]` aliases to those declared in one of
# the merged namespaces and returns their CURRENT types — resolved or NOT,
# because the trait finder must SEE an unresolved one (still an SNamed) to
# register its trait set as not-yet-complete, rather than treat it as absent
# and commit a name against a search that was actually blocked.

# get_ambient_patterns: the PRECOMPUTED ambient entries (stAmbient), scope-
# filtered per query site — the walk only collects the in-scope namespaces.
# get_trait_instances: pre-lowering first-class instances (constraint
# discharge and droppability read these before lower_instances runs).
fun [tail] traitInstanceStmts(r: Resolver): List<PStmt>
  ret match(r)
    (root: RRoot)    => root.rrStmts.stInstances
    (sc: RScopes)    => traitInstanceStmts(sc.rsParent)
    (d: RData)       => traitInstanceStmts(d.rdParent)
    (t2: RTypes)     => traitInstanceStmts(t2.rtParent)
    (tr: RTraits)    => traitInstanceStmts(tr.rtrParent)
    (cb: RClassBody) => traitInstanceStmts(cb.rcbParent)
    (rg: RGen)       => traitInstanceStmts(rg.rgParent)

# DERIVED is_complex: walk to the root resolver and ask its breaker
# analysis (identity vs state — no stamps anywhere). Mirror of
# Python Resolver.is_complex_root.
fun [tail] isComplexRoot(r: Resolver, root2: String): Bool
  ret match(r)
    (root: RRoot)    => root.rrComplex(root2)
    (sc: RScopes)    => isComplexRoot(sc.rsParent, root2)
    (d: RData)    => isComplexRoot(d.rdParent, root2)
    (t2: RTypes)    => isComplexRoot(t2.rtParent, root2)
    (tr: RTraits)    => isComplexRoot(tr.rtrParent, root2)
    (cb: RClassBody)    => isComplexRoot(cb.rcbParent, root2)
    (rg: RGen)    => isComplexRoot(rg.rgParent, root2)

# The one place the (root, leaf) pair becomes a Dict key (shared by the
# analysis writer in complex_enums.yafl and the reader below).
fun boxedLeafKey(root: String, leaf: String): String
  ret root + "|" + leaf

# DERIVED per-leaf boxing decision (the enum-encoding principle): walk to
# the root resolver and ask its threshold analysis. Mirror of Python
# Resolver.is_boxed_leaf; None (non-generate roots) boxes nothing.
fun [tail] isBoxedLeaf(r: Resolver, root2: String, leaf: String): Bool
  ret match(r)
    (root: RRoot)    => match(root.rrBoxedLeaves)
      (d2: Dict<String, Bool>) => !(get(d2, boxedLeafKey(root2, leaf)) is None)
      ()                        => false
    (sc: RScopes)    => isBoxedLeaf(sc.rsParent, root2, leaf)
    (d: RData)    => isBoxedLeaf(d.rdParent, root2, leaf)
    (t2: RTypes)    => isBoxedLeaf(t2.rtParent, root2, leaf)
    (tr: RTraits)    => isBoxedLeaf(tr.rtrParent, root2, leaf)
    (cb: RClassBody)    => isBoxedLeaf(cb.rcbParent, root2, leaf)
    (rg: RGen)    => isBoxedLeaf(rg.rgParent, root2, leaf)

fun ambientEntries(r: Resolver): AmbEntries
  ret ambEntryWalk(r, List<String>())

fun [tail] ambEntryWalk(r: Resolver, scopes: List<String>): AmbEntries
  ret match(r)
    (root: RRoot) => isEmpty(scopes)
      ? AmbEntries(List<TraitEntry>(), false)
      : AmbEntries(ambFilter(chain(root.rrStmts.stAmbient), scopes,
                             builder<TraitEntry>()),
                   root.rrStmts.stAmbientBlocked)
    (sc: RScopes)    => ambEntryWalk(sc.rsParent, mergeNames(scopes, chain(sc.rsNames)))
    (d: RData)       => ambEntryWalk(d.rdParent, scopes)
    (t2: RTypes)     => ambEntryWalk(t2.rtParent, scopes)
    (tr: RTraits)    => ambEntryWalk(tr.rtrParent, scopes)
    (cb: RClassBody) => ambEntryWalk(cb.rcbParent, scopes)
    (rg: RGen)       => ambEntryWalk(rg.rgParent, scopes)

fun [tail] ambFilter(es: Chain<AmbEntry>, scopes: List<String>,
                     acc: ListBuilder<TraitEntry>): List<TraitEntry>
  ret match(es)
    (nil: ChainEnd) => build(acc)
    (l: ChainLink)  => anyInScopes(chain(l.value.amNs), scopes)
      ? ambFilter(l.next, scopes,
                  push(acc, TraitEntry(l.value.amSpec, l.value.amOwn)))
      : ambFilter(l.next, scopes, acc)

fun [tail] anyInScopes(ns: Chain<String>, scopes: List<String>): Bool
  ret match(ns)
    (nil: ChainEnd) => false
    (l: ChainLink)  => contains2(scopes, l.value)
      ? true
      : anyInScopes(l.next, scopes)

# Everything before the LAST '::' (Python name.rpartition('::')[0]).
fun namespacePart(name: String): String
  let ix = lastSep(name, 0, -1)
  ret ix < 0 ? "" : slice(name, 0, ix)

# get_param_suggestion: the call-site-implied parameter shape for `name`, or
# None when nothing was suggested. Read-only — a declared parameter type
# always overrides; this only fills holes.
fun [tail] paramSuggestion(r: Resolver, name: String): Spec|None
  ret match(r)
    (root: RRoot)    => match(root.rrSuggest)
      (d: Dict<String, Spec>) => get(d, name)
      ()                      => None
    (sc: RScopes)    => paramSuggestion(sc.rsParent, name)
    (d2: RData)      => paramSuggestion(d2.rdParent, name)
    (t2: RTypes)     => paramSuggestion(t2.rtParent, name)
    (tr: RTraits)    => paramSuggestion(tr.rtrParent, name)
    (cb: RClassBody) => paramSuggestion(cb.rcbParent, name)
    (rg: RGen)       => paramSuggestion(rg.rgParent, name)

# The per-pass derived-enum-fields table, carried on RRoot (rootResolver
# supplies it, precomputed eagerly per pass — the stAmbient pattern). A root
# built without one answers None and readers derive per query as before; a
# table MISS is a pruned root, whose fields are empty either way.
fun [tail] enumFieldsHook(r: Resolver, root: String): List<SField>|None
  ret match(r)
    (rt2: RRoot)     => match(rt2.rrEnumFields)
      (d: Dict<String, List<SField> >) => enumFieldsAt(d, root)
      ()                                => None
    (sc: RScopes)    => enumFieldsHook(sc.rsParent, root)
    (d: RData)       => enumFieldsHook(d.rdParent, root)
    (t2: RTypes)     => enumFieldsHook(t2.rtParent, root)
    (tr: RTraits)    => enumFieldsHook(tr.rtrParent, root)
    (cb: RClassBody) => enumFieldsHook(cb.rcbParent, root)
    (rg: RGen)       => enumFieldsHook(rg.rgParent, root)

fun enumFieldsAt(d: Dict<String, List<SField> >, root: String): List<SField>
  ret match(get(d, root))
    (fs: List<SField>) => fs
    ()                 => List<SField>()   # pruned root: no fields to resolve against

# get_traits: every `[trait]` let in the statement set (precomputed by the
# index) — no scope filter, exactly like Python's root.
fun [tail] traitLets(r: Resolver): List<PStmt>
  ret match(r)
    (root: RRoot)    => root.rrStmts.stTraits
    (sc: RScopes)    => traitLets(sc.rsParent)
    (d: RData)       => traitLets(d.rdParent)
    (t2: RTypes)     => traitLets(t2.rtParent)
    (tr: RTraits)    => traitLets(tr.rtrParent)
    (cb: RClassBody) => traitLets(cb.rcbParent)
    (rg: RGen)       => traitLets(rg.rgParent)

# Dedupe preserving FIRST-SEEN order: a Set answers "have I seen this" in
# O(log n) where scanning the accumulator was O(n) per element, and a builder
# keeps the order the Set cannot. Reading a half-built list was the only
# reason this loop could not simply push.
fun mergeNames(acc: List<String>, ns: Chain<String>): List<String>
  ret build<String >(mergeNamesB(_pushChain<String >(builder<String >(),
                                                     chain<String >(acc)),
                                 _chainToSet<String >(chain<String >(acc),
                                                      Set<String >()),
                                 ns))

fun [tail] mergeNamesB([terminal] out: ListBuilder<String >, seen: Set<String >,
                       ns: Chain<String>): ListBuilder<String >
  ret match(ns)
    (nil: ChainEnd) => out
    (l: ChainLink)  => contains<String >(seen, l.value)
      ? mergeNamesB(out, seen, l.next)
      : mergeNamesB(push<String >(out, l.value), add<String >(seen, l.value),
                    l.next)

# The parent's answer, PLUS the answer under each in-scope namespace — but only
# for a name that is still unqualified (no `::`) and unhashed (no `@`). The
# per-namespace root round trips (one query-string build + one root query
# each) are replaced by ONE filtered bare-index lookup at the root: same
# bags, same namespace-then-declaration order (Python AddScopeResolution).
fun scopedFindings(sc: RScopes, query: String, wantType: Bool): Findings
  let direct = wantType ? findType(sc.rsParent, query)
                        : findData(sc.rsParent, query)
  ret contains(query, "::") || contains(query, "@")
    ? direct
    : joinFindings(direct,
                   bareScoped(sc.rsParent, query, wantType, sc.rsNames))

# addFindings without the allocation when either side is a complete empty —
# the overwhelmingly common shapes here.
fun joinFindings(a: Findings, b: Findings): Findings
  if isEmpty(a.bItems) && a.bComplete
    ret b
  if isEmpty(b.bItems) && b.bComplete
    ret a
  ret addFindings(a, b)

fun [tail] bareScoped(r: Resolver, bare: String, wantType: Bool,
                      namespaces: List<String>): Findings
  ret match(r)
    (root: RRoot)    => bareAtRoot(root, bare, wantType, namespaces)
    (sc: RScopes)    => bareScoped(sc.rsParent, bare, wantType, namespaces)
    (d: RData)       => bareScoped(d.rdParent, bare, wantType, namespaces)
    (t2: RTypes)     => bareScoped(t2.rtParent, bare, wantType, namespaces)
    (tr: RTraits)    => bareScoped(tr.rtrParent, bare, wantType, namespaces)
    (cb: RClassBody) => bareScoped(cb.rcbParent, bare, wantType, namespaces)
    (rg: RGen)       => bareScoped(rg.rgParent, bare, wantType, namespaces)

fun bareAtRoot(root: RRoot, bare: String, wantType: Bool,
               namespaces: List<String>): Findings
  ret match(get(wantType ? root.rrStmts.stBareTypes : root.rrStmts.stBareData,
                bare))
    (inner: Dict<String, Findings>) => underScopes(chain(namespaces), inner,
                                                   emptyFindingsGlobal)
    ()                               => emptyFindingsGlobal

# Sum the per-namespace bags in scope order; the single-hit case returns the
# shared bag (Python resolver._under).
fun [tail] underScopes(ns: Chain<String>, inner: Dict<String, Findings >,
                       acc: Findings): Findings
  ret match(ns)
    (nil: ChainEnd) => acc
    (l: ChainLink)  => underScopes(l.next, inner,
                                   underAdd(acc, get(inner, l.value)))

fun underAdd(acc: Findings, hit: Findings|None): Findings
  ret match(hit)
    (f: Findings) => joinFindings(acc, f)
    ()            => acc

# The shared miss answer (Python's module-level EMPTY): the query path must
# not allocate.
let emptyFindingsGlobal: Findings = Findings(List<Found>(), true)

# The root's answer: every indexed statement under the query, split by whether
# it declares a TYPE (class/interface/enum/typealias) or DATA (fun/let) —
# PREBUILT per key at index build (withKindIndexes), so a query is one dict
# hit returning a shared Findings.
fun globalFindings(idx: Statements, query: String, wantType: Bool): Findings
  ret match(get(wantType ? idx.stTypesIdx : idx.stDataIdx, query))
    (f: Findings) => f
    ()            => emptyFindingsGlobal

fun globalLoop(ss: Chain<PStmt>, wantType: Bool,
                      acc: List<Found>): List<Found>
  ret build<Found >(globalLoopB(ss, wantType, _pushChain<Found >(builder<Found >(), chain<Found >(acc))))

fun [tail] globalLoopB(ss: Chain<PStmt>, wantType: Bool,
                      [terminal] acc: ListBuilder<Found >): ListBuilder<Found >
  ret match(ss)
    (nil: ChainEnd) => acc
    (l: ChainLink)  => !isNeitherStmt(l.value)
                       && wantsThis(isTypeStmt(l.value), wantType)
      ? globalLoopB(l.next, wantType,
                   push<Found >(acc, Found(stmtName(l.value), l.value, ScGlobal())))
      : globalLoopB(l.next, wantType, acc)

fun wantsThis(isType: Bool, wantType: Bool): Bool
  ret isType ? wantType : !wantType

fun isTypeStmt(st: PStmt): Bool
  ret match(st)
    (c: PsClass)      => true
    (e: PsEnum)       => true
    (ta: PsTypealias) => true
    (o: PStmt)        => false

# A trait `instance` is INDEXED (so its name is reachable) but is neither a
# type nor data, so it belongs to NEITHER bag. Python's
# TraitInstanceStatement extends NamedStatement — not DataStatement, not
# TypeStatement — and `find_data`/`find_type` filter on those, so it appears
# in neither. Without this the port's "everything that isn't a type is data"
# split leaks it into findData, and a lookup of the synthesised
# `instance$<hash>` name resolves here while Python finds nothing.
fun isNeitherStmt(st: PStmt): Bool
  ret match(st)
    (ti: PsTraitInstance) => true
    (o: PStmt)            => false

fun localsFirst(own: Findings, parent: Resolver, query: String): Findings
  ret isEmpty(own.bItems) ? findData(parent, query) : own

fun classBodyFindings(cb: RClassBody, query: String): Findings
  let own = concat(classFindData(cb.rcbClass, cb.rcbParent, query),
                   thisFound(cb.rcbClass, query))
  ret isEmpty(own) ? findData(cb.rcbParent, query) : Findings(own, true)

fun matchingFound(names: List<Found>, query: String): Findings
  ret Findings(matchLoop(chain(names), query, List<Found>()), true)

fun matchLoop(fs: Chain<Found>, query: String,
                     acc: List<Found>): List<Found>
  ret build<Found >(matchLoopB(fs, query, _pushChain<Found >(builder<Found >(), chain<Found >(acc))))

fun [tail] matchLoopB(fs: Chain<Found>, query: String,
                     [terminal] acc: ListBuilder<Found >): ListBuilder<Found >
  ret match(fs)
    (nil: ChainEnd) => acc
    (l: ChainLink)  => nameMatches(l.value.fName, query)
      ? matchLoopB(l.next, query, push<Found >(acc, l.value))
      : matchLoopB(l.next, query, acc)

fun stmtName(st: PStmt): String
  ret match(st)
    (f: PsFun)        => f.fName
    (l: PsLet)        => l.lName
    (c: PsClass)      => c.cName
    (e: PsEnum)       => e.eName
    (ta: PsTypealias) => ta.taName
    (ti: PsTraitInstance) => ti.tiName
    (d: PsDestructure) => d.dName
    (o: PStmt)        => ""
