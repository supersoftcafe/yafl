# bootstrap/access.yafl — use-site resolution, ported from
# pyast/expression/access.py: overload resolution by EXPECTED SHAPE, and the
# receiver-side type-parameter substitutions. (The enum half —
# narrowedEnumField and friends — currently lives with compileDot in
# compile_expr.yafl.)
namespace Bootstrap::Resolve

import System

import Bootstrap::Ast
import Bootstrap::Codegen
import Bootstrap::Parse
import Bootstrap::Types



fun soleOf(datas: List<Found>): Found|None
  ret exactly(chain(datas), 1) ? head(datas) : None

# ── _resolve_overloads ───────────────────────────────────────────────────────
# Partition by verdict against the expected type: definite matches (True) win
# over undecided ones (None); the undecided bucket only returns when nothing
# matches definitively — specific-beats-generic dispatch (`0 == 1` picks
# BasicEquality<Int>::== over the unconstrained BasicEquality<K>::==). When
# every candidate is rejected and the expected shape is a CALL with a result,
# retry on the parameters alone: a call OWNS its result conversion, so a
# candidate returning a MEMBER of the expected union is still the winner.

fun resolveOverloads(r: Resolver, expected: Spec|None,
                     candidates: List<Found>): List<Found>
  if atMost(chain(candidates), 1)
    ret candidates
  let survivors = partitionByVerdict(candidates, expected, r)
  if !isEmpty(survivors)
    ret survivors
  ret match(expected)
    (e2: Spec) => match(e2)
      (c: SCallable) => match(c.scResult)
        (res: Spec) => partitionByVerdict(candidates,
                                          SCallable(c.scParams2, None,
                                                    c.sclLine),
                                          r)
        ()          => survivors
      (o: Spec)      => survivors
    ()         => survivors

class [final] Verdicts(pvTrue: List<Found>, pvMaybe: List<Found>)

fun partitionByVerdict(cands: List<Found>, expected: Spec|None,
                       r: Resolver): List<Found>
  let v = verdictLoop(chain(cands), expected, r, List<Found>(), List<Found>())
  ret isEmpty(v.pvTrue) ? v.pvMaybe : v.pvTrue

fun [tail] verdictLoop(cs: Chain<Found>, expected: Spec|None, r: Resolver,
                       yes: List<Found>, maybe: List<Found>): Verdicts
  ret match(cs)
    (nil: ChainEnd) => Verdicts(yes, maybe)
    (l: ChainLink)  => match(assignableEq(r, expected,
                                          candidateType(l.value, r)))
      (b: Bool) => b
        ? verdictLoop(l.next, expected, r, append(yes, l.value), maybe)
        : verdictLoop(l.next, expected, r, yes, maybe)
      ()        => verdictLoop(l.next, expected, r, yes,
                               append(maybe, l.value))

# The candidate's EFFECTIVE type: its declaration's, with a TRAIT find's
# interface instantiation substituted through (Plus<Int>.+ compares as
# (Int,Int)->Int, not (TVal,TVal)->TVal), and then the candidate's OWN generic
# params replaced by WILDCARDS — instantiating the candidate can bind them to
# whatever the argument holds, so no structural mismatch through them may
# reject it; the unresolvable wildcard name makes every comparison through
# such a slot undecided, even on the contravariant side. A placeholder the
# candidate does NOT own stays put and keeps rejecting concrete instances.
fun candidateType(x: Found, r: Resolver): Spec|None
  ret match(stmtType(x.fStmt))
    (ty: Spec) => instanceWildcarded(wildcarded(traitSubstituted(ty, x), x), x)
    ()         => None

# A GENERIC ambient instance's placeholders are equally the candidate's own:
# the instance is a family, and instantiating this member can bind them to
# whatever the use site holds.
fun instanceWildcarded(ty: Spec, x: Found): Spec
  ret match(x.fInstanceParams)
    (ns: List<String>) => isEmpty(ns)
      ? ty
      : substitute(ty, nameWildcards(chain(ns), stmtLine(x.fStmt),
                                     List<Binding>()))
    ()                 => ty

fun nameWildcards(ns: Chain<String>, lr: PLine,
                         acc: List<Binding>): List<Binding>
  ret build<Binding >(nameWildcardsB(ns, lr, _pushChain<Binding >(builder<Binding >(), chain<Binding >(acc))))

fun [tail] nameWildcardsB(ns: Chain<String>, lr: PLine,
                         [terminal] acc: ListBuilder<Binding >): ListBuilder<Binding >
  ret match(ns)
    (nil: ChainEnd) => acc
    (l: ChainLink)  => nameWildcardsB(l.next, lr,
                        push<Binding >(acc, Binding(l.value,
                                            SNamed("$overload$wildcard",
                                                   List<Spec>(), lr))))

# _solve_instance_scope: bind a generic ambient instance's own placeholders
# from the use site — the latch a generic FUNCTION candidate gets, applied to
# the instance. The SOLVED interface scope (Sized<List<T>> ⇒
# Sized<List<Int>>), or None while the use site can't bind every placeholder.
fun solveInstanceScope(f: Found, own: List<String>, expected: Spec|None,
                       r: Resolver): Spec|None
  ret match(expected)
    (exp: Spec) => match(f.fTraitScope)
      (ts: Spec) => match(stmtType(f.fStmt))
        (eff: Spec) => solveAgainst(traitSubstituted(eff, f), exp, ts, own)
        ()          => None
      ()         => None
    ()          => None

fun solveAgainst(effective: Spec, expected: Spec, ts: Spec,
                 own: List<String>): Spec|None
  ret match(unifyGeneric(effective, expected, own, List<Binding>()))
    (m: UMap)  => bindsAll(chain(own), m.uBindings)
      ? substitute(ts, m.uBindings)
      : None
    (f2: UFail) => None

fun [tail] bindsAll(ns: Chain<String>, bs: List<Binding>): Bool
  ret match(ns)
    (nil: ChainEnd) => true
    (l: ChainLink)  => hasBinding(chain(bs), l.value)
      ? bindsAll(l.next, bs)
      : false

fun [tail] hasBinding(bs: Chain<Binding>, name: String): Bool
  ret match(bs)
    (nil: ChainEnd) => false
    (l: ChainLink)  => l.value.bName == name ? true : hasBinding(l.next, name)

fun traitSubstituted(ty: Spec, x: Found): Spec
  ret match(traitMapping(x))
    (m: List<Binding>) => substitute(ty, m)
    ()                 => ty

fun traitMapping(x: Found): List<Binding>|None
  ret match(x.fTraitScope)
    (ts: Spec) => match(ts)
      (tsc: SClass) => ownerMapping(x.fOwner, tsc)
      (o: Spec)     => None
    ()         => None

fun ownerMapping(owner: PStmt|None, tsc: SClass): List<Binding>|None
  ret match(owner)
    (ow: PStmt) => match(ow)
      (cls: PsClass) => paramMapping(cls.cGens, tsc.scParams)
      (o: PStmt)     => None
    ()          => None

fun wildcarded(ty: Spec, x: Found): Spec
  let gens = stmtGens(x.fStmt)
  ret isEmpty(gens)
    ? ty
    : substitute(ty, wildcardBindings(chain(gens), stmtLine(x.fStmt),
                                      List<Binding>()))

fun wildcardBindings(gs: Chain<PGen>, lr: PLine,
                            acc: List<Binding>): List<Binding>
  ret build<Binding >(wildcardBindingsB(gs, lr, _pushChain<Binding >(builder<Binding >(), chain<Binding >(acc))))

fun [tail] wildcardBindingsB(gs: Chain<PGen>, lr: PLine,
                            [terminal] acc: ListBuilder<Binding >): ListBuilder<Binding >
  ret match(gs)
    (nil: ChainEnd) => acc
    (l: ChainLink)  => wildcardBindingsB(l.next, lr,
                         push<Binding >(acc,
                                Binding(l.value.genName,
                                        SNamed("$overload$wildcard",
                                               List<Spec>(), lr))))

fun stmtGens(st: PStmt): List<PGen>
  ret match(st)
    (f: PsFun)        => f.fGens
    (l: PsLet)        => l.lGens
    (c: PsClass)      => c.cGens
    (e: PsEnum)       => e.eGens
    (ta: PsTypealias) => ta.taGens
    (o: PStmt)        => List<PGen>()

# ── _substitute_class_type_params ────────────────────────────────────────────
# Map the class's declared placeholders to the receiver's concrete type args
# and rewrite them inside the field's declared type — `b: Box<Int>` reads
# `b.value: Int`, not the bare T.
fun substituteClassTypeParams(r: Resolver, receiver: SClass, cdecl: PsClass,
                              fieldType: Spec|None): Spec|None
  ret match(fieldType)
    (ft: Spec) => isEmpty(cdecl.cGens) || isEmpty(receiver.scParams)
      ? fieldType
      : substitute(ft, paramMapping(cdecl.cGens, receiver.scParams))
    ()         => None
