# bootstrap/inference.yafl — call-site generic-parameter inference, ported
# from pyast/inference.py.
#
# The compile-fixpoint twin of algebra.yafl: where the algebra answers
# questions about types, this answers ONE question about a USE of a generic
# statement — what type arguments should it carry? — by combining the three
# sources, strongest first: the argument types, the expected result type, and
# the `where` constraints discharged against the `[trait]` instances in scope.
# Results may be PARTIAL (an unbound param keeps its own placeholder for a
# later pass) and are MONOTONE across passes (fresh bindings MEET stored ones
# — inference refines, never forgets).
namespace Bootstrap::Resolve

import System

import Bootstrap::Ast
import Bootstrap::Codegen
import Bootstrap::Parse
import Bootstrap::Types



# ── the entry point (NamedExpression.compile) ────────────────────────────────
# The type arguments a use of generic `stmt` should carry: `supplied` if it is
# COMPLETE, otherwise re-inferred from the enclosing call's expected type.
# Complete is scope-aware and structural (hasFreePlaceholders): a placeholder
# that resolves in scope is an enclosing generic's param passing through and
# LATCHES; one that does not — even buried inside a compound argument — is a
# not-yet-bound leftover, and this use refreshes once the inner hole fills.

fun useSiteTypeParams(stmt, supplied, expected: Spec|None,
                      r)
  let gens = stmtGens(stmt)
  if isEmpty(gens)
    ret supplied
  ret match(expected)
    (e2: Spec) => match(e2)
      (want: SCallable) => suppliedComplete(supplied, gens, r)
        ? supplied
        : reinferred(stmt, gens, supplied, want, r)
      (o: Spec)         => supplied
    ()         => supplied

# A binding to a NARROWED enum view (`T = Circle`, from a Circle-valued
# argument) is provisional too: the context may expect the root — a list of
# Circles flowing where List<Shape> is declared — and generic type arguments
# are invariant, so the use must widen rather than latch. The merge widens
# views, so re-inferring against the expected type widens the binding exactly
# as far as the context demands and no further.
fun suppliedComplete(supplied: List<Spec>, gens: List<PGen>,
                     r) => sameLen(chain(supplied), chain(gens)) && !anyFree(chain(supplied), r)
    && !any(supplied, (sp) => containsNarrowedView(sp))

fun [tail] anyFree(ts: Chain<Spec>, r) => match(ts)
  (nil: ChainEnd) => false
  (l: ChainLink)  => hasFreePlaceholders(l.value, r) ? true : anyFree(l.next, r)

fun reinferred(stmt, gens: List<PGen>, supplied,
               want: SCallable, r) => match(stmtType(stmt))
  (dt: Spec) => match(dt)
    (declared: SCallable) => match(inferTypeParams(stmt, gens, declared,
                                                   want, r))
      (mapping: List<Binding>) => mergedParams(gens, supplied, mapping, r)
      ()                       => supplied
    (o: Spec)             => supplied
  ()         => supplied

# MONOTONE re-inference: the stored binding RECEIVES this pass's — a merge
# that widens a provisional view — so a fresh hole never overwrites a ground
# binding; types only refine. A param never bound keeps its OWN placeholder,
# so the use stays generic until a later pass. A contradiction takes the
# fresh binding.
fun mergedParams(gens: List<PGen>, supplied: List<Spec>,
                 mapping: List<Binding>, r)
  let prior = sameLen(chain(supplied), chain(gens))
    ? priorBindings(chain(gens), chain(supplied), List())
    : List()
  ret mergeLoop(chain(gens), prior, mapping, r, List())

fun priorBindings(gs, ss,
                         acc: List<Binding>): List<Binding>
  ret build(priorBindingsB(gs, ss, builderFrom(acc)))

fun [tail] priorBindingsB(gs: Chain<PGen>, ss: Chain<Spec>,
                         [terminal] acc: ListBuilder<Binding>) => match(gs)
  (nil: ChainEnd) => acc
  (g2: ChainLink) => match(ss)
    (nil2: ChainEnd) => acc
    (s2: ChainLink)  => priorBindingsB(g2.next, s2.next,
                                      push(acc, Binding(g2.value.genName,
                                                s2.value)))

fun mergeLoop(gs, prior: List<Binding>,
                     mapping: List<Binding>, r, acc: List<Spec>)
  ret build(mergeLoopB(gs, prior, mapping, r, builderFrom(acc)))

fun [tail] mergeLoopB(gs: Chain<PGen>, prior: List<Binding>,
                     mapping: List<Binding>, r, [terminal] acc: ListBuilder<Spec>) => match(gs)
  (nil: ChainEnd) => acc
  (l: ChainLink)  => mergeLoopB(l.next, prior, mapping, r,
                               push(acc, boundParam(l.value, prior, mapping, r)))

fun boundParam(g2: PGen, prior: List<Binding>, mapping: List<Binding>, r): Spec
  let fresh = match(bindingOf(mapping, g2.genName))
    (b: Spec) => b
    ()        => ownPlaceholder(g2)
  let m = mergeSpecsWidening(bindingOf(prior, g2.genName), fresh, List(), true, r)
  ret match(m.moSpec)
    (sp: Spec) => isEmpty(m.moErrs) ? sp : fresh
    ()         => fresh

fun ownPlaceholder(g2: PGen) => SGeneric(g2.genName, isLinearGen(g2), g2.pgLine)

# ── _infer_type_params ───────────────────────────────────────────────────────
# Three sources, strongest first: argument types (declared parameter tuple vs
# the call's actual one), the expected result, and — for a param that appears
# only in a `where` clause — the trait instances in scope. The mapping may be
# PARTIAL; None means the arguments contradict the parameters.

fun inferTypeParams(stmt, gens: List<PGen>, declared: SCallable,
                    want: SCallable, r)
  let names = genNames(chain(gens), List())
  ret match(paramsMerged(declared, want, names, r))
    (m: List<Binding>) => viaWhere(stmt, gens, resultUnified(declared, want, names, r, m),
                                   r, declared.scParams2)
    ()                 => None

# The declared parameters RECEIVE the arguments: a merge, the callee's params
# its named holes. Covariant positions first — a callable parameter's own
# parameters are contravariant, so they only fill what the rest left open
# (`map(xs: List<T>, f: (:T): U)` takes T from xs). An argument's view is
# provisional, so there a binding widens across arguments (`pair(Circle(1),
# Square(2))` binds T to Shape); a callable parameter only fills it, never
# widens it (`map(circles, (v) => named(v))` keeps T = Circle though the lambda
# takes a Shape), and never binds a parameter whose argument is still unknown
# — that waits for the argument (`fold(xs, init, (a, x) => …)` takes T from
# xs, never from x, while xs is untyped). A known argument that cannot decide
# (`?>`'s `value: TIn | E` against `Int | Oops`) leaves it to the lambda's own
# `(a: Int)`, and a binding one position learns can decide another, so the
# merge repeats until nothing more is learned. A contradiction in the
# covariant positions means this candidate does not take these arguments; a
# callable parameter's type is only evidence to learn from — a lambda's is
# derived from this very binding on an earlier pass — and the checker owns its
# mismatches.
fun paramsMerged(declared: SCallable, want: SCallable, names: List<String>, r): List<Binding>|None
  let covariant = withoutCallableParams(declared.scParams2)
  let fuel = chain(prepend("", names))   # one pass per name, and one more
  let first = settledMerge(covariant, want.scParams2, map(names, (n) => MBind(n, None)), r, fuel)
  if !isEmpty(first.moErrs)
    ret None
  let waiting = unknownArgNames(covariant, want.scParams2, r)
  let open = filter(first.moBinds, (b) => isBound(b) || !contains2(waiting, b.mbName))
  let full = settledMerge(declared.scParams2, want.scParams2, open, r, fuel)
  ret learnedBindings(chain(full.moBinds), List())

fun [tail] settledMerge(declared: Spec, want: Spec, binds: List<MBind>, r, fuel: Chain<String>): MergeOut
  let m = mergeSpecsWidening(declared, want, binds, true, r)
  ret match(fuel)
    (nil: ChainEnd) => m
    (l: ChainLink)  => sameBinds(m.moBinds, binds) ? m : settledMerge(declared, want, m.moBinds, r, l.next)

fun sameBinds(a: List<MBind>, b: List<MBind>) => eqBy(a, b, (x, y) => x.mbName == y.mbName && sameOpt(x.mbSpec, y.mbSpec))

fun sameOpt(a: Spec|None, b: Spec|None) => match(a)
  (x: Spec) => match(b)
    (y: Spec) => eqSpec(x, y)
    ()        => false
  ()        => b is None

fun isBound(b: MBind) => match(b.mbSpec)
  (sp: Spec) => true
  ()         => false

# _unknown_argument_names: the placeholders of every declared parameter whose
# argument's type is not known yet (absent, unresolved, or holding a hole).
fun unknownArgNames(covariant, actual, r): List<String> => match(covariant)
  (dt: STuple) => match(actual)
    (at: STuple) => match(bindTupleEntries(dt.stEntries, map(at.stEntries, (e) => e.seName)))
      (b: List<Int>) => unknownLoop(chain(dt.stEntries), chain(b), at.stEntries, r, List<String>())
      ()             => List<String>()
    (o: Spec)    => List<String>()
  (o: Spec)    => List<String>()

fun [tail] unknownLoop(ds: Chain<SEntry>, bs: Chain<Int>, actual: List<SEntry>, r,
                       acc: List<String>): List<String> => match(ds)
  (nil: ChainEnd) => acc
  (d: ChainLink)  => match(bs)
    (nil2: ChainEnd) => acc
    (b: ChainLink)   => unknownLoop(d.next, b.next, actual, r,
                                    argKnown(b.value, actual, r) ? acc : concat(acc, entryNamesOf(d.value)))

fun argKnown(ix: Int, actual: List<SEntry>, r): Bool
  if ix < 0
    ret false
  ret match(head(drop(actual, ix)))
    (e: SEntry) => match(e.seType)
      (sp: Spec) => isConcrete(sp) && !hasFreePlaceholders(sp, r) && !hasMissingArguments(sp, r)
      ()         => false
    ()          => false

fun entryNamesOf(e: SEntry): List<String> => match(e.seType)
  (sp: Spec) => placeholderNames(sp)
  ()         => List<String>()

fun resultUnified(declared: SCallable, want: SCallable, names: List<String>,
                  r: Resolver, mapping): List<Binding> => match(declared.scResult)
  (dr: Spec) => match(want.scResult)
    (wr: Spec) => resultMerged(wr, dr, names, mapping, r)
    ()         => mapping
  ()         => mapping

# The expected result RECEIVES the callee's result: a merge, with the callee's
# params as named holes the arguments have already bound — so it fills only
# what the arguments left open (`List()` against `List<Int> | None` is
# `List<Int>`). A contradiction is the receiver's to report and never erases
# what the arguments proved. A binding to a narrowed view is provisional and
# widens to the view the receiver expects.
fun resultMerged(want, dr, names: List<String>, mapping: List<Binding>, r): List<Binding>
  let binds = map(names, (n) => MBind(n, bindingOf(mapping, n)))
  let m = mergeSpecsWidening(want, dr, binds, false, r)
  ret isEmpty(m.moErrs) ? learnedBindings(chain(m.moBinds), List()) : mapping

fun genNames(gs: Chain<PGen>, acc: List<String>) => build(genNamesB(gs, builderFrom(acc)))

fun [tail] genNamesB(gs: Chain<PGen>, [terminal] acc): ListBuilder<String> => match(gs)
  (nil: ChainEnd) => acc
  (l: ChainLink)  => genNamesB(l.next, push(acc, l.value.genName))

# ── _infer_type_params_via_where ─────────────────────────────────────────────
# Bind type params argument inference CANNOT determine — those appearing in no
# value parameter — by discharging the statement's `where` constraints against
# the trait instances. A param that DOES appear in the value parameters must
# come from the arguments; binding it from an arbitrary instance would pick
# the wrong one. Additive: the mapping is untouched when nothing grounds.

fun viaWhere(stmt, gens: List<PGen>, mapping,
             r, declaredParams)
  let argInferrable = placeholderNames(declaredParams)
  let targets = whereTargets(chain(gens), mapping, argInferrable,
                             List())
  if isEmpty(targets)
    ret mapping
  ret whereLoop(chain(stmtWheres(stmt)), gens, mapping, argInferrable,
                traitInstances(r), r)

fun whereTargets(gs: Chain<PGen>, mapping: List<Binding>,
                        argInferrable: List<String>,
                        acc: List<String>)
  ret build(whereTargetsB(gs, mapping, argInferrable, builderFrom(acc)))

fun [tail] whereTargetsB(gs: Chain<PGen>, mapping: List<Binding>,
                        argInferrable: List<String>,
                        [terminal] acc): ListBuilder<String> => match(gs)
  (nil: ChainEnd) => acc
  (l: ChainLink)  => isWhereTarget(l.value.genName, mapping, argInferrable)
    ? whereTargetsB(l.next, mapping, argInferrable,
                   push(acc, l.value.genName))
    : whereTargetsB(l.next, mapping, argInferrable, acc)

fun isWhereTarget(name: String, mapping: List<Binding>,
                  argInferrable: List<String>) => match(bindingOf(mapping, name))
  (b: Spec) => false
  ()        => !contains2(argInferrable, name)

fun [tail] whereLoop(ws: Chain<Spec>, gens: List<PGen>,
                     mapping, argInferrable: List<String>,
                     instances: List<TraitInst>, r: Resolver)
  let targets = whereTargets(chain(gens), mapping, argInferrable,
                             List())
  if isEmpty(targets)
    ret mapping
  ret match(ws)
    (nil: ChainEnd) => mapping
    (l: ChainLink)  => whereLoop(l.next, gens,
                                 dischargeOne(l.value, mapping, targets,
                                              instances, r),
                                 argInferrable, instances, r)

fun dischargeOne(wc, mapping, targets: List<String>,
                 instances: List<TraitInst>, r: Resolver) => match(substitute(wc, mapping))
  (sub: SClass) => match(solveTraitConstraint(sub, targets, instances, r))
    (b: List<Binding>) => concat(mapping, b)
    ()                 => mapping
  (o: Spec)     => mapping

fun stmtWheres(stmt) => match(stmt)
  (f: PsFun)   => f.fWheres
  (l: PsLet)   => l.lWheres
  (c: PsClass) => c.cWheres
  (o: PStmt)   => List()

# ── _trait_instances ─────────────────────────────────────────────────────────
# Every `[trait]` instance in scope, CONCRETE instances first. A non-generic
# instance grounds a constraint directly; a generic provider carries its
# params, matched from the constraint's own type args. An instance whose
# witness class has not resolved its parents yet is skipped this pass.

fun traitInstances(r) => sortByParamCount(
                           tiStmtLoop(chain(traitInstanceStmts(r)),
                                      instLoop(chain(traitLets(r)), r, List())))

# PRE-LOWERING first-class instances: the pattern IS the interface — no
# witness lookup, no parent substitution (_trait_instances).
fun tiStmtLoop(ts, acc: List<TraitInst>): List<TraitInst>
  ret build(tiStmtLoopB(ts, builderFrom(acc)))

fun [tail] tiStmtLoopB(ts: Chain<PStmt>, [terminal] acc: ListBuilder<TraitInst>) => match(ts)
  (nil: ChainEnd) => acc
  (l: ChainLink)  => match(l.value)
    (ti: PsTraitInstance) => match(ti.tiPattern)
      (c: SClass) => tiStmtLoopB(l.next,
                                push(acc, TraitInst(genNames(chain(ti.tiGens),
                                                   builder()),
                                          c)))
      (o: Spec)   => tiStmtLoopB(l.next, acc)
    (o2: PStmt)           => tiStmtLoopB(l.next, acc)

fun [tail] instLoop(ts: Chain<PStmt>, r,
                    acc) => match(ts)
  (nil: ChainEnd) => acc
  (l: ChainLink)  => match(l.value)
    (let2: PsLet) => instLoop(l.next, r, instancesOf(let2, r, acc))
    (o: PStmt)    => instLoop(l.next, r, acc)

fun instancesOf(let2: PsLet, r, acc) => match(let2.lType)
  (dt: Spec) => match(dt)
    (dc: SClass) => match(soleItem(findType(r, dc.scName)))
      (f: Found) => match(f.fStmt)
        (cls: PsClass) => witnessParents(let2, dc, cls, acc)
        (o: PStmt)     => acc
      ()         => acc
    (o2: Spec)   => acc
  ()         => acc

fun witnessParents(let2: PsLet, dc: SClass, cls: PsClass,
                   acc) => match(cls.cAllParents)
  (parents: List<Spec>) => parentIfaces(chain(parents),
                                        witnessRemap(dc, cls),
                                        genNames(chain(let2.lGens),
                                                 List()),
                                        acc)
  ()                    => acc     # parents not resolved yet this pass

fun witnessRemap(dc: SClass, cls: PsClass) => !isEmpty(cls.cGens)
    && sameLen(chain(cls.cGens), chain(dc.scParams))
  ? paramMapping(cls.cGens, dc.scParams)
  : List()

fun [tail] parentIfaces(ps: Chain<Spec>, remap: List<Binding>,
                        paramNames,
                        acc) => match(ps)
  (nil: ChainEnd) => acc
  (l: ChainLink)  => match(l.value)
    (pc: SClass) => parentIfaces(l.next, remap, paramNames,
                                 addIface(substitute(l.value, remap),
                                          paramNames, acc))
    (o: Spec)    => parentIfaces(l.next, remap, paramNames, acc)

fun addIface(iface, paramNames,
             acc) => match(iface)
  # Declaration order is kept: the sort is STABLE, so this order decides
  # ties between instances of equal param count.
  (ic: SClass) => build(push(builderFrom(acc), TraitInst(paramNames, ic)))
  (o: Spec)    => acc

# Sorted by param count, STABLY — concrete (zero-param) instances win ties in
# declaration order, exactly like Python's stable sort. This was a hand-written
# insertion sort: every instance walked the sorted prefix, rebuilding it as it
# went. The stdlib sort is a stable mergesort and takes the same comparator.
fun sortByParamCount(is2: List<TraitInst>) => sortBy(is2,
                                                  (a, b) => shorterThan(chain(a.tiParams),
                                                                        chain(b.tiParams)))
