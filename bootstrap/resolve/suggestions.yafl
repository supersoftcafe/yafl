# bootstrap/suggestions.yafl — path 3 of the inference model, ported from
# compiler.py::__collect_param_suggestions / __meet_hint and
# FunctionStatement.__with_param_suggestion.
#
# Gather, for each function, the parameter shape implied by its CALL SITES, so
# an un-annotated parameter can be typed from how the function is used. A pure
# function of the AST, recomputed once per PASS — the resolver carries it down
# read-only. Each resolved call contributes its argument tuple as a hint;
# hints from multiple sites MEET per position (a hole contributes nothing, a
# disagreement makes the position CONFLICT — sticky: once two sites disagree,
# no later agreeing site revives the suggestion).
#
# The walk mirrors search_and_replace's scope threading exactly, so an
# argument that references a local types correctly: a fun body sees its
# params (and, top-level, the trait layer); a block its lets; a lambda its
# params; a match arm its binding; a class body its members.
namespace Bootstrap::Resolve

import System

import Bootstrap::Ast
import Bootstrap::Lower::Ast
import Bootstrap::Frontend
import Bootstrap::Parse
import Bootstrap::Types



# hDetail: per function, per position, the DISTINCT type ids its call sites
# supplied (simple names) — only consumed by the untyped-parameter diagnostic
# (__collect_param_suggestion_detail); gathered by the SAME walk.
# The name list beside hSlots was exactly its keys, kept only to iterate; the
# suggestions it feeds are keyed by name, so the walk order is not observed.
class [final] Hints(hSlots: Dict<String, List<Meet> >,
                    hDetail: Dict<String, List<List<String> > >)

fun collectHints(statements: List<PStmt>): Hints
  let r = rootResolver(statements)
  ret hintStmts(chain(statements), r,
                Hints(Dict<String, List<Meet> >(),
                      Dict<String, List<List<String> > >()))

fun collectParamSuggestions(statements: List<PStmt>): Dict<String, Spec>
  ret suggestionsOf(collectHints(statements))

fun collectSuggestionDetail(statements: List<PStmt>): Dict<String, List<List<String> > >
  ret collectHints(statements).hDetail

# ── the walk ────────────────────────────────────────────────────────────────

fun [tail] hintStmts(ss: Chain<PStmt>, r: Resolver, acc: Hints): Hints
  ret match(ss)
    (nil: ChainEnd) => acc
    (l: ChainLink)  => hintStmts(l.next, r, hintStmt(l.value, r, acc))

fun hintStmt(st: PStmt, r: Resolver, acc: Hints): Hints
  ret match(st)
    (f: PsFun)         => hintFun(f, r, acc)
    (l: PsLet)         => hintExprOpt(l.lDefault, r, acc)
    (d: PsDestructure) => hintStmts(chain(d.dTargets), r,
                                    hintExprOpt(d.dDefault, r, acc))
    (c: PsClass)       => hintStmts(chain(c.cMembers),
                                    genScope(c.cGens, RClassBody(c, r)),
                                    hintStmt(c.cParams, r, acc))
    (rt: PsRet)        => hintExpr(rt.retValue, r, acc)
    (a: PsAction)      => hintExpr(a.action, r, acc)
    (i: PsIf)          => hintStmts(chain(i.ifFalse),
                                    blockScope(i.ifFalse, r),
                                    hintStmts(chain(i.ifTrue),
                                              blockScope(i.ifTrue, r),
                                              hintExpr(i.ifCond, r, acc)))
    (ei: PsElseIf)     => hintStmts(chain(ei.eiStmts),
                                    blockScope(ei.eiStmts, r),
                                    hintExpr(ei.eiCond, r, acc))
    (el: PsElse)       => hintStmts(chain(el.elStmts),
                                    blockScope(el.elStmts, r), acc)
    (o: PStmt)         => acc

# A fun's body (and only the body) sees its params as locals — and its trait
# layer when top-level, exactly as compile does; the param defaults walk under
# the plain resolver.
fun hintFun(f: PsFun, r: Resolver, acc: Hints): Hints
  let bodyR = localScope(paramLets(f.fParams),
                         f.fNested ? r : traitScope(f.fWheres, r))
  ret hintExprOpt(f.fBody, bodyR, hintStmt(f.fParams, r, acc))

fun hintExprOpt(x: PExpr|None, r: Resolver, acc: Hints): Hints
  ret match(x)
    (e2: PExpr) => hintExpr(e2, r, acc)
    ()          => acc

fun hintExpr(x: PExpr, r: Resolver, acc: Hints): Hints
  ret match(x)
    (c: PeCall)    => hintExpr(c.parameter, r,
                               hintExpr(c.function, r,
                                        recordCall(c, r, acc)))
    (d: PeDot)     => hintExpr(d.base, r, acc)
    (tp: PeTuple)  => hintEntries(chain(tp.exprs), r, acc)
    (te: PeTernary) => hintExpr(te.falseResult, r,
                                hintExpr(te.trueResult, r,
                                         hintExpr(te.condition, r, acc)))
    (lm: PeLambda) => hintExprOpt2(lm.lamBody,
                                   localScope(paramLets(lm.lamParams), r),
                                   hintStmt(lm.lamParams, r, acc))
    (bk: PeBlock)  => hintExpr(bk.blockValue, blockScope(bk.blockStmts, r),
                               hintStmts(chain(bk.blockStmts),
                                         blockScope(bk.blockStmts, r), acc))
    (mt: PeMatch)  => hintArms(chain(mt.arms), r,
                               hintExpr(mt.subject, r, acc))
    (op: PeBuiltinOp) => hintExpr(op.opParams, r, acc)
    (nw: PeNew)    => hintExpr(nw.newParam, r, acc)
    (ar: PeArrayRead) => hintExpr(ar.arrIndex, r, hintExpr(ar.arrObj, r, acc))
    (cv: PeConvert) => hintExpr(cv.convInner, r, acc)
    (qq: PeCoalesce) => hintExpr(qq.qqFallback, r, hintExpr(qq.qqSubject, r, acc))
    (wx: PeWith)   => hintExpr(wx.withRepls, r,
                               hintExpr(wx.withSubject, r, acc))
    (o: PExpr)     => acc

fun hintExprOpt2(x: PExpr, r: Resolver, acc: Hints): Hints
  ret hintExpr(x, r, acc)

fun [tail] hintEntries(es: Chain<PTupEnt>, r: Resolver, acc: Hints): Hints
  ret match(es)
    (nil: ChainEnd) => acc
    (l: ChainLink)  => hintEntries(l.next, r,
                                   hintExpr(l.value.tupValue, r, acc))

# An arm's body and guard see its binding (its OWN type_spec — exactly the
# search_and_replace threading).
fun [tail] hintArms(as2: Chain<PArm>, r: Resolver, acc: Hints): Hints
  ret match(as2)
    (nil: ChainEnd) => acc
    (l: ChainLink)  => hintArms(l.next, r, hintArm(l.value, r, acc))

fun hintArm(a: PArm, r: Resolver, acc: Hints): Hints
  let bodyR = bindingScope(a, a.armType, r)
  ret hintExprOpt(a.armGuard, bodyR, hintExpr(a.armBody, bodyR, acc))

# ── recording a call site ───────────────────────────────────────────────────
# Only a RESOLVED callee (hashed name) whose argument tuple has a type
# contributes; the hint is the tuple's per-position entry types.

fun recordCall(c: PeCall, r: Resolver, acc: Hints): Hints
  ret match(c.function)
    (nm: PeName) => contains(nm.refName, "@")
      ? recordTyped(nm.refName, exprType(c.parameter, r), acc)
      : acc
    (o: PExpr)   => acc

fun recordTyped(name: String, ptype: Spec|None, acc: Hints): Hints
  ret match(ptype)
    (pt: Spec) => match(pt)
      (tp: STuple) => addDetail(name, tp,
                                addHint(name, entryTypes(chain(tp.stEntries),
                                                         List<Meet>()),
                                        acc))
      (o: Spec)    => acc
    ()         => acc

fun entryTypes(es: Chain<SEntry>, acc: List<Meet>): List<Meet>
  ret build<Meet >(entryTypesB(es, builderFrom<Meet>(acc)))

fun [tail] entryTypesB(es: Chain<SEntry>, [terminal] acc: ListBuilder<Meet >): ListBuilder<Meet >
  ret match(es)
    (nil: ChainEnd) => acc
    (l: ChainLink)  => entryTypesB(l.next, push<Meet >(acc, optMeet(l.value.seType)))

fun addHint(name: String, args: List<Meet>, acc: Hints): Hints
  ret match(get(acc.hSlots, name))
    (existing: List<Meet>) => sameLen(chain(existing), chain(args))
      ? Hints(put(acc.hSlots, name,
                              meetSlots(chain(existing), chain(args),
                                        List<Meet>())),
              acc.hDetail)
      : acc
    ()                     => Hints(put(acc.hSlots, name, args), acc.hDetail)

# The detail sets: each position accumulates the DISTINCT simple names of the
# ground ids call sites supplied (a not-yet-ground entry contributes nothing).
fun addDetail(name: String, tp: STuple, acc: Hints): Hints
  ret match(get(acc.hDetail, name))
    (slots: List<List<String> >) => sameLen(chain(slots), chain(tp.stEntries))
      ? Hints(acc.hSlots,
              put(acc.hDetail, name,
                  mergeDetail(chain(slots), chain(tp.stEntries),
                              List<List<String> >())))
      : acc
    ()                           => Hints(acc.hSlots,
                                          put(acc.hDetail, name,
                                              mergeDetail(chain(blankDetail(chain(tp.stEntries),
                                                                           List<List<String> >())),
                                                          chain(tp.stEntries),
                                                          List<List<String> >())))

# One blank per tuple entry — sized by the walk, never by a count.
fun blankDetail(es: Chain<SEntry>, acc: List<List<String> >): List<List<String> >
  ret build<List<String> >(blankDetailB(es, _pushChain<List<String> >(builder<List<String> >(), chain<List<String> >(acc))))

fun [tail] blankDetailB(es: Chain<SEntry>, [terminal] acc: ListBuilder<List<String> >): ListBuilder<List<String> >
  ret match(es)
    (nil: ChainEnd) => acc
    (l: ChainLink)  => blankDetailB(l.next, push<List<String> >(acc, List<String>()))

fun mergeDetail(slots: Chain<List<String> >, es: Chain<SEntry>,
                       acc: List<List<String> >): List<List<String> >
  ret build<List<String> >(mergeDetailB(slots, es, _pushChain<List<String> >(builder<List<String> >(), chain<List<String> >(acc))))

fun [tail] mergeDetailB(slots: Chain<List<String> >, es: Chain<SEntry>,
                       [terminal] acc: ListBuilder<List<String> >): ListBuilder<List<String> >
  ret match(slots)
    (nil: ChainEnd) => acc
    (s2: ChainLink) => match(es)
      (nil2: ChainEnd) => acc
      (e2: ChainLink)  => mergeDetailB(s2.next, e2.next,
                                      push<List<String> >(acc, addDetailId(s2.value,
                                                              e2.value.seType)))

fun addDetailId(seen: List<String>, ty: Spec|None): List<String>
  ret match(ty)
    (t2: Spec) => uid(t2) == "" ? seen : addNameOnce(seen, simpleName(uid(t2)))
    ()         => seen

# CONFLICT is sticky: once two call sites disagree on a position, no later
# agreeing site revives the suggestion for it.
fun meetSlots(xs: Chain<Meet>, ys: Chain<Meet>,
                     acc: List<Meet>): List<Meet>
  ret build<Meet >(meetSlotsB(xs, ys, builderFrom<Meet>(acc)))

fun [tail] meetSlotsB(xs: Chain<Meet>, ys: Chain<Meet>,
                     [terminal] acc: ListBuilder<Meet >): ListBuilder<Meet >
  ret match(xs)
    (nil: ChainEnd) => acc
    (x: ChainLink)  => match(ys)
      (nil2: ChainEnd) => acc
      (y: ChainLink)   => meetSlotsB(x.next, y.next,
                                    push<Meet >(acc, meetHint(x.value, y.value)))

fun meetHint(a: Meet, b: Meet): Meet
  ret match(a)
    (ac: MConflict) => a
    (o: Meet)       => match(b)
      (bc: MConflict) => b
      (o2: Meet)      => meet(specOfMeet(a), specOfMeet(b))

fun specOfMeet(m: Meet): Spec|None
  ret match(m)
    (s2: MSpec) => s2.mSpec
    (o: Meet)   => None

# ── the result ──────────────────────────────────────────────────────────────
# {function unique-name: suggested param TupleSpec} — entries unnamed, a
# conflicted or empty position a hole.

fun suggestionsOf(acc: Hints): Dict<String, Spec>
  ret buildSuggestions(chain(sort<String>(keys<String, List<Meet> >(acc.hSlots))),
                       acc.hSlots, Dict<String, Spec>())

fun [tail] buildSuggestions(ns: Chain<String>, slots: Dict<String, List<Meet> >,
                            out: Dict<String, Spec>): Dict<String, Spec>
  ret match(ns)
    (nil: ChainEnd) => out
    (l: ChainLink)  => match(get(slots, l.value))
      (ms: List<Meet>) => buildSuggestions(l.next, slots,
                                           put(out, l.value,
                                               suggestionTuple(ms)))
      ()               => buildSuggestions(l.next, slots, out)

fun suggestionTuple(ms: List<Meet>): Spec
  ret STuple(hintEntriesOf(chain(ms), List<SEntry>()),
             PLine("suggestion", 0, 0))

fun hintEntriesOf(ms: Chain<Meet>, acc: List<SEntry>): List<SEntry>
  ret build<SEntry >(hintEntriesOfB(ms, builderFrom<SEntry>(acc)))

fun [tail] hintEntriesOfB(ms: Chain<Meet>, [terminal] acc: ListBuilder<SEntry >): ListBuilder<SEntry >
  ret match(ms)
    (nil: ChainEnd) => acc
    (l: ChainLink)  => hintEntriesOfB(l.next,
                                     push<SEntry >(acc, SEntry("", specOfMeet(l.value),
                                                        None)))

# ── __with_param_suggestion (FunctionStatement) ─────────────────────────────
# Fill any UN-annotated parameter from the call-site suggestion for this
# function. Per-parameter: a target with its own declared type always wins,
# and a suggested type is usable only if it resolves IN THIS SCOPE — an
# out-of-scope placeholder is a hole and fills nothing (its concrete sibling
# entries still do).

fun withParamSuggestion(f: PsFun, r: Resolver): PStmt
  ret match(paramSuggestion(r, f.fName))
    (sg: Spec) => match(sg)
      (tp: STuple) => fillParams(f.fParams, tp, r)
      (o: Spec)    => f.fParams
    ()         => f.fParams

fun fillParams(params: PStmt, tp: STuple, r: Resolver): PStmt
  ret match(params)
    (d: PsDestructure) => sameLen(chain(tp.stEntries), chain(d.dTargets))
      ? PsDestructure(d.dName, d.dAttrs, d.dType,
                      fillTargets(chain(d.dTargets), chain(tp.stEntries), r,
                                  List<PStmt>()),
                      d.dDefault, d.psdLine, d.dTypeInferred)
      : params
    (o: PStmt)         => params

fun fillTargets(ts: Chain<PStmt>, es: Chain<SEntry>, r: Resolver,
                       acc: List<PStmt>): List<PStmt>
  ret build<PStmt >(fillTargetsB(ts, es, r, builderFrom<PStmt>(acc)))

fun [tail] fillTargetsB(ts: Chain<PStmt>, es: Chain<SEntry>, r: Resolver,
                       [terminal] acc: ListBuilder<PStmt >): ListBuilder<PStmt >
  ret match(ts)
    (nil: ChainEnd) => acc
    (t2: ChainLink) => match(es)
      (nil2: ChainEnd) => acc
      (e2: ChainLink)  => fillTargetsB(t2.next, e2.next, r,
                                      push<PStmt >(acc, fillTarget(t2.value,
                                                             e2.value.seType,
                                                             r)))

fun fillTarget(target: PStmt, suggested: Spec|None, r: Resolver): PStmt
  ret match(target)
    (l: PsLet) => match(l.lType)
      (own: Spec) => target
      ()          => match(suggested)
        (su: Spec) => hasFreePlaceholders(su, r)
          ? target
          : PsLet(l.lName, l.lAttrs, l.lGens, su, l.lDefault, l.lArrayLen,
                  l.lWheres, l.pslLine, l.lTypeInferred, l.lImports)
        ()         => target
    (o: PStmt) => target
