# bootstrap/gettype.yafl — get_type for STATEMENTS, ported from the get_type
# methods in compiler/pyast/statement/.
#
# Nothing here caches. A statement's type is DERIVED from the statement each
# time it is asked for — that is what lets the compile fixpoint use plain
# structural equality of the AST as its termination test (see equality.yafl):
# the tree is the whole state, and every type is a function of it.
#
# The expression half (get_type over PExpr) lands with the expression pass.
#
# LAYOUT: each node kind's own get_type lives with the rest of that node in
# bootstrap/nodes/ (one file per kind, as pyast/); this file keeps the
# helpers several node kinds share.
namespace Bootstrap::Resolve

import System
import System::Containers

import Bootstrap::Ast
import Bootstrap::Codegen
import Bootstrap::Frontend
import Bootstrap::Parse
import Bootstrap::Types
import Bootstrap::StdlibCandidates
import Bootstrap::Nodes


# A let's type is simply what it declares (inference fills that in).
fun letType(l: PsLet) => l.lType

# A destructure IS a tuple type — and this is where a parameter's `= literal`
# default surfaces, into the CallableSpec that every call site sees.
fun destructureType(d: PsDestructure)
  ret STuple(targetEntries(d.dTargets,
                                 List()), d.psdLine)

fun targetEntries(ts: List<PStmt>, acc: List<SEntry>) => fold(ts, acc, addTarget)

fun addTarget(acc, st): List<SEntry> => match(st)
  (l: PsLet) => append(acc, SEntry(l.lName, l.lType, l.lDefault))
  (o: PStmt) => acc

# A function is a callable over its parameter tuple.
fun funType(f: PsFun) => SCallable(paramsTupleOf(f.fParams), f.fRet, f.psfLine)

# The parameter tuple of a fun/class param list. A class's parameters are its
# STRUCTURAL type — which is what a [final] class member of a union is
# represented as (see conversions.yafl).
fun paramsTupleOf(params): Spec => match(params)
  (d: PsDestructure) => destructureType(d)
  (o: PStmt)         => STuple(List(), stmtLine(o))

fun paramsTuple(params) => paramsTupleOf(params)

# The type a statement DECLARES, if it declares one.
fun stmtType(st) => match(st)
  (f: PsFun)         => funType(f)
  (l: PsLet)         => letType(l)
  (d: PsDestructure) => destructureType(d)
  (o: PStmt)         => None

# ── expressions ─────────────────────────────────────────────────────────────
# get_type over PExpr. Nothing is cached: a type is DERIVED from the node and
# the resolver every time it is asked for. That is what lets the fixpoint use
# structural equality of the AST as its termination test — the tree is the whole
# state (see equality.yafl).
#
# `None` means "not knowable YET", never "no type": an unresolved name, a call
# whose callee has not resolved, a lambda not yet inferred. The fixpoint asks
# again next pass.

# A literal's precision names its builtin (0 = the unbounded default).
fun intBuiltin(precision) => precision == 0 ? "bigint"
  : precision == 8 ? "int8"
  : precision == 16 ? "int16"
  : precision == 32 ? "int32"
  : "int64"

fun floatBuiltin(precision) => precision == 32 ? "float32" : "float64"

# Every arm is a branch: the same rule as a ternary.
fun typeOfMatch(mt: PeMatch, r) => branchType(map(mt.arms, (a) => armBodyType(a, r)), r)

# Each body types under its arm's OWN bindings (get_body_type): position 0's
# name, a local of the arm's type_spec, then each extra position's name at its
# declared type. An else arm binds nothing here; only compile, which knows the
# subject type, can bind it.
fun armBodyType(a: PArm, r): Spec|None =>
  exprType(a.armBody, armBodyScope(a, r))

fun twoTypes(a: Spec|None, b: Spec|None) => append(append(List(), a), b)

# A generic callee whose result IS one of its own placeholders — bare, or a
# member of the result union (`head`'s `T|None`) — has no result type until
# its arguments are typed and bind it: reported now, that hole reaches a
# receiver's inferred type as a union member no later answer can fill. A
# placeholder INSIDE a named type (`put`'s `Dict<K,V>`) is a shape, and
# inference fills it from siblings (call.py get_type).
fun callResultType(c: PeCall, res: Spec|None, r): Spec|None => match(res)
  (sp: Spec) => hasHoleMember(sp, r) && !callArgsConcrete(c, r) ? None : sp
  ()         => None

fun hasHoleMember(sp: Spec, r): Bool => match(sp)
  (cm: SCombination) => any(reprMembers(cm), (m) => isFreeHole(m, r))
  (o: Spec)          => isFreeHole(sp, r)

fun isFreeHole(sp: Spec, r): Bool => match(sp)
  (g: SGeneric) => !resolvesInScope(g.sgName, r)
  (o: Spec)     => false

fun callArgsConcrete(c: PeCall, r): Bool => match(exprType(c.parameter, r))
  (pt: Spec) => isConcrete(pt)
  ()         => false

fun memberType(bt, name, r) => match(bt)
  (t2: STuple) => entryNamed(t2.stEntries, name)
  (c: SClass)  => classMemberType(c, name, r)
  (e: SEnum)   => enumFieldType(e, name, r)
  (o: Spec)    => None

fun entryNamed(es: List<SEntry>, name: String) => match(firstWhere(es, (e) => e.seName == name))
  (e: SEntry) => e.seType
  ()          => None

# The member's declared type comes from the class's find_data — constructor
# params AND body statements, then implemented interfaces — with the class's
# type params substituted through the receiver's instantiation.
fun classMemberType(c: SClass, name, r) => match(soleItem(findType(r, c.scName)))
  (f: Found) => match(f.fStmt)
    (cs: PsClass) => match(soleOf(Bag(classFindData(cs, r, name))))
      (m: Found) => substituteClassTypeParams(r, c, cs, stmtType(m.fStmt))
      ()         => None
    (o: PStmt)    => None
  ()         => None

# An enum value's fields are its members: declared at its level or a parent
# level, derived from the declaration (enumMembers), never a stale copy.
fun fieldNamed(fs: List<SField>, name: String) => match(firstWhere(fs, (f) => f.sfName == name))
  (f: SField) => f.sfType
  ()          => None

# The field's declared type, mapped through the receiver's type arguments
# when the enum is a concrete generic instantiation.
fun enumFieldType(e: SEnum, name: String, r)
  ret substituteEnumTypeParams(r, e, fieldNamed(enumMembers(r, e), name))

fun arrayElemOf(st: PStmt): Spec|None => match(st)
  (let2: PsLet) => match(let2.lType)
    (af: SArrayField) => af.safElem
    ()                => None
  (o: PStmt)    => None
