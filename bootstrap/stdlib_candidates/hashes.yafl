# bootstrap/hashes.yafl — MD5 and LineRef.hash6, ported from the Python
# compiler (hashlib.md5 + base64 + alphanumeric filter, first six chars).
# Every `name@hash6` unique name in the ported compiler must match the Python
# compiler byte for byte, so this is a full RFC 1321 MD5 over the
# "filename:line:col" string, then standard base64, then the filter.
#
# All 32-bit arithmetic runs in Int with an explicit `& 0xffffffff` mask
# after every add/rotate. The K and s tables are packed into constant
# strings (8 hex chars / 2 decimal digits per entry) and indexed on demand.
namespace Bootstrap::StdlibCandidates

import System

let mask32: Int = 4294967295

# ── tables ───────────────────────────────────────────────────────────────────

# K[i] = floor(abs(sin(i+1)) * 2^32), packed as 64 x 8 hex chars.
let md5K: String =
  "d76aa478e8c7b756242070dbc1bdceeef57c0faf4787c62aa8304613fd469501"
  + "698098d88b44f7afffff5bb1895cd7be6b901122fd987193a679438e49b40821"
  + "f61e2562c040b340265e5a51e9b6c7aad62f105d02441453d8a1e681e7d3fbc8"
  + "21e1cde6c33707d6f4d50d87455a14eda9e3e905fcefa3f8676f02d98d2a4c8a"
  + "fffa39428771f6816d9d6122fde5380ca4beea444bdecfa9f6bb4b60bebfbc70"
  + "289b7ec6eaa127fad4ef308504881d05d9d4d039e6db99e51fa27cf8c4ac5665"
  + "f4292244432aff97ab9423a7fc93a039655b59c38f0ccc92ffeff47d85845dd1"
  + "6fa87e4ffe2ce6e0a30143144e0811a1f7537e82bd3af2352ad7d2bbeb86d391"


# Per-round left-rotate amounts, packed as 64 x 2 decimal digits.
let md5S: String =
  "07121722071217220712172207121722"
  + "05091420050914200509142005091420"
  + "04111623041116230411162304111623"
  + "06101521061015210610152106101521"


fun kOf(i: Int): Int
  ret hex8(md5K, i * 8)

fun sOf(i: Int): Int
  ret digit(md5S, i * 2) * 10 + digit(md5S, i * 2 + 1)

fun digit(s: String, at: Int): Int
  ret Int(byteAt(s, at) - '0')

fun [tail] hex8Loop(s: String, at: Int, left: Int,
                    acc: Int): Int
  if left == 0
    ret acc
  let c = byteAt(s, at)
  let v = c <= '9' ? Int(c - '0') : Int(c - 'a') + 10
  ret hex8Loop(s, at + 1, left - 1, acc * 16 + v)

fun hex8(s: String, at: Int): Int
  ret hex8Loop(s, at, 8, 0)

# ── 32-bit helpers ───────────────────────────────────────────────────────────

fun add32(a: Int, b: Int): Int
  ret (a + b) & mask32

fun not32(a: Int): Int
  ret a ^ mask32

fun rotl32(x: Int, c: Int): Int
  ret ((x << c) | (x >> (32 - c))) & mask32

# ── message access: source bytes, 0x80, zero padding, 8-byte LE bit length ──

fun paddedLen(msgLen: Int): Int
  let rem = (msgLen + 1) % 64
  let zeros = rem <= 56 ? 56 - rem : 120 - rem
  ret msgLen + 1 + zeros + 8

# `len` is length(msg) computed ONCE per digest — length() walks UTF-8, so
# calling it per byte made padding O(n^2).
fun messageByte(msg: String, len: Int, idx: Int): Int
  if idx < len
    ret Int(byteAt(msg, idx))
  if idx == len
    ret 128
  let total = paddedLen(len)
  if idx < total - 8
    ret 0
  ret (len * 8 >> ((idx - (total - 8)) * 8)) & 255

# Little-endian 32-bit word j (0..15) of the 64-byte chunk at `base`.
fun wordOf(msg: String, len: Int, base: Int, j: Int): Int
  let at = base + j * 4
  ret messageByte(msg, len, at)
    | (messageByte(msg, len, at + 1) << 8)
    | (messageByte(msg, len, at + 2) << 16)
    | (messageByte(msg, len, at + 3) << 24)

# ── the 64-round core ────────────────────────────────────────────────────────

class [final] Md5State(sa: Int, sb: Int,
                       sc: Int, sd: Int)

fun [tail] rounds(msg: String, len: Int, base: Int, i: Int,
                  a: Int, b: Int, c: Int,
                  d: Int): Md5State
  if i == 64
    ret Md5State(a, b, c, d)
  let f0 = i < 16 ? (b & c) | (not32(b) & d)
    : i < 32 ? (d & b) | (not32(d) & c)
    : i < 48 ? b ^ c ^ d
    : c ^ (b | not32(d))
  let g = i < 16 ? i
    : i < 32 ? (5 * i + 1) % 16
    : i < 48 ? (3 * i + 5) % 16
    : (7 * i) % 16
  let f1 = add32(add32(add32(f0, a), kOf(i)), wordOf(msg, len, base, g))
  ret rounds(msg, len, base, i + 1, d, add32(b, rotl32(f1, sOf(i))), b, c)

fun [tail] chunks(msg: String, len: Int, base: Int, total: Int,
                  st: Md5State): Md5State
  if base >= total
    ret st
  let r = rounds(msg, len, base, 0, st.sa, st.sb, st.sc, st.sd)
  ret chunks(msg, len, base + 64, total,
             Md5State(add32(st.sa, r.sa), add32(st.sb, r.sb),
                      add32(st.sc, r.sc), add32(st.sd, r.sd)))

# The 16 digest bytes: a0 b0 c0 d0, each little-endian.
fun md5DigestByte(st: Md5State, i: Int): Int
  let word = i < 4 ? st.sa : i < 8 ? st.sb : i < 12 ? st.sc : st.sd
  ret (word >> ((i % 4) * 8)) & 255

fun md5(msg: String): Md5State
  let len = length(msg)
  ret chunks(msg, len, 0, paddedLen(len),
             Md5State(1732584193, 4023233417, 2562383102, 271733878))

# ── base64 of the 16-byte digest (24 chars, standard alphabet + padding) ─────

let b64Alphabet: String =
  "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/"

fun b64Char(v: Int): String
  ret slice(b64Alphabet, v, v + 1)

fun [tail] b64Groups(st: Md5State, i: Int, acc: String): String
  if i >= 16
    ret acc
  let b0 = md5DigestByte(st, i)
  let b1 = i + 1 < 16 ? md5DigestByte(st, i + 1) : 0
  let b2 = i + 2 < 16 ? md5DigestByte(st, i + 2) : 0
  let quad = b64Char(b0 >> 2)
    + b64Char(((b0 & 3) << 4) | (b1 >> 4))
    + (i + 1 < 16 ? b64Char(((b1 & 15) << 2) | (b2 >> 6)) : "=")
    + (i + 2 < 16 ? b64Char(b2 & 63) : "=")
  ret b64Groups(st, i + 3, acc + quad)

# ── hash6: base64(md5("file:line:col")), alphanumerics only, first six ──────

fun isAlnumByte(c: Int32): Bool
  ret match(c)
    ('0' .. '9' | 'a' .. 'z' | 'A' .. 'Z') => true
    ()                                   => false

fun [tail] takeAlnum(s: String, at: Int, left: Int,
                     acc: String): String
  if left == 0 || at >= length(s)
    ret acc
  let c = byteAt(s, at)
  ret isAlnumByte(c)
    ? takeAlnum(s, at + 1, left - 1, acc + slice(s, at, at + 1))
    : takeAlnum(s, at + 1, left, acc + "")

fun hash6(filename: String, line: Int, col: Int): String
  let b64 = b64Groups(md5(filename + ":" + String(line) + ":" + String(col)), 0, "")
  ret takeAlnum(b64, 0, 6, "")

# ── SHA1 (RFC 3174) — Python's lazy_thunks._ir_mangle hashes struct field
# signatures with hashlib.sha1(...).hexdigest()[:16]; irMangle needs the
# byte-identical digest. Same 64-byte block structure as MD5 but BIG-endian
# words, BIG-endian bit length, 5-word state and an 80-entry schedule. ────────

# Same padding layout as MD5; only the trailing 8 length bytes flip to BE.
fun sha1MessageByte(msg: String, len: Int, idx: Int): Int
  if idx < len
    ret Int(byteAt(msg, idx))
  if idx == len
    ret 128
  let total = paddedLen(len)
  if idx < total - 8
    ret 0
  ret (len * 8 >> ((total - 1 - idx) * 8)) & 255

# Big-endian 32-bit word j (0..15) of the 64-byte chunk at `base`.
fun sha1WordOf(msg: String, len: Int, base: Int, j: Int): Int
  let at = base + j * 4
  ret (sha1MessageByte(msg, len, at) << 24)
    | (sha1MessageByte(msg, len, at + 1) << 16)
    | (sha1MessageByte(msg, len, at + 2) << 8)
    | sha1MessageByte(msg, len, at + 3)

# W[0..79]: first 16 off the message, the rest rotl1 of the xor of four
# earlier entries. Every tap is within the last 16 words, so `recent` (a
# raw prepend chain, newest first) serves each in a BOUNDED <=15-step walk —
# forceNth into the growing list re-materialised the chain per read (O(n^2),
# 19% of a self-compile). The full schedule accumulates in a builder for
# the sequential rounds walk.
fun [tail] sha1Schedule(msg: String, len: Int, base: Int, t: Int,
                        recent: Chain<Int>, acc: ListBuilder<Int>): List<Int>
  if t == 80
    ret build(acc)
  let w = t < 16
    ? sha1WordOf(msg, len, base, t)
    : rotl32(tapAt(recent, 2) ^ tapAt(recent, 7)
             ^ tapAt(recent, 13) ^ tapAt(recent, 15), 1)
  ret sha1Schedule(msg, len, base, t + 1, ChainLink<Int>(w, recent),
                   push(acc, w))

fun [tail] tapAt(c: Chain<Int>, k: Int): Int
  ret match(c)
    (l: ChainLink)  => k == 0 ? l.value : tapAt(l.next, k - 1)
    (nil: ChainEnd) => 0

class [final] Sha1State(h0: Int, h1: Int, h2: Int, h3: Int, h4: Int)

# The schedule walks SEQUENTIALLY — head/tail per round, never indexed.
fun [tail] sha1Rounds(ws: Chain<Int>, i: Int, a: Int, b: Int, c: Int, d: Int, e: Int): Sha1State
  if i == 80
    ret Sha1State(a, b, c, d, e)
  let wv = match(ws)
    (l: ChainLink)  => l.value
    (nil: ChainEnd) => 0
  let rest = match(ws)
    (l: ChainLink)  => l.next
    (nil: ChainEnd) => ws
  let f0 = i < 20 ? (b & c) | (not32(b) & d)
    : i < 40 ? b ^ c ^ d
    : i < 60 ? (b & c) | (b & d) | (c & d)
    : b ^ c ^ d
  let k = i < 20 ? 1518500249 : i < 40 ? 1859775393 : i < 60 ? 2400959708 : 3395469782
  let temp = add32(add32(add32(add32(rotl32(a, 5), f0), e), k), wv)
  ret sha1Rounds(rest, i + 1, temp, a, rotl32(b, 30), c, d)

fun [tail] sha1Chunks(msg: String, len: Int, base: Int, total: Int, st: Sha1State): Sha1State
  if base >= total
    ret st
  let r = sha1Rounds(chain(sha1Schedule(msg, len, base, 0, ChainEnd<Int>(),
                                        builder<Int>())),
                     0, st.h0, st.h1, st.h2, st.h3, st.h4)
  ret sha1Chunks(msg, len, base + 64, total,
                 Sha1State(add32(st.h0, r.h0), add32(st.h1, r.h1), add32(st.h2, r.h2),
                           add32(st.h3, r.h3), add32(st.h4, r.h4)))

fun sha1(msg: String): Sha1State
  let len = length(msg)
  ret sha1Chunks(msg, len, 0, paddedLen(len),
                 Sha1State(1732584193, 4023233417, 2562383102, 271733878, 3285377520))

# hexdigest: 5 words big-endian, two lowercase hex chars per byte (40 chars).
let hexAlphabet: String = "0123456789abcdef"

fun sha1HexByte(v: Int): String
  ret slice(hexAlphabet, v >> 4, (v >> 4) + 1) + slice(hexAlphabet, v & 15, (v & 15) + 1)

fun sha1StateWord(st: Sha1State, i: Int): Int
  ret i == 0 ? st.h0 : i == 1 ? st.h1 : i == 2 ? st.h2 : i == 3 ? st.h3 : st.h4

fun [tail] sha1HexLoop(st: Sha1State, i: Int, acc: String): String
  if i == 20
    ret acc
  let w = sha1StateWord(st, i / 4)
  ret sha1HexLoop(st, i + 1, acc + sha1HexByte((w >> ((3 - i % 4) * 8)) & 255))

fun sha1Hex(msg: String): String
  ret sha1HexLoop(sha1(msg), 0, "")
