# bootstrap/lsp/workspace.yafl — the program the server analyses (#26): every
# `.yafl` under the workspace root, each named by its path relative to the
# root, exactly the units `yaflc <dir>` compiles (projectInputs). An open
# document's text replaces what is on disk.
#
# The client names files by `file://` URI; the compiler by unit name.

namespace Bootstrap::Lsp

import System
import System::Containers
import System::IO

import Bootstrap::Ast
import Bootstrap::Driver
import Bootstrap::Frontend
import Bootstrap::Types


# ── URIs ─────────────────────────────────────────────────────────────────────

# The path a `file://` URI names, its %XX escapes decoded; None for any other
# scheme.
fun uriPath(uri: String): String|None
  ret startsWith(uri, "file://")
    ? percentDecoded(slice(uri, 7, System::length(uri)), 0, "")
    : None

fun [tail] percentDecoded(s: String, i: Int, out: String): String
  if i >= System::length(s)
    ret out
  let b = System::byteAt(s, i)
  let hi = hexValue(i + 1 < System::length(s) ? System::byteAt(s, i + 1) : -1i32)
  let lo = hexValue(i + 2 < System::length(s) ? System::byteAt(s, i + 2) : -1i32)
  ret b == '%'
    ? match(hi)
        (h: System::Int32) => match(lo)
          (l: System::Int32) => percentDecoded(s, i + 3, out + asciiToString(h * 16i32 + l))
          (_: None)          => percentDecoded(s, i + 1, out + asciiToString(b))
        (_: None) => percentDecoded(s, i + 1, out + asciiToString(b))
    : percentDecoded(s, i + 1, out + asciiToString(b))

# The `file://` URI of a path, every byte but a plain one %XX-escaped.
fun pathUri(path: String): String => "file://" + percentEncoded(path, 0, "")

fun [tail] percentEncoded(s: String, i: Int, out: String): String
  if i >= System::length(s)
    ret out
  let b = System::byteAt(s, i)
  let plain = isWordByte(b) || b == '/' || b == '.' || b == '-' || b == '~'
  ret percentEncoded(s, i + 1, plain ? out + asciiToString(b) : out + "%" + hexByte(b, true))


# The unit name of the file at `path`: its path relative to `root`; None when
# it lies outside the root.
fun unitAt(root: String, path: String): String|None
  ret startsWith(path, root + "/") ? slice(path, System::length(root) + 1, System::length(path)) : None

# The unit name of the document at `uri`.
fun unitOf(root: String, uri: String): String|None => match(uriPath(uri))
  (path: String) => unitAt(root, path)
  ()             => None

# A workspace root without the trailing `/` a client may send.
fun rootOf(uri: String): String|None => match(uriPath(uri))
  (path: String) => endsWith(path, "/") && System::length(path) > 1 ? slice(path, 0, System::length(path) - 1) : path
  ()             => None


# ── the program's sources ────────────────────────────────────────────────────

# Every unit, each with the text an open document gives it or else the text
# on disk; or why the workspace cannot be listed. A file that cannot be read
# is left out.
fun programSources(root: String, open: Dict<String, String>): List<LibSource>|String => match(yaflPaths(root, List()))
  (why: String)         => why
  (paths: List<String>) => map(paths, (p) => relativeTo(root, p))
    |> (onDisk) => sort(fold(onDisk, keys(open), (acc: Set<String>, u: String) => add(acc, u)))
    |> (units) => fold(units, List<LibSource>(), (acc, u) => withSource(acc, root, u, open))

fun withSource(acc: List<LibSource>, root: String, unit: String, open: Dict<String, String>): List<LibSource>
  ret match(get(open, unit))
    (text: String) => append(acc, LibSource(unit, text))
    ()             => match(readWholeFile(root + "/" + unit))
      (t: String)  => append(acc, LibSource(unit, t))
      (e: IOError) => acc


# ── a workspace that is a library ────────────────────────────────────────────
# A folder holding a `yafl.toml` is a library, and is analysed as one (#144): in
# place of an installed library of the same name, whose sources it holds. The
# folder's units stay the program the server analyses, so it converges and is
# checked as the top layer, and the libraries beneath it are the installed ones
# without three groups: the library the folder shadows, whatever is built on
# it or on the folder (it could not be analysed beside a different copy), and
# nothing else. An unnamed library shadows nothing, as in discovery.
#
# Read when the libraries are loaded, with them: a manifest changed meanwhile
# is read the next time the editor starts the server.

# The installed libraries, beneath the folder when the folder is a library.
fun installedLibraries(root: String|None): LibResult => match(root)
  (dir: String) => match(readDirLibrary(dir))
    (own: Library) => beneath(availableLibraries(List()), own)
    (why: String)  => LibsErr(why)
    (_: None)      => availableLibraries(List())
  (_: None)     => availableLibraries(List())

# A library that does not parse is left in: the libraries' own load reports it.
fun beneath(found: LibResult, own: Library): LibResult => match(found)
  (e: LibsErr) => e
  (ok: LibsOk) => match(parseLibraries(ok.libsFound, List()))
    (pe: LoadErrors)            => ok
    (layers: List<List<PStmt>>) => zipMap(ok.libsFound, layers, (l: Library, st: List<PStmt>) => Loaded(l, st))
      |> (loaded) => partition(loaded, (x: Loaded) => isShadowedBy(own, x.ldLib))
      |> (split) => withoutBuiltOn(split.no,
                      Set(concat(own.libManifest.libNamespaces,
                                 flatMap(split.yes, (x: Loaded) => x.ldLib.libManifest.libNamespaces))))
      |> (kept) => LibsOk(map(kept, (x: Loaded) => x.ldLib))

fun isShadowedBy(own: Library, lib: Library): Bool =>
  own.libManifest.libName != UNNAMED && lib.libManifest.libName == own.libManifest.libName

# What is left once every library that references a namespace in `gone` is
# out, and with it the namespaces of each in turn.
fun withoutBuiltOn(loaded: List<Loaded>, gone: Set<String>): List<Loaded>
  let split = partition(loaded, (x: Loaded) => referencesAny(x, gone))
  ret isEmpty(split.yes)
    ? split.no
    : withoutBuiltOn(split.no, union(gone, Set(flatMap(split.yes, (x: Loaded) => x.ldLib.libManifest.libNamespaces))))

# A library that declares a namespace in `gone` is not built on it but clashes
# with it, which the program's check reports.
fun referencesAny(x: Loaded, gone: Set<String>): Bool =>
  !any(x.ldLib.libManifest.libNamespaces, (n: String) => contains(gone, n))
    && any(candidateNamespaces(declaredImports(x.ldStmts), qualifiedRefs(x.ldStmts)), (n: String) => contains(gone, n))
