# bootstrap/driver/references.yafl — every namespace-qualified name a parsed
# tree mentions.
#
# WHY THIS EXISTS: `import` is not mandatory, so a file may write `A::B::c`
# with no import at all. compiler.py's `_candidate_namespaces` therefore feeds
# the library loader BOTH halves — the declared imports and every qualified
# reference in the AST. Collecting only the imports makes
# the port load a strictly narrower set than the reference compiler, and since
# the loaded statements ARE the program, a difference there is a difference in
# the emitted C. This file is the second half.
#
# Python gets it from one `search_and_replace` over the tree, keeping names
# with `::` that sit on a NamedExpression or a NamedSpec; this is that walk.

namespace Bootstrap::Driver

import System
import System::Containers

import Bootstrap::Ast
import Bootstrap::Resolve


fun qualifiedRefs(stmts: List<PStmt>) =>
  walkStmts(stmts, emptyResolverGlobal, Set<String>(),
            Walk<Set<String>>((a, _r, x) => (s = refsExpr(x, a), r = None),
                              wkNoStmt<Set<String>>,
                              (a, _r, sp) => (s = refsSpec(sp, a), r = None))).s
  |> (refs) => sort(refs)

# A name is a candidate only when it is qualified; `prefixesOf` splits it and
# strips the `@unique` tags later.
fun noteName(name, acc): Set<String> => contains(name, "::") ? add(acc, name) : acc

fun refsExpr(x: PExpr, acc: Set<String>): Set<String> => match(x)
  (n2: PeName) => noteName(n2.refName, acc)
  (o: PExpr)   => acc

# Only SNamed carries a name here: SClass and SEnum are what compile() RESOLVES
# a SNamed into, and by then the libraries are long loaded.
fun refsSpec(sp: Spec, acc: Set<String>): Set<String> => match(sp)
  (n2: SNamed) => noteName(n2.snName, acc)
  (o: Spec)    => acc
