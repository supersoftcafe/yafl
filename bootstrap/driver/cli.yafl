# bootstrap/driver/cli.yafl — the compiler's COMMAND LINE: compiler/main.py,
# ported flag for flag.
#
#   yaflc [-h] [-O LEVEL] [-a OUTFILE] [-c OUTFILE] [-o OUTFILE] [-L DIR]
#              [--profile] [-W WARNING] [--test] [--inline-threshold OPS]
#              files [files ...]
#
# Same arguments, same errors, same exit codes, same C, same clang command. The
# port used to have no command line at all — it read a pre-assembled `#FILE#`
# stream on stdin and Python drove it, which is not a compiler. The stage modes
# the test harness diffs live behind `--stage` (main.yafl), never here.
#
# The command line is declared here and read by System::Args, whose rules and
# text are Python 3.15's argparse's: a value is the next word only when that
# word reads as an argument; `files` takes the FIRST run of arguments and any
# later one is unrecognised; long options match by unique prefix; `-Ox`,
# `-O=x`, `--lib-path=x` carry their value inline; `-hxyz` is a cluster.
#
# ONE deliberate difference: Python pipes the C to clang on stdin; the runtime's
# spawn connects a child's stdin to /dev/null, so the port writes the C to a
# file in its private temp folder and names that file instead.

namespace Bootstrap::Driver

import System
import System::Args
import System::Containers
import System::IO

import Bootstrap::Ast
import Bootstrap::Frontend
import Bootstrap::Parse
import Bootstrap::StdlibCandidates
import Bootstrap::Types


# ── entry ────────────────────────────────────────────────────────────────────

fun cliMain(argv: List<String>): Int
  let line = commandLine(progName())
  ret match(parse(line, argv, freshScan()))
    (e: ArgError) => usageError(line, e)
    (s: CliScan)  => s.csHelp
      ? exitWithOut(help(line, terminalWidth(), wantColour(false)), 0)
      : match(resolveEnabledWarnings(s.csWarns))
        (werr: WrErr) => usageError(line, Invalid(werr.wrMessage))
        (ok: WrOk)    => s.csFormat || s.csFormatCheck ? cliFormat(s) : cliCompile(s, ok.wrEnabled)

fun [impure] usageError(line: Args<CliScan>, e: ArgError): Int
  ret exitWithErr(message(line, e, terminalWidth(), wantColour(true)), 2)

fun progName() => baseName(argv0())


# ── the command line (main.py's ArgumentParser) ──────────────────────────────
# What it asked for. Repeated -O/-a/-c/-o: the last one wins; -L and -W append.

class [final] CliScan(csHelp: Bool, csOpt: Int, csAsm: String|None, csC: String|None,
                      csOut: String|None, csLibs: List<String>,
                      csProfile: Bool, csWarns: List<String>, csTest: Bool,
                      csThreshold: Int, csFiles: List<String>, csFormat: Bool, csFormatCheck: Bool)

fun freshScan() => CliScan(false, 0, None, None, None, List(), false, List(), false,
                           Bootstrap::Lower::Ir::inlCutoffComplexity(), List(), false, false)

# The arguments, in the order main.py declares them (argparse adds -h first).
# In short lists joined together, not one pipeline of appends: a pipeline this
# long costs either compiler exponentially more per stage (#119).
fun commandLine(prog: String): Args<CliScan> => Args(prog, "My compiler-like tool",
  concat(concat(concat(outputArguments(), buildArguments()), formatArguments()), inputArguments()))

fun outputArguments(): List<Arg<CliScan>> => concat(
  List<Arg<CliScan>>(
    Stop(List("-h", "--help"), "show this help message and exit",
         (s: CliScan) => with s(csHelp = true)),
    Value(List("-O"), "LEVEL", "Optimisation level", setLevel),
    Value(List("-a"), "OUTFILE", "Assembly output",
          (s: CliScan, v: String) => with s(csAsm = v))),
  List<Arg<CliScan>>(
    Value(List("-c"), "OUTFILE", "C output",
          (s: CliScan, v: String) => with s(csC = v)),
    Value(List("-o"), "OUTFILE", "Output file name",
          (s: CliScan, v: String) => with s(csOut = v))))

fun buildArguments(): List<Arg<CliScan>> => concat(
  List<Arg<CliScan>>(
    Value(List("-L", "--lib-path"), "DIR", "Additional library search path (repeatable)",
          (s: CliScan, v: String) => with s(csLibs = append(s.csLibs, v))),
    Flag(List("--profile"),
         "Instrument for profiling; the binary writes callgrind.out.<pid> at exit",
         (s: CliScan) => with s(csProfile = true)),
    Value(List("-W"), "WARNING", "Enable/disable a warning: -Wname, -Wall, -Wno-name",
          (s: CliScan, v: String) => with s(csWarns = append(s.csWarns, v)))),
  List<Arg<CliScan>>(
    Flag(List("--test"), "Build a unit-test binary from the [test] functions",
         (s: CliScan) => with s(csTest = true)),
    Value(List("--inline-threshold"), "OPS",
          "Inline functions of fewer than OPS ops at -O2 and above (default 5)",
          setThreshold)))

# The formatter (#91, driver/format.yafl): instead of compiling, put the
# files in the language's one layout, or report the ones that are not.
fun formatArguments(): List<Arg<CliScan>> => List<Arg<CliScan>>(
  Flag(List("--format"), "Rewrite the files in the language's one layout instead of compiling",
       (s: CliScan) => with s(csFormat = true)),
  Flag(List("--format-check"), "List the files not in that layout, and fail if there are any",
       (s: CliScan) => with s(csFormatCheck = true)))

fun inputArguments(): List<Arg<CliScan>> => List<Arg<CliScan>>(
  Positional("files", AtLeastOne(), "Input .yafl file(s), or a project directory",
             (s: CliScan, vs: List<String>) => with s(csFiles = vs)))

# `choices=["0", "1", "2", "3"]`
fun setLevel(s: CliScan, v: String): CliScan|String
  ret v == "0" || v == "1" || v == "2" || v == "3"
    ? with s(csOpt = parseInt(v) ?? 0)
    : "invalid choice: " + pyRepr(v) + " (choose from '0', '1', '2', '3')"

# `type=int`
fun setThreshold(s: CliScan, v: String): CliScan|String => match(pyInt(v))
  (n: Int) => with s(csThreshold = n)
  ()       => "invalid int value: " + pyRepr(v)


# ── compile (main.py's body) ─────────────────────────────────────────────────

fun cliCompile(s: CliScan, enabled: Set<String>): Int => match(gatherInputs(s.csFiles))
  (why: String)          => exitWithErr("error: " + why + "\n", 1)
  (srcs: List<LibSource>) => match(parseUnits(srcs))
    (pe: ParseErrors)    => exitWithOut(printedDiagnostics(pe.peErrs), 1)
    (user: List<PStmt>)  => cliBuild(s, enabled, user)

fun cliBuild(s: CliScan, enabled: Set<String>, parsed: List<PStmt>): Int
  let user = s.csTest ? testProgram(parsed) : parsed
  ret match(user)
    (why: String)       => exitWithOut(why, 1)
    (u: List<PStmt>)    => projectBuild(u, s.csLibs, s.csOpt, s.csProfile, enabled,
                                        Bootstrap::Lower::Ir::InlineOpts(s.csThreshold))
      |> (b) => cliEmit(s, b)

# `for w in sorted(set(warnings)): print(w, file=sys.stderr)`, then a failed
# compile exits 1 with its diagnostics on stdout, as compile_project printed them.
fun [impure] cliEmit(s: CliScan, b: ProjectBuild): Int
  printErr(b.pbWarns)
  ret b.pbCode != 0
    ? exitWithOut(join(b.pbOuts, ""), 1)
    : match(b.pbSpec)
      (spec: LinkSpec) => cliOutputs(s, b.pbOuts, spec)
      ()               => 1   # unreachable: a successful build carries its spec

# -c writes the C as emitted; -a then -o run clang over it, in main.py's order.
fun cliOutputs(s: CliScan, outs: List<String>, spec: LinkSpec): Int
  let cWritten = match(s.csC)
    (path: String) => writeParts(path, outs)
    ()             => None
  ret match(cWritten)
    (why: String) => exitWithErr("error: " + why + "\n", 1)
    ()            => cliClang(s, outs, spec)

fun cliClang(s: CliScan, outs: List<String>, spec: LinkSpec): Int
  if s.csAsm is None && s.csOut is None
    ret 0
  ret match(tempDir())
    (tmp: String) => match(writeParts(tmp + "/out.c", outs))
      (why: String) => exitWithErr("error: " + why + "\n", 1)
      ()            => cliClangRuns(s, tmp, tmp + "/out.c", spec, unitCount(outs))
    ()           => exitWithErr("error: the process temp folder cannot be created\n", 1)

fun cliClangRuns(s: CliScan, tmp: String, cFile: String, spec: LinkSpec, units: Int): Int
  let asmCode = match(s.csAsm)
    (a: String) => runClang(concat(clangCompileArgs(s, cFile, spec), prepend("-S", prepend("-o", list1(a)))))
    ()          => 0
  if asmCode != 0
    ret asmCode
  ret match(s.csOut)
    (o: String) => units == 1
      ? runClang(concat(concat(concat(clangCompileArgs(s, cFile, spec), linkInputs(spec)),
                                      releaseLink(s.csOpt)),
                               prepend("-o", list1(o))))
      : cliClangUnits(s, tmp, cFile, spec, units, o)
    ()          => 0

# The C is one text that clang also compiles as K units (codegen/gen.yafl):
# K clangs at once, then one link. A fixed rule (clang_units.py), not a probe of
# the machine: below unitBytes the shared header is not worth repeating.
fun unitBytes() => 4 * 1024 * 1024
fun maxUnits() => 4

fun unitCount(outs: List<String>): Int
  let bytes = fold(outs, 0, (n, p) => n + length(p))
  let k = bytes / unitBytes()
  ret k < 1 ? 1 : k > maxUnits() ? maxUnits() : k

fun unitObject(tmp: String, i: Int) => tmp + "/unit" + String(i) + ".o"

# `[*compile_args, -DYAFL_UNITS=K, -DYAFL_UNIT=i, -c, source, -o, obj]`
fun unitArgs(s: CliScan, cFile: String, spec: LinkSpec, tmp: String, units: Int, i: Int): List<String>
  ret concat(concat(commonFlags(s.csOpt), prepend("-O" + String(s.csOpt), map(spec.specIncludeDirs, (d) => "-I" + d))),
             prepend("-DYAFL_UNITS=" + String(units), prepend("-DYAFL_UNIT=" + String(i),
             prepend("-c", prepend(cFile, prepend("-o", list1(unitObject(tmp, i))))))))

# powerMap calls the clangs on workers of their own and joins the results in
# order, so the K compiles overlap; the first failure is reported.
fun cliClangUnits(s: CliScan, tmp: String, cFile: String, spec: LinkSpec, units: Int, o: String): Int
  let runs = powerMap(unitIndices(units, 0, List()),
                      (i) => System::IO::run("clang", unitArgs(s, cFile, spec, tmp, units, i)))
  ret match(unitFailure(runs))
    (why: String) => exitWithOut("Compilation failed:\n" + why + "\n", 1)
    ()            => runClang(concat(concat(concat(unitObjects(tmp, units, 0, List()), linkInputs(spec)),
                                            releaseLink(s.csOpt)),
                                     prepend("-o", list1(o))))

fun [tail] unitIndices(units: Int, i: Int, acc: List<Int>): List<Int>
  ret i >= units ? acc : unitIndices(units, i + 1, append(acc, i))

fun [tail] unitObjects(tmp: String, units: Int, i: Int, acc: List<String>): List<String>
  ret i >= units ? acc : unitObjects(tmp, units, i + 1, append(acc, unitObject(tmp, i)))

fun unitFailure(rs: List<ProcessResult|IOError>): String|None => match(firstWhere(rs, unitFailed))
  (e: IOError)       => "clang could not be started"
  (r: ProcessResult) => r.err
  ()                 => None

fun unitFailed(r: ProcessResult|IOError): Bool => match(r)
  (e: IOError)       => true
  (p: ProcessResult) => p.exitCode != 0

# `[*common, "-x", "c", "-", f"-O{O}", *include_args]` — `cFile` where Python
# writes `-` for stdin.
fun clangCompileArgs(s: CliScan, cFile: String, spec: LinkSpec): List<String>
  ret concat(concat(commonFlags(s.csOpt), prepend("-x", prepend("c", prepend(cFile,
         list1("-O" + String(s.csOpt)))))), map(spec.specIncludeDirs, (d) => "-I" + d))

# -O0 is a debug build: full debug info, nothing stripped. Any optimisation
# level is a release build. -O2+ drops the asserts.
fun commonFlags(o: Int): List<String>
  let base = prepend("-std=c11", prepend("-Wall", prepend("-Wextra", prepend("-Werror",
             prepend("-ffunction-sections", list1("-fdata-sections"))))))
  ret concat(concat(base, o == 0 ? list1("-g") : List()), o >= 2 ? list1("-DNDEBUG") : List())

fun releaseLink(o: Int): List<String> => o == 0 ? List()
  : prepend("-Wl,--gc-sections", list1("-Wl,-s"))

# LINKING only — never with -S, where -Werror turns every unused linker input
# into an error. The static archives go after `-x none` (so clang reads them as
# libraries, not C), then the system libraries the runtime needs.
fun linkInputs(spec: LinkSpec): List<String>
  let statics = isEmpty(spec.specStaticLibs) ? List() : prepend("-x", prepend("none", spec.specStaticLibs))
  ret concat(statics, prepend("-lpthread", prepend("-lm", list1("-ldl"))))

# `_run_clang`: on failure, "Compilation failed:" and clang's stderr, on stdout.
fun runClang(argv: List<String>): Int => match(System::IO::run("clang", argv))
  (e: IOError)        => exitWithOut("Compilation failed:\nclang could not be started\n", 1)
  (r: ProcessResult)  => r.exitCode == 0 ? 0
    : exitWithOut("Compilation failed:\n" + r.err + "\n", 1)


# ── inputs (main.py _gather_inputs) ──────────────────────────────────────────
# ONE directory argument is a project: every `.yafl` under it, recursively,
# named by its path relative to that directory. Otherwise each argument is a
# file named by its BASENAME (`unit_name(p, p.parent)`). Paths are spelled as
# pathlib spells them (pathStr), in messages and in the units' file names.

fun gatherInputs(given: List<String>): List<LibSource>|String
  let paths = map(given, (p: String) => pathStr(p))
  ret !isEmpty(paths) && !sizeAtLeast(paths, 2) && isDirectory(head(paths) ?? "")
    ? projectInputs(head(paths) ?? "")
    : fileInputs(paths, List())

fun projectInputs(root: String): List<LibSource>|String => match(yaflPaths(root, List()))
  (why: String)         => why
  (ps: List<String>)    => readSources(root, sortByUnitName(root, ps))

# The first file that cannot be read stops the walk with its message.
fun fileInputs(ps: List<String>, b: List<LibSource>): List<LibSource>|String =>
  foldWhile<String, List<LibSource>|String>(ps, b, fileInput, (acc) => acc is List<LibSource>)

fun fileInput(acc: List<LibSource>|String, p: String): List<LibSource>|String => match(acc)
  (srcs: List<LibSource>) => match(readWholeFile(p))
    (e: IOError) => p + ": cannot be read"
    (t: String)  => append(srcs, LibSource(baseName(p), t))
  (why: String)           => why

# ── output ───────────────────────────────────────────────────────────────────

# Write `text` to stdout, then finish with `code` — every exit path of the
# command line. Through the IO handle, never `print`: print is a tracing aid
# that steps outside the effect rules, not program output.
fun [impure] exitWithOut(text: String, code: Int): Int
  printOut(text)
  ret code

fun [impure] exitWithErr(text: String, code: Int): Int
  printErr(text)
  ret code

fun [impure] printOut(text: String): None => closeQuietly(writeAll(stdout(), text).io)

fun [impure] printErr(text: String): None => closeQuietly(writeAll(stderr(), text).io)

fun closeQuietly(io: IO): None => match(io.close())
  (e: IOError) => None
  ()           => None

# A failed write still owns an open file: close it, and report `why`.
fun closedWith(io: IO, why: String): String => match(io.close())
  (e: IOError) => why
  ()           => why

# The C, fragment by fragment, into `path` (created or truncated, like
# `open(path, "w")`). None on success, else why it failed.
fun writeParts(path: String, parts: List<String>): String|None => match(create(path))
  (e: IOError) => path + ": cannot be written"
  (io: IO)     => writePartsChecked(io, parts, path)

fun [tail] writePartsChecked(io: IO, ps: List<String>, path: String): String|None => match(head(ps))
  (p: String) => writeAll(io, p) |> (w) => match(w.v)
    (e2: IOError) => closedWith(w.io, path + ": cannot be written")
    (n: Int)      => writePartsChecked(w.io, dropOne(ps), path)
  ()          => match(io.close())
    (e: IOError) => path + ": cannot be written"
    ()           => None
