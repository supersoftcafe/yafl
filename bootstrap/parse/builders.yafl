# bootstrap/builders.yafl — parse-time tree transforms ported from parser.py,
# as pure functions over the mirrored nodes. The parser rework calls these
# from its build actions; each mirrors its Python original by name.
namespace Bootstrap::Parse

import System
import System::Containers

import Bootstrap::Ast
import Bootstrap::Codegen
import Bootstrap::StdlibCandidates
import Bootstrap::Types



# ── shared little constructors ──────────────────────────────────────────────

fun hashName(name, lr: PLine) => name + "@" + hash6(lr.plFile, lr.plLine, lr.plCol)

fun oneEntryTuple(x, lr) => PeTuple(prepend(madeEntry("", false, x), List()), lr)

fun twoEntryTuple(a, b, lr)
  ret PeTuple(append(append(List(), madeEntry("", false, a)), madeEntry("", false, b)), lr)

fun callNamed(name, args, lr) => PeCall(PeName(name, List(), lr), args, lr, None)

# ── __to_call_operators / __fold_binary: `a op b` → `op`(a, b), andNot fold ──
# The call is at `lr`, where the expression starts; the operator's name is at
# `opLr`, where the operator is written, so each operator of a chain is a
# use of its own.

fun foldBinary(op, opLr: PLine, lhs, rhs, lr)
  if op == "&"
    ret match(invertOperand(rhs))
      (ir: PExpr) => andNot(lhs, ir, opLr, lr)
      ()          => match(invertOperand(lhs))
        (il: PExpr) => andNot(rhs, il, opLr, lr)
        ()          => opCall(op, opLr, lhs, rhs, lr)
  ret opCall(op, opLr, lhs, rhs, lr)

fun opCall(op, opLr: PLine, lhs, rhs, lr) => PeCall(PeName("`" + op + "`", List(), opLr), twoEntryTuple(lhs, rhs, lr), lr, None)

fun andNot(a, b, opLr: PLine, lr) => opCall("&~", opLr, a, b, lr)

# A `~x` operand's inner expression, when the expression is exactly the
# complement call the unary parser built (`` `~` ``(x)).
fun invertOperand(x: PExpr) => match(x)
  (c: PeCall) => match(c.function)
    (n: PeName) => n.refName == "`~`" ? innerOfUnary(c.parameter) : None
    ()          => None
  ()          => None

fun innerOfUnary(param: PExpr) => match(param)
  (t2: PeTuple) => match(head(t2.exprs))
    (en: PTupEnt) => isEmpty(dropOne(t2.exprs)) ? en.tupValue : None
    ()            => None
  ()            => None

# ── pipelines: beta-reduction and the `_` placeholder ───────────────────────
# The parser keeps `l |> stage` as a PePipe; fixupProgram lowers it here
# (parser.py lower_pipe / __lower_pipes).

# The forms that exist only as the parser read them, lowered: every PePipe
# (lowerPipe) and PeInterp (lowerInterp), innermost first — the order the
# parser itself once lowered pipes in. A pipe inside a slot is lowered before
# the string that holds it (parser.py __lower_parse_forms).
fun lowerParseForms(ss: List<PStmt>): List<PStmt> => rwStmts(ss, rwOnExpr(lowerParseForm))

fun lowerParseForm(x: PExpr): PExpr|None => match(x)
  (pp: PePipe)   => lowerPipe(pp.pipeSubject, pp.pipeStage)
  (ip: PeInterp) => lowerInterp(ip)
  ()             => None

# ── interpolated strings (parser.py lower_interpolation) ────────────────────
# `$"a{x}b{y:s}"` lowers to `str_concat_n("a", show(x), "b", show(y, "s"))`:
# ONE exact-size join, grouped by the runtime's operand cap. `show` resolves
# where the string is written, as `"a" + show(x)` would. str_concat_n checks
# its operands are Strings (checkBuiltinOp), so a `show` answering something
# else is an error, phrased through the call's origin as the slot written.

let concatCap = 16   # str_concat_n's fixed operand arrays (yafllib/str.c)

fun lowerInterp(ip: PeInterp): PExpr
  # The operand count rides the walk that builds the operands (no-length ruling).
  let ops = fold(ip.interpParts, (xs = List<PExpr>(), n = 0),
                 (acc, part) => (xs = append(acc.xs, interpOperand(part, ip.peipLine)), n = acc.n + 1))
  ret concatOf(ops.xs, ops.n, ip.peipLine)

fun interpOperand(part: PInterpPart, lr: PLine): PExpr => match(part)
  (t2: PipText) => PeStr(t2.ipText, lr, "")
  (sl: PipSlot) => PeCall(PeName("show", List(), inventedAt(sl.ipLine)), slotArgs(sl), sl.ipLine,
                          PoInterpolation(sl.ipText))

# `show`'s arguments for a slot: its expression, and its spec when it has one.
fun slotArgs(sl: PipSlot): PExpr => match(sl.ipSpec)
  (sp: String) => twoEntryTuple(sl.ipExpr, PeStr(sp, sl.ipLine, ""), sl.ipLine)
  ()           => oneEntryTuple(sl.ipExpr, sl.ipLine)

# `n` operands joined: one of them is itself; past the runtime's cap, the
# first `cap` are joined first and that join leads the rest, until what is
# left fits one call (parser.py _concat_of).
fun [tail] concatOf(ops: List<PExpr>, n: Int, lr: PLine): PExpr
  if n > concatCap
    let parts = splitOps(ops, concatCap, List())
    ret concatOf(prepend(joinOps(parts.first, concatCap, lr), parts.rest), n - concatCap + 1, lr)
  if n == 1
    ret match(head(ops))
      (only: PExpr) => only
      ()            => PeStr("", lr, "")   # unreachable: n counts ops
  ret joinOps(ops, n, lr)

# The first `k` operands, and the rest.
fun [tail] splitOps(ops: List<PExpr>, k: Int, first: List<PExpr>): (first: List<PExpr>, rest: List<PExpr>)
  if k == 0
    ret (first = first, rest = ops)
  ret match(head(ops))
    (o: PExpr) => splitOps(dropOne(ops), k - 1, append(first, o))
    ()         => (first = first, rest = ops)

# One str_concat_n over `n` operands.
fun joinOps(ops: List<PExpr>, n: Int, lr: PLine): PExpr =>
  PeBuiltinOp(SBuiltin("str", lr), PeStr("str_concat_n", lr, ""),
              PeTuple(map(prepend(PeInt(n, 32, lr, ""), ops), (o) => madeEntry("", false, o)), lr), lr)

# `l |> stage`: a lambda stage beta-reduces to a Block binding its params
# from l; a call stage with one `_` placeholder binds l to $pipe@hash and
# substitutes; any other stage becomes stage(l).
fun lowerPipe(last, stage)
  let holes = placeholderCount(stage)
  if holes == 1
    ret pipePlaceholder(last, stage)
  ret match(stage)
    (lm: PeLambda) => pipeBeta(last, lm)
    ()             => PeCall(stage, pipeArgs(last), exprLine(stage), None)

# Whether a stage lowers to blocks that bind the piped value (a lambda, or a
# call with one `_` placeholder) rather than to a call of the stage.
fun pipeBindsSubject(stage: PExpr) => match(stage)
  (lm: PeLambda) => true
  ()             => placeholderCount(stage) == 1

# `l |> f` wraps l in a tuple UNLESS it already is one (Python __to_pipeline).
fun pipeArgs(last) => match(last)
  (t2: PeTuple) => last
  (o)           => oneEntryTuple(last, exprLine(last))

fun placeholderCount(stage: PExpr) => match(stage)
  (c: PeCall) => match(c.parameter)
    (t2: PeTuple) => countHoles(t2.exprs, 0)
    ()            => 0
  ()          => 0

fun countHoles(es: List<PTupEnt>, acc) => fold(es, acc, (n, e) => n + (isHole(e.tupValue) ? 1 : 0))

fun isHole(x: PExpr) => match(x)
  (n: PeName) => n.refName == "_"
  ()          => false

# The name of a pipeline's intermediate: `$pipe@<position hash>`, which no
# source can spell, so nothing in the piped value can resolve to it (parser.py's
# _PIPE_TEMP_PREFIX).
fun pipeTempPrefix() => "$pipe@"

fun pipePlaceholder(last, stage): PExpr
  let lr = exprLine(stage)
  let tmp = pipeTempPrefix() + hash6(lr.plFile, lr.plLine, lr.plCol)
  let filled = match(stage)
    (c: PeCall) => PeCall(c.function, fillHole(c.parameter, tmp, lr), c.pecLine, c.pecOrigin)
    (other)     => stage
  let bind = PsLet(tmp, List(), List(), None, last, "", List(), lr, inventedAt(lr))
  ret PeBlock(prepend(bind, List()), filled, "", lr)

fun fillHole(param, tmp, lr): PExpr => match(param)
  (t2: PeTuple) => PeTuple(map(t2.exprs, (en) =>
      isHole(en.tupValue)
        ? PTupEnt(en.tupName, en.tupSpread, PeName(tmp, List(), lr), en.tupLine)
        : en), t2.petLine)
  (other)       => param

# Beta-reduce `l |> (a, b) => body` — CAPTURE-AVOIDING, exactly as parser.py:
# an OUTER block binds `l` to a fresh $pipe@hash intermediate (nothing inside
# `l` can resolve to it), and an INNER block binds the lambda's parameters
# from that name — one target binds it directly, several destructure it.
fun pipeBeta(last, lm: PeLambda)
  let lr = lm.pelLine
  let tmp = pipeTempPrefix() + hash6(lr.plFile, lr.plLine, lr.plCol)
  let ref = PeName(tmp, List(), lr)
  let binder = betaBinder(lm.lamParams, ref, lr)
  let inner = PeBlock(prepend(binder, List()), lm.lamBody, "", lr)
  let outer = PsLet(tmp, List(), List(), None, last, "", List(), lr, inventedAt(lr))
  ret PeBlock(prepend(outer, List()), inner, "", lr)

fun betaBinder(params, ref, lr: PLine) => match(params)
  (d: PsDestructure) => match(head(d.dTargets))
    (only: PStmt) => isEmpty(dropOne(d.dTargets))
      ? letWithValue(only, ref)
      : destructureWithValue(d, ref)
    ()            => destructureWithValue(d, ref)
  (o: PStmt)         => o

fun letWithValue(target, value) => match(target)
  (l: PsLet) => PsLet(l.lName, l.lAttrs, l.lGens, l.lType, value, l.lArrayLen,
                      l.lWheres, l.pslLine, l.lNameAt)
  (o: PStmt) => o

# A DestructureStatement WITH a default value: the holder binds the piped
# intermediate and its targets destructure it.
fun destructureWithValue(d: PsDestructure, value)
  ret PsDestructure(d.dName, d.dAttrs, d.dType, d.dTargets, value, d.psdLine)

# ── class constructors (pyast/utils.create_constructor) ────────────────────
# Every non-interface class gets a constructor function of its own name whose
# body is a New expression over a tuple of NAMED entries — one per field.

fun classConstructorOf(st) => match(st)
  (c: PsClass) => classConstructor(c)
  (o: PStmt)   => o

fun classConstructor(c: PsClass): PStmt
  let lr = c.pscLine
  let tps = map<PGen, Spec>(c.cGens, (g2) => SGeneric(g2.genName, false, g2.pgLine))
  let clsTy = SClass(c.cName, tps, lr)
  let fields = paramsOf(c.cParams)
  let entries = map(fields, ctorEntry)
  let body = PeBlock(List(), PeNew(clsTy, PeTuple(entries, lr), lr), "", lr)
  let ctorParams = PsDestructure("_", List(), None,
                                 map(fields, ctorParam), None, lr)
  # The constructor COPIES its class's ImportGroup (create_constructor).
  ret PsFun(c.cName, List(), c.cGens, ctorParams, body, clsTy, c.cWheres,
            lr, c.cNameAt, false, false, c.cImports)

# An array field is CONSTRUCTED from an initialiser function `(:Int32): Elem`
# whose results are tabulated into the trailing storage (utils.__constructor_param).
fun ctorParam(f) => match(f)
  (l: PsLet) => match(arrayElem(l.lType))
    # The initialiser's signature: one Int32 index parameter, element result.
    (el: Spec) => PsLet(l.lName, l.lAttrs, l.lGens,
                        SCallable(STuple(prepend(SEntry("",
                                                        SBuiltin("int32", l.pslLine),
                                                        None),
                                                 List()),
                                         l.pslLine),
                                  el, l.pslLine),
                        l.lDefault, l.lArrayLen, l.lWheres, l.pslLine, l.lNameAt)

    ()        => l
  (o: PStmt) => o

fun ctorEntry(f) => match(f)
  (l: PsLet) => madeEntry(l.lName, false, PeName(l.lName, List(), l.pslLine))
  (o: PStmt) => madeEntry("", false, PeNothing(stmtLine(o)))

fun stmtLine(st) => match(st)
  (f: PsFun) => f.psfLine
  (d: PsDestructure) => d.psdLine
  (l: PsLet) => l.pslLine
  (c: PsClass) => c.pscLine
  (e: PsEnum) => e.pseLine
  (ta: PsTypealias) => ta.pstLine
  (im: PsImport) => im.psiLine
  (ns: PsNamespace) => ns.psnLine
  (r: PsRet) => r.psrLine
  (i2: PsIf) => i2.psifLine
  (ei: PsElseIf) => ei.pseiLine
  (el: PsElse) => el.pselLine
  (ac: PsAction) => ac.psaLine
  (fa: PsFieldAssign) => fa.psfaLine
  (inst: PsTraitInstance) => inst.pstiLine

# Where a declaration's NAME is written: its token, at its own length. A
# statement with no name of its own is at its line.
fun stmtNameAt(st) => match(st)
  (f: PsFun) => f.fNameAt
  (l: PsLet) => l.lNameAt
  (c: PsClass) => c.cNameAt
  (e: PsEnum) => e.eNameAt
  (ta: PsTypealias) => ta.taNameAt
  (o: PStmt) => stmtLine(o)

# ── array accessor (pyast/utils.create_array_accessor) ─────────────────────
# A class with a trailing array field gains an accessor member `field@hash6r`
# — a `(Int32): Elem` function reading the element via ArrayRead.

fun withArrayAccessor(c) => match(accessorFor(paramsOf(c.cParams)))
  (acc: PStmt) => PsClass(c.cName, c.cAttrs, c.cGens, c.cParams, c.cImplements,
                          c.cWheres,
                          append(c.cMembers, acc),
                          c.cIsInterface,
                          c.pscLine, c.cNameAt, c.cAllParents, c.cAllSlots, c.cImports)
  ()           => c

# The accessor is built INSIDE the narrowed arm — a field read through a
# PStmt-typed binder mis-generates (see the open representation bug).
# The accessor for the first array-typed field, if there is one.
fun accessorFor(ps: List<PStmt>) =>
  foldWhile<PStmt, PStmt|None>(ps, None, (found, st) => accessorOf(st), (found) => found is None)

fun accessorOf(st: PStmt): PStmt|None => match(st)
  (let2: PsLet) => match(arrayElem(let2.lType))
    (el: Spec) => arrayAccessor(bareName(let2.lName), el, let2.pslLine, let2.lNameAt)
    ()         => None
  (o: PStmt)    => None

fun arrayElem(ty: Spec|None) => match(ty)
  (t2: Spec) => arrayElemOf(t2)
  ()        => None

fun arrayElemOf(t2: Spec) => match(t2)
  (af: SArrayField) => af.safElem
  (o)                => None

# The accessor is named for the field, and is written where the field is.
fun arrayAccessor(field, elem, lr, nameAt)
  let idxName = hashName("index", lr)
  let idx = PsLet(idxName, List(), List(), SBuiltin("int32", lr),
                  None, "", List(), lr, inventedAt(lr))
  let body = PeBlock(List(),
                     PeArrayRead(PeName("this", List(), lr),
                                 PeName(idxName, List(), lr), lr), "", lr)
  ret PsFun(field + "@" + hash6(lr.plFile, lr.plLine, lr.plCol) + "r",
            List(), List(),
            PsDestructure("_", List(), None, prepend(idx, List()), None, lr),
            body, elem, List(), lr, nameAt)

fun bareName(name)
  let at = findByte(name, '@', 0)
  ret at < 0 ? name : slice(name, 0, at)

# ── enum leaf constructors (parser.py _create_enum_leaf_constructors) ───────
# Each LEAF (a variant with no variants of its own) gets a constructor named
# after the leaf, taking every field from the root down to it, returning the
# ROOT enum type, its body a NewEnum expression.

fun enumLeafConstructors(root: PsEnum, grp) => leafWalk(root, root, List(), grp, List())

fun leafWalk(root: PsEnum, node: PsEnum, inherited,
             grp, acc): List<PStmt>
  let params = concat(inherited, paramsOf(node.eParams))
  if isEmpty(node.eVariants)
    # Leaf constructors come out in variant declaration order.
    ret node.eHasParams
      ? append(acc, leafConstructor(root, node, params, grp))
      : acc
  ret variantsWalk(root, node.eVariants, params, grp, acc)

fun variantsWalk(root: PsEnum, vs: List<PStmt>, params, grp, acc: List<PStmt>) =>
  fold(vs, acc, (a, v) => leafWalkOf(root, v, params, grp, a))

fun leafWalkOf(root: PsEnum, v, params,
               grp, acc): List<PStmt> => match(v)
  (e: PsEnum) => leafWalk(root, e, params, grp, acc)
  (o: PStmt)  => acc

fun paramsOf(d) => match(d)
  (ds: PsDestructure) => ds.dTargets
  (o: PStmt)          => List()

fun leafConstructor(root: PsEnum, leaf: PsEnum, params,
                    grp): PStmt
  let lr = leaf.pseLine
  let tps = map<PGen, Spec>(root.eGens, (g2) => SGeneric(g2.genName, false, g2.pgLine))
  # A construction builds exactly one variant, so the constructor returns
  # the LEAF type (USER RULING 2026-08-24; parser.py mirror). The
  # representation is unchanged — a leaf-typed value carries the root's
  # struct — so this is a type-system fact only.
  let retTy = SNamed(leaf.eName, tps, lr)
  let body = PeBlock(List(),
                     PeNewEnum(root.eName, leaf.eName,
                               map(params, (p) =>
                                 PFieldArg(letName(p),
                                           PeName(letName(p), List(), lr))),
                               tps, lr), "", lr)
  # A leaf constructor carries the file's ImportGroup, like any top-level fun.
  ret PsFun(leaf.eName, List(), root.eGens,
            PsDestructure("_", List(), None, params, None, lr),
            body, retTy, List(), lr, leaf.eNameAt, false, false, grp)

fun letName(p) => match(p)
  (l: PsLet) => l.lName
  (o: PStmt) => "_"

# Where an expression starts, read from its shape: a call at its callee, or at
# its own position when that comes first (an operator is written between its
# operands, and `a op b` sits where it starts, a leading bracket included); a
# dot/ternary at its left/condition, a match at its subject, a pipeline where
# its lowering starts — at the piped value when the stage binds it, else at the
# stage it calls; anything else at its own position. parser.py's
# __expression_start is the same rule. (It used to be modelled on the first
# token Python's combinators keep, which is NOT the same where a bracketed
# group leads a binary expression — `(a) == b`: the combinators drop the `(`
# — so Python now uses this rule instead.)
fun startLine(x: PExpr): PLine => match(x)
  (c: PeCall)     => earlier(startLine(c.function), c.pecLine)
  (d: PeDot)      => startLine(d.base)
  (t3: PeTernary) => startLine(t3.condition)
  (pp: PePipe)    => startLine(pipeBindsSubject(pp.pipeStage) ? pp.pipeSubject : pp.pipeStage)
  # The `is`/`!is` sugar lowers to a match over the LEFT operand, so the
  # expression's parse start is the subject's start (`g2.f is None` starts
  # at `g2`, not at the match node's own line — which is the left's line,
  # a dot's MEMBER position).
  (m2: PeMatch)   => startLine(m2.subject)
  (other)         => exprLine(x)

fun earlier(a: PLine, b: PLine): PLine
  ret b.plLine < a.plLine || (b.plLine == a.plLine && b.plCol < a.plCol) ? b : a

# An entry the compiler makes up around `value`: it begins where the value
# does and marks no source text of its own (Python TupleEntryExpression.invented).
fun madeEntry(name: String, spread: Bool, value: PExpr): PTupEnt => PTupEnt(name, spread, value, inventedAt(exprLine(value)))

fun exprLine(x) => match(x)
  (i: PeInt) => i.peiLine
  (f: PeFloat) => f.pefLine
  (b: PeBool) => b.pebLine
  (s2: PeStr) => s2.pesLine
  (r: PeRegex) => r.perLine
  (n: PeName) => n.penLine
  (wx: PeWith) => wx.pewLine
  (d: PeDot) => d.pedLine
  (c: PeCall) => c.pecLine
  (tu: PeTuple) => tu.petLine
  (t3: PeTernary) => t3.pety
  (ps: PePinSet) => ps.pepsLine
  (lm: PeLambda) => lm.pelLine
  (bk: PeBlock) => bk.pebkLine
  (m: PeMatch) => m.pemLine
  (lp: PeLoop) => lp.pelpLine
  (rc: PeRecur) => rc.percLine
  (lz: PeLazy) => lz.pelzLine
  (bo: PeBuiltinOp) => bo.peboLine
  (ng: PeNothing) => ng.pengLine
  (ne: PeNewEnum) => ne.penewLine
  (nw: PeNew) => nw.penwLine
  (ar: PeArrayRead) => ar.pearLine
  (cv: PeConvert) => cv.pecvLine
  (qq: PeCoalesce) => qq.peqqLine
  (pp: PePipe) => pp.pepiLine
  (ip: PeInterp) => ip.peipLine

# ── parse() fixups: namespace qualification, import removal ─────────────────
# Mirrors parser.py parse()'s tail: imports and namespaces vanish from the
# output; each named declaration takes the current namespace as a prefix
# (enum variants included, recursively). Constructor/accessor/leaf-constructor
# synthesis is ported separately (create_constructor et al.).

fun fixupProgram(stmts: List<PStmt>)
  let groups = blockGroupsOf(stmts)
  ret match(head(groups))
    (g2: List<PStmt>) => lowerParseForms(fixupLoop(stmts, Fixup("Main::", dropOne(groups), g2, List())))
    ()                => List()   # unreachable: the default block always exists

# Block-scoped ImportGroups (USER RULING 2026-08-23; parser.py mirror): one
# group per namespace block — the block's self-import (members see their
# siblings unqualified) plus the imports written in that block, wherever
# they sit within it. Declaring a namespace earlier in the file grants NO
# access to it, and imports do not pool across blocks. Statements before
# the first namespace declaration form the default block (namespace Main,
# no self-import).
fun blockGroupsOf(ss): List<List<PStmt>> => bgLoop(ss, List(), List())

# Each namespace's import group: the imports seen since it (and its own path).
fun bgLoop(ss: List<PStmt>, cur: List<PStmt>, done: List<List<PStmt>>) =>
  fold(ss, (cur = cur, done = done), bgStep)
    |> (st) => append(st.done, st.cur)

fun bgStep(st: (cur: List<PStmt>, done: List<List<PStmt>>), s: PStmt): (cur: List<PStmt>, done: List<List<PStmt>>) => match(s)
  (im: PsImport)    => (cur = append(st.cur, s), done = st.done)
  (n2: PsNamespace) => (cur = list1(PsImport(n2.nsPath, n2.psnLine)), done = append(st.done, st.cur))
  (o: PStmt)        => st

# The walk's state: the current namespace prefix, the import groups of the
# namespaces still to come, the current one's group, and the output so far.
class [final] Fixup(fxNs: String, fxGrps: List<List<PStmt>>, fxGrp: List<PStmt>,
                    fxOut: List<PStmt>)

fun fixupLoop(ss: List<PStmt>, start: Fixup): List<PStmt> => fold(ss, start, fixupStep).fxOut

fun fixupStep(fx: Fixup, s: PStmt) => match(s)
  (im: PsImport)    => fx
  # Entering a namespace: its group is the next one.
  (n2: PsNamespace) => Fixup(n2.nsPath + "::", dropOne(fx.fxGrps),
                             head(fx.fxGrps) ?? List<PStmt>(), fx.fxOut)
  (e: PsEnum)       => with fx(fxOut = concat(append(fx.fxOut, withImports(addNamespace(e, fx.fxNs), fx.fxGrp)),
                                              enumLeafConstructors(namespacedEnum(e, fx.fxNs), fx.fxGrp)))
  (c: PsClass)      => with fx(fxOut = classWithCtor(c, fx.fxNs, fx.fxGrp, fx.fxOut))
  # A first-class TraitInstanceStatement rides the ordinary named
  # handling (namespacing, import attachment); lower_instances.yafl
  # lowers it AFTER checking.
  (other)           => with fx(fxOut = append(fx.fxOut, withImports(addNamespace(s, fx.fxNs), fx.fxGrp)))

# Attach the ImportGroup to a NAMED statement (the kinds parse() attaches to).
fun withImports(st, grp) => match(st)
  (f: PsFun)  => with f(fImports = grp)
  (l: PsLet)  => PsLet(l.lName, l.lAttrs, l.lGens, l.lType, l.lDefault,
                       l.lArrayLen, l.lWheres, l.pslLine, l.lNameAt, l.lTypeInferred,
                       grp)
  (c: PsClass) => PsClass(c.cName, c.cAttrs, c.cGens, c.cParams,
                          c.cImplements, c.cWheres, c.cMembers,
                          c.cIsInterface, c.pscLine, c.cNameAt, c.cAllParents,
                          c.cAllSlots, grp)
  (ta: PsTypealias) => PsTypealias(ta.taName, ta.taAttrs, ta.taGens,
                                   ta.taType, ta.taWheres, ta.pstLine, ta.taNameAt, grp)
  (ti: PsTraitInstance) => PsTraitInstance(ti.tiName, ti.tiAttrs,
                                           ti.tiAmbient,
                                           ti.tiGens, ti.tiPattern,
                                           ti.tiWheres, ti.tiMembers,
                                           ti.pstiLine, grp)
  (e: PsEnum) => PsEnum(e.eName, e.eAttrs, e.eGens, e.eParams, e.eVariants,
                        e.eHasParams, e.pseLine, e.eNameAt, e.eRootName, e.eSpec, grp)
  (other)     => st

# A class emits itself then its constructor (interfaces get neither).
fun classWithCtor(c, ns, grp,
                  acc: List<PStmt>)
  let named = importedClass(namespacedClass(c, ns), grp)
  ret c.cIsInterface
    ? append(acc, named)
    : withArrayAccessor(named)
      |> (full) => append(append(acc, full), classConstructorOf(full))

fun importedClass(c, grp) => match(withImports(c, grp))
  (c2: PsClass) => c2
  (other)       => c

fun namespacedClass(c, ns) => match(addNamespace(c, ns))
  (c2: PsClass) => c2
  (other)       => c

fun namespacedEnum(e, ns) => match(addNamespace(e, ns))
  (e2: PsEnum) => e2
  (other)      => e

fun addNamespace(st, ns) => match(st)
  (f: PsFun)  => PsFun(ns + f.fName, f.fAttrs, f.fGens, f.fParams, f.fBody,
                       f.fRet, f.fWheres, f.psfLine, f.fNameAt)
  (l: PsLet)  => PsLet(ns + l.lName, l.lAttrs, l.lGens, l.lType, l.lDefault,
                       l.lArrayLen, l.lWheres, l.pslLine, l.lNameAt)
  (c: PsClass) => PsClass(ns + c.cName, c.cAttrs, c.cGens, c.cParams,
                          c.cImplements, c.cWheres, c.cMembers,
                          c.cIsInterface, c.pscLine, c.cNameAt)
  (ta: PsTypealias) => PsTypealias(ns + ta.taName, ta.taAttrs, ta.taGens,
                                   ta.taType, ta.taWheres, ta.pstLine, ta.taNameAt)
  (ti: PsTraitInstance) => PsTraitInstance(ns + ti.tiName, ti.tiAttrs,
                                           ti.tiAmbient,
                                           ti.tiGens, ti.tiPattern,
                                           ti.tiWheres, ti.tiMembers,
                                           ti.pstiLine, ti.tiImports)
  (e: PsEnum) => PsEnum(ns + e.eName, e.eAttrs, e.eGens, e.eParams,
                        map(e.eVariants, (v) => addNamespace(v, ns)),
                        e.eHasParams, e.pseLine, e.eNameAt)
  (other)     => st
