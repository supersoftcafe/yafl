# bootstrap/union_repr.yafl — how a union type is represented and operated
# on, ported from compiler/pyast/union_repr.py.
#
# A "union" is either an ad-hoc SCombination (A|B|None) or a declared SEnum
# (itself a union of variants). `classify` decides ONCE which of three
# representations it uses; the returned GRepr owns every representation-
# specific operation (ctype/generate_match/box_value/widen_from/read_field/
# construct_enum_value) so callers never re-derive the decision:
#
#   GTagged      by-value {$s0.., $tag} struct. Non-collapsing SCombination
#                and flat (non-complex) SEnum.
#   GPointer     one dispatch word; None=NULL, every other member
#                dispatches by pointer tag/vtable. Collapsing SCombination.
#                WIDE (a String or function member): the value is a str_t
#                whose `head` is that word; scalars ride as spare codes.
#   GComplexEnum DataPointer + per-variant heap objects, dispatch by
#                vtable.discriminator. Complex SEnum.
#
# Drives generate_expr2.yafl's GEmit (emArm/emMultiEntryArm/emFallback/
# emGuardToFallback/bindSubject/bindFromSlots) for generate_match, exactly as
# match.py's _Emitter does.
namespace Bootstrap::Codegen

import System
import System::Containers

import Bootstrap::Ast
import Bootstrap::Frontend
import Bootstrap::Ir
import Bootstrap::Parse
import Bootstrap::Resolve
import Bootstrap::StdlibCandidates
import Bootstrap::Types



# ══════════════════════════════════════════════════════════════════════════
# SECTION 0: enum-declaration helpers (specs.py's collect_enum_leaves /
# _collect_leaf_field_sets / enum_variant_types / enum_leaf_object_name —
# none of these were ported before this task either).
# ══════════════════════════════════════════════════════════════════════════

# One field list per leaf, including fields inherited from ancestor nodes
# (a field declared on a parent enum node is inherited by every descendant
# leaf).
fun collectLeafFieldSets(st: PsEnum, inherited: List<PStmt>)
  let own = filterDeclaredFields(flattenParams(st.eParams), List())
  let combined = concat(inherited, own)
  ret isEmpty(st.eVariants)
    ? (st.eHasParams ? list1(combined) : List())
    : collectLeafFieldSetsVariants(st.eVariants, combined, List())

fun filterDeclaredFields(ps: List<PStmt>, acc: List<PStmt>) =>
  fold(ps, acc, filterDeclaredFieldsStep)

fun filterDeclaredFieldsStep(a: List<PStmt>, x: PStmt) => match(x)
  (let2: PsLet) => isSome(let2.lType)
    ? append(a, x)
    : a
  (o: PStmt) => a

fun collectLeafFieldSetsVariants(vs: List<PStmt>, combined: List<PStmt>, acc: List<List<PStmt>>) =>
  fold(vs, acc, (a, x) => collectLeafFieldSetsVariantsStep(a, x, combined))

fun collectLeafFieldSetsVariantsStep(a: List<List<PStmt>>, x: PStmt, combined: List<PStmt>) => match(x)
  (v: PsEnum) => concat(a, collectLeafFieldSets(v, combined))
  (o: PStmt) => a

# One type per leaf variant: the Struct of all fields accessible to that
# leaf — or a bare DataPointer for a BOXED leaf (the enum-encoding
# principle: a payload over the value-struct threshold is a heap object
# everywhere it appears, so it occupies one pointer slot here).
fun enumVariantTypes(st: PsEnum, r): List<CgType> => match(asEnumVariant(st.eSpec))
  (sp: SEnum) => evtLoop(sp.seAllLeaves,
                         collectLeafFieldSets(st, List()),
                         st.eName, r, List())
  ()           => map(collectLeafFieldSets(st, List()),
                      (fields) => CgStruct(letFieldsToCgFields(fields, r)))

fun evtLoop(names: List<String>, sets: List<List<PStmt>>, rootName, r, acc: List<CgType>) =>
  zipFold(names, sets, acc,
          (a, name, set) => append(a, isBoxedLeaf(r, rootName, name)
                                        ? CgDataPointer(true)
                                        : CgStruct(letFieldsToCgFields(set, r))))

fun letFieldsToCgFields(fields: List<PStmt>, r) => map(fields, (st) => letFieldToCgField(st, r))

fun letFieldToCgField(st, r) => match(st)
  (l: PsLet) => CgField(l.lName, specGenerateOpt(l.lType, r))
  (o: PStmt) => CgField("", CgVoid())   # unreachable: filterDeclaredFields only keeps PsLet

# The per-variant Object/vtable name for a complex-enum leaf: qualify with the
# root's `$generic$` suffix (already-suffixed names untouched).
fun enumLeafObjectName(rootName, leafName)
  ret (contains(leafName, "$generic$") || !contains(rootName, "$generic$"))
    ? leafName
    : leafName + "$generic$" + suffixAfter(rootName, "$generic$")

fun suffixAfter(s, sep) => join(dropOne(split(s, sep)), sep)

fun baseName(name) => match(head(split(name, "$generic$")))
  (first: String) => first
  ()               => name

# ══════════════════════════════════════════════════════════════════════════
# SECTION 1: small generic list helpers reused throughout this file.
# ══════════════════════════════════════════════════════════════════════════

# forceNth<T> (generate_expr.yafl) and fieldNameAt (generate_expr2.yafl) are
# reused as-is from those files (same one-namespace program).

fun forceFields(t) => match(cgFieldsOf(t))
  (fields: List<CgField>) => fields
  ()                       => List()   # unreachable: a TaggedRepr container is always a Struct

fun getOr0(d: Dict<String, Int>, key: String) => match(get(d, key))
  (v: Int) => v
  ()        => 0

fun globalMaxTag(r) => maxOr(values(getDiscriminators(r)), 0)

fun sliceList<T>(l: List<T>, start, len2): List<T> => take(drop(l, start), len2)

fun variantIndexOf(members: List<Spec>, u) => findIndex(members, (m) => uid(m) == u)

fun setNamedValueAt(vs: List<RpNamedValue>, name, v)
  ret map(vs, (nv) => nv.name == name ? RpNamedValue(name, v) : nv)

# ══════════════════════════════════════════════════════════════════════════
# SECTION 2: literal_eq_test / literal_range_test / literal_alternative_tests
# live in generate_expr2.yafl alongside GEmit (shared by all three match
# generators, and by MatchExpression's own primitive-subject path).
# ══════════════════════════════════════════════════════════════════════════

# ══════════════════════════════════════════════════════════════════════════
# SECTION 3: pointer-word kind (_pointer_word_kind / _classspec_is_foreign /
# _union_collapses_to_pointer / _unwrap_to_pointer_word / _variant_slots).
# ══════════════════════════════════════════════════════════════════════════

enum PtrKind
  enum PkUnit()
  enum PkInt()
  enum PkStr()
  # bool / int8..int64 / float32 / float64 -> a SPARE code in word 0 with the
  # payload in word 1 — only inside a WIDE union (unionCollapsesToPointer).
  enum PkScalar(pkScalar: String)
  # a function value -> its environment in word 0 (spare code 0 when NULL),
  # its code pointer in word 1; the union is wide and may hold no class.
  enum PkFun()
  enum PkClass(pkName: String)
  enum PkEnum(pkRoot: String)
  enum PkForeign()

fun eqPtrKind(a: PtrKind, b: PtrKind) => match(a, b)
  (x: PkUnit, y: PkUnit)       => true
  (x: PkInt, y: PkInt)         => true
  (x: PkStr, y: PkStr)         => true
  (x: PkFun, y: PkFun)         => true
  (x: PkForeign, y: PkForeign) => true
  (x: PkScalar, y: PkScalar)   => x.pkScalar == y.pkScalar
  (x: PkClass, y: PkClass)     => x.pkName == y.pkName
  (x: PkEnum, y: PkEnum)       => x.pkRoot == y.pkRoot
  ()                           => false

fun isUnitKind(k) => match(k)
  (u: PkUnit)  => true
  (o: PtrKind) => false

fun isIntKind(k) => match(k)
  (i: PkInt)   => true
  (o: PtrKind) => false

fun isStrKind(k) => match(k)
  (s2: PkStr)  => true
  (o: PtrKind) => false

fun isForeignKind(k) => match(k)
  (f: PkForeign) => true
  (o: PtrKind)   => false

fun isFunKind(k) => match(k)
  (f: PkFun)   => true
  (o: PtrKind) => false

fun isScalarKind(k) => match(k)
  (sc: PkScalar) => true
  (o: PtrKind)   => false

# A heap object in word 0: a function's environment cannot share it.
fun isObjectKind(k) => match(k)
  (c: PkClass)   => true
  (e2: PkEnum)   => true
  (f: PkForeign) => true
  (o: PtrKind)   => false

# Spare word-0 codes for scalar members of a wide union (yafl.h
# STR_SPARE_WORD): one per TYPE, the same in every union, so a value widens
# between unions unchanged. The C helper suffix names the payload's C type.
fun isScalarName(name) => name == "bool" || name == "int8" || name == "int16" || name == "int32"
  || name == "int64" || name == "float32" || name == "float64"

fun scalarCode(name) => name == "bool" ? 1 : name == "int8" ? 2 : name == "int16" ? 3
  : name == "int32" ? 4 : name == "int64" ? 5 : name == "float32" ? 6 : 7

fun scalarC(name) => name == "bool" ? "int8" : name

fun scalarCtype(name): CgType => name == "float32" ? CgFloat(32) : name == "float64" ? CgFloat(64)
  : name == "int16" ? CgInt(16) : name == "int32" ? CgInt(32) : name == "int64" ? CgInt(64)
  : CgInt(8)

fun classSpecIsForeign(c: SClass, r) => anyFoundIsForeignClass(findType(r, c.scName).bItems)

fun anyFoundIsForeignClass(fs: List<Found>) => any(fs, anyFoundIsForeignClassStep)

fun anyFoundIsForeignClassStep(x: Found) => match(x.fStmt)
  (cs: PsClass) => hasAttr(cs.cAttrs, "foreign")
  (o: PStmt) => false

fun pointerWordKind(member, r): PtrKind|None => match(specGenerate(member, r))
  (fp: CgFuncPointer) => PkFun()
  (o: CgType)         => eqCgType(o, CgStruct(List()))
    ? PkUnit()
    : pointerWordKindNonUnit(member, r)

fun pointerWordKindNonUnit(member, r) => match(member)
  (t2: STuple) => pointerWordKindTuple(t2, r)
  (b: SBuiltin) => pointerWordKindBuiltin(b)
  (c: SClass)   => classSpecIsForeign(c, r) ? PkForeign() : PkClass(c.scName)
  (e2: SEnum)   => isComplexEnum(e2, r) ? PkEnum(e2.seRoot) : None
  (o: Spec)     => None

fun pointerWordKindTuple(t2: STuple, r)
  ret exactly(t2.stEntries, 1) ? pointerWordKindTupleEntry(entryTypeAt(t2, 0), r) : None

fun pointerWordKindTupleEntry(ety: Spec|None, r) => match(ety)
  (e2: Spec) => pointerWordKind(e2, r)
  ()          => None

fun pointerWordKindBuiltin(b: SBuiltin): PtrKind|None
  ret b.sbName == "bigint" ? PkInt()
    : b.sbName == "str" ? PkStr()
    : isScalarName(b.sbName) ? PkScalar(b.sbName)
    : None

fun unionCollapsesToPointer(members: List<Spec>, r): Bool
  let kinds = map(members, (m) => pointerWordKind(m, r))
  ret any(kinds, isNoneKind) ? false : unionCollapsesToPointerOn(map(kinds, forceKindId))

fun isNoneKind(k: PtrKind|None) => match(k)
  (kk: PtrKind) => false
  ()             => true

fun forceKindId(k: PtrKind|None) => match(k)
  (kk: PtrKind) => kk
  ()             => PkUnit()   # unreachable: caller already excluded None

# A bound method's environment IS a class instance: a class member and a
# function member could not be told apart by word 0. Scalars ride in a WIDE
# union's second word, so only a union that is wide anyway (a String or
# function member) packs them; a foreign fallback cannot be told apart from
# a spare code, so it keeps the tagged struct.
fun unionCollapsesToPointerOn(ks: List<PtrKind>) => (any(ks, isFunKind) && any(ks, isObjectKind))
    || (any(ks, isScalarKind)
        && (!(any(ks, isStrKind) || any(ks, isFunKind)) || any(ks, isForeignKind)))
  ? false
  : unionCollapsesToPointerRest(ks)

fun unionCollapsesToPointerRest(ks: List<PtrKind>) => !any(ks, (k) => !isUnitKind(k))
  ? false
  : (countKind(ks, isUnitKind) > 1 || countKind(ks, isForeignKind) > 1 ? false : allDistinctKinds(filterKinds(ks)))

fun countKind(ks: List<PtrKind>, pred: (:PtrKind): Bool)
  ret fold(ks, 0, (acc, k) => pred(k) ? acc + 1 : acc)

fun filterKinds(ks: List<PtrKind>) => filter(ks, (k) => !(isUnitKind(k) || isForeignKind(k)))

fun allDistinctKinds(ks: List<PtrKind>) =>
  foldWhile(ks, (ok = true, seen = List<PtrKind>()),
            (st, k) => any(st.seen, (s2) => eqPtrKind(s2, k))
              ? (ok = false, seen = st.seen)
              : (ok = true, seen = prepend(k, st.seen)),
            (st) => st.ok).ok

# Rebuild a single-field newtype wrapper (a chain of one-field structs ending
# in a DataPointer) from a bare pointer word.
fun [tail] unwrapToPointerWord(value, ctype) => match(cgFieldsOf(ctype))
  (fields: List<CgField>) => match(soleField(fields))
    (f: CgField) => unwrapToPointerWord(RpStructField(value, f.fieldName), f.fieldType)
    ()            => value
  ()               => value

fun soleField(fields: List<CgField>) => exactly(fields, 1) ? head(fields) : None

# The ctype `unwrapToPointerWord` peels down to.
fun [tail] peeledCtype(ctype): CgType => match(cgFieldsOf(ctype))
  (fields: List<CgField>) => match(soleField(fields))
    (f: CgField) => peeledCtype(f.fieldType)
    ()            => ctype
  ()               => ctype

# Rebuild single-field newtype nesting around a leaf value (the inverse of
# unwrapToPointerWord).
fun wrapLeaf(ctype, leaf): RParam => match(cgFieldsOf(ctype))
  (fields: List<CgField>) => match(soleField(fields))
    (f: CgField) => RpNewStruct(list1(RpNamedValue(f.fieldName, wrapLeaf(f.fieldType, leaf))))
    ()            => leaf
  ()               => leaf

# A one-word member value (NULL / tagged Int / object pointer) as a two-word
# union value: word 0 carries it, the String payload is zero.
fun strWord(word): RParam => RpRuntimeInvoke("str_word", RpNewStruct(list1(RpNamedValue("word", word))), CgStr(false))

# The dispatch word of a value of this union.
fun ptrWord(gp: GPointer, sv): RParam => gp.grpWide ? RpStructField(sv, "head") : sv

# The test that `word` (a value's dispatch word) holds `member`, or None for
# an untestable member (a foreign class: the fallback).
fun ptrGuard(gp: GPointer, member, word, r): RParam|None
  ret eqCgType(specGenerate(member, r), CgStruct(List()))
    ? RpIntEqConst(word, 0)
    : match(pointerWordKind(member, r))
        (k: PtrKind) => ptrGuardOf(gp, k, word, r)
        ()           => None

fun ptrGuardOf(gp: GPointer, k, word, r): RParam|None => match(k)
  (i: PkInt)      => RpObjVtableEq(word, None, "INTEGER_VTABLE", None)
  # A spare code is a tag-4 word too: check the length.
  (s2: PkStr)     => gp.grpPacks
    ? RpRuntimeInvoke("str_word_is_string", RpNewStruct(list1(RpNamedValue("w", word))), CgInt(8))
    : RpObjVtableEq(word, None, "STR_HEAD_VTABLE", None)
  (sc: PkScalar)  => RpIntEqConst(RpRuntimeInvoke("str_word_code", RpNewStruct(list1(RpNamedValue("w", word))), CgInt(32)),
                                  scalarCode(sc.pkScalar))
  (f: PkFun)      => RpRuntimeInvoke("str_word_is_fun", RpNewStruct(list1(RpNamedValue("w", word))), CgInt(8))
  (c: PkClass)    => RpObjVtableEq(word, c.pkName, None, ptrClassMembers(gp, r))
  (e2: PkEnum)    => RpObjVtableEq(word, e2.pkRoot, None, None)
  (u: PkUnit)     => None
  (fo: PkForeign) => None

# Every class this union's tests must tell apart — its class members — or None
# when the set is open: an interface member admits any implementor, and an
# enum member is tested through its root. (union_repr.py _class_members.)
fun ptrClassMembers(gp: GPointer, r): List<String>|None
  ret ptrClassMembersLoop(reprMembersOf(unionMembers(gp.grpType)), r, Set<String>())

fun ptrClassMembersLoop(ms: List<Spec>, r, acc: Set<String>): List<String>|None =>
  match(foldWhile<Spec, Set<String>|None>(ms, acc, (a, m) => ptrClassMemberStep(a, m, r), (a) => a !is None))
    (s: Set<String>) => sort(s)
    ()               => None

fun ptrClassMemberStep(a: Set<String>|None, m: Spec, r) => match(a)
  (s: Set<String>) => match(pointerWordKind(m, r))
    (c: PkClass)    => specIsInterface(m, r) ? None : add(s, c.pkName)
    (e2: PkEnum)    => None
    (fo: PkForeign) => None
    ()              => s
  ()               => None

fun specIsInterface(m: Spec, r): Bool => match(m)
  (c: SClass) => soleFoundIsInterface(findType(r, c.scName).bItems)
  (o: Spec)   => false

fun soleFoundIsInterface(fs: List<Found>) => exactly(fs, 1) && any(fs, foundIsInterface)

fun foundIsInterface(f: Found): Bool => match(f.fStmt)
  (cls: PsClass) => cls.cIsInterface
  (o: PStmt)     => false

fun ptrToFun(value) => RpRuntimeInvoke("str_to_fun", RpNewStruct(list1(RpNamedValue("s", value))), CgFuncPointer(false, false))

fun ptrUnpack(value, scalar) => RpRuntimeInvoke("str_unpack_" + scalarC(scalar),
                                                RpNewStruct(list1(RpNamedValue("s", value))), scalarCtype(scalar))

# A value of this union, known to hold `member`, as that member's own
# representation (newtype nesting included).
fun ptrMemberValue(gp: GPointer, member, value, r): RParam
  let mctype = specGenerate(member, r)
  ret eqCgType(mctype, CgStruct(List()))
    ? RpZeroOf(mctype)
    : wrapLeaf(mctype, ptrMemberLeaf(gp, mctype, pointerWordKind(member, r), value))

fun ptrMemberLeaf(gp: GPointer, mctype, kind: PtrKind|None, value): RParam => match(kind)
  (sc: PkScalar) => ptrUnpack(value, sc.pkScalar)
  (f: PkFun)     => ptrToFun(value)
  ()             => ptrStrOrWord(gp, mctype, value)

fun ptrStrOrWord(gp: GPointer, mctype, value): RParam
  ret gp.grpWide && eqCgType(peeledCtype(mctype), CgStr(false)) ? value : ptrWord(gp, value)

# The subject seen at an arm's type, as a LEAF (bindSubject rebuilds any
# newtype nesting): the whole value for a String, the unpacked payload for a
# scalar, else the dispatch word.
fun ptrAs(gp: GPointer, sv, armType, r): RParam
  if !gp.grpWide
    ret sv
  if eqCgType(peeledCtype(specGenerate(armType, r)), CgStr(false))
    ret sv
  ret match(armType)
    (cm: SCombination) => ptrWord(gp, sv)
    (o: Spec)          => match(pointerWordKind(armType, r))
      (sc: PkScalar) => ptrUnpack(sv, sc.pkScalar)
      (f: PkFun)     => ptrToFun(sv)
      ()             => ptrWord(gp, sv)

class [final] SlotValuePair(svpName: String, svpValue: RParam)

fun variantSlots(value, innerCtype, slotAssignments: List<CgSlotEntry>, slotFields: List<CgField>): List<SlotValuePair>
  ret isEmpty(cgFlattenPrimitives(innerCtype)) ? List() : collectVariantSlots(value, innerCtype, slotAssignments, slotFields, 0).cvValues

class [final] CollectOut(cvValues: List<SlotValuePair>, cvOffset: Int)

fun collectVariantSlots(param, ctype, slotAssignments: List<CgSlotEntry>, slotFields: List<CgField>, offset)
  ret match(ctype)
    (fp: CgFuncPointer) => collectVariantSlotsFun(param, slotAssignments, slotFields, offset)
    (o: CgType)          => match(cgFieldsOf(ctype))
      (fields: List<CgField>) => collectVariantSlotsFields(fields, param, slotAssignments, slotFields, offset, List())
      ()                       => collectVariantSlotsLeaf(param, slotAssignments, slotFields, offset)

# A closure IS a struct (the enum-encoding principle): deconstructed into the
# two primitives the layout allotted — the code word (non-GC), then the
# environment pointer (GC). union_repr.py _variant_slots is the mirror.
fun collectVariantSlotsFun(param, slotAssignments: List<CgSlotEntry>,
                           slotFields: List<CgField>, offset)
  ret match(listAt(slotAssignments, offset))
    (ef: CgSlotEntry) => match(listAt(slotAssignments, offset + 1))
      (eo: CgSlotEntry) => CollectOut(
          list2(SlotValuePair(fieldNameAt(slotFields, ef.slotIndex),
                              RpFunField(param, "f")),
                SlotValuePair(fieldNameAt(slotFields, eo.slotIndex),
                              RpFunField(param, "o"))),
          offset + 2)
      ()                 => CollectOut(List(), offset + 2)   # unreachable
    ()                 => CollectOut(List(), offset + 2)   # unreachable

fun collectVariantSlotsLeaf(param, slotAssignments: List<CgSlotEntry>, slotFields: List<CgField>, offset)
  ret match(listAt(slotAssignments, offset))
    (e2: CgSlotEntry) => CollectOut(list1(SlotValuePair(fieldNameAt(slotFields, e2.slotIndex), param)), offset + 1)
    ()                 => CollectOut(List(), offset + 1)   # unreachable

fun collectVariantSlotsFields(fs: List<CgField>, param, slotAssignments: List<CgSlotEntry>,
                              slotFields: List<CgField>, offset, acc)
  let out = fold(fs, (offset = offset, acc = acc),
                 (st, f) => collectVariantSlotsFieldsStep(st, f, param, slotAssignments, slotFields))
  ret CollectOut(out.acc, out.offset)

fun collectVariantSlotsFieldsStep(st: (offset: Int, acc: List<SlotValuePair>), f: CgField, param,
                                  slotAssignments: List<CgSlotEntry>, slotFields: List<CgField>)
  let sub = collectVariantSlots(RpStructField(param, f.fieldName), f.fieldType, slotAssignments, slotFields, st.offset)
  ret (offset = sub.cvOffset, acc = concat(st.acc, sub.cvValues))

# ══════════════════════════════════════════════════════════════════════════
# SECTION 4: the GRepr sum type + classify.
# ══════════════════════════════════════════════════════════════════════════

enum GRepr
  # grtNullTests: a flat enum whose NULL slots name its variant carries no
  # $tag — per variant, the tests that hold for it alone (computeEnumSlots).
  # None: the variant is the $tag.
  enum GTagged(grtType: Spec, grtContainer: CgType, grtVariantMap: List<List<CgSlotEntry>>,
               grtNullTests: List<List<CgNullTest>>|None)
  # grpWide: a String or function member — the value is a str_t whose head
  # is the dispatch word. grpPacks: scalar or function members ride as spare
  # codes (wide only). grpNonNull: no unit member — the word is never NULL.
  enum GPointer(grpType: Spec, grpWide: Bool, grpPacks: Bool, grpNonNull: Bool)
  enum GComplexEnum(grcType: Spec)

# DERIVED is_complex: the resolver carries the breaker analysis (identity
# vs state — no stamps to read, no canon lookup, no stale copies).
fun isComplexEnum(sp: SEnum, r) => isComplexRoot(r, sp.seRoot)

# Whether classifyRepr can answer for this union inside a generic body. A
# member held BY VALUE as a type parameter — `T` itself, or a tuple holding one
# — has no layout until monomorphisation binds it. A heap member (class, enum)
# is a pointer whatever its type arguments, so `List<T>` is decided.
# (union_repr.py layout_decided.)
fun layoutDecided(sp: Spec): Bool => match(sp)
  (cm: SCombination) => !any(reprMembers(cm), byValuePlaceholder)
  (o: Spec)          => true

fun byValuePlaceholder(sp: Spec): Bool => match(sp)
  (g: SGeneric) => true
  (t2: STuple)  => any(t2.stEntries, (e) => entryByValuePlaceholder(e.seType))
  (o: Spec)     => false

fun entryByValuePlaceholder(sp: Spec|None): Bool => match(sp)
  (x: Spec) => byValuePlaceholder(x)
  ()        => false

fun classifyRepr(sp, r): GRepr => match(sp)
  (e2: SEnum) => classifyEnum(e2, r)
  (cm: SCombination) => classifyCombination(cm, r)
  (o: Spec)   => GPointer(sp, false, false, false)   # unreachable (Python raises TypeError): not a union type

fun classifyEnum(e2, r): GRepr => isComplexEnum(e2, r) ? GComplexEnum(e2) : classifyFlatEnum(e2, r)

fun classifyFlatEnum(e2: SEnum, r) => match(soleItem(findType(r, e2.seRoot)))
  (found: Found) => match(found.fStmt)
    (stmt: PsEnum) => classifyFlatEnumStmt(e2, stmt, r)
    (o: PStmt)     => classifyFlatEnumFallback(e2, r)
  ()               => classifyFlatEnumFallback(e2, r)

fun classifyFlatEnumStmt(e2, stmt: PsEnum, r)
  let layout = computeEnumSlots(enumVariantTypes(stmt, r), globalMaxTag(r))
  ret GTagged(e2, layout.fieldsStruct, layout.variantMap, layout.nullTests)

fun classifyFlatEnumFallback(e2: SEnum, r)
  ret GTagged(e2, CgStruct(map(enumFieldsVia(r, e2.seRoot),
                               (f) => CgField(f.sfName, specGenerate(f.sfType, r)))),
              List(), None)

fun classifyCombination(cm: SCombination, r): GRepr
  let members = reprMembersOf(cm.scTypes)
  ret unionCollapsesToPointer(members, r) ? classifyPointer(cm, members, r) : classifyCombinationTagged(cm, members, r)

fun classifyPointer(cm, members: List<Spec>, r)
  let kinds = map(members, (m) => forceKindId(pointerWordKind(m, r)))
  ret GPointer(cm, any(kinds, (k) => isStrKind(k) || isFunKind(k)),
               any(kinds, (k) => isScalarKind(k) || isFunKind(k)),
               !any(kinds, isUnitKind))

fun classifyCombinationTagged(cm, members: List<Spec>, r)
  let layout = computeUnionSlots(map(members, (v) => specGenerate(v, r)), globalMaxTag(r))
  ret GTagged(cm, layout.fieldsStruct, layout.variantMap, layout.nullTests)

fun reprCtype(rep): CgType => match(rep)
  (gt: GTagged) => gt.grtContainer
  (gp: GPointer) => gp.grpWide ? CgStr(gp.grpNonNull) : CgDataPointer(gp.grpNonNull)
  (gc: GComplexEnum) => CgDataPointer(true)   # every variant is an object

# ══════════════════════════════════════════════════════════════════════════
# SECTION 5: generate_match — TaggedRepr (flat enum + combination),
# PointerRepr, ComplexEnumRepr.
# ══════════════════════════════════════════════════════════════════════════

# ── per-position stages and binds (multi-subject match) ──────────────────
# `reprGenerateMatch` above drives the whole dispatch for ONE subject. With
# several subjects each position instead contributes its STAGES of checks to
# each arm, and emArm ANDs the stages and falls through to the next arm when
# any fails — first-match-wins across positions, with no decision tree. A
# position usually takes one stage; one that names some variants of an enum
# member takes two: the member, then the variant.
#
# The stages are built at code generation only, for a pattern
# `reprTestsPosition` accepts: the guards read discriminators, which do not
# exist before then. None means "this repr cannot serve a position with that
# pattern"; the check phase has already reported it.

# Whether `rep` can test `armType` at ONE position. The check phase asks, and
# reports a refusal; it is a question about types alone, so it can be asked
# before any discriminator is assigned. (union_repr.py tests_position.)
fun reprTestsPosition(rep, armType: Spec, r): Bool => match(rep)
  (gt: GTagged)      => taggedTestsPosition(gt, armType)
  (gp: GPointer)     => pointerTestsPosition(gp, armType, r)
  (gc: GComplexEnum) => (asEnumVariant(gc.grcType) !is None) && (asEnumVariant(armType) !is None)

# A flat enum tests an enum pattern. A tagged combination tests a pattern that
# selects exactly one of its members: one selecting several (`(t: Thing)` over
# `Car|Boat`) would bind a different value per member, which one position
# cannot.
fun taggedTestsPosition(gt: GTagged, armType: Spec): Bool => match(gt.grtType)
  (e2: SEnum) => asEnumVariant(armType) !is None
  (o: Spec)   => soleSelection(taggedSelections(reprMembersOf(unionMembers(gt.grtType)), armType)) !is None

# A FOREIGN class is untestable from generated code — in a single-subject match
# it can be the implicit fallback, but a POSITION has no fallback to be. And
# "variant and member, or another member" is not one stage per position.
fun pointerTestsPosition(gp: GPointer, armType: Spec, r): Bool
  let members = unionMembers(narrowedMember(gp.grpType, armType))
  ret !any(members, (m) => narrowsUnionMember(gp.grpType, m))
    && all(members, (m) => ptrTestable(m, r))

# Whether ptrGuard has a test for `member`: all but a foreign class.
fun ptrTestable(member: Spec, r): Bool =>
  eqCgType(specGenerate(member, r), CgStruct(List())) || ptrKindTestable(pointerWordKind(member, r))

fun ptrKindTestable(k: PtrKind|None): Bool => match(k)
  (u: PkUnit)     => false
  (fo: PkForeign) => false
  (o: PtrKind)    => true
  ()              => false

fun reprPositionStages(rep, sv, armType: Spec|None,
                       r): List<List<RParam>>|None => match(armType)
  (at: Spec) => reprPositionStagesOn(rep, sv, at, r)
  ()         => None

fun reprPositionStagesOn(rep, sv, armType,
                         r): List<List<RParam>>|None => match(rep)
  (gt: GTagged) => match(gt.grtType)
    (e2: SEnum) => oneStage(flatLeafGuards(gt, ownSlot(gt, sv), armType))
    (o: Spec)   => combinationPositionStages(gt, sv, armType, r)
  (gp: GPointer)     => pointerPositionStages(gp, sv, armType, r)
  (gc: GComplexEnum) => oneStage(complexPositionGuards(gc, sv, armType, r))

fun oneStage(guards: List<RParam>|None): List<List<RParam>>|None => match(guards)
  (g: List<RParam>) => list1(g)
  ()                => None

# OR-alternatives testing that a value of the flat enum `gt` holds one of
# `armType`'s leaves, in leaf order. `readSlot(i)` reads the value's i-th
# slot (its $tag is the last): the value is a subject of its own, or a member
# held in a combination's slots. A leaf is its position in the leaf list: the
# $tag's value, or the index of its null tests.
fun flatLeafGuards(gt: GTagged, readSlot: (:Int): RParam, armType: Spec): List<RParam>|None
  ret match(asEnumVariant(armType))
    (at: SEnum) => map(sortLeavesByGuardOrder(at.seValidLeaves, enumAllLeaves(gt.grtType)),
                       (leaf) => flatLeafGuard(gt, readSlot, leafId(enumAllLeaves(gt.grtType), leaf)))
    ()          => None

fun flatLeafGuard(gt: GTagged, readSlot: (:Int): RParam, leafIdx: Int): RParam => match(gt.grtNullTests)
  (tests: List<List<CgNullTest>>) => RpNullPattern(map(forceNthTests(tests, leafIdx),
      (t2) => RpNullTest(readSlot(t2.ntSlot), t2.ntIsNull)))
  ()                              => RpIntEqConst(readSlot(fieldIndexNamed(forceFields(gt.grtContainer), "$tag")),
                                                  leafIdx)

fun forceNthTests(l: List<List<CgNullTest>>, i) => match(listAt(l, i))
  (v: List<CgNullTest>) => v
  ()                    => List()   # unreachable: one test list per leaf

fun fieldIndexNamed(fields: List<CgField>, name) => findIndex(fields, (f) => f.fieldName == name) ?? -1  # always present

# readSlot for a value of the union `gt` held as a subject of its own.
fun ownSlot(gt: GTagged, sv): (:Int): RParam
  let fields = forceFields(gt.grtContainer)
  ret (si: Int) => RpStructField(sv, fieldNameAt(fields, si))

# The enum member among `members` that `armType` names only SOME of the
# variants of — `EOFError` within `String|IOError` — else `armType` itself.
# An arm whose pattern is narrower than the member it selects must test the
# variant as well as the member.
fun narrowedMemberIn(members: List<Spec>, armType): Spec => match(armType)
  (ae: SEnum) => match(head(filter(members, (m) => strictlyHoldsMember(m, ae))))
    (m: Spec) => m
    ()        => armType
  (o: Spec)   => armType

fun narrowedMember(unionType, armType): Spec => match(unionType)
  (cm: SCombination) => narrowedMemberIn(reprMembersOf(unionMembers(unionType)), armType)
  (o: Spec)          => armType

# Whether `armType` names only some of the variants of one of `members`.
fun narrowsAnyMember(members: List<Spec>, armType) => match(armType)
  (ae: SEnum) => any(members, (m) => strictlyHoldsMember(m, ae))
  (o: Spec)   => false

fun narrowsUnionMember(unionType, armType) => match(unionType)
  (cm: SCombination) => narrowsAnyMember(reprMembersOf(unionMembers(unionType)), armType)
  (o: Spec)          => false

# ── what a tagged-combination pattern selects ───────────────────────────────

# A subject member an arm's pattern matches: its index, the member, and
# whether the pattern is below the member's level (then the variant is tested
# as well as the member's tag).
class [final] Selection(selIndex: Int, selHolder: Spec, selNeedsVariantTest: Bool)

# The members of a tagged combination that `pattern` matches. Usually one:
# the member that holds a value of `pattern`, which needs a variant test as
# well when `pattern` is below its level. A parent-level pattern over sibling
# members (`Thing` over `Car|Boat`) matches each member it holds.
fun taggedSelections(members: List<Spec>, pattern: Spec): List<Selection> => match(memberHolding(members, pattern), pattern)
  (held: HeldMember, _: Spec) => list1(Selection(held.hmIndex, held.hmMember, belowHolder(held.hmMember, pattern)))
  (_: None, pe: SEnum)        => heldSelections(members, pe)
  ()                          => List()

fun belowHolder(holder: Spec, pattern: Spec) => match(pattern)
  (pe: SEnum) => strictlyHoldsMember(holder, pe)
  (o: Spec)   => false

fun heldSelections(members: List<Spec>, pe: SEnum): List<Selection> =>
  fold(members, (i = 0, acc = List<Selection>()),
       (st, m) => (i = st.i + 1,
                   acc = heldByPattern(m, pe) ? append(st.acc, Selection(st.i, m, false)) : st.acc)).acc

# Whether the subject member `m` is held by the pattern `pe`.
fun heldByPattern(m: Spec, pe: SEnum) => match(m)
  (me: SEnum) => holds(pe, me)
  (o: Spec)   => false

fun soleSelection(ss: List<Selection>): Selection|None => exactly(ss, 1) ? head(ss) : None

fun complexPositionGuards(gc: GComplexEnum, sv, armType: Spec,
                          r): List<RParam>|None => match(asEnumVariant(gc.grcType))
  (subj: SEnum) => match(asEnumVariant(armType))
    (at: SEnum) => map(sortLeavesByComplexId(at.seValidLeaves, subj.seRoot,
                                             getDiscriminators(r)),
                       (leaf) =>
                         RpIntEqConst(RpVtableDiscriminator(sv),
                                      complexLeafId(subj.seRoot, leaf,
                                                    getDiscriminators(r))))
    ()          => None
  ()            => None

# NULL for the unit member, vtable identity for the rest — then, for a
# pattern naming only some of an enum member's variants, the variant. A
# FOREIGN class is untestable from generated code — in a single-subject match
# it can be the implicit fallback, but a POSITION has no fallback to be. A
# union pattern naming some variants ("variant and member, or another
# member") is not one stage per position, and is refused too.
fun pointerPositionStages(gp: GPointer, sv, armType,
                          r): List<List<RParam>>|None
  let member = narrowedMember(gp.grpType, armType)
  let members = unionMembers(member)
  if any(members, (m) => narrowsUnionMember(gp.grpType, m))
    ret None
  ret match(pointerGuards(gp, members, ptrWord(gp, sv), r))
    (guards: List<RParam>) => narrowsUnionMember(gp.grpType, armType)
      ? list2(guards, ptrVariantGuards(gp, member, sv, armType, r))
      : list1(guards)
    ()                     => None

# Every member's guard, or None when one is FOREIGN (untestable in a position)
# or there are none at all.
fun pointerGuards(gp: GPointer, ms: List<Spec>, word, r) => match(mapAll(ms, (m) => ptrGuard(gp, m, word, r)))
  (gs: List<RParam>) => isEmpty(gs) ? None : gs
  ()                 => None

# The member's tag — then, for a pattern naming only some of an enum
# member's variants, the variant. `.get(uid, 0)` is deliberate: a BUILTIN
# member such as the `int32` of `Int32|None` carries no registry
# discriminator and takes tag 0, exactly as the single-subject path reads it.
fun combinationPositionStages(gt: GTagged, sv, armType,
                              r): List<List<RParam>>|None
  # The pattern must select exactly one member of this subject union. A
  # pattern selecting none would test tag 0 and silently match the wrong
  # variant; one selecting several (`(t: Thing)` over `Car|Boat`) would bind a
  # different value per member, which one position cannot. Both are refused.
  ret match(soleSelection(taggedSelections(reprMembersOf(unionMembers(gt.grtType)), armType)))
    (sel: Selection) => combinationMemberStages(gt, sv, sel, armType, r)
    ()                     => None

fun combinationMemberStages(gt: GTagged, sv, sel: Selection, armType, r): List<List<RParam>>
  let tagStage: List<RParam> = list1(RpIntEqConst(RpStructField(sv, "$tag"),
                                    discOf(getDiscriminators(r), uid(sel.selHolder))))
  ret sel.selNeedsVariantTest
    ? list2(tagStage, taggedVariantGuards(sel.selHolder, forceNth(gt.grtVariantMap, sel.selIndex),
                                          forceFields(gt.grtContainer), sv, armType, r))
    : list1(tagStage)

# OR-alternatives testing that the enum `member` held in a tagged union's
# slots is one of `armType`'s variants: a complex enum by its variant's
# vtable, a flat one by its own slots — each a primitive, so the member's
# i-th slot is its i-th primitive here.
fun taggedVariantGuards(member, slots: List<CgSlotEntry>, slotFields: List<CgField>, sv,
                        armType, r): List<RParam> => match(classifyRepr(member, r))
  (gc: GComplexEnum) => guardsOrNever(complexPositionGuards(gc, slotValue(firstSlot(slots), slotFields, sv),
                                                            armType, r))
  (gt: GTagged)      => guardsOrNever(flatLeafGuards(gt, (i: Int) => slotValue(listAt(slots, i), slotFields, sv),
                                                     armType))
  (o: GRepr)         => guardsOrNever(None)   # unreachable: a flat enum member is tagged

fun slotValue(e2: CgSlotEntry|None, slotFields: List<CgField>, sv): RParam => match(e2)
  (s2: CgSlotEntry) => slotRead(sv, slotFields, s2.slotIndex, s2.origType)
  ()                 => RpNullPointer()   # unreachable: an enum member occupies a slot

fun firstSlot(slots: List<CgSlotEntry>): CgSlotEntry|None => head(slots)

fun enumAllLeaves(sp): List<String> => match(sp)
  (e2: SEnum) => e2.seAllLeaves
  (o: Spec)   => List()                # unreachable: only an enum member narrows

fun guardsOrNever(guards: List<RParam>|None): List<RParam> => match(guards)
  (g: List<RParam>) => g
  ()                => list1(RpIntEqConst(RpInteger(0, 32), 1))   # unreachable: the pattern is an enum

# subject_at_arm: the subject's type at the arm's level of the enum, so the
# arm body sees that level's fields. The value itself is unchanged.
fun subjectAtArm(subjType: Spec, armType: Spec, r): Spec => match(subjType, armType)
  (se: SEnum, ae: SEnum) => isEmpty(ae.sePath) ? subjType : (enumLevel(se, ae.sePath, r) ?? subjType)
  ()                     => subjType

fun discOf(discs: Dict<String, Int>, u: String) => match(get(discs, u))
  (i: Int) => i
  ()       => 0

# Bind ONE position's name, or None when it binds nothing. The enum reprs
# bind at the SUBJECT type seen at the arm's level (an SEnum arm type may be a
# pruned generic spec with stale fields, but its level is what the body reads);
# a pointer union binds at the ARM's type, since the value IS the narrowed
# pointer; and a tagged combination REASSEMBLES the variant out of the
# union's slots.
fun reprPositionBind(rep, holder: PArm, sv, armType, subjType, r): GBind|None => match(rep)
  (gt: GTagged) => match(gt.grtType)
    (e2: SEnum) => bindSubject(r, holder, subjectAtArm(subjType, armType, r), sv)
    (o: Spec)   => combinationPositionBind(gt, holder, sv, armType, r)
  (gp: GPointer)     => bindSubject(r, holder, armType, ptrAs(gp, sv, armType, r))
  (gc: GComplexEnum) => bindSubject(r, holder, subjectAtArm(subjType, armType, r), sv)

fun combinationPositionBind(gt: GTagged, holder: PArm, sv, armType, r): GBind|None
  ret match(soleSelection(taggedSelections(reprMembersOf(unionMembers(gt.grtType)), armType)))
    (sel: Selection) => bindFromSlots(r, holder, specGenerate(sel.selHolder, r),
                                            forceNth(gt.grtVariantMap, sel.selIndex),
                                            forceFields(gt.grtContainer), sv)
    ()                     => None   # several members need a Phi, not a stage

fun reprGenerateMatch(rep, em, resultType, subjBundle: GBundle,
                     arms: List<PArm>, elseArm, r): GEmit => match(rep)
  (gt: GTagged) => match(gt.grtType)
    (e2: SEnum) => generateFlatEnumMatch(em, resultType, subjBundle, gt, arms, elseArm, r)
    (o: Spec)   => generateCombinationMatch(em, resultType, subjBundle, gt.grtType, gt.grtContainer, gt.grtVariantMap, arms, elseArm, r)
  (gp: GPointer) => generatePointerMatch(em, resultType, subjBundle, gp, arms, elseArm, r)
  (gc: GComplexEnum) => generateComplexEnumMatch(em, resultType, subjBundle, gc.grcType, arms, elseArm, r)

# isNoneSpec is reused as-is from generate_expr2.yafl.

fun leafId(allLeafNames: List<String>, leaf): Int
  ret findIndex(allLeafNames, (n) => baseName(n) == baseName(leaf)) ?? -1  # always a member

fun sortLeavesByGuardOrder(leaves: List<String>, allLeafNames: List<String>): List<String>
  ret fold(leaves, List(), (acc, lf) => insertByLeafId(acc, lf, allLeafNames))

fun insertByLeafId(sorted, lf, allLeafNames: List<String>) => match(head(sorted))
  (h: String) => leafId(allLeafNames, lf) < leafId(allLeafNames, h)
    ? prepend(lf, sorted)
    : prepend(h, insertByLeafId(dropOne(sorted), lf, allLeafNames))
  ()           => prepend(lf, List())

# ── flat enum ────────────────────────────────────────────────────────────

fun generateFlatEnumMatch(em0, resultType: Spec|None, subjBundle: GBundle, gt: GTagged,
                          arms: List<PArm>, elseArm: PArm|None, r): GEmit
  let sv = mustResult(subjBundle)
  let em1 = flatEnumArms(em0, arms, sv, gt, resultType, r)
  let bind = match(elseArm)
    (a: PArm) => bindSubject(r, a, gt.grtType, sv)
    ()         => None
  ret emFallback(em1, r, resultType, elseArm, bind, "enum match fell through all arms")

fun flatEnumArms(em: GEmit, arms: List<PArm>, sv: RParam, gt: GTagged, resultType: Spec|None,
                 r: Resolver): GEmit =>
  fold(arms, em, (a, x) => isNoneSpec(x.armType) ? a : flatEnumArm(a, x, sv, gt, resultType, r))

fun flatEnumArm(em, arm: PArm, sv, gt: GTagged, resultType: Spec|None, r): GEmit
  ret match(asEnumVariant(arm.armType))
    (armType: SEnum) => flatEnumArmOn(em, arm, gt, armType, sv, resultType, r)
    ()                => em   # unreachable: check() requires an enum arm here

fun flatEnumArmOn(em: GEmit, arm: PArm, gt: GTagged, armType: SEnum, sv,
                  resultType: Spec|None, r): GEmit
  let guards = guardsOrNever(flatLeafGuards(gt, ownSlot(gt, sv), armType))
  ret emArm(em, r, resultType, arm, list1(guards),
            bindSubject(r, arm, subjectAtArm(gt.grtType, armType, r), sv), List())

# ── tagged combination ──────────────────────────────────────────────────

fun generateCombinationMatch(em0, resultType: Spec|None, subjBundle: GBundle, subjType,
                             container, variantMap: List<List<CgSlotEntry>>,
                             arms: List<PArm>, elseArm: PArm|None, r): GEmit
  let sv = mustResult(subjBundle)
  let tag = RpStructField(sv, "$tag")
  let members = reprMembersOf(unionMembers(subjType))
  let slotFields = forceFields(container)
  let discs = getDiscriminators(r)
  let em1 = combinationArms(em0, arms, sv, tag, members, variantMap, slotFields, discs, resultType, r)
  let bind = match(elseArm)
    (a: PArm) => bindSubject(r, a, subjType, sv)
    ()         => None
  ret emFallback(em1, r, resultType, elseArm, bind, "tagged-union match fell through all arms")

fun combinationArms(em,
                    arms: List<PArm>,
                    sv,
                    tag,
                    members,
                    variantMap: List<List<CgSlotEntry>>,
                    slotFields: List<CgField>,
                    discs: Dict<String, Int>,
                    resultType,
                    r) =>
  fold(arms, em, (a, x) => combinationArm(a, x, sv, tag, members, variantMap, slotFields, discs, resultType, r))

fun combinationArm(em, arm: PArm, sv, tag, members,
                   variantMap: List<List<CgSlotEntry>>, slotFields: List<CgField>,
                   discs, resultType: Spec|None, r): GEmit => !isEmpty(arm.armLiterals)
  ? combinationLiteralArm(em, arm, sv, tag, members, variantMap, slotFields, discs, resultType, r)
  : combinationTypedArm(em, arm, sv, tag, members, variantMap, slotFields, discs, resultType, r)

fun combinationTypedArm(em, arm: PArm, sv, tag, members: List<Spec>,
                        variantMap: List<List<CgSlotEntry>>, slotFields: List<CgField>,
                        discs, resultType: Spec|None, r): GEmit => match(arm.armType)
  (cm: SCombination) => combinationUnionArm(em, arm, cm, sv, tag, members, variantMap, slotFields, discs, resultType, r)
  (t2: Spec)         => combinationPlainArm(em, arm, t2, sv, tag, members, variantMap, slotFields, discs, resultType, r)
  ()                 => em   # else arm: the fallback, handled at the end

fun litExprOf(l2) => match(l2)
  (le2: PlExpr) => le2.litExpr
  (rg: PlRange) => rg.rangeLo

fun litTypeNameOfFirst(lits: List<PLit>, r) => match(head(lits))
  (l2: PLit) => litTypeNameOfOne(l2, r)
  ()          => None

fun litTypeNameOfOne(l2, r) => match(asBuiltinVariant(exprType(litExprOf(l2), r)))
  (b: SBuiltin) => b.sbName
  ()             => None

fun [tail] indexWhereBuiltin(members: List<Spec>, typeName, i) => match(head(members))
  (m: Spec) => isBuiltinNamed(m, typeName) ? i : indexWhereBuiltin(dropOne(members), typeName, i + 1)
  ()         => None

fun isBuiltinNamed(sp, typeName) => match(sp)
  (b: SBuiltin) => b.sbName == typeName
  (o: Spec)     => false

fun combinationLiteralArm(em, arm: PArm, sv, tag, members,
                          variantMap: List<List<CgSlotEntry>>, slotFields: List<CgField>,
                          discs: Dict<String, Int>, resultType, r)
  ret match(litTypeNameOfFirst(arm.armLiterals, r))
    (litTypeName: String) => match(indexWhereBuiltin(members, litTypeName, 0))
      (vi: Int) => combinationLiteralArmAt(em, arm, sv, tag, members, variantMap, slotFields, discs, litTypeName, vi, resultType, r)
      ()         => em   # check() prevents this; skip to be safe
    ()                     => em

fun combinationLiteralArmAt(em: GEmit, arm: PArm, sv, tag, members,
                            variantMap: List<List<CgSlotEntry>>, slotFields: List<CgField>,
                            discs: Dict<String, Int>, litTypeName, vi, resultType, r)
  let tagValue = getOr0(discs, uid(forceNth(members, vi)))
  let slotVal = forceSlotRead(forceNth(variantMap, vi), slotFields, sv)
  let lt = literalAlternativeTests(arm.armLiterals, litTypeName, slotVal, r, "lit" + String(em.geCounter))
  ret emArm(em, r, resultType, arm, list2(list1(RpIntEqConst(tag, tagValue)), lt.ltoTests), None, lt.ltoBundles)

fun forceSlotRead(entries: List<CgSlotEntry>, slotFields: List<CgField>, sv) => match(head(entries))
  (e2: CgSlotEntry) => slotRead(sv, slotFields, e2.slotIndex, e2.origType)
  ()                 => RpNullPointer()   # unreachable: a literal-typed variant always occupies exactly one slot

fun isStructLike(t) => match(cgFieldsOf(t))
  (fields: List<CgField>) => true
  ()                       => false

fun combinationUnionArm(em: GEmit, arm: PArm, cm, sv, tag, members: List<Spec>,
                        variantMap: List<List<CgSlotEntry>>, slotFields: List<CgField>,
                        discs: Dict<String, Int>, resultType, r)
  let narrowCtype = specGenerate(cm, r)
  let narrowMembers = reprMembersOf(unionMembers(cm))
  let narrowRep = classifyRepr(cm, r)
  let narrowMap = isStructLike(narrowCtype)
    ? computeUnionSlots(map(narrowMembers, (m) => specGenerate(m, r)), None).variantMap
    : List()
  let entries = combinationUnionEntries(narrowMembers, members, variantMap, slotFields, discs, tag, sv,
                                        narrowCtype, narrowMap, narrowRep, r)
  ret emMultiEntryArm(em, r, resultType, arm, entries, narrowCtype)

fun combinationUnionEntries(narrowMembers: List<Spec>, members: List<Spec>,
                            variantMap: List<List<CgSlotEntry>>, slotFields: List<CgField>,
                            discs: Dict<String, Int>, tag, sv, narrowCtype,
                            narrowMap: List<List<CgSlotEntry>>, narrowRep: GRepr, r): List<GEntry> =>
  fold(narrowMembers, (k = 0, acc = List<GEntry>()),
       (st, m) => (k = st.k + 1,
                   acc = combinationUnionEntriesStep(m, st.k, members, variantMap, slotFields, discs, tag, sv,
                                                     narrowCtype, narrowMap, narrowRep, r, st.acc))).acc

# Each member of the arm's union (a `pattern`) enters through every subject
# member it matches (its holder): the holder's tag, then — when the pattern
# is below the holder's level — the variant.
fun combinationUnionEntriesStep(pattern: Spec, k, members: List<Spec>,
                               variantMap: List<List<CgSlotEntry>>, slotFields: List<CgField>,
                               discs: Dict<String, Int>, tag, sv, narrowCtype,
                               narrowMap: List<List<CgSlotEntry>>, narrowRep: GRepr, r,
                               acc): List<GEntry>
  ret fold(taggedSelections(members, pattern), acc,
           (a, sel) => contains(discs, uid(sel.selHolder))
             ? append(a, combinationUnionEntry(sel, pattern, discs, variantMap, slotFields, tag, sv, k,
                                               narrowCtype, narrowMap, narrowRep, r))
             : a)   # check() validated coverage; skip defensively

fun combinationUnionEntry(sel: Selection, pattern: Spec, discs: Dict<String, Int>,
                          variantMap: List<List<CgSlotEntry>>,
                          slotFields: List<CgField>, tag, sv, k,
                          narrowCtype, narrowMap: List<List<CgSlotEntry>>, narrowRep: GRepr, r)
  let vi = sel.selIndex
  let memberTag = getOr0(discs, uid(sel.selHolder))
  # Pointer narrow union: the member's LEAF, read out of its wide slots and
  # boxed by the narrow union itself (NULL for the unit member, a spare code
  # for a scalar, environment + code for a function).
  let value = match(narrowRep)
    (np: GPointer) => pointerBoxLeaf(np, leafFromSlots(pattern, forceNth(variantMap, vi), slotFields, sv, r), pattern, r)
    (o: GRepr)     => combinationUnionValueTagged(narrowCtype, forceNth(narrowMap, k), forceNth(variantMap, vi), slotFields, sv, memberTag)
  let tagStage: List<RParam> = list1(RpIntEqConst(tag, memberTag))
  ret GEntry(sel.selNeedsVariantTest
               ? list2(tagStage, taggedVariantGuards(sel.selHolder, forceNth(variantMap, vi), slotFields, sv, pattern, r))
               : list1(tagStage),
             value)

# The slot values with the discriminator LAST. Not a list utility: the tag's
# position IS its position in the union struct, so this names the layout rule
# rather than the list operation that implements it.
fun withTagField(values: List<RpNamedValue>, tag: Int): List<RpNamedValue> =>
  append(values, RpNamedValue("$tag", RpInteger(tag, 32)))

fun combinationUnionValueTagged(narrowCtype, narrowSlots: List<CgSlotEntry>, wideSlots: List<CgSlotEntry>,
                                slotFields: List<CgField>, sv, memberTag)
  let namedValues = withTagField(zipSlotFields(narrowSlots, wideSlots,
                                     forceFields(narrowCtype), slotFields, sv),
                                 memberTag)
  ret unionStruct(narrowCtype, namedValues)

# The primitive of type `orig` held in slot `si` of the union value `sv`: the
# slot itself, or — where a smaller integer was merged into a larger slot
# (cgComputeUnionSlots) — the slot narrowed back to it (union_repr.py
# slot_read). Every read of a union slot goes through here; only integers
# merge, so any other primitive is always read from a slot of its own type.
fun slotRead(sv, slotFields: List<CgField>, si: Int, orig: CgType): RParam => match(listAt(slotFields, si))
  (f: CgField) => eqCgType(orig, f.fieldType)
    ? RpStructField(sv, f.fieldName)
    : RpNarrowInt(RpStructField(sv, f.fieldName), orig)
  ()            => RpNullPointer()   # unreachable: every slot index names a slot

fun zipSlotFields(narrowSlots: List<CgSlotEntry>, wideSlots: List<CgSlotEntry>, narrowFields: List<CgField>,
                  wideSlotFields: List<CgField>, sv)
  ret zipSlotFieldsLoop(narrowSlots, wideSlots, narrowFields, wideSlotFields, sv, List())

fun zipSlotFieldsLoop(ns: List<CgSlotEntry>, ws: List<CgSlotEntry>, narrowFields: List<CgField>,
                             wideSlotFields: List<CgField>, sv, acc: List<RpNamedValue>) =>
  zipFold(ns, ws, acc,
          (a, n, w) => append(a, RpNamedValue(fieldNameAt(narrowFields, n.slotIndex),
                                              slotRead(sv, wideSlotFields, w.slotIndex, w.origType))))

# A pattern naming only some of an enum member's variants tests the member,
# then the variant; one holding several members enters once per member, each
# binding that member's value.
fun combinationPlainArm(em: GEmit, arm: PArm, armType: Spec, sv, tag, members: List<Spec>,
                        variantMap: List<List<CgSlotEntry>>, slotFields: List<CgField>,
                        discs: Dict<String, Int>, resultType, r)
  let selected = taggedSelections(members, armType)
  ret match(soleSelection(selected))
    (sel: Selection) => combinationSoleArm(em, arm, armType, sel, sv, tag, variantMap, slotFields, discs, resultType, r)
    ()                     => isEmpty(selected)
      ? em   # check() validated coverage; skip defensively
      : emMultiEntryArm(em, r, resultType, arm,
                        map(selected, (sel) => combinationHeldEntry(sel, armType, sv, tag, variantMap, slotFields, discs, r)),
                        specGenerate(armType, r))

fun combinationSoleArm(em: GEmit, arm: PArm, armType, sel: Selection, sv, tag,
                       variantMap: List<List<CgSlotEntry>>, slotFields: List<CgField>,
                       discs: Dict<String, Int>, resultType, r)
  let slots = forceNth(variantMap, sel.selIndex)
  let tagStage: List<RParam> = list1(RpIntEqConst(tag, getOr0(discs, uid(sel.selHolder))))
  ret emArm(em, r, resultType, arm,
            sel.selNeedsVariantTest
              ? list2(tagStage, taggedVariantGuards(sel.selHolder, slots, slotFields, sv, armType, r))
              : list1(tagStage),
            bindFromSlots(r, arm, specGenerate(sel.selHolder, r), slots, slotFields, sv), List())

# One entry of an arm holding several members: that member's tag, and its
# value reassembled at the arm's type (every level shares one representation).
fun combinationHeldEntry(sel: Selection, armType, sv, tag, variantMap: List<List<CgSlotEntry>>,
                         slotFields: List<CgField>, discs: Dict<String, Int>, r): GEntry =>
  GEntry(list1(list1(RpIntEqConst(tag, getOr0(discs, uid(sel.selHolder))))),
         reconstructFromSlots(specGenerate(armType, r), forceNth(variantMap, sel.selIndex), slotFields, sv, 0).rfValue)

# ── pointer union ────────────────────────────────────────────────────────

class [final] MemberClassification(mcNullArm: PArm|None, mcForeignFallback: PArm|None,
                                   mcGuarded: List<PArm>, mcUnionArmCoversNone: Bool)

fun classifyPointerArms(arms: List<PArm>, r): MemberClassification =>
  fold(arms, MemberClassification(None, None, List(), false), (mc, arm) => classifyPointerArm(mc, arm, r))

# The guarded arms keep their source order — match arms are tested in order,
# so this order is the semantics, not a convenience.
fun classifyPointerArm(mc: MemberClassification, arm: PArm, r): MemberClassification
  if !isEmpty(arm.armLiterals)
    ret with mc(mcGuarded = append(mc.mcGuarded, arm))
  ret match(arm.armType)
    (t2: Spec) => eqCgType(specGenerate(t2, r), CgStruct(List()))
      ? with mc(mcNullArm = arm)
      : classifyPointerArmNonNull(mc, arm, t2, r)
    ()         => mc

fun classifyPointerArmNonNull(mc: MemberClassification, arm: PArm, t2, r) => match(t2)
  (c: SClass) => classSpecIsForeign(c, r)
    ? with mc(mcForeignFallback = arm)
    : with mc(mcGuarded = append(mc.mcGuarded, arm))
  (cm: SCombination) => with mc(mcGuarded = append(mc.mcGuarded, arm),
                                mcUnionArmCoversNone = mc.mcUnionArmCoversNone || combinationCoversNone(cm, r))
  (o: Spec)          => with mc(mcGuarded = append(mc.mcGuarded, arm))

fun combinationCoversNone(cm, r)
  ret any(reprMembersOf(unionMembers(cm)), (m) => eqCgType(specGenerate(m, r), CgStruct(List())))

fun isNoneArm(a: PArm|None) => match(a)
  (x: PArm) => false
  ()         => true

fun armTypeOr(arm: PArm, fallback): Spec => match(arm.armType)
  (t2: Spec) => t2
  ()          => fallback

# A member's guard; the unit member's NULL test is routed separately.
fun memberGuard(gp: GPointer, member, sv, r): RParam|None
  ret eqCgType(specGenerate(member, r), CgStruct(List())) ? None : ptrGuard(gp, member, sv, r)

# The stages testing that this union's value holds `pattern`, one member of
# an arm's union pattern: the member's guard (NULL for the unit member) —
# then, when `pattern` names only some of an enum member's variants, the
# variant.
fun ptrMemberStages(gp: GPointer, pattern, value, word, r): List<List<RParam>>
  let whole = narrowedMember(gp.grpType, pattern)
  let memberStage = list1(guardOrNever(ptrGuard(gp, whole, word, r)))
  ret narrowsUnionMember(gp.grpType, pattern)
    ? list2(memberStage, ptrVariantGuards(gp, whole, value, pattern, r))
    : list1(memberStage)

# OR-alternatives testing that the enum `member` this union holds is one of
# `armType`'s variants. A pointer union's enum member is a complex enum, told
# apart by its variant's vtable.
fun ptrVariantGuards(gp: GPointer, member, value, armType, r): List<RParam> => match(classifyRepr(member, r))
  (gc: GComplexEnum) => guardsOrNever(complexPositionGuards(gc, ptrMemberValue(gp, member, value, r), armType, r))
  (o: GRepr)         => guardsOrNever(None)   # unreachable: a flat enum is no pointer word

# Bind an arm to the subject seen at `boundType` (ptrAs).
fun ptrBind(gp: GPointer, r, arm: PArm, boundType, value): GBind|None
  ret bindSubject(r, arm, boundType, ptrAs(gp, value, boundType, r))

# Pointer-union dispatch: the dispatch word == NULL → the None arm; typed arms
# test vtable identity / pointer tag bits / spare codes (ptrGuard); literal
# arms test kind then value; at most one foreign class acts as the implicit
# fallback (untestable from generated code).
fun generatePointerMatch(em0, resultType: Spec|None, subjBundle: GBundle, gp: GPointer,
                        arms: List<PArm>, elseArm: PArm|None, r): GEmit
  let subjType = gp.grpType
  let value = mustResult(subjBundle)
  let sv = ptrWord(gp, value)          # the dispatch word every guard reads
  let subjHasNone = any(reprMembersOf(unionMembers(subjType)), (v) => eqCgType(specGenerate(v, r), CgStruct(List())))
  let cls = classifyPointerArms(arms, r)
  let em1 = genPointerNullRouting(em0, r, resultType, gp, value, sv, cls, elseArm, subjHasNone)
  # The LAST arm needs no test when the earlier arms and the NULL route have
  # taken every member but the ones it covers (union_repr.py _implied_last).
  let implied = ptrImpliedLast(gp, cls.mcGuarded, !isNoneArm(cls.mcNullArm),
                               isNoneArm(cls.mcForeignFallback) && isNoneArm(elseArm), r)
  let guarded = match(implied)
    (ia: PArm) => dropLastOne(cls.mcGuarded)
    ()          => cls.mcGuarded
  let em2 = fold(guarded, em1, (acc, arm) => genPointerGuardedArm(acc, r, resultType, arm, gp, value, sv))
  let finalFallback = match(implied)
    (ia: PArm) => implied
    ()          => match(cls.mcForeignFallback)
      (ff: PArm) => cls.mcForeignFallback
      ()          => elseArm
  let bind = match(finalFallback)
    (fb: PArm) => ptrBind(gp, r, fb, armTypeOr(fb, subjType), value)
    ()          => None
  ret emFallback(em2, r, resultType, finalFallback, bind, "pointer-union match fell through all arms")

# The last guarded arm, when it covers every member the arms before it (and
# the NULL route) leave — so it can be reached untested — else None. Only plain
# typed arms qualify: a literal or guarded arm does not cover its type, and a
# tagged sub-union arm narrows per member.
fun ptrImpliedLast(gp: GPointer, guarded: List<PArm>, nullRouted: Bool,
                   noFallback: Bool, r): PArm|None
  if !noFallback || any(guarded, (a) => !isEmpty(a.armLiterals) || hasGuard(a))
    ret None
  ret match(head(takeLastOne(guarded)))
    (l: PArm) => ptrImpliedCheck(gp, guarded, l, nullRouted, r)
    ()         => None

fun ptrImpliedCheck(gp: GPointer, guarded: List<PArm>, l: PArm, nullRouted: Bool, r): PArm|None
  ret match(l.armType)
    (t2: Spec) => ptrArmNarrowsTagged(t2, r) ? None : ptrImpliedCover(gp, guarded, l, t2, nullRouted, r)
    ()          => None

fun ptrArmNarrowsTagged(t2: Spec, r): Bool => match(t2)
  (cm: SCombination) => match(classifyRepr(cm, r))
    (np: GPointer) => false
    (o: GRepr)     => true
  (o: Spec)          => false

fun ptrImpliedCover(gp: GPointer, guarded: List<PArm>, l: PArm, t2: Spec,
                    nullRouted: Bool, r): PArm|None
  let all0 = ptrKindKeys(gp.grpType, r)
  if contains(all0, "NONE") || contains(all0, "FOREIGN")
    ret None
  let all1 = nullRouted ? remove(all0, "UNIT") : all0
  let rem = fold(dropLastOne(guarded), all1, (a, arm) => fold(ptrArmKeys(arm, r), a, remove))
  let lastKeys = ptrKindKeys(t2, r)
  ret !isEmpty(rem) && all(rem, (k) => contains(lastKeys, k)) ? l : None

# The members every arm but the last leaves.
fun ptrArmKeys(a: PArm, r): Set<String> => match(a.armType)
  (t2: Spec) => ptrKindKeys(t2, r)
  ()          => Set<String>()

# The pointer-word kinds of a type's members, as comparable keys.
fun ptrKindKeys(spec: Spec, r): Set<String>
  let members = match(spec)
    (cm: SCombination) => reprMembersOf(unionMembers(cm))
    (o: Spec)          => list1(spec)
  ret fold(members, Set<String>(), (acc, m) => add(acc, ptrKindKey(pointerWordKind(m, r))))

fun ptrKindKey(k: PtrKind|None): String => match(k)
  (u: PkUnit)     => "UNIT"
  (i: PkInt)      => "INT"
  (s2: PkStr)     => "STR"
  (sc: PkScalar)  => "SCALAR:" + sc.pkScalar
  (f: PkFun)      => "FUN"
  (c: PkClass)    => "CLASS:" + c.pkName
  (e2: PkEnum)    => "ENUM:" + e2.pkRoot
  (fo: PkForeign) => "FOREIGN"
  ()              => "NONE"

fun genPointerNullRouting(em, r, resultType: Spec|None, gp: GPointer, value, sv,
                          cls: MemberClassification, elseArm: PArm|None, subjHasNone: Bool): GEmit
  ret match(cls.mcNullArm)
    (na: PArm) => emArm(em, r, resultType, na, list1(list1(RpIntEqConst(sv, 0))),
                        ptrBind(gp, r, na, armTypeOr(na, gp.grpType), value), List())
    ()          => (subjHasNone && !cls.mcUnionArmCoversNone)
      ? genPointerNullRoutingToElse(em, r, resultType, gp, value, sv, cls, elseArm)
      : em

fun genPointerNullRoutingToElse(em, r, resultType: Spec|None, gp: GPointer, value, sv,
                                cls: MemberClassification, elseArm: PArm|None): GEmit
  ret match(elseArm)
    (ea: PArm) => isNoneArm(cls.mcForeignFallback)
      ? emGuardToFallback(em, RpIntEqConst(sv, 0))
      : emArm(em, r, resultType, ea, list1(list1(RpIntEqConst(sv, 0))),
              ptrBind(gp, r, ea, armTypeOr(ea, gp.grpType), value), List())
    ()          => em

fun genPointerGuardedArm(em, r, resultType: Spec|None, arm: PArm, gp: GPointer, value, sv): GEmit
  ret !isEmpty(arm.armLiterals)
    ? genPointerLiteralArm(em, arm, gp, value, r, resultType)
    : genPointerGuardedTypedArm(em, r, resultType, arm, gp, value, sv)

fun genPointerGuardedTypedArm(em, r, resultType: Spec|None, arm: PArm, gp: GPointer, value, sv): GEmit
  ret match(arm.armType)
    (cm: SCombination) => genPointerUnionArm(em, r, resultType, arm, cm, gp, value, sv)
    (t2: Spec)         => genPointerPlainArm(em, r, resultType, arm, t2, gp, value, sv)
    ()                 => em   # unreachable: an else arm never ends up in `guarded`

fun genPointerUnionArm(em: GEmit, r, resultType, arm: PArm, cm, gp: GPointer, value, sv): GEmit
  ret match(classifyRepr(cm, r))
    (np: GPointer) => genPointerUnionArmGuarded(em, r, resultType, arm, cm, gp, value, sv)
    (nr: GRepr)    => genPointerUnionArmTagged(em, r, resultType, arm, cm, nr, gp, value, sv)

fun genPointerUnionArmGuarded(em: GEmit, r, resultType, arm: PArm, cm, gp: GPointer, value, sv): GEmit
  let members = reprMembersOf(unionMembers(cm))
  # A member named by some of its variants takes two stages, so each member
  # is its own entry; the value is the same.
  if any(members, (m) => narrowsUnionMember(gp.grpType, m))
    ret emMultiEntryArm(em, r, resultType, arm,
                        map(members, (m) => GEntry(ptrMemberStages(gp, m, value, sv, r), ptrAs(gp, value, cm, r))),
                        specGenerate(cm, r))
  let guards = pointerUnionGuards(gp, members, sv, r, List())
  ret emArm(em, r, resultType, arm, list1(guards), ptrBind(gp, r, arm, cm, value), List())

# A TAGGED sub-union (scalars without a String): one entry per member, each
# narrowed into the arm's own repr.
fun genPointerUnionArmTagged(em: GEmit, r, resultType, arm: PArm, cm, nr, gp: GPointer, value, sv): GEmit
  let entries = map(reprMembersOf(unionMembers(cm)), (m) =>
    GEntry(ptrMemberStages(gp, m, value, sv, r),
           mustResult(reprBoxValue(nr, ptrMemberValue(gp, m, value, r), m, r))))
  ret emMultiEntryArm(em, r, resultType, arm, entries, specGenerate(cm, r))

fun guardOrNever(g2: RParam|None): RParam => match(g2)
  (gg: RParam) => gg
  ()           => RpIntEqConst(RpInteger(0, 32), 1)   # unreachable: collapse rules exclude it

# One guard per union member, in member order — the tests are emitted in this
# order, so it is the order of the generated condition chain.
fun pointerUnionGuards(gp: GPointer, members: List<Spec>, sv, r, acc: List<RParam>) =>
  fold(members, acc, (a, x) => eqCgType(specGenerate(x, r), CgStruct(List()))
    ? append(a, RpIntEqConst(sv, 0))
    : pushMemberGuard(a, memberGuard(gp, x, sv, r)))

fun pushMemberGuard(acc, g2: RParam|None): List<RParam> => match(g2)
  (gg: RParam) => append(acc, gg)
  ()            => acc

# A pattern naming only some of an enum member's variants tests the member,
# then the variant.
fun genPointerPlainArm(em, r, resultType, arm: PArm, t2, gp: GPointer, value, sv)
  let member = narrowedMember(gp.grpType, t2)
  ret match(memberGuard(gp, member, sv, r))
    (g2: RParam) => emArm(em, r, resultType, arm,
                          narrowsUnionMember(gp.grpType, t2)
                            ? list2(list1(g2), ptrVariantGuards(gp, member, value, t2, r))
                            : list1(list1(g2)),
                          ptrBind(gp, r, arm, t2, value), List())
    ()           => em

fun genPointerLiteralArm(em, arm: PArm, gp: GPointer, value, r, resultType: Spec|None): GEmit
  ret match(litTypeNameOfFirst(arm.armLiterals, r))
    (tn: String) => (tn == "str" || tn == "bigint" || isScalarName(tn))
      ? genPointerLiteralArmKind(em, arm, gp, value, r, resultType, tn)
      : em
    ()           => em

fun genPointerLiteralArmKind(em, arm: PArm, gp: GPointer, value, r, resultType, tn): GEmit
  ret match(pointerWordKindBuiltin(SBuiltin(tn, noLine())))
    (k: PtrKind) => match(ptrGuardOf(gp, k, ptrWord(gp, value), r))
      (kg: RParam) => genPointerLiteralArmGuarded(em, arm, literalCompared(gp, value, tn), r, resultType, tn, kg)
      ()           => em
    ()           => em

# What the literal is compared against: the whole value for a String, the
# unpacked payload for a scalar, else the dispatch word.
fun literalCompared(gp: GPointer, value, tn): RParam
  ret tn == "str" ? value : isScalarName(tn) ? ptrUnpack(value, tn) : ptrWord(gp, value)

fun genPointerLiteralArmGuarded(em: GEmit, arm: PArm, compared, r, resultType,
                                typeName, kindGuard)
  let lt = literalAlternativeTests(arm.armLiterals, typeName, compared, r, "lit" + String(em.geCounter))
  ret emArm(em, r, resultType, arm, list2(list1(kindGuard), lt.ltoTests), None, lt.ltoBundles)

# ── complex enum ─────────────────────────────────────────────────────────

fun complexEnumRoot(subjType) => match(subjType)
  (e2: SEnum) => e2.seRoot
  (o: Spec)   => ""   # unreachable

# Every variant has a discriminator by code generation; a missing one is a
# compiler bug.
fun complexLeafId(rootName, leaf, discs: Dict<String, Int>): Int
  let key = "enumleaf(" + enumLeafObjectName(rootName, leaf) + ")"
  ret match(get(discs, key))
    (id: Int) => id
    ()        => abort<Int>("compiler bug: no discriminator for " + key)

fun sortLeavesByComplexId(leaves: List<String>, rootName, discs: Dict<String, Int>): List<String>
  ret fold(leaves, List(), (acc, lf) => insertByComplexId(acc, lf, rootName, discs))

fun insertByComplexId(sorted, lf, rootName, discs: Dict<String, Int>) => match(head(sorted))
  (h: String) => complexLeafId(rootName, lf, discs) < complexLeafId(rootName, h, discs)
    ? prepend(lf, sorted)
    : prepend(h, insertByComplexId(dropOne(sorted), lf, rootName, discs))
  ()           => prepend(lf, List())

fun generateComplexEnumMatch(em0, resultType: Spec|None, subjBundle: GBundle, subjType,
                             arms: List<PArm>, elseArm: PArm|None, r): GEmit
  let sv = mustResult(subjBundle)
  let tag = RpVtableDiscriminator(sv)
  let discs = getDiscriminators(r)
  let rootName = complexEnumRoot(subjType)
  let em1 = complexEnumArms(em0, arms, sv, tag, subjType, rootName, discs, resultType, r)
  let bind = match(elseArm)
    (a: PArm) => bindSubject(r, a, subjType, sv)
    ()         => None
  ret emFallback(em1, r, resultType, elseArm, bind, "enum match fell through all arms")

fun complexEnumArms(em: GEmit, arms: List<PArm>, sv: RParam, tag: RParam, subjType: Spec,
                    rootName: String, discs: Dict<String, Int>, resultType: Spec|None, r: Resolver): GEmit =>
  fold(arms, em,
       (a, x) => isNoneSpec(x.armType) ? a : complexEnumArm(a, x, sv, tag, subjType, rootName, discs, resultType, r))

fun complexEnumArm(em, arm: PArm, sv, tag, subjType, rootName,
                   discs: Dict<String, Int>, resultType: Spec|None, r): GEmit
  ret match(asEnumVariant(arm.armType))
    (armType: SEnum) => complexEnumArmOn(em, arm, tag, subjType, rootName, discs, armType, sv, resultType, r)
    ()           => em   # unreachable: check() requires an enum arm here

fun complexEnumArmOn(em: GEmit, arm: PArm, tag, subjType, rootName, discs: Dict<String, Int>,
                     armType: SEnum, sv, resultType: Spec|None, r): GEmit
  let ordered = sortLeavesByComplexId(armType.seValidLeaves, rootName, discs)
  let guards = map<String, RParam>(ordered, (leaf) => RpIntEqConst(tag, complexLeafId(rootName, leaf, discs)))
  ret emArm(em, r, resultType, arm, list1(guards),
            bindSubject(r, arm, subjectAtArm(subjType, armType, r), sv), List())

# ══════════════════════════════════════════════════════════════════════════
# SECTION 6: box_value (CombinationSpec targets only).
# ══════════════════════════════════════════════════════════════════════════

fun reprBoxValue(rep, value, sourceType, r) => match(rep)
  (gt: GTagged) => taggedBoxValue(gt, value, sourceType, r)
  (gp: GPointer) => pointerBoxValue(gp, value, sourceType, r)
  (gc: GComplexEnum) => bundleValue(value)   # unreachable: Python raises NotImplementedError

fun taggedBoxValue(gt: GTagged, value, sourceType, r)
  let innerCtype = specGenerate(sourceType, r)
  ret eqCgType(innerCtype, gt.grtContainer) ? bundleValue(value) : taggedBoxValueDifferent(gt, value, sourceType, innerCtype, r)

fun taggedBoxValueDifferent(gt: GTagged, value, sourceType, innerCtype, r)
  let su = uid(sourceType)
  ret match(variantIndexOf(reprMembersOf(unionMembers(gt.grtType)), su))
    (vi: Int) => taggedBoxValueAt(gt, value, innerCtype, su, vi, r)
    ()          => bundleValue(value)   # unreachable: caller only boxes an actual member

fun taggedBoxValueAt(gt: GTagged, value, innerCtype, su: String, vi, r)
  let tagValue = getOr0(getDiscriminators(r), su)
  let slotFields = forceFields(gt.grtContainer)
  let slotValues = variantSlots(value, innerCtype, forceNth(gt.grtVariantMap, vi), slotFields)
  let namedValues = withTagField(
      map(slotValues, (p) => RpNamedValue(p.svpName, p.svpValue)),
      tagValue)
  ret bundleValue(unionStruct(gt.grtContainer, namedValues))

# Box a value of `sourceType` into the pointer union: None/unit -> NULL, a
# scalar -> its spare code + payload, a function -> env + code, a single-
# field newtype -> its bare word; a wide union carries a one-word member in
# word 0 of a String value.
fun pointerBoxValue(gp: GPointer, value, sourceType, r)
  ret bundleValue(pointerBoxLeaf(gp, unwrapToPointerWord(value, specGenerate(sourceType, r)), sourceType, r))

# A member's LEAF value (newtype nesting already peeled; ignored for the unit
# member) as a value of this union.
fun pointerBoxLeaf(gp: GPointer, leaf, sourceType, r): RParam
  let innerCtype = specGenerate(sourceType, r)
  if eqCgType(innerCtype, CgStruct(List()))
    ret gp.grpWide ? strWord(RpNullPointer()) : RpNullPointer()
  ret pointerBoxWord(gp, pointerWordKind(sourceType, r), innerCtype, leaf)

# A pointer-union member's LEAF (newtype nesting peeled) read out of a tagged
# union's slots: a function from its two slots (code, environment), any other
# leaf from its one. The unit member has none: NULL stands in, and
# pointerBoxLeaf ignores it.
fun leafFromSlots(member, slotAssignments: List<CgSlotEntry>, slotFields: List<CgField>, sv, r): RParam
  let leafCtype = peeledCtype(specGenerate(member, r))
  ret eqCgType(leafCtype, CgStruct(List()))
    ? RpNullPointer()
    : match(leafCtype)
        (fp: CgFuncPointer) => reconstructFun(slotAssignments, slotFields, sv, 0).rfValue
        (o: CgType)         => reconstructLeaf(slotAssignments, slotFields, sv, 0).rfValue

fun pointerBoxWord(gp: GPointer, kind: PtrKind|None, innerCtype, word): RParam => match(kind)
  (sc: PkScalar) => RpRuntimeInvoke("str_pack_" + scalarC(sc.pkScalar),
                                    RpNewStruct(list2(RpNamedValue("code", RpInteger(scalarCode(sc.pkScalar), 32)),
                                                      RpNamedValue("v", word))),
                                    CgStr(false))
  (f: PkFun)     => RpRuntimeInvoke("str_from_fun", RpNewStruct(list1(RpNamedValue("f", word))), CgStr(false))
  ()             => wideWord(gp, innerCtype, word)

# A wide union carries a one-word member in word 0 of a String value.
fun wideWord(gp: GPointer, innerCtype, word): RParam
  ret gp.grpWide && !eqCgType(peeledCtype(innerCtype), CgStr(false)) ? strWord(word) : word

# ══════════════════════════════════════════════════════════════════════════
# SECTION 7: widen_from (CombinationSpec targets only).
# ══════════════════════════════════════════════════════════════════════════

class [final] WidenOut(woBundles: List<GBundle>, woSources: List<OpPhiSource>)

fun reprWidenFrom(targetRep, srcRep, value, r) => match(targetRep)
  (gt: GTagged) => taggedWidenFrom(gt, srcRep, value, r)
  (gp: GPointer) => pointerWidenFrom(gp, srcRep, value, r)
  (gc: GComplexEnum) => bundleValue(value)   # unreachable: Python raises NotImplementedError

# Both pointer unions share the tag-bit word encoding and every source member
# is a target member, so the value passes through — wrapped in a String
# value when only the target is wide.
fun pointerWidenFrom(gp: GPointer, srcRep, value, r) => match(srcRep)
  (sp: GPointer) => bundleValue(gp.grpWide && !sp.grpWide ? strWord(value) : value)
  (gt: GTagged)  => pointerWidenFromTagged(gp, gt, value, r)
  (o: GRepr)     => bundleValue(value)   # unreachable: Python asserts the source kind

# Widen a tagged union (e.g. Int32|None) into this one: dispatch on the
# source's $tag, read each member's leaf from its slots, box it here, and join the
# boxed values with a Phi. The last exit falls through into the join.
class [final] WidenTAcc(wtJumps: Array<Op>, wtBodies: Array<Op>, wtResults: List<OpPhiSource>)

fun pointerWidenFromTagged(gp: GPointer, src: GTagged, value, r): GBundle
  let acc = widenTLoop(gp, src, reprMembersOf(unionMembers(src.grtType)), 0, value,
                       getDiscriminators(r), r, WidenTAcc(Array<Op>(), Array<Op>(), List()))
  let result = RpStackVar(reprCtype(gp), "widen_result")
  ret GBundle(list1(result),
              pushAll<Op>(pushAll<Op>(acc.wtJumps, acc.wtBodies),
                          arrayOf<Op>(OpLabel("widen_end", Dict()), OpPhi(result, acc.wtResults, Dict()))),
              result, List(), List())

fun [tail] widenTLoop(gp: GPointer, src: GTagged, ms: List<Spec>, k, value,
                      discs: Dict<String, Int>, r, acc: WidenTAcc): WidenTAcc => match(head(ms))
  (m: Spec) => widenTLoop(gp, src, dropOne(ms), k + 1, value, discs, r,
                          widenTStep(gp, src, m, isEmpty(dropOne(ms)), k, value, discs, r, acc))
  ()        => acc

fun widenTStep(gp: GPointer, src: GTagged, member, last: Bool, k, value,
               discs: Dict<String, Int>, r, acc: WidenTAcc): WidenTAcc
  let label = "widen_t" + String(k)
  let jumpIf = OpJumpIf(label, RpIntEqConst(RpStructField(value, "$tag"), getOr0(discs, uid(member))), false, Dict())
  let leaf = leafFromSlots(member, forceNth(src.grtVariantMap, k), forceFields(src.grtContainer), value, r)
  let boxed = pointerBoxLeaf(gp, leaf, member, r)
  ret WidenTAcc(pushAll<Op>(acc.wtJumps, last ? arrayOf<Op>(jumpIf, OpJump(label, Dict())) : arrayOf<Op>(jumpIf)),
                pushAll<Op>(acc.wtBodies, last ? arrayOf<Op>(OpLabel(label, Dict()))
                                               : arrayOf<Op>(OpLabel(label, Dict()), OpJump("widen_end", Dict()))),
                append(acc.wtResults, OpPhiSource(label, boxed)))

fun taggedWidenFrom(gt: GTagged, srcRep, value, r)
  let endLabel = "wide_end"
  let wo = match(srcRep)
    (gp: GPointer) => widenFromPointer(value, gp, gt, endLabel, r)
    (o: GRepr)      => widenFromTagged(value, forceTagged(srcRep), gt, endLabel, r)
  let resultVar = RpStackVar(gt.grtContainer, "wide_result")
  let joinBundle = GBundle(list1(resultVar), arrayOf<Op>(OpLabel(endLabel, Dict()), OpPhi(resultVar, wo.woSources, Dict())), resultVar, List(), List())
  ret bundleJoin(bundleJoinAll(wo.woBundles), joinBundle)

fun forceTagged(rep) => match(rep)
  (gt: GTagged) => gt
  (o: GRepr)    => GTagged(SBuiltin("bool", noLine()), CgVoid(), List(), None)   # unreachable

# Widen a pointer union (one dispatch word; wide ones carry a String payload or
# a spare-coded scalar) to this tagged union: test each source member in turn
# with the source's own guards — the untestable one (a foreign class), if
# any, is the fall-through — and slot its value into the target. Each
# member's exit contributes one tagged-union expression to the Phi. Guarded
# members first (None's NULL test among them), the untestable one last; with
# none untestable the last member is the fall-through.
class [final] WidenPAcc(wpJumps: Array<Op>, wpBodies: Array<Op>, wpSources: List<OpPhiSource>)

fun widenFromPointer(sv, gp: GPointer, gt: GTagged, endLabel, r): WidenOut
  let word = ptrWord(gp, sv)
  let members = reprMembersOf(unionMembers(gp.grpType))
  let ordered = concat(filter(members, (m) => hasPtrGuard(gp, m, word, r)),
                       filter(members, (m) => !hasPtrGuard(gp, m, word, r)))
  let acc = widenPLoop(gp, gt, ordered, 0, sv, word, reprMembersOf(unionMembers(gt.grtType)),
                       getDiscriminators(r), endLabel, r, WidenPAcc(Array<Op>(), Array<Op>(), List()))
  ret WidenOut(list1(bundleOps(pushAll<Op>(acc.wpJumps, acc.wpBodies))), acc.wpSources)

fun hasPtrGuard(gp: GPointer, m, word, r) => match(ptrGuard(gp, m, word, r))
  (g2: RParam) => true
  ()           => false

fun [tail] widenPLoop(gp: GPointer, gt: GTagged, ms: List<Spec>, k, sv, word, targetMembers: List<Spec>,
                      discs: Dict<String, Int>, endLabel, r, acc: WidenPAcc): WidenPAcc => match(head(ms))
  (m: Spec) => widenPLoop(gp, gt, dropOne(ms), k + 1, sv, word, targetMembers, discs, endLabel, r,
                          widenPStep(gp, gt, m, isEmpty(dropOne(ms)), k, sv, word, targetMembers,
                                     discs, endLabel, r, acc))
  ()        => acc

fun widenPStep(gp: GPointer, gt: GTagged, member: Spec, last: Bool, k: Int, sv, word, targetMembers: List<Spec>,
               discs: Dict<String, Int>, endLabel, r, acc: WidenPAcc): WidenPAcc
  let label = "wide_p" + String(k)
  let held = memberHolding(targetMembers, member)
  let mv = ptrMemberValue(gp, member, sv, r)
  let slotValues = match(held)
    (h: HeldMember) => map(variantSlots(mv, specGenerate(member, r), forceNth(gt.grtVariantMap, h.hmIndex),
                                        forceFields(gt.grtContainer)),
                           (p) => RpNamedValue(p.svpName, p.svpValue))
    ()              => List()
  let jump = last ? OpJump(label, Dict())
                  : OpJumpIf(label, guardOrNever(ptrGuard(gp, member, word, r)), false, Dict())
  ret WidenPAcc(push<Op>(acc.wpJumps, jump),
                pushAll<Op>(acc.wpBodies, last ? arrayOf<Op>(OpLabel(label, Dict()))
                                               : arrayOf<Op>(OpLabel(label, Dict()), OpJump(endLabel, Dict()))),
                append(acc.wpSources,
                           OpPhiSource(label, unionStruct(gt.grtContainer,
                                                          withTagField(slotValues, widenedTag(held, discs))))))

class [final] OneWidenOut(owBundles: List<GBundle>, owSource: OpPhiSource)

# The tag of the target member that stores a widened source member. Widening
# is emitted only after assignability, so there always is one (Python
# asserts it); were there not, -1 is a tag no arm tests, so the value falls
# through to a match's abort instead of dispatching as another member.
fun widenedTag(held: HeldMember|None, discs: Dict<String, Int>) => match(held)
  (h: HeldMember) => getOr0(discs, uid(h.hmMember))
  ()              => -1

fun widenFromTagged(sv, srcRep: GTagged, gt: GTagged, endLabel, r)
  let sourceMembers = reprMembersOf(unionMembers(srcRep.grtType))
  let targetMembers = reprMembersOf(unionMembers(gt.grtType))
  let srcTagField = RpStructField(sv, "$tag")
  let discs = getDiscriminators(r)
  # The abort is the LAST bundle: it is where control lands when no source
  # variant matched, so it is pushed after the per-variant walk.
  let step = fold(sourceMembers, (i = 0, acc = WidenAcc(List(), List())),
                  (st, m) => widenFromTaggedStep(st, m, sv, srcRep, gt, targetMembers, srcTagField, discs, endLabel, r)).acc
  ret WidenOut(append(step.waBundles,
                   bundleOp1(OpAbort("container-widening fell through all source variants", Dict()))),
               step.waSources)

# One bundle group and one phi source per source variant, in variant order.
class [final] WidenAcc(waBundles: List<GBundle>,
                               waSources: List<OpPhiSource>)

fun widenFromTaggedStep(st: (i: Int, acc: WidenAcc), m: Spec, sv, srcRep: GTagged, gt: GTagged,
                        targetMembers: List<Spec>, srcTagField, discs: Dict<String, Int>,
                        endLabel, r: Resolver)
  let one = widenFromTaggedOne(m, st.i, sv, srcRep, gt, targetMembers, srcTagField, discs, endLabel, r)
  ret (i = st.i + 1,
       acc = WidenAcc(concat(st.acc.waBundles, one.owBundles), append(st.acc.waSources, one.owSource)))

fun widenFromTaggedOne(srcVar: Spec, i: Int, sv, srcRep: GTagged, gt: GTagged, targetMembers: List<Spec>,
                       srcTagField, discs: Dict<String, Int>, endLabel, r: Resolver)
  let varTag = getOr0(discs, uid(srcVar))
  # Stored in the target member that holds this variant, with that member's
  # tag, not the source's.
  let held = memberHolding(targetMembers, srcVar)
  let tgtTag = widenedTag(held, discs)
  let armLabel = "wide_arm_" + String(i)
  let nextLabel = "wide_next_" + String(i)
  let exitLabel = "wide_exit_" + String(i)
  let srcSlotFields = forceFields(srcRep.grtContainer)
  let tgtSlotFields = forceFields(gt.grtContainer)
  let slotValues = match(held)
    (h: HeldMember) => withTagField(
        zipSlotFields(forceNth(gt.grtVariantMap, h.hmIndex),
                      forceNth(srcRep.grtVariantMap, i), tgtSlotFields,
                      srcSlotFields, sv),
        tgtTag)
    ()          => list1(RpNamedValue("$tag", RpInteger(tgtTag, 32)))
  let bundles = list3(
    bundleOps(arrayOf<Op>(OpJumpIf(armLabel, RpIntEqConst(srcTagField, varTag), false, Dict()), OpJump(nextLabel, Dict()), OpLabel(armLabel, Dict()))),
    bundleOps(arrayOf<Op>(OpLabel(exitLabel, Dict()), OpJump(endLabel, Dict()))),
    bundleOp1(OpLabel(nextLabel, Dict())))
  ret OneWidenOut(bundles, OpPhiSource(exitLabel, unionStruct(gt.grtContainer, slotValues)))

# ══════════════════════════════════════════════════════════════════════════
# SECTION 8: read_field (SEnum targets only).
# ══════════════════════════════════════════════════════════════════════════

fun reprReadField(rep, baseValue, fieldName, r) => match(rep)
  (gt: GTagged) => taggedReadField(gt, baseValue, fieldName, r)
  (gc: GComplexEnum) => complexReadField(gc, baseValue, fieldName, r)
  (gp: GPointer) => RpNullPointer()   # unreachable: Python raises NotImplementedError (not an enum union)

fun taggedReadField(gt: GTagged, baseValue, fieldName, r) => match(gt.grtType)
  (e2: SEnum) => match(soleItem(findType(r, e2.seRoot)))
    (found: Found) => match(found.fStmt)
      (root: PsEnum) => taggedReadFieldOn(gt, e2, root, baseValue, fieldName, r)
      (o: PStmt)     => RpNullPointer()   # unreachable
    ()               => RpNullPointer()   # unreachable
  (o: Spec)   => RpNullPointer()   # unreachable: only ever classified from an SEnum

fun taggedReadFieldOn(gt: GTagged, e2: SEnum, root: PsEnum, baseValue, fieldName, r)
  let leafFieldSets = collectLeafFieldSets(root, List())
  let slotFields = forceFields(gt.grtContainer)
  ret taggedReadFieldLeaves(e2.seAllLeaves, leafFieldSets, 0, e2.seRoot,
                            gt.grtVariantMap, slotFields, baseValue, fieldName, r)

fun [tail] taggedReadFieldLeaves(names: List<String>, leaves: List<List<PStmt>>, leafIdx, rootName,
                                 variantMap: List<List<CgSlotEntry>>,
                                 slotFields: List<CgField>, baseValue, fieldName, r) => match(head(names))
  (n: String) => match(head(leaves))
    (l: List<PStmt>) => match(isBoxedLeaf(r, rootName, n)
                                ? taggedReadFieldBoxed(l, n, rootName, forceNth(variantMap, leafIdx), slotFields, baseValue, fieldName, r)
                                : taggedReadFieldInLeaf(l, 0, forceNth(variantMap, leafIdx), slotFields, baseValue, fieldName, r))
      (found: RParam) => found
      ()               => taggedReadFieldLeaves(dropOne(names), dropOne(leaves), leafIdx + 1, rootName, variantMap, slotFields, baseValue, fieldName, r)
    ()               => RpNullPointer()   # unreachable: leaf names and field sets zip 1:1
  ()          => RpNullPointer()   # unreachable: check() guarantees the field exists on some leaf

# Boxed leaf: the pool holds one pointer to the per-leaf heap object; the
# field lives there under its own name — the complex-leaf read, borrowed per
# variant, with the object pointer read out of the leaf's single slot.
fun taggedReadFieldBoxed(fields: List<PStmt>, leafName, rootName,
                         leafSlots: List<CgSlotEntry>, slotFields: List<CgField>,
                         baseValue, fieldName, r) => match(listAt(leafSlots, 0))
  (e2: CgSlotEntry) => complexReadFieldInLeaf(fields, leafName, rootName,
                           RpStructField(baseValue, fieldNameAt(slotFields, e2.slotIndex)),
                           fieldName, r)
  ()                 => None   # unreachable: a boxed leaf has exactly one slot

fun taggedReadFieldInLeaf(fields: List<PStmt>, offset, leafSlots: List<CgSlotEntry>,
                         slotFields: List<CgField>, baseValue, fieldName: String, r)
  ret taggedReadFieldInLeafLoop(fields, offset, leafSlots, slotFields, baseValue, fieldName, r)

fun taggedReadFieldInLeafLoop(fields: List<PStmt>, offset, leafSlots: List<CgSlotEntry>,
                                     slotFields: List<CgField>, baseValue, fieldName: String, r) => match(head(fields))
  (f: PStmt) => taggedReadFieldStep(f, dropOne(fields), offset, leafSlots, slotFields, baseValue, fieldName, r)
  ()         => None

fun taggedReadFieldStep(field, rest, offset, leafSlots: List<CgSlotEntry>,
                        slotFields: List<CgField>, baseValue, fieldName: String, r) => match(field)
  (l: PsLet) => taggedReadFieldLet(l, rest, offset, leafSlots, slotFields, baseValue, fieldName, r)
  (o: PStmt) => taggedReadFieldInLeafLoop(rest, offset, leafSlots, slotFields, baseValue, fieldName, r)

fun taggedReadFieldLet(l: PsLet, rest, offset, leafSlots: List<CgSlotEntry>,
                       slotFields: List<CgField>, baseValue, fieldName: String, r): RParam|None
  let fieldType = specGenerateOpt(l.lType, r)
  let nPrims = cgFlattenPrimitivesN(fieldType).n
  ret l.lName == fieldName
    ? reconstructFromSlots(fieldType, sliceList(leafSlots, offset, nPrims), slotFields, baseValue, 0).rfValue
    : taggedReadFieldInLeafLoop(rest, offset + nPrims, leafSlots, slotFields, baseValue, fieldName, r)

fun complexReadField(gc: GComplexEnum, baseValue, fieldName, r) => match(gc.grcType)
  (e2: SEnum) => complexReadFieldSpec(e2, baseValue, fieldName, r)
  (o: Spec)   => RpNullPointer()   # unreachable: only ever classified from an SEnum

fun complexReadFieldSpec(e2: SEnum, baseValue, fieldName, r)
  ret match(soleItem(findType(r, e2.seRoot)))
    (found: Found) => match(found.fStmt)
      (root: PsEnum) => complexReadFieldOn(e2, root, baseValue, fieldName, r)
      (o: PStmt)     => RpNullPointer()   # unreachable
    ()               => RpNullPointer()   # unreachable

fun complexReadFieldOn(e2: SEnum, root: PsEnum, baseValue, fieldName, r)
  let leafFieldSets = collectLeafFieldSets(root, List())
  ret complexReadFieldLeaves(e2.seAllLeaves, leafFieldSets, e2.seRoot, baseValue, fieldName, r)

fun [tail] complexReadFieldLeaves(leafNames: List<String>, leafFieldSets: List<List<PStmt>>, rootName,
                                  baseValue, fieldName, r) => match(head(leafNames))
  (n: String) => match(head(leafFieldSets))
    (fs: List<PStmt>) => match(complexReadFieldInLeaf(fs, n, rootName, baseValue, fieldName, r))
      (found: RParam) => found
      ()               => complexReadFieldLeaves(dropOne(leafNames), dropOne(leafFieldSets), rootName, baseValue, fieldName, r)
    ()                => RpNullPointer()   # unreachable: same length as leafNames
  ()          => RpNullPointer()   # unreachable: check() guarantees the field exists on some leaf

fun complexReadFieldInLeaf(fields: List<PStmt>, leafName, rootName, baseValue,
                           fieldName, r) => match(firstWhere(fields, (f) => isLetNamed(f, fieldName)))
  (let2: PsLet) => RpObjectField(specGenerateOpt(let2.lType, r), baseValue, enumLeafObjectName(rootName, leafName), let2.lName, None, false, false)
  ()            => None

fun isLetNamed(st: PStmt, name) => match(st)
  (let2: PsLet) => let2.lName == name
  (o: PStmt)    => false

# ══════════════════════════════════════════════════════════════════════════
# SECTION 9: construct_enum_value (SEnum targets only).
# ══════════════════════════════════════════════════════════════════════════

# pinned: the variant's heap object is born pinned (`new_pinned`; only a
# heap-held variant has one to pin).
fun reprConstructEnumValue(rep, leafName, fieldArgs: List<PunArg>, r, pinned: Bool) => match(rep)
  (gt: GTagged) => taggedConstructEnumValue(gt, leafName, fieldArgs, r, pinned)
  (gc: GComplexEnum) => complexConstructEnumValue(gc, leafName, fieldArgs, r, pinned)
  (gp: GPointer) => emptyBundle()   # unreachable: Python raises NotImplementedError (not an enum union)

fun [tail] indexOfString(xs: List<String>, target, i) => match(head(xs))
  (x: String) => x == target ? i : indexOfString(dropOne(xs), target, i + 1)
  ()           => 0   # unreachable: leafName is always a member (check() guarantees it)

fun [tail] fieldTypeNamed(fields: List<CgField>, name) => match(head(fields))
  (f: CgField) => f.fieldName == name ? f.fieldType : fieldTypeNamed(dropOne(fields), name)
  ()            => CgVoid()   # unreachable: every TaggedRepr container has a $tag field

fun tagPrecision(t) => match(t)
  (i: CgInt)  => i.precision
  (o: CgType) => 32   # unreachable: $tag is always a CgInt

class [final] PrimStart(psName: String, psOffset: Int)

fun primStartsOf(fields: List<PStmt>, offset: Int, r: Resolver, acc: List<PrimStart>) =>
  fold(fields, (offset = offset, acc = acc), (st, x) => primStartsOfStep(st, x, r)).acc

fun primStartsOfStep(st: (offset: Int, acc: List<PrimStart>), x: PStmt, r: Resolver) => match(x)
  (let2: PsLet) => (offset = st.offset + cgFlattenPrimitivesN(specGenerateOpt(let2.lType, r)).n, acc = append(st.acc, PrimStart(let2.lName, st.offset)))
  (o: PStmt) => (offset = st.offset, acc = st.acc)

fun [tail] primStartFor(starts: List<PrimStart>, name) => match(head(starts))
  (p: PrimStart) => p.psName == name ? p.psOffset : primStartFor(dropOne(starts), name)
  ()              => 0   # unreachable: every field arg names a declared field

fun [tail] letNamed(fields: List<PStmt>, name) => match(head(fields))
  (f: PStmt) => stmtName(f) == name ? f : letNamed(dropOne(fields), name)
  ()          => None

fun letTypeOf(st: PStmt|None) => match(asPsLetVariant(st))
  (l: PsLet) => l.lType
  ()          => None

class [final] EmitFlatOut(efSlots: List<RpNamedValue>, efOffset: Int)

fun emitFlat(param, ftype, variantSlots2: List<CgSlotEntry>, slotFields: List<CgField>,
            offset, slots) => match(ftype)
  (fp: CgFuncPointer) => emitFlatFun(param, variantSlots2, slotFields, offset, slots)
  (o: CgType)          => match(cgFieldsOf(ftype))
    (fields: List<CgField>) => emitFlatStruct(param, fields, variantSlots2, slotFields, offset, slots)
    ()                       => emitFlatLeaf(param, variantSlots2, slotFields, offset, slots)

# The closure deconstructs into its code word and environment pointer (the
# enum-encoding principle; union_repr.py construct_enum_value.emit_flat).
fun emitFlatFun(param, variantSlots2: List<CgSlotEntry>, slotFields: List<CgField>,
                offset, slots) => match(listAt(variantSlots2, offset))
  (ef: CgSlotEntry) => match(listAt(variantSlots2, offset + 1))
    (eo: CgSlotEntry) => EmitFlatOut(
        setNamedValueAt(setNamedValueAt(slots,
                            fieldNameAt(slotFields, ef.slotIndex),
                            RpFunField(param, "f")),
                        fieldNameAt(slotFields, eo.slotIndex),
                        RpFunField(param, "o")),
        offset + 2)
    ()                 => EmitFlatOut(slots, offset + 2)   # unreachable
  ()                 => EmitFlatOut(slots, offset + 2)   # unreachable

fun emitFlatLeaf(param, variantSlots2: List<CgSlotEntry>, slotFields: List<CgField>,
                 offset, slots) => match(listAt(variantSlots2, offset))
  (e2: CgSlotEntry) => EmitFlatOut(setNamedValueAt(slots, fieldNameAt(slotFields, e2.slotIndex), param), offset + 1)
  ()                 => EmitFlatOut(slots, offset + 1)   # unreachable

fun emitFlatStruct(param, fields: List<CgField>, variantSlots2: List<CgSlotEntry>, slotFields: List<CgField>,
                   offset, slots)
  # Fold state named (offset, acc) to match reconstructFields — workaround for #88.
  let out = fold(fields, (offset = offset, acc = slots),
                 (st, f) => emitFlatStructStep(st, f, param, variantSlots2, slotFields))
  ret EmitFlatOut(out.acc, out.offset)

fun emitFlatStructStep(st: (offset: Int, acc: List<RpNamedValue>), f: CgField, param,
                       variantSlots2: List<CgSlotEntry>, slotFields: List<CgField>)
  let sub = emitFlat(RpStructField(param, f.fieldName), f.fieldType, variantSlots2, slotFields, st.offset, st.acc)
  ret (offset = sub.efOffset, acc = sub.efSlots)

fun taggedConstructEnumValue(gt: GTagged, leafName, fieldArgs: List<PunArg>, r, pinned: Bool) => match(gt.grtType)
  (e2: SEnum) => taggedConstructEnumValueOn(gt, e2, leafName, fieldArgs, r, pinned)
  (o: Spec)   => emptyBundle()   # unreachable: only ever classified from an SEnum

fun taggedConstructEnumValueOn(gt: GTagged, e2: SEnum, leafName, fieldArgs: List<PunArg>, r, pinned: Bool)
  ret match(soleItem(findType(r, e2.seRoot)))
    (found: Found) => match(found.fStmt)
      (root: PsEnum) => taggedConstructEnumValueRoot(gt, e2, root, leafName, fieldArgs, r, pinned)
      (o: PStmt)     => emptyBundle()   # unreachable
    ()                => emptyBundle()   # unreachable

fun taggedConstructEnumValueRoot(gt: GTagged, e2: SEnum, root: PsEnum, leafName, fieldArgs: List<PunArg>, r, pinned: Bool)
  let leafIdx = indexOfString(e2.seAllLeaves, leafName, 0)
  let leafFields = forceNth(collectLeafFieldSets(root, List()), leafIdx)
  let container = gt.grtContainer
  let slotFields = forceFields(container)
  let zeroSlots = map(slotFields, (f) => RpNamedValue(f.fieldName, RpZeroOf(f.fieldType)))
  # Every slot the variant does not fill stays zero — NULL, which is what
  # names the variant when there is no $tag.
  let taggedSlots = gt.grtNullTests is None
    ? setNamedValueAt(zeroSlots, "$tag", RpInteger(leafIdx, tagPrecision(fieldTypeNamed(slotFields, "$tag"))))
    : zeroSlots
  if isBoxedLeaf(r, e2.seRoot, leafName)
    ret taggedConstructBoxed(e2, leafFields, leafName, fieldArgs,
                             forceNth(gt.grtVariantMap, leafIdx),
                             slotFields, taggedSlots, container, r, pinned)
  let primStarts = primStartsOf(leafFields, 0, r, List())
  let variantSlots2 = forceNth(gt.grtVariantMap, leafIdx)
  let step = fold(fieldArgs, (slots = taggedSlots, bundles = List<GBundle>()),
                  (st, a) => taggedConstructFieldsStep(st, a, leafFields, primStarts, variantSlots2, slotFields, r))
  ret bundleJoin(bundleJoinAll(step.bundles), bundleValue(unionStruct(container, step.slots)))

# Boxed leaf (payload over the value-struct threshold): allocate the
# per-leaf heap object — the complex-leaf construction, borrowed per
# variant, ZeroOf for unwritten fields so staticinit can promote
# all-constant constructions — then the pool carries the pointer in the
# leaf's single slot, tagged as usual. Field args coerce into their
# declared types (genExprTo), exactly as the flat path does.
fun taggedConstructBoxed(e2: SEnum, leafFields: List<PStmt>, leafName,
                         fieldArgs: List<PunArg>, variantSlots2: List<CgSlotEntry>,
                         slotFields: List<CgField>, taggedSlots: List<RpNamedValue>,
                         container, r, pinned: Bool)
  let objName = enumLeafObjectName(e2.seRoot, leafName)
  let objVar = RpStackVar(CgDataPointer(false), "boxed")
  let step = bxConstructFields(leafFields, objName, objVar, fieldArgs, r,
                               CcAcc(arrayOf<Op>(OpNewObject(objName, objVar, None, pinned, Dict())), List()))
  let allocBundle = GBundle(list1(objVar), step.ccOps, objVar, List(), List())
  ret match(listAt(variantSlots2, 0))
    (se: CgSlotEntry) => bundleJoin(bundleJoinAll(step.ccBundles),
                             bundleJoin(allocBundle,
                                 bundleValue(unionStruct(container,
                                     setNamedValueAt(taggedSlots,
                                                     fieldNameAt(slotFields, se.slotIndex),
                                                     objVar)))))
    ()                 => emptyBundle()   # unreachable: a boxed leaf has exactly one slot

# complexConstructFields with genExprTo: the flat construct path coerces
# each argument into the field's declared type, and the boxed borrow keeps
# that behaviour (Python taggedConstruct's generate_to).
fun [tail] bxConstructFields(fields: List<PStmt>, objName, resultVar,
                             fieldArgs: List<PunArg>, r, acc: CcAcc) => match(head(fields))
  (let2: PsLet) => bxConstructField(let2, dropOne(fields), objName, resultVar, fieldArgs, r, acc)
  (o: PStmt)    => bxConstructFields(dropOne(fields), objName, resultVar, fieldArgs, r, acc)
  ()            => ComplexConstructOut(acc.caOps, acc.caBundles)

fun bxConstructField(let2: PsLet, rest, objName, resultVar,
                     fieldArgs: List<PunArg>, r, acc: CcAcc)
  let fieldType = specGenerateOpt(let2.lType, r)
  ret match(punArgNamed(fieldArgs, let2.lName))
    (pa: PunArg) => bxConstructFieldArg(pa, let2, fieldType, rest, objName,
                                        resultVar, fieldArgs, r, acc)
    ()            => bxConstructFields(rest, objName, resultVar, fieldArgs, r,
                       CcAcc(push<Op>(acc.caOps,
                                 OpMove(RpObjectField(fieldType, resultVar,
                                            objName, let2.lName, None, true, false),
                                        RpZeroOf(fieldType), false,
                                        Dict())),
                             acc.caBundles))

fun bxConstructFieldArg(pa: PunArg, let2: PsLet, fieldType, rest, objName,
                        resultVar, fieldArgs: List<PunArg>, r, acc: CcAcc)
  let argBundle = withPrefix(genExprTo(pa.paExpr, r, let2.lType), "arg_" + bareName(let2.lName))
  ret bxConstructFields(rest, objName, resultVar, fieldArgs, r,
          CcAcc(push<Op>(acc.caOps,
                    OpMove(RpObjectField(fieldType, resultVar, objName, let2.lName, None, true, false),
                           mustResult(argBundle), false, Dict())),
                append(acc.caBundles, argBundle)))

fun taggedConstructFieldsStep(st: (slots: List<RpNamedValue>, bundles: List<GBundle>), a: PunArg,
                              leafFields: List<PStmt>, primStarts: List<PrimStart>,
                              variantSlots2: List<CgSlotEntry>, slotFields: List<CgField>, r)
  let fieldName = a.paName
  let fieldType = letTypeOf(letNamed(leafFields, fieldName))
  let argBundle = withPrefix(genExprTo(a.paExpr, r, fieldType), "arg_" + bareName(fieldName))
  let pi = primStartFor(primStarts, fieldName)
  let ef = emitFlat(mustResult(argBundle), specGenerateOpt(fieldType, r), variantSlots2, slotFields, pi, st.slots)
  ret (slots = ef.efSlots, bundles = append(st.bundles, argBundle))

fun complexConstructEnumValue(gc: GComplexEnum, leafName, fieldArgs: List<PunArg>, r, pinned: Bool)
  ret match(gc.grcType)
    (e2: SEnum) => complexConstructEnumValueOn(e2, leafName, fieldArgs, r, pinned)
    (o: Spec)   => emptyBundle()   # unreachable

fun complexConstructEnumValueOn(e2: SEnum, leafName, fieldArgs: List<PunArg>, r, pinned: Bool)
  ret match(soleItem(findType(r, e2.seRoot)))
    (found: Found) => match(found.fStmt)
      (root: PsEnum) => complexConstructEnumValueRoot(e2, root, leafName, fieldArgs, r, pinned)
      (o: PStmt)     => emptyBundle()   # unreachable
    ()                => emptyBundle()   # unreachable

fun complexConstructEnumValueRoot(e2: SEnum, root: PsEnum, leafName, fieldArgs: List<PunArg>, r, pinned: Bool)
  let leafIdx = indexOfString(e2.seAllLeaves, leafName, 0)
  let leafFields = forceNth(collectLeafFieldSets(root, List()), leafIdx)
  let objName = enumLeafObjectName(e2.seRoot, leafName)
  let resultVar = RpStackVar(CgDataPointer(false), "result")
  let step = complexConstructFields(leafFields, objName, resultVar,
                                    fieldArgs, r,
                                    CcAcc(arrayOf<Op>(OpNewObject(objName, resultVar, None, pinned, Dict())), List()))
  let ctorBundle = GBundle(list1(resultVar), step.ccOps, resultVar, List(), List())
  ret bundleJoin(bundleJoinAll(step.ccBundles), ctorBundle)

class [final] ComplexConstructOut(ccOps: Array<Op>, ccBundles: List<GBundle>)

# Both while they are being built: the allocation then the field stores in
# program order, and the argument bundles in the order they are emitted.
class [final] CcAcc(caOps: Array<Op>,
                            caBundles: List<GBundle>)

fun [tail] complexConstructFields(fields: List<PStmt>, objName, resultVar, fieldArgs: List<PunArg>,
                                  r, acc: CcAcc) => match(head(fields))
  (let2: PsLet) => complexConstructField(let2, dropOne(fields), objName, resultVar,
                                        fieldArgs, r, acc)
  (o: PStmt)    => complexConstructFields(dropOne(fields), objName, resultVar, fieldArgs, r, acc)
  ()            => ComplexConstructOut(acc.caOps, acc.caBundles)

fun complexConstructField(let2: PsLet, rest, objName, resultVar, fieldArgs: List<PunArg>,
                          r, acc: CcAcc)
  let fieldType = specGenerateOpt(let2.lType, r)
  ret match(punArgNamed(fieldArgs, let2.lName))
    (pa: PunArg) => complexConstructFieldWithArg(pa, let2, fieldType, rest,
                        objName, resultVar, fieldArgs, r, acc)
    # No argument for this field: it is zero-filled in place.
    ()            => complexConstructFields(rest, objName, resultVar, fieldArgs, r,
                       CcAcc(push<Op>(acc.caOps,
                                 OpMove(RpObjectField(fieldType, resultVar,
                                            objName, let2.lName, None, true, false),
                                        RpZeroOf(fieldType), false,
                                        Dict())),
                             acc.caBundles))

fun complexConstructFieldWithArg(pa: PunArg, let2: PsLet, fieldType, rest, objName,
                                 resultVar, fieldArgs: List<PunArg>, r, acc: CcAcc)
  let argBundle = withPrefix(genExpr(pa.paExpr, r), "arg_" + bareName(let2.lName))
  ret complexConstructFields(rest, objName, resultVar, fieldArgs, r,
          CcAcc(push<Op>(acc.caOps,
                    OpMove(RpObjectField(fieldType, resultVar, objName, let2.lName, None, true, false),
                           mustResult(argBundle), false, Dict())),
                append(acc.caBundles, argBundle)))

fun [tail] punArgNamed(args: List<PunArg>, name) => match(head(args))
  (a: PunArg) => a.paName == name ? a : punArgNamed(dropOne(args), name)
  ()           => None
