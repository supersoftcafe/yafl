# bootstrap/union_repr.yafl — how a union type is represented and operated
# on, ported from compiler/pyast/union_repr.py.
#
# A "union" is either an ad-hoc SCombination (A|B|None) or a declared SEnum
# (itself a union of variants). `classify` decides ONCE which of three
# representations it uses; the returned GRepr owns every representation-
# specific operation (ctype/generate_match/box_value/widen_from/read_field/
# construct_enum_value) so callers never re-derive the decision:
#
#   GTagged      by-value {$s0.., $tag} struct. Non-collapsing SCombination
#                and flat (non-complex) SEnum.
#   GPointer     one DataPointer word; None=NULL, every other member
#                dispatches by pointer tag/vtable. Collapsing SCombination.
#   GComplexEnum DataPointer + per-variant heap objects, dispatch by
#                vtable.discriminator. Complex SEnum.
#
# Drives generate_expr2.yafl's GEmit (emArm/emMultiEntryArm/emFallback/
# emGuardToFallback/bindSubject/bindFromSlots) for generate_match, exactly as
# match.py's _Emitter does.
namespace Bootstrap::Codegen

import System

import Bootstrap::Ast
import Bootstrap::Frontend
import Bootstrap::Ir
import Bootstrap::Parse
import Bootstrap::Resolve
import Bootstrap::StdlibCandidates
import Bootstrap::Types



# ══════════════════════════════════════════════════════════════════════════
# SECTION 0: enum-declaration helpers (specs.py's collect_enum_leaves /
# _collect_leaf_field_sets / enum_variant_types / enum_leaf_object_name —
# none of these were ported before this task either).
# ══════════════════════════════════════════════════════════════════════════

# One field list per leaf, including fields inherited from ancestor nodes
# (a field declared on a parent enum node is inherited by every descendant
# leaf).
fun collectLeafFieldSets(st: PsEnum, inherited: List<PStmt>): List<List<PStmt>>
  let own = filterDeclaredFields(chain(flattenParams(st.eParams)), List<PStmt>())
  let combined = concat(inherited, own)
  ret isEmpty(st.eVariants)
    ? (st.eHasParams ? list1(combined) : List<List<PStmt>>())
    : collectLeafFieldSetsVariants(chain(st.eVariants), combined, List<List<PStmt>>())

fun filterDeclaredFields(ps: Chain<PStmt>, acc: List<PStmt>): List<PStmt>
  ret build<PStmt >(filterDeclaredFieldsB(ps, builderFrom<PStmt>(acc)))

fun [tail] filterDeclaredFieldsB(ps: Chain<PStmt>, [terminal] acc: ListBuilder<PStmt >): ListBuilder<PStmt >
  ret match(ps)
    (nil: ChainEnd) => acc
    (l: ChainLink)  => match(l.value)
      (let2: PsLet) => isSome(let2.lType) ? filterDeclaredFieldsB(l.next, push<PStmt >(acc, l.value)) : filterDeclaredFieldsB(l.next, acc)
      (o: PStmt)    => filterDeclaredFieldsB(l.next, acc)

fun [tail] collectLeafFieldSetsVariants(vs: Chain<PStmt>, combined: List<PStmt>, acc: List<List<PStmt>>): List<List<PStmt>>
  ret match(vs)
    (nil: ChainEnd) => acc
    (l: ChainLink)  => match(l.value)
      (v: PsEnum) => collectLeafFieldSetsVariants(l.next, combined, concat(acc, collectLeafFieldSets(v, combined)))
      (o: PStmt)  => collectLeafFieldSetsVariants(l.next, combined, acc)

# One type per leaf variant: the Struct of all fields accessible to that
# leaf — or a bare DataPointer for a BOXED leaf (the enum-encoding
# principle: a payload over the value-struct threshold is a heap object
# everywhere it appears, so it occupies one pointer slot here).
fun enumVariantTypes(st: PsEnum, r: Resolver): List<CgType>
  ret match(asEnumVariant(st.eSpec))
    (sp: SEnum) => evtLoop(chain(sp.seAllLeaves),
                           chain(collectLeafFieldSets(st, List<PStmt>())),
                           st.eName, r, List<CgType>())
    ()           => map(collectLeafFieldSets(st, List<PStmt>()),
                        (fields: List<PStmt>) => CgStruct(letFieldsToCgFields(fields, r)))

fun [tail] evtLoop(names: Chain<String>, sets: Chain<List<PStmt>>,
                   rootName: String, r: Resolver, acc: List<CgType>): List<CgType>
  ret match(names)
    (nil: ChainEnd) => acc
    (l: ChainLink)  => match(sets)
      (nil2: ChainEnd) => acc   # unreachable: leaf names and field sets zip 1:1
      (s2: ChainLink)  => evtLoop(l.next, s2.next, rootName, r,
          concat(acc, list1<CgType>(isBoxedLeaf(r, rootName, l.value)
                                      ? CgDataPointer()
                                      : CgStruct(letFieldsToCgFields(s2.value, r)))))

fun letFieldsToCgFields(fields: List<PStmt>, r: Resolver): List<CgField>
  ret map(fields, (st: PStmt) => letFieldToCgField(st, r))

fun letFieldToCgField(st: PStmt, r: Resolver): CgField
  ret match(st)
    (l: PsLet) => CgField(l.lName, specGenerateOpt(l.lType, r))
    (o: PStmt) => CgField("", CgVoid())   # unreachable: filterDeclaredFields only keeps PsLet

# The per-variant Object/vtable name for a complex-enum leaf: qualify with the
# root's `$generic$` suffix (already-suffixed names untouched).
fun enumLeafObjectName(rootName: String, leafName: String): String
  ret (contains(leafName, "$generic$") || !contains(rootName, "$generic$"))
    ? leafName
    : leafName + "$generic$" + suffixAfter(rootName, "$generic$")

fun suffixAfter(s: String, sep: String): String
  ret join(tail<String>(split(s, sep)), sep)

fun baseName(name: String): String
  ret match(head<String>(split(name, "$generic$")))
    (first: String) => first
    ()               => name

# ══════════════════════════════════════════════════════════════════════════
# SECTION 1: small generic list helpers reused throughout this file.
# ══════════════════════════════════════════════════════════════════════════

# forceNth<T> (generate_expr.yafl) and fieldNameAt (generate_expr2.yafl) are
# reused as-is from those files (same one-namespace program).

fun forceFields(t: CgType): List<CgField>
  ret match(cgFieldsOf(t))
    (fields: List<CgField>) => fields
    ()                       => List<CgField>()   # unreachable: a TaggedRepr container is always a Struct

fun getOr0(d: Dict<String, Int>, key: String): Int
  ret match(get(d, key))
    (v: Int) => v
    ()        => 0

fun globalMaxTag(r: Resolver): Int
  ret maxOr(values(getDiscriminators(r)), 0)

fun takeList<T>(l: List<T>, n: Int): List<T>
  ret (n <= 0) ? List<T>() : match(head<T>(l))
    (h: T) => prepend<T>(h, takeList<T>(tail<T>(l), n - 1))
    ()      => List<T>()

fun sliceList<T>(l: List<T>, start: Int, len2: Int): List<T>
  ret takeList<T>(drop<T>(l, start), len2)

fun variantIndexOf(members: List<Spec>, u: String): Int|None
  ret variantIndexLoop(chain(members), u, 0)

fun [tail] variantIndexLoop(ms: Chain<Spec>, u: String, i: Int): Int|None
  ret match(ms)
    (nil: ChainEnd) => None
    (l: ChainLink)  => uid(l.value) == u ? i : variantIndexLoop(l.next, u, i + 1)

fun setNamedValueAt(vs: List<RpNamedValue>, name: String, v: RParam): List<RpNamedValue>
  ret map(vs, (nv: RpNamedValue) => nv.name == name ? RpNamedValue(name, v) : nv)

# ══════════════════════════════════════════════════════════════════════════
# SECTION 2: literal_eq_test / literal_range_test / literal_alternative_tests
# live in generate_expr2.yafl alongside GEmit (shared by all three match
# generators, and by MatchExpression's own primitive-subject path).
# ══════════════════════════════════════════════════════════════════════════

# ══════════════════════════════════════════════════════════════════════════
# SECTION 3: pointer-word kind (_pointer_word_kind / _classspec_is_foreign /
# _union_collapses_to_pointer / _unwrap_to_pointer_word / _variant_slots).
# ══════════════════════════════════════════════════════════════════════════

enum PtrKind
  enum PkUnit()
  enum PkInt()
  enum PkStr()
  enum PkClass(pkName: String)
  enum PkEnum(pkRoot: String)
  enum PkForeign()

fun eqPtrKind(a: PtrKind, b: PtrKind): Bool
  ret match(a)
    (x: PkUnit)    => isUnitKind(b)
    (x: PkInt)     => isIntKind(b)
    (x: PkStr)     => isStrKind(b)
    (x: PkForeign) => isForeignKind(b)
    (x: PkClass)   => match(b)
      (y: PkClass) => x.pkName == y.pkName
      (o: PtrKind) => false
    (x: PkEnum)    => match(b)
      (y: PkEnum)  => x.pkRoot == y.pkRoot
      (o: PtrKind) => false

fun isUnitKind(k: PtrKind): Bool
  ret match(k)
    (u: PkUnit)  => true
    (o: PtrKind) => false

fun isIntKind(k: PtrKind): Bool
  ret match(k)
    (i: PkInt)   => true
    (o: PtrKind) => false

fun isStrKind(k: PtrKind): Bool
  ret match(k)
    (s2: PkStr)  => true
    (o: PtrKind) => false

fun isForeignKind(k: PtrKind): Bool
  ret match(k)
    (f: PkForeign) => true
    (o: PtrKind)   => false

fun classSpecIsForeign(c: SClass, r: Resolver): Bool
  ret anyFoundIsForeignClass(chain(findType(r, c.scName).bItems))

fun [tail] anyFoundIsForeignClass(fs: Chain<Found>): Bool
  ret match(fs)
    (nil: ChainEnd) => false
    (l: ChainLink)  => match(l.value.fStmt)
      (cs: PsClass) => hasAttr(cs.cAttrs, "foreign") ? true : anyFoundIsForeignClass(l.next)
      (o: PStmt)    => anyFoundIsForeignClass(l.next)

fun pointerWordKind(member: Spec, r: Resolver): PtrKind|None
  ret eqCgType(specGenerate(member, r), CgStruct(List<CgField>()))
    ? PkUnit()
    : pointerWordKindNonUnit(member, r)

fun pointerWordKindNonUnit(member: Spec, r: Resolver): PtrKind|None
  ret match(member)
    (t2: STuple) => pointerWordKindTuple(t2, r)
    (b: SBuiltin) => pointerWordKindBuiltin(b)
    (c: SClass)   => classSpecIsForeign(c, r) ? PkForeign() : PkClass(c.scName)
    (e2: SEnum)   => isComplexEnum(e2, r) ? PkEnum(e2.seRoot) : None
    (o: Spec)     => None

fun pointerWordKindTuple(t2: STuple, r: Resolver): PtrKind|None
  ret exactly(chain(t2.stEntries), 1) ? pointerWordKindTupleEntry(entryTypeAt(t2, 0), r) : None

fun pointerWordKindTupleEntry(ety: Spec|None, r: Resolver): PtrKind|None
  ret match(ety)
    (e2: Spec) => pointerWordKind(e2, r)
    ()          => None

fun pointerWordKindBuiltin(b: SBuiltin): PtrKind|None
  ret b.sbName == "bigint" ? PkInt() : (b.sbName == "str" ? PkStr() : None)

fun unionCollapsesToPointer(members: List<Spec>, r: Resolver): Bool
  let kinds = map(members, (m: Spec) => pointerWordKind(m, r))
  ret any(kinds, (k: PtrKind|None) => isNoneKind(k)) ? false : unionCollapsesToPointerOn(map(kinds, forceKindId))

fun isNoneKind(k: PtrKind|None): Bool
  ret match(k)
    (kk: PtrKind) => false
    ()             => true

fun forceKindId(k: PtrKind|None): PtrKind
  ret match(k)
    (kk: PtrKind) => kk
    ()             => PkUnit()   # unreachable: caller already excluded None

fun unionCollapsesToPointerOn(ks: List<PtrKind>): Bool
  ret !any(ks, (k: PtrKind) => !isUnitKind(k))
    ? false
    : (countKind(ks, isUnitKind) > 1 || countKind(ks, isForeignKind) > 1 ? false : allDistinctKinds(filterKinds(ks)))

fun countKind(ks: List<PtrKind>, pred: (:PtrKind): Bool): Int
  ret fold(ks, 0, (acc: Int, k: PtrKind) => pred(k) ? acc + 1 : acc)

fun filterKinds(ks: List<PtrKind>): List<PtrKind>
  ret filter(ks, (k: PtrKind) => !(isUnitKind(k) || isForeignKind(k)))

fun allDistinctKinds(ks: List<PtrKind>): Bool
  ret allDistinctKindsLoop(chain(ks), List<PtrKind>())

# `seen` answers membership only, so a kind goes on the front.
fun [tail] allDistinctKindsLoop(ks: Chain<PtrKind>, seen: List<PtrKind>): Bool
  ret match(ks)
    (nil: ChainEnd) => true
    (l: ChainLink)  => any(seen, (s2: PtrKind) => eqPtrKind(s2, l.value))
      ? false
      : allDistinctKindsLoop(l.next, prepend(l.value, seen))

# Rebuild a single-field newtype wrapper (a chain of one-field structs ending
# in a DataPointer) from a bare pointer word.
fun [tail] unwrapToPointerWord(value: RParam, ctype: CgType): RParam
  ret match(cgFieldsOf(ctype))
    (fields: List<CgField>) => match(soleField(fields))
      (f: CgField) => unwrapToPointerWord(RpStructField(value, f.fieldName), f.fieldType)
      ()            => value
    ()               => value

fun soleField(fields: List<CgField>): CgField|None
  ret exactly(chain(fields), 1) ? head(fields) : None

class [final] SlotValuePair(svpName: String, svpValue: RParam)

fun variantSlots(value: RParam, innerCtype: CgType, slotAssignments: List<CgSlotEntry>, slotFields: List<CgField>): List<SlotValuePair>
  ret isEmpty(cgFlattenPrimitives(innerCtype)) ? List<SlotValuePair>() : collectVariantSlots(value, innerCtype, slotAssignments, slotFields, 0).cvValues

class [final] CollectOut(cvValues: List<SlotValuePair>, cvOffset: Int)

fun collectVariantSlots(param: RParam, ctype: CgType, slotAssignments: List<CgSlotEntry>, slotFields: List<CgField>, offset: Int): CollectOut
  ret match(ctype)
    (fp: CgFuncPointer) => collectVariantSlotsFun(param, slotAssignments, slotFields, offset)
    (o: CgType)          => match(cgFieldsOf(ctype))
      (fields: List<CgField>) => collectVariantSlotsFields(chain(fields), param, slotAssignments, slotFields, offset, List<SlotValuePair>())
      ()                       => collectVariantSlotsLeaf(param, slotAssignments, slotFields, offset)

# A closure IS a struct (the enum-encoding principle): deconstructed into the
# two primitives the layout allotted — the code word (non-GC), then the
# environment pointer (GC). union_repr.py _variant_slots is the mirror.
fun collectVariantSlotsFun(param: RParam, slotAssignments: List<CgSlotEntry>,
                           slotFields: List<CgField>, offset: Int): CollectOut
  ret match(listAt<CgSlotEntry>(slotAssignments, offset))
    (ef: CgSlotEntry) => match(listAt<CgSlotEntry>(slotAssignments, offset + 1))
      (eo: CgSlotEntry) => CollectOut(
          list2(SlotValuePair(fieldNameAt(slotFields, ef.slotIndex),
                              RpFunField(param, "f")),
                SlotValuePair(fieldNameAt(slotFields, eo.slotIndex),
                              RpFunField(param, "o"))),
          offset + 2)
      ()                 => CollectOut(List<SlotValuePair>(), offset + 2)   # unreachable
    ()                 => CollectOut(List<SlotValuePair>(), offset + 2)   # unreachable

fun collectVariantSlotsLeaf(param: RParam, slotAssignments: List<CgSlotEntry>, slotFields: List<CgField>, offset: Int): CollectOut
  ret match(listAt<CgSlotEntry>(slotAssignments, offset))
    (e2: CgSlotEntry) => CollectOut(list1(SlotValuePair(fieldNameAt(slotFields, e2.slotIndex), param)), offset + 1)
    ()                 => CollectOut(List<SlotValuePair>(), offset + 1)   # unreachable

fun collectVariantSlotsFields(fs: Chain<CgField>, param: RParam, slotAssignments: List<CgSlotEntry>,
                                    slotFields: List<CgField>, offset: Int, acc: List<SlotValuePair>): CollectOut
  ret match(fs)
    (nil: ChainEnd) => CollectOut(acc, offset)
    (l: ChainLink)  => collectVariantSlotsFieldsStep(l, param, slotAssignments, slotFields, offset, acc)

fun collectVariantSlotsFieldsStep(l: ChainLink<CgField>, param: RParam, slotAssignments: List<CgSlotEntry>,
                                 slotFields: List<CgField>, offset: Int, acc: List<SlotValuePair>): CollectOut
  let sub = collectVariantSlots(RpStructField(param, l.value.fieldName), l.value.fieldType, slotAssignments, slotFields, offset)
  ret collectVariantSlotsFields(l.next, param, slotAssignments, slotFields, sub.cvOffset, concat(acc, sub.cvValues))

# ══════════════════════════════════════════════════════════════════════════
# SECTION 4: the GRepr sum type + classify.
# ══════════════════════════════════════════════════════════════════════════

enum GRepr
  enum GTagged(grtType: Spec, grtContainer: CgType, grtVariantMap: List<List<CgSlotEntry>>)
  enum GPointer(grpType: Spec)
  enum GComplexEnum(grcType: Spec)

# DERIVED is_complex: the resolver carries the breaker analysis (identity
# vs state — no stamps to read, no canon lookup, no stale copies).
fun isComplexEnum(sp: SEnum, r: Resolver): Bool
  ret isComplexRoot(r, sp.seRoot)

fun classifyRepr(sp: Spec, r: Resolver): GRepr
  ret match(sp)
    (e2: SEnum) => classifyEnum(e2, r)
    (cm: SCombination) => classifyCombination(cm, r)
    (o: Spec)   => GPointer(sp)   # unreachable (Python raises TypeError): not a union type

fun classifyEnum(e2: SEnum, r: Resolver): GRepr
  ret isComplexEnum(e2, r) ? GComplexEnum(e2) : classifyFlatEnum(e2, r)

fun classifyFlatEnum(e2: SEnum, r: Resolver): GRepr
  ret match(soleItem(findType(r, e2.seRoot)))
    (found: Found) => match(found.fStmt)
      (stmt: PsEnum) => classifyFlatEnumStmt(e2, stmt, r)
      (o: PStmt)     => classifyFlatEnumFallback(e2, r)
    ()               => classifyFlatEnumFallback(e2, r)

fun classifyFlatEnumStmt(e2: SEnum, stmt: PsEnum, r: Resolver): GRepr
  let layout = computeUnionSlots(enumVariantTypes(stmt, r), globalMaxTag(r))
  ret GTagged(e2, layout.fieldsStruct, layout.variantMap)

fun classifyFlatEnumFallback(e2: SEnum, r: Resolver): GRepr
  ret GTagged(e2, CgStruct(map(enumFieldsVia(r, e2.seRoot),
                               (f: SField) => CgField(f.sfName, specGenerate(f.sfType, r)))),
              List<List<CgSlotEntry>>())

fun classifyCombination(cm: SCombination, r: Resolver): GRepr
  let members = reprMembersOf(cm.scTypes)
  ret unionCollapsesToPointer(members, r) ? GPointer(cm) : classifyCombinationTagged(cm, members, r)

fun classifyCombinationTagged(cm: SCombination, members: List<Spec>, r: Resolver): GRepr
  let layout = computeUnionSlots(map(members, (v: Spec) => specGenerate(v, r)), globalMaxTag(r))
  ret GTagged(cm, layout.fieldsStruct, layout.variantMap)

fun reprCtype(rep: GRepr): CgType
  ret match(rep)
    (gt: GTagged) => gt.grtContainer
    (gp: GPointer) => CgDataPointer()
    (gc: GComplexEnum) => CgDataPointer()

# ══════════════════════════════════════════════════════════════════════════
# SECTION 5: generate_match — TaggedRepr (flat enum + combination),
# PointerRepr, ComplexEnumRepr.
# ══════════════════════════════════════════════════════════════════════════

# ── per-position guards and binds (multi-subject match) ──────────────────
# `reprGenerateMatch` above drives the whole dispatch for ONE subject. With
# several subjects each position instead contributes one STAGE of checks to
# each arm, and emArm ANDs the stages and falls through to the next arm when
# any fails — first-match-wins across positions, with no decision tree.
#
# None means "this repr cannot serve a position with that pattern"; the check
# phase reports it rather than letting codegen emit something wrong.

fun reprPositionGuards(rep: GRepr, sv: RParam, armType: Spec|None,
                       r: Resolver): List<RParam>|None
  ret match(armType)
    (at: Spec) => reprPositionGuardsOn(rep, sv, at, r)
    ()         => None

fun reprPositionGuardsOn(rep: GRepr, sv: RParam, armType: Spec,
                         r: Resolver): List<RParam>|None
  ret match(rep)
    (gt: GTagged) => match(gt.grtType)
      (e2: SEnum) => flatEnumPositionGuards(sv, armType, e2.seAllLeaves)
      (o: Spec)   => combinationPositionGuards(gt, sv, armType, r)
    (gp: GPointer)     => pointerPositionGuards(sv, armType, r)
    (gc: GComplexEnum) => complexPositionGuards(gc, sv, armType, r)

fun flatEnumPositionGuards(sv: RParam, armType: Spec,
                           allLeafNames: List<String>): List<RParam>|None
  ret match(asEnumVariant(armType))
    (at: SEnum) => map(sortLeavesByGuardOrder(at.seValidLeaves, allLeafNames),
                       (leaf: String) =>
                         RpIntEqConst(RpStructField(sv, "$tag"),
                                      leafId(allLeafNames, leaf)))
    ()          => None

fun complexPositionGuards(gc: GComplexEnum, sv: RParam, armType: Spec,
                          r: Resolver): List<RParam>|None
  ret match(asEnumVariant(gc.grcType))
    (subj: SEnum) => match(asEnumVariant(armType))
      (at: SEnum) => map(sortLeavesByComplexId(at.seValidLeaves, subj.seRoot,
                                               getDiscriminators(r)),
                         (leaf: String) =>
                           RpIntEqConst(RpVtableDiscriminator(sv),
                                        complexLeafId(subj.seRoot, leaf,
                                                      getDiscriminators(r))))
      ()          => None
    ()            => None

# NULL for the unit member, vtable identity for the rest. A FOREIGN class is
# untestable from generated code — in a single-subject match it can be the
# implicit fallback, but a POSITION has no fallback to be.
fun pointerPositionGuards(sv: RParam, armType: Spec,
                          r: Resolver): List<RParam>|None
  ret pointerGuardLoop(chain(unionMembers(armType)), sv, r, List<RParam>())

fun [tail] pointerGuardLoop(ms: Chain<Spec>, sv: RParam, r: Resolver,
                            acc: List<RParam>): List<RParam>|None
  ret match(ms)
    (nil: ChainEnd) => isEmpty(acc) ? None : acc
    (l: ChainLink)  => isNoneSpec2(l.value)
      ? pointerGuardLoop(l.next, sv, r,
                         appendGuard(acc, RpIntEqConst(sv, 0)))
      : match(memberGuard(l.value, sv, r))
        (g: RParam) => pointerGuardLoop(l.next, sv, r, appendGuard(acc, g))
        ()          => None          # FOREIGN: untestable in a position

fun appendGuard(acc: List<RParam>, g: RParam): List<RParam>
  ret build<RParam >(push<RParam >(builderFrom<RParam>(acc), g))

# One tag comparison per position. `.get(uid, 0)` is deliberate: a BUILTIN
# member such as the `int32` of `Int32|None` carries no registry
# discriminator and takes tag 0, exactly as the single-subject path reads it.
fun combinationPositionGuards(gt: GTagged, sv: RParam, armType: Spec,
                              r: Resolver): List<RParam>|None
  ret match(soleMemberOf(armType))
    # The member must actually BE a member of this subject union. Without the
    # check a pattern naming something else emits a tag test against 0 and
    # silently matches the wrong variant; Python refuses it (vi is None).
    (m: Spec) => contains2(map(unionMembers(gt.grtType), (v: Spec) => uid(v)),
                           uid(m))
      ? list1(RpIntEqConst(RpStructField(sv, "$tag"),
                           discOf(getDiscriminators(r), uid(m))))
      : None
    ()        => None                # several members need a Phi, not a stage

# None when the pattern names SEVERAL members: a tagged combination tests ONE
# tag per stage, so a multi-member pattern needs a Phi over entry edges, which
# a position cannot be. Returning the union itself here — as this did — hands
# back a single tag for a pattern that matches several, silently accepting a
# program Python refuses.
fun soleMemberOf(sp: Spec): Spec|None
  ret exactly(chain(unionMembers(sp)), 1) ? head(unionMembers(sp)) : None

fun discOf(discs: Dict<String, Int>, u: String): Int
  ret match(get(discs, u))
    (i: Int) => i
    ()       => 0

fun reprGenerateMatch(rep: GRepr, em: GEmit, resultType: Spec|None, subjBundle: GBundle,
                     arms: List<PArm>, elseArm: PArm|None, r: Resolver): GEmit
  ret match(rep)
    (gt: GTagged) => match(gt.grtType)
      (e2: SEnum) => generateFlatEnumMatch(em, resultType, subjBundle, gt.grtType, e2.seAllLeaves, arms, elseArm, r)
      (o: Spec)   => generateCombinationMatch(em, resultType, subjBundle, gt.grtType, gt.grtContainer, gt.grtVariantMap, arms, elseArm, r)
    (gp: GPointer) => generatePointerMatch(em, resultType, subjBundle, gp.grpType, arms, elseArm, r)
    (gc: GComplexEnum) => generateComplexEnumMatch(em, resultType, subjBundle, gc.grcType, arms, elseArm, r)

# isNoneSpec is reused as-is from generate_expr2.yafl.

fun leafId(allLeafNames: List<String>, leaf: String): Int
  ret leafIdLoop(chain(allLeafNames), baseName(leaf), 0)

fun [tail] leafIdLoop(ns: Chain<String>, target: String, i: Int): Int
  ret match(ns)
    (nil: ChainEnd) => -1   # unreachable: leaf is always a member of allLeafNames
    (l: ChainLink)  => baseName(l.value) == target ? i : leafIdLoop(l.next, target, i + 1)

fun sortLeavesByGuardOrder(leaves: List<String>, allLeafNames: List<String>): List<String>
  ret fold(leaves, List<String>(), (acc: List<String>, lf: String) => insertByLeafId(acc, lf, allLeafNames))

fun insertByLeafId(sorted: List<String>, lf: String, allLeafNames: List<String>): List<String>
  ret match(head<String>(sorted))
    (h: String) => leafId(allLeafNames, lf) < leafId(allLeafNames, h)
      ? prepend<String>(lf, sorted)
      : prepend<String>(h, insertByLeafId(tail<String>(sorted), lf, allLeafNames))
    ()           => prepend(lf, List<String>())

# ── flat enum ────────────────────────────────────────────────────────────

fun generateFlatEnumMatch(em0: GEmit, resultType: Spec|None, subjBundle: GBundle, subjType: Spec,
                          allLeafNames: List<String>, arms: List<PArm>, elseArm: PArm|None, r: Resolver): GEmit
  let sv = mustResult(subjBundle)
  let tag = RpStructField(sv, "$tag")
  let em1 = flatEnumArms(em0, chain(arms), sv, tag, subjType, allLeafNames, resultType, r)
  let bind = match(elseArm)
    (a: PArm) => bindSubject(r, a, subjType, sv)
    ()         => None
  ret emFallback(em1, r, resultType, elseArm, bind, "enum match fell through all arms")

fun [tail] flatEnumArms(em: GEmit, arms: Chain<PArm>, sv: RParam, tag: RParam, subjType: Spec,
                        allLeafNames: List<String>, resultType: Spec|None, r: Resolver): GEmit
  ret match(arms)
    (nil: ChainEnd) => em
    (l: ChainLink)  => flatEnumArms(
        isNoneSpec(l.value.armType) ? em : flatEnumArm(em, l.value, sv, tag, subjType, allLeafNames, resultType, r),
        l.next, sv, tag, subjType, allLeafNames, resultType, r)

fun flatEnumArm(em: GEmit, arm: PArm, sv: RParam, tag: RParam, subjType: Spec, allLeafNames: List<String>,
               resultType: Spec|None, r: Resolver): GEmit
  ret match(asEnumVariant(arm.armType))
    (armType: SEnum) => flatEnumArmOn(em, arm, tag, subjType, allLeafNames, armType, sv, resultType, r)
    ()                => em   # unreachable: check() requires an enum arm here

fun flatEnumArmOn(em: GEmit, arm: PArm, tag: RParam, subjType: Spec, allLeafNames: List<String>,
                  armType: SEnum, sv: RParam, resultType: Spec|None, r: Resolver): GEmit
  let ordered = sortLeavesByGuardOrder(armType.seValidLeaves, allLeafNames)
  let guards = map(ordered, (leaf: String) => RpIntEqConst(tag, leafId(allLeafNames, leaf)))
  ret emArm(em, r, resultType, arm, list1(guards), bindSubject(r, arm, subjType, sv), List<GBundle>())

# ── tagged combination ──────────────────────────────────────────────────

fun generateCombinationMatch(em0: GEmit, resultType: Spec|None, subjBundle: GBundle, subjType: Spec,
                             container: CgType, variantMap: List<List<CgSlotEntry>>,
                             arms: List<PArm>, elseArm: PArm|None, r: Resolver): GEmit
  let sv = mustResult(subjBundle)
  let tag = RpStructField(sv, "$tag")
  let members = reprMembersOf(unionMembers(subjType))
  let variantTypes = map(members, (v: Spec) => specGenerate(v, r))
  let slotFields = forceFields(container)
  let discs = getDiscriminators(r)
  let em1 = combinationArms(em0, chain(arms), sv, tag, members, variantTypes, variantMap, slotFields, discs, resultType, r)
  let bind = match(elseArm)
    (a: PArm) => bindSubject(r, a, subjType, sv)
    ()         => None
  ret emFallback(em1, r, resultType, elseArm, bind, "tagged-union match fell through all arms")

fun [tail] combinationArms(em: GEmit, arms: Chain<PArm>, sv: RParam, tag: RParam, members: List<Spec>,
                          variantTypes: List<CgType>, variantMap: List<List<CgSlotEntry>>, slotFields: List<CgField>,
                          discs: Dict<String, Int>, resultType: Spec|None, r: Resolver): GEmit
  ret match(arms)
    (nil: ChainEnd) => em
    (l: ChainLink)  => combinationArms(
        combinationArm(em, l.value, sv, tag, members, variantTypes, variantMap, slotFields, discs, resultType, r),
        l.next, sv, tag, members, variantTypes, variantMap, slotFields, discs, resultType, r)

fun combinationArm(em: GEmit, arm: PArm, sv: RParam, tag: RParam, members: List<Spec>,
                   variantTypes: List<CgType>, variantMap: List<List<CgSlotEntry>>, slotFields: List<CgField>,
                   discs: Dict<String, Int>, resultType: Spec|None, r: Resolver): GEmit
  ret !isEmpty(arm.armLiterals)
    ? combinationLiteralArm(em, arm, sv, tag, members, variantMap, slotFields, discs, resultType, r)
    : combinationTypedArm(em, arm, sv, tag, members, variantTypes, variantMap, slotFields, discs, resultType, r)

fun combinationTypedArm(em: GEmit, arm: PArm, sv: RParam, tag: RParam, members: List<Spec>,
                        variantTypes: List<CgType>, variantMap: List<List<CgSlotEntry>>, slotFields: List<CgField>,
                        discs: Dict<String, Int>, resultType: Spec|None, r: Resolver): GEmit
  ret match(arm.armType)
    (whole: Spec) => match(whole)
      (cm: SCombination) => combinationUnionArm(em, arm, cm, sv, tag, members, variantMap, slotFields, discs, resultType, r)
      (t2: Spec)          => combinationPlainArm(em, arm, t2, sv, tag, variantTypes, variantMap, slotFields, discs, resultType, r)
    ()             => em   # else arm: the fallback, handled at the end

fun litExprOf(l2: PLit): PExpr
  ret match(l2)
    (le2: PlExpr) => le2.litExpr
    (rg: PlRange) => rg.rangeLo

fun litTypeNameOfFirst(lits: List<PLit>, r: Resolver): String|None
  ret match(head(lits))
    (l2: PLit) => litTypeNameOfOne(l2, r)
    ()          => None

fun litTypeNameOfOne(l2: PLit, r: Resolver): String|None
  ret match(asBuiltinVariant(exprType(litExprOf(l2), r)))
    (b: SBuiltin) => b.sbName
    ()             => None

fun [tail] indexWhereBuiltin(members: List<Spec>, typeName: String, i: Int): Int|None
  ret match(head(members))
    (m: Spec) => isBuiltinNamed(m, typeName) ? i : indexWhereBuiltin(tail(members), typeName, i + 1)
    ()         => None

fun isBuiltinNamed(sp: Spec, typeName: String): Bool
  ret match(sp)
    (b: SBuiltin) => b.sbName == typeName
    (o: Spec)     => false

fun combinationLiteralArm(em: GEmit, arm: PArm, sv: RParam, tag: RParam, members: List<Spec>,
                          variantMap: List<List<CgSlotEntry>>, slotFields: List<CgField>,
                          discs: Dict<String, Int>, resultType: Spec|None, r: Resolver): GEmit
  ret match(litTypeNameOfFirst(arm.armLiterals, r))
    (litTypeName: String) => match(indexWhereBuiltin(members, litTypeName, 0))
      (vi: Int) => combinationLiteralArmAt(em, arm, sv, tag, members, variantMap, slotFields, discs, litTypeName, vi, resultType, r)
      ()         => em   # check() prevents this; skip to be safe
    ()                     => em

fun combinationLiteralArmAt(em: GEmit, arm: PArm, sv: RParam, tag: RParam, members: List<Spec>,
                            variantMap: List<List<CgSlotEntry>>, slotFields: List<CgField>,
                            discs: Dict<String, Int>, litTypeName: String, vi: Int, resultType: Spec|None, r: Resolver): GEmit
  let tagValue = getOr0(discs, uid(forceNth(members, vi)))
  let si = forceSlotIndex(forceNth(variantMap, vi))
  let slotVal = RpStructField(sv, fieldNameAt(slotFields, si))
  let lt = literalAlternativeTests(arm.armLiterals, litTypeName, slotVal, r, "lit" + String(em.geCounter))
  ret emArm(em, r, resultType, arm, list2(list1(RpIntEqConst(tag, tagValue)), lt.ltoTests), None, lt.ltoBundles)

fun forceSlotIndex(entries: List<CgSlotEntry>): Int
  ret match(head(entries))
    (e2: CgSlotEntry) => e2.slotIndex
    ()                 => 0   # unreachable: a literal-typed variant always occupies exactly one slot

fun isStructLike(t: CgType): Bool
  ret match(cgFieldsOf(t))
    (fields: List<CgField>) => true
    ()                       => false

fun combinationUnionArm(em: GEmit, arm: PArm, cm: SCombination, sv: RParam, tag: RParam, members: List<Spec>,
                        variantMap: List<List<CgSlotEntry>>, slotFields: List<CgField>,
                        discs: Dict<String, Int>, resultType: Spec|None, r: Resolver): GEmit
  let narrowCtype = specGenerate(cm, r)
  let narrowMembers = reprMembersOf(unionMembers(cm))
  let hasNarrowMap = isStructLike(narrowCtype)
  let narrowMap = hasNarrowMap
    ? computeUnionSlots(map(narrowMembers, (m: Spec) => specGenerate(m, r)), None).variantMap
    : List<List<CgSlotEntry>>()
  let entries = combinationUnionEntries(chain(narrowMembers), 0, members, variantMap, slotFields, discs, tag, sv,
                                        narrowCtype, narrowMap, hasNarrowMap, r,
                                        builder<GEntry >())
  ret emMultiEntryArm(em, r, resultType, arm, entries, narrowCtype)

fun combinationUnionEntries(narrowMembers: Chain<Spec>, k: Int, members: List<Spec>,
                                   variantMap: List<List<CgSlotEntry>>, slotFields: List<CgField>,
                                   discs: Dict<String, Int>, tag: RParam, sv: RParam, narrowCtype: CgType,
                                   narrowMap: List<List<CgSlotEntry>>, hasNarrowMap: Bool, r: Resolver,
                                   [terminal] acc: ListBuilder<GEntry >): List<GEntry>
  ret match(narrowMembers)
    (nil: ChainEnd) => build<GEntry >(acc)
    (l: ChainLink)  => combinationUnionEntriesStep(l, k, members, variantMap, slotFields, discs, tag, sv,
                                                   narrowCtype, narrowMap, hasNarrowMap, r, acc)

fun combinationUnionEntriesStep(l: ChainLink<Spec>, k: Int, members: List<Spec>,
                               variantMap: List<List<CgSlotEntry>>, slotFields: List<CgField>,
                               discs: Dict<String, Int>, tag: RParam, sv: RParam, narrowCtype: CgType,
                               narrowMap: List<List<CgSlotEntry>>, hasNarrowMap: Bool, r: Resolver,
                               [terminal] acc: ListBuilder<GEntry >): List<GEntry>
  let u = uid(l.value)
  ret combinationUnionEntries(l.next, k + 1, members, variantMap, slotFields, discs, tag, sv, narrowCtype, narrowMap, hasNarrowMap, r,
        combinationUnionEntryFor(variantIndexOf(members, u), l.value, u, discs, k, variantMap, slotFields, tag, sv, narrowCtype, narrowMap, hasNarrowMap, r, acc))

fun combinationUnionEntryFor(vi: Int|None, member: Spec, u: String, discs: Dict<String, Int>, k: Int,
                             variantMap: List<List<CgSlotEntry>>, slotFields: List<CgField>, tag: RParam, sv: RParam,
                             narrowCtype: CgType, narrowMap: List<List<CgSlotEntry>>, hasNarrowMap: Bool, r: Resolver,
                             [terminal] acc: ListBuilder<GEntry >): ListBuilder<GEntry >
  ret match(vi)
    (viv: Int) if contains(discs, u) =>
        push<GEntry >(acc, combinationUnionEntry(viv, member, u, discs, variantMap,
                                                 slotFields, tag, sv, k, narrowCtype,
                                                 narrowMap, hasNarrowMap, r))
    ()          => acc

fun combinationUnionEntry(vi: Int, member: Spec, u: String, discs: Dict<String, Int>, variantMap: List<List<CgSlotEntry>>,
                          slotFields: List<CgField>, tag: RParam, sv: RParam, k: Int,
                          narrowCtype: CgType, narrowMap: List<List<CgSlotEntry>>, hasNarrowMap: Bool, r: Resolver): GEntry
  let memberTag = getOr0(discs, u)
  let value = hasNarrowMap
    ? combinationUnionValueTagged(narrowCtype, forceNth(narrowMap, k), forceNth(variantMap, vi), slotFields, sv, memberTag)
    : combinationUnionValuePointer(specGenerate(member, r), vi, variantMap, slotFields, sv)
  ret GEntry(RpIntEqConst(tag, memberTag), value)

# DataPointer narrow union: NULL for the unit member, else the member's single
# pointer slot. The emptiness test is on the MEMBER's generated ctype (Python:
# `member.generate(resolver) == Struct(())`) — NOT the arm's narrow ctype,
# which on this path is a DataPointer and never the empty struct.
fun combinationUnionValuePointer(memberCtype: CgType, vi: Int, variantMap: List<List<CgSlotEntry>>,
                                 slotFields: List<CgField>, sv: RParam): RParam
  ret eqCgType(memberCtype, CgStruct(List<CgField>()))
    ? RpNullPointer()
    : RpStructField(sv, fieldNameAt(slotFields, forceSlotIndex(forceNth(variantMap, vi))))

# The slot values with the discriminator LAST. Not a list utility: the tag's
# position IS its position in the union struct, so this names the layout rule
# rather than the list operation that implements it.
fun withTagField(values: List<RpNamedValue>, tag: Int): List<RpNamedValue>
  ret build<RpNamedValue >(push<RpNamedValue >(
          builderFrom<RpNamedValue>(values),
          RpNamedValue("$tag", RpInteger(tag, 32))))

fun combinationUnionValueTagged(narrowCtype: CgType, narrowSlots: List<CgSlotEntry>, wideSlots: List<CgSlotEntry>,
                                slotFields: List<CgField>, sv: RParam, memberTag: Int): RParam
  let namedValues = withTagField(zipSlotFields(narrowSlots, wideSlots,
                                     forceFields(narrowCtype), slotFields, sv),
                                 memberTag)
  ret unionStruct(narrowCtype, namedValues)

fun zipSlotFields(narrowSlots: List<CgSlotEntry>, wideSlots: List<CgSlotEntry>, narrowFields: List<CgField>,
                  wideSlotFields: List<CgField>, sv: RParam): List<RpNamedValue>
  ret zipSlotFieldsLoop(chain(narrowSlots), chain(wideSlots), narrowFields, wideSlotFields, sv, List<RpNamedValue>())

fun zipSlotFieldsLoop(ns: Chain<CgSlotEntry>, ws: Chain<CgSlotEntry>, narrowFields: List<CgField>,
                             wideSlotFields: List<CgField>, sv: RParam, acc: List<RpNamedValue>): List<RpNamedValue>
  ret build<RpNamedValue >(zipSlotFieldsLoopB(ns, ws, narrowFields, wideSlotFields, sv, builderFrom<RpNamedValue>(acc)))

fun [tail] zipSlotFieldsLoopB(ns: Chain<CgSlotEntry>, ws: Chain<CgSlotEntry>, narrowFields: List<CgField>,
                             wideSlotFields: List<CgField>, sv: RParam, [terminal] acc: ListBuilder<RpNamedValue >): ListBuilder<RpNamedValue >
  ret match(ns)
    (nil: ChainEnd) => acc
    (l: ChainLink)  => match(ws)
      (nil2: ChainEnd) => acc
      (w: ChainLink)   => zipSlotFieldsLoopB(l.next, w.next, narrowFields, wideSlotFields, sv,
                            push<RpNamedValue >(acc, RpNamedValue(fieldNameAt(narrowFields, l.value.slotIndex),
                                                     RpStructField(sv, fieldNameAt(wideSlotFields, w.value.slotIndex)))))

fun [tail] indexWhereCgType(types2: List<CgType>, target: CgType, i: Int): Int|None
  ret match(head(types2))
    (t2: CgType) => eqCgType(t2, target) ? i : indexWhereCgType(tail(types2), target, i + 1)
    ()            => None

fun combinationPlainArm(em: GEmit, arm: PArm, armType: Spec, sv: RParam, tag: RParam,
                        variantTypes: List<CgType>, variantMap: List<List<CgSlotEntry>>, slotFields: List<CgField>,
                        discs: Dict<String, Int>, resultType: Spec|None, r: Resolver): GEmit
  let armCtype = specGenerate(armType, r)
  let tagValue = getOr0(discs, uid(armType))
  let bind = match(indexWhereCgType(variantTypes, armCtype, 0))
    (viv: Int) => bindFromSlots(r, arm, armCtype, forceNth(variantMap, viv), slotFields, sv)
    ()          => None
  ret emArm(em, r, resultType, arm, list1(list1(RpIntEqConst(tag, tagValue))), bind, List<GBundle>())

# ── pointer union ────────────────────────────────────────────────────────

class [final] MemberClassification(mcNullArm: PArm|None, mcForeignFallback: PArm|None,
                                   mcGuarded: List<PArm>, mcUnionArmCoversNone: Bool)

fun classifyPointerArms(arms: List<PArm>, r: Resolver): MemberClassification
  ret classifyPointerArmsLoop(chain(arms), r, None, None, builder<PArm >(),
                              false)

# The guarded arms keep their source order — match arms are tested in order,
# so this order is the semantics, not a convenience.
fun [tail] classifyPointerArmsLoop(arms: Chain<PArm>, r: Resolver, nullArm: PArm|None, foreignFallback: PArm|None,
                                   [terminal] guarded: ListBuilder<PArm >, unionCoversNone: Bool): MemberClassification
  ret match(arms)
    (nil: ChainEnd) => MemberClassification(nullArm, foreignFallback, build<PArm >(guarded), unionCoversNone)
    (l: ChainLink)  => !isEmpty(l.value.armLiterals)
      ? classifyPointerArmsLoop(l.next, r, nullArm, foreignFallback, push<PArm >(guarded, l.value), unionCoversNone)
      : classifyPointerArmsStep(l.value, l.next, r, nullArm, foreignFallback, guarded, unionCoversNone)

fun classifyPointerArmsStep(arm: PArm, rest: Chain<PArm>, r: Resolver, nullArm: PArm|None, foreignFallback: PArm|None,
                            [terminal] guarded: ListBuilder<PArm >, unionCoversNone: Bool): MemberClassification
  ret match(arm.armType)
    (t2: Spec) => eqCgType(specGenerate(t2, r), CgStruct(List<CgField>()))
      ? classifyPointerArmsLoop(rest, r, arm, foreignFallback, guarded, unionCoversNone)
      : classifyPointerArmsStepNonNull(arm, t2, rest, r, nullArm, foreignFallback, guarded, unionCoversNone)
    ()          => classifyPointerArmsLoop(rest, r, nullArm, foreignFallback, guarded, unionCoversNone)

fun classifyPointerArmsStepNonNull(arm: PArm, t2: Spec, rest: Chain<PArm>, r: Resolver, nullArm: PArm|None,
                                   foreignFallback: PArm|None, [terminal] guarded: ListBuilder<PArm >,
                                   unionCoversNone: Bool): MemberClassification
  ret match(t2)
    (c: SClass) => classSpecIsForeign(c, r)
      ? classifyPointerArmsLoop(rest, r, nullArm, arm, guarded, unionCoversNone)
      : classifyPointerArmsLoop(rest, r, nullArm, foreignFallback, push<PArm >(guarded, arm), unionCoversNone)
    (cm: SCombination) => classifyPointerArmsLoop(rest, r, nullArm, foreignFallback, push<PArm >(guarded, arm),
                                                 unionCoversNone || combinationCoversNone(cm, r))
    (o: Spec)          => classifyPointerArmsLoop(rest, r, nullArm, foreignFallback, push<PArm >(guarded, arm), unionCoversNone)

fun combinationCoversNone(cm: SCombination, r: Resolver): Bool
  ret any(reprMembersOf(unionMembers(cm)), (m: Spec) => eqCgType(specGenerate(m, r), CgStruct(List<CgField>())))

fun isNoneArm(a: PArm|None): Bool
  ret match(a)
    (x: PArm) => false
    ()         => true

fun armTypeOr(arm: PArm, fallback: Spec): Spec
  ret match(arm.armType)
    (t2: Spec) => t2
    ()          => fallback

fun memberGuard(member: Spec, sv: RParam, r: Resolver): RParam|None
  ret match(pointerWordKind(member, r))
    (k: PtrKind) => memberGuardOf(k, sv)
    ()            => None

fun memberGuardOf(k: PtrKind, sv: RParam): RParam|None
  ret match(k)
    (i: PkInt)     => RpObjVtableEq(sv, None, "INTEGER_VTABLE")
    (s2: PkStr)    => RpObjVtableEq(sv, None, "STRING_VTABLE")
    (c: PkClass)   => RpObjVtableEq(sv, c.pkName, None)
    (e2: PkEnum)   => RpObjVtableEq(sv, e2.pkRoot, None)
    (u: PkUnit)    => None
    (f: PkForeign) => None

fun generatePointerMatch(em0: GEmit, resultType: Spec|None, subjBundle: GBundle, subjType: Spec,
                        arms: List<PArm>, elseArm: PArm|None, r: Resolver): GEmit
  let sv = mustResult(subjBundle)
  let subjHasNone = any(reprMembersOf(unionMembers(subjType)), (v: Spec) => eqCgType(specGenerate(v, r), CgStruct(List<CgField>())))
  let cls = classifyPointerArms(arms, r)
  let em1 = genPointerNullRouting(em0, r, resultType, subjType, sv, cls, elseArm, subjHasNone)
  let em2 = fold(cls.mcGuarded, em1, (acc: GEmit, arm: PArm) => genPointerGuardedArm(acc, r, resultType, arm, sv))
  let finalFallback = match(cls.mcForeignFallback)
    (ff: PArm) => cls.mcForeignFallback
    ()          => elseArm
  let bind = match(finalFallback)
    (fb: PArm) => bindSubject(r, fb, armTypeOr(fb, subjType), sv)
    ()          => None
  ret emFallback(em2, r, resultType, finalFallback, bind, "pointer-union match fell through all arms")

fun genPointerNullRouting(em: GEmit, r: Resolver, resultType: Spec|None, subjType: Spec, sv: RParam,
                          cls: MemberClassification, elseArm: PArm|None, subjHasNone: Bool): GEmit
  ret match(cls.mcNullArm)
    (na: PArm) => emArm(em, r, resultType, na, list1(list1(RpIntEqConst(sv, 0))),
                        bindSubject(r, na, armTypeOr(na, subjType), sv), List<GBundle>())
    ()          => (subjHasNone && !cls.mcUnionArmCoversNone)
      ? genPointerNullRoutingToElse(em, r, resultType, subjType, sv, cls, elseArm)
      : em

fun genPointerNullRoutingToElse(em: GEmit, r: Resolver, resultType: Spec|None, subjType: Spec, sv: RParam,
                                cls: MemberClassification, elseArm: PArm|None): GEmit
  ret match(elseArm)
    (ea: PArm) => isNoneArm(cls.mcForeignFallback)
      ? emGuardToFallback(em, RpIntEqConst(sv, 0))
      : emArm(em, r, resultType, ea, list1(list1(RpIntEqConst(sv, 0))), bindSubject(r, ea, subjType, sv), List<GBundle>())
    ()          => em

fun genPointerGuardedArm(em: GEmit, r: Resolver, resultType: Spec|None, arm: PArm, sv: RParam): GEmit
  ret !isEmpty(arm.armLiterals)
    ? genPointerLiteralArm(em, arm, sv, r, resultType)
    : genPointerGuardedTypedArm(em, r, resultType, arm, sv)

fun genPointerGuardedTypedArm(em: GEmit, r: Resolver, resultType: Spec|None, arm: PArm, sv: RParam): GEmit
  ret match(arm.armType)
    (whole: Spec) => match(whole)
      (cm: SCombination) => genPointerUnionArm(em, r, resultType, arm, cm, sv)
      (t2: Spec)          => genPointerPlainArm(em, r, resultType, arm, t2, sv)
    ()             => em   # unreachable: an else arm never ends up in `guarded`

fun genPointerUnionArm(em: GEmit, r: Resolver, resultType: Spec|None, arm: PArm, cm: SCombination, sv: RParam): GEmit
  let guards = build<RParam >(pointerUnionGuards(
      chain(reprMembersOf(unionMembers(cm))), sv, r, builder<RParam >()))
  ret emArm(em, r, resultType, arm, list1(guards), bindSubject(r, arm, cm, sv), List<GBundle>())

# One guard per union member, in member order — the tests are emitted in this
# order, so it is the order of the generated condition chain.
fun [tail] pointerUnionGuards(members: Chain<Spec>, sv: RParam, r: Resolver,
                              [terminal] acc: ListBuilder<RParam >): ListBuilder<RParam >
  ret match(members)
    (nil: ChainEnd) => acc
    (l: ChainLink)  => eqCgType(specGenerate(l.value, r), CgStruct(List<CgField>()))
      ? pointerUnionGuards(l.next, sv, r, push<RParam >(acc, RpIntEqConst(sv, 0)))
      : pointerUnionGuards(l.next, sv, r, pushMemberGuard(acc, memberGuard(l.value, sv, r)))

fun pushMemberGuard([terminal] acc: ListBuilder<RParam >,
                    g2: RParam|None): ListBuilder<RParam >
  ret match(g2)
    (gg: RParam) => push<RParam >(acc, gg)
    ()            => acc

fun genPointerPlainArm(em: GEmit, r: Resolver, resultType: Spec|None, arm: PArm, t2: Spec, sv: RParam): GEmit
  ret match(memberGuard(t2, sv, r))
    (g2: RParam) => emArm(em, r, resultType, arm, list1(list1(g2)), bindSubject(r, arm, t2, sv), List<GBundle>())
    ()            => em

fun genPointerLiteralArm(em: GEmit, arm: PArm, sv: RParam, r: Resolver, resultType: Spec|None): GEmit
  ret match(litTypeNameOfFirst(arm.armLiterals, r))
    (typeName: String) => typeName == "str"
      ? genPointerLiteralArmGuarded(em, arm, sv, r, resultType, typeName, RpObjVtableEq(sv, None, "STRING_VTABLE"))
      : (typeName == "bigint"
          ? genPointerLiteralArmGuarded(em, arm, sv, r, resultType, typeName, RpObjVtableEq(sv, None, "INTEGER_VTABLE"))
          : em)
    ()                   => em

fun genPointerLiteralArmGuarded(em: GEmit, arm: PArm, sv: RParam, r: Resolver, resultType: Spec|None,
                                typeName: String, kindGuard: RParam): GEmit
  let lt = literalAlternativeTests(arm.armLiterals, typeName, sv, r, "lit" + String(em.geCounter))
  ret emArm(em, r, resultType, arm, list2(list1(kindGuard), lt.ltoTests), None, lt.ltoBundles)

# ── complex enum ─────────────────────────────────────────────────────────

fun complexEnumRoot(subjType: Spec): String
  ret match(subjType)
    (e2: SEnum) => e2.seRoot
    (o: Spec)   => ""   # unreachable

fun complexLeafId(rootName: String, leaf: String, discs: Dict<String, Int>): Int
  ret getOr0(discs, "enumleaf(" + enumLeafObjectName(rootName, leaf) + ")")

fun sortLeavesByComplexId(leaves: List<String>, rootName: String, discs: Dict<String, Int>): List<String>
  ret fold(leaves, List<String>(), (acc: List<String>, lf: String) => insertByComplexId(acc, lf, rootName, discs))

fun insertByComplexId(sorted: List<String>, lf: String, rootName: String, discs: Dict<String, Int>): List<String>
  ret match(head<String>(sorted))
    (h: String) => complexLeafId(rootName, lf, discs) < complexLeafId(rootName, h, discs)
      ? prepend<String>(lf, sorted)
      : prepend<String>(h, insertByComplexId(tail<String>(sorted), lf, rootName, discs))
    ()           => prepend(lf, List<String>())

fun generateComplexEnumMatch(em0: GEmit, resultType: Spec|None, subjBundle: GBundle, subjType: Spec,
                             arms: List<PArm>, elseArm: PArm|None, r: Resolver): GEmit
  let sv = mustResult(subjBundle)
  let tag = RpVtableDiscriminator(sv)
  let discs = getDiscriminators(r)
  let rootName = complexEnumRoot(subjType)
  let em1 = complexEnumArms(em0, chain(arms), sv, tag, subjType, rootName, discs, resultType, r)
  let bind = match(elseArm)
    (a: PArm) => bindSubject(r, a, subjType, sv)
    ()         => None
  ret emFallback(em1, r, resultType, elseArm, bind, "enum match fell through all arms")

fun [tail] complexEnumArms(em: GEmit, arms: Chain<PArm>, sv: RParam, tag: RParam, subjType: Spec,
                          rootName: String, discs: Dict<String, Int>, resultType: Spec|None, r: Resolver): GEmit
  ret match(arms)
    (nil: ChainEnd) => em
    (l: ChainLink)  => complexEnumArms(
        isNoneSpec(l.value.armType) ? em : complexEnumArm(em, l.value, sv, tag, subjType, rootName, discs, resultType, r),
        l.next, sv, tag, subjType, rootName, discs, resultType, r)

fun complexEnumArm(em: GEmit, arm: PArm, sv: RParam, tag: RParam, subjType: Spec, rootName: String,
                   discs: Dict<String, Int>, resultType: Spec|None, r: Resolver): GEmit
  ret match(asEnumVariant(arm.armType))
    (armType: SEnum) => complexEnumArmOn(em, arm, tag, subjType, rootName, discs, armType, sv, resultType, r)
    ()           => em   # unreachable: check() requires an enum arm here

fun complexEnumArmOn(em: GEmit, arm: PArm, tag: RParam, subjType: Spec, rootName: String, discs: Dict<String, Int>,
                     armType: SEnum, sv: RParam, resultType: Spec|None, r: Resolver): GEmit
  let ordered = sortLeavesByComplexId(armType.seValidLeaves, rootName, discs)
  let guards = map(ordered, (leaf: String) => RpIntEqConst(tag, complexLeafId(rootName, leaf, discs)))
  ret emArm(em, r, resultType, arm, list1(guards), bindSubject(r, arm, subjType, sv), List<GBundle>())

# ══════════════════════════════════════════════════════════════════════════
# SECTION 6: box_value (CombinationSpec targets only).
# ══════════════════════════════════════════════════════════════════════════

fun reprBoxValue(rep: GRepr, value: RParam, sourceType: Spec, r: Resolver): GBundle
  ret match(rep)
    (gt: GTagged) => taggedBoxValue(gt, value, sourceType, r)
    (gp: GPointer) => pointerBoxValue(value, sourceType, r)
    (gc: GComplexEnum) => bundleValue(value)   # unreachable: Python raises NotImplementedError

fun taggedBoxValue(gt: GTagged, value: RParam, sourceType: Spec, r: Resolver): GBundle
  let innerCtype = specGenerate(sourceType, r)
  ret eqCgType(innerCtype, gt.grtContainer) ? bundleValue(value) : taggedBoxValueDifferent(gt, value, sourceType, innerCtype, r)

fun taggedBoxValueDifferent(gt: GTagged, value: RParam, sourceType: Spec, innerCtype: CgType, r: Resolver): GBundle
  let su = uid(sourceType)
  ret match(variantIndexOf(reprMembersOf(unionMembers(gt.grtType)), su))
    (vi: Int) => taggedBoxValueAt(gt, value, innerCtype, su, vi, r)
    ()          => bundleValue(value)   # unreachable: caller only boxes an actual member

fun taggedBoxValueAt(gt: GTagged, value: RParam, innerCtype: CgType, su: String, vi: Int, r: Resolver): GBundle
  let tagValue = getOr0(getDiscriminators(r), su)
  let slotFields = forceFields(gt.grtContainer)
  let slotValues = variantSlots(value, innerCtype, forceNth(gt.grtVariantMap, vi), slotFields)
  let namedValues = withTagField(
      map(slotValues, (p: SlotValuePair) => RpNamedValue(p.svpName, p.svpValue)),
      tagValue)
  ret bundleValue(unionStruct(gt.grtContainer, namedValues))

fun pointerBoxValue(value: RParam, sourceType: Spec, r: Resolver): GBundle
  let innerCtype = specGenerate(sourceType, r)
  ret eqCgType(innerCtype, CgStruct(List<CgField>())) ? bundleValue(RpNullPointer()) : bundleValue(unwrapToPointerWord(value, innerCtype))

# ══════════════════════════════════════════════════════════════════════════
# SECTION 7: widen_from (CombinationSpec targets only).
# ══════════════════════════════════════════════════════════════════════════

class [final] WidenOut(woBundles: List<GBundle>, woSources: List<OpPhiSource>)

fun reprWidenFrom(targetRep: GRepr, srcRep: GRepr, value: RParam, r: Resolver): GBundle
  ret match(targetRep)
    (gt: GTagged) => taggedWidenFrom(gt, srcRep, value, r)
    (gp: GPointer) => pointerWidenFrom(srcRep, value)
    (gc: GComplexEnum) => bundleValue(value)   # unreachable: Python raises NotImplementedError

fun pointerWidenFrom(srcRep: GRepr, value: RParam): GBundle
  ret match(srcRep)
    (gp: GPointer) => bundleValue(value)
    (o: GRepr)     => bundleValue(value)   # unreachable: Python asserts src must be PointerRepr too

fun taggedWidenFrom(gt: GTagged, srcRep: GRepr, value: RParam, r: Resolver): GBundle
  let endLabel = "wide_end"
  let wo = match(srcRep)
    (gp: GPointer) => widenFromPointer(value, gp.grpType, gt, endLabel, r)
    (o: GRepr)      => widenFromTagged(value, forceTagged(srcRep), gt, endLabel, r)
  let resultVar = RpStackVar(gt.grtContainer, "wide_result")
  let joinBundle = GBundle(list1(resultVar), list2<Op>(OpLabel(endLabel, List<RParam>()), OpPhi(resultVar, wo.woSources, List<RParam>())), resultVar, List<RecurSource>(), List<ExitSource>())
  ret bundleJoin(bundleJoinAll(wo.woBundles), joinBundle)

fun forceTagged(rep: GRepr): GTagged
  ret match(rep)
    (gt: GTagged) => gt
    (o: GRepr)    => GTagged(SBuiltin("bool", noLine()), CgVoid(), List<List<CgSlotEntry>>())   # unreachable

fun [tail] findPointerVariant(members: List<Spec>, r: Resolver): Spec|None
  ret match(head(members))
    (m: Spec) => eqCgType(specGenerate(m, r), CgStruct(List<CgField>())) ? findPointerVariant(tail(members), r) : m
    ()         => None

fun [tail] findUnitVariant(members: List<Spec>, r: Resolver): Spec|None
  ret match(head(members))
    (m: Spec) => eqCgType(specGenerate(m, r), CgStruct(List<CgField>())) ? m : findUnitVariant(tail(members), r)
    ()         => None

fun widenFromPointer(sv: RParam, source: Spec, gt: GTagged, endLabel: String, r: Resolver): WidenOut
  let members = reprMembersOf(unionMembers(source))
  ret widenFromPointerOn(sv, findPointerVariant(members, r), findUnitVariant(members, r), gt, endLabel, r)

fun widenFromPointerOn(sv: RParam, ptrVariant: Spec|None, unitVariant: Spec|None, gt: GTagged, endLabel: String, r: Resolver): WidenOut
  ret match(ptrVariant)
    (pv: Spec) => widenFromPointerWithVariant(sv, pv, unitVariant, gt, endLabel, r)
    ()          => WidenOut(List<GBundle>(), List<OpPhiSource>())   # unreachable: a DataPointer union always has one

fun widenFromPointerWithVariant(sv: RParam, ptrVariant: Spec, unitVariant: Spec|None, gt: GTagged, endLabel: String, r: Resolver): WidenOut
  let nullLabel = "wide_null"
  let ptrUid = uid(ptrVariant)
  let discs = getDiscriminators(r)
  let ptrTag = getOr0(discs, ptrUid)
  let targetMembers = reprMembersOf(unionMembers(gt.grtType))
  let slotFields = forceFields(gt.grtContainer)
  let slotValues = match(variantIndexOf(targetMembers, ptrUid))
    (tpi: Int) => withTagField(
        map(forceNth(gt.grtVariantMap, tpi),
            (e2: CgSlotEntry) => RpNamedValue(fieldNameAt(slotFields,
                                                          e2.slotIndex), sv)),
        ptrTag)
    ()          => list1(RpNamedValue("$tag", RpInteger(ptrTag, 32)))
  let unitTag = match(unitVariant)
    (uv: Spec) => getOr0(discs, uid(uv))
    ()          => 0
  let sources = list2(OpPhiSource("ptr_exit", unionStruct(gt.grtContainer, slotValues)),
                      OpPhiSource("null_exit", unionStruct(gt.grtContainer, list1(RpNamedValue("$tag", RpInteger(unitTag, 32))))))
  let bodies = list3(
    bundleOps(list1<Op>(OpJumpIf(nullLabel, RpIntEqConst(sv, 0), false, List<RParam>()))),
    bundleOps(list3<Op>(OpLabel("ptr_exit", List<RParam>()), OpJump(endLabel, List<RParam>()), OpLabel(nullLabel, List<RParam>()))),
    bundleOps(list1<Op>(OpLabel("null_exit", List<RParam>()))))
  ret WidenOut(bodies, sources)

class [final] OneWidenOut(owBundles: List<GBundle>, owSource: OpPhiSource)

fun widenFromTagged(sv: RParam, srcRep: GTagged, gt: GTagged, endLabel: String, r: Resolver): WidenOut
  let sourceMembers = reprMembersOf(unionMembers(srcRep.grtType))
  let targetMembers = reprMembersOf(unionMembers(gt.grtType))
  let srcTagField = RpStructField(sv, "$tag")
  let discs = getDiscriminators(r)
  # The abort is the LAST bundle: it is where control lands when no source
  # variant matched, so it is pushed after the per-variant walk.
  let step = widenFromTaggedLoop(chain(sourceMembers), 0, sv, srcRep, gt, targetMembers, srcTagField, discs, endLabel, r,
                                WidenAcc(builder<GBundle >(),
                                         builder<OpPhiSource >()))
  ret WidenOut(build<GBundle >(push<GBundle >(step.waBundles,
                   bundleOp1(OpAbort("container-widening fell through all source variants", List<RParam>())))),
               build<OpPhiSource >(step.waSources))

# One bundle group and one phi source per source variant, in variant order.
class [linear, final] WidenAcc(waBundles: ListBuilder<GBundle >,
                               waSources: ListBuilder<OpPhiSource >)

fun widenFromTaggedLoop(members: Chain<Spec>, i: Int, sv: RParam, srcRep: GTagged, gt: GTagged,
                               targetMembers: List<Spec>, srcTagField: RParam, discs: Dict<String, Int>,
                               endLabel: String, r: Resolver,
                               [terminal] acc: WidenAcc): WidenAcc
  ret match(members)
    (nil: ChainEnd) => acc
    (l: ChainLink)  => widenFromTaggedLoopStep(l, i, sv, srcRep, gt, targetMembers, srcTagField, discs, endLabel, r, acc)

fun widenFromTaggedLoopStep(l: ChainLink<Spec>, i: Int, sv: RParam, srcRep: GTagged, gt: GTagged,
                            targetMembers: List<Spec>, srcTagField: RParam, discs: Dict<String, Int>,
                            endLabel: String, r: Resolver,
                            [terminal] acc: WidenAcc): WidenAcc
  let step = widenFromTaggedOne(l.value, i, sv, srcRep, gt, targetMembers, srcTagField, discs, endLabel, r)
  ret widenFromTaggedLoop(l.next, i + 1, sv, srcRep, gt, targetMembers, srcTagField, discs, endLabel, r,
                         WidenAcc(_pushChain<GBundle >(acc.waBundles,
                                      chain<GBundle>(step.owBundles)),
                                  push<OpPhiSource >(acc.waSources,
                                                     step.owSource)))

fun widenFromTaggedOne(srcVar: Spec, i: Int, sv: RParam, srcRep: GTagged, gt: GTagged, targetMembers: List<Spec>,
                       srcTagField: RParam, discs: Dict<String, Int>, endLabel: String, r: Resolver): OneWidenOut
  let varUid = uid(srcVar)
  let varTag = getOr0(discs, varUid)
  let armLabel = "wide_arm_" + String(i)
  let nextLabel = "wide_next_" + String(i)
  let exitLabel = "wide_exit_" + String(i)
  let srcSlotFields = forceFields(srcRep.grtContainer)
  let tgtSlotFields = forceFields(gt.grtContainer)
  let slotValues = match(variantIndexOf(targetMembers, varUid))
    (tvi: Int) => withTagField(
        zipSlotFields(forceNth(gt.grtVariantMap, tvi),
                      forceNth(srcRep.grtVariantMap, i), tgtSlotFields,
                      srcSlotFields, sv),
        varTag)
    ()          => list1(RpNamedValue("$tag", RpInteger(varTag, 32)))
  let bundles = list3(
    bundleOps(list3<Op>(OpJumpIf(armLabel, RpIntEqConst(srcTagField, varTag), false, List<RParam>()), OpJump(nextLabel, List<RParam>()), OpLabel(armLabel, List<RParam>()))),
    bundleOps(list2<Op>(OpLabel(exitLabel, List<RParam>()), OpJump(endLabel, List<RParam>()))),
    bundleOps(list1<Op>(OpLabel(nextLabel, List<RParam>()))))
  ret OneWidenOut(bundles, OpPhiSource(exitLabel, unionStruct(gt.grtContainer, slotValues)))

# ══════════════════════════════════════════════════════════════════════════
# SECTION 8: read_field (SEnum targets only).
# ══════════════════════════════════════════════════════════════════════════

fun reprReadField(rep: GRepr, baseValue: RParam, fieldName: String, r: Resolver): RParam
  ret match(rep)
    (gt: GTagged) => taggedReadField(gt, baseValue, fieldName, r)
    (gc: GComplexEnum) => complexReadField(gc, baseValue, fieldName, r)
    (gp: GPointer) => RpNullPointer()   # unreachable: Python raises NotImplementedError (not an enum union)

fun taggedReadField(gt: GTagged, baseValue: RParam, fieldName: String, r: Resolver): RParam
  ret match(gt.grtType)
    (e2: SEnum) => match(soleItem(findType(r, e2.seRoot)))
      (found: Found) => match(found.fStmt)
        (root: PsEnum) => taggedReadFieldOn(gt, e2, root, baseValue, fieldName, r)
        (o: PStmt)     => RpNullPointer()   # unreachable
      ()               => RpNullPointer()   # unreachable
    (o: Spec)   => RpNullPointer()   # unreachable: only ever classified from an SEnum

fun taggedReadFieldOn(gt: GTagged, e2: SEnum, root: PsEnum, baseValue: RParam, fieldName: String, r: Resolver): RParam
  let leafFieldSets = collectLeafFieldSets(root, List<PStmt>())
  let slotFields = forceFields(gt.grtContainer)
  ret taggedReadFieldLeaves(chain(e2.seAllLeaves), chain(leafFieldSets), 0, e2.seRoot,
                            gt.grtVariantMap, slotFields, baseValue, fieldName, r)

fun [tail] taggedReadFieldLeaves(names: Chain<String>, leaves: Chain<List<PStmt>>, leafIdx: Int, rootName: String,
                                 variantMap: List<List<CgSlotEntry>>,
                                 slotFields: List<CgField>, baseValue: RParam, fieldName: String, r: Resolver): RParam
  ret match(names)
    (nil: ChainEnd) => RpNullPointer()   # unreachable: check() guarantees the field exists on some leaf
    (n: ChainLink)  => match(leaves)
      (nil2: ChainEnd) => RpNullPointer()   # unreachable: leaf names and field sets zip 1:1
      (l: ChainLink)   => match(isBoxedLeaf(r, rootName, n.value)
                                  ? taggedReadFieldBoxed(l.value, n.value, rootName, forceNth(variantMap, leafIdx), slotFields, baseValue, fieldName, r)
                                  : taggedReadFieldInLeaf(l.value, 0, forceNth(variantMap, leafIdx), slotFields, baseValue, fieldName, r))
        (found: RParam) => found
        ()               => taggedReadFieldLeaves(n.next, l.next, leafIdx + 1, rootName, variantMap, slotFields, baseValue, fieldName, r)

# Boxed leaf: the pool holds one pointer to the per-leaf heap object; the
# field lives there under its own name — the complex-leaf read, borrowed per
# variant, with the object pointer read out of the leaf's single slot.
fun taggedReadFieldBoxed(fields: List<PStmt>, leafName: String, rootName: String,
                         leafSlots: List<CgSlotEntry>, slotFields: List<CgField>,
                         baseValue: RParam, fieldName: String, r: Resolver): RParam|None
  ret match(listAt<CgSlotEntry>(leafSlots, 0))
    (e2: CgSlotEntry) => complexReadFieldInLeaf(chain(fields), leafName, rootName,
                             RpStructField(baseValue, fieldNameAt(slotFields, e2.slotIndex)),
                             fieldName, r)
    ()                 => None   # unreachable: a boxed leaf has exactly one slot

fun taggedReadFieldInLeaf(fields: List<PStmt>, offset: Int, leafSlots: List<CgSlotEntry>,
                         slotFields: List<CgField>, baseValue: RParam, fieldName: String, r: Resolver): RParam|None
  ret taggedReadFieldInLeafLoop(chain(fields), offset, leafSlots, slotFields, baseValue, fieldName, r)

fun taggedReadFieldInLeafLoop(fields: Chain<PStmt>, offset: Int, leafSlots: List<CgSlotEntry>,
                                     slotFields: List<CgField>, baseValue: RParam, fieldName: String, r: Resolver): RParam|None
  ret match(fields)
    (nil: ChainEnd) => None
    (l: ChainLink)  => taggedReadFieldStep(l.value, l.next, offset, leafSlots, slotFields, baseValue, fieldName, r)

fun taggedReadFieldStep(field: PStmt, rest: Chain<PStmt>, offset: Int, leafSlots: List<CgSlotEntry>,
                        slotFields: List<CgField>, baseValue: RParam, fieldName: String, r: Resolver): RParam|None
  ret match(field)
    (l: PsLet) => taggedReadFieldLet(l, rest, offset, leafSlots, slotFields, baseValue, fieldName, r)
    (o: PStmt) => taggedReadFieldInLeafLoop(rest, offset, leafSlots, slotFields, baseValue, fieldName, r)

fun taggedReadFieldLet(l: PsLet, rest: Chain<PStmt>, offset: Int, leafSlots: List<CgSlotEntry>,
                       slotFields: List<CgField>, baseValue: RParam, fieldName: String, r: Resolver): RParam|None
  let fieldType = specGenerateOpt(l.lType, r)
  let nPrims = cgFlattenPrimitivesN(fieldType).n
  ret l.lName == fieldName
    ? reconstructFromSlots(fieldType, sliceList<CgSlotEntry>(leafSlots, offset, nPrims), slotFields, baseValue, 0).rfValue
    : taggedReadFieldInLeafLoop(rest, offset + nPrims, leafSlots, slotFields, baseValue, fieldName, r)

fun complexReadField(gc: GComplexEnum, baseValue: RParam, fieldName: String, r: Resolver): RParam
  ret match(gc.grcType)
    (e2: SEnum) => complexReadFieldSpec(e2, baseValue, fieldName, r)
    (o: Spec)   => RpNullPointer()   # unreachable: only ever classified from an SEnum

fun complexReadFieldSpec(e2: SEnum, baseValue: RParam, fieldName: String, r: Resolver): RParam
  ret match(soleItem(findType(r, e2.seRoot)))
    (found: Found) => match(found.fStmt)
      (root: PsEnum) => complexReadFieldOn(e2, root, baseValue, fieldName, r)
      (o: PStmt)     => RpNullPointer()   # unreachable
    ()               => RpNullPointer()   # unreachable

fun complexReadFieldOn(e2: SEnum, root: PsEnum, baseValue: RParam, fieldName: String, r: Resolver): RParam
  let leafFieldSets = collectLeafFieldSets(root, List<PStmt>())
  ret complexReadFieldLeaves(chain(e2.seAllLeaves), chain(leafFieldSets), e2.seRoot, baseValue, fieldName, r)

fun [tail] complexReadFieldLeaves(leafNames: Chain<String>, leafFieldSets: Chain<List<PStmt>>, rootName: String,
                                  baseValue: RParam, fieldName: String, r: Resolver): RParam
  ret match(leafNames)
    (nil: ChainEnd) => RpNullPointer()   # unreachable: check() guarantees the field exists on some leaf
    (l: ChainLink)  => match(leafFieldSets)
      (nil2: ChainEnd) => RpNullPointer()   # unreachable: same length as leafNames
      (lf: ChainLink)  => match(complexReadFieldInLeaf(chain(lf.value), l.value, rootName, baseValue, fieldName, r))
        (found: RParam) => found
        ()               => complexReadFieldLeaves(l.next, lf.next, rootName, baseValue, fieldName, r)

fun [tail] complexReadFieldInLeaf(fields: Chain<PStmt>, leafName: String, rootName: String, baseValue: RParam,
                          fieldName: String, r: Resolver): RParam|None
  ret match(fields)
    (nil: ChainEnd) => None
    (l: ChainLink)  => match(l.value)
      (let2: PsLet) => let2.lName == fieldName
        ? RpObjectField(specGenerateOpt(let2.lType, r), baseValue, enumLeafObjectName(rootName, leafName), let2.lName, None, false)
        : complexReadFieldInLeaf(l.next, leafName, rootName, baseValue, fieldName, r)
      (o: PStmt)    => complexReadFieldInLeaf(l.next, leafName, rootName, baseValue, fieldName, r)

# ══════════════════════════════════════════════════════════════════════════
# SECTION 9: construct_enum_value (SEnum targets only).
# ══════════════════════════════════════════════════════════════════════════

fun reprConstructEnumValue(rep: GRepr, leafName: String, fieldArgs: List<PunArg>, r: Resolver): GBundle
  ret match(rep)
    (gt: GTagged) => taggedConstructEnumValue(gt, leafName, fieldArgs, r)
    (gc: GComplexEnum) => complexConstructEnumValue(gc, leafName, fieldArgs, r)
    (gp: GPointer) => emptyBundle()   # unreachable: Python raises NotImplementedError (not an enum union)

fun [tail] indexOfString(xs: List<String>, target: String, i: Int): Int
  ret match(head(xs))
    (x: String) => x == target ? i : indexOfString(tail(xs), target, i + 1)
    ()           => 0   # unreachable: leafName is always a member (check() guarantees it)

fun [tail] fieldTypeNamed(fields: List<CgField>, name: String): CgType
  ret match(head(fields))
    (f: CgField) => f.fieldName == name ? f.fieldType : fieldTypeNamed(tail(fields), name)
    ()            => CgVoid()   # unreachable: every TaggedRepr container has a $tag field

fun tagPrecision(t: CgType): Int
  ret match(t)
    (i: CgInt)  => i.precision
    (o: CgType) => 32   # unreachable: $tag is always a CgInt

class [final] PrimStart(psName: String, psOffset: Int)

fun primStartsOf(fields: Chain<PStmt>, offset: Int, r: Resolver, acc: List<PrimStart>): List<PrimStart>
  ret build<PrimStart >(primStartsOfB(fields, offset, r, builderFrom<PrimStart>(acc)))

fun [tail] primStartsOfB(fields: Chain<PStmt>, offset: Int, r: Resolver, [terminal] acc: ListBuilder<PrimStart >): ListBuilder<PrimStart >
  ret match(fields)
    (nil: ChainEnd) => acc
    (l: ChainLink)  => match(l.value)
      (let2: PsLet) => primStartsOfB(l.next, offset + cgFlattenPrimitivesN(specGenerateOpt(let2.lType, r)).n, r,
                                    push<PrimStart >(acc, PrimStart(let2.lName, offset)))
      (o: PStmt)    => primStartsOfB(l.next, offset, r, acc)

fun [tail] primStartFor(starts: List<PrimStart>, name: String): Int
  ret match(head(starts))
    (p: PrimStart) => p.psName == name ? p.psOffset : primStartFor(tail(starts), name)
    ()              => 0   # unreachable: every field arg names a declared field

fun [tail] letNamed(fields: List<PStmt>, name: String): PStmt|None
  ret match(head(fields))
    (f: PStmt) => stmtName(f) == name ? f : letNamed(tail(fields), name)
    ()          => None

fun letTypeOf(st: PStmt|None): Spec|None
  ret match(asPsLetVariant(st))
    (l: PsLet) => l.lType
    ()          => None

class [final] EmitFlatOut(efSlots: List<RpNamedValue>, efOffset: Int)

fun emitFlat(param: RParam, ftype: CgType, variantSlots2: List<CgSlotEntry>, slotFields: List<CgField>,
            offset: Int, slots: List<RpNamedValue>): EmitFlatOut
  ret match(ftype)
    (fp: CgFuncPointer) => emitFlatFun(param, variantSlots2, slotFields, offset, slots)
    (o: CgType)          => match(cgFieldsOf(ftype))
      (fields: List<CgField>) => emitFlatStruct(param, chain(fields), variantSlots2, slotFields, offset, slots)
      ()                       => emitFlatLeaf(param, variantSlots2, slotFields, offset, slots)

# The closure deconstructs into its code word and environment pointer (the
# enum-encoding principle; union_repr.py construct_enum_value.emit_flat).
fun emitFlatFun(param: RParam, variantSlots2: List<CgSlotEntry>, slotFields: List<CgField>,
                offset: Int, slots: List<RpNamedValue>): EmitFlatOut
  ret match(listAt<CgSlotEntry>(variantSlots2, offset))
    (ef: CgSlotEntry) => match(listAt<CgSlotEntry>(variantSlots2, offset + 1))
      (eo: CgSlotEntry) => EmitFlatOut(
          setNamedValueAt(setNamedValueAt(slots,
                              fieldNameAt(slotFields, ef.slotIndex),
                              RpFunField(param, "f")),
                          fieldNameAt(slotFields, eo.slotIndex),
                          RpFunField(param, "o")),
          offset + 2)
      ()                 => EmitFlatOut(slots, offset + 2)   # unreachable
    ()                 => EmitFlatOut(slots, offset + 2)   # unreachable

fun emitFlatLeaf(param: RParam, variantSlots2: List<CgSlotEntry>, slotFields: List<CgField>,
                 offset: Int, slots: List<RpNamedValue>): EmitFlatOut
  ret match(listAt<CgSlotEntry>(variantSlots2, offset))
    (e2: CgSlotEntry) => EmitFlatOut(setNamedValueAt(slots, fieldNameAt(slotFields, e2.slotIndex), param), offset + 1)
    ()                 => EmitFlatOut(slots, offset + 1)   # unreachable

fun emitFlatStruct(param: RParam, fields: Chain<CgField>, variantSlots2: List<CgSlotEntry>, slotFields: List<CgField>,
                         offset: Int, slots: List<RpNamedValue>): EmitFlatOut
  ret match(fields)
    (nil: ChainEnd) => EmitFlatOut(slots, offset)
    (l: ChainLink)  => emitFlatStructStep(param, l, variantSlots2, slotFields, offset, slots)

fun emitFlatStructStep(param: RParam, l: ChainLink<CgField>, variantSlots2: List<CgSlotEntry>,
                       slotFields: List<CgField>, offset: Int, slots: List<RpNamedValue>): EmitFlatOut
  let sub = emitFlat(RpStructField(param, l.value.fieldName), l.value.fieldType, variantSlots2, slotFields, offset, slots)
  ret emitFlatStruct(param, l.next, variantSlots2, slotFields, sub.efOffset, sub.efSlots)

fun taggedConstructEnumValue(gt: GTagged, leafName: String, fieldArgs: List<PunArg>, r: Resolver): GBundle
  ret match(gt.grtType)
    (e2: SEnum) => taggedConstructEnumValueOn(gt, e2, leafName, fieldArgs, r)
    (o: Spec)   => emptyBundle()   # unreachable: only ever classified from an SEnum

fun taggedConstructEnumValueOn(gt: GTagged, e2: SEnum, leafName: String, fieldArgs: List<PunArg>, r: Resolver): GBundle
  ret match(soleItem(findType(r, e2.seRoot)))
    (found: Found) => match(found.fStmt)
      (root: PsEnum) => taggedConstructEnumValueRoot(gt, e2, root, leafName, fieldArgs, r)
      (o: PStmt)     => emptyBundle()   # unreachable
    ()                => emptyBundle()   # unreachable

fun taggedConstructEnumValueRoot(gt: GTagged, e2: SEnum, root: PsEnum, leafName: String, fieldArgs: List<PunArg>, r: Resolver): GBundle
  let leafIdx = indexOfString(e2.seAllLeaves, leafName, 0)
  let leafFields = forceNth(collectLeafFieldSets(root, List<PStmt>()), leafIdx)
  let container = gt.grtContainer
  let slotFields = forceFields(container)
  let tagConst = RpInteger(leafIdx, tagPrecision(fieldTypeNamed(slotFields, "$tag")))
  let zeroSlots = map(slotFields, (f: CgField) => RpNamedValue(f.fieldName, RpZeroOf(f.fieldType)))
  let taggedSlots = setNamedValueAt(zeroSlots, "$tag", tagConst)
  if isBoxedLeaf(r, e2.seRoot, leafName)
    ret taggedConstructBoxed(e2, leafFields, leafName, fieldArgs,
                             forceNth(gt.grtVariantMap, leafIdx),
                             slotFields, taggedSlots, container, r)
  let primStarts = primStartsOf(chain(leafFields), 0, r, List<PrimStart>())
  let step = taggedConstructFields(chain(fieldArgs), leafFields, primStarts, forceNth(gt.grtVariantMap, leafIdx),
                                  slotFields, taggedSlots, r,
                                  builder<GBundle >())
  ret bundleJoin(bundleJoinAll(step.tcBundles), bundleValue(unionStruct(container, step.tcSlots)))

# Boxed leaf (payload over the value-struct threshold): allocate the
# per-leaf heap object — the complex-leaf construction, borrowed per
# variant, ZeroOf for unwritten fields so staticinit can promote
# all-constant constructions — then the pool carries the pointer in the
# leaf's single slot, tagged as usual. Field args coerce into their
# declared types (genExprTo), exactly as the flat path does.
fun taggedConstructBoxed(e2: SEnum, leafFields: List<PStmt>, leafName: String,
                         fieldArgs: List<PunArg>, variantSlots2: List<CgSlotEntry>,
                         slotFields: List<CgField>, taggedSlots: List<RpNamedValue>,
                         container: CgType, r: Resolver): GBundle
  let objName = enumLeafObjectName(e2.seRoot, leafName)
  let objVar = RpStackVar(CgDataPointer(), "boxed")
  let step = bxConstructFields(chain(leafFields), objName, objVar, fieldArgs, r,
                               CcAcc(builder<Op >(), builder<GBundle >()))
  let ops = concat(list1<Op>(OpNewObject(objName, objVar, None, List<RParam>())), step.ccOps)
  let allocBundle = GBundle(list1(objVar), ops, objVar, List<RecurSource>(), List<ExitSource>())
  ret match(listAt<CgSlotEntry>(variantSlots2, 0))
    (se: CgSlotEntry) => bundleJoin(bundleJoinAll(step.ccBundles),
                             bundleJoin(allocBundle,
                                 bundleValue(unionStruct(container,
                                     setNamedValueAt(taggedSlots,
                                                     fieldNameAt(slotFields, se.slotIndex),
                                                     objVar)))))
    ()                 => emptyBundle()   # unreachable: a boxed leaf has exactly one slot

# complexConstructFields with genExprTo: the flat construct path coerces
# each argument into the field's declared type, and the boxed borrow keeps
# that behaviour (Python taggedConstruct's generate_to).
fun [tail] bxConstructFields(fields: Chain<PStmt>, objName: String, resultVar: RParam,
                             fieldArgs: List<PunArg>, r: Resolver, [terminal] acc: CcAcc): ComplexConstructOut
  ret match(fields)
    (nil: ChainEnd) => ComplexConstructOut(build<Op >(acc.caOps),
                                           build<GBundle >(acc.caBundles))
    (l: ChainLink)  => match(l.value)
      (let2: PsLet) => bxConstructField(let2, l.next, objName, resultVar,
                                        fieldArgs, r, acc)
      (o: PStmt)    => bxConstructFields(l.next, objName, resultVar,
                                         fieldArgs, r, acc)

fun bxConstructField(let2: PsLet, rest: Chain<PStmt>, objName: String, resultVar: RParam,
                     fieldArgs: List<PunArg>, r: Resolver, [terminal] acc: CcAcc): ComplexConstructOut
  let fieldType = specGenerateOpt(let2.lType, r)
  ret match(punArgNamed(fieldArgs, let2.lName))
    (pa: PunArg) => bxConstructFieldArg(pa, let2, fieldType, rest, objName,
                                        resultVar, fieldArgs, r, acc)
    ()            => bxConstructFields(rest, objName, resultVar, fieldArgs, r,
                       CcAcc(push<Op >(acc.caOps,
                                 OpMove(RpObjectField(fieldType, resultVar,
                                            objName, let2.lName, None, true),
                                        RpZeroOf(fieldType), false,
                                        List<RParam>())),
                             acc.caBundles))

fun bxConstructFieldArg(pa: PunArg, let2: PsLet, fieldType: CgType, rest: Chain<PStmt>, objName: String,
                        resultVar: RParam, fieldArgs: List<PunArg>, r: Resolver, [terminal] acc: CcAcc): ComplexConstructOut
  let argBundle = withPrefix(genExprTo(pa.paExpr, r, let2.lType), "arg_" + bareName(let2.lName))
  ret bxConstructFields(rest, objName, resultVar, fieldArgs, r,
          CcAcc(push<Op >(acc.caOps,
                    OpMove(RpObjectField(fieldType, resultVar, objName, let2.lName, None, true),
                           mustResult(argBundle), false, List<RParam>())),
                push<GBundle >(acc.caBundles, argBundle)))

class [final] TaggedConstructOut(tcBundles: List<GBundle>, tcSlots: List<RpNamedValue>)

fun taggedConstructFields(args: Chain<PunArg>, leafFields: List<PStmt>, primStarts: List<PrimStart>,
                                 variantSlots2: List<CgSlotEntry>, slotFields: List<CgField>,
                                 slots: List<RpNamedValue>, r: Resolver, [terminal] bundles: ListBuilder<GBundle >): TaggedConstructOut
  ret match(args)
    (nil: ChainEnd) => TaggedConstructOut(build<GBundle >(bundles), slots)
    (l: ChainLink)  => taggedConstructFieldsStep(l, leafFields, primStarts, variantSlots2, slotFields, slots, r, bundles)

fun taggedConstructFieldsStep(l: ChainLink<PunArg>, leafFields: List<PStmt>, primStarts: List<PrimStart>,
                              variantSlots2: List<CgSlotEntry>, slotFields: List<CgField>,
                              slots: List<RpNamedValue>, r: Resolver, [terminal] bundles: ListBuilder<GBundle >): TaggedConstructOut
  let fieldName = l.value.paName
  let fieldType = letTypeOf(letNamed(leafFields, fieldName))
  let argBundle = withPrefix(genExprTo(l.value.paExpr, r, fieldType), "arg_" + bareName(fieldName))
  let pi = primStartFor(primStarts, fieldName)
  let ef = emitFlat(mustResult(argBundle), specGenerateOpt(fieldType, r), variantSlots2, slotFields, pi, slots)
  ret taggedConstructFields(l.next, leafFields, primStarts, variantSlots2,
                            slotFields, ef.efSlots, r,
                            push<GBundle >(bundles, argBundle))

fun complexConstructEnumValue(gc: GComplexEnum, leafName: String, fieldArgs: List<PunArg>, r: Resolver): GBundle
  ret match(gc.grcType)
    (e2: SEnum) => complexConstructEnumValueOn(e2, leafName, fieldArgs, r)
    (o: Spec)   => emptyBundle()   # unreachable

fun complexConstructEnumValueOn(e2: SEnum, leafName: String, fieldArgs: List<PunArg>, r: Resolver): GBundle
  ret match(soleItem(findType(r, e2.seRoot)))
    (found: Found) => match(found.fStmt)
      (root: PsEnum) => complexConstructEnumValueRoot(e2, root, leafName, fieldArgs, r)
      (o: PStmt)     => emptyBundle()   # unreachable
    ()                => emptyBundle()   # unreachable

fun complexConstructEnumValueRoot(e2: SEnum, root: PsEnum, leafName: String, fieldArgs: List<PunArg>, r: Resolver): GBundle
  let leafIdx = indexOfString(e2.seAllLeaves, leafName, 0)
  let leafFields = forceNth(collectLeafFieldSets(root, List<PStmt>()), leafIdx)
  let objName = enumLeafObjectName(e2.seRoot, leafName)
  let resultVar = RpStackVar(CgDataPointer(), "result")
  let step = complexConstructFields(chain(leafFields), objName, resultVar,
                                    fieldArgs, r,
                                    CcAcc(builder<Op >(), builder<GBundle >()))
  let ops = concat(list1<Op>(OpNewObject(objName, resultVar, None, List<RParam>())), step.ccOps)
  let ctorBundle = GBundle(list1(resultVar), ops, resultVar, List<RecurSource>(), List<ExitSource>())
  ret bundleJoin(bundleJoinAll(step.ccBundles), ctorBundle)

class [final] ComplexConstructOut(ccOps: List<Op>, ccBundles: List<GBundle>)

# Both lists while they are being built: the field stores in program order and
# the argument bundles in the order they are emitted.
class [linear, final] CcAcc(caOps: ListBuilder<Op >,
                            caBundles: ListBuilder<GBundle >)

fun [tail] complexConstructFields(fields: Chain<PStmt>, objName: String, resultVar: RParam, fieldArgs: List<PunArg>,
                                  r: Resolver, [terminal] acc: CcAcc): ComplexConstructOut
  ret match(fields)
    (nil: ChainEnd) => ComplexConstructOut(build<Op >(acc.caOps),
                                           build<GBundle >(acc.caBundles))
    (l: ChainLink)  => match(l.value)
      (let2: PsLet) => complexConstructField(let2, l.next, objName, resultVar,
                                            fieldArgs, r, acc)
      (o: PStmt)    => complexConstructFields(l.next, objName, resultVar,
                                              fieldArgs, r, acc)

fun complexConstructField(let2: PsLet, rest: Chain<PStmt>, objName: String, resultVar: RParam, fieldArgs: List<PunArg>,
                          r: Resolver, [terminal] acc: CcAcc): ComplexConstructOut
  let fieldType = specGenerateOpt(let2.lType, r)
  ret match(punArgNamed(fieldArgs, let2.lName))
    (pa: PunArg) => complexConstructFieldWithArg(pa, let2, fieldType, rest,
                        objName, resultVar, fieldArgs, r, acc)
    # No argument for this field: it is zero-filled in place.
    ()            => complexConstructFields(rest, objName, resultVar, fieldArgs, r,
                       CcAcc(push<Op >(acc.caOps,
                                 OpMove(RpObjectField(fieldType, resultVar,
                                            objName, let2.lName, None, true),
                                        RpZeroOf(fieldType), false,
                                        List<RParam>())),
                             acc.caBundles))

fun complexConstructFieldWithArg(pa: PunArg, let2: PsLet, fieldType: CgType, rest: Chain<PStmt>, objName: String,
                                 resultVar: RParam, fieldArgs: List<PunArg>, r: Resolver, [terminal] acc: CcAcc): ComplexConstructOut
  let argBundle = withPrefix(genExpr(pa.paExpr, r), "arg_" + bareName(let2.lName))
  ret complexConstructFields(rest, objName, resultVar, fieldArgs, r,
          CcAcc(push<Op >(acc.caOps,
                    OpMove(RpObjectField(fieldType, resultVar, objName, let2.lName, None, true),
                           mustResult(argBundle), false, List<RParam>())),
                push<GBundle >(acc.caBundles, argBundle)))

fun [tail] punArgNamed(args: List<PunArg>, name: String): PunArg|None
  ret match(head(args))
    (a: PunArg) => a.paName == name ? a : punArgNamed(tail(args), name)
    ()           => None
