# bootstrap/generate_stmt.yafl — statement-side generate, ported from
# pyast/statement/control.py (Return/Action/If) and pyast/statement/lets.py
# (Let + the [lazy] two-phase halves, Destructure, to_c_destructure). The
# global_codegen trio (function/class/enum/let globals) is NOT here — it ports
# with the __create_c_code driver stage.
#
# genBlockTo (generate_expr.yafl) drives these through the genStmt/
# genStmtLazyAlloc/genStmtLazyPopulate dispatch points, replacing the stubs
# the expression-generate port left loud.
#
# irMangle parity: struct field signatures hash via sha1Hex (hashes.yafl),
# byte-identical to Python's hashlib.sha1(sig).hexdigest()[:16] — pinned by
# tests/test_bootstrap_sha1.py.
#
# LAYOUT: each node kind's own generate lives with the rest of that node in
# bootstrap/nodes/ (one file per kind, as pyast/); this file keeps the
# helpers several node kinds share.
namespace Bootstrap::Codegen

import System
import System::Containers

import Bootstrap::Ast
import Bootstrap::Ir
import Bootstrap::Frontend
import Bootstrap::Lower::Ast
import Bootstrap::Resolve
import Bootstrap::StdlibCandidates
import Bootstrap::Nodes


# ── dispatch ────────────────────────────────────────────────────────────────

# ── FieldAssignStatement (control.py) ───────────────────────────────────────

# ── ReturnStatement (control.py) ────────────────────────────────────────────

# ── IfStatement (control.py) ────────────────────────────────────────────────

# ── LetStatement (lets.py) ──────────────────────────────────────────────────

fun genExprToOpt(x: PExpr|None, r, expected) => match(x)
  (e2: PExpr) => genExprTo(e2, r, expected)
  ()           => emptyBundle()

# ── [lazy] two-phase halves (lets.py) ───────────────────────────────────────

fun gsStmtLazyAlloc(st, r) => match(st)
  (l: PsLet) => genLazyAlloc(l, r)
  (o: PStmt) => bundleOp1(OpAbort("generate_lazy_alloc on a non-let", Dict()))

# Stub allocation half — at block entry, so forward references inside other
# lazies see the stub slot pointing at a real heap object.
fun genLazyAlloc(l: PsLet, r)
  let irT = specGenerateOpt(l.lType, r)
  let cls = stubClassName(irT)
  let svStub = RpStackVar(CgDataPointer(false), l.lName)
  let flagF = RpObjectField(CgDataPointer(false), svStub, cls, "flag", None, true, false)
  let closureF = RpObjectField(CgFuncPointer(false, false), svStub, cls, "closure", None, true, false)
  ret GBundle(list1(svStub),
              arrayOf<Op>(OpNewObject(cls, svStub, None, false, Dict()),
                          OpMove(flagF, RpNullPointer(), false, Dict()),
                          OpMove(closureF, RpZeroOf(CgFuncPointer(false, false)), false, Dict())),
              None, List(), List())

fun gsStmtLazyPopulate(st, r) => match(st)
  (l: PsLet) => genLazyPopulate(l, r)
  (o: PStmt) => bundleOp1(OpAbort("generate_lazy_populate on a non-let", Dict()))

# Closure-population half — at the let's original textual position. The
# lambdas pass has already turned the RHS into a fun_t-valued expression and
# the stub slot is bound.
fun genLazyPopulate(l: PsLet, r)
  let irT = specGenerateOpt(l.lType, r)
  let cls = stubClassName(irT)
  let closureBundle = withPrefix(genExprToOpt(l.lDefault, r, None), "closure")
  let svStub = RpStackVar(CgDataPointer(false), l.lName)
  let closureF = RpObjectField(CgFuncPointer(false, false), svStub, cls, "closure", None, false, false)
  let moveOp = OpMove(closureF, mustResult(closureBundle), false, Dict())
  ret hasAttr(l.lAttrs, "future")
    ? bundleJoin(closureBundle, genFuturePost(irT, svStub, moveOp))
    : bundleJoin(closureBundle,
                 GBundle(List(), arrayOf<Op>(moveOp), None, List(), List()))

# `[future]`: hand the populated stub to the worker pool. Must follow the
# closure Move — a worker may fire immediately.
fun genFuturePost(irT, svStub, moveOp)
  let svDiscard = RpStackVar(CgDataPointer(false), "$sv_future_discard")
  let post = RpRuntimeInvoke("future_post",
                             RpNewStruct(list1(RpNamedValue("cb", RpGlobalFunction(futureRunnerName(irT), svStub, false, None, false, false)))),
                             CgDataPointer(false))
  ret GBundle(list1(svDiscard),
              arrayOf<Op>(moveOp, OpMove(svDiscard, post, true, Dict())),
              None, List(), List())

fun stubClassName(t2) => "Lazy$" + irMangle(t2)

fun futureRunnerName(t2) => "future_run$" + irMangle(t2)

# ── DestructureStatement (lets.py) ──────────────────────────────────────────

fun dPureTupleType(d: PsDestructure) => STuple(map(d.dTargets, dTargetEntry), noLine())

fun dTargetEntry(st) => match(st)
  (l: PsLet)         => SEntry(l.lName, l.lType, l.lDefault)
  (d2: PsDestructure) => SEntry(d2.dName, dPureTupleType(d2), d2.dDefault)
  (o: PStmt)         => SEntry("", None, None)   # unreachable: targets are lets

# to_c_destructure: leaf let → Move into a stack var named for the let;
# destructure → per-target f{i} prefixed moves off `_i` struct fields.
fun toCDestructureTargets(d: PsDestructure, root, r)
  ret tcdLoop(d.dTargets, root, r, 0, emptyBundle())

# State fields named to match another fold over the same types — workaround for #88.
fun tcdLoop(ts: List<PStmt>, root, r, i, acc: GBundle)
  ret fold(ts, (acc = acc, i = i),
           (st, t) =>
             (acc = bundleJoin(st.acc, withPrefix(tcdTarget(t, RpStructField(root, "_" + String(st.i)), r),
                                                  "f" + String(st.i))),
              i = st.i + 1)).acc

fun tcdTarget(st, root, r) => match(st)
  (l: PsLet)          => tcdLeaf(l, root, r)
  (d2: PsDestructure) => toCDestructureTargets(d2, root, r)
  (o: PStmt)          => emptyBundle()

fun tcdLeaf(l: PsLet, root, r)
  let sv = RpStackVar(specGenerateOpt(l.lType, r), l.lName)
  ret GBundle(list1(sv), arrayOf<Op>(OpMove(sv, root, false, Dict())),
              None, List(), List())
