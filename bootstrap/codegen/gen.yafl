# bootstrap/gen.yafl — the Application C-emission assembly, ported from
# codegen/gen.py: per-function cleanup + prototype/implement emission,
# per-object hashed vtables (typedef + VTABLE_DECLARE with linear probing) in
# extends order, per-global emission with GC-root path collection, the
# _declare_roots chain and main(), all threaded through ONE type cache in
# Python's exact sequence — anonymous-struct numbering depends on it.
# gen() validation of __entrypoint__'s shape lives in the driver.
namespace Bootstrap::Codegen

import System

import Bootstrap::Ast

import Bootstrap::Driver
import Bootstrap::Ir
import Bootstrap::Lower::Ir
import Bootstrap::Parse
import Bootstrap::Resolve
import Bootstrap::StdlibCandidates
import Bootstrap::Types



# ── pointer paths (typedecl get_pointer_paths) ───────────────────────────────

fun cgTypePointerPaths(t2: CgType, path: String): List<String>
  ret match(t2)
    (d: CgDataPointer)      => list1(path)
    (fp: CgFuncPointer)     => list1(path + ".o")
    (s2: CgStruct)          => cgPathsFields(s2.fields, path)
    (im: CgImmediateStruct) => cgPathsFields(im.fields, path)
    (o: CgType)             => List<String>()

fun cgPathsFields(fields: List<CgField>, path: String): List<String>
  ret fold(fields, List<String>(), (acc: List<String>, f2: CgField) =>
        concat(acc, cgTypePointerPaths(f2.fieldType, path + "." + mangleName(f2.fieldName))))

# ── function-id enum ─────────────────────────────────────────────────────────

fun genFunctionIds(methodIds: List<MethodId>): String
  if isEmpty(methodIds)
    ret ""
  ret "enum {" + join(map(methodIds, (m: MethodId) =>
        "\n    __FUNCTION_ID__" + mangleName(m.mName) + " = rotate_function_id(" + String(m.mId) + ")"), ",")
      + "\n};\n"

fun miIdOf(methodIds: List<MethodId>, name: String): Int
  ret match(head(filter(methodIds, (m: MethodId) => m.mName == name)))
    (m: MethodId) => m.mId
    ()             => 0   # unreachable: every slot id was assigned

fun vsSizeOf(sizes: List<VtableSize>, name: String): Int
  ret match(head(filter(sizes, (v: VtableSize) => v.vsClassName == name)))
    (v: VtableSize) => v.vsSize
    ()               => 1   # unreachable: sizes computed for every object

# ── the emission accumulator (Python's per-Application string lists) ─────────

# The five C sections as they are emitted. Every one of them is ORDERED — the
# order is the order of the output file — so each is a builder: appending a
# function's text to a section copied the whole section, once per function of
# the program, and this runs over every function, object and global.
#
# [linear,final] because it holds builders; the cache rides along as a plain
# value, threaded rather than accumulated.
class [linear, final] GenAcc(gaCache: List<CgCacheEntry>,
                             gaTypedefs: ListBuilder<String >,
                             gaForwards: ListBuilder<String >,
                             gaVariables: ListBuilder<String >,
                             gaFunctions: ListBuilder<String >,
                             gaGcRoots: ListBuilder<String >)

fun genAccEmpty(): GenAcc
  ret GenAcc(List<CgCacheEntry>(), builder<String >(), builder<String >(),
             builder<String >(), builder<String >(), builder<String >())

# ── per-function: cleanup chain then prototype + implement ───────────────────

fun genFunction([terminal] acc: GenAcc, f0: CgFunction, profId: Int|None): GenAcc
  # SSA → imperative first (Phi → per-edge Moves while the CFG is intact);
  # everything downstream is Phi-unaware.
  let f = cgFunctionEliminateCSE(cgFunctionSimplifyControlFlow(cgFunctionCopyPropagate(
            cgFunctionFoldStructFields(cgFunctionSimplifyControlFlow(
              cgFunctionStripUnusedOperations(cgFunctionLowerPhis(f0)))))))
  # --profile instrumentation goes in LAST, after the cleanup chain, so
  # nothing can merge, move or delete the enter/leave pairing (gen.py
  # __gen_function's exact position).
  let fi = match(profId)
    (id2: Int) => cgFunctionInstrumentProfile(f, id2)
    ()          => f
  let proto = cgFunctionToCPrototype(fi, acc.gaCache)
  let impl = cgFunctionToCImplement(fi, proto.cache)
  ret GenAcc(impl.cache, acc.gaTypedefs,
             push<String >(acc.gaForwards, proto.text), acc.gaVariables,
             push<String >(acc.gaFunctions, impl.text), acc.gaGcRoots)

fun genExtern([terminal] acc: GenAcc, f: CgFunction): GenAcc
  let ext = cgFunctionToCExtern(f, acc.gaCache)
  ret GenAcc(ext.cache, acc.gaTypedefs, push<String >(acc.gaForwards, ext.text),
             acc.gaVariables, acc.gaFunctions, acc.gaGcRoots)

# ── extends-order object walk (DFS, insertion tie-break, pre-marked) ─────────

# The emission order (parents before children) and the visited marks. The
# order is a builder — it is the order objects reach the C file — and `seen`
# is asked only whether a name has been visited, so it is a Set.
class [linear, final] ObjOrder(ooOrder: ListBuilder<CgObject >,
                               ooSeen: Set<String >)

fun objectsInExtendsOrder(a: CgApp): List<CgObject>
  ret build<CgObject >(objVisitAll(chain(appObjects(a)), a,
                           ObjOrder(builder<CgObject >(),
                                    Set<String >())).ooOrder)

fun [tail] objVisitAll(os: Chain<CgObject>, a: CgApp,
                       [terminal] acc: ObjOrder): ObjOrder
  ret match(os)
    (nil: ChainEnd) => acc
    (l: ChainLink)  => objVisitAll(l.next, a,
                                   objVisit(acc, l.value.objName, a))

fun objVisit([terminal] acc: ObjOrder, name: String, a: CgApp): ObjOrder
  if contains<String >(acc.ooSeen, name)
    ret acc
  # Pre-mark: extends cycles terminate; foreign/extern parents not in the
  # registry are marked and skipped rather than emitted.
  let marked = ObjOrder(acc.ooOrder, add<String >(acc.ooSeen, name))
  ret match(appObject(a, name))
    (o: CgObject) => objVisitParents(marked, o, a)
    ()             => marked

fun objVisitParents([terminal] acc: ObjOrder, o: CgObject, a: CgApp): ObjOrder
  ret objVisitOne(chain(o.objExtends), a, acc)
    |> (afterParents) => ObjOrder(push<CgObject >(afterParents.ooOrder, o),
                                  afterParents.ooSeen)

fun [tail] objVisitOne(ps: Chain<String>, a: CgApp,
                       [terminal] acc: ObjOrder): ObjOrder
  ret match(ps)
    (nil: ChainEnd) => acc
    (l: ChainLink)  => objVisitOne(l.next, a, objVisit(acc, l.value, a))

# ── per-object: hashed vtable + typedef + VTABLE_DECLARE ─────────────────────

class [final] VtRow(vtI: String, vtF: String)

# One walk each: the rendered C fragment AND the count the macro argument
# needs (no-length ruling — counts ride existing walks, joins unchanged).
fun [tail] vtRowsText(rs: Chain<VtRow>, n: Int, acc: String): (n: Int, text: String)
  ret match(rs)
    (nil: ChainEnd) => (n, acc)
    (l: ChainLink)  => vtRowsText(l.next, n + 1,
                         (acc == "" ? "" : acc + ",")
                         + "\n        { .i = " + l.value.vtI
                         + ", .f = " + l.value.vtF + " }")

fun [tail] vtImplText(es: Chain<String>, n: Int, acc: String): (n: Int, text: String)
  ret match(es)
    (nil: ChainEnd) => (n, acc)
    (l: ChainLink)  => vtImplText(l.next, n + 1,
                         (acc == "" ? "" : acc + ", ")
                         + "obj_" + mangleName(l.value))

# Method names AND their count from one walk (no-length ruling).
fun vtEntryOf(o: CgObject): VtableEntry
  let ms = vtMethodsOf(chain(o.objFunctions), 0, builder<String >())
  ret VtableEntry(o.objName, ms.names, ms.n)

fun [tail] vtMethodsOf(fs: Chain<CgFuncSlot>, n: Int,
                       [terminal] acc: ListBuilder<String >): (names: List<String>, n: Int)
  ret match(fs)
    (nil: ChainEnd) => (build<String >(acc), n)
    (l: ChainLink)  => vtMethodsOf(l.next, n + 1,
                                   push<String >(acc, l.value.slotVirtualName))

fun vtDefaultRow(): VtRow
  ret VtRow("-1", "(void*)&abort_on_vtable_lookup")

fun vtIsDefault(r: VtRow): Bool
  ret r.vtI == "-1"

fun genObject([terminal] acc: GenAcc, o: CgObject, methodIds: List<MethodId>,
              sizes: List<VtableSize>): GenAcc
  let vtableSize = vsSizeOf(sizes, o.objName)
  let rows0 = vtRows(vtableSize, List<VtRow>())
  let rows1 = fold(o.objFunctions, rows0, (rs: List<VtRow>, s2: CgFuncSlot) =>
                vtPlace(rs, s2, methodIds, vtableSize))
  # Ensure the last entry is an empty catch-all.
  # The catch-all must be LAST, so when it is missing it is pushed on the end.
  let rows = vtLastIsDefault(rows1)
    ? rows1
    : build<VtRow >(push<VtRow >(_pushChain<VtRow >(builder<VtRow >(),
                                                    chain<VtRow>(rows1)),
                                 vtDefaultRow()))
  let mangled = mangleName(o.objName)
  # Counts ride the SAME walks that render the text (no-length ruling):
  # one pass produces both the joined C fragment and the number the macro
  # argument needs.
  let impl = vtImplText(chain(o.objExtends), 0, "")
  let vt = vtRowsText(chain(rows), 0, "")
  let commentLine = cgObjectCommentLine(o)
  let typedefDecl = cgDeclare(o.objFields, acc.gaCache)
  let typedefs1 = push<String >(acc.gaTypedefs,
        commentLine + "typedef " + typedefDecl.text + " ALIGNED " + mangled + "_t;\n")
  let arrElSize = cgObjectGetArrayElSize(o, typedefDecl.cache)
  let arrPtrMask = cgObjectGetArrayPointerMask(o, arrElSize.cache)
  let masks = genObjectMasks(o, commentLine, mangled)
  let variables1 = push<String >(_pushChain<String >(acc.gaVariables,
                                     chain<String>(masks.gmVarLines)),
        (commentLine + "static vtable_t* const obj_" + mangled
              + " = VTABLE_DECLARE(" + String(vt.n) + "){\n"
              + "    .object_size = " + cgObjectGetObjectSize(o) + ",\n"
              + "    .array_el_size = " + arrElSize.text + ",\n"
              + "    .functions_mask = rotate_function_id(" + String(vtableSize - 1) + "),\n"
              + "    .object_pointer_locations = " + cgObjectGetPointerMask(o) + ",\n"
              + "    .array_el_pointer_locations = " + arrPtrMask.text + ",\n"
              + masks.gmMasksInit
              + "    .array_len_offset = " + genArrayLenOffset(o) + ",\n"
              + "    .is_mutable = " + (o.objIsMutable ? "1" : "0") + ",\n"
              + "    .discriminator = " + String(o.objDiscriminator) + ",\n"
              + "    .name = \"" + o.objName + "\",\n"
              + "    .implements_array = VTABLE_IMPLEMENTS(" + String(impl.n)
              + ", " + impl.text + "),\n"
              + "    .lookup = { " + vt.text + " },\n"
              + "};\n"))
  ret GenAcc(arrPtrMask.cache, typedefs1,
             push<String >(acc.gaForwards, commentLine + "static vtable_t* const obj_" + mangled + ";\n"),
             variables1, acc.gaFunctions, acc.gaGcRoots)

# n copies of the catch-all row. Prepended, not appended: every element is the
# same value, so which end they go on cannot be observed.
fun [tail] vtRows(n: Int, acc: List<VtRow>): List<VtRow>
  if n <= 0
    ret acc
  ret vtRows(n - 1, prepend(vtDefaultRow(), acc))

# Is the LAST row the catch-all? (An empty table has nothing to guard.)
fun vtLastIsDefault(rows: List<VtRow>): Bool
  ret vtLastLoop(chain(rows), true)

fun [tail] vtLastLoop(rs: Chain<VtRow>, sofar: Bool): Bool
  ret match(rs)
    (nil: ChainEnd) => sofar
    (l: ChainLink)  => vtLastLoop(l.next, vtIsDefault(l.value))

# id & (size-1), linear probe past occupied rows, growing as needed.
fun vtPlace(rows: List<VtRow>, s2: CgFuncSlot, methodIds: List<MethodId>, size: Int): List<VtRow>
  let id = miIdOf(methodIds, s2.slotVirtualName)
  ret vtProbe(rows, id & (size - 1),
              VtRow("__FUNCTION_ID__" + mangleName(s2.slotVirtualName),
                    "(void*)&" + mangleName(s2.slotGlobalName)))

# ONE walk places the row: skip to `index`, then probe forward to the first
# default slot, splicing the new row in where it lands (or appending when the
# probe runs off the end). The old form re-indexed and rebuilt the whole table
# per probe step.
fun vtProbe(rows: List<VtRow>, index: Int, row: VtRow): List<VtRow>
  ret build<VtRow >(vtProbeLoop(chain(rows), index, row, builder<VtRow >()))

# The rows walked so far are re-emitted in place, so they go into a builder;
# the table is index-addressed, so this order IS the table.
fun [tail] vtProbeLoop(rest: Chain<VtRow>, index: Int, row: VtRow,
                       [terminal] seen: ListBuilder<VtRow >): ListBuilder<VtRow >
  ret match(rest)
    (nil: ChainEnd) => push<VtRow >(seen, row)
    (l: ChainLink)  => index > 0
      ? vtProbeLoop(l.next, index - 1, row, push<VtRow >(seen, l.value))
      : vtIsDefault(l.value)
        ? _pushChain<VtRow >(push<VtRow >(seen, row), l.next)
        : vtProbeLoop(l.next, index, row, push<VtRow >(seen, l.value))

fun genArrayLenOffset(o: CgObject): String
  ret match(o.objLengthField)
    (l: String) => "offsetof(" + mangleName(o.objName) + "_t, " + mangleName(l) + ")"
    ()           => "0"

class [final] GenMasks(gmVarLines: List<String>, gmMasksInit: String)

# Objects wider than 64 slots carry the rest of the pointer map in a static
# window array; window 0 duplicates the inline word.
fun genObjectMasks(o: CgObject, commentLine: String, mangled: String): GenMasks
  let nwindows = cgObjectGetPointerMaskWindowCount(o)
  if nwindows <= 1
    ret GenMasks(List<String>(), "")
  let masksName = "pmasks_" + mangled
  let windows = join(build<String >(genMaskWindows(o, nwindows, 0,
                                                  builder<String >())),
                     ",\n    ")
  ret GenMasks(list1(commentLine + "static const ptr_mask_t " + masksName + "[" + String(nwindows)
                     + "] = {\n    " + windows + "\n};\n"),
               "    .object_pointer_masks = " + masksName + ",\n"
               + "    .object_pointer_mask_words = " + String(nwindows) + ",\n")

# Window w of the pointer mask, low word first — the order is the array's.
fun [tail] genMaskWindows(o: CgObject, n: Int, w: Int,
                          [terminal] acc: ListBuilder<String >): ListBuilder<String >
  if w >= n
    ret acc
  ret genMaskWindows(o, n, w + 1,
                     push<String >(acc, cgObjectGetPointerMaskWindow(o, w)))

# ── per-global: emission + GC roots ──────────────────────────────────────────

fun genGlobal([terminal] acc: GenAcc, g2: CgGlobal, a: CgApp): GenAcc
  # to_c_prototype: the FULL dispatch (static-object globals tentatively
  # declare their `<name>_data` struct too) plus the ";\n" terminator —
  # not the bare Plain form.
  let proto = cgGlobalToCPrototype(g2, acc.gaCache)
  let impl = cgGlobalToCImplement(g2, proto.cache)
  let roots = genGlobalRoots(g2, a)
  ret GenAcc(impl.cache, acc.gaTypedefs, push<String >(acc.gaForwards, proto.text),
             push<String >(acc.gaVariables, impl.text), acc.gaFunctions,
             _pushChain<String >(acc.gaGcRoots, chain<String>(roots)))

fun genGlobalRoots(g2: CgGlobal, a: CgApp): List<String>
  # Old-style lazy global: the value lives directly in the slot.
  if isNoneStr(g2.globalObjectName) && !isNoneStr(g2.globalLazyInitFunction)
    ret cgTypePointerPaths(g2.globalType, cgGlobalToCName(g2))
  # Static class-instance global: register the <name>_data in-struct pointer
  # field addresses (skip the leading vtable `type` field). INTERNED STRING
  # LITERALS are not roots: compile-time constants, bytes in .data, never
  # written after static initialisation — they alone put thousands of dead
  # roots into every cycle's scan. (Pruning ALL frozen statics broke the
  # runtime — a non-string static holds a heap pointer; tracked separately.)
  if !isNoneStr(g2.globalObjectName) && !isNoneR2(g2.globalInit)
     && !(isNoneStr(g2.globalLazyInitFunction)
          && startsWith(g2.globalName, "$strings::"))
    ret genStaticInstanceRoots(g2, a)
  ret List<String>()

fun isNoneR2(r: RParam|None): Bool
  ret match(r)
    (x: RParam) => false
    ()           => true

fun genStaticInstanceRoots(g2: CgGlobal, a: CgApp): List<String>
  ret match(g2.globalObjectName)
    (objName: String) => match(appObject(a, objName))
      (cls: CgObject) => genStaticRootsFields(cls, g2)
      ()               => List<String>()
    ()                 => List<String>()

fun genStaticRootsFields(cls: CgObject, g2: CgGlobal): List<String>
  let fields = cgFieldsOfOrEmpty(cls.objFields)
  if atMost(chain(fields), 1)
    ret List<String>()
  ret cgPathsFields(tail(fields), cgGlobalToCName(g2) + "_data")

# ── roots + main ─────────────────────────────────────────────────────────────

fun genDeclareRoots(roots: List<String>): String
  let declarations = join(map(roots, (r: String) => "declare((object_t**)&" + r + ")"), ";\n    ")
  ret "static roots_declaration_func_t _previous_declare_roots;\n"
      + "static void _declare_roots(void(*declare)(object_t**)) {\n"
      + "    _previous_declare_roots(declare);\n"
      + "    " + declarations + ";\n"
      + "}\n"

# --profile: init BEFORE thread_start, so the profiler precedes every worker
# registration and every instrumented call (gen.py __declare_main).
fun genDeclareMain(profile: Bool, nProf: Int): String
  ret "int main(int argc, char** argv) {\n"
      + "    _yafl_argc = argc;\n"
      + "    _yafl_argv = argv;\n"
      + (profile ? "    yafl_prof_init(yafl_prof_fns, " + String(nProf) + "u);\n" : "")
      + "    _previous_declare_roots = add_roots_declaration_func(_declare_roots);\n"
      + "    thread_start(__entrypoint__);\n"
      + "    return 0;\n"
      + "}\n"

# ── --profile descriptor table (gen.py __gen_prof_table) ─────────────────────

# c_str: escape backslashes and quotes only — the exact twin of gen.py's local
# escaper (names and paths never contain other C-special bytes).
fun profCStr(s: String): String
  ret "\"" + toString(profCStrBody(s, 0, StringBuilder())) + "\""

fun [tail] profCStrBody(s: String, i: Int,
                        [terminal] sb: StringBuilder): StringBuilder
  let bs = findByte(s, '\\', i)
  let qt = findByte(s, '"', i)
  let nxt = bs < 0 ? qt : qt < 0 ? bs : bs < qt ? bs : qt
  if nxt < 0
    ret append(sb, slice(s, i, length(s)))
  ret profCStrBody(s, nxt + 1,
                   append(append(append(sb, slice(s, i, nxt)), "\\"),
                          slice(s, nxt, nxt + 1)))

# Rows in id order — the same non-foreign walk order the numbering used; the
# count rides the walk (no-length ruling).
fun genProfTable(a: CgApp): (text: String, n: Int)
  let rows = profTableRows(chain(appFunctions(a)), 0, StringBuilder())
  ret ("static const yafl_prof_fn_t yafl_prof_fns[" + String(rows.n) + "] = {\n"
       + toString(rows.sb2) + "\n};\n", rows.n)

fun [tail] profTableRows(fs: Chain<CgFunction>, n: Int,
                         [terminal] sb: StringBuilder): (sb2: StringBuilder, n: Int)
  ret match(fs)
    (nil: ChainEnd) => (sb, n)
    (l: ChainLink)  => isNoneStr(l.value.fnForeignSymbol)
      ? profTableRows(l.next, n + 1,
          append(n == 0 ? sb : append(sb, ",\n"),
                 "    { " + profCStr(l.value.fnName) + ", "
                 + profCStr(l.value.fnSourceFile) + ", "
                 + String(l.value.fnSourceLine) + " }"))
      : profTableRows(l.next, n, sb)

# ── the assembly ─────────────────────────────────────────────────────────────

fun genDiagnostics(): String
  ret join(map(build<String>(push<String>(push<String>(push<String>(push<String>(builder<String>(), "-Wunused-variable"), "-Wunused-but-set-variable"), "-Wunused-parameter"), "-Wunused-const-variable")),
        (w: String) => "#pragma GCC diagnostic ignored \"" + w + "\""), "\n")
      + "\n#pragma GCC diagnostic ignored \"-Wmissing-braces\""

fun [tail] vtEntries(os: Chain<CgObject>,
                     [terminal] acc: ListBuilder<VtableEntry >): ListBuilder<VtableEntry >
  ret match(os)
    (nil: ChainEnd) => acc
    (l: ChainLink)  => vtEntries(l.next, l.value.objIsForeign
      ? acc
      : push<VtableEntry >(acc, vtEntryOf(l.value)))

fun genApplication(a: CgApp, headers: List<String>, profile: Bool): List<String>
  let vtables = build<VtableEntry >(vtEntries(chain(appObjects(a)),
                                              builder<VtableEntry >()))
  let ph = createPerfectLookups(vtables)
  # Explicit walks rather than folds: the accumulator is linear, so it is
  # threaded through one call per element instead of riding a fold's lambda.
  let acc1 = genFunctionsLoop(chain(appFunctions(a)), profile, 0, genAccEmpty())
  let acc2 = genObjectsLoop(chain(objectsInExtendsOrder(a)), ph.methodIds,
                            ph.vtableSizes, acc1)
  let acc0 = genGlobalsLoop(chain(appGlobals(a)), a, acc2)
  # The descriptor table is appended AFTER the emission loops: the lazy
  # struct_anon numbering is settled by then, and the table itself uses only
  # named C types so it can never touch the cache (gen.py's exact position —
  # the last element of the variables section).
  let prof: (text: String, n: Int) = profile ? genProfTable(a) : ("", 0)
  let acc3 = profile
    ? GenAcc(acc0.gaCache, acc0.gaTypedefs, acc0.gaForwards,
             push<String >(acc0.gaVariables, prof.text),
             acc0.gaFunctions, acc0.gaGcRoots)
    : acc0
  # A flat list of modest fragments, never one giant string — the caller
  # streams them to stdout in order (Application.gen returns the same parts
  # shape). Separators are explicit elements: "\n" between the items of a
  # section, "\n\n" between sections (including empty ones — the vtables
  # section is always empty here, matching Python's unused __vtables list).
  # Assembling the joined text needed one ~83MB contiguous allocation at the
  # end of a compiler-sized run.
  # The sections in file order, pushed one at a time. The FIRST section is the
  # #include block — it must stay first, and it is the reason `headers` is a
  # parameter at all.
  let sec = push<List<String> >(push<List<String> >(push<List<String> >(
                push<List<String> >(push<List<String> >(push<List<String> >(
                    push<List<String> >(push<List<String> >(push<List<String> >(
                        push<List<String> >(push<List<String> >(
                            builder<List<String> >(),
                            map(headers, (h: String) => "#include <" + h + ">")),
                            prepend(genDiagnostics(), List<String>())),
                        prepend(genFunctionIds(ph.methodIds), List<String>())),
                        map(acc3.gaCache, (e2: CgCacheEntry) => e2.entryTypedef)),
                    build<String >(acc3.gaTypedefs)),
                    build<String >(acc3.gaForwards)),
                    List<String>()),
                build<String >(acc3.gaVariables)),
                build<String >(acc3.gaFunctions)),
            prepend(genDeclareRoots(build<String >(acc3.gaGcRoots)),
                    List<String>())),
            prepend(genDeclareMain(profile, prof.n), List<String>()))
  ret genFlatten(build<List<String> >(sec))

fun profIdOf(profile: Bool, id2: Int): Int|None
  ret profile ? id2 : None

# --profile: non-foreign functions are numbered 0..N-1 in emission order —
# the port's appFunctions order equals Python's sorted dict order by the
# existing byte contract, so ids agree (gen.py's numbering comment).
fun [tail] genFunctionsLoop(fs: Chain<CgFunction>, profile: Bool, nextId: Int,
                            [terminal] acc: GenAcc): GenAcc
  ret match(fs)
    (nil: ChainEnd) => acc
    (l: ChainLink)  => isNoneStr(l.value.fnForeignSymbol)
      ? genFunctionsLoop(l.next, profile, nextId + 1,
                         genFunction(acc, l.value, profIdOf(profile, nextId)))
      : genFunctionsLoop(l.next, profile, nextId, genExtern(acc, l.value))

fun [tail] genObjectsLoop(os: Chain<CgObject>, methodIds: List<MethodId>,
                          sizes: List<VtableSize>,
                          [terminal] acc: GenAcc): GenAcc
  ret match(os)
    (nil: ChainEnd) => acc
    (l: ChainLink)  => genObjectsLoop(l.next, methodIds, sizes,
        l.value.objIsForeign ? acc : genObject(acc, l.value, methodIds, sizes))

fun [tail] genGlobalsLoop(gs: Chain<CgGlobal>, a: CgApp,
                          [terminal] acc: GenAcc): GenAcc
  ret match(gs)
    (nil: ChainEnd) => acc
    (l: ChainLink)  => genGlobalsLoop(l.next, a, genGlobal(acc, l.value, a))

# Flatten sections into the parts list with separator elements. Byte-exact
# twin of the old nested join: "\n\n" precedes every section but the first,
# "\n" precedes every item but its section's first.
fun genFlatten(sections: List<List<String>>): List<String>
  ret build<String >(gfSections(chain(sections), true, builder<String >()))

fun [tail] gfSections(ss: Chain<List<String>>, first: Bool,
                      [terminal] acc: ListBuilder<String >): ListBuilder<String >
  ret match(ss)
    (nil: ChainEnd) => acc
    (l: ChainLink)  => gfSections(l.next, false,
        gfItems(chain(l.value), true,
                first ? acc : push<String >(acc, "\n\n")))

fun [tail] gfItems(is2: Chain<String>, first: Bool,
                   [terminal] acc: ListBuilder<String >): ListBuilder<String >
  ret match(is2)
    (nil: ChainEnd) => acc
    (l: ChainLink)  => gfItems(l.next, false,
        push<String >(first ? acc : push<String >(acc, "\n"), l.value))
