# bootstrap/generate_expr2.yafl — MatchArm/MatchExpression.generate, ported
# from compiler/pyast/match.py (continues generate_expr.yafl; split here per
# the ~1500-line guidance in the task brief).
#
# `_Emitter` in match.py is a MUTABLE dataclass (self.bundles/self.counter/
# self.fallback_label/self.arm_results all mutated in place across the whole
# match). Ported here as `GEmit`, an IMMUTABLE value threaded through every
# helper (emArm/emMultiEntryArm/emGuardToFallback/emFallback/emFinish) —
# each Python mutation becomes "compute and return the new state". Bundles are
# folded into ONE running GBundle as they're produced (rather than kept as a
# list-of-bundles reduced at the very end, as Python does) — algebraically
# identical since GBundle's `+`/bundleJoin only ever concatenates in order.
#
# union_repr.yafl's TaggedRepr/PointerRepr/ComplexEnumRepr.generate_match
# implementations drive `em` via `emArm`/`emMultiEntryArm`/`emFallback`/
# `emGuardToFallback`/`bindSubject`/`bindFromSlots` — the same functions
# MatchExpression.generate itself uses for the primitive-literal path below.
namespace Bootstrap::Codegen

import System

import Bootstrap::Ast
import Bootstrap::Frontend
import Bootstrap::Ir
import Bootstrap::Parse
import Bootstrap::Resolve
import Bootstrap::StdlibCandidates
import Bootstrap::Types



# ══════════════════════════════════════════════════════════════════════════
# SECTION 0: GEmit — the pure-functional port of match.py's `_Emitter`.
# ══════════════════════════════════════════════════════════════════════════

class [final] ArmResult(arLabel: String, arValue: RParam)

# One binding: the OperationBundle that moves the matched value into the
# arm's bound StackVar, and the Resolver that exposes the bound name to the
# arm's guard/body (Python: `bind: tuple[OperationBundle, Resolver] | None`).
class [final] GBind(gbdBundle: GBundle, gbdResolver: Resolver)

# One entry of a tagged-union narrow arm: a per-member tag guard and the
# value narrowed/reslotted for that member (Python: `entries: list[tuple[RParam, RParam]]`).
class [final] GEntry(geGuard: RParam, geValue: RParam)

class [final] GEmit(geBundle: GBundle, geArmResults: List<ArmResult>,
                    geCounter: Int, geFallbackLabel: String|None)

fun emEmpty(): GEmit
  ret GEmit(emptyBundle(), List<ArmResult>(), 0, None)

fun matchEndLabel(): String => "match_end"

fun emAdd(st: GEmit, b: GBundle): GEmit
  ret GEmit(bundleJoin(st.geBundle, b), st.geArmResults, st.geCounter, st.geFallbackLabel)

fun emOps(st: GEmit, ops: List<Op>): GEmit
  ret emAdd(st, bundleOps(ops))

fun emOp1(st: GEmit, op: Op): GEmit
  ret emOps(st, list1(op))

fun emStackVar(st: GEmit, sv: RParam): GEmit
  ret emAdd(st, bundleFull(list1(sv), List<Op>(), None))

class [final] NextIndexOut(niIdx: Int, niState: GEmit)

fun emNextIndex(st: GEmit): NextIndexOut
  ret NextIndexOut(st.geCounter, GEmit(st.geBundle, st.geArmResults, st.geCounter + 1, st.geFallbackLabel))

# ── arm(arm, stages, bind, pre) ─────────────────────────────────────────────
# `stages`: a sequence of checks that must ALL pass to reach the body; each
# check is a list of alternatives, any ONE of which passing clears that
# check. Failing a check (no alternative hit) falls through to the next arm.

fun emArm(st0: GEmit, resolver: Resolver, resultType: Spec|None, arm: PArm,
         stages: List<List<RParam>>, bind: GBind|None, pre: List<GBundle>): GEmit
  let ni = emNextIndex(st0)
  let idx = ni.niIdx
  let armLabel = "match_arm_" + String(idx)
  let nextLabel = "match_next_" + String(idx)
  let st1 = fold(pre, ni.niState, (acc: GEmit, b: GBundle) => emAdd(acc, b))
  let st2 = emStages(st1, chain(stages), 0, idx, armLabel, nextLabel)
  let prefix = "arm" + String(idx)
  let armResolver = match(bind)
    (b: GBind) => b.gbdResolver
    ()          => resolver
  let st3 = match(bind)
    (b: GBind) => emAdd(st2, withPrefix(b.gbdBundle, prefix))
    ()          => st2
  # Pattern passed: bind, then the arm's own guard — a failing guard falls
  # through to the next arm exactly like a failed stage.
  let st4 = emGuard(st3, armResolver, arm, idx, nextLabel)
  let st5 = emBody(st4, armResolver, resultType, arm, None, prefix)
  ret emOp1(st5, OpLabel(nextLabel, List<RParam>()))

fun emStages(st: GEmit, stages: Chain<List<RParam>>, stageNo: Int,
                    idx: Int, armLabel: String, nextLabel: String): GEmit
  ret match(stages)
    (nil: ChainEnd) => st
    (l: ChainLink)  => emStagesStep(st, l, stageNo, idx, armLabel, nextLabel)

fun emStagesStep(st: GEmit, l: ChainLink<List<RParam>>, stageNo: Int,
                idx: Int, armLabel: String, nextLabel: String): GEmit
  let passLabel = l.next is ChainEnd ? armLabel : "match_stage_" + String(idx) + "_" + String(stageNo)
  let withGuards = fold(l.value, st, (acc: GEmit, guard: RParam) => emOp1(acc, OpJumpIf(passLabel, guard, false, List<RParam>())))
  let withJump = emOp1(withGuards, OpJump(nextLabel, List<RParam>()))
  let withLabel = emOp1(withJump, OpLabel(passLabel, List<RParam>()))
  ret emStages(withLabel, l.next, stageNo + 1, idx, armLabel, nextLabel)

# ── multi_entry_arm(arm, entries, bound_ctype) ──────────────────────────────
# One arm with several entry edges, each binding a DIFFERENT value — the
# tagged-union narrow arm: per member, a tag guard and the value narrowed for
# that member. The bound variable is defined once, by a Phi over the entries.

fun emMultiEntryArm(st0: GEmit, resolver: Resolver, resultType: Spec|None,
                    arm: PArm, entries: List<GEntry>, boundCtype: CgType): GEmit
  let ni = emNextIndex(st0)
  let idx = ni.niIdx
  let nextLabel = "match_next_" + String(idx)
  let bodyLabel = "match_armbody_" + String(idx)
  let st1 = emEntryGuards(ni.niState, chain(entries), idx, 0)
  let st2 = emOp1(st1, OpJump(nextLabel, List<RParam>()))
  let st3 = emEntryLabelJumps(st2, chain(entries), idx, 0, bodyLabel)
  let armSv = RpStackVar(boundCtype, armUniqueName(arm))
  let st4 = emOp1(emStackVar(st3, armSv), OpLabel(bodyLabel, List<RParam>()))
  let st5 = emOp1(st4, OpPhi(armSv, phiSourcesOf(entries, idx), List<RParam>()))
  let armResolver = bindingScope(arm, arm.armType, resolver)
  let st6 = emGuard(st5, armResolver, arm, idx, nextLabel)
  let st7 = emBody(st6, armResolver, resultType, arm, None, "arm" + String(idx))
  ret emOp1(st7, OpLabel(nextLabel, List<RParam>()))

fun entryLabel(idx: Int, k: Int): String
  ret "match_arm_" + String(idx) + "_m" + String(k)

fun [tail] emEntryGuards(st: GEmit, es: Chain<GEntry>, idx: Int, k: Int): GEmit
  ret match(es)
    (nil: ChainEnd) => st
    (l: ChainLink)  => emEntryGuards(emOp1(st, OpJumpIf(entryLabel(idx, k), l.value.geGuard, false, List<RParam>())), l.next, idx, k + 1)

fun [tail] emEntryLabelJumps(st: GEmit, es: Chain<GEntry>, idx: Int, k: Int, bodyLabel: String): GEmit
  ret match(es)
    (nil: ChainEnd) => st
    (l: ChainLink)  => emEntryLabelJumps(
        emOp1(emOp1(st, OpLabel(entryLabel(idx, k), List<RParam>())), OpJump(bodyLabel, List<RParam>())),
        l.next, idx, k + 1, bodyLabel)

fun phiSourcesOf(es: List<GEntry>, idx: Int): List<OpPhiSource>
  ret phiSourcesLoop(chain(es), idx, 0, List<OpPhiSource>())

fun phiSourcesLoop(es: Chain<GEntry>, idx: Int, k: Int, acc: List<OpPhiSource>): List<OpPhiSource>
  ret build<OpPhiSource >(phiSourcesLoopB(es, idx, k, builderFrom<OpPhiSource>(acc)))

fun [tail] phiSourcesLoopB(es: Chain<GEntry>, idx: Int, k: Int, [terminal] acc: ListBuilder<OpPhiSource >): ListBuilder<OpPhiSource >
  ret match(es)
    (nil: ChainEnd) => acc
    (l: ChainLink)  => phiSourcesLoopB(l.next, idx, k + 1, push<OpPhiSource >(acc, OpPhiSource(entryLabel(idx, k), l.value.geValue)))

# ── the arm's own `if` guard (private in Python: `__guard`) ─────────────────
# Evaluated after the binding: a False guard falls through to the next arm.
# No-op for an unguarded arm.

fun emGuard(st: GEmit, armResolver: Resolver, arm: PArm, idx: Int, nextLabel: String): GEmit
  ret match(arm.armGuard)
    (guard: PExpr) => emGuardOn(st, armResolver, guard, idx, nextLabel)
    ()             => st

fun emGuardOn(st: GEmit, armResolver: Resolver, guard: PExpr, idx: Int, nextLabel: String): GEmit
  let gb = withPrefix(genExpr(guard, armResolver), "arm" + String(idx) + "guard")
  let withG = emAdd(st, gb)
  let passLabel = "match_guardpass_" + String(idx)
  let withJ = emOp1(withG, OpJumpIf(passLabel, mustResult(gb), false, List<RParam>()))
  let withN = emOp1(withJ, OpJump(nextLabel, List<RParam>()))
  ret emOp1(withN, OpLabel(passLabel, List<RParam>()))

# `guard_to_fallback`: route a passing guard straight to the fallback body —
# used when one arm handles both an early dispatch case (NULL) and the
# fall-through, so the body is emitted exactly once, in `fallback()`.

fun emGuardToFallback(st: GEmit, guard: RParam): GEmit
  let st1 = match(st.geFallbackLabel)
    (fl: String) => st
    ()            => emAssignFallbackLabel(st)
  let fl = match(st1.geFallbackLabel)
    (fl2: String) => fl2
    ()             => ""   # unreachable: emAssignFallbackLabel always sets one
  ret emOp1(st1, OpJumpIf(fl, guard, false, List<RParam>()))

fun emAssignFallbackLabel(st: GEmit): GEmit
  let ni = emNextIndex(st)
  ret GEmit(ni.niState.geBundle, ni.niState.geArmResults, ni.niState.geCounter,
           "match_fallback_" + String(ni.niIdx))

# ── fallback(arm, bind, abort_reason) ───────────────────────────────────────
# The unguarded tail: the else arm if present, else an explicit Abort.

fun emFallback(st0: GEmit, resolver: Resolver, resultType: Spec|None,
              arm: PArm|None, bind: GBind|None, abortReason: String): GEmit
  let st1 = match(st0.geFallbackLabel)
    (fl: String) => emOp1(st0, OpLabel(fl, List<RParam>()))
    ()            => st0
  ret match(arm)
    (a: PArm) => emBody(st1, resolver, resultType, a, bind, "else")
    ()         => emOp1(st1, OpAbort(abortReason, List<RParam>()))

# ── internals: __body ───────────────────────────────────────────────────────
# Binding bundle (if any), the arm body generated TO the shared slot type (so
# narrow arms widen before the join), an exit label naming this arm's Phi
# edge, and the jump to the join — suppressed when the body already ended in
# a control transfer.

fun emBody(st0: GEmit, resolver: Resolver, resultType: Spec|None, arm: PArm,
          bind: GBind|None, prefix: String): GEmit
  let armResolver = match(bind)
    (b: GBind) => b.gbdResolver
    ()          => resolver
  let st1 = match(bind)
    (b: GBind) => emAdd(st0, withPrefix(b.gbdBundle, prefix))
    ()          => st0
  let bodyBundle = withPrefix(genExprTo(arm.armBody, armResolver, resultType), prefix)
  let st2 = emAdd(st1, bodyBundle)
  let st3 = match(bodyBundle.gbResult)
    (rv: RParam) => emArmResult(st2, prefix, rv)
    ()            => st2
  ret bundleBottom(bodyBundle) ? st3 : emOp1(st3, OpJump(matchEndLabel(), List<RParam>()))

fun emArmResult(st: GEmit, prefix: String, rv: RParam): GEmit
  let exitLabel = prefix + "_exit"
  let withLabel = emOp1(st, OpLabel(exitLabel, List<RParam>()))
  # Arm order: these become the join Phi's sources, one per arm.
  ret GEmit(withLabel.geBundle,
            build<ArmResult >(push<ArmResult >(_pushChain<ArmResult >(builder<ArmResult >(), chain<ArmResult>(withLabel.geArmResults)), ArmResult(exitLabel, rv))),
            withLabel.geCounter, withLabel.geFallbackLabel)

# ── binding constructors (used by union_repr's generate_match implementations) ──

# Bind the arm name to `value` at `bound_type` — the common case where the
# subject (or the subject pointer) IS the arm's value.
fun bindSubject(resolver: Resolver, arm: PArm, boundType: Spec, value: RParam): GBind|None
  ret (arm.armName == "" || arm.armName == "_")
    ? None
    : bindSubjectOn(resolver, arm, boundType, value)

fun bindSubjectOn(resolver: Resolver, arm: PArm, boundType: Spec, value: RParam): GBind|None
  let armCtype = specGenerate(boundType, resolver)
  let value2 = adjustBoundValue(armCtype, value)
  let armSv = RpStackVar(armCtype, armUniqueName(arm))
  let bundle = GBundle(list1(armSv), list1(OpMove(armSv, value2, false, List<RParam>())), None, List<RecurSource>(), List<ExitSource>())
  ret GBind(bundle, bindingScope(arm, boundType, resolver))

# A unit-typed arm in a pointer union (the `None` of `Box|None`) carries no
# data: the subject is object_t* and cannot assign to a struct{}, so
# synthesise the empty value. A single-field newtype arm in a COLLAPSED
# pointer union: the subject is the bare pointer word, so re-wrap it into the
# tuple struct the arm binds.
fun adjustBoundValue(armCtype: CgType, value: RParam): RParam
  ret match(cgFieldsOf(armCtype))
    (fields: List<CgField>) => isEmpty(fields)
      ? RpZeroOf(armCtype)
      : (eqCgTypeList(cgFlattenPrimitives(armCtype), list1(CgDataPointer()))
          ? wrapPointerInto(armCtype, value)
          : value)
    ()                       => value

fun [tail] eqCgTypeList(a: List<CgType>, b: List<CgType>): Bool
  ret match(head(a))
    (xa: CgType) => match(head(b))
      (xb: CgType) => eqCgType(xa, xb) && eqCgTypeList(tail(a), tail(b))
      ()            => false
    () => isEmpty(b)

# `_wrap_pointer_into`: rebuild a single-field newtype wrapper (a chain of
# one-field structs ending in a DataPointer) from a bare pointer word.
fun wrapPointerInto(ctype: CgType, ptrValue: RParam): RParam
  ret match(cgFieldsOf(ctype))
    (fields: List<CgField>) if exactly(chain(fields), 1) =>
        wrapPointerIntoField(head(fields), ptrValue)
    ()                       => ptrValue

fun wrapPointerIntoField(f: CgField|None, ptrValue: RParam): RParam
  ret match(f)
    (fld: CgField) => RpNewStruct(list1(RpNamedValue(fld.fieldName, wrapPointerInto(fld.fieldType, ptrValue))))
    ()              => ptrValue   # unreachable given the length check above

# Bind the arm name to the variant value reassembled from union slots.
# `slotAssignments` is variant_map[var_idx]: one (slot_index, orig_type) per
# primitive of this variant; a multi-primitive variant is rebuilt field by field.
fun bindFromSlots(resolver: Resolver, arm: PArm, armCtype: CgType,
                  slotAssignments: List<CgSlotEntry>, slotFields: List<CgField>, sv: RParam): GBind|None
  ret (arm.armName == "" || arm.armName == "_")
    ? None
    : bindFromSlotsOn(resolver, arm, armCtype, slotAssignments, slotFields, sv)

fun bindFromSlotsOn(resolver: Resolver, arm: PArm, armCtype: CgType,
                    slotAssignments: List<CgSlotEntry>, slotFields: List<CgField>, sv: RParam): GBind|None
  let armValue = reconstructFromSlots(armCtype, slotAssignments, slotFields, sv, 0).rfValue
  let armSv = RpStackVar(armCtype, armUniqueName(arm))
  let bundle = GBundle(list1(armSv), list1(OpMove(armSv, armValue, false, List<RParam>())), None, List<RecurSource>(), List<ExitSource>())
  ret match(arm.armType)
    (ty: Spec) => GBind(bundle, bindingScope(arm, ty, resolver))
    ()          => GBind(bundle, resolver)   # unreachable: a typed arm always carries armType

class [final] ReconstructOut(rfValue: RParam, rfOffset: Int)

fun reconstructFromSlots(ctype: CgType, slotAssignments: List<CgSlotEntry>,
                         slotFields: List<CgField>, sv: RParam, offset: Int): ReconstructOut
  ret match(ctype)
    (fp: CgFuncPointer) => reconstructFun(slotAssignments, slotFields, sv, offset)
    (o: CgType)          => match(cgFieldsOf(ctype))
      (fields: List<CgField>) => reconstructStruct(ctype, fields, slotAssignments, slotFields, sv, offset)
      ()                       => reconstructLeaf(slotAssignments, slotFields, sv, offset)

# Reassemble the closure from its two slots (RpFunField's inverse; serves
# both the match arm bind and read_field — match.py / union_repr.py mirrors).
fun reconstructFun(slotAssignments: List<CgSlotEntry>, slotFields: List<CgField>,
                   sv: RParam, offset: Int): ReconstructOut
  ret match(listAt<CgSlotEntry>(slotAssignments, offset))
    (ef: CgSlotEntry) => match(listAt<CgSlotEntry>(slotAssignments, offset + 1))
      (eo: CgSlotEntry) => ReconstructOut(
          RpMakeFun(RpStructField(sv, fieldNameAt(slotFields, ef.slotIndex)),
                    RpStructField(sv, fieldNameAt(slotFields, eo.slotIndex))),
          offset + 2)
      ()                 => ReconstructOut(RpNullPointer(), offset + 2)   # unreachable
    ()                 => ReconstructOut(RpNullPointer(), offset + 2)   # unreachable

fun reconstructLeaf(slotAssignments: List<CgSlotEntry>, slotFields: List<CgField>, sv: RParam, offset: Int): ReconstructOut
  ret match(listAt<CgSlotEntry>(slotAssignments, offset))
    (e2: CgSlotEntry) => ReconstructOut(RpStructField(sv, fieldNameAt(slotFields, e2.slotIndex)), offset + 1)
    ()                 => ReconstructOut(RpNullPointer(), offset + 1)   # unreachable

fun fieldNameAt(fields: List<CgField>, idx: Int): String
  ret match(listAt<CgField>(fields, idx))
    (f: CgField) => f.fieldName
    ()            => ""   # unreachable

fun reconstructStruct(ctype: CgType, fields: List<CgField>, slotAssignments: List<CgSlotEntry>,
                      slotFields: List<CgField>, sv: RParam, offset0: Int): ReconstructOut
  let r = reconstructFields(chain(fields), slotAssignments, slotFields, sv,
                            offset0, builder<RpNamedValue >())
  ret ReconstructOut(unionStruct(ctype, r.rfsValues), r.rfsOffset)

class [final] ReconstructFieldsOut(rfsValues: List<RpNamedValue>, rfsOffset: Int)

fun reconstructFields(fs: Chain<CgField>, slotAssignments: List<CgSlotEntry>,
                             slotFields: List<CgField>, sv: RParam, offset: Int,
                             [terminal] acc: ListBuilder<RpNamedValue >): ReconstructFieldsOut
  ret match(fs)
    (nil: ChainEnd) => ReconstructFieldsOut(build<RpNamedValue >(acc), offset)
    (l: ChainLink)  => reconstructFieldsStep(l, slotAssignments, slotFields, sv, offset, acc)

fun reconstructFieldsStep(l: ChainLink<CgField>, slotAssignments: List<CgSlotEntry>, slotFields: List<CgField>,
                          sv: RParam, offset: Int, [terminal] acc: ListBuilder<RpNamedValue >): ReconstructFieldsOut
  let sub = reconstructFromSlots(l.value.fieldType, slotAssignments, slotFields, sv, offset)
  ret reconstructFields(l.next, slotAssignments, slotFields, sv, sub.rfOffset,
          push<RpNamedValue >(acc,
              RpNamedValue(l.value.fieldName, sub.rfValue)))

# `finish(result_var)`: the join — a Phi collecting one source per arm, or a
# bare label if the match has no value, or an Abort if it SHOULD have one but
# every arm transferred control away.

fun emFinish(st: GEmit, resultVar: RParam|None): GBundle
  ret match(resultVar)
    (rv: RParam) => isEmpty(st.geArmResults)
      ? bundleJoin(st.geBundle, bundleOps(list2(OpLabel(matchEndLabel(), List<RParam>()),
                                                OpAbort("unreachable match join: every arm transferred control", List<RParam>()))))
      : bundleJoin(st.geBundle, GBundle(list1(rv),
                                       list2(OpLabel(matchEndLabel(), List<RParam>()),
                                            OpPhi(rv, armResultsToPhi(st.geArmResults), List<RParam>())),
                                       rv, List<RecurSource>(), List<ExitSource>()))
    ()          => bundleJoin(st.geBundle, bundleOp1(OpLabel(matchEndLabel(), List<RParam>())))

fun armResultsToPhi(ars: List<ArmResult>): List<OpPhiSource>
  ret map(ars, (a: ArmResult) => OpPhiSource(a.arLabel, a.arValue))

# ══════════════════════════════════════════════════════════════════════════
# SECTION 1: literal-arm alternative tests (union_repr.literal_eq_test /
# literal_range_test / literal_alternative_tests — shared by all three match
# generators, so kept here alongside GEmit rather than duplicated in
# union_repr.yafl; union_repr calls these by name).
# ══════════════════════════════════════════════════════════════════════════

fun literalEqTest(litTypeName: String, value: RParam, literal: RParam): RParam
  let args = RpNewStruct(list2(RpNamedValue("a", value), RpNamedValue("b", literal)))
  ret litTypeName == "str"
    ? RpIntEqConst(RpRuntimeInvoke("string_compare", args, CgInt(32)), 0)
    : (litTypeName == "bigint"
        ? RpRuntimeInvoke("integer_test_eq", args, CgInt(8))
        : ((litTypeName == "float32" || litTypeName == "float64")
            ? RpRuntimeInvoke(litTypeName + "_eq", args, CgInt(8))
            : RpRuntimeInvoke(litTypeName + "_test_eq", args, CgInt(8))))

# lo <= value <= hi, as ONE pure RParam. bigint/floats use ge/le helpers —
# for floats this is REQUIRED, since NaN must fail every range (IEEE
# comparisons with NaN are all false; a `!(v<lo) & !(v>hi)` composition would
# let NaN inside every range).
fun literalRangeTest(litTypeName: String, value: RParam, lo: RParam, hi: RParam): RParam
  let loArgs = RpNewStruct(list2(RpNamedValue("a", value), RpNamedValue("b", lo)))
  let hiArgs = RpNewStruct(list2(RpNamedValue("a", value), RpNamedValue("b", hi)))
  let ge = (litTypeName == "bigint") ? RpRuntimeInvoke("integer_test_ge", loArgs, CgInt(8))
    : ((litTypeName == "float32" || litTypeName == "float64") ? RpRuntimeInvoke(litTypeName + "_ge", loArgs, CgInt(8))
        : RpIntEqConst(RpRuntimeInvoke(litTypeName + "_test_lt", loArgs, CgInt(8)), 0))
  let le = (litTypeName == "bigint") ? RpRuntimeInvoke("integer_test_le", hiArgs, CgInt(8))
    : ((litTypeName == "float32" || litTypeName == "float64") ? RpRuntimeInvoke(litTypeName + "_le", hiArgs, CgInt(8))
        : RpIntEqConst(RpRuntimeInvoke(litTypeName + "_test_gt", hiArgs, CgInt(8)), 0))
  ret RpRuntimeInvoke("int8_and", RpNewStruct(list2(RpNamedValue("a", ge), RpNamedValue("b", le))), CgInt(8))

class [final] LitTestsOut(ltoBundles: List<GBundle>, ltoTests: List<RParam>)

# (pre-bundles, tests) for one literal arm's alternatives: plain literals
# become equality tests, ranges become bounds tests. `items` is the arm's
# `armLiterals: List<PLit>`.
fun literalAlternativeTests(items: List<PLit>, typeName: String, value: RParam, r: Resolver, prefix: String): LitTestsOut
  ret litAltLoop(chain(items), typeName, value, r, prefix, 0,
                 builder<GBundle >(), builder<RParam >())

fun litAltLoop(items: Chain<PLit>, typeName: String, value: RParam, r: Resolver, prefix: String,
                      k: Int, [terminal] bundles: ListBuilder<GBundle >, tests: ListBuilder<RParam >): LitTestsOut
  ret match(items)
    (nil: ChainEnd) => LitTestsOut(build<GBundle >(bundles),
                                   build<RParam >(tests))
    (l: ChainLink)  => match(l.value)
      (rg: PlRange) => litAltRange(items, l, rg, typeName, value, r, prefix, k, bundles, tests)
      (le2: PlExpr) => litAltLit(items, l, le2, typeName, value, r, prefix, k, bundles, tests)

fun litAltRange(items: Chain<PLit>, l: ChainLink<PLit>, rg: PlRange, typeName: String, value: RParam,
               r: Resolver, prefix: String, k: Int, [terminal] bundles: ListBuilder<GBundle >, tests: ListBuilder<RParam >): LitTestsOut
  let loB = withPrefix(genExpr(rg.rangeLo, r), prefix + "_" + String(k) + "lo")
  let hiB = withPrefix(genExpr(rg.rangeHi, r), prefix + "_" + String(k) + "hi")
  ret litAltLoop(l.next, typeName, value, r, prefix, k + 1,
          _pushChain<GBundle >(bundles, chain<GBundle>(list2(loB, hiB))),
          push<RParam >(tests,
              literalRangeTest(typeName, value, mustResult(loB),
                               mustResult(hiB))))

fun litAltLit(items: Chain<PLit>, l: ChainLink<PLit>, le2: PlExpr, typeName: String, value: RParam,
             r: Resolver, prefix: String, k: Int, [terminal] bundles: ListBuilder<GBundle >, tests: ListBuilder<RParam >): LitTestsOut
  let b = withPrefix(genExpr(le2.litExpr, r), prefix + "_" + String(k))
  ret litAltLoop(l.next, typeName, value, r, prefix, k + 1,
          push<GBundle >(bundles, b),
          push<RParam >(tests,
              literalEqTest(typeName, value, mustResult(b))))

# ══════════════════════════════════════════════════════════════════════════
# SECTION 2: MatchExpression.generate/generate_to.
# ══════════════════════════════════════════════════════════════════════════

# isPrimitiveMatchType(name: String): Bool (match.py's _is_primitive_match_type)
# is reused as-is from check_expr.yafl.

fun genMatchTo(mt: PeMatch, r: Resolver, expected: Spec|None): GBundle
  ret genMatch(mt, r, expected)

fun genMatch(mt: PeMatch, r: Resolver, expected: Spec|None): GBundle
  ret isEmpty(mt.matchExtra) ? genMatchOne(mt, r, expected)
                             : genMatchMulti(mt, r, expected)

# Dispatch over several subjects: each arm is a SEQUENCE of stages, one per
# position, and emArm falls through to the next arm the moment a stage fails
# — first-match-wins across positions, no decision tree, no duplicated body.
fun genMatchMulti(mt: PeMatch, r: Resolver, expected: Spec|None): GBundle
  let subs = prepend(mt.subject, mt.matchExtra)
  let gens = genSubjects(chain(subs), r, 0, List<GBundle>())
  let resultType = match(expected)
    (e2: Spec) => expected
    ()          => matchType(mt, r)
  let resultVar = match(resultType)
    (rt: Spec) => RpStackVar(specGenerate(rt, r), "result")
    ()          => None
  let em0 = addAll(emEmpty(), chain(gens))
  let em1 = multiArms(em0, chain(mt.arms), subs, gens, resultType, r)
  ret emFinish(multiFallback(em1, mt, resultType, r), resultVar)

fun [tail] genSubjects(ss: Chain<PExpr>, r: Resolver, i: Int,
                       acc: List<GBundle>): List<GBundle>
  ret match(ss)
    (nil: ChainEnd) => acc
    (l: ChainLink)  => genSubjects(l.next, r, i + 1,
                         appendBundle(acc, withPrefix(genExpr(l.value, r),
                                                      "subj" + String(i))))

fun appendBundle(acc: List<GBundle>, b: GBundle): List<GBundle>
  ret build<GBundle >(push<GBundle >(builderFrom<GBundle>(acc), b))

fun [tail] addAll(em: GEmit, bs: Chain<GBundle>): GEmit
  ret match(bs)
    (nil: ChainEnd) => em
    (l: ChainLink)  => addAll(emAdd(em, l.value), l.next)

fun multiFallback(em: GEmit, mt: PeMatch, resultType: Spec|None,
                  r: Resolver): GEmit
  ret emFallback(em, r, resultType, elseArmOf(mt), None,
                 "multi-subject match fell through all arms")

fun [tail] multiArms(em: GEmit, as2: Chain<PArm>, subs: List<PExpr>,
                     gens: List<GBundle>, resultType: Spec|None,
                     r: Resolver): GEmit
  ret match(as2)
    (nil: ChainEnd) => em
    (l: ChainLink)  => multiArms(
        isElseArm(l.value) ? em
                           : multiArm(em, l.value, subs, gens, resultType, r),
        l.next, subs, gens, resultType, r)

fun isElseArm(a: PArm): Bool
  ret isNoneSpec(a.armType) && isEmpty(a.armLiterals) && isEmpty(a.armExtra)

# One multi-subject arm: a stage per position that carries a pattern, and the
# per-position bindings concatenated. The RESOLVER for the body is the arm's
# own scope — every position's name is registered there by compileArm — so the
# binds contribute their bundles and the scope comes from position 0's.
fun multiArm(em: GEmit, a: PArm, subs: List<PExpr>, gens: List<GBundle>,
             resultType: Spec|None, r: Resolver): GEmit
  let pats = prepend(a.armType, map(a.armExtra, (p: PPos) => p.posType))
  let stages = positionStages(chain(pats), chain(subs), chain(gens), r,
                              List<List<RParam>>())
  let bind = positionBinds(a, chain(subs), chain(gens), r)
  ret emArm(em, r, resultType, a, stages, bind, List<GBundle>())

fun [tail] positionStages(pats: Chain<Spec|None>, subs: Chain<PExpr>,
                          gens: Chain<GBundle>, r: Resolver,
                          acc: List<List<RParam>>): List<List<RParam>>
  ret match(pats)
    (nil: ChainEnd) => acc
    (l: ChainLink)  => positionStages(l.next, restExprs(subs), restBundles(gens), r,
        appendStage(acc, stageFor(l.value, headExpr(subs), headBundle(gens), r)))

fun stageFor(pat: Spec|None, sub: PExpr|None, g: GBundle|None,
             r: Resolver): List<RParam>|None
  ret match(sub)
    (e2: PExpr) => match(g)
      (b: GBundle) => match(exprType(e2, r))
        (st: Spec) => reprPositionGuards(classifyRepr(st, r), mustResult(b), pat, r)
        ()         => None
      ()           => None
    ()            => None

# A position whose repr cannot supply guards must NOT be dropped: dropping it
# leaves the arm with fewer stages than positions, so it matches on a partial
# test — and if every stage is dropped the arm matches unconditionally and the
# arms after it become unreachable, which surfaces far away as a Phi with a
# missing source.
#
# checkMatch REFUSES such a program (multiSubjectErrs), so a checked program
# never reaches here with an unsupported position; the never-passing guard
# below is the defensive floor for an UNCHECKED path, chosen because it fails
# closed. Codegen must not be the place that decides this — the port silently
# emitting a never-matching arm where Python errors is exactly the kind of
# divergence the contracts exist to catch.
fun appendStage(acc: List<List<RParam>>,
                st: List<RParam>|None): List<List<RParam>>
  ret build<List<RParam> >(push<List<RParam> >(
        builderFrom<List<RParam> >(acc), stageOrNever(st)))

fun stageOrNever(st: List<RParam>|None): List<RParam>
  ret match(st)
    (g: List<RParam>) => g
    ()                => list1(RpIntEqConst(RpInteger(0, 32), 1))

fun restExprs(es: Chain<PExpr>): Chain<PExpr>
  ret match(es)
    (l: ChainLink)  => l.next
    (nil: ChainEnd) => es

fun headExpr(es: Chain<PExpr>): PExpr|None
  ret match(es)
    (l: ChainLink)  => l.value
    (nil: ChainEnd) => None

fun restBundles(bs: Chain<GBundle>): Chain<GBundle>
  ret match(bs)
    (l: ChainLink)  => l.next
    (nil: ChainEnd) => bs

fun headBundle(bs: Chain<GBundle>): GBundle|None
  ret match(bs)
    (l: ChainLink)  => l.value
    (nil: ChainEnd) => None

# Position 0 binds through the arm; the rest through a PArm synthesised from
# their PPos, which gives the SAME unique name (armUniqueName reads the name
# and line, and posUniqueName built them the same way).
fun positionBinds(a: PArm, subs: Chain<PExpr>, gens: Chain<GBundle>,
                  r: Resolver): GBind|None
  ret bindsLoop(chain(prepend(posOfArm(a), a.armExtra)), subs, gens, r,
                None)

fun posOfArm(a: PArm): PPos
  ret PPos(a.armName, a.armType, a.parmLine)

# THREADS the resolver: each position binds over the scope the previous ones
# built, so the body sees EVERY position's name. Binding each independently
# and keeping the first one's scope leaves later positions invisible — an arm
# whose body reads only the second subject then fails to generate, and the
# damage surfaces as a join Phi missing that arm's source.
fun [tail] bindsLoop(ps: Chain<PPos>, subs: Chain<PExpr>, gens: Chain<GBundle>,
                     r: Resolver, acc: GBind|None): GBind|None
  ret match(ps)
    (nil: ChainEnd) => acc
    (l: ChainLink)  => bindsLoop(l.next, restExprs(subs), restBundles(gens),
        scopeOf(acc, r),
        mergeInto(acc, bindPosition(l.value, headExpr(subs), headBundle(gens),
                                    scopeOf(acc, r))))

fun scopeOf(acc: GBind|None, r: Resolver): Resolver
  ret match(acc)
    (b: GBind) => b.gbdResolver
    ()         => r

# Concatenate the binding BUNDLES and keep the LATEST scope, which is the one
# holding every name bound so far.
fun mergeInto(acc: GBind|None, b: GBind|None): GBind|None
  ret match(b)
    (nb: GBind) => match(acc)
      (ab: GBind) => GBind(bundleJoin(ab.gbdBundle, nb.gbdBundle),
                           nb.gbdResolver)
      ()          => nb
    ()          => acc

fun bindPosition(p: PPos, sub: PExpr|None, g: GBundle|None,
                 r: Resolver): GBind|None
  ret match(sub)
    (e2: PExpr) => match(g)
      (b: GBundle) => match(posBindSpec(p, exprType(e2, r)))
        (bt: Spec) => bindSubject(r, PArm(p.posName, p.posType, PeNothing(p.pposLine),
                                          List<PLit>(), None, p.pposLine,
                                          List<PPos>()),
                                  bt, mustResult(b))
        ()         => None
      ()           => None
    ()            => None

fun posBindSpec(p: PPos, subjTy: Spec|None): Spec|None
  ret match(p.posType)
    (t2: Spec) => p.posType
    ()         => subjTy

fun genMatchOne(mt: PeMatch, r: Resolver, expected: Spec|None): GBundle
  let subjBundle = withPrefix(genExpr(mt.subject, r), "subj")
  let subjType = exprType(mt.subject, r)
  # `result_type`: the shared slot type. A sink supplies it (the union the
  # arms widen into); otherwise the arms already agree and matchType is
  # exact. Each arm body is generated *to* this type (emBody widens narrow
  # arms before the join Phi).
  let resultType = match(expected)
    (e2: Spec) => expected
    ()          => matchType(mt, r)
  let resultVar = match(resultType)
    (rt: Spec) => RpStackVar(specGenerate(rt, r), "result")
    ()          => None
  let em0 = emAdd(emEmpty(), subjBundle)
  let em1 = genMatchDispatch(em0, mt, subjType, resultType, subjBundle, r)
  ret emFinish(em1, resultVar)

fun genMatchDispatch(em0: GEmit, mt: PeMatch, subjType: Spec|None, resultType: Spec|None,
                     subjBundle: GBundle, r: Resolver): GEmit
  ret match(subjType)
    (st2: Spec) => genMatchDispatchOn(em0, mt, st2, resultType, subjBundle, r)
    ()           => em0   # unreachable: check() requires the subject type resolved

fun genMatchDispatchOn(em0: GEmit, mt: PeMatch, subjType: Spec, resultType: Spec|None,
                       subjBundle: GBundle, r: Resolver): GEmit
  ret match(subjType)
    (b: SBuiltin) => isPrimitiveMatchType(b.sbName)
      ? genPrimitiveMatch(em0, mt, subjBundle, b.sbName, resultType, r)
      : em0   # unreachable: check() requires a union or a primitive-with-literals subject
    (e2: SEnum)   => reprGenerateMatch(classifyRepr(subjType, r), em0, resultType, subjBundle, mt.arms, elseArmOf(mt), r)
    (cm: SCombination) => reprGenerateMatch(classifyRepr(subjType, r), em0, resultType, subjBundle, mt.arms, elseArmOf(mt), r)
    (o: Spec)     => em0   # unreachable

fun elseArmOf(mt: PeMatch): PArm|None
  ret elseArmLoop(chain(mt.arms))

fun [tail] elseArmLoop(as2: Chain<PArm>): PArm|None
  ret match(as2)
    (nil: ChainEnd) => None
    (l: ChainLink)  => (isNoneSpec(l.value.armType) && isEmpty(l.value.armLiterals)) ? l.value : elseArmLoop(l.next)

fun isNoneSpec(sp: Spec|None): Bool
  ret match(sp)
    (s2: Spec) => false
    ()          => true

# Literal-arm match on a primitive subject: Int (bigint), String (str), or a
# fixed-width integer. An arm's literals are ALTERNATIVES of one stage: any
# equality passing enters the arm.
fun genPrimitiveMatch(em0: GEmit, mt: PeMatch, subjBundle: GBundle, typeName: String,
                      resultType: Spec|None, r: Resolver): GEmit
  let sv = mustResult(subjBundle)
  let em1 = genPrimitiveArms(em0, chain(mt.arms), sv, typeName, resultType, r)
  let elseArm = elseArmOf(mt)
  let bind = match(elseArm)
    (a: PArm) => bindSubject(r, a, SBuiltin(typeName, noLine()), sv)
    ()         => None
  ret emFallback(em1, r, resultType, elseArm, bind, "primitive match fell through all arms")

fun [tail] genPrimitiveArms(em: GEmit, arms: Chain<PArm>, sv: RParam, typeName: String,
                            resultType: Spec|None, r: Resolver): GEmit
  ret match(arms)
    (nil: ChainEnd) => em
    (l: ChainLink)  => genPrimitiveArms(
        isEmpty(l.value.armLiterals) ? em : genPrimitiveArm(em, l.value, sv, typeName, resultType, r),
        l.next, sv, typeName, resultType, r)

fun genPrimitiveArm(em: GEmit, arm: PArm, sv: RParam, typeName: String, resultType: Spec|None, r: Resolver): GEmit
  let idx = em.geCounter   # peek for the literal bundle prefix only, matching Python's `idx = em.counter`
  let lt = literalAlternativeTests(arm.armLiterals, typeName, sv, r, "lit" + String(idx))
  ret emArm(em, r, resultType, arm, list1(lt.ltoTests), None, lt.ltoBundles)
