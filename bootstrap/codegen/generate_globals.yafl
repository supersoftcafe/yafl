# bootstrap/generate_globals.yafl — the per-statement global codegen trio,
# ported from pyast/statement/function.py (global_codegen → CgFunction),
# classdef.py (global_codegen → CgObject + method functions + field thunks,
# with classtools.create_thunk), and types.py (global_codegen → complex-enum
# marker + per-variant objects). LetStatement.global_codegen (statics + [lazy]
# globals, unifying the sgpPlan predicate with the emitter) is the next slice
# of this file.
namespace Bootstrap::Codegen

import System

import Bootstrap::Ast
import Bootstrap::Frontend
import Bootstrap::Ir
import Bootstrap::Lower::Ast
import Bootstrap::Parse
import Bootstrap::Resolve
import Bootstrap::StdlibCandidates



# ── FunctionStatement.global_codegen ────────────────────────────────────────

fun funGlobalCodegen(f: PsFun, r0): CgFunction
  let r = genScope(f.fGens, r0)
  let bodyR = localScope(paramLets(f.fParams), f.fNested ? r : traitScope(f.fWheres, r))
  let paramBundle = fgcParamBundles(chain(paramTargets(f.fParams)), bodyR, 0, emptyBundle())
  let bundle = match(f.fBody)
    (b: PExpr) => bundleJoin(paramBundle, withPrefix(fgcBodyBundle(b, bodyR, f.fRet), "body"))
    ()          => paramBundle
  let params = concat(list1(CgField("this", CgDataPointer())),
                       map(paramTargets(f.fParams), (t2) => CgField(stmtName2(t2), specGenerateOpt(targetType(t2), bodyR))))
  let vars = map(bundle.gbStackVars, (sv) => CgField(stackVarName(sv), rpGetType(sv)))
  ret CgFunction(f.fName, CgStruct(params), specGenerateOpt(f.fRet, bodyR), CgStruct(vars),
                 cgOpsOf(bundle.gbOps), f.fName, foreignSymbolOf(f),
                 hasAttr(f.fAttrs, "sync"), hasAttr(f.fAttrs, "tail"), false,
                 inlineAlways(f),
                 f.psfLine.plFile, f.psfLine.plLine)

fun fgcBodyBundle(b, bodyR, fRet: Spec|None): GBundle
  let bodyBundle = genExprTo(b, bodyR, fRet)
  ret bundleJoin(bodyBundle, bundleOp1(OpReturn(mustResult(bodyBundle), List())))

# Python: `for index, parameter in enumerate(self.parameters.targets):
#   bundle += parameter.to_c_destructure(None).with_prefix(f"p{index}")`.
# A LEAF target contributes nothing (to_c_destructure(None) is empty); a
# DESTRUCTURE target declares its own tuple root and unpacks off it.
fun [tail] fgcParamBundles(ts: Chain<PStmt>, r, i, acc: GBundle) => match(ts)
  (nil: ChainEnd) => acc
  (l: ChainLink)  => fgcParamBundles(l.next, r, i + 1,
                       bundleJoin(acc, withPrefix(tcdRootless(l.value, r), "p" + String(i))))

fun tcdRootless(st, r) => match(st)
  (d: PsDestructure) => toCDestructureTargets(d, RpStackVar(specGenerate(dPureTupleType(d), r), d.dName), r)
  (o: PStmt)         => emptyBundle()

fun paramTargets(params) => match(params)
  (d: PsDestructure) => d.dTargets
  (o: PStmt)         => List()   # unreachable: a fun's parameters node is a destructure

fun targetType(st) => match(st)
  (l: PsLet)         => l.lType
  (d: PsDestructure) => d.dType
  (o: PStmt)         => None

fun foreignSymbolOf(f: PsFun) => match(attrValueOf(f.fAttrs, "foreign"))
  (v: PExpr) => match(v)
    (tp: PeTuple) => exactly(chain(tp.exprs), 1) ? tupleFirstString(tp) : None
    (o: PExpr)    => None
  ()          => None

fun tupleFirstString(tp: PeTuple) => match(head(tp.exprs))
  (en: PTupEnt) => match(en.tupValue)
    (s2: PeStr) => s2.strValue
    (o: PExpr)  => None
  ()             => None

# `[inline(always)]` — the inline attribute CARRYING an argument (vs bare
# `[inline]`). Forces inlining regardless of size.
fun inlineAlways(f: PsFun) => match(attrValueOf(f.fAttrs, "inline"))
  (v: PExpr) => true
  ()          => false

# ── ClassStatement.global_codegen (+ classtools.create_thunk) ───────────────

class [final] ClassCodegenOut(ccObject: CgObject, ccFunctions: List<CgFunction>)

fun classGlobalCodegen(c, r0): ClassCodegenOut
  # Python: ResolverType(ResolverData(resolver, __find_locals)) — the class's
  # find_data (params + members + parents) PLUS `this`, no trait data.
  # RClassBody is that exact scope (classBodyFindings); params-only localScope
  # left `this` unresolvable inside member bodies at generate.
  let r = genScope(c.cGens, RClassBody(c, r0))
  let genFunctions = classMemberFunctions(chain(c.cMembers), r, List())
  let extends = c.cIsInterface ? List<String>() : sort(classParentUids(c))
  let functions = c.cIsInterface ? List<CgFuncSlot>() : classSlotEntries(c)
  let functionNames = map(functions, (s2: CgFuncSlot) => s2.slotGlobalName)
  let thunks = classFieldThunks(chain(flattenParams(c.cParams)), c.cName, functionNames, r, List())
  let fields = classObjectFields(c, r)
  ret ClassCodegenOut(
        # [mutable]: fields written after construction, so the collector must not
        # relocate it — a write can otherwise land in a copy that is then
        # abandoned. See docs/memoize-proposal.md.
        # [pinnable]: written only inside a late pin, so it DOES relocate and
        # its reads follow forwarding instead.
        CgObject(c.cName, extends, functions, fields.cofStruct, fields.cofLengthField,
                 c.cName, hasAttr(c.cAttrs, "foreign"), hasAttr(c.cAttrs, "mutable"), 0,
                 hasAttr(c.cAttrs, "pinnable")),
        concat(genFunctions, thunks))

fun classMemberFunctions(ms, r, acc: List<CgFunction>): List<CgFunction>
  ret build(classMemberFunctionsB(ms, r, builderFrom(acc)))

fun [tail] classMemberFunctionsB(ms: Chain<PStmt>, r, [terminal] acc: ListBuilder<CgFunction>)
  ret match(ms)
    (nil: ChainEnd) => acc
    (l: ChainLink)  => match(l.value)
      (f2: PsFun) => classMemberFunctionsB(l.next, r, push(acc, funGlobalCodegen(f2, r)))
      (o: PStmt)  => classMemberFunctionsB(l.next, r, acc)

# extends: sorted unique-id strings of the transitive parent closure.
fun classParentUids(c: PsClass) => match(c.cAllParents)
  (ps: List<Spec>) => filter(map(ps, uid), (s2) => length(s2) > 0)
  ()                => List()

# functions: (virtual name, global name) per provided name per slot —
# Python `tuple((y, x.name) for x in self._all_slots for y in sorted(x.provides))`.
fun classSlotEntries(c: PsClass) => match(c.cAllSlots)
  (slots: List<Slot>) => cseLoop(chain(slots), List())
  ()                   => List()

fun [tail] cseLoop(ss: Chain<Slot>, acc) => match(ss)
  (nil: ChainEnd) => acc
  (l: ChainLink)  => cseLoop(l.next,
                       concat(acc, map(sort(l.value.slotProvides),
                                       (y) => CgFuncSlot(y, l.value.slotName))))

# A fun-typed FIELD occupying a vtable slot needs a dispatch thunk: load the
# field off `this`, call it with the packed params, return the result.
fun classFieldThunks(ps, className, functionNames: List<String>,
                            r, acc: List<CgFunction>)
  ret build(classFieldThunksB(ps, className, functionNames, r, builderFrom(acc)))

fun [tail] classFieldThunksB(ps: Chain<PStmt>, className, functionNames: List<String>,
                            r, [terminal] acc: ListBuilder<CgFunction>) => match(ps)
  (nil: ChainEnd) => acc
  (l: ChainLink)  => match(l.value)
    (let2: PsLet) => contains2(functionNames, let2.lName)
      ? classFieldThunksB(l.next, className, functionNames, r, push(acc, createThunk(className, let2, r)))
      : classFieldThunksB(l.next, className, functionNames, r, acc)
    (o: PStmt)    => classFieldThunksB(l.next, className, functionNames, r, acc)

fun createThunk(className, let2: PsLet, r)
  let paramStruct = thunkParamStruct(let2.lType, r)
  let resultType = thunkResultType(let2.lType, r)
  let paramVars = map(cgStructFields(paramStruct), (f2) => RpStackVar(f2.fieldType, f2.fieldName))
  let resultVar = RpStackVar(resultType, "result")
  let opCall = OpCall(RpObjectField(CgFuncPointer(false), RpStackVar(CgDataPointer(), "this"), className, let2.lName, None, false),
                      RpNewStruct(map(paramVars, (sv) => RpNamedValue(stackVarName(sv), sv))),
                      resultVar, false, false, None, List())
  ret CgFunction(let2.lName,
                 CgStruct(concat(list1(CgField("this", CgDataPointer())), cgStructFields(paramStruct))),
                 resultType,
                 CgStruct(list1(CgField("result", resultType))),
                 cgOpsOf(list2(opCall, OpReturn(resultVar, List()))),
                 "", None, false, false, false, false)

fun thunkParamStruct(sp: Spec|None, r) => match(sp)
  (s2: Spec) => match(s2)
    (cl: SCallable) => specGenerate(cl.scParams2, r)
    (o: Spec)       => CgStruct(List())
  ()          => CgStruct(List())

fun thunkResultType(sp: Spec|None, r) => match(sp)
  (s2: Spec) => match(s2)
    (cl: SCallable) => specGenerateOpt(cl.scResult, r)
    (o: Spec)       => CgDataPointer()
  ()          => CgDataPointer()

fun cgStructFields(t2) => match(t2)
  (s2: CgStruct) => s2.fields
  (o: CgType)    => List()

# fields: "type" DataPointer first, then the scalar params; an array-carrying
# class lays the scalars (incl. the length field) before a 0-length trailing
# "array" field.
class [final] ClassObjFields(cofStruct: CgType, cofLengthField: String|None)

fun classObjectFields(c: PsClass, r)
  let params = flattenParams(c.cParams)
  ret match(classArrayParam(chain(params)))
    (ap: PsLet) => classObjectFieldsArray(params, ap, r)
    ()           => ClassObjFields(
                      CgImmediateStruct(concat(list1(CgField("type", CgDataPointer())),
                                                map(params, (p) => letCgField(p, r)))),
                      None)

fun letCgField(p, r) => match(p)
  (l: PsLet) => CgField(l.lName, specGenerateOpt(l.lType, r))
  (o: PStmt) => CgField("", CgDataPointer())

fun [tail] classArrayParam(ps: Chain<PStmt>) => match(ps)
  (nil: ChainEnd) => None
  (l: ChainLink)  => match(l.value)
    (let2: PsLet) => isArrayField(let2.lType) ? let2 : classArrayParam(l.next)
    (o: PStmt)    => classArrayParam(l.next)

fun isArrayField(sp: Spec|None) => match(sp)
  (s2: Spec) => match(s2)
    (af: SArrayField) => true
    (o: Spec)         => false
  ()          => false

fun classObjectFieldsArray(params: List<PStmt>, ap: PsLet, r)
  let scalars = filter(params, (p) => !isSameLet(p, ap))
  let scalarFields = map(scalars, (p) => letCgField(p, r))
  let arrayField = CgField("array", CgArray(specGenerateOpt(arrayElem(ap.lType), r), 0))
  ret ClassObjFields(
        # Header, the scalar fields, then the trailing array LAST.
        CgImmediateStruct(concat(list1(CgField("type", CgDataPointer())),
                                 build(push(builderFrom(scalarFields), arrayField)))),
        arrayLengthFieldName(scalars, ap))

fun isSameLet(p, ap: PsLet) => match(p)
  (l: PsLet) => l.lName == ap.lName
  (o: PStmt) => false

# Python: `next(p.name for p in scalars if name_matches(p.name, length_field))`
# — the length field's MANGLED name, resolved among the scalar params. The
# marker string is the field's bare spelling; the emitted offsetof needs the
# struct member's name (fieldNameMatching, as the array-read path already
# does), or the vtable points at a member that does not exist.
fun arrayLengthFieldName(scalars: List<PStmt>, ap: PsLet)
  ret length(ap.lArrayLen) > 0 ? fieldNameMatching(chain(scalars), ap.lArrayLen) : None

# ── EnumStatement.global_codegen (types.py) ─────────────────────────────────

# Complex enums emit one Object PER VARIANT (own vtable, variant-sized layout,
# global discriminator id) plus a never-instantiated MARKER root object.
# A FLAT root with BOXED leaves (payload over the value-struct threshold —
# the enum-encoding principle) emits the marker plus one Object per boxed
# leaf, borrowing the same machinery; its inline leaves stay in the pool.
# Simple enums (and non-root statements) emit nothing.
fun enumGlobalCodegen(st: PsEnum, r) => match(asEnumVariant(st.eSpec))
  (sp: SEnum) if enumIsRootStmt(st) => enumRootObjects(st, sp, r)
  ()           => List()

fun enumRootObjects(st: PsEnum, sp: SEnum, r)
  if isComplexRoot(r, sp.seRoot)
    ret enumComplexObjects(st, sp, r, true)
  ret enumAnyBoxedLeaf(chain(sp.seAllLeaves), r, sp.seRoot)
    ? enumComplexObjects(st, sp, r, false)
    : List()

fun [tail] enumAnyBoxedLeaf(names: Chain<String>, r, rootName) => match(names)
  (nil: ChainEnd) => false
  (l: ChainLink)  => isBoxedLeaf(r, rootName, l.value)
    ? true
    : enumAnyBoxedLeaf(l.next, r, rootName)

fun enumIsRootStmt(st: PsEnum) => match(st.eRootName)
  (rn: String) => rn == st.eName
  ()            => true

fun enumComplexObjects(st: PsEnum, sp: SEnum, r, isComplex: Bool)
  let discs = getDiscriminators(r)
  # NOTE: [mutable] on enums is still unimplemented (the ATTRIBUTE now parses;
  # honouring it here is separate work). Leaves are emitted immutable.
  #
  # EVERY boxed enum carries a hidden Int32 hash-cache slot DIRECTLY AFTER
  # the vtable pointer, in every leaf (and the never-instantiated marker,
  # documenting the shared prefix). The fixed offset — sizeof(vtable_t*) —
  # is what lets yafl_hash_peek/store exist once, not per type; with
  # GC_ALLOC_GRANULE at 32 the word is usually absorbed by padding. A
  # scalar: absent from pointer masks, no barrier, and deliberately NOT
  # [mutable] — a store lost to a compaction move is a benign recompute, as
  # string_t's lazy hash.
  let prefix = list2(CgField("type", CgDataPointer()),
                     CgField("$hash", CgInt(32)))
  let marker = CgObject(st.eName, List(), List(),
                        CgImmediateStruct(prefix),
                        None, st.eName + " — enum root marker (never instantiated)",
                        false, false, 0)
  let leafSets = collectLeafFieldSets(st, List())
  ret concat(list1(marker),
             enumLeafObjects(chain(sp.seAllLeaves), chain(leafSets), st.eName,
                             discs, r, prefix, List()))

fun enumLeafObjects(names, sets, rootName,
                           discs: Dict<String, Int>, r,
                           prefix: List<CgField>, acc: List<CgObject>): List<CgObject>
  ret build(enumLeafObjectsB(names, sets, rootName, discs, r, prefix, builderFrom(acc)))

fun [tail] enumLeafObjectsB(names: Chain<String>, sets: Chain<List<PStmt>>, rootName,
                           discs: Dict<String, Int>, r,
                           prefix, [terminal] acc: ListBuilder<CgObject>) => match(names)
  (nil: ChainEnd) => acc
  (l: ChainLink)  => match(sets)
    (nil2: ChainEnd) => acc   # unreachable: leaf names and field sets zip 1:1
    (ls: ChainLink)  => enumLeafObjectsB(l.next, ls.next, rootName, discs, r, prefix,
                          push(acc, enumLeafObject(l.value, ls.value, rootName, discs, r, prefix)))

fun enumLeafObject(leafName, leafFields: List<PStmt>, rootName,
                   discs: Dict<String, Int>, r, prefix)
  let objName = enumLeafObjectName(rootName, leafName)
  let fields = concat(prefix,
                       map(leafFields, (p) => letCgField(p, r)))
  # Strict lookup: the registry enumerates leaves from these same root
  # statements, so a miss is a compiler bug — loud, not a dispatch fall-through.
  # A VARIANT's [pinnable] reaches its emitted object (a leaf whose field is
  # late-pin written), exactly as for a [pinnable] class.
  ret CgObject(objName, list1(rootName), List(),
               CgImmediateStruct(fields), None, "", false, false,
               getOr0(discs, "enumleaf(" + objName + ")"),
               enumLeafIsPinnable(rootName, leafName, r))

fun enumLeafIsPinnable(rootName, leafName, r) => match(soleItem(findType(r, rootName)))
  (f: Found) => match(f.fStmt)
    (e: PsEnum) => leafHasAttr(e, leafName, "pinnable")
    (o: PStmt)  => false
  ()          => false

fun leafHasAttr(e: PsEnum, leafName, attr: String) => fold(e.eVariants, false, (found, v) =>
                                                        found || variantHasAttr(v, leafName, attr))

fun variantHasAttr(v, leafName, attr: String) => match(v)
  (ve: PsEnum) => isEmpty(ve.eVariants)
    ? (ve.eName == leafName && hasAttr(ve.eAttrs, attr))
    : leafHasAttr(ve, leafName, attr)
  (o: PStmt)   => false

# ── LetStatement.global_codegen: statics + [lazy] globals (lets.py) ─────────

# The compile-time-constant emission plan: the Global(s) a constant-tree
# initialiser becomes — nested constructors emitted first as anonymous static
# instances, the let's own global last. None when any part needs runtime work
# (the let is then [lazy]-promoted). This is BOTH the promotion predicate
# (lower_lazy_lets' hasStaticGlobalPlan derives from it) and the emitter —
# ONE routine, so decision and emission cannot disagree (Python's own rule).
class [final] LetCodegenOut(lcGlobals: List<CgGlobal>, lcFunctions: List<CgFunction>)

fun letGlobalCodegen(l: PsLet, r)
  if isDeferredInit(l)
    ret LetCodegenOut(letLazyGlobal(l, r), List())
  ret match(staticGlobalPlan(l, r, List()))
    (plan: List<CgGlobal>) => LetCodegenOut(plan, List())
    ()                      => LetCodegenOut(letPlainGlobal(l, r), List())

# Non-[lazy], non-static: reaches here only when lower_lazy_lets did NOT
# auto-promote — the init must be a single pure RParam (Python raises on a
# non-trivial bundle; here the abort surfaces via an OpAbort-free contract
# diff instead).
fun letPlainGlobal(l: PsLet, r)
  let xtype = specGenerateOpt(l.lType, r)
  ret match(l.lDefault)
    (dv: PExpr) => list1(CgGlobal(l.lName, xtype, mustResult(genExprTo(dv, r, l.lType)), None, None, None))
    ()           => list1(CgGlobal(l.lName, xtype, None, None, None, None))

# [lazy] global — a static Lazy$<irmangle> stub whose closure points at the
# lifted captureless init function (the lambdas pass guarantees the RHS is a
# single fun_t value by now).
fun letLazyGlobal(l: PsLet, r)
  let xtype = specGenerateOpt(l.lType, r)
  let stubCls = stubClassName(xtype)
  let closureValue = match(l.lDefault)
    (dv: PExpr) => mustResult(genExpr(dv, r))
    ()           => RpNullPointer()   # unreachable: [lazy] requires an initialiser (checked earlier)
  let stubInit = RpNewStruct(list3(RpNamedValue("flag", RpNullPointer()),
                                   RpNamedValue("closure", closureValue),
                                   RpNamedValue("value", RpZeroOf(xtype))))
  ret list1(CgGlobal(l.lName, CgDataPointer(), stubInit, stubCls, None, None))

# ── static_global_plan: predicate AND emitter ───────────────────────────────

# rec()'s result: the RParam the expression reduces to (None = plan fails)
# plus the anonymous statics emitted along the way, in emission order.
class [final] SgpOut(sgpRp: RParam|None, sgpGlobals: List<CgGlobal>)

fun staticGlobalPlan(l: PsLet, r, chasing: List<String>)
  if contains2(chasing, l.lName)
    ret None
  ret match(l.lDefault)
    (dv: PExpr) => match(l.lType)
      # A declared type still holding an unresolved NAME cannot be emitted as
      # a static (Python: get_type().generate raises; the plan falls to lazy).
      (t2: Spec) => specHasNamed(t2)
        ? None
        # `chasing` is the cycle guard — a membership set.
        : sgpFinish(l, r, sgpEmit(dv, r, prepend(l.lName, chasing),
                                  l.lName + "$static"))
      ()         => None
    ()          => None

fun sgpFinish(l: PsLet, r, out: SgpOut) => match(out.sgpRp)
  (rp: RParam) => sgpLeafOk(rp)
    # The let's own global comes after the ones its initialiser needed.
    ? build(push(builderFrom(out.sgpGlobals), CgGlobal(l.lName, specGenerateOpt(l.lType, r), rp, None, None, None)))
    : None
  ()            => None

# Everything a C static initialiser can hold. A GlobalVar READ is not a
# constant expression, so a reference surviving to a leaf disqualifies.
fun sgpLeafOk(rp) => match(rp)
  (ns: RpNewStruct)       => sgpLeavesOk(chain(ns.values))
  (i: RpInteger)          => true
  (f: RpFloat)            => true
  (s2: RpString)          => true
  (np: RpNullPointer)     => true
  (z: RpZeroOf)           => true
  (so: RpStaticObjectRef) => true
  (o: RParam)             => false

fun [tail] sgpLeavesOk(vs: Chain<RpNamedValue>) => match(vs)
  (nil: ChainEnd) => true
  (l: ChainLink)  => sgpLeafOk(l.value.value) ? sgpLeavesOk(l.next) : false

# rec(): a constructor call (pre-inline) or NewExpression (post-inline) → an
# anonymous static instance; a conversion → only a PURE emission stays static;
# a reference to another global let → chase its plan and borrow a constant /
# static address (strings stay a GlobalVar read and fail leaf_ok at the use
# site); anything else must generate to a single pure RParam.
fun sgpEmit(x, r, chasing: List<String>, hint) => match(x)
  (c: PeCall)    => match(c.function)
    (nm: PeName) => match(c.parameter)
      (args: PeTuple) => sgpEmitCtor(nm.refName, args, r, chasing, hint)
      (o: PExpr)      => sgpNo()
    (o2: PExpr)  => sgpNo()
  (nw: PeNew)    => match(nw.newType)
    (ct: SClass) => match(nw.newParam)
      (args: PeTuple) => sgpEmitCtor(ct.scName, args, r, chasing, hint)
      (o: PExpr)      => sgpNo()
    (o2: Spec)   => sgpNo()
  (cv: PeConvert) => sgpEmitConvert(cv, r, chasing, hint)
  (nm2: PeName)   => sgpEmitChase(nm2.refName, r, chasing)
  (o: PExpr)      => sgpEmitFallback(x, r)

fun sgpNo() => SgpOut(None, List())

# Anything else: literals, tuples of constants, unit refs — must generate to
# a single pure RParam (no ops, no stack vars). Validated by leaf_ok upstream.
fun sgpEmitFallback(x, r)
  let b = genExpr(x, r)
  ret isEmpty(b.gbOps) && isEmpty(b.gbStackVars)
    ? SgpOut(b.gbResult, List())
    : sgpNo()

# A conversion (boxing into a union slot): convert the constant value; only a
# PURE emission (no ops) stays static.
fun sgpEmitConvert(cv: PeConvert, r, chasing: List<String>, hint)
  let inner = sgpEmit(cv.convInner, r, chasing, hint)
  ret match(inner.sgpRp)
    (rp: RParam) => sgpEmitConvertOn(cv, r, inner, rp)
    ()            => sgpNo()

fun sgpEmitConvertOn(cv: PeConvert, r, inner: SgpOut, rp: RParam)
  let b = emitConversion(rp, exprType(cv.convInner, r), cv.convTarget, r)
  ret isEmpty(b.gbOps) && isEmpty(b.gbStackVars)
    ? SgpOut(b.gbResult, inner.sgpGlobals)
    : sgpNo()

fun sgpEmitCtor(name, args: PeTuple, r, chasing: List<String>, hint)
  ret match(soleItem(findType(r, name)))
    (f: Found) => match(f.fStmt)
      (cls: PsClass) => sgpEmitInstance(cls, args, r, chasing, hint)
      (o: PStmt)     => sgpNo()
    ()          => sgpNo()

fun sgpEmitInstance(cls: PsClass, args: PeTuple, r, chasing: List<String>, hint)
  if cls.cIsInterface || isSomeLet(classArrayParam(chain(flattenParams(cls.cParams))))
    ret sgpNo()
  let fields = flattenParams(cls.cParams)
  if !sameLen(chain(args.exprs), chain(fields))
    ret sgpNo()
  ret sgpEmitFields(chain(args.exprs), chain(fields), cls, r, chasing, hint, 0,
                    List(), List())

fun isSomeLet(l: PsLet|None) => match(l)
  (l2: PsLet) => true
  ()           => false

fun sgpEmitFields(as2, fs, cls: PsClass, r,
                         chasing: List<String>, hint, i,
                         pairs, globals) => match(as2)
  (nil: ChainEnd) => sgpInstanceDone(cls, hint, pairs, globals)
  (l: ChainLink)  => match(fs)
    (nil2: ChainEnd) => sgpNo()   # unreachable: arity checked by caller
    (lf: ChainLink)  => sgpEmitField(as2, fs, l, lf, cls, r, chasing, hint, i, pairs, globals)

fun sgpEmitField(as2: Chain<PTupEnt>, fs: Chain<PStmt>, l: ChainLink<PTupEnt>, lf: ChainLink<PStmt>,
                 cls: PsClass, r, chasing: List<String>, hint, i,
                 pairs, globals)
  let sub = sgpEmit(l.value.tupValue, r, chasing, hint + "$f" + String(i))
  ret match(sub.sgpRp)
    (rp: RParam) if sgpLeafOk(rp) =>
        sgpEmitFields(l.next, lf.next, cls, r, chasing, hint, i + 1,
                      build(
                        push(builderFrom(pairs),
                             RpNamedValue(stmtName2(lf.value), rp))),
                      concat(globals, sub.sgpGlobals))
    ()            => sgpNo()

fun sgpInstanceDone(cls: PsClass, hint, pairs,
                    globals) => SgpOut(RpStaticObjectRef(hint),
                                       build(push(builderFrom(globals), CgGlobal(hint, CgDataPointer(), RpNewStruct(pairs), cls.cName, None, None))))

# A reference to another global let: chase its own plan. An integer/float
# constant inlines its constant; a static class instance is referenced by
# address. Strings stay a GlobalVar read and fail leaf_ok at the use site.
fun sgpEmitChase(name, r, chasing: List<String>) => match(soleItem(findData(r, name)))
  (f: Found) => match(f.fStmt)
    (let2: PsLet) => !isDeferredInit(let2) && !contains2(chasing, let2.lName)
      ? sgpChasePlan(let2, r, chasing)
      : sgpNo()
    (o: PStmt)    => sgpNo()
  ()          => sgpNo()

fun sgpChasePlan(let2: PsLet, r, chasing: List<String>) => match(staticGlobalPlan(let2, r, chasing))
  (sub: List<CgGlobal>) => sgpBorrowLast(sub)
  ()                     => sgpNo()

# The referenced let emits its globals itself; we only borrow the constant /
# the address of its LAST global.
fun sgpBorrowLast(sub: List<CgGlobal>) => match(lastGlobal(chain(sub)))
  (g2: CgGlobal) => match(g2.globalInit)
    (init: RParam) => sgpBorrowInit(init)
    ()              => sgpNo()
  ()              => sgpNo()

fun sgpBorrowInit(init) => match(init)
  (i: RpInteger)          => SgpOut(init, List())
  (f: RpFloat)            => SgpOut(init, List())
  (so: RpStaticObjectRef) => SgpOut(init, List())
  (o: RParam)             => sgpNo()

fun [tail] lastGlobal(gs: Chain<CgGlobal>) => match(gs)
  (nil: ChainEnd) => None
  (l: ChainLink)  => match(l.next)
    (nil2: ChainEnd) => l.value
    (l2: ChainLink)  => lastGlobal(l.next)
