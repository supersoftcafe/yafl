namespace Bootstrap::Codegen

import System

import Bootstrap::Ast

import Bootstrap::Ir
import Bootstrap::Lower::Ast
import Bootstrap::StdlibCandidates



# bootstrap/perfecthash.yafl — port of compiler/codegen/perfecthash.py: a
# greedy near-perfect hash assignment for vtable dispatch slots.
#
# Python threads two pieces of MUTABLE state across the whole algorithm: a
# `new_id` counter (closed over by `next_method_id()`) and a `conflict_graph`
# dict-of-sets that is rebuilt every outer iteration and mutated in place
# during the greedy vertex-cover pass. Both become explicit values threaded
# through as extra parameters/return fields — same discipline as the
# `type_cache` threading in typedecl.yafl.
#
# DETERMINISM: Python's re-randomisation loop iterates `sorted(cover)` —
# the cover is a set, and hash-order iteration there was the one place id
# assignment was not deterministic by construction (it showed up as a
# single method id differing between the compilers at whole-program
# scale). Both sides now sort the cover before reassigning ids.
#
# Despite the Python docstring/import ("Generate random 32-bit ids"), no
# randomness is actually used anywhere — `random` is imported but never
# called; ids are assigned by the sequential `next_method_id()` counter.
# Ported as-is (see the port report for this being flagged as dead
# import / stale comment upstream, not a behavioural bug).

# vtN is the method count, CARRIED from the walk that builds `methods`
# (no-length ruling) — the hash-table sizing needs it as data.
class [final] VtableEntry(className: String, methods: List<String>, vtN: Int)
class [final] MethodId(mName: String, mId: Int)
class [final] VtableSize(vsClassName: String, vsSize: Int)
class [final] PerfectHashResult(methodIds: List<MethodId>, vtableSizes: List<VtableSize>)

# Python's int.bit_length() measures the ABSOLUTE value, so
# (-1).bit_length() == 1 and next_power_of_two(0) == 2 — a method-less
# vtable still gets two catch-all rows. The port must keep the quirk.
fun bitLength(n) => n < 0 ? bitLength(0 - n) : n == 0 ? 0 : 1 + bitLength(n / 2)

fun nextPowerOfTwo(n) => pow2(bitLength(n - 1))

# Python: `sorted(set(name for sublist in vtables.values() for name in sublist))`.
# A set, so nothing but the sort's order is ever observed — which is why the
# gathering is a Set here and not a list that gets deduped afterwards.
fun phAllMethodNames(vtables: List<VtableEntry>)
  ret sort(fold(vtables, Set(), (acc, v) =>
        fold(v.methods, acc, (names, n) => add(names, n))))

# This list's ORDER IS OBSERVED: gen.yafl emits the __FUNCTION_ID__ enum by
# walking it, mirroring Python's insertion-ordered method_ids dict (later
# re-assignment overwrites a value, so it never moves a key). Ids are handed
# out along the same walk, so the builder and the counter stay in step and the
# next free id rides out with them.
class [final] IdAcc(iaIds: List<MethodId>, iaNext: Int)

fun phAssignIds(names: List<String>): (ids: List<MethodId>, next: Int)
  ret phAssignIdsFinish(phAssignIdsLoop(names,
                                        IdAcc(List(), 0)))

fun phAssignIdsFinish(acc: IdAcc): (ids: List<MethodId>, next: Int)
  ret (acc.iaIds, acc.iaNext)

fun [tail] phAssignIdsLoop(names: List<String>, [terminal] acc: IdAcc) => isEmpty(names)
  ? acc
  : phAssignIdsLoop(tail(names),
      IdAcc(append(acc.iaIds, MethodId(first(names), acc.iaNext)),
            acc.iaNext + 1))

fun phVtableSizes(vtables: List<VtableEntry>)
  ret map(vtables, (v) => VtableSize(v.className, nextPowerOfTwo(v.vtN * 2)))

# Dict views of the ordered lists — Python's create_perfect_lookups carries
# dicts from the start; the port's Lists stay authoritative for emission
# order, and these twins retire the linear per-query scans (vtableSizeGet
# alone was 19.1s of a self-compile at ~116us per call).
fun [tail] methodIdDict(ms: List<MethodId>, acc): Dict<String, Int> => isEmpty(ms)
  ? acc
  : methodIdDict(tail(ms), put(acc, first(ms).mName, first(ms).mId))

fun [tail] vtableSizeDict(vs: List<VtableSize>, acc): Dict<String, Int> => isEmpty(vs)
  ? acc
  : vtableSizeDict(tail(vs), put(acc, first(vs).vsClassName, first(vs).vsSize))

fun methodIdGet(ids: Dict<String, Int>, name: String) => match(get(ids, name))
  (i: Int) => i
  ()       => 0   # unreachable: every method name has an assigned id

fun vtableSizeGet(sizes: Dict<String, Int>, className: String): Int => match(get(sizes, className))
  (i: Int) => i
  ()       => 0   # unreachable: every class has an assigned size

# ── one collision-detection scan over all vtables (using the CURRENT ids) ──

class [final] CollisionPair(pairA: String, pairB: String)

# Both scan loops are SINGLE self-recursive steppers ([tail] refuses mutual
# pairs; the loop/step split left two C frames per element and the vtable
# walk alone held 8,440 frames at self-host scale — the last 8MB overflow).
# The per-element work rides inline.
#
# `slots` is Python's per-class `slots = {}`, asked only "is this index
# taken, and by whom" — a Dict, which also retires the linear scan that
# answered that question. `pairs` is a builder: it is written and never read,
# and its order IS observed, because buildConflictGraph replays it to
# reproduce Python's key insertion order.
fun [tail] phScanClassSlots(methods: List<String>, methodIds: Dict<String, Int>,
                            mask, slots: Dict<Int, String>,
                            [terminal] pairs: List<CollisionPair>) => isEmpty(methods)
  ? pairs
  : match(get(slots, methodIdGet(methodIds, first(methods)) & mask))
    (existing: String) => phScanClassSlots(tail(methods), methodIds, mask, slots,
                            append(pairs, CollisionPair(first(methods), existing)))
    ()                 => phScanClassSlots(tail(methods), methodIds, mask,
                            put(slots, methodIdGet(methodIds, first(methods)) & mask, first(methods)),
                            pairs)

fun [tail] phScanAllSlots(vtables: List<VtableEntry>, methodIds: Dict<String, Int>,
                          vtableSizes: Dict<String, Int>,
                          [terminal] pairs): List<CollisionPair> => isEmpty(vtables)
  ? pairs
  : phScanAllSlots(tail(vtables), methodIds, vtableSizes,
      phScanClassSlots(first(vtables).methods, methodIds,
                       vtableSizeGet(vtableSizes, first(vtables).className) - 1,
                       Dict(), pairs))

# ── conflict graph + greedy vertex cover ─────────────────────────────────────

# Python's conflict_graph is a defaultdict(set), and the two halves of that
# are read very differently. The NEIGHBOUR collections are sets — asked for
# their degree, their membership and one-at-a-time removal, never their order.
# The GRAPH'S OWN key order, on the other hand, IS observed: max(degree_count,
# key=...) breaks a degree tie by first insertion. So the keys keep their
# discovery order in a list and the edges live in a Dict — which also retires
# the whole-graph rewrite that removing a single edge used to cost.
class [final] ConflictGraph(cgOrder: List<String>, cgEdges: Dict<String, List<String>>)

# cgOrder is only WRITTEN during the build — "have I met this method before"
# is the Dict's question, not the list's — so it can be a builder.
class [final] CgAcc(caOrder: List<String>,
                            caEdges: Dict<String, List<String>>)

fun buildConflictGraph(pairs: List<CollisionPair>)
  ret cgFinish(bcgLoop(pairs,
                       CgAcc(List(), Dict())))

fun cgFinish(acc: CgAcc) => ConflictGraph(acc.caOrder, acc.caEdges)

fun [tail] bcgLoop(ps: List<CollisionPair>, [terminal] acc): CgAcc => isEmpty(ps)
  ? acc
  : bcgLoop(tail(ps), cgAddEdge(acc, first(ps).pairA, first(ps).pairB))

fun cgAddEdge([terminal] acc: CgAcc, a, b) => cgAddDirected(cgAddDirected(acc, a, b), b, a)

fun cgAddDirected([terminal] acc: CgAcc, from2, to) => match(get(acc.caEdges, from2))
  (ns: List<String>) => CgAcc(acc.caOrder,
      put(acc.caEdges, from2,
        strListMember(ns, to) ? ns : prepend(to, ns)))
  ()                 => CgAcc(append(acc.caOrder, from2),
      put(acc.caEdges, from2, list1(to)))

fun cgNeighbors(g: ConflictGraph, method: String) => match(get(g.cgEdges, method))
  (ns: List<String>) => ns
  ()                 => List()

fun conflictGraphHasAnyEdges(g: ConflictGraph) => any(g.cgOrder, (m) => !isEmpty(cgNeighbors(g, m)))

# Ties broken by first occurrence — matches Python's max(dict, key=...) over
# an insertion-ordered dict (this graph is built in the same discovery order
# as `phScanAllSlots`, so insertion order matches Python's exactly).
# Max-degree pick by CO-WALK: the previous best's neighbour list is the
# yardstick (None = nothing picked yet); strictly-longer wins, exactly the
# old `degree > bestDegree` with the -1 seed (no-length ruling).
fun [tail] pickMaxDegreeLoop(ms: List<String>, g: ConflictGraph,
                             bestMethod: String, bestNs: List<String>|None) => isEmpty(ms)
  ? bestMethod
  : match(bestNs)
    (ns: List<String>) => shorterThan(ns, (cgNeighbors(g, first(ms))))
      ? pickMaxDegreeLoop(tail(ms), g, first(ms), cgNeighbors(g, first(ms)))
      : pickMaxDegreeLoop(tail(ms), g, bestMethod, bestNs)
    ()                 => pickMaxDegreeLoop(tail(ms), g, first(ms),
                                            cgNeighbors(g, first(ms)))

fun pickMaxDegree(g: ConflictGraph) => pickMaxDegreeLoop(g.cgOrder, g, "", None)

fun conflictGraphRemoveOne(g: ConflictGraph, from2, target)
  ret ConflictGraph(g.cgOrder,
        put(g.cgEdges, from2,
          filter(cgNeighbors(g, from2), (x) => x != target)))

fun removeFromNeighbors(g: ConflictGraph, neighbors: List<String>, method)
  ret fold(neighbors, g, (acc, n) => conflictGraphRemoveOne(acc, n, method))

fun conflictGraphClearMethod(g: ConflictGraph, method)
  ret ConflictGraph(g.cgOrder,
        put(g.cgEdges, method, List()))

# `cover` is a Python set, sorted before its only use (phReassignCover), so
# the order methods land in it is not observed.
fun greedyVertexCoverStep(g: ConflictGraph, cover: List<String>)
  let method = pickMaxDegree(g)
  let neighbors = cgNeighbors(g, method)
  let g2 = removeFromNeighbors(g, neighbors, method)
  let g3 = conflictGraphClearMethod(g2, method)
  ret greedyVertexCover(g3, prepend(method, cover))

fun greedyVertexCover(g: ConflictGraph, cover): List<String>
  ret conflictGraphHasAnyEdges(g) ? greedyVertexCoverStep(g, cover) : cover

# ── re-assign fresh ids to every method in the cover, then re-iterate ──────

fun phReassignOne(acc: (methodIds: List<MethodId>, nextId: Int), m: String): (methodIds: List<MethodId>, nextId: Int)
  ret (map(acc.methodIds, (e) => e.mName == m ? MethodId(e.mName, acc.nextId) : e), acc.nextId + 1)

# Sorted to mirror Python's `for method in sorted(cover)` — see the
# DETERMINISM note at the top of this file.
fun phReassignCover(methodIds: List<MethodId>, cover: List<String>, nextId0: Int): (methodIds: List<MethodId>, nextId: Int)
  ret fold(sort(cover), (methodIds, nextId0),
           (acc, m) => phReassignOne(acc, m))

fun phFixpointCollision(vtables: List<VtableEntry>, methodIds0: List<MethodId>, vtableSizes: List<VtableSize>, iteration, nextId0: Int, pairs: List<CollisionPair>)
  let graph = buildConflictGraph(pairs)
  let cover = greedyVertexCover(graph, List())
  let reassigned = phReassignCover(methodIds0, cover, nextId0)
  ret phFixpoint(vtables, reassigned.methodIds, vtableSizes, iteration + 1, reassigned.nextId)

fun phFixpointStep(vtables: List<VtableEntry>, methodIds0, vtableSizes: List<VtableSize>, iteration, nextId0: Int): List<MethodId>
  # The dict views are per ROUND (ids are reassigned between rounds); the
  # build is one walk, against millions of per-method linear scans inside.
  let pairs = (phScanAllSlots(vtables,
                                  methodIdDict(methodIds0, Dict()),
                                  vtableSizeDict(vtableSizes, Dict()),
                                  List()))
  ret isEmpty(pairs)
    ? methodIds0
    : phFixpointCollision(vtables, methodIds0, vtableSizes, iteration, nextId0, pairs)

fun phFixpoint(vtables: List<VtableEntry>, methodIds0, vtableSizes: List<VtableSize>, iteration, nextId0: Int): List<MethodId>
  ret iteration >= 1000 ? methodIds0 : phFixpointStep(vtables, methodIds0, vtableSizes, iteration, nextId0)

# ── public entry point ───────────────────────────────────────────────────────

fun createPerfectLookups(vtables: List<VtableEntry>): PerfectHashResult
  let names = phAllMethodNames(vtables)
  let assigned = phAssignIds(names)
  let vtableSizes = phVtableSizes(vtables)
  let finalIds = phFixpoint(vtables, assigned.ids, vtableSizes, 0, assigned.next)
  ret PerfectHashResult(finalIds, vtableSizes)
