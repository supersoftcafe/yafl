# bootstrap/classtools.yafl — class utilities, ported from pyast/classtools.py.
#
# The COMPILE-time half only: find_classes_or_error, create_slots_from_members,
# override_inherited_slots, and the parameter flatten they rest on. The thunk
# and fragile-base machinery is check/codegen work and waits for those stages.
namespace Bootstrap::Ast

import System

import Bootstrap::Codegen
import Bootstrap::Parse
import Bootstrap::Resolve
import Bootstrap::Types



# ── parameters.flatten() ─────────────────────────────────────────────────────
# The constructor's LEAF lets — a nested destructure flattens to its leaves.

fun flattenParams(params: PStmt): List<PStmt>
  ret match(params)
    (d: PsDestructure) => build<PStmt >(flattenTargets(chain(d.dTargets),
                                                      builder<PStmt >()))
    (l: PsLet)         => prepend(params, List<PStmt>())
    (o: PStmt)         => List<PStmt>()

# Parameter order: a nested destructure contributes its own targets in place.
# (Not [tail]: the nested-destructure arm recurses into the inner targets
# before it can step on, so that self-call is not in tail position.)
fun flattenTargets(ts: Chain<PStmt>,
                          [terminal] acc: ListBuilder<PStmt >): ListBuilder<PStmt >
  ret match(ts)
    (nil: ChainEnd) => acc
    (l: ChainLink)  => match(l.value)
      (d: PsDestructure) => flattenTargets(l.next,
                                flattenTargets(chain(d.dTargets), acc))
      (o: PStmt)         => flattenTargets(l.next,
                                           push<PStmt >(acc, l.value))

# ── find_classes_or_error ────────────────────────────────────────────────────
# Resolve each inherited type to (resolved spec, class statement). A spec that
# does not resolve to exactly one CLASS keeps its ORIGINAL spelling and yields
# no class — Python pairs it with an Error, which is check's to report;
# compile just skips it. On success the resolved spec is an SClass of the
# statement's unique name with the type params COMPILED through (aliases
# resolved), so cAllParents retains parameterisation for monomorphisation.

class [final] FoundClass(fcSpec: Spec, fcClass: PsClass|None)

fun findClassesOrError(types: List<Spec>, r: Resolver): List<FoundClass>
  ret fceLoop(chain(types), r, List<FoundClass>())

fun fceLoop(ts: Chain<Spec>, r: Resolver,
                   acc: List<FoundClass>): List<FoundClass>
  ret build<FoundClass >(fceLoopB(ts, r, _pushChain<FoundClass >(builder<FoundClass >(), chain<FoundClass >(acc))))

fun [tail] fceLoopB(ts: Chain<Spec>, r: Resolver,
                   [terminal] acc: ListBuilder<FoundClass >): ListBuilder<FoundClass >
  ret match(ts)
    (nil: ChainEnd) => acc
    (l: ChainLink)  => fceLoopB(l.next, r,
                               push<FoundClass >(acc, findClassOrError(l.value, r)))

fun findClassOrError(xtype: Spec, r: Resolver): FoundClass
  ret match(xtype)
    (n: SNamed) => resolveClassSpec(xtype, n.snName, n.snParams, n.snLine, r)
    (c: SClass) => resolveClassSpec(xtype, c.scName, c.scParams, c.scLine, r)
    (o: Spec)   => FoundClass(xtype, None)

fun resolveClassSpec(xtype: Spec, name: String, params: List<Spec>,
                     lr: PLine, r: Resolver): FoundClass
  ret match(soleItem(findType(r, name)))
    (f: Found) => match(f.fStmt)
      (cs: PsClass) => FoundClass(SClass(cs.cName, compileSpecsPlain(params, r),
                                         lr),
                                  cs)
      (o: PStmt)    => FoundClass(xtype, None)
    ()         => FoundClass(xtype, None)

# The type params compile through (an alias resolves); their globals are
# discarded exactly as Python's `rp.compile(resolver)[0]` discards them.
fun compileSpecsPlain(ps: List<Spec>, r: Resolver): List<Spec>
  ret cspLoop(chain(ps), r, List<Spec>())

fun cspLoop(ps: Chain<Spec>, r: Resolver, acc: List<Spec>): List<Spec>
  ret build<Spec >(cspLoopB(ps, r, _pushChain<Spec >(builder<Spec >(), chain<Spec >(acc))))

fun [tail] cspLoopB(ps: Chain<Spec>, r: Resolver, [terminal] acc: ListBuilder<Spec >): ListBuilder<Spec >
  ret match(ps)
    (nil: ChainEnd) => acc
    (l: ChainLink)  => cspLoopB(l.next, r,
                               push<Spec >(acc, compileSpec(l.value, r).soSpec))

# ── create_slots_from_members ────────────────────────────────────────────────
# One slot per CALLABLE member (constructor params + body statements). A slot
# provides its own name when it can actually dispatch: a fun WITH a body, or a
# fun-typed field. An interface's bodiless fun provides nothing.

fun createSlotsFromMembers(cs: PsClass): List<Slot>
  ret slotLoop(chain(concat(flattenParams(cs.cParams), cs.cMembers)),
               List<Slot>())

fun slotLoop(ms: Chain<PStmt>, acc: List<Slot>): List<Slot>
  ret build<Slot >(slotLoopB(ms, _pushChain<Slot >(builder<Slot >(), chain<Slot >(acc))))

fun [tail] slotLoopB(ms: Chain<PStmt>, [terminal] acc: ListBuilder<Slot >): ListBuilder<Slot >
  ret match(ms)
    (nil: ChainEnd) => acc
    (l: ChainLink)  => isCallableMember(l.value)
      ? slotLoopB(l.next, push<Slot >(acc, toSlot(l.value)))
      : slotLoopB(l.next, acc)

fun isCallableMember(st: PStmt): Bool
  ret match(stmtType(st))
    (t2: Spec) => match(t2)
      (c: SCallable) => true
      (o: Spec)      => false
    () => false

fun toSlot(st: PStmt): Slot
  ret Slot(stmtName(st), stmtType(st), providesOwn(st))

fun providesOwn(st: PStmt): List<String>
  ret match(st)
    (l: PsLet) => prepend(l.lName, List<String>())
    (f: PsFun) => match(f.fBody)
      (b: PExpr) => prepend(f.fName, List<String>())
      ()         => List<String>()
    (o: PStmt) => List<String>()

# ── override_inherited_slots ─────────────────────────────────────────────────
# Each own slot ABSORBS every parent slot it overrides (same simple name AND
# assignable type — strictly TRUE, an undecided comparison does not override):
# the parent slot's name and everything it in turn provided join this slot's
# provides set. Parent slots so absorbed disappear from the table.

fun overrideInheritedSlots(r: Resolver, base: List<Slot>,
                           parents: List<Slot>): List<Slot>
  let enhanced = enhanceLoop(chain(base), r, parents, List<Slot>())
  let exclusion = allProvides(chain(enhanced), List<String>())
  ret concat(enhanced, keepUnabsorbed(chain(parents), exclusion, List<Slot>()))

fun enhanceLoop(bs: Chain<Slot>, r: Resolver, parents: List<Slot>,
                       acc: List<Slot>): List<Slot>
  ret build<Slot >(enhanceLoopB(bs, r, parents, _pushChain<Slot >(builder<Slot >(), chain<Slot >(acc))))

fun [tail] enhanceLoopB(bs: Chain<Slot>, r: Resolver, parents: List<Slot>,
                       [terminal] acc: ListBuilder<Slot >): ListBuilder<Slot >
  ret match(bs)
    (nil: ChainEnd) => acc
    (l: ChainLink)  => enhanceLoopB(l.next, r, parents,
                                   push<Slot >(acc, absorbMatches(l.value, r,
                                                             parents)))

fun absorbMatches(slot: Slot, r: Resolver, parents: List<Slot>): Slot
  ret Slot(slot.slotName, slot.slotType,
           matchedNames(chain(parents), slot, r, slot.slotProvides))

fun [tail] matchedNames(ps: Chain<Slot>, slot: Slot, r: Resolver,
                        acc: List<String>): List<String>
  ret match(ps)
    (nil: ChainEnd) => acc
    (l: ChainLink)  => matchName(slot.slotName, l.value.slotName)
                       && triTrue(assignableEq(r, l.value.slotType,
                                               slot.slotType))
      ? matchedNames(l.next, slot, r,
                     addNameOnce(addNamesOnce(acc,
                                              chain(l.value.slotProvides)),
                                 l.value.slotName))
      : matchedNames(l.next, slot, r, acc)

fun [tail] allProvides(ss: Chain<Slot>, acc: List<String>): List<String>
  ret match(ss)
    (nil: ChainEnd) => acc
    (l: ChainLink)  => allProvides(l.next,
                                   addNamesOnce(acc,
                                                chain(l.value.slotProvides)))

fun keepUnabsorbed(ps: Chain<Slot>, exclusion: List<String>,
                          acc: List<Slot>): List<Slot>
  ret build<Slot >(keepUnabsorbedB(ps, exclusion, _pushChain<Slot >(builder<Slot >(), chain<Slot >(acc))))

fun [tail] keepUnabsorbedB(ps: Chain<Slot>, exclusion: List<String>,
                          [terminal] acc: ListBuilder<Slot >): ListBuilder<Slot >
  ret match(ps)
    (nil: ChainEnd) => acc
    (l: ChainLink)  => contains2(exclusion, l.value.slotName)
      ? keepUnabsorbedB(l.next, exclusion, acc)
      : keepUnabsorbedB(l.next, exclusion, push<Slot >(acc, l.value))

# ── set helpers (List with set semantics) ────────────────────────────────────

# Set semantics, but the ORDER is kept: these lists become parent and slot
# orders that reach generated code. `acc` is read by the dedup just above, so
# it cannot be a builder — this is the copy the old append did, written out.
fun addNameOnce(acc: List<String>, n: String): List<String>
  ret contains2(acc, n) ? acc : build<String >(push<String >(_pushChain<String >(builder<String >(), chain<String>(acc)), n))

fun [tail] addNamesOnce(acc: List<String>, ns: Chain<String>): List<String>
  ret match(ns)
    (nil: ChainEnd) => acc
    (l: ChainLink)  => addNamesOnce(addNameOnce(acc, l.value), l.next)

fun addSpecOnce(acc: List<Spec>, sp: Spec): List<Spec>
  ret containsSpec(acc, sp) ? acc : build<Spec >(push<Spec >(_pushChain<Spec >(builder<Spec >(), chain<Spec>(acc)), sp))

fun [tail] addSpecsOnce(acc: List<Spec>, ss: Chain<Spec>): List<Spec>
  ret match(ss)
    (nil: ChainEnd) => acc
    (l: ChainLink)  => addSpecsOnce(addSpecOnce(acc, l.value), l.next)

# ── ClassStatement.find_data ─────────────────────────────────────────────────
# A member lookup: the class's OWN members first (constructor params minus the
# internal array-storage field, plus body statements) — anything found masks
# the parents — else every implemented interface's, accumulated. Member access
# to the array field resolves to the generated ACCESSOR (same name), never the
# raw storage.

fun classFindData(cs: PsClass, r: Resolver, query: String): List<Found>
  let own = memberFinds(chain(concat(nonArrayFields(cs), cs.cMembers)), query,
                        List<Found>())
  ret isEmpty(own)
    ? parentFinds(chain(findClassesOrError(cs.cImplements, r)), r, query,
                  List<Found>())
    : own

fun nonArrayFields(cs: PsClass): List<PStmt>
  ret dropArrayField(chain(flattenParams(cs.cParams)), List<PStmt>())

fun dropArrayField(ls: Chain<PStmt>, acc: List<PStmt>): List<PStmt>
  ret build<PStmt >(dropArrayFieldB(ls, _pushChain<PStmt >(builder<PStmt >(), chain<PStmt >(acc))))

fun [tail] dropArrayFieldB(ls: Chain<PStmt>, [terminal] acc: ListBuilder<PStmt >): ListBuilder<PStmt >
  ret match(ls)
    (nil: ChainEnd) => acc
    (l: ChainLink)  => isArrayStorage(l.value)
      ? dropArrayFieldB(l.next, acc)
      : dropArrayFieldB(l.next, push<PStmt >(acc, l.value))

fun isArrayStorage(st: PStmt): Bool
  ret match(st)
    (l: PsLet) => match(arrayElem(l.lType))
      (el: Spec) => true
      ()         => false
    (o: PStmt) => false

fun memberFinds(ms: Chain<PStmt>, query: String,
                       acc: List<Found>): List<Found>
  ret build<Found >(memberFindsB(ms, query, _pushChain<Found >(builder<Found >(), chain<Found >(acc))))

fun [tail] memberFindsB(ms: Chain<PStmt>, query: String,
                       [terminal] acc: ListBuilder<Found >): ListBuilder<Found >
  ret match(ms)
    (nil: ChainEnd) => acc
    (l: ChainLink)  => nameMatches(stmtName(l.value), query)
      ? memberFindsB(l.next, query, push<Found >(acc, Found(stmtName(l.value),
                                                     l.value, ScMember())))
      : memberFindsB(l.next, query, acc)

fun [tail] parentFinds(fs: Chain<FoundClass>, r: Resolver, query: String,
                       acc: List<Found>): List<Found>
  ret match(fs)
    (nil: ChainEnd) => acc
    (l: ChainLink)  => match(l.value.fcClass)
      (p: PsClass) => parentFinds(l.next, r, query,
                                  concat(acc, classFindData(p, r, query)))
      ()           => parentFinds(l.next, r, query, acc)

# `this` inside a generic class carries the class's own placeholders — a bare
# ClassSpec would fail the declared-arity check later.
fun thisFound(cs: PsClass, query: String): List<Found>
  ret query == "this"
    ? prepend(Found("this", thisLet(cs), ScLocal()), List<Found>())
    : List<Found>()

fun thisLet(cs: PsClass): PStmt
  ret PsLet("this", List<PAttr>(), List<PGen>(), thisType(cs), None, "",
            List<Spec>(), cs.pscLine)

fun thisType(cs: PsClass): Spec
  ret SClass(cs.cName,
             map(cs.cGens, (g2: PGen) => SGeneric(g2.genName, isLinearGen(g2),
                                                  g2.pgLine)),
             cs.pscLine)


# ── structural size probes ───────────────────────────────────────────────────
# The no-length ruling (user, 08-11): a list's length is never CALCULATED.
# Bounded questions are answered by bounded probes, length comparisons by
# co-walks, and a count that genuinely must exist is carried from the walk
# that built the list. These helpers are the whole vocabulary.

# At least n elements: walks at most n cells.
fun [tail] atLeast<T>(c: Chain<T>, n: Int): Bool
  ret n <= 0 ? true : match(c)
    (nil: ChainEnd) => false
    (l: ChainLink)  => atLeast(l.next, n - 1)

# At most n elements: walks at most n+1 cells.
fun atMost<T>(c: Chain<T>, n: Int): Bool
  ret !atLeast<T>(c, n + 1)

# Exactly n elements: two bounded probes.
fun exactly<T>(c: Chain<T>, n: Int): Bool
  ret atLeast<T>(c, n) && !atLeast<T>(c, n + 1)

# The two-list co-walks spell EVERY generic call with explicit type args.
# The silent third-shape abort (a bare match arm inside a two-type-param host
# latching the wrong enum instantiation) is FIXED — witness test:
# tests/test_two_generic_match.py — so nested matches over Chain<T>/Chain<U>
# are safe now. The explicit <T>/<U> on the CALLS remain load-bearing for a
# different, LOUD reason: a cross-function inferred generic call inside a
# generic host still fails "cannot infer the type arguments" (the ledgered
# nested-generic inference gap, shapes 1-2); explicit args are the
# sanctioned form until that inference lands.

fun isEnd<T>(c: Chain<T>): Bool
  ret match(c)
    (nil: ChainEnd) => true
    (l: ChainLink)  => false

# The next link, or the (empty) chain itself at the end — callers guard with
# isEnd, so the self-return arm never drives a loop.
fun restOf<T>(c: Chain<T>): Chain<T>
  ret match(c)
    (nil: ChainEnd) => c
    (l: ChainLink)  => l.next

# Same length: co-walk, stops at the shorter.
fun [tail] sameLen<T, U>(a: Chain<T>, b: Chain<U>): Bool
  ret isEnd<T>(a) || isEnd<U>(b)
    ? isEnd<T>(a) && isEnd<U>(b)
    : sameLen<T, U>(restOf<T>(a), restOf<U>(b))

# Strictly fewer elements than b: co-walk, stops at the shorter.
fun [tail] shorterThan<T, U>(a: Chain<T>, b: Chain<U>): Bool
  ret isEnd<U>(b)
    ? false
    : (isEnd<T>(a) ? true : shorterThan<T, U>(restOf<T>(a), restOf<U>(b)))

# All but the last element, structurally.
fun initOf<T>(l: List<T>): List<T>
  ret build<T>(initLoop<T>(chain(l), builder<T>()))

# Everything but the last element, in order.
fun [tail] initLoop<T>(c: Chain<T>, [terminal] acc: ListBuilder<T>): ListBuilder<T>
  ret match(c)
    (nil: ChainEnd) => acc
    (l: ChainLink)  => l.next is ChainEnd
      ? acc
      : initLoop<T>(l.next, push<T>(acc, l.value))
