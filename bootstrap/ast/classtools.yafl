# bootstrap/classtools.yafl — class utilities, ported from pyast/classtools.py.
#
# The COMPILE-time half only: find_classes_or_error, create_slots_from_members,
# override_inherited_slots, and the parameter flatten they rest on. The thunk
# and fragile-base machinery is check/codegen work and waits for those stages.
namespace Bootstrap::Ast

import System
import System::Containers

import Bootstrap::Codegen
import Bootstrap::Parse
import Bootstrap::Resolve
import Bootstrap::StdlibCandidates
import Bootstrap::Types



# ── capture field names (pyast/utils.py: capture_field_name) ────────────────
# The field a synthesised closure class stores a capture of `name` under:
# itself, unless it answers to `this`.
#
# A field spelled `this` would collide with the receiver a class puts in scope
# for every method body, leaving the reference with two candidates. The `$` is
# what avoids that and a hash alone would not: lookup matches by PREFIX
# (nameMatches), so `this@<hash>` still answers to `this`. That is also the
# spelling of a captured LOCAL named `this` — uniquified to `this@<hash>` — so
# it takes the `$` too; its own hash already makes it unique. The receiver has
# none, and `lr` makes its field unique within the class that holds it.

fun capturedFieldName(name, lr: PLine): String
  if name == "this"
    ret "$this@" + hash6(lr.plFile, lr.plLine, lr.plCol)
  ret startsWith(name, "this@") ? "$" + name : name


# ── does a member occupy a vtable slot, and so dispatch virtually? ───────────
# Every member the class declares does, own or inherited — including an abstract
# one, whose slot exists with nothing providing it yet. The slot table is built
# during convergence, from the members as they stood then. A member added
# AFTERWARDS therefore has none: the nested-function hoist gives a class new
# sibling helpers once convergence is over and the table is fixed, and such a
# helper is unreachable from outside the class, so nothing can ever override it.
# Dispatching a call to one virtually would look up a slot that was never built,
# so it is called directly instead.
#
# cAllSlots is None only before the class has compiled, where no call is being
# generated yet; that answers true, so the test can only narrow the dispatch,
# never widen it.

fun occupiesSlot(cs: PsClass, memberName) => match(cs.cAllSlots)
  (slots: List<Slot>) => any(slots,
                             (s2) => s2.slotName == memberName)
  ()                  => true


# ── parameters.flatten() ─────────────────────────────────────────────────────
# The constructor's LEAF lets — a nested destructure flattens to its leaves.

fun flattenParams(params): List<PStmt> => match(params)
  (d: PsDestructure) => flattenTargets(d.dTargets,
                                            List())
  (l: PsLet)         => prepend(params, List())
  (o: PStmt)         => List()

# Parameter order: a nested destructure contributes its own targets in place.
# (Not [tail]: the nested-destructure arm recurses into the inner targets
# before it can step on, so that self-call is not in tail position.)
fun flattenTargets(ts: List<PStmt>, acc: List<PStmt>) => fold(ts, acc, flattenTarget)

fun flattenTarget(acc: List<PStmt>, t: PStmt): List<PStmt> => match(t)
  (d: PsDestructure) => flattenTargets(d.dTargets, acc)
  (o: PStmt)         => append(acc, t)

# ── find_classes_or_error ────────────────────────────────────────────────────
# Resolve each inherited type to (resolved spec, class statement). A spec that
# does not resolve to exactly one CLASS keeps its ORIGINAL spelling and yields
# no class — Python pairs it with an Error, which is check's to report;
# compile just skips it. On success the resolved spec is an SClass of the
# statement's unique name with the type params COMPILED through (aliases
# resolved), so cAllParents retains parameterisation for monomorphisation.

class [final] FoundClass(fcSpec: Spec, fcClass: PsClass|None)

fun findClassesOrError(types: List<Spec>, r) => fceLoop(types, r, List())

fun fceLoop(ts: List<Spec>, r, acc: List<FoundClass>) =>
  fold(ts, acc, (a, x) => append(a, findClassOrError(x, r)))

fun findClassOrError(xtype, r) => match(xtype)
  (n: SNamed) => resolveClassSpec(xtype, n.snName, n.snParams, n.snLine, r)
  (c: SClass) => resolveClassSpec(xtype, c.scName, c.scParams, c.scLine, r)
  (o: Spec)   => FoundClass(xtype, None)

fun resolveClassSpec(xtype, name, params: List<Spec>,
                     lr, r) => match(soleItem(findType(r, name)))
  (f: Found) => match(f.fStmt)
    (cs: PsClass) => FoundClass(SClass(cs.cName, compileSpecsPlain(params, r),
                                       lr),
                                cs)
    (o: PStmt)    => FoundClass(xtype, None)
  ()         => FoundClass(xtype, None)

# The type params compile through (an alias resolves); their globals are
# discarded exactly as Python's `rp.compile(resolver)[0]` discards them.
fun compileSpecsPlain(ps: List<Spec>, r) => cspLoop(ps, r, List())

fun cspLoop(ps: List<Spec>, r, acc): List<Spec> =>
  fold(ps, acc, (a, x) => append(a, compileSpec(x, r).soSpec))

# ── create_slots_from_members ────────────────────────────────────────────────
# One slot per CALLABLE member (constructor params + body statements). A slot
# provides its own name when it can actually dispatch: a fun WITH a body, or a
# fun-typed field. An interface's bodiless fun provides nothing.

fun createSlotsFromMembers(cs: PsClass)
  ret slotLoop(concat(flattenParams(cs.cParams), cs.cMembers),
               List())

fun slotLoop(ms: List<PStmt>, acc: List<Slot>) =>
  fold(ms, acc, (a, x) => isCallableMember(x) ? append(a, toSlot(x)) : a)

fun isCallableMember(st) => match(stmtType(st))
  (t2: Spec) => match(t2)
    (c: SCallable) => true
    (o: Spec)      => false
  () => false

fun toSlot(st) => Slot(stmtName(st), stmtType(st), providesOwn(st))

fun providesOwn(st) => match(st)
  (l: PsLet) => prepend(l.lName, List())
  (f: PsFun) => match(f.fBody)
    (b: PExpr) => prepend(f.fName, List())
    ()         => List()
  (o: PStmt) => List()

# ── override_inherited_slots ─────────────────────────────────────────────────
# Each own slot ABSORBS every parent slot it overrides (same simple name AND
# assignable type — strictly TRUE, an undecided comparison does not override):
# the parent slot's name and everything it in turn provided join this slot's
# provides set. Parent slots so absorbed disappear from the table.

fun overrideInheritedSlots(r, base: List<Slot>,
                           parents: List<Slot>)
  let enhanced = enhanceLoop(base, r, parents, List())
  let exclusion = allProvides(enhanced, List())
  ret concat(enhanced, keepUnabsorbed(parents, exclusion, List()))

fun enhanceLoop(bs: List<Slot>, r, parents: List<Slot>, acc: List<Slot>) =>
  fold(bs, acc, (a, x) => append(a, absorbMatches(x, r, parents)))

fun absorbMatches(slot: Slot, r, parents: List<Slot>)
  ret Slot(slot.slotName, slot.slotType,
           matchedNames(parents, slot, r, slot.slotProvides))

fun matchedNames(ps: List<Slot>, slot: Slot, r, acc): List<String> =>
  fold(ps, acc, (a, x) => matchMemberName(slot.slotName, x.slotName)
                     && triTrue(assignableEq(r, x.slotType, slot.slotType))
    ? addNameOnce(addNamesOnce(a, x.slotProvides), x.slotName)
    : a)

fun allProvides(ss: List<Slot>, acc): List<String> =>
  fold(ss, acc, (a, x) => addNamesOnce(a, x.slotProvides))

fun keepUnabsorbed(ps: List<Slot>, exclusion: List<String>, acc: List<Slot>) =>
  fold(ps, acc, (a, x) => contains(exclusion, x.slotName) ? a : append(a, x))

# ── set helpers (List with set semantics) ────────────────────────────────────

# Set semantics, but the ORDER is kept: these lists become parent and slot
# orders that reach generated code. `acc` is read by the dedup just above, so
# it cannot be a builder — this is the copy the old append did, written out.
fun addNameOnce(acc, n: String): List<String>
  ret contains(acc, n) ? acc : append(acc, n)

fun addNamesOnce(acc: List<String>, ns: List<String>) =>
  fold(ns, acc, addNameOnce)

fun addSpecOnce(acc, sp) => containsSpec(acc, sp) ? acc : append(acc, sp)

fun addSpecsOnce(acc, ss: List<Spec>) => fold(ss, acc, addSpecOnce)

# ── ClassStatement.never_flattens ────────────────────────────────────────────
# This declaration alone keeps every instance a heap object, whatever the rest
# of the program does: the half of the simple-class rule (simple_classes.yafl)
# that needs no other declaration. The other half — never a base, no method
# taken standalone — needs them all.
#
# Classes that are published into after construction need a real object with
# a stable identity to write through; a flattened value struct would leave
# nothing to publish to. [mutable] says so by being writable at any time;
# [pinnable] says so for an object that is immutable except inside a late pin,
# which is a heap object for the same reason — the pin lives in its vtable
# word, and a value struct has none. A trailing variable-length array is heap
# storage.

# The most fields a class may have and still be flattened to a value struct.
# Arbitrary but reasonable: a complex number (2 fields) and even a quaternion
# (4) flatten, a matrix does not.
fun maxFlatStructFields() => 4

fun classNeverFlattens(cls: PsClass)
  let fields = flattenParams(cls.cParams)
  ret cls.cIsInterface
    || hasAttr(cls.cAttrs, "foreign") || hasAttr(cls.cAttrs, "mutable")
    || hasAttr(cls.cAttrs, "pinnable")
    || !isEmpty(cls.cImplements)
    || sizeAtLeast(fields, maxFlatStructFields() + 1)
    || hasArrayField(fields)

fun hasArrayField(fs: List<PStmt>) => any(fs, isArrayField)

fun isArrayField(f: PStmt): Bool => match(f)
  (let2: PsLet) => arrayElem(let2.lType) !is None
  (o: PStmt)    => false

# ── ClassStatement.find_data ─────────────────────────────────────────────────
# A member lookup: the class's OWN members first (constructor params minus the
# internal array-storage field, plus body statements) — anything found masks
# the parents — else every implemented interface's, accumulated. Member access
# to the array field resolves to the generated ACCESSOR (same name), never the
# raw storage.

fun classFindData(cs: PsClass, r, query)
  let own = memberFinds(concat(nonArrayFields(cs), cs.cMembers), query,
                        List())
  ret isEmpty(own)
    ? parentFinds(findClassesOrError(cs.cImplements, r), r, query,
                  List())
    : own

fun nonArrayFields(cs: PsClass) => dropArrayField(flattenParams(cs.cParams), List())

fun dropArrayField(ls: List<PStmt>, acc: List<PStmt>) =>
  fold(ls, acc, (a, x) => isArrayStorage(x) ? a : append(a, x))

fun isArrayStorage(st) => match(st)
  (l: PsLet) => match(arrayElem(l.lType))
    (el: Spec) => true
    ()         => false
  (o: PStmt) => false

fun memberFinds(ms: List<PStmt>, query, acc: List<Found>) =>
  fold(ms, acc, (a, x) => nameMatches(stmtName(x), query)
    ? append(a, Found(stmtName(x), x, ScMember()))
    : a)

fun parentFinds(fs: List<FoundClass>, r, query, acc): List<Found> =>
  fold(fs, acc, (a, x) => parentFindsStep(a, x, r, query))

fun parentFindsStep(a: List<Found>, x: FoundClass, r, query) => match(x.fcClass)
  (p: PsClass) => concat(a, classFindData(p, r, query))
  () => a

# `this` inside a generic class carries the class's own placeholders — a bare
# ClassSpec would fail the declared-arity check later.
fun thisFound(cs: PsClass, query) => query == "this"
  ? prepend(Found("this", thisLet(cs), ScLocal()), List())
  : List()

fun thisLet(cs: PsClass) => PsLet("this", List(), List(), thisType(cs), None, "",
                                  List(), cs.pscLine)

fun thisType(cs: PsClass)
  ret SClass(cs.cName,
             map(cs.cGens, (g2) => SGeneric(g2.genName, isLinearGen(g2),
                                            g2.pgLine)),
             cs.pscLine)


# ── structural size probes ───────────────────────────────────────────────────
# The no-length ruling (user, 08-11): a list's length is never CALCULATED.
# Bounded questions are answered by bounded probes, length comparisons by
# co-walks, and a count that genuinely must exist is carried from the walk
# that built the list. The stdlib's sizeAtLeast / sizeAtMost are the bounded
# probes (List and Array alike); these helpers complete the vocabulary.

# Exactly n elements: two bounded probes.
fun exactly<T>(c: List<T>, n): Bool => sizeAtLeast(c, n) && sizeAtMost(c, n)

# ── Array twins ──────────────────────────────────────────────────────────────
# The same vocabulary over Arrays, which carry their length: every probe is
# O(1), and nthOf is one indexed read.

fun exactly<T>(a: Array<T>, n): Bool => size(a) == n

fun nthOf<T>(a: Array<T>, idx): T|None => idx >= 0 && !sizeAtMost(a, idx) ? a[idx] : None

fun sameLen<T, U>(a: Array<T>, b: Array<U>): Bool => size(a) == size(b)

# Same length: co-walk, stops at the shorter.
fun [tail] sameLen<T, U>(a: List<T>, b: List<U>): Bool =>
  isEmpty(a) || isEmpty(b) ? isEmpty(a) && isEmpty(b) : sameLen(dropOne(a), dropOne(b))

# Strictly fewer elements than b: co-walk, stops at the shorter.
fun [tail] shorterThan<T, U>(a: List<T>, b: List<U>): Bool =>
  isEmpty(b) ? false : (isEmpty(a) ? true : shorterThan(dropOne(a), dropOne(b)))

