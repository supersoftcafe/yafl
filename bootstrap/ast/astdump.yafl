# bootstrap/astdump.yafl — the PORT 2 contract dump, YAFL side. Must produce
# byte-for-byte the output of compiler/tests/astdump.py over the same tree:
# one `Kind|line:col|salient` line per node, two spaces of indent per depth.
# Strings re-escape with Python's repr rules (values are stored UNESCAPED).
namespace Bootstrap::Ast

import System

import Bootstrap::Codegen
import Bootstrap::Frontend
import Bootstrap::Parse
import Bootstrap::Types



fun dLine(out, depth, kind,
          lr: PLine, extra) => out + indentOf(depth) + kind + "|" + String(lr.plLine) + ":"
                                      + String(lr.plCol) + "|" + extra + "\n"

fun [tail] indentLoop(n, acc) => n == 0 ? acc : indentLoop(n - 1, acc + "  ")

fun indentOf(depth) => indentLoop(depth, "")

# ── Python str repr ─────────────────────────────────────────────────────────

fun pyRepr(s)
  let useDouble = containsByte(s, '\'') && !containsByte(s, '"')
  let q = useDouble ? "\"" : "'"
  ret q + reprBody(s, 0, useDouble ? '"' : '\'', "") + q

fun [tail] reprBody(s, at, quote,
                    acc): String
  if at >= length(s)
    ret acc
  let c = byteAt(s, at)
  ret reprBody(s, at + 1, quote, acc + reprByte(c, quote))

fun reprByte(c, quote)
  if c == '\\'
    ret "\\\\"
  if c == quote
    ret "\\" + asciiToString(quote)
  if c == '\n'
    ret "\\n"
  if c == '\r'
    ret "\\r"
  if c == '\t'
    ret "\\t"
  if c < 32i32 || c == 127i32
    ret "\\x" + hexByte(Int(c))
  ret asciiToString(c)

fun hexByte(v)
  let hexd = "0123456789abcdef"
  ret slice(hexd, v / 16, v / 16 + 1) + slice(hexd, v % 16, v % 16 + 1)

# ── type spelling ────────────────────────────────────────────────────────────

fun tyStr(o: Spec|None) => match(o)
  (ty: Spec) => tyOf(ty)
  ()        => "-"

fun tyOf(ty) => match(ty)
  (n: SNamed)    => "N(" + n.snName + (isEmpty(n.snParams) ? ""
                      : "<" + tyList(n.snParams) + ">") + ")"
  (b: SBuiltin)  => "B(" + b.sbName + ")"
  (t2: STuple)   => "T(" + tyEnts(t2.stEntries) + ")"
  (u: SCombination)    => "U(" + joinBar(u.scTypes) + ")"
  (c: SCallable) => "F(" + tyOf(c.scParams2) + "->" + tyStr(c.scResult) + ")"
  (g: SGeneric) => "G(" + g.sgName + ")"
  (c2: SClass)      => "C(" + c2.scName + (isEmpty(c2.scParams) ? ""
                        : "<" + tyList(c2.scParams) + ">") + ")"
  (af: SArrayField) => "ArrayFieldSpec"
  # Compile-phase only — the parser never builds one. Valid leaves are a
  # SET: sorted for a deterministic dump, matching Python's _ty.
  # `!cx` marks is_complex — absent before mark_complex_enums runs.
  (e: SEnum)        => "E(" + e.seRoot + ":"
                       + join(sort(e.seValidLeaves), ",")
                       + ")"
  (ls: SLazyStub)   => "LazyStubSpec"

fun tyList(ts: List<Spec>) => join(map(ts, (t2) => tyOf(t2)), ",")

fun joinBar(ts: List<Spec>) => join(map(ts, (t2) => tyOf(t2)), "|")

fun tyEnts(es: List<SEntry>) => join(map(es, (en) => tyEnt(en)), ",")

fun tyEnt(en: SEntry)
  let d = match(en.seDefault)
    (x: PExpr) => "=D"
    ()         => ""
  ret en.seName + ":" + tyStr(en.seType) + d

fun attrsStr(attrs: List<PAttr>)
  if isEmpty(attrs)
    ret "-"
  ret join(map(attrs, (a) => attrStr(a)), ",")

fun attrStr(a: PAttr) => match(a.attrValue)
  (x: PExpr) => a.attrName + "=<expr>"
  ()         => a.attrName

fun gensStr(gs: List<PGen>) => join(map(gs, (g2) => g2.genName), ",")

fun wheresStr(ws: List<Spec>) => join(map(ws, (w) => tyOf(w)), ",")

# ── expression walk ──────────────────────────────────────────────────────────

fun dumpExprOpt(o: PExpr|None, depth, out) => match(o)
  (x: PExpr) => dumpExpr(x, depth, out)
  ()         => out + indentOf(depth) + "None|-|\n"

fun dumpExpr(x, depth, out) => match(x)
  (i: PeInt)    => dLine(out, depth, "Int", i.peiLine,
                         String(i.value) + ":" + String(i.precision))
  (f: PeFloat)  => dLine(out, depth, "Float", f.pefLine,
                         f.floatText + ":" + String(f.fPrecision))
  (b: PeBool)   => dLine(out, depth, "Bool", b.pebLine, b.boolValue ? "True" : "False")
  (s2: PeStr)   => dLine(out, depth, "Str", s2.pesLine, pyRepr(s2.strValue))
  (r: PeRegex)  => dLine(out, depth, "Regex", r.perLine, pyRepr(r.pattern))
  (n: PeName)   => dLine(out, depth, "Name", n.penLine,
                         n.refName + "|" + tyList(n.refTypeParams))
  (d: PeDot)    => dLine(out, depth, "Dot", d.pedLine, d.member)
    |> (s1) => dumpExpr(d.base, depth + 1, s1)
  (c: PeCall)   => dLine(out, depth, "Call", c.pecLine, "")
    |> (s1) => dumpExpr(c.function, depth + 1, s1)
    |> (s2) => dumpExpr(c.parameter, depth + 1, s2)
  (tu: PeTuple) => dLine(out, depth, "Tuple", tu.petLine, "")
    |> (s1) => dumpTupEnts(tu.exprs, tu.petLine, depth + 1, s1)
  (t3: PeTernary) => dLine(out, depth, "Ternary", t3.pety, "")
    |> (s1) => dumpExpr(t3.condition, depth + 1, s1)
    |> (s2) => dumpExpr(t3.trueResult, depth + 1, s2)
    |> (s3) => dumpExpr(t3.falseResult, depth + 1, s3)
  # lamRet IS compared by eqExpr, and the lambda-lifting passes read it, so
  # it belongs in the dump — a contract that cannot see it reports two
  # DIFFERENT trees as equal. `tyStr` is the existing Spec|None speller.
  (lm: PeLambda) => dLine(out, depth, "Lambda", lm.pelLine, tyStr(lm.lamRet))
    |> (s1) => dumpStmt(lm.lamParams, depth + 1, s1)
    |> (s2) => dumpExpr(lm.lamBody, depth + 1, s2)
  (bk: PeBlock)  => dLine(out, depth, "Block", bk.pebkLine, bk.blockTag)
    |> (s1) => dumpStmts(bk.blockStmts, depth + 1, s1)
    |> (s2) => dumpExpr(bk.blockValue, depth + 1, s2)
  (m: PeMatch)   => dLine(out, depth, "Match", m.pemLine, "")
    |> (s1) => dumpExpr(m.subject, depth + 1, s1)
    |> (s2) => dumpArms(m.arms, depth + 1, s2)
  (bo: PeBuiltinOp) => dLine(out, depth, "BuiltinOp", bo.peboLine, tyOf(bo.opType))
    |> (s1) => dumpExpr(bo.opName, depth + 1, s1)
    |> (s2) => dumpExpr(bo.opParams, depth + 1, s2)
  (pl: PeParallel)  => dLine(out, depth, "Parallel", pl.pepLine, "")
    |> (s1) => dumpExpr(pl.parParams, depth + 1, s1)
  (ng: PeNothing)   => dLine(out, depth, "Nothing", ng.pengLine, "")
  # Names only, SORTED — the value expressions are deliberately not dumped
  # (Python's astdump prints the dict keys; keep the bytes identical).
  (ne: PeNewEnum)   => dLine(out, depth, "NewEnum", ne.penewLine,
                             ne.rootName + "|" + ne.leafName + "|"
                             + join(sort(map(ne.fieldArgs,
                                     (fa) => fa.faName)), ","))
  (nw: PeNew)       => dLine(out, depth, "New", nw.penwLine, tyOf(nw.newType))
    |> (s1) => dumpExpr(nw.newParam, depth + 1, s1)
  (ar: PeArrayRead) => dLine(out, depth, "ArrayRead", ar.pearLine, "")
    |> (s1) => dumpExpr(ar.arrObj, depth + 1, s1)
    |> (s2) => dumpExpr(ar.arrIndex, depth + 1, s2)
  # Compile-phase only — the parser never builds one.
  (wx: PeWith)      => dLine(out, depth, "With", wx.pewLine, "")
    |> (s1) => dumpExpr(wx.withSubject, depth + 1, s1)
    |> (s2) => dumpExpr(wx.withRepls, depth + 1, s2)
  (cv: PeConvert)   => dLine(out, depth, "Convert", cv.pecvLine,
                             tyOf(cv.convTarget))
    |> (s1) => dumpExpr(cv.convInner, depth + 1, s1)
  (qq: PeCoalesce)  => dLine(out, depth, "Coalesce", qq.peqqLine, "")
    |> (s1) => dumpExpr(qq.qqSubject, depth + 1, s1)
    |> (s2) => dumpExpr(qq.qqFallback, depth + 1, s2)
  # tail_loop lowering only — exercised by the tail-stage contract.
  (lp: PeLoop)      => dLine(out, depth, "Loop", lp.pelpLine,
                             join(loopParamNames(lp.loopParams,
                                                 List()),
                                  ","))
    |> (s1) => dumpExpr(lp.loopBody, depth + 1, s1)
  (rc: PeRecur)     => dumpExprs(rc.recArgs, depth + 1,
                                 dLine(out, depth, "Recur", rc.percLine,
                                       String(rc.recIndex)))
  (lz: PeLazy)      => dLine(out, depth, "Lazy", lz.pelzLine,
                             lz.stubName + ":" + tyOf(lz.lzTarget)
                               + lazyCapMark(lz.lzCaptured)
                               + (lz.lzStubOnly ? "!stub" : ""))


fun lazyCapMark(c: String|None) => match(c)
  (n: String) => "!cap=" + n
  ()          => ""

fun loopParamNames(ps, acc: List<String>): List<String>
  ret build(loopParamNamesB(ps, acc))

fun [tail] loopParamNamesB(ps: List<PExpr>, [terminal] acc: List<String>) => isEmpty(ps)
  ? acc
  : match(first(ps))
    (nm: PeName) => loopParamNamesB(tail(ps), push(acc, nm.refName))
    (o: PExpr)   => loopParamNamesB(tail(ps), acc)

fun [tail] dumpExprs(es: List<PExpr>, depth,
                     out) => match(head(es))
  (x: PExpr) => dumpExprs(tail(es), depth, dumpExpr(x, depth, out))
  ()         => out

fun [tail] dumpTupEnts(es: List<PTupEnt>, lr: PLine, depth,
                       out) => match(head(es))
  (en: PTupEnt) => dumpTupEnts(tail(es), lr, depth,
      dumpExpr(en.tupValue, depth + 1,
        dLine(out, depth, "Entry", lr,
              en.tupName + "|" + (en.tupSpread ? "*" : ""))))
  ()            => out

fun [tail] dumpArms(arms: List<PArm>, depth, out) => match(head(arms))
  (a: PArm) => dumpArms(tail(arms), depth, dumpArm(a, depth, out))
  ()        => out

fun dumpArm(a: PArm, depth, out)
  let opened = dLine(out, depth, "Arm", a.parmLine, a.armName + "|" + tyStr(a.armType))
  let lits = dumpLits(a.armLiterals, depth + 1, opened)
  let guarded = match(a.armGuard)
    (g2: PExpr) => dumpExpr(g2, depth + 2, dLine(lits, depth + 1, "Guard", a.parmLine, ""))
    ()          => lits
  ret dumpExpr(a.armBody, depth + 1, guarded)

fun [tail] dumpLits(ls: List<PLit>, depth, out) => match(head(ls))
  (l: PLit) => dumpLits(tail(ls), depth, dumpLit(l, depth, out))
  ()        => out

fun dumpLit(l, depth, out) => match(l)
  (x: PlExpr)  => dumpExpr(x.litExpr, depth, out)
  (r: PlRange) => dumpExpr(r.rangeHi, depth + 1,
                    dumpExpr(r.rangeLo, depth + 1,
                      dLine(out, depth, "Range", r.plrLine, "")))

# ── statement walk ───────────────────────────────────────────────────────────

fun [tail] dumpStmts(ss: List<PStmt>, depth, out) => match(head(ss))
  (st: PStmt) => dumpStmts(tail(ss), depth, dumpStmt(st, depth, out))
  ()          => out

fun dumpStmt(st, depth, out) => match(st)
  (f: PsFun) => dLine(out, depth, "Fun", f.psfLine,
                      f.fName + "|" + attrsStr(f.fAttrs) + "|" + gensStr(f.fGens)
                      + "|" + tyStr(f.fRet) + "|" + wheresStr(f.fWheres))
    |> (s1) => dumpStmt(f.fParams, depth + 1, s1)
    |> (s2) => dumpExprOpt(f.fBody, depth + 1, s2)
  (d: PsDestructure) => dLine(out, depth, "Destructure", d.psdLine,
                              d.dName + "|" + attrsStr(d.dAttrs) + "|" + tyStr(d.dType))
    |> (s1) => dumpStmts(d.dTargets, depth + 1, s1)
  (l: PsLet) => dLine(out, depth, "Let", l.pslLine,
                      l.lName + "|" + attrsStr(l.lAttrs) + "|" + gensStr(l.lGens)
                      + "|" + tyStr(l.lType))
    |> (s1) => dumpExprOpt(l.lDefault, depth + 1, s1)
  (c: PsClass) => dLine(out, depth, c.cIsInterface ? "Interface" : "Class", c.pscLine,
                        c.cName + "|" + attrsStr(c.cAttrs) + "|" + gensStr(c.cGens)
                        + "|" + wheresStr(c.cImplements) + "|" + wheresStr(c.cWheres))
    |> (s1) => dumpStmt(c.cParams, depth + 1, s1)
    |> (s2) => dumpStmts(c.cMembers, depth + 1, s2)
  (e: PsEnum) => dLine(out, depth, "Enum", e.pseLine,
                       e.eName + "|" + attrsStr(e.eAttrs) + "|"
                       + gensStr(e.eGens) + "|"
                       + (e.eHasParams ? "True" : "False"))
    |> (s1) => dumpStmt(e.eParams, depth + 1, s1)
    |> (s2) => dumpStmts(e.eVariants, depth + 1, s2)
  (ta: PsTypealias) => dLine(out, depth, "Typealias", ta.pstLine,
                            ta.taName + "|" + gensStr(ta.taGens) + "|" + tyOf(ta.taType))
  (r: PsRet)    => dumpExpr(r.retValue, depth + 1, dLine(out, depth, "Ret", r.psrLine, String(r.retIndex)))
  (i2: PsIf)    => dLine(out, depth, "If", i2.psifLine, "")
    |> (s1) => dumpExpr(i2.ifCond, depth + 1, s1)
    |> (s2) => dumpStmts(i2.ifTrue, depth + 1, s2)
    |> (s3) => dumpStmts(i2.ifFalse, depth + 1, s3)
  (ei: PsElseIf) => dLine(out, depth, "ElseIf", ei.pseiLine, "")
    |> (s1) => dumpExpr(ei.eiCond, depth + 1, s1)
    |> (s2) => dumpStmts(ei.eiStmts, depth + 1, s2)
  (el: PsElse)  => dLine(out, depth, "Else", el.pselLine, "")
    |> (s1) => dumpStmts(el.elStmts, depth + 1, s1)
  (ac: PsAction) => dLine(out, depth, "Action", ac.psaLine, "")
    |> (s1) => dumpExpr(ac.action, depth + 1, s1)
  (im: PsImport)   => dLine(out, depth, "ImportStatement", im.psiLine, "")
  (ns: PsNamespace) => dLine(out, depth, "NamespaceStatement", ns.psnLine, "")
  (inst: PsTraitInstance) => dLine(out, depth, "TraitInstance", inst.pstiLine,
                                   inst.tiName + "|"
                                   + (inst.tiAmbient ? "True" : "False")
                                   + "|" + gensStr(inst.tiGens) + "|"
                                   + tyOf(inst.tiPattern) + "|"
                                   + wheresStr(inst.tiWheres))
    |> (s1) => dumpStmts(inst.tiMembers, depth + 1, s1)

# Python's dump is `"\n".join(out) + "\n"` — an EMPTY statement list (a file
# monomorphisation pruned to nothing) still prints one newline.
fun dumpProgram(stmts: List<PStmt>)
  ret isEmpty(stmts) ? "\n" : dumpStmts(stmts, 0, "")
