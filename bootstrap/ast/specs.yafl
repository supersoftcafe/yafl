# bootstrap/specs.yafl — the TypeSpec representations, ported from
# compiler/pyast/typespec/specs.py. This is the ONE type tree: the parser
# builds the unresolved subset of it, and the compile fixpoint refines those
# in place — an SNamed becomes an SClass/SEnum/SBuiltin once its name resolves.
#
# Ported here: the spec tree, as_unique_id_str (THE structural identity used
# for layout, mangling and union dedup), is_concrete, repr_members with the
# union flattening/subsumption rules, and bind_tuple_entries (the one binding
# shared by assignability, unification, conversion and calls).
namespace Bootstrap::Ast

import System

import Bootstrap::Driver
import Bootstrap::Frontend
import Bootstrap::Parse
import Bootstrap::Resolve
import Bootstrap::Types



# ── the spec tree ────────────────────────────────────────────────────────────

# Spec is recursive, hence boxed — and every boxed enum carries the hidden
# hash slot by default, so the deep structural hash the memo keys need is
# O(fanout) per node and computed once per object — see
# lower/ast/complex_enums.yafl (CeKey) and plan §3b/§4.
enum Spec
  enum SBuiltin(sbName: String, sbLine: PLine)
  enum SNamed(snName: String, snParams: List<Spec>, snLine: PLine)
  enum SClass(scName: String, scParams: List<Spec>, scLine: PLine)
  enum SEnum(seRoot: String, seValidLeaves: List<String>, seAllLeaves: List<String>,
             seParams: List<Spec>, seLine: PLine)
  enum SGeneric(sgName: String, sgLinear: Bool, sgLine: PLine)
  enum SCallable(scParams2: Spec, scResult: Spec|None, sclLine: PLine)
  enum SCombination(scTypes: List<Spec>, scmLine: PLine)
  enum STuple(stEntries: List<SEntry>, stLine: PLine)
  enum SArrayField(safElem: Spec, safLenField: String, safLine: PLine)
  enum SLazyStub(slsTarget: Spec|None, slsLine: PLine)

class [final] SEntry(seName: String, seType: Spec|None, seDefault: PExpr|None)
class [final] SField(sfName: String, sfType: Spec)

fun specLine(sp) => match(sp)
  (b: SBuiltin)     => b.sbLine
  (n: SNamed)       => n.snLine
  (c: SClass)       => c.scLine
  (e: SEnum)        => e.seLine
  (g: SGeneric)     => g.sgLine
  (cl: SCallable)   => cl.sclLine
  (cm: SCombination) => cm.scmLine
  (t2: STuple)      => t2.stLine
  (af: SArrayField) => af.safLine
  (ls: SLazyStub)   => ls.slsLine

# ── structural identity ─────────────────────────────────────────────────────
# as_unique_id_str: None ("" here) while a spec is not yet ground. Every
# layout, name mangle and union dedup reads identity through this.

fun uid(sp) => match(sp)
  (b: SBuiltin)      => b.sbName
  (n: SNamed)        => ""                       # unresolved alias
  (g: SGeneric)      => ""                       # unbound placeholder
  (c: SClass)        => instantiationUid(c.scName, c.scParams)
  (e: SEnum)         => contains(e.seRoot, "@")
    ? instantiationUid("enum(" + e.seRoot + ")", e.seParams)
    : ""
  (cl: SCallable)    => uidCallable(cl)
  (cm: SCombination) => uidUnion(cm)
  (t2: STuple)       => uidTuple(t2)
  (af: SArrayField)  => uidArray(af)
  (ls: SLazyStub)    => uidLazy(ls)

# A generic instantiation is its root's id plus EVERY type argument's
# (identity = name + all type args): `List<Int>` and `List<String>` are two
# types. An argument not yet ground leaves the whole id "" (not ground).
# Monomorphised specs carry no params, so their ids are the root's alone.
fun instantiationUid(base, params: List<Spec>) => isEmpty(params)
  ? base
  : match(argUidList(params, List()))
    (ids: List<String>) => base + "<" + join(ids, ",") + ">"
    ()                  => ""

fun [tail] argUidList(ps: List<Spec>,
                      [terminal] acc: List<String>) => isEmpty(ps)
  ? build(acc)
  : uid(first(ps))
    |> (u) => u == "" ? None : argUidList(tail(ps), push(acc, u))

fun uidCallable(cl: SCallable)
  let p = uid(cl.scParams2)
  ret p == "" ? "" : "f" + p

fun uidTuple(t2: STuple) => match(entryUidList(t2.stEntries, List()))
  (ids: List<String>) => "(" + join(ids, ",") + ")"
  ()                  => ""

# POSITIONAL: a tuple's identity is its entry uids IN ORDER.
fun [tail] entryUidList(es: List<SEntry>,
                        [terminal] acc: List<String>) => isEmpty(es)
  ? build(acc)
  : match(first(es).seType)
    (t2: Spec) => uid(t2)
      |> (u) => u == "" ? None
                        : entryUidList(tail(es), push(acc, u))
    ()         => None

# A union's identity is its SORTED member ids — set semantics, so `A|B` and
# `B|A` are the same type.
fun uidUnion(cm: SCombination): String
  let ids = memberUids(reprMembers(cm), List())
  ret match(ids)
    (l: List<String>) => "union(" + join(sort(l), ",") + ")"
    ()                => ""

# uidUnion SORTS these before joining them — set semantics — so the order they
# are gathered in is not observable.
fun [tail] memberUids(ms: List<Spec>, acc: List<String>) => isEmpty(ms)
  ? acc
  : uid(first(ms))
    |> (u) => u == "" ? None : memberUids(tail(ms), prepend(u, acc))

fun uidArray(af: SArrayField)
  let inner = uid(af.safElem)
  ret inner == "" ? "" : "$array$" + af.safLenField + "$" + inner

# NOTE: the arm binder must not feed a pipe stage here — see
# tests/test_arm_binder_in_pipe.py (open compiler bug); use a let.
fun uidLazy(ls: SLazyStub) => match(ls.slsTarget)
  (t2: Spec) => lazyUid(uid(t2))
  ()         => "$lazy$"

fun lazyUid(u) => u == "" ? "" : "$lazy$" + u

fun isGround(sp) => uid(sp) != ""

# is_concrete: does this type still NAME something unresolved? Distinct from
# isGround — a generic placeholder is concrete (it is a real type inside its
# owner's scope) but not ground (it has no layout until it is bound).
fun isConcrete(sp) => match(sp)
  (b: SBuiltin)      => true
  (g: SGeneric)      => true
  (n: SNamed)        => false
  (c: SClass)        => isEmpty(c.scParams) || allConcrete(c.scParams)
  (e: SEnum)         => contains(e.seRoot, "@")
  (cl: SCallable)    => isConcrete(cl.scParams2) && concreteOpt(cl.scResult)
  (cm: SCombination) => allConcrete(cm.scTypes)
  (t2: STuple)       => allEntriesConcrete(t2.stEntries)
  (af: SArrayField)  => isConcrete(af.safElem)
  (ls: SLazyStub)    => concreteOpt(ls.slsTarget)

fun concreteOpt(sp: Spec|None) => match(sp)
  (x: Spec) => isConcrete(x)
  ()        => true

fun [tail] allConcrete(ts: List<Spec>) => isEmpty(ts)
  ? true
  : isConcrete(first(ts)) ? allConcrete(tail(ts)) : false

# A tuple entry with NO type is not concrete — an untyped field is unresolved.
fun [tail] allEntriesConcrete(es: List<SEntry>) => isEmpty(es)
  ? true
  : match(first(es).seType)
    (t2: Spec) => isConcrete(t2) ? allEntriesConcrete(tail(es)) : false
    ()         => false

# ── union canonical members ─────────────────────────────────────────────────
# _flatten_union_members: associativity + set semantics — a member that is
# itself a union contributes its members; a GROUND duplicate is dropped; and
# an enum member SUBSUMED by another member of the same enum folds away
# (`E3 | EU` where EU narrows E3 IS `E3`). Unresolved members are kept.

fun reprMembers(cm: SCombination): List<Spec> => reprMembersOf(cm.scTypes)

# The unit type — `typealias None : ()`, the empty tuple. This is what `??`
# eliminates and what a bare `()` match arm catches.
fun isUnitSpec(sp) => match(sp)
  (t2: STuple) => isEmpty(t2.stEntries)
  (o: Spec)    => false

# `sp` minus its None member, or None when that is not yet ANSWERABLE — the
# subject is not a union, carries no None member, or is nothing but None.
# Each of those is either an error for the check phase to name or a type that
# has not settled, and in both cases `??` must wait rather than guess.
# Spelling-level on purpose: an unresolved SNamed("None") is not treated as
# the unit member, because desugaring against a type still in motion is how a
# fixpoint stops converging.
fun withoutNone(sp) => match(sp)
  (cm: SCombination) => withoutNoneOf(reprMembers(cm), cm.scmLine)
  (o: Spec)          => None

fun withoutNoneOf(members: List<Spec>, lr)
  let kept = filter(members, (m) => !isUnitSpec(m))
  ret sameLen(kept, members) || isEmpty(kept)
    ? None
    : (exactly(kept, 1) ? head(kept) : SCombination(kept, lr))

# Takes the MEMBERS, not the union: a variant constructor returns the root
# enum type, so a caller that has just built an SCombination cannot pass it
# where an SCombination is expected.
fun reprMembersOf(types: List<Spec>): List<Spec> => flattenMembers(types, List())
  |> (flat) => dropSubsumed(flat)

fun [tail] flattenMembers(ts: List<Spec>, acc: List<Spec>): List<Spec> => isEmpty(ts)
  ? acc
  : flattenMembers(tail(ts), addMember(acc, first(ts)))

fun addMember(acc, sp) => match(sp)
  (cm: SCombination) => flattenMembers(cm.scTypes, acc)
  # A member's POSITION is its variant index, so this grows at the end;
  # `acc` is read just above for the dedup, so it cannot be a builder.
  (o)                => uid(sp) != "" && hasUid(acc, uid(sp))
    ? acc
    : build(push(acc, sp))

fun [tail] hasUidIn(ts: List<Spec>, u) => isEmpty(ts)
  ? false
  : uid(first(ts)) == u ? true : hasUidIn(tail(ts), u)

fun hasUid(ts: List<Spec>, u) => hasUidIn(ts, u)

fun dropSubsumed(flat: List<Spec>): List<Spec> => keepUnsubsumed(flat, flat, List())

fun keepUnsubsumed(ms, all2: List<Spec>,
                          acc: List<Spec>) => build(keepUnsubsumedB(ms, all2, acc))

fun [tail] keepUnsubsumedB(ms: List<Spec>, all2: List<Spec>,
                          [terminal] acc: List<Spec>) => isEmpty(ms)
  ? acc
  : isSubsumed(first(ms), all2)
    ? keepUnsubsumedB(tail(ms), all2, acc)
    : keepUnsubsumedB(tail(ms), all2, push(acc, first(ms)))

# An enum member whose valid leaves are a STRICT subset of another member of
# the same enum carries no values the wider member lacks.
fun isSubsumed(m: Spec, flat: List<Spec>) => match(m)
  (e: SEnum) => contains(e.seRoot, "@") && anyWider(flat, e)
  (o)        => false

fun [tail] anyWider(os: List<Spec>, e: SEnum) => isEmpty(os)
  ? false
  : widerEnum(first(os), e) ? true : anyWider(tail(os), e)

fun widerEnum(o: Spec, e: SEnum) => match(o)
  (oe: SEnum) => oe.seRoot == e.seRoot
                 && shorterThan(e.seValidLeaves, oe.seValidLeaves)
                 && allIn(e.seValidLeaves, oe.seValidLeaves)
  (other)     => false

fun [tail] allIn(ns: List<String>, wider: List<String>) => isEmpty(ns)
  ? true
  : contains2(wider, first(ns)) ? allIn(tail(ns), wider) : false

fun [tail] containsName(ns: List<String>, n: String) => isEmpty(ns)
  ? false
  : first(ns) == n ? true : containsName(tail(ns), n)

fun contains2(names: List<String>, n: String) => containsName(names, n)

# ── tuple entry binding ─────────────────────────────────────────────────────
# bind_tuple_entries: the ONE binding rule — positional first, then by NAME
# (only where the supplied names overlap the declared ones), with unbound
# declared entries covered by their defaults. Returns, per declared entry, the
# supplied index bound to it (-1 = filled by its default), or None when the
# tuples cannot bind at all.

# bind_tuple_entries — transcribed from specs.py. One value per DECLARED
# field: the supplied index that binds it, or -1 meaning "fill from this
# field's default". None (no binding) when the tuples don't correspond: more
# entries than fields, a bare entry after a name-bound one, a doubly-bound
# field, or an unbound field with no default.
#
# A supplied name binds ONLY when it matches a declared field. Tuples whose
# names don't overlap the declared names keep the structural semantics — same
# length binds positionally, names ignored — so a `(dir, entries)` value still
# pipes into `(d, acc)` parameters.

fun bindTupleEntries(declared: List<SEntry>,
                     supplied: List<String>)
  if shorterThan(declared, supplied)
    ret None
  let bare = bareNames(declared, List())
  if sameLen(supplied, declared) && !anyOverlap(supplied, bare)
    ret identityBinding(declared, 0, List())
  ret bindLoop(supplied, 0, declared, bare,
               blankSlots(declared, List()), false)

fun bareNames(ds: List<SEntry>, acc: List<String>) => build(bareNamesB(ds, acc))

fun [tail] bareNamesB(ds: List<SEntry>, [terminal] acc): List<String> => isEmpty(ds)
  ? acc
  : bareNamesB(tail(ds), push(acc, bareOfName(first(ds).seName)))

fun bareOfName(name)
  let at = findByte(name, '@', 0)
  ret at < 0 ? name : slice(name, 0, at)

fun [tail] anyOverlap(ss: List<String>, bare: List<String>) => isEmpty(ss)
  ? false
  : first(ss) != "" && contains2(bare, first(ss))
    ? true
    : anyOverlap(tail(ss), bare)

# One slot per declared entry, sized by the walk (no-length ruling).
fun identityBinding(ds: List<SEntry>, i, acc: List<Int>)
  ret build(identityBindingB(ds, i, acc))

fun [tail] identityBindingB(ds: List<SEntry>, i, [terminal] acc): List<Int> => isEmpty(ds)
  ? acc
  : identityBindingB(tail(ds), i + 1, push(acc, i))

fun blankSlots(ds: List<SEntry>, acc: List<Int>) => build(blankSlotsB(ds, acc))

fun [tail] blankSlotsB(ds: List<SEntry>, [terminal] acc): List<Int> => isEmpty(ds)
  ? acc
  : blankSlotsB(tail(ds), push(acc, -1))

# `slots` carries -1 for "unbound so far"; a field bound by name or position
# takes the supplied index. seenName tracks the "bare positional after a
# name-bound entry" rejection.
fun bindLoop(ss: List<String>, i, declared: List<SEntry>,
             bare: List<String>, slots: List<Int>, seenName) => !isEmpty(ss)
  ? bindOne(ss, i, declared, bare, slots, seenName)
  : fillDefaults(declared, slots, 0,
                                  List())

fun bindOne(l: List<String>, i, declared: List<SEntry>,
            bare: List<String>, slots: List<Int>, seenName)
  let byName = first(l) != "" ? indexOfName(bare, first(l)) : -1
  if byName >= 0
    ret nth(slots, byName) >= 0
      ? None                                  # doubly-bound field
      : bindLoop(tail(l), i + 1, declared, bare, setSlot(slots, byName, i), true)
  if first(l) == "" && seenName
    ret None                                  # bare positional after a name bind
  ret match(slotAt(slots, i))
    (v: Int) => v >= 0
      ? None
      : bindLoop(tail(l), i + 1, declared, bare, setSlot(slots, i, i), seenName)
    ()       => None                           # positional index past declared

fun [tail] slotAt(ss: List<Int>, i) => isEmpty(ss)
  ? None
  : i <= 0 ? first(ss) : slotAt(tail(ss), i - 1)

# An unbound field is filled by its default, or the binding fails.
fun [tail] fillDefaults(ds: List<SEntry>, ss: List<Int>, i,
                 [terminal] acc: List<Int>) => isEmpty(ds)
  ? build(acc)
  : isEmpty(ss)
    ? None
    : first(ss) < 0 && !hasDefault(first(ds))
      ? None
      : fillDefaults(tail(ds), tail(ss), i + 1, push(acc, first(ss)))

fun hasDefault(e: SEntry) => match(e.seDefault)
  (d: PExpr) => true
  ()         => false

fun indexOfName(bare: List<String>, name) => name == "" ? -1 : indexLoop(bare, name, 0)

fun [tail] indexLoop(ns: List<String>, name: String, at) => isEmpty(ns)
  ? -1
  : first(ns) == name ? at : indexLoop(tail(ns), name, at + 1)

fun nth(xs: List<Int>, i) => match(head(drop(xs, i)))
  (v: Int) => v
  ()       => -1

fun setSlot(xs: List<Int>, at: Int, v: Int) => setLoop(xs, 0, at, v, List())

fun setLoop(xs, i: Int, at: Int, v: Int,
                   acc: List<Int>) => build(setLoopB(xs, i, at, v, acc))

fun [tail] setLoopB(xs: List<Int>, i, at, v: Int,
                   [terminal] acc: List<Int>) => isEmpty(xs)
  ? acc
  : setLoopB(tail(xs), i + 1, at, v,
                             push(acc, i == at ? v : first(xs)))

# ══ spec text format (test harness only) ═════════════════════════════════════
# A compact spelling so the Python side can drive both implementations over
# the same cases: i:Int b:Bool s:Str  E:Root:leaf1|leaf2  C:Name  G:Name
# U(a,b)  T(name=spec,...)  F(params->result)
# A class/enum may end in type arguments `<a+b>` (`+`, so commas stay free).
# Nested commas are avoided by keeping the generated cases shallow.

fun parseSpecText(s): Spec|None
  let t2 = trim(s)
  if t2 == ""
    ret None
  let k = byteAt(t2, 0)
  if k == 'i'
    ret SBuiltin("bigint", noLine())
  if k == 'b'
    ret SBuiltin("bool", noLine())
  if k == 's'
    ret SBuiltin("str", noLine())
  if k == 'G'
    ret SGeneric(afterColon(t2), false, noLine())
  if k == 'C'
    ret parseClassText(afterColon(t2))
  if k == 'E'
    ret parseEnumText(afterColon(t2))
  if k == 'U'
    ret parseUnionText(inParens(t2))
  if k == 'T'
    ret parseTupleText(inParens(t2))
  ret None

fun noLine(): PLine => PLine("x", 0, 0)

fun afterColon(s)
  let c = findByte(s, ':', 0)
  ret c < 0 ? "" : slice(s, c + 1, length(s))

fun inParens(s)
  let o = findByte(s, '(', 0)
  ret o < 0 ? "" : slice(s, o + 1, length(s) - 1)

# `Root:leafA|leafB` — the valid leaves of an enum spec (all leaves = valid).
# NO leaves at all is the EMPTY type (Never), so the empty spelling must yield
# an empty list — `split("", "|")` would hand back one empty name and make an
# uninhabited enum look inhabited.
fun parseEnumText(text)
  let parts = withArgsText(text)
  let body = parts.head
  let c = findByte(body, ':', 0)
  let root = c < 0 ? body : slice(body, 0, c)
  let tail2 = c < 0 ? "" : slice(body, c + 1, length(body))
  let leaves = tail2 == "" ? List<String>() : split(tail2, "|")
  ret SEnum(root, leaves, leaves, parts.args, noLine())

fun parseClassText(text)
  let parts = withArgsText(text)
  ret SClass(parts.head, parts.args, noLine())

# A trailing `<a+b>`: the spelling before it, and its type arguments.
fun withArgsText(body): (head: String, args: List<Spec>)
  let o = findByte(body, '<', 0)
  ret o < 0 || byteAt(body, length(body) - 1) != '>'
    ? (head = body, args = List<Spec>())
    : (head = slice(body, 0, o),
       args = argSpecs((split(slice(body, o + 1, length(body) - 1), "+")),
                       List()))

fun [tail] argSpecs(ps: List<String>, [terminal] acc: List<Spec>): List<Spec> => isEmpty(ps)
  ? build(acc)
  : match(parseSpecText(first(ps)))
    (s2: Spec) => argSpecs(tail(ps), push(acc, s2))
    ()         => argSpecs(tail(ps), acc)

fun parseUnionText(body) => unionParts(topLevelParts(body), List())

# `_=spec,name=spec` — a tuple spelling; `_` is an unnamed entry.
fun parseTupleText(body) => tupleParts(topLevelParts(body), List())

fun [tail] tupleParts(ps: List<String>, [terminal] acc) => isEmpty(ps)
  ? STuple(build(acc), noLine())
  : trim(first(ps)) == ""
    ? tupleParts(tail(ps), acc)
    : tupleEntryText(first(ps))
      |> (en) => match(en)
        (e: SEntry) => tupleParts(tail(ps), push(acc, e))
        ()          => None

fun tupleEntryText(part): SEntry|None
  let eq = findByte(part, '=', 0)
  if eq < 0
    ret None
  let name = trim(slice(part, 0, eq))
  ret match(parseSpecText(slice(part, eq + 1, length(part))))
    (sp: Spec) => SEntry(name == "_" ? "" : name, sp, None)
    ()         => None

# Split on TOP-LEVEL commas only — a nested U(...)/T(...) carries its own.
fun topLevelParts(body) => partLoop(body, 0, 0, 0, List())

fun partLoop(body, at, start, depth,
                    acc: List<String>): List<String>
  ret build(partLoopB(body, at, start, depth, acc))

fun [tail] partLoopB(body, at, start, depth,
                    [terminal] acc: List<String>): List<String>
  if at >= length(body)
    ret push(acc, slice(body, start, length(body)))
  let c = byteAt(body, at)
  ret c == '(' ? partLoopB(body, at + 1, start, depth + 1, acc)
    : c == ')' ? partLoopB(body, at + 1, start, depth - 1, acc)
    : c == ',' && depth == 0
      ? partLoopB(body, at + 1, at + 1, depth,
                 push(acc, slice(body, start, at)))
      : partLoopB(body, at + 1, start, depth, acc)

fun [tail] unionParts(ps: List<String>, [terminal] acc: List<Spec>): Spec|None => isEmpty(ps)
  ? SCombination(build(acc), noLine())
  : match(parseSpecText(first(ps)))
    (s2: Spec) => unionParts(tail(ps), push(acc, s2))
    ()         => None

# `name=spec;name=spec` — declared tuple entries (a trailing `!` marks a
# default). Semicolons separate entries so commas stay free for unions.
fun parseEntriesText(s) => entryParts((split(s, ";")), List())

fun entryParts(ps, acc: List<SEntry>): List<SEntry> => build(entryPartsB(ps, acc))

fun [tail] entryPartsB(ps: List<String>, [terminal] acc: List<SEntry>) => isEmpty(ps)
  ? acc
  : entryPartsB(tail(ps), push(acc, oneEntry(trim(first(ps)))))

fun oneEntry(part)
  let hasDflt = endsWith(part, "!")
  let core = hasDflt ? slice(part, 0, length(part) - 1) : part
  let eq = findByte(core, '=', 0)
  let name = eq < 0 ? core : slice(core, 0, eq)
  let ty = eq < 0 ? "" : slice(core, eq + 1, length(core))
  ret SEntry(name == "_" ? "" : name, parseSpecText(ty),
             hasDflt ? PeNothing(noLine()) : None)
