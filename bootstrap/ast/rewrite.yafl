# bootstrap/ast/rewrite.yafl — THE tree traversal, written once: pyast's
# search_and_replace. Python distributes it across each node's own method and
# rebuilds by `dataclasses.replace`; here every node's children are stated in
# ONE place — the `walk` below — and every pass supplies only its callbacks.
# No other walker restates what a node's children are.
#
# The walk mirrors search_and_replace node for node:
#   * the SAME visit set, in the SAME order (the kwargs order of each node's
#     rw.rewrite call — e.g. a class's cAllParents before its params, an
#     enum's eSpec before its params, a name's penTrait before its type args);
#   * BOTTOM-UP: a node's children first, then the callback on the rebuilt
#     node; a replacement is not re-visited;
#   * the scope each node hands its children — block lets, lambda params, arm
#     bindings, if-branch lets, a function's body scope, a class body, generic
#     params — and the scope each callback receives (a function's and a
#     class's own callback see their NESTED scope, as rw.rewrite is handed it);
#   * the change signal of pyast/rewrite.py's UNCHANGED: a subtree nothing
#     changed is returned as it was, so a walk that only collects rebuilds
#     nothing;
#   * a union re-flattens after its members are rewritten (CombinationSpec).
#
# THE VISIT-SET LAW (search_and_replace's):
#   Fun        params, body, ret, wheres
#   Let        default, declared type, wheres
#   Destructure default, type, targets
#   Typealias  ONLY its type (a typealias has no where syntax)
#   Class      cAllParents, params, members, implements, wheres — NEVER cAllSlots
#   Enum       eSpec, params, variants — an SEnum's all_fields are NEVER
#              visited (recursive enums would loop)
#   Instance   pattern, wheres, members
#   NamedSpec  params (a type argument is a reference in its own right)
#   PeName     penTrait, refTypeParams — a penTrait replacement that is not an
#              SClass becomes None (access.py), as an eSpec one that is not
#              an SEnum does (types.py)
#   BuiltinOp  type, params — never its name
#
# Callbacks receive the walk's state, the scope in effect at the node, and the
# node; they return the new state and the replacement, or None for "no change
# here". State threads through every callback in visit order — the YAFL
# spelling of a Python callback closing over a counter or a collector.
namespace Bootstrap::Ast

import System
import System::Containers

import Bootstrap::Frontend
import Bootstrap::Parse
import Bootstrap::Resolve



# ── API ──────────────────────────────────────────────────────────────────────

class [final] Walk<S>(wkOnExpr: (:S, :Resolver, :PExpr): (s: S, r: PExpr|None),
                      wkOnStmt: (:S, :Resolver, :PStmt): (s: S, r: PStmt|None),
                      wkOnSpec: (:S, :Resolver, :Spec): (s: S, r: Spec|None))

fun walkStmts<S>(ss: List<PStmt>, r: Resolver, s: S, w: Walk<S>): (s: S, x: List<PStmt>)
  let o = wkStmts(ss, r, s, w)
  ret (s = o.s, x = o.x)

fun walkStmt<S>(st: PStmt, r: Resolver, s: S, w: Walk<S>): (s: S, x: PStmt)
  let o = wkStmt(st, r, s, w)
  ret (s = o.s, x = o.x)

fun walkExpr<S>(x: PExpr, r: Resolver, s: S, w: Walk<S>): (s: S, x: PExpr)
  let o = wkExpr(x, r, s, w)
  ret (s = o.s, x = o.x)

fun walkSpec<S>(sp: Spec, r: Resolver, s: S, w: Walk<S>): (s: S, x: Spec)
  let o = wkSpec(sp, r, s, w)
  ret (s = o.s, x = o.x)

# The callbacks that change nothing.
fun wkNoExpr<S>(s: S, r: Resolver, x: PExpr): (s: S, r: PExpr|None) => (s = s, r = None)

fun wkNoStmt<S>(s: S, r: Resolver, st: PStmt): (s: S, r: PStmt|None) => (s = s, r = None)

fun wkNoSpec<S>(s: S, r: Resolver, sp: Spec): (s: S, r: Spec|None) => (s = s, r = None)

# ── stateless rewrites ───────────────────────────────────────────────────────
# A walk whose callbacks only replace: no state, no scope read.

class [final] Rw(rwFnExpr: (:PExpr): PExpr|None,
                 rwFnSpec: (:Spec): Spec|None,
                 rwFnStmt: (:PStmt): PStmt|None)

fun rwNoExpr(x: PExpr): PExpr|None => None

fun rwNoSpec(sp: Spec): Spec|None => None

fun rwNoStmt(st: PStmt): PStmt|None => None

fun rwOnExpr(f): Rw => Rw(f, rwNoSpec, rwNoStmt)

fun rwOnSpec(f): Rw => Rw(rwNoExpr, f, rwNoStmt)

fun rwWalk(w: Rw): Walk<Bool> =>
  Walk<Bool>((s, _r, x) => (s = s, r = w.rwFnExpr(x)),
             (s, _r, st) => (s = s, r = w.rwFnStmt(st)),
             (s, _r, sp) => (s = s, r = w.rwFnSpec(sp)))

fun rwStmts(ss: List<PStmt>, w: Rw): List<PStmt> => wkStmts(ss, emptyResolverGlobal, false, rwWalk(w)).x

fun rwExpr(x: PExpr, w: Rw): PExpr => wkExpr(x, emptyResolverGlobal, false, rwWalk(w)).x

fun rwSpec(sp: Spec, w: Rw): Spec => wkSpec(sp, emptyResolverGlobal, false, rwWalk(w)).x

fun rwEntries(es: List<SEntry>, w: Rw): List<SEntry> =>
  wkEntries(es, emptyResolverGlobal, false, rwWalk(w)).x

# ── folds ────────────────────────────────────────────────────────────────────
# A walk whose callbacks only accumulate, in visit order (bottom-up).

fun foldWalk<T>(f: (:T, :PStmt): T, fx: (:T, :PExpr): T): Walk<T> =>
  Walk<T>((a, _r, x) => (s = fx(a, x), r = None),
          (a, _r, st) => (s = f(a, st), r = None),
          wkNoSpec<T>)

fun foldStmts<T>(ss: List<PStmt>, f: (:T, :PStmt): T, fx: (:T, :PExpr): T, acc: T): T =>
  wkStmts(ss, emptyResolverGlobal, acc, foldWalk(f, fx)).s

fun foldStmt<T>(st: PStmt, f: (:T, :PStmt): T, fx: (:T, :PExpr): T, acc: T): T =>
  wkStmt(st, emptyResolverGlobal, acc, foldWalk(f, fx)).s

fun foldExpr<T>(x: PExpr, f: (:T, :PStmt): T, fx: (:T, :PExpr): T, acc: T): T =>
  wkExpr(x, emptyResolverGlobal, acc, foldWalk(f, fx)).s

# Every spec in the tree, children before parents — the order
# collect_discriminator_ids numbers union members in, observable in the C.
fun foldAllSpecs<T>(ss: List<PStmt>, f: (:T, :Spec): T, acc: T): T =>
  wkStmts(ss, emptyResolverGlobal, acc,
          Walk<T>(wkNoExpr<T>, wkNoStmt<T>, (a, _r, sp) => (s = f(a, sp), r = None))).s

# Every expression, with the scope it is in.
fun foldExprsScoped<T>(ss: List<PStmt>, r: Resolver,
                       fx: (:T, :PExpr, :Resolver): T, acc: T): T =>
  wkStmts(ss, r, acc,
          Walk<T>((a, r2, x) => (s = fx(a, x, r2), r = None), wkNoStmt<T>, wkNoSpec<T>)).s

# ── the walk: one node ───────────────────────────────────────────────────────
# Every wk* returns (state, node, changed): the node is the ORIGINAL when
# nothing under it changed, and `changed` says so — pyast/rewrite.py's
# UNCHANGED, so lists are rebuilt only where an element changed and `with`
# keeps the original wherever its replacements are the fields it had.

fun wkStmt<S>(st: PStmt, r: Resolver, s: S, w: Walk<S>): (s: S, x: PStmt, ch: Bool)
  let own = wkOwnScope(st, r)
  let kids = wkStmtKids(st, r, own, s, w)
  let out = w.wkOnStmt(kids.s, own, kids.x)
  ret match(out.r)
    (rep: PStmt) => (s = out.s, x = rep, ch = true)
    ()           => (s = out.s, x = kids.x, ch = kids.ch)

fun wkExpr<S>(x: PExpr, r: Resolver, s: S, w: Walk<S>): (s: S, x: PExpr, ch: Bool)
  let kids = wkExprKids(x, r, s, w)
  let out = w.wkOnExpr(kids.s, r, kids.x)
  ret match(out.r)
    (rep: PExpr) => (s = out.s, x = rep, ch = true)
    ()           => (s = out.s, x = kids.x, ch = kids.ch)

fun wkSpec<S>(sp: Spec, r: Resolver, s: S, w: Walk<S>): (s: S, x: Spec, ch: Bool) => match(sp)
  (cm: SCombination) => wkUnion(cm, r, s, w)
  (o: Spec)          => wkSpecDone(wkSpecKids(sp, r, s, w), r, w)

fun wkSpecDone<S>(kids: (s: S, x: Spec, ch: Bool), r: Resolver, w: Walk<S>): (s: S, x: Spec, ch: Bool)
  let out = w.wkOnSpec(kids.s, r, kids.x)
  ret match(out.r)
    (rep: Spec) => (s = out.s, x = rep, ch = true)
    ()          => (s = out.s, x = kids.x, ch = kids.ch)

# CombinationSpec.search_and_replace: rewrite the members, then re-flatten —
# a substitution can put a union where a member was. A union that flattens to
# ONE member IS that member (no callback); one whose members neither changed
# nor re-flattened is the original.
fun wkUnion<S>(cm: SCombination, r: Resolver, s: S, w: Walk<S>): (s: S, x: Spec, ch: Bool)
  let ms = wkSpecs(cm.scTypes, r, s, w)
  let flat = reprMembersOf(ms.x)
  ret exactly(flat, 1)
    ? (s = ms.s, x = head(flat) ?? cm, ch = true)
    : (!ms.ch && sameCount(flat, cm.scTypes)
       ? wkSpecDone((s = ms.s, x = cm, ch = false), r, w)
       : wkSpecDone((s = ms.s, x = with cm(scTypes = flat), ch = true), r, w))

fun sameCount<T>(a: List<T>, b: List<T>): Bool => wkLen(a) == wkLen(b)

fun wkLen<T>(xs: List<T>): Int => fold(xs, 0, (n, _x) => n + 1)

# The scope a statement's OWN callback receives, and its nested children see.
fun wkOwnScope(st: PStmt, r: Resolver): Resolver => match(st)
  (f: PsFun)   => funBodyScope(f, r)
  (c: PsClass) => genScope(c.cGens, c.cWheres, RClassBody(c, r))
  (o: PStmt)   => r

# ── statements ───────────────────────────────────────────────────────────────

fun wkStmtKids<S>(st: PStmt, r: Resolver, own: Resolver, s: S, w: Walk<S>): (s: S, x: PStmt, ch: Bool) => match(st)
  (f: PsFun) => wkStmt(f.fParams, r, s, w)
    |> (p) => (p, wkExprOpt(f.fBody, own, p.s, w))
    |> (p, b) => (p, b, wkSpecOpt(f.fRet, r, b.s, w))
    |> (p, b, rt) => (p, b, rt, wkSpecs(f.fWheres, r, rt.s, w))
    |> (p, b, rt, wh) => (s = wh.s,
                          x = with f(fParams = p.x, fBody = b.x, fRet = rt.x, fWheres = wh.x),
                          ch = p.ch || b.ch || rt.ch || wh.ch)
  (l: PsLet) => wkExprOpt(l.lDefault, r, s, w)
    |> (d) => (d, wkSpecOpt(l.lType, r, d.s, w))
    |> (d, t) => (d, t, wkSpecs(l.lWheres, r, t.s, w))
    |> (d, t, wh) => (s = wh.s,
                      x = with l(lDefault = d.x, lType = t.x, lWheres = wh.x),
                      ch = d.ch || t.ch || wh.ch)
  (d: PsDestructure) => wkExprOpt(d.dDefault, r, s, w)
    |> (dv) => (dv, wkSpecOpt(d.dType, r, dv.s, w))
    |> (dv, t) => (dv, t, wkStmts(d.dTargets, r, t.s, w))
    |> (dv, t, ts) => (s = ts.s,
                       x = with d(dDefault = dv.x, dType = t.x, dTargets = ts.x),
                       ch = dv.ch || t.ch || ts.ch)
  (ta: PsTypealias) => wkSpec(ta.taType, r, s, w)
    |> (t) => (s = t.s, x = with ta(taType = t.x), ch = t.ch)
  (c: PsClass) => wkSpecsOpt(c.cAllParents, r, s, w)
    |> (ap) => (ap, wkStmt(c.cParams, r, ap.s, w))
    |> (ap, p) => (ap, p, wkStmts(c.cMembers, own, p.s, w))
    |> (ap, p, ms) => (ap, p, ms, wkSpecs(c.cImplements, r, ms.s, w))
    |> (ap, p, ms, im) => (ap, p, ms, im, wkSpecs(c.cWheres, r, im.s, w))
    |> (ap, p, ms, im, wh) => (s = wh.s,
                               x = with c(cAllParents = ap.x, cParams = p.x, cMembers = ms.x,
                                          cImplements = im.x, cWheres = wh.x),
                               ch = ap.ch || p.ch || ms.ch || im.ch || wh.ch)
  (e2: PsEnum) => wkEnum(e2, r, s, w)
  (ti: PsTraitInstance) => wkInstance(ti, genScope(ti.tiGens, ti.tiWheres, r), s, w)
  (rt: PsRet) => wkExpr(rt.retValue, r, s, w)
    |> (v) => (s = v.s, x = with rt(retValue = v.x), ch = v.ch)
  (a: PsAction) => wkExpr(a.action, r, s, w)
    |> (v) => (s = v.s, x = with a(action = v.x), ch = v.ch)
  (fa: PsFieldAssign) => wkExpr(fa.faTarget, r, s, w)
    |> (t) => (t, wkExpr(fa.faValue, r, t.s, w))
    |> (t, v) => (s = v.s, x = with fa(faTarget = t.x, faValue = v.x), ch = t.ch || v.ch)
  (i: PsIf) => wkExpr(i.ifCond, r, s, w)
    |> (cd) => (cd, wkStmts(i.ifTrue, localScope(i.ifTrue, r), cd.s, w))
    |> (cd, tb) => (cd, tb, wkStmts(i.ifFalse, localScope(i.ifFalse, r), tb.s, w))
    |> (cd, tb, fb) => (s = fb.s,
                        x = with i(ifCond = cd.x, ifTrue = tb.x, ifFalse = fb.x),
                        ch = cd.ch || tb.ch || fb.ch)
  (ei: PsElseIf) => wkExpr(ei.eiCond, r, s, w)
    |> (cd) => (cd, wkStmts(ei.eiStmts, r, cd.s, w))
    |> (cd, b) => (s = b.s, x = with ei(eiCond = cd.x, eiStmts = b.x), ch = cd.ch || b.ch)
  (el: PsElse) => wkStmts(el.elStmts, r, s, w)
    |> (b) => (s = b.s, x = with el(elStmts = b.x), ch = b.ch)
  (im: PsImport)    => (s = s, x = st, ch = false)
  (ns: PsNamespace) => (s = s, x = st, ch = false)

# EnumStatement.search_and_replace: its spec first (a replacement that is not
# an enum spec becomes None), then params and variants in the generic scope.
fun wkEnum<S>(e2: PsEnum, r: Resolver, s: S, w: Walk<S>): (s: S, x: PStmt, ch: Bool)
  let vr = enumScope(e2, r)
  ret wkSpecOpt(e2.eSpec, r, s, w)
    |> (sp) => (sp, wkStmt(e2.eParams, vr, sp.s, w))
    |> (sp, p) => (sp, p, wkStmts(e2.eVariants, vr, p.s, w))
    |> (sp, p, vs) => (s = vs.s,
                       x = with e2(eSpec = sp.ch ? enumSpecOnly(sp.x) : e2.eSpec, eParams = p.x, eVariants = vs.x),
                       ch = sp.ch || p.ch || vs.ch)

fun enumSpecOnly(sp: Spec|None): Spec|None => match(sp)
  (se: SEnum) => se
  ()          => None

fun wkInstance<S>(ti: PsTraitInstance, scoped: Resolver, s: S, w: Walk<S>): (s: S, x: PStmt, ch: Bool) =>
  wkSpec(ti.tiPattern, scoped, s, w)
    |> (pt) => (pt, wkSpecs(ti.tiWheres, scoped, pt.s, w))
    |> (pt, wh) => (pt, wh, wkStmts(ti.tiMembers, scoped, wh.s, w))
    |> (pt, wh, ms) => (s = ms.s,
                        x = with ti(tiPattern = pt.x, tiWheres = wh.x, tiMembers = ms.x),
                        ch = pt.ch || wh.ch || ms.ch)

# ── expressions ──────────────────────────────────────────────────────────────

fun wkExprKids<S>(x: PExpr, r: Resolver, s: S, w: Walk<S>): (s: S, x: PExpr, ch: Bool) => match(x)
  (nm: PeName) => wkSpecOpt(nm.penTrait, r, s, w)
    |> (t) => (t, wkSpecs(nm.refTypeParams, r, t.s, w))
    |> (t, ps) => (s = ps.s,
                   x = with nm(penTrait = t.ch ? traitOnly(t.x) : nm.penTrait, refTypeParams = ps.x),
                   ch = t.ch || ps.ch)
  (d: PeDot) => wkExpr(d.base, r, s, w)
    |> (b) => (s = b.s, x = with d(base = b.x), ch = b.ch)
  (ar: PeArrayRead) => wkExpr(ar.arrObj, r, s, w)
    |> (ob) => (ob, wkExpr(ar.arrIndex, r, ob.s, w))
    |> (ob, ix) => (s = ix.s, x = with ar(arrObj = ob.x, arrIndex = ix.x), ch = ob.ch || ix.ch)
  (lz: PeLazy) => wkSpec(lz.lzTarget, r, s, w)
    |> (t) => (s = t.s, x = with lz(lzTarget = t.x), ch = t.ch)
  (c: PeCall) => wkExpr(c.function, r, s, w)
    |> (f) => (f, wkExpr(c.parameter, r, f.s, w))
    |> (f, p) => (s = p.s, x = with c(function = f.x, parameter = p.x), ch = f.ch || p.ch)
  (lm: PeLambda) => wkStmt(lm.lamParams, r, s, w)
    |> (p) => (p, wkExpr(lm.lamBody, localScope(flattenParams(lm.lamParams), r), p.s, w))
    |> (p, b) => (p, b, wkSpecOpt(lm.lamRet, r, b.s, w))
    |> (p, b, rt) => (s = rt.s,
                      x = with lm(lamParams = p.x, lamBody = b.x, lamRet = rt.x),
                      ch = p.ch || b.ch || rt.ch)
  (te: PeTernary) => wkExpr(te.condition, r, s, w)
    |> (cd) => (cd, wkExpr(te.trueResult, r, cd.s, w))
    |> (cd, tr) => (cd, tr, wkExpr(te.falseResult, r, tr.s, w))
    |> (cd, tr, fr) => (s = fr.s,
                        x = with te(condition = cd.x, trueResult = tr.x, falseResult = fr.x),
                        ch = cd.ch || tr.ch || fr.ch)
  (bk: PeBlock) => wkBlock(bk, blockScope(bk.blockStmts, r), s, w)
  (op: PeBuiltinOp) => wkSpec(op.opType, r, s, w)
    |> (t) => (t, wkExpr(op.opParams, r, t.s, w))
    |> (t, p) => (s = p.s, x = with op(opType = t.x, opParams = p.x), ch = t.ch || p.ch)
  (ps: PePinSet) => wkExpr(ps.psSubject, r, s, w)
    |> (sb) => (sb, wkExpr(ps.psTarget, r, sb.s, w))
    |> (sb, tg) => (sb, tg, wkExpr(ps.psValue, r, tg.s, w))
    |> (sb, tg, vl) => (s = vl.s,
                        x = with ps(psSubject = sb.x, psTarget = tg.x, psValue = vl.x),
                        ch = sb.ch || tg.ch || vl.ch)
  (qq: PeCoalesce) => wkExpr(qq.qqSubject, r, s, w)
    |> (sb) => (sb, wkExpr(qq.qqFallback, r, sb.s, w))
    |> (sb, fb) => (s = fb.s, x = with qq(qqSubject = sb.x, qqFallback = fb.x), ch = sb.ch || fb.ch)
  (cv: PeConvert) => wkExpr(cv.convInner, r, s, w)
    |> (iv) => (iv, wkSpec(cv.convTarget, r, iv.s, w))
    |> (iv, t) => (s = t.s, x = with cv(convInner = iv.x, convTarget = t.x), ch = iv.ch || t.ch)
  (rc: PeRecur) => wkExprs(rc.recArgs, r, s, w)
    |> (as2) => (s = as2.s, x = with rc(recArgs = as2.x), ch = as2.ch)
  (lp: PeLoop) => wkExpr(lp.loopBody, r, s, w)
    |> (b) => (b, wkExprs(lp.loopParams, r, b.s, w))
    |> (b, ps2) => (s = ps2.s, x = with lp(loopBody = b.x, loopParams = ps2.x), ch = b.ch || ps2.ch)
  (nw: PeNew) => wkSpec(nw.newType, r, s, w)
    |> (t) => (t, wkExpr(nw.newParam, r, t.s, w))
    |> (t, p) => (s = p.s, x = with nw(newType = t.x, newParam = p.x), ch = t.ch || p.ch)
  (ne: PeNewEnum) => wkFieldArgs(ne.fieldArgs, r, s, w)
    |> (fas) => (fas, wkSpecs(ne.neTypeParams, r, fas.s, w))
    |> (fas, ps2) => (s = ps2.s,
                      x = with ne(fieldArgs = fas.x, neTypeParams = ps2.x),
                      ch = fas.ch || ps2.ch)
  (tp: PeTuple) => wkTupEnts(tp.exprs, r, s, w)
    |> (es) => (s = es.s, x = with tp(exprs = es.x), ch = es.ch)
  (wx: PeWith) => wkExpr(wx.withSubject, r, s, w)
    |> (sb) => (sb, wkExpr(wx.withRepls, r, sb.s, w))
    |> (sb, rp) => (s = rp.s, x = with wx(withSubject = sb.x, withRepls = rp.x), ch = sb.ch || rp.ch)
  (mt: PeMatch) => wkExpr(mt.subject, r, s, w)
    |> (sj) => (sj, wkArms(mt.arms, r, sj.s, w))
    |> (sj, as2) => (sj, as2, wkExprs(mt.matchExtra, r, as2.s, w))
    |> (sj, as2, ex) => (s = ex.s,
                         x = with mt(subject = sj.x, arms = as2.x, matchExtra = ex.x),
                         ch = sj.ch || as2.ch || ex.ch)
  (o: PeLiteral) => (s = s, x = x, ch = false)

# A trait-scope replacement that is not a class spec becomes None.
fun traitOnly(sp: Spec|None): Spec|None => match(sp)
  (c: SClass) => c
  ()          => None

# A block's statements and its value both see the block's own lets.
fun wkBlock<S>(bk: PeBlock, bs: Resolver, s: S, w: Walk<S>): (s: S, x: PExpr, ch: Bool) =>
  wkStmts(bk.blockStmts, bs, s, w)
    |> (ss) => (ss, wkExpr(bk.blockValue, bs, ss.s, w))
    |> (ss, v) => (s = v.s, x = with bk(blockStmts = ss.x, blockValue = v.x), ch = ss.ch || v.ch)

# MatchArm: its body and guard see its bindings; its type, literals and extra
# positions see the match's scope.
fun wkArm<S>(s: S, a: PArm, r: Resolver, w: Walk<S>): (s: S, x: PArm, ch: Bool)
  let ar = armBodyScope(a, r)
  ret wkExpr(a.armBody, ar, s, w)
    |> (b) => (b, wkSpecOpt(a.armType, r, b.s, w))
    |> (b, t) => (b, t, wkLits(a.armLiterals, r, t.s, w))
    |> (b, t, ls) => (b, t, ls, wkExprOpt(a.armGuard, ar, ls.s, w))
    |> (b, t, ls, g) => (b, t, ls, g, wkPositions(a.armExtra, r, g.s, w))
    |> (b, t, ls, g, ex) => (s = ex.s,
                             x = with a(armBody = b.x, armType = t.x, armLiterals = ls.x,
                                        armGuard = g.x, armExtra = ex.x),
                             ch = b.ch || t.ch || ls.ch || g.ch || ex.ch)

fun wkLit<S>(s: S, lt: PLit, r: Resolver, w: Walk<S>): (s: S, x: PLit, ch: Bool) => match(lt)
  (le: PlExpr) => wkExpr(le.litExpr, r, s, w)
    |> (v) => (s = v.s, x = with le(litExpr = v.x), ch = v.ch)
  (lr: PlRange) => wkExpr(lr.rangeLo, r, s, w)
    |> (lo) => (lo, wkExpr(lr.rangeHi, r, lo.s, w))
    |> (lo, hi) => (s = hi.s, x = with lr(rangeLo = lo.x, rangeHi = hi.x), ch = lo.ch || hi.ch)

fun wkPosition<S>(s: S, p: PPos, r: Resolver, w: Walk<S>): (s: S, x: PPos, ch: Bool) =>
  wkSpecOpt(p.posType, r, s, w)
    |> (t) => (s = t.s, x = with p(posType = t.x), ch = t.ch)

fun wkTupEnt<S>(s: S, te: PTupEnt, r: Resolver, w: Walk<S>): (s: S, x: PTupEnt, ch: Bool) =>
  wkExpr(te.tupValue, r, s, w)
    |> (v) => (s = v.s, x = with te(tupValue = v.x), ch = v.ch)

fun wkFieldArg<S>(s: S, fa: PFieldArg, r: Resolver, w: Walk<S>): (s: S, x: PFieldArg, ch: Bool) =>
  wkExpr(fa.faValue, r, s, w)
    |> (v) => (s = v.s, x = with fa(faValue = v.x), ch = v.ch)

# ── specs ────────────────────────────────────────────────────────────────────

fun wkSpecKids<S>(sp: Spec, r: Resolver, s: S, w: Walk<S>): (s: S, x: Spec, ch: Bool) => match(sp)
  (cb: SCallable) => wkSpec(cb.scParams2, r, s, w)
    |> (p) => (p, wkSpecOpt(cb.scResult, r, p.s, w))
    |> (p, rs) => (s = rs.s, x = with cb(scParams2 = p.x, scResult = rs.x), ch = p.ch || rs.ch)
  (ls: SLazyStub) => wkSpecOpt(ls.slsTarget, r, s, w)
    |> (t) => (s = t.s, x = with ls(slsTarget = t.x), ch = t.ch)
  (af: SArrayField) => wkSpec(af.safElem, r, s, w)
    |> (el) => (s = el.s, x = with af(safElem = el.x), ch = el.ch)
  (cl: SClass) => wkSpecs(cl.scParams, r, s, w)
    |> (ps) => (s = ps.s, x = with cl(scParams = ps.x), ch = ps.ch)
  (e2: SEnum) => wkSpecs(e2.seParams, r, s, w)
    |> (ps) => (s = ps.s, x = with e2(seParams = ps.x), ch = ps.ch)
  (cm: SCombination) => wkSpecs(cm.scTypes, r, s, w)
    |> (ms) => (s = ms.s, x = with cm(scTypes = ms.x), ch = ms.ch)
  (t2: STuple) => wkEntries(t2.stEntries, r, s, w)
    |> (es) => (s = es.s, x = with t2(stEntries = es.x), ch = es.ch)
  (b: SBuiltin) => (s = s, x = sp, ch = false)
  (n: SNamed) => wkSpecs(n.snParams, r, s, w)
    |> (ps) => (s = ps.s, x = with n(snParams = ps.x), ch = ps.ch)
  (g: SGeneric) => (s = s, x = sp, ch = false)

fun wkEntry<S>(s: S, se: SEntry, r: Resolver, w: Walk<S>): (s: S, x: SEntry, ch: Bool) =>
  wkSpecOpt(se.seType, r, s, w)
    |> (t) => (t, wkExprOpt(se.seDefault, r, t.s, w))
    |> (t, d) => (s = d.s, x = with se(seType = t.x, seDefault = d.x), ch = t.ch || d.ch)

# ── optionals and lists ──────────────────────────────────────────────────────

fun wkExprOpt<S>(x: PExpr|None, r: Resolver, s: S, w: Walk<S>): (s: S, x: PExpr|None, ch: Bool) => match(x)
  (e2: PExpr) => wkExpr(e2, r, s, w) |> (o) => (s = o.s, x = o.x, ch = o.ch)
  ()          => (s = s, x = None, ch = false)

fun wkSpecOpt<S>(sp: Spec|None, r: Resolver, s: S, w: Walk<S>): (s: S, x: Spec|None, ch: Bool) => match(sp)
  (s2: Spec) => wkSpec(s2, r, s, w) |> (o) => (s = o.s, x = o.x, ch = o.ch)
  ()         => (s = s, x = None, ch = false)

fun wkSpecsOpt<S>(ss: List<Spec>|None, r: Resolver, s: S, w: Walk<S>): (s: S, x: List<Spec>|None, ch: Bool) => match(ss)
  (l: List<Spec>) => wkSpecs(l, r, s, w) |> (o) => (s = o.s, x = o.x, ch = o.ch)
  ()              => (s = s, x = None, ch = false)

fun wkStmts<S>(ss: List<PStmt>, r: Resolver, s: S, w: Walk<S>): (s: S, x: List<PStmt>, ch: Bool) =>
  wkList(ss, s, (s2, x) => wkStmt(x, r, s2, w))

fun wkExprs<S>(es: List<PExpr>, r: Resolver, s: S, w: Walk<S>): (s: S, x: List<PExpr>, ch: Bool) =>
  wkList(es, s, (s2, x) => wkExpr(x, r, s2, w))

fun wkSpecs<S>(ts: List<Spec>, r: Resolver, s: S, w: Walk<S>): (s: S, x: List<Spec>, ch: Bool) =>
  wkList(ts, s, (s2, x) => wkSpec(x, r, s2, w))

fun wkArms<S>(as2: List<PArm>, r: Resolver, s: S, w: Walk<S>): (s: S, x: List<PArm>, ch: Bool) =>
  wkList(as2, s, (s2, x) => wkArm(s2, x, r, w))

fun wkLits<S>(ls: List<PLit>, r: Resolver, s: S, w: Walk<S>): (s: S, x: List<PLit>, ch: Bool) =>
  wkList(ls, s, (s2, x) => wkLit(s2, x, r, w))

fun wkPositions<S>(ps: List<PPos>, r: Resolver, s: S, w: Walk<S>): (s: S, x: List<PPos>, ch: Bool) =>
  wkList(ps, s, (s2, x) => wkPosition(s2, x, r, w))

fun wkTupEnts<S>(es: List<PTupEnt>, r: Resolver, s: S, w: Walk<S>): (s: S, x: List<PTupEnt>, ch: Bool) =>
  wkList(es, s, (s2, x) => wkTupEnt(s2, x, r, w))

fun wkFieldArgs<S>(fas: List<PFieldArg>, r: Resolver, s: S, w: Walk<S>): (s: S, x: List<PFieldArg>, ch: Bool) =>
  wkList(fas, s, (s2, x) => wkFieldArg(s2, x, r, w))

fun wkEntries<S>(es: List<SEntry>, r: Resolver, s: S, w: Walk<S>): (s: S, x: List<SEntry>, ch: Bool) =>
  wkList(es, s, (s2, x) => wkEntry(s2, x, r, w))

# rw.seq: each element in order; the ORIGINAL list when none changed. The new
# list is started only at the first change, from the unchanged prefix.
fun wkList<S, T>(xs: List<T>, s: S, f: (:S, :T): (s: S, x: T, ch: Bool)): (s: S, x: List<T>, ch: Bool)
  let o = fold(xs, (s = s, i = 0, ch = false, acc = List<T>()), (st, x) => wkListStep(st, x, xs, f))
  ret (s = o.s, x = o.ch ? o.acc : xs, ch = o.ch)

fun wkListStep<S, T>(st: (s: S, i: Int, ch: Bool, acc: List<T>), x: T, xs: List<T>,
                     f: (:S, :T): (s: S, x: T, ch: Bool)): (s: S, i: Int, ch: Bool, acc: List<T>)
  let o = f(st.s, x)
  ret (s = o.s, i = st.i + 1, ch = st.ch || o.ch,
       acc = st.ch ? append(st.acc, o.x) : (o.ch ? append(take(xs, st.i), o.x) : st.acc))
