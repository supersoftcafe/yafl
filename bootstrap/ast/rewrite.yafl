# bootstrap/rewrite.yafl — THE tree traversal, written once. This is
# pyast/rewrite.py's role in the port: Python distributes the walk across
# each node's search_and_replace method and derives the rebuild by
# reflection; YAFL has no reflection (by design), so the same walk is a
# single hand-written bottom-up rebuild, and every pass supplies only its
# leaf rules as callbacks.
#
# THE VISIT-SET LAW (verified against each node's search_and_replace):
#   Fun        visits params, body, ret, wheres
#   Let        visits ONLY default + declared type — NEVER wheres
#   Destructure visits default, type, targets
#   Typealias  visits ONLY its type — NEVER wheres
#   Class      visits params, members, implements, wheres, cAllParents —
#              NEVER cAllSlots
#   Enum       visits params, variants, eSpec — its SEnum's all_fields are
#              NEVER visited (recursive enums would loop); passes that need
#              them use walk-all-fields style helpers with visited sets
#   NamedSpec  is a traversal LEAF: the callback fires on the node, its
#              params are never visited
#   PeName     visits refTypeParams and penTrait — a penTrait replacement
#              that is not an SClass becomes None (access.py:374-378)
#
# Callback protocol: return the replacement, or None for "no change here".
# Children are rebuilt FIRST, then the callback fires on the rebuilt node
# (bottom-up, like rw.rewrite); a replacement is NOT re-visited.
namespace Bootstrap::Ast

import System
import System::Containers

import Bootstrap::Frontend
import Bootstrap::Parse
import Bootstrap::Resolve



class [final] Rw(rwFnExpr: (:PExpr): PExpr|None,
                 rwFnSpec: (:Spec): Spec|None,
                 rwFnStmt: (:PStmt): PStmt|None)

fun rwNoExpr(x: PExpr): PExpr|None => None

fun rwNoSpec(sp: Spec): Spec|None => None

fun rwNoStmt(st: PStmt): PStmt|None => None

# The common shapes.
fun rwOnExpr(f): Rw => Rw(f, rwNoSpec, rwNoStmt)

fun rwOnSpec(f): Rw => Rw(rwNoExpr, f, rwNoStmt)

fun rwOnStmt(f): Rw => Rw(rwNoExpr, rwNoSpec, f)

# ── statements ───────────────────────────────────────────────────────────────

# List fields are rewritten with `map`, which always builds a new list: a
# parent's `with` then sees a changed field and rebuilds too, so a walk that
# changes nothing still allocates along every list (the old Chain spine was
# rebuilt through `with` and kept identity). Correct either way — identity
# never surfaces — but see docs/preserving-rewrites-design.md for the cost.
fun rwStmts(ss, w: Rw): List<PStmt> => rwStmtChain(ss, w)

fun rwStmtChain(ss: List<PStmt>, w: Rw): List<PStmt> => map(ss, (x) => rwStmt(x, w))

fun rwStmt(st, w: Rw)
  let rebuilt = rwStmtKids(st, w)
  ret match(w.rwFnStmt(rebuilt))
    (r: PStmt) => r
    ()         => rebuilt

fun rwStmtKids(st, w: Rw): PStmt => match(st)
  (f: PsFun)  => with f(fParams = rwStmt(f.fParams, w),
                        fBody   = rwExprOpt(f.fBody, w),
                        fRet    = rwSpecOpt(f.fRet, w),
                        fWheres = rwSpecs(f.fWheres, w))
  (l: PsLet)  => with l(lType    = rwSpecOpt(l.lType, w),
                        lDefault = rwExprOpt(l.lDefault, w))
  (d: PsDestructure) => with d(dType    = rwSpecOpt(d.dType, w),
                               dTargets = rwStmts(d.dTargets, w),
                               dDefault = rwExprOpt(d.dDefault, w))
  (c: PsClass) => with c(cParams     = rwStmt(c.cParams, w),
                         cImplements = rwSpecs(c.cImplements, w),
                         cWheres     = rwSpecs(c.cWheres, w),
                         cMembers    = rwStmts(c.cMembers, w),
                         cAllParents = rwSpecsOpt(c.cAllParents, w))
  (e2: PsEnum) => with e2(eParams   = rwStmt(e2.eParams, w),
                          eVariants = rwStmts(e2.eVariants, w),
                          eSpec     = rwSpecOpt(e2.eSpec, w))
  (ta: PsTypealias) => with ta(taType = rwSpec(ta.taType, w))
  (rt: PsRet)  => with rt(retValue = rwExpr(rt.retValue, w))
  (a: PsAction) => with a(action = rwExpr(a.action, w))
  (fa: PsFieldAssign) => with fa(faTarget = rwExpr(fa.faTarget, w), faValue = rwExpr(fa.faValue, w))
  (i: PsIf)    => with i(ifCond  = rwExpr(i.ifCond, w),
                         ifTrue  = rwStmts(i.ifTrue, w),
                         ifFalse = rwStmts(i.ifFalse, w))
  (o: PStmt)   => st

# ── expressions ──────────────────────────────────────────────────────────────

fun rwExpr(x: PExpr, w: Rw): PExpr
  let rebuilt = rwExprKids(x, w)
  ret match(w.rwFnExpr(rebuilt))
    (r: PExpr) => r
    ()         => rebuilt

fun rwExprOpt(x: PExpr|None, w: Rw) => match(x)
  (e2: PExpr) => rwExpr(e2, w)
  ()          => None

fun rwExprs(es, w: Rw): List<PExpr> => rwExprChain(es, w)

fun rwExprChain(es: List<PExpr>, w: Rw): List<PExpr> => map(es, (x) => rwExpr(x, w))

fun rwExprKids(x, w: Rw): PExpr => match(x)
  (nm: PeName)   => with nm(refTypeParams = rwSpecs(nm.refTypeParams, w),
                            penTrait      = rwTrait(nm.penTrait, w))
  (d: PeDot)     => with d(base = rwExpr(d.base, w))
  (c: PeCall)    => with c(function  = rwExpr(c.function, w),
                           parameter = rwExpr(c.parameter, w))
  (tp: PeTuple)  => with tp(exprs = rwTupEnts(tp.exprs, w))
  (te: PeTernary) => with te(condition   = rwExpr(te.condition, w),
                             trueResult  = rwExpr(te.trueResult, w),
                             falseResult = rwExpr(te.falseResult, w))
  (ps: PePinSet) => with ps(psSubject = rwExpr(ps.psSubject, w),
                            psTarget  = rwExpr(ps.psTarget, w),
                            psValue   = rwExpr(ps.psValue, w))
  (lm: PeLambda) => with lm(lamParams = rwStmt(lm.lamParams, w),
                            lamBody   = rwExpr(lm.lamBody, w),
                            lamRet    = rwSpecOpt(lm.lamRet, w))
  (bk: PeBlock)  => with bk(blockStmts = rwStmts(bk.blockStmts, w),
                            blockValue = rwExpr(bk.blockValue, w))
  (mt: PeMatch)  => with mt(subject    = rwExpr(mt.subject, w),
                            arms       = rwArms(mt.arms, w),
                            matchExtra = rwExprs(mt.matchExtra, w))
  (op: PeBuiltinOp) => with op(opType   = rwSpec(op.opType, w),
                               opParams = rwExpr(op.opParams, w))
  (nw: PeNew)    => with nw(newType  = rwSpec(nw.newType, w),
                            newParam = rwExpr(nw.newParam, w))
  # Python's s&r visits every field_args VALUE expression.
  (ne: PeNewEnum) => with ne(fieldArgs    = rwFieldArgs(ne.fieldArgs, w),
                             neTypeParams = rwSpecs(ne.neTypeParams, w))
  (ar: PeArrayRead) => with ar(arrObj   = rwExpr(ar.arrObj, w),
                               arrIndex = rwExpr(ar.arrIndex, w))
  (cv: PeConvert) => with cv(convInner  = rwExpr(cv.convInner, w),
                             convTarget = rwSpec(cv.convTarget, w))
  (qq: PeCoalesce) => with qq(qqSubject  = rwExpr(qq.qqSubject, w),
                              qqFallback = rwExpr(qq.qqFallback, w))
  (wx: PeWith)   => with wx(withSubject = rwExpr(wx.withSubject, w),
                            withRepls   = rwExpr(wx.withRepls, w))
  (lp: PeLoop)   => with lp(loopBody   = rwExpr(lp.loopBody, w),
                            loopParams = rwExprs(lp.loopParams, w))
  (rc: PeRecur)  => with rc(recArgs = rwExprs(rc.recArgs, w))
  # LazyExpression visits ONLY its target type (access.py:597-599).
  (lz: PeLazy)   => with lz(lzTarget = rwSpec(lz.lzTarget, w))
  (o: PeLiteral) => x

# A penTrait replacement that is not a class spec becomes None
# (access.py:374-378).
fun rwTrait(sp: Spec|None, w: Rw) => match(sp)
  (s2: Spec) => match(rwSpec(s2, w))
    (c: SClass) => c
    (o: Spec)   => None
  ()         => None

fun rwTupEnts(es, w: Rw): List<PTupEnt> => rwTupEntChain(es, w)

fun rwTupEntChain(es: List<PTupEnt>, w: Rw): List<PTupEnt> => map(es, (x) => rwTupEnt(x, w))

fun rwTupEnt(te2: PTupEnt, w: Rw) => with te2(tupValue = rwExpr(te2.tupValue, w))

fun rwArms(as2, w: Rw): List<PArm> => rwArmChain(as2, w)

fun rwArmChain(as2: List<PArm>, w: Rw): List<PArm> => map(as2, (x) => rwArm(x, w))

fun rwArm(a: PArm, w: Rw): PArm => with a(armType     = rwSpecOpt(a.armType, w),
                                          armBody     = rwExpr(a.armBody, w),
                                          armLiterals = rwLits(a.armLiterals, w),
                                          armGuard    = rwExprOpt(a.armGuard, w),
                                          armExtra    = rwPositions(a.armExtra, w))

# An extra position carries a SPEC, and a spec position a walker does not
# reach is a spec that never resolves or substitutes.
fun rwPositions(ps, w: Rw): List<PPos> => rwPosChain(ps, w)

fun rwPosChain(ps: List<PPos>, w: Rw): List<PPos> => map(ps, (x) => with x(posType = rwSpecOpt(x.posType, w)))

# Arm LITERALS are expressions and Python's MatchArm visits them
# (match.py:181) — a fold or rewrite that skips them diverges (first seen as
# _node_count undercounting literal-heavy functions below the inline
# threshold).
fun rwLits(ls, w: Rw): List<PLit> => rwLitChain(ls, w)

fun rwLitChain(ls: List<PLit>, w: Rw): List<PLit> => map(ls, (x) => rwLit(x, w))

fun rwLit(lt, w: Rw) => match(lt)
  (le: PlExpr)  => with le(litExpr = rwExpr(le.litExpr, w))
  (lr: PlRange) => with lr(rangeLo = rwExpr(lr.rangeLo, w),
                           rangeHi = rwExpr(lr.rangeHi, w))

fun rwFieldArgs(fas, w: Rw): List<PFieldArg> => rwFieldArgChain(fas, w)

fun rwFieldArgChain(fas: List<PFieldArg>, w: Rw): List<PFieldArg> => map(fas, (x) => rwFieldArg(x, w))

fun rwFieldArg(fa: PFieldArg, w: Rw) => with fa(faValue = rwExpr(fa.faValue, w))

# ── specs ────────────────────────────────────────────────────────────────────

fun rwSpec(sp, w: Rw): Spec
  let rebuilt = rwSpecKids(sp, w)
  ret match(w.rwFnSpec(rebuilt))
    (r: Spec) => r
    ()        => rebuilt

fun rwSpecOpt(sp: Spec|None, w: Rw) => match(sp)
  (s2: Spec) => rwSpec(s2, w)
  ()         => None

fun rwSpecs(ts, w: Rw): List<Spec> => rwSpecChain(ts, w)

fun rwSpecChain(ts: List<Spec>, w: Rw): List<Spec> => map(ts, (x) => rwSpec(x, w))

fun rwSpecsOpt(ss: List<Spec>|None, w: Rw): List<Spec>|None => match(ss)
  (l: List<Spec>) => rwSpecs(l, w)
  ()              => None

fun rwSpecKids(sp, w: Rw): Spec => match(sp)
  (e2: SEnum)        => with e2(seParams = rwSpecs(e2.seParams, w))
  (cl: SClass)       => with cl(scParams = rwSpecs(cl.scParams, w))
  (n: SNamed)        => sp   # traversal LEAF
  (cm: SCombination) => with cm(scTypes = rwSpecs(cm.scTypes, w))
  (t2: STuple)       => with t2(stEntries = rwEntries(t2.stEntries, w))
  (cb: SCallable)    => with cb(scParams2 = rwSpec(cb.scParams2, w),
                                scResult  = rwSpecOpt(cb.scResult, w))
  (af: SArrayField)  => with af(safElem = rwSpec(af.safElem, w))
  (ls: SLazyStub)    => with ls(slsTarget = rwSpecOpt(ls.slsTarget, w))
  (o: Spec)          => sp

fun rwEntries(es, w: Rw): List<SEntry> => rwEntryChain(es, w)

fun rwEntryChain(es: List<SEntry>, w: Rw): List<SEntry> => map(es, (x) => rwEntry(x, w))

fun rwEntry(se: SEntry, w: Rw) => with se(seType    = rwSpecOpt(se.seType, w),
                                          seDefault = rwExprOpt(se.seDefault, w))

# ── the fold twins ───────────────────────────────────────────────────────────
# Same visit sets, no rebuild: the accumulator threads through every visited
# node in traversal order (children after the node — a PRE-order fold, which
# is what every scan in the compiler observes: counters and collectors are
# order-insensitive or want first-encounter order).

fun foldStmts<T>(ss: List<PStmt>, f: (:T, :PStmt): T,
                 fx: (:T, :PExpr): T, acc: T): T => foldStmtLoop(ss, f, fx, acc)

fun foldStmtLoop<T>(ss: List<PStmt>, f: (:T, :PStmt): T, fx: (:T, :PExpr): T, acc: T): T =>
  fold(ss, acc, (a, x) => foldStmt(x, f, fx, a))

fun foldStmt<T>(st, f: (:T, :PStmt): T, fx: (:T, :PExpr): T,
                acc: T): T
  let acc2 = f(acc, st)
  ret match(st)
    (fn: PsFun)  => foldSpecs(fn.fWheres, f, fx,
                      foldSpecOpt(fn.fRet, f, fx,
                        foldExprOpt(fn.fBody, f, fx,
                          foldStmt(fn.fParams, f, fx, acc2))))
    (l: PsLet)   => foldExprOpt(l.lDefault, f, fx,
                                foldSpecOpt(l.lType, f, fx, acc2))
    (d: PsDestructure) => foldStmts(d.dTargets, f, fx,
                                    foldExprOpt(d.dDefault, f, fx,
                                      foldSpecOpt(d.dType, f, fx,
                                                  acc2)))
    (rt: PsRet)  => foldExpr(rt.retValue, f, fx, acc2)
    (a: PsAction) => foldExpr(a.action, f, fx, acc2)
    (fa: PsFieldAssign) => foldExpr(fa.faValue, f, fx, foldExpr(fa.faTarget, f, fx, acc2))
    (i: PsIf)    => foldStmts(i.ifFalse, f, fx,
                              foldStmts(i.ifTrue, f, fx,
                                        foldExpr(i.ifCond, f, fx,
                                                 acc2)))
    (c: PsClass) => foldStmts(c.cMembers, f, fx,
                      foldSpecs(c.cWheres, f, fx,
                        foldSpecs(c.cImplements, f, fx,
                          foldStmt(c.cParams, f, fx,
                            foldSpecsOpt(c.cAllParents, f, fx, acc2)))))
    (e2: PsEnum) => foldSpecOpt(e2.eSpec, f, fx,
                      foldStmts(e2.eVariants, f, fx,
                        foldStmt(e2.eParams, f, fx, acc2)))
    (ta: PsTypealias) => foldSpec(ta.taType, f, fx, acc2)
    (o: PStmt)   => acc2

fun foldExprOpt<T>(x: PExpr|None, f: (:T, :PStmt): T, fx: (:T, :PExpr): T,
                   acc: T): T => match(x)
  (e2: PExpr) => foldExpr(e2, f, fx, acc)
  ()          => acc

fun foldExpr<T>(x, f: (:T, :PStmt): T, fx: (:T, :PExpr): T,
                acc: T): T
  let acc2 = fx(acc, x)
  ret match(x)
    (nm: PeName)   => foldSpecOpt(nm.penTrait, f, fx,
                        foldSpecs(nm.refTypeParams, f, fx, acc2))
    (d: PeDot)     => foldExpr(d.base, f, fx, acc2)
    (c: PeCall)    => foldExpr(c.parameter, f, fx,
                               foldExpr(c.function, f, fx, acc2))
    (tp: PeTuple)  => foldTupEnts(tp.exprs, f, fx, acc2)
    (te: PeTernary) => foldExpr(te.falseResult, f, fx,
                         foldExpr(te.trueResult, f, fx,
                           foldExpr(te.condition, f, fx, acc2)))
    (ps: PePinSet) => foldExpr(ps.psValue, f, fx,
                        foldExpr(ps.psTarget, f, fx,
                          foldExpr(ps.psSubject, f, fx, acc2)))
    (lm: PeLambda) => foldSpecOpt(lm.lamRet, f, fx,
                        foldExpr(lm.lamBody, f, fx,
                          foldStmt(lm.lamParams, f, fx, acc2)))
    (bk: PeBlock)  => foldExpr(bk.blockValue, f, fx,
                               foldStmts(bk.blockStmts, f, fx, acc2))
    (mt: PeMatch)  => foldArms(mt.arms, f, fx,
                               foldExprs(mt.matchExtra, f, fx,
                                 foldExpr(mt.subject, f, fx, acc2)))
    (op: PeBuiltinOp) => foldExpr(op.opParams, f, fx,
                                  foldSpec(op.opType, f, fx, acc2))
    (nw: PeNew)    => foldExpr(nw.newParam, f, fx,
                               foldSpec(nw.newType, f, fx, acc2))
    (ar: PeArrayRead) => foldExpr(ar.arrIndex, f, fx,
                                  foldExpr(ar.arrObj, f, fx, acc2))
    (cv: PeConvert) => foldSpec(cv.convTarget, f, fx,
                                foldExpr(cv.convInner, f, fx, acc2))
    (qq: PeCoalesce) => foldExpr(qq.qqFallback, f, fx,
                                 foldExpr(qq.qqSubject, f, fx, acc2))
    (wx: PeWith)   => foldExpr(wx.withRepls, f, fx,
                               foldExpr(wx.withSubject, f, fx, acc2))
    (ne: PeNewEnum) => foldSpecs(ne.neTypeParams, f, fx,
                         fold(ne.fieldArgs, acc2, (a3, fa) =>
                            foldExpr(fa.faValue, f, fx, a3)))
    (lp: PeLoop)   => foldExpr(lp.loopBody, f, fx,
                               foldExprs(lp.loopParams, f, fx,
                                         acc2))
    (rc: PeRecur)  => foldExprs(rc.recArgs, f, fx, acc2)
    (lz: PeLazy)   => foldSpec(lz.lzTarget, f, fx, acc2)
    (o: PeLiteral) => acc2

fun foldExprs<T>(es: List<PExpr>, f: (:T, :PStmt): T, fx: (:T, :PExpr): T, acc: T): T =>
  fold(es, acc, (a, x) => foldExpr(x, f, fx, a))

fun foldTupEnts<T>(es: List<PTupEnt>, f: (:T, :PStmt): T, fx: (:T, :PExpr): T, acc: T): T =>
  fold(es, acc, (a, x) => foldExpr(x.tupValue, f, fx, a))

fun foldArms<T>(as2: List<PArm>, f: (:T, :PStmt): T, fx: (:T, :PExpr): T, acc: T): T =>
  fold(as2, acc, (a, x) => foldPositions(x.armExtra, f, fx,
        foldExprOpt(x.armGuard, f, fx,
                    foldLits(x.armLiterals, f, fx,
                             foldExpr(x.armBody, f, fx,
                               foldSpecOpt(x.armType, f, fx,
                                           a))))))

# Every extra position's SPEC — the same reach law as the rw walker.
fun foldPositions<T>(ps: List<PPos>, f: (:T, :PStmt): T, fx: (:T, :PExpr): T, acc: T): T =>
  fold(ps, acc, (a, x) => foldSpecOpt(x.posType, f, fx, a))

fun foldLits<T>(ls: List<PLit>, f: (:T, :PStmt): T, fx: (:T, :PExpr): T, acc: T): T =>
  fold(ls, acc, (a, x) => foldLit(x, f, fx, a))

fun foldLit<T>(lt, f: (:T, :PStmt): T, fx: (:T, :PExpr): T, acc: T): T => match(lt)
  (le: PlExpr)  => foldExpr(le.litExpr, f, fx, acc)
  (lr: PlRange) => foldExpr(lr.rangeHi, f, fx,
                            foldExpr(lr.rangeLo, f, fx, acc))

# Specs carry EXPRESSIONS: a tuple entry's default (Python's
# TupleEntrySpec.search_and_replace descends `default`, so its callback
# fires on those Expression instances). The fold twins must therefore
# thread fx through every spec position the rewrite walker descends —
# skipping them undercounts the _node_count mirror. That exact miss broke
# whole-compiler c1 byte parity (found 08-12): aiNodeCount never saw the
# default riding in a Convert TARGET, deRef fell under the inline
# threshold in the port only, and Python kept calls the port inlined.
# Specs themselves fire NO callback — Python counts only Expression/
# Statement instances. Reach mirrors rwSpecKids/rwEntry exactly.

fun foldSpec<T>(sp, f: (:T, :PStmt): T, fx: (:T, :PExpr): T,
                acc: T): T => match(sp)
  (e2: SEnum)        => foldSpecs(e2.seParams, f, fx, acc)
  (cl: SClass)       => foldSpecs(cl.scParams, f, fx, acc)
  (n: SNamed)        => acc   # traversal LEAF (rwSpecKids parity)
  (cm: SCombination) => foldSpecs(cm.scTypes, f, fx, acc)
  (t2: STuple)       => foldEntries(t2.stEntries, f, fx, acc)
  (cb: SCallable)    => foldSpecOpt(cb.scResult, f, fx,
                          foldSpec(cb.scParams2, f, fx, acc))
  (af: SArrayField)  => foldSpec(af.safElem, f, fx, acc)
  (ls: SLazyStub)    => foldSpecOpt(ls.slsTarget, f, fx, acc)
  (o: Spec)          => acc

fun foldSpecOpt<T>(sp: Spec|None, f: (:T, :PStmt): T, fx: (:T, :PExpr): T,
                   acc: T): T => match(sp)
  (s2: Spec) => foldSpec(s2, f, fx, acc)
  ()         => acc

fun foldSpecs<T>(ts: List<Spec>, f: (:T, :PStmt): T, fx: (:T, :PExpr): T, acc: T): T =>
  fold(ts, acc, (a, x) => foldSpec(x, f, fx, a))

fun foldSpecsOpt<T>(ss: List<Spec>|None, f: (:T, :PStmt): T,
                    fx: (:T, :PExpr): T, acc: T): T => match(ss)
  (l: List<Spec>) => foldSpecs(l, f, fx, acc)
  ()              => acc

fun foldEntries<T>(es: List<SEntry>, f: (:T, :PStmt): T, fx: (:T, :PExpr): T, acc: T): T =>
  fold(es, acc, (a, x) => foldExprOpt(x.seDefault, f, fx, foldSpecOpt(x.seType, f, fx, a)))

# ── counter-threading rewrite twins ──────────────────────────────────────────
# Same traversal, threading an Int through in visit order — for passes whose
# callbacks ALLOCATE (the inliner's fresh-suffix counter must increment in
# exactly Python's order, including inside nested rewrites fired mid-walk).
# The callback returns the updated counter plus the replacement (or None).

class [final] RwN(rnFnExpr: (:Int, :Resolver|None, :PExpr): (n2: Int, r: PExpr|None),
                  rnFnStmt: (:Int, :Resolver|None, :PStmt): (n2: Int, r: PStmt|None))
class [final] RwNE(rneN: Int, rneExpr: PExpr)
class [final] RwNS(rnsN: Int, rnsStmt: PStmt)
class [final] RwNSs(rnssN: Int, rnssStmts: List<PStmt>)

fun rwnNoExpr(n: Int, _sc: Resolver|None, x: PExpr): (n2: Int, r: PExpr|None) => (n, None)

fun rwnNoStmt(n: Int, _sc: Resolver|None, st: PStmt): (n2: Int, r: PStmt|None) => (n, None)

# ── the scope in effect at each node ─────────────────────────────────────────
# Python's search_and_replace hands every node the resolver in effect THERE,
# and a callback may read types through it: the inliner types an untyped
# parameter's binding let from its argument, and an argument that names a
# match-arm binder has a type only inside that arm. So the walk threads the
# resolver and adds exactly the scopes Python's nodes add — block locals,
# lambda params, match-arm bindings (with each extra position's), if-branch
# lets, a function's params, a class body — while every other child sees its
# parent's. Each callback receives its node's INCOMING resolver, as
# rw.rewrite passes it. A walk that needs no scope (block_exits) threads None,
# which stays None.

fun rwnLocalScope(lets: List<PStmt>, sc: Resolver|None) => match(sc)
  (r2: Resolver) => localScope(lets, r2)
  ()             => None

fun rwnFunScope(f: PsFun, sc: Resolver|None) => match(sc)
  (r2: Resolver) => localScope(flattenParams(f.fParams),
                               f.fNested ? r2 : traitScope(f.fWheres, r2))
  ()             => None

fun rwnClassScope(c, sc: Resolver|None) => match(sc)
  (r2: Resolver) => genScope(c.cGens, c.cWheres, RClassBody(c, r2))
  ()             => None

# The arm's own binding, then one per extra position at its DECLARED type —
# posScope's fallback type is the subject's, which search_and_replace does not
# consult, so the fallback chain is empty.
fun rwnArmScope(a: PArm, sc: Resolver|None) => match(sc)
  (r2: Resolver) => extraScope(a.armExtra,
                               chain2(List()),
                               bindingScope(a, a.armType, r2))
  ()             => None

fun rwnStmts(ss: List<PStmt>, w: RwN, sc, n) => rwnStmtLoop(ss, w, sc, n, List())

# State fields named to match another fold over the same types — workaround for #88.
fun rwnStmtLoop(ss: List<PStmt>, w: RwN, sc, n, acc) =>
  fold(ss, (i = n, acc = acc), (st, x) => rwnStmtLoopStep(st, x, w, sc))
    |> (r) => RwNSs(r.i, r.acc)

fun rwnStmtLoopStep(st: (i: Int, acc: List<PStmt>), x: PStmt, w: RwN, sc) =>
  rwnStmt(x, w, sc, st.i)
  |> (o) => (i = o.rnsN, acc = append(st.acc, o.rnsStmt))

fun rwnStmt(st, w: RwN, sc, n)
  let kids = rwnStmtKids(st, w, sc, n)
  let out = w.rnFnStmt(kids.rnsN, rwnOwnScope(st, sc), kids.rnsStmt)
  ret match(out.r)
    (rep: PStmt) => RwNS(out.n2, rep)
    ()           => RwNS(out.n2, kids.rnsStmt)

# The resolver a statement's OWN callback receives. Python's FunctionStatement
# and ClassStatement hand rw.rewrite their nested scope (the body's, the
# members'); every other statement hands on the scope it was entered with.
fun rwnOwnScope(st, sc) => match(st)
  (f: PsFun)   => rwnFunScope(f, sc)
  (c: PsClass) => rwnClassScope(c, sc)
  (o: PStmt)   => sc

fun rwnStmtKids(st, w: RwN, sc, n) => match(st)
  (f: PsFun)  => rwnStmt(f.fParams, w, sc, n)
    |> (p) => (p, rwnExprOpt(f.fBody, w, rwnFunScope(f, sc), p.rnsN))
    |> (p, b) => RwNS(b.rneN2,
                      PsFun(f.fName, f.fAttrs, f.fGens, p.rnsStmt,
                            b.rneExpr2, f.fRet, f.fWheres, f.psfLine,
                            f.fRetInferred, f.fNested, f.fImports, f.fGlobal))
  (l: PsLet)  => rwnExprOpt(l.lDefault, w, sc, n)
    |> (d) => RwNS(d.rneN2,
                   PsLet(l.lName, l.lAttrs, l.lGens, l.lType, d.rneExpr2,
                         l.lArrayLen, l.lWheres, l.pslLine,
                         l.lTypeInferred, l.lImports))
  (d: PsDestructure) => rwnExprOpt(d.dDefault, w, sc, n)
    |> (dv) => (dv, rwnStmts(d.dTargets, w, sc, dv.rneN2))
    |> (dv, ts) => RwNS(ts.rnssN,
                        PsDestructure(d.dName, d.dAttrs, d.dType,
                                      ts.rnssStmts, dv.rneExpr2, d.psdLine,
                                      d.dTypeInferred))
  (c: PsClass) => rwnStmt(c.cParams, w, sc, n)
    |> (p) => (p, rwnStmts(c.cMembers, w, rwnClassScope(c, sc), p.rnsN))
    |> (p, ms) => RwNS(ms.rnssN,
                       PsClass(c.cName, c.cAttrs, c.cGens, p.rnsStmt,
                               c.cImplements, c.cWheres, ms.rnssStmts,
                               c.cIsInterface, c.pscLine, c.cAllParents,
                               c.cAllSlots, c.cImports))
  (e2: PsEnum) => rwnStmt(e2.eParams, w, sc, n)
    |> (p) => (p, rwnStmts(e2.eVariants, w, sc, p.rnsN))
    |> (p, vs) => RwNS(vs.rnssN,
                       PsEnum(e2.eName, e2.eAttrs, e2.eGens, p.rnsStmt,
                              vs.rnssStmts,
                              e2.eHasParams, e2.pseLine, e2.eRootName,
                              e2.eSpec, e2.eImports))
  (rt: PsRet)  => rwnExpr(rt.retValue, w, sc, n)
    |> (v) => RwNS(v.rneN, PsRet(v.rneExpr, rt.psrLine))
  (a: PsAction) => rwnExpr(a.action, w, sc, n)
    |> (v) => RwNS(v.rneN, PsAction(v.rneExpr, a.psaLine))
  (fa: PsFieldAssign) => rwnExpr(fa.faTarget, w, sc, n)
    |> (t1) => rwnFieldAssignValue(fa, t1, w, sc)
  (i: PsIf)    => rwnExpr(i.ifCond, w, sc, n)
    |> (cd) => (cd, rwnStmts(i.ifTrue, w, rwnLocalScope(i.ifTrue, sc),
                             cd.rneN))
    |> (cd, tb) => (cd, tb, rwnStmts(i.ifFalse, w,
                                     rwnLocalScope(i.ifFalse, sc),
                                     tb.rnssN))
    |> (cd, tb, fb) => RwNS(fb.rnssN,
                            PsIf(cd.rneExpr, tb.rnssStmts, fb.rnssStmts,
                                 i.psifLine))
  (o: PStmt)   => RwNS(n, st)

class [final] RwNEo(rneN2: Int, rneExpr2: PExpr|None)

fun rwnExprOpt(x: PExpr|None, w: RwN, sc, n) => match(x)
  (e2: PExpr) => rwnExpr(e2, w, sc, n)
    |> (o) => RwNEo(o.rneN, o.rneExpr)
  ()          => RwNEo(n, None)

fun rwnExpr(x, w: RwN, sc, n)
  let kids = rwnExprKids(x, w, sc, n)
  let out = w.rnFnExpr(kids.rneN, sc, kids.rneExpr)
  ret match(out.r)
    (rep: PExpr) => RwNE(out.n2, rep)
    ()           => RwNE(out.n2, kids.rneExpr)

class [final] RwNEs(rnesN: Int, rnesExprs: List<PExpr>)
class [final] RwNTs(rntsN: Int, rntsEnts: List<PTupEnt>)
class [final] RwNAs(rnasN: Int, rnasArms: List<PArm>)

# A block's statements and its value both see the block's own lets; the
# block's callback (in rwnExpr) sees the scope it was entered with.
fun rwnBlockIn(bk: PeBlock, w: RwN, bsc, n) => rwnStmts(bk.blockStmts, w, bsc, n)
  |> (ss) => (ss, rwnExpr(bk.blockValue, w, bsc, ss.rnssN))
  |> (ss, v) => RwNE(v.rneN, PeBlock(ss.rnssStmts, v.rneExpr,
                                     bk.blockTag, bk.pebkLine))

fun rwnExprKids(x, w: RwN, sc, n) => match(x)
  (d: PeDot)     => rwnExpr(d.base, w, sc, n)
    |> (b) => RwNE(b.rneN, PeDot(b.rneExpr, d.member, d.pedLine, d.pedIndex))
  (c: PeCall)    => rwnExpr(c.function, w, sc, n)
    |> (f) => (f, rwnExpr(c.parameter, w, sc, f.rneN))
    |> (f, p) => RwNE(p.rneN, PeCall(f.rneExpr, p.rneExpr, c.pecLine))
  (tp: PeTuple)  => rwnTupEnts(tp.exprs, w, sc, n, List())
    |> (es) => RwNE(es.rntsN, PeTuple(es.rntsEnts, tp.petLine))
  (te: PeTernary) => rwnExpr(te.condition, w, sc, n)
    |> (cd) => (cd, rwnExpr(te.trueResult, w, sc, cd.rneN))
    |> (cd, tr) => (cd, tr, rwnExpr(te.falseResult, w, sc, tr.rneN))
    |> (cd, tr, fr) => RwNE(fr.rneN,
                            PeTernary(cd.rneExpr, tr.rneExpr, fr.rneExpr,
                                      te.pety))
  (ps: PePinSet) => rwnExpr(ps.psSubject, w, sc, n)
    |> (sb) => (sb, rwnExpr(ps.psTarget, w, sc, sb.rneN))
    |> (sb, tg) => (sb, tg, rwnExpr(ps.psValue, w, sc, tg.rneN))
    |> (sb, tg, vl) => RwNE(vl.rneN,
                            PePinSet(sb.rneExpr, tg.rneExpr, vl.rneExpr,
                                     ps.pepsLine))
  (lm: PeLambda) => rwnStmt(lm.lamParams, w, sc, n)
    |> (p) => (p, rwnExpr(lm.lamBody, w,
                          rwnLocalScope(flattenParams(lm.lamParams), sc),
                          p.rnsN))
    |> (p, b) => RwNE(b.rneN, PeLambda(p.rnsStmt, b.rneExpr, lm.pelLine,
                                       lm.lamRet))
  (bk: PeBlock)  => rwnBlockIn(bk, w, rwnLocalScope(bk.blockStmts, sc), n)
  # Python's order: subject, arms, extra subjects (match.py). The counter
  # advances inside arms, so visiting the extras first would renumber any
  # inline in an extra subject.
  (mt: PeMatch)  => rwnExpr(mt.subject, w, sc, n)
    |> (sj) => (sj, rwnArms(mt.arms, w, sc, sj.rneN, List()))
    |> (sj, as3) => (sj, as3, rwnExprs(mt.matchExtra, w, sc,
                                       as3.rnasN, List()))
    |> (sj, as3, ex) => RwNE(ex.rnesN,
                             with mt(subject    = sj.rneExpr,
                                     arms       = as3.rnasArms,
                                     matchExtra = ex.rnesExprs))
  (op: PeBuiltinOp) => rwnExpr(op.opParams, w, sc, n)
    |> (p) => RwNE(p.rneN, PeBuiltinOp(op.opType, op.opName, p.rneExpr,
                                       op.peboLine))
  (nw: PeNew)    => rwnExpr(nw.newParam, w, sc, n)
    |> (p) => RwNE(p.rneN, PeNew(nw.newType, p.rneExpr, nw.penwLine))
  (ar: PeArrayRead) => rwnExpr(ar.arrObj, w, sc, n)
    |> (ob) => (ob, rwnExpr(ar.arrIndex, w, sc, ob.rneN))
    |> (ob, ix) => RwNE(ix.rneN, PeArrayRead(ob.rneExpr, ix.rneExpr,
                                             ar.pearLine))
  (cv: PeConvert) => rwnExpr(cv.convInner, w, sc, n)
    |> (iv) => RwNE(iv.rneN, PeConvert(iv.rneExpr, cv.convTarget,
                                       cv.pecvLine))
  (qq: PeCoalesce) => rwnExpr(qq.qqSubject, w, sc, n)
    |> (sv) => (sv, rwnExpr(qq.qqFallback, w, sc, sv.rneN))
    |> (sv, fv) => RwNE(fv.rneN, PeCoalesce(sv.rneExpr, fv.rneExpr,
                                            qq.peqqLine))
  (wx: PeWith)   => rwnExpr(wx.withSubject, w, sc, n)
    |> (sv) => (sv, rwnExpr(wx.withRepls, w, sc, sv.rneN))
    |> (sv, rv) => RwNE(rv.rneN, PeWith(sv.rneExpr, rv.rneExpr,
                                        wx.pewLine))
  (ne: PeNewEnum) => rwnFieldArgs(ne.fieldArgs, w, sc, n, List())
    |> (fas) => RwNE(fas.rnfN, PeNewEnum(ne.rootName, ne.leafName,
                                         fas.rnfArgs, ne.neTypeParams,
                                         ne.penewLine))
  # Python's order: body, then params (loop.py).
  (lp: PeLoop)   => rwnExpr(lp.loopBody, w, sc, n)
    |> (b) => (b, rwnExprs(lp.loopParams, w, sc, b.rneN, List()))
    |> (b, ps) => RwNE(ps.rnesN, PeLoop(b.rneExpr, ps.rnesExprs,
                                        lp.pelpLine))
  (rc: PeRecur)  => rwnExprs(rc.recArgs, w, sc, n, List())
    |> (as3) => RwNE(as3.rnesN, PeRecur(as3.rnesExprs, rc.recIndex,
                                        rc.percLine))
  (lz: PeLazy)   => RwNE(n, x)   # target type carries no counter work
  (o: PeLiteral) => RwNE(n, x)
  (o: PeName) => RwNE(n, x)

class [final] RwNFas(rnfN: Int, rnfArgs: List<PFieldArg>)

fun rwnFieldArgs(fas: List<PFieldArg>, w: RwN, sc, n, acc) =>
  fold(fas, (n = n, acc = acc), (st, x) => rwnFieldArgsStep(st, x, w, sc))
    |> (r) => RwNFas(r.n, r.acc)

fun rwnFieldArgsStep(st: (n: Int, acc: List<PFieldArg>), x: PFieldArg, w: RwN, sc) =>
  rwnExpr(x.faValue, w, sc, st.n)
  |> (v) => (n = v.rneN, acc = append(st.acc, PFieldArg(x.faName, v.rneExpr)))

fun rwnExprs(es: List<PExpr>, w: RwN, sc, n, acc) =>
  fold(es, (n = n, acc = acc), (st, x) => rwnExprsStep(st, x, w, sc))
    |> (r) => RwNEs(r.n, r.acc)

fun rwnExprsStep(st: (n: Int, acc: List<PExpr>), x: PExpr, w: RwN, sc) =>
  rwnExpr(x, w, sc, st.n)
  |> (o) => (n = o.rneN, acc = append(st.acc, o.rneExpr))

fun rwnTupEnts(es: List<PTupEnt>, w: RwN, sc, n, acc) =>
  fold(es, (n = n, acc = acc), (st, x) => rwnTupEntsStep(st, x, w, sc))
    |> (r) => RwNTs(r.n, r.acc)

fun rwnTupEntsStep(st: (n: Int, acc: List<PTupEnt>), x: PTupEnt, w: RwN, sc) =>
  rwnExpr(x.tupValue, w, sc, st.n)
  |> (o) => (n = o.rneN, acc = append(st.acc, PTupEnt(x.tupName, x.tupSpread, o.rneExpr)))

# An arm's body and guard see its binding; its literals see the match's scope.
fun rwnArms(as2: List<PArm>, w: RwN, sc, n, acc) =>
  fold(as2, (n = n, acc = acc), (st, x) => rwnArmsStep(st, x, w, sc))
    |> (r) => RwNAs(r.n, r.acc)

fun rwnArmsStep(st: (n: Int, acc: List<PArm>), x: PArm, w: RwN, sc) =>
  rwnExpr(x.armBody, w, rwnArmScope(x, sc), st.n)
  |> (b) => (b, rwnLits(x.armLiterals, w, sc, b.rneN, List()))
    |> (b, ls) => (b, ls, rwnExprOpt(x.armGuard, w, rwnArmScope(x, sc), ls.rnlsN))
      |> (b, ls, gd) => (n = gd.rneN2,
        acc = append(st.acc,
            with x(armBody = b.rneExpr, armLiterals = ls.rnlsLits, armGuard = gd.rneExpr2)))

class [final] RwNLs(rnlsN: Int, rnlsLits: List<PLit>)

fun rwnLits(ls: List<PLit>, w: RwN, sc, n, acc) =>
  fold(ls, (n = n, acc = acc), (st, x) => rwnLitsStep(st, x, w, sc))
    |> (r) => RwNLs(r.n, r.acc)

fun rwnLitsStep(st: (n: Int, acc: List<PLit>), x: PLit, w: RwN, sc) => match(x)
  (le: PlExpr) => rwnExpr(le.litExpr, w, sc, st.n)
    |> (o) => (n = o.rneN, acc = append(st.acc, PlExpr(o.rneExpr)))
  (lr: PlRange) => rwnExpr(lr.rangeLo, w, sc, st.n)
    |> (lo) => (lo, rwnExpr(lr.rangeHi, w, sc, lo.rneN))
      |> (lo, hi) => (n = hi.rneN,
        acc = append(st.acc,
            PlRange(lo.rneExpr, hi.rneExpr,
                    lr.plrLine)))

# ── foldAllSpecs: a BOTTOM-UP spec fold over the whole tree ──────────────────
# Mirrors rwStmt/rwExprKids/rwSpecKids' traversal and visit sets EXACTLY, but
# fires the callback on each SPEC in the same order Python's search_and_replace
# `replace` fires (children before parents) — encounter-order consumers
# (discriminator-id assignment) depend on that order, which the PRE-order fold
# twins above deliberately do not provide.

fun foldAllSpecs<T>(ss: List<PStmt>, f: (:T, :Spec): T, acc: T): T => fasStmts(ss, f, acc)

fun fasStmts<T>(ss: List<PStmt>, f: (:T, :Spec): T, acc: T): T =>
  fold(ss, acc, (a, x) => fasStmt(x, f, a))

# Every walk below visits a node's parts in the order Python's
# search_and_replace does: collect_discriminator_ids numbers union members in
# the order they are first met, so the order is observable in the C.
fun fasStmt<T>(st, f: (:T, :Spec): T, acc: T): T => match(st)
  (f2: PsFun) => fasSpecs(f2.fWheres, f,
                   fasSpecOpt(f2.fRet, f,
                     fasExprOpt(f2.fBody, f,
                       fasStmt(f2.fParams, f, acc))))
  (l: PsLet)  => fasSpecOpt(l.lType, f, fasExprOpt(l.lDefault, f, acc))
  (d: PsDestructure) => fasStmts(d.dTargets, f,
                          fasSpecOpt(d.dType, f,
                            fasExprOpt(d.dDefault, f, acc)))
  (c: PsClass) => fasSpecsOpt(c.cAllParents, f,
                    fasSpecs(c.cWheres, f,
                      fasSpecs(c.cImplements, f,
                        fasStmts(c.cMembers, f,
                          fasStmt(c.cParams, f, acc)))))
  (e2: PsEnum) => fasSpecOpt(e2.eSpec, f,
                    fasStmts(e2.eVariants, f,
                      fasStmt(e2.eParams, f, acc)))
  (ta: PsTypealias) => fasSpec(ta.taType, f, acc)
  (rt: PsRet)  => fasExpr(rt.retValue, f, acc)
  (a: PsAction) => fasExpr(a.action, f, acc)
  (fa: PsFieldAssign) => fasExpr(fa.faValue, f, fasExpr(fa.faTarget, f, acc))
  (i: PsIf)    => fasStmts(i.ifFalse, f,
                    fasStmts(i.ifTrue, f,
                      fasExpr(i.ifCond, f, acc)))
  (o: PStmt)   => acc

fun fasExprOpt<T>(x: PExpr|None, f: (:T, :Spec): T, acc: T): T => match(x)
  (e2: PExpr) => fasExpr(e2, f, acc)
  ()           => acc

fun fasExprs<T>(es: List<PExpr>, f: (:T, :Spec): T, acc: T): T =>
  fold(es, acc, (a, x) => fasExpr(x, f, a))

fun fasExpr<T>(x, f: (:T, :Spec): T, acc: T): T => match(x)
  (nm: PeName)    => fasTrait(nm.penTrait, f, fasSpecs(nm.refTypeParams, f, acc))
  (d: PeDot)      => fasExpr(d.base, f, acc)
  (c: PeCall)     => fasExpr(c.parameter, f, fasExpr(c.function, f, acc))
  (tp: PeTuple)   => fasTupEnts(tp.exprs, f, acc)
  (te: PeTernary) => fasExpr(te.falseResult, f,
                       fasExpr(te.trueResult, f,
                         fasExpr(te.condition, f, acc)))
  (ps: PePinSet)  => fasExpr(ps.psValue, f,
                       fasExpr(ps.psTarget, f,
                         fasExpr(ps.psSubject, f, acc)))
  (lm: PeLambda)  => fasSpecOpt(lm.lamRet, f,
                       fasExpr(lm.lamBody, f,
                         fasStmt(lm.lamParams, f, acc)))
  (bk: PeBlock)   => fasExpr(bk.blockValue, f, fasStmts(bk.blockStmts, f, acc))
  (mt: PeMatch)   => fasExprs(mt.matchExtra, f,
                             fasArms(mt.arms, f,
                                     fasExpr(mt.subject, f, acc)))
  (op: PeBuiltinOp) => fasExpr(op.opParams, f, fasSpec(op.opType, f, acc))
  (nw: PeNew)     => fasExpr(nw.newParam, f, fasSpec(nw.newType, f, acc))
  (ne: PeNewEnum) => fasSpecs(ne.neTypeParams, f,
                              fold(ne.fieldArgs, acc, (a2, fa) =>
                                fasExpr(fa.faValue, f, a2)))
  (ar: PeArrayRead) => fasExpr(ar.arrIndex, f, fasExpr(ar.arrObj, f, acc))
  (cv: PeConvert) => fasSpec(cv.convTarget, f, fasExpr(cv.convInner, f, acc))
  (qq: PeCoalesce) => fasExpr(qq.qqFallback, f, fasExpr(qq.qqSubject, f, acc))
  (wx: PeWith)   => fasExpr(wx.withRepls, f, fasExpr(wx.withSubject, f, acc))
  (lp: PeLoop)    => fasExprs(lp.loopParams, f, fasExpr(lp.loopBody, f, acc))
  (rc: PeRecur)   => fasExprs(rc.recArgs, f, acc)
  (lz: PeLazy)    => fasSpec(lz.lzTarget, f, acc)
  (o: PeLiteral) => acc

fun fasTrait<T>(sp: Spec|None, f: (:T, :Spec): T, acc: T): T => fasSpecOpt(sp, f, acc)

fun fasTupEnts<T>(es: List<PTupEnt>, f: (:T, :Spec): T, acc: T): T =>
  fold(es, acc, (a, x) => fasExpr(x.tupValue, f, a))

fun fasArms<T>(as2: List<PArm>, f: (:T, :Spec): T, acc: T): T =>
  fold(as2, acc, (a, x) => fasPositions(x.armExtra, f,
        fasExprOpt(x.armGuard, f,
          fasLits(x.armLiterals, f,
            fasSpecOpt(x.armType, f,
              fasExpr(x.armBody, f, a))))))

fun fasPositions<T>(ps: List<PPos>, f: (:T, :Spec): T, acc: T): T =>
  fold(ps, acc, (a, x) => fasSpecOpt(x.posType, f, a))

fun fasLits<T>(ls: List<PLit>, f: (:T, :Spec): T, acc: T): T =>
  fold(ls, acc, (a, x) => fasLit(x, f, a))

fun fasLit<T>(lt, f: (:T, :Spec): T, acc: T): T => match(lt)
  (le: PlExpr)  => fasExpr(le.litExpr, f, acc)
  (lr: PlRange) => fasExpr(lr.rangeHi, f, fasExpr(lr.rangeLo, f, acc))

# Specs: kids first (bottom-up), then the node itself.
fun fasSpec<T>(sp, f: (:T, :Spec): T, acc: T): T => f(fasSpecKids(sp, f, acc), sp)

fun fasSpecOpt<T>(sp: Spec|None, f: (:T, :Spec): T, acc: T): T => match(sp)
  (s2: Spec) => fasSpec(s2, f, acc)
  ()          => acc

fun fasSpecs<T>(ts: List<Spec>, f: (:T, :Spec): T, acc: T): T =>
  fold(ts, acc, (a, x) => fasSpec(x, f, a))

fun fasSpecsOpt<T>(ss: List<Spec>|None, f: (:T, :Spec): T, acc: T): T => match(ss)
  (l: List<Spec>) => fasSpecs(l, f, acc)
  ()               => acc

fun fasSpecKids<T>(sp, f: (:T, :Spec): T, acc: T): T => match(sp)
  (e2: SEnum)        => fasSpecs(e2.seParams, f, acc)
  (cl: SClass)       => fasSpecs(cl.scParams, f, acc)
  (n: SNamed)        => acc   # traversal LEAF
  (cm: SCombination) => fasSpecs(cm.scTypes, f, acc)
  (t2: STuple)       => fasEntries(t2.stEntries, f, acc)
  (cb: SCallable)    => fasSpecOpt(cb.scResult, f, fasSpec(cb.scParams2, f, acc))
  (af: SArrayField)  => fasSpec(af.safElem, f, acc)
  (ls: SLazyStub)    => fasSpecOpt(ls.slsTarget, f, acc)
  (o: Spec)          => acc

fun fasEntries<T>(es: List<SEntry>, f: (:T, :Spec): T, acc: T): T =>
  fold(es, acc, (a, x) => fasExprOpt(x.seDefault, f, fasSpecOpt(x.seType, f, a)))


# A field assignment numbers its target, then its value from where the target
# left off; both come back in the one node.
fun rwnFieldAssignValue(fa: PsFieldAssign, t1: RwNE, w: RwN, sc)
  ret rwnExpr(fa.faValue, w, sc, t1.rneN)
    |> (v) => RwNS(v.rneN, PsFieldAssign(t1.rneExpr, v.rneExpr, fa.psfaLine))
