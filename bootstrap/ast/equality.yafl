# bootstrap/equality.yafl — structural equality over the AST.
#
# The compile fixpoint terminates when a whole pass rewrites nothing:
# `newStatements == statements`. Python gets that test free from dataclass
# `__eq__`; YAFL derives nothing, so it is written out here — and it must
# honour Python's equality EXCLUSIONS exactly, or the loop either spins
# forever (comparing metadata that never settles) or stops early (missing a
# change that matters):
#
#   * every Spec ignores its line_ref — two spellings of the same type ARE
#     the same type, wherever they were written;
#   * an SEnum further ignores seParams (best-effort metadata) and would
#     ignore all_fields/is_complex if we carried them;
#   * expressions and statements DO compare their line refs (a node that
#     moved is a different node), but ignore the derived caches: a name's
#     resolved trait scope, and the `inferred` flags on fun/let/destructure.
namespace Bootstrap::Ast

import System
import System::Containers

import Bootstrap::Codegen
import Bootstrap::Frontend
import Bootstrap::Parse
import Bootstrap::Resolve



# ── types ───────────────────────────────────────────────────────────────────

fun eqSpecOpt(a: Spec|None, b: Spec|None) => match(a, b)
  (x: Spec, y: Spec) => eqSpec(x, y)
  (_: None, _: None) => true
  ()                 => false

fun eqSpec(a: Spec, b: Spec) => match(a, b)
  (x: SBuiltin, y: SBuiltin)         => x.sbName == y.sbName
  (x: SNamed, y: SNamed)             => x.snName == y.snName && eqSpecs(x.snParams, y.snParams)
  (x: SClass, y: SClass)             => x.scName == y.scName && eqSpecs(x.scParams, y.scParams)
  # seParams ARE identity (identity vs state, user ruling): a complete
  # spec's identity is its name plus ALL its type arguments. The family
  # question (same root, params aside) is asked by NAME where it is meant
  # — never through equality.
  (x: SEnum, y: SEnum)               => x.seRoot == y.seRoot
                                        && eqStrs(x.seValidLeaves, y.seValidLeaves)
                                        && eqStrs(x.seAllLeaves, y.seAllLeaves)
                                        && eqSpecs(x.seParams, y.seParams)
                                        && eqStrs(x.sePath, y.sePath)
  (x: SGeneric, y: SGeneric)         => x.sgName == y.sgName && eqBool(x.sgLinear, y.sgLinear)
  (x: SCallable, y: SCallable)       => eqSpec(x.scParams2, y.scParams2)
                                        && eqSpecOpt(x.scResult, y.scResult)
  (x: SCombination, y: SCombination) => eqSpecs(x.scTypes, y.scTypes)
  (x: STuple, y: STuple)             => eqEntries(x.stEntries, y.stEntries)
  (x: SArrayField, y: SArrayField)   => x.safLenField == y.safLenField
                                        && eqSpec(x.safElem, y.safElem)
  (x: SLazyStub, y: SLazyStub)       => eqSpecOpt(x.slsTarget, y.slsTarget)
  ()                                 => false

fun eqEntry(a: SEntry, b: SEntry) => a.seName == b.seName
    && eqSpecOpt(a.seType, b.seType)
    && eqExprOpt(a.seDefault, b.seDefault)

# ── expressions ─────────────────────────────────────────────────────────────

fun eqExprOpt(a: PExpr|None, b: PExpr|None) => match(a, b)
  (x: PExpr, y: PExpr) => eqExpr(x, y)
  (_: None, _: None)   => true
  ()                   => false

fun eqIndex(a: Int|None, b: Int|None): Bool => match(a, b)
  (x: Int,  y: Int)  => x == y
  (x: None, y: None) => true
  ()                 => false

fun eqExpr(a: PExpr, b: PExpr) => match(a, b)
  (x: PeInt, y: PeInt)             => x.value == y.value && x.precision == y.precision
                                      && eqLine(x.peiLine, y.peiLine)
  (x: PeFloat, y: PeFloat)         => x.floatText == y.floatText && x.fPrecision == y.fPrecision
                                      && eqLine(x.pefLine, y.pefLine)
  (x: PeBool, y: PeBool)           => eqBool(x.boolValue, y.boolValue) && eqLine(x.pebLine, y.pebLine)
  (x: PeStr, y: PeStr)             => x.strValue == y.strValue && eqLine(x.pesLine, y.pesLine)
  (x: PeRegex, y: PeRegex)         => x.pattern == y.pattern && eqLine(x.perLine, y.perLine)
  # resolvedTraitScope is a derived cache — excluded, as in Python.
  (x: PeName, y: PeName)           => x.refName == y.refName
                                      && eqSpecs(x.refTypeParams, y.refTypeParams)
                                      && eqLine(x.penLine, y.penLine)
  (x: PeDot, y: PeDot)             => x.member == y.member && eqExpr(x.base, y.base)
                                      && eqLine(x.pedLine, y.pedLine)
                                      && eqIndex(x.pedIndex, y.pedIndex)
  (x: PeCall, y: PeCall)           => eqExpr(x.function, y.function)
                                      && eqExpr(x.parameter, y.parameter)
                                      && eqLine(x.pecLine, y.pecLine)
  (x: PeTuple, y: PeTuple)         => eqTupEnts(x.exprs, y.exprs) && eqLine(x.petLine, y.petLine)
  (x: PeTernary, y: PeTernary)     => eqExpr(x.condition, y.condition)
                                      && eqExpr(x.trueResult, y.trueResult)
                                      && eqExpr(x.falseResult, y.falseResult)
                                      && eqLine(x.pety, y.pety)
  (x: PeLambda, y: PeLambda)       => eqStmt(x.lamParams, y.lamParams)
                                      && eqExpr(x.lamBody, y.lamBody)
                                      && eqLine(x.pelLine, y.pelLine)
                                      && eqSpecOpt(x.lamRet, y.lamRet)
  (x: PeBlock, y: PeBlock)         => x.blockTag == y.blockTag
                                      && eqStmts(x.blockStmts, y.blockStmts)
                                      && eqExpr(x.blockValue, y.blockValue)
                                      && eqLine(x.pebkLine, y.pebkLine)
  (x: PeMatch, y: PeMatch)         => eqExpr(x.subject, y.subject) && eqArms(x.arms, y.arms)
                                      && eqLine(x.pemLine, y.pemLine)
  (x: PeBuiltinOp, y: PeBuiltinOp) => eqSpec(x.opType, y.opType)
                                      && eqExpr(x.opName, y.opName)
                                      && eqExpr(x.opParams, y.opParams)
                                      && eqLine(x.peboLine, y.peboLine)
  (x: PePinSet, y: PePinSet)       => eqExpr(x.psSubject, y.psSubject)
                                      && eqExpr(x.psTarget, y.psTarget)
                                      && eqExpr(x.psValue, y.psValue)
                                      && eqLine(x.pepsLine, y.pepsLine)
  (x: PeNothing, y: PeNothing)     => eqLine(x.pengLine, y.pengLine)
  (x: PeNewEnum, y: PeNewEnum)     => x.rootName == y.rootName && x.leafName == y.leafName
                                      && eqFieldArgs(x.fieldArgs, y.fieldArgs)
                                      && eqSpecs(x.neTypeParams, y.neTypeParams)
                                      && eqLine(x.penewLine, y.penewLine)
  (x: PeNew, y: PeNew)             => eqSpec(x.newType, y.newType)
                                      && eqExpr(x.newParam, y.newParam)
                                      && eqLine(x.penwLine, y.penwLine)
  (x: PeArrayRead, y: PeArrayRead) => eqExpr(x.arrObj, y.arrObj)
                                      && eqExpr(x.arrIndex, y.arrIndex)
                                      && eqLine(x.pearLine, y.pearLine)
  (x: PeWith, y: PeWith)           => eqExpr(x.withSubject, y.withSubject)
                                      && eqExpr(x.withRepls, y.withRepls)
                                      && eqLine(x.pewLine, y.pewLine)
  (x: PeConvert, y: PeConvert)     => eqSpec(x.convTarget, y.convTarget)
                                      && eqExpr(x.convInner, y.convInner)
                                      && eqLine(x.pecvLine, y.pecvLine)
  (x: PeCoalesce, y: PeCoalesce)   => eqExpr(x.qqSubject, y.qqSubject)
                                      && eqExpr(x.qqFallback, y.qqFallback)
                                      && eqLine(x.peqqLine, y.peqqLine)
  (x: PePipe, y: PePipe)           => eqExpr(x.pipeSubject, y.pipeSubject)
                                      && eqExpr(x.pipeStage, y.pipeStage)
                                      && eqLine(x.pepiLine, y.pepiLine)
  (x: PeLoop, y: PeLoop)           => eqExpr(x.loopBody, y.loopBody)
                                      && eqExprs(x.loopParams, y.loopParams)
                                      && eqLine(x.pelpLine, y.pelpLine)
  (x: PeRecur, y: PeRecur)         => x.recIndex == y.recIndex
                                      && eqExprs(x.recArgs, y.recArgs)
                                      && eqLine(x.percLine, y.percLine)
  (x: PeLazy, y: PeLazy)           => x.stubName == y.stubName
                                      && eqSpec(x.lzTarget, y.lzTarget)
                                      && eqStrOpt(x.lzCaptured, y.lzCaptured)
                                      && eqBool(x.lzStubOnly, y.lzStubOnly)
                                      && eqLine(x.pelzLine, y.pelzLine)
  ()                               => false

fun eqTupEnt(a: PTupEnt, b: PTupEnt) => a.tupName == b.tupName && eqBool(a.tupSpread, b.tupSpread)
    && eqExpr(a.tupValue, b.tupValue)

fun eqArm(a: PArm, b: PArm) => a.armName == b.armName
    && eqSpecOpt(a.armType, b.armType)
    && eqLits(a.armLiterals, b.armLiterals)
    && eqExprOpt(a.armGuard, b.armGuard)
    && eqExpr(a.armBody, b.armBody)
    && eqLine(a.parmLine, b.parmLine)

fun eqLit(a: PLit, b: PLit) => match(a, b)
  (x: PlExpr, y: PlExpr)   => eqExpr(x.litExpr, y.litExpr)
  (x: PlRange, y: PlRange) => eqExpr(x.rangeLo, y.rangeLo)
                              && eqExpr(x.rangeHi, y.rangeHi)
                              && eqLine(x.plrLine, y.plrLine)
  ()                       => false

fun eqAttr(a: PAttr, b: PAttr) => a.attrName == b.attrName && eqExprOpt(a.attrValue, b.attrValue)

fun eqGen(a: PGen, b: PGen) => a.genName == b.genName && eqAttrs(a.genAttrs, b.genAttrs)
    && eqLine(a.pgLine, b.pgLine)

# `==` has no Bool instance in the stdlib, and YAFL derives nothing.
fun eqBool(a, b) => a ? b : !b

fun eqLine(a: PLine, b: PLine) => a.plLine == b.plLine && a.plCol == b.plCol && a.plFile == b.plFile

# ── statements ──────────────────────────────────────────────────────────────
# The `inferred` flags and the enum's cached root/spec are derived caches —
# excluded here exactly as Python excludes them.

fun eqStmt(a: PStmt, b: PStmt) => match(a, b)
  (x: PsFun, y: PsFun)                     => x.fName == y.fName
                                              && eqAttrs(x.fAttrs, y.fAttrs)
                                              && eqGens(x.fGens, y.fGens)
                                              && eqStmt(x.fParams, y.fParams)
                                              && eqSpecOpt(x.fRet, y.fRet)
                                              && eqSpecs(x.fWheres, y.fWheres)
                                              && eqExprOpt(x.fBody, y.fBody)
                                              && eqLine(x.psfLine, y.psfLine)
                                              # is_nested is NOT excluded in Python — the mark must
                                              # settle for the fixpoint to see it settle.
                                              && eqBool(x.fNested, y.fNested)
                                              && eqStmtsOpt(x.fImports, y.fImports)
  (x: PsLet, y: PsLet)                     => x.lName == y.lName && x.lArrayLen == y.lArrayLen
                                              && eqAttrs(x.lAttrs, y.lAttrs)
                                              && eqGens(x.lGens, y.lGens)
                                              && eqSpecOpt(x.lType, y.lType)
                                              && eqExprOpt(x.lDefault, y.lDefault)
                                              && eqSpecs(x.lWheres, y.lWheres)
                                              && eqLine(x.pslLine, y.pslLine)
                                              && eqStmtsOpt(x.lImports, y.lImports)
  (x: PsDestructure, y: PsDestructure)     => x.dName == y.dName
                                              && eqAttrs(x.dAttrs, y.dAttrs)
                                              && eqStmts(x.dTargets, y.dTargets)
                                              && eqSpecOpt(x.dType, y.dType)
                                              && eqExprOpt(x.dDefault, y.dDefault)
                                              && eqLine(x.psdLine, y.psdLine)
  (x: PsClass, y: PsClass)                 => x.cName == y.cName && eqBool(x.cIsInterface, y.cIsInterface)
                                              && eqAttrs(x.cAttrs, y.cAttrs)
                                              && eqGens(x.cGens, y.cGens)
                                              && eqStmt(x.cParams, y.cParams)
                                              && eqSpecs(x.cImplements, y.cImplements)
                                              && eqSpecs(x.cWheres, y.cWheres)
                                              && eqStmts(x.cMembers, y.cMembers)
                                              && eqLine(x.pscLine, y.pscLine)
                                              # _all_parents / _all_slots are NOT excluded in Python
                                              # (no compare=False): the fixpoint runs until the
                                              # tables settle. Parents and provides are SETS —
                                              # compared order-free.
                                              && eqSpecSetOpt(x.cAllParents, y.cAllParents)
                                              && eqSlotsOpt(x.cAllSlots, y.cAllSlots)
                                              && eqStmtsOpt(x.cImports, y.cImports)
  (x: PsEnum, y: PsEnum)                   => x.eName == y.eName
                                              && eqAttrs(x.eAttrs, y.eAttrs)
                                              && eqGens(x.eGens, y.eGens)
                                              && eqStmt(x.eParams, y.eParams)
                                              && eqStmts(x.eVariants, y.eVariants)
                                              && eqBool(x.eHasParams, y.eHasParams)
                                              && eqLine(x.pseLine, y.pseLine)
                                              && eqStmtsOpt(x.eImports, y.eImports)
  (x: PsTypealias, y: PsTypealias)         => x.taName == y.taName
                                              && eqAttrs(x.taAttrs, y.taAttrs)
                                              && eqGens(x.taGens, y.taGens)
                                              && eqSpec(x.taType, y.taType)
                                              && eqSpecs(x.taWheres, y.taWheres)
                                              && eqLine(x.pstLine, y.pstLine)
                                              && eqStmtsOpt(x.taImports, y.taImports)
  (x: PsImport, y: PsImport)               => x.importPath == y.importPath
                                              && eqLine(x.psiLine, y.psiLine)
  (x: PsNamespace, y: PsNamespace)         => x.nsPath == y.nsPath && eqLine(x.psnLine, y.psnLine)
  (x: PsTraitInstance, y: PsTraitInstance) => x.tiName == y.tiName
                                              && eqAttrs(x.tiAttrs, y.tiAttrs)
                                              && eqBool(x.tiAmbient, y.tiAmbient)
                                              && eqGens(x.tiGens, y.tiGens)
                                              && eqSpec(x.tiPattern, y.tiPattern)
                                              && eqSpecs(x.tiWheres, y.tiWheres)
                                              && eqStmts(x.tiMembers, y.tiMembers)
                                              && eqLine(x.pstiLine, y.pstiLine)
  (x: PsRet, y: PsRet)                     => x.retIndex == y.retIndex
                                                && eqExpr(x.retValue, y.retValue) && eqLine(x.psrLine, y.psrLine)
  (x: PsIf, y: PsIf)                       => eqExpr(x.ifCond, y.ifCond)
                                              && eqStmts(x.ifTrue, y.ifTrue)
                                              && eqStmts(x.ifFalse, y.ifFalse)
                                              && eqLine(x.psifLine, y.psifLine)
  (x: PsElseIf, y: PsElseIf)               => eqExpr(x.eiCond, y.eiCond)
                                              && eqStmts(x.eiStmts, y.eiStmts)
                                              && eqLine(x.pseiLine, y.pseiLine)
  (x: PsElse, y: PsElse)                   => eqStmts(x.elStmts, y.elStmts)
                                              && eqLine(x.pselLine, y.pselLine)
  (x: PsAction, y: PsAction)               => eqExpr(x.action, y.action) && eqLine(x.psaLine, y.psaLine)
  (x: PsFieldAssign, y: PsFieldAssign)     => eqExpr(x.faTarget, y.faTarget) && eqExpr(x.faValue, y.faValue)
                                              && eqLine(x.psfaLine, y.psfaLine)
  ()                                       => false

# ── lists ───────────────────────────────────────────────────────────────────
# One walk per element type: a generic `eqList` would need a function
# parameter, and the element types are few enough that spelling them out is
# both clearer and safe from the generic-lambda instantiation gap.

fun eqStrOpt(a: String|None, b: String|None) => match(a, b)
  (x: String, y: String) => x == y
  (_: None, _: None)     => true
  ()                     => false

# Python's field_args dict equality: same keys in order AND equal value exprs.
fun eqFieldArgs(a: List<PFieldArg>, b: List<PFieldArg>)
  ret eqBy(a, b, (x, y) =>
        x.faName == y.faName && eqExpr(x.faValue, y.faValue))

fun eqStrs(a: List<String>, b: List<String>) => eqBy(a, b, (x, y) => x == y)

fun eqSpecs(a: List<Spec>, b: List<Spec>) => eqBy(a, b, eqSpec)

fun eqEntries(a: List<SEntry>, b: List<SEntry>) => eqBy(a, b, eqEntry)

fun eqExprs(a: List<PExpr>, b: List<PExpr>) => eqBy(a, b, eqExpr)

fun eqStmts(a: List<PStmt>, b: List<PStmt>) => eqBy(a, b, eqStmt)

fun eqTupEnts(a: List<PTupEnt>, b: List<PTupEnt>) => eqBy(a, b, eqTupEnt)

fun eqArms(a: List<PArm>, b: List<PArm>) => eqBy(a, b, eqArm)

fun eqLits(a: List<PLit>, b: List<PLit>) => eqBy(a, b, eqLit)

fun eqAttrs(a: List<PAttr>, b: List<PAttr>) => eqBy(a, b, eqAttr)

fun eqGens(a: List<PGen>, b: List<PGen>) => eqBy(a, b, eqGen)

# ── set-wise comparisons ─────────────────────────────────────────────────────
# Python holds _all_parents and a slot's provides as SETS: equality is mutual
# membership, order-free — the direct spelling of frozenset equality, with no
# size guard (the no-length ruling; lengths are never calculated).

fun eqSpecSetOpt(a: List<Spec>|None, b: List<Spec>|None) => match(a, b)
  (x: List<Spec>, y: List<Spec>) => eqSpecSet(x, y)
  (_: None, _: None)             => true
  ()                             => false

fun eqSpecSet(a: List<Spec>, b: List<Spec>) => specsSubset(a, b) && specsSubset(b, a)

fun specsSubset(xs: List<Spec>, ys: List<Spec>) => all(xs, (x) => containsSpec(ys, x))

fun eqStrSet(a: List<String>, b: List<String>) => strsSubset(a, b) && strsSubset(b, a)

fun strsSubset(xs: List<String>, ys: List<String>) => all(xs, (x) => contains(ys, x))

fun eqSlotsOpt(a: List<Slot>|None, b: List<Slot>|None) => match(a, b)
  (x: List<Slot>, y: List<Slot>) => eqSlots(x, y)
  (_: None, _: None)             => true
  ()                             => false

# The slot LIST is ordered (own slots first, surviving parent slots after);
# each slot's provides is a set.
fun eqSlots(a: List<Slot>, b: List<Slot>) => eqBy(a, b, eqSlot)

fun eqSlot(a: Slot, b: Slot) => a.slotName == b.slotName
    && eqSpecOpt(a.slotType, b.slotType)
    && eqStrSet(a.slotProvides, b.slotProvides)

fun eqStmtsOpt(a: List<PStmt>|None, b: List<PStmt>|None) => match(a, b)
  (x: List<PStmt>, y: List<PStmt>) => eqStmts(x, y)
  (_: None, _: None)               => true
  ()                               => false
