namespace Bootstrap

import System

# bootstrap/ops.yafl — port of compiler/codegen/ops.py: the per-instruction
# IR (`Op`), one tagged union of C-emission instructions.
#
# NAMING: variants are "Op"-prefixed (OpLabel, OpMove, ...) — plain "Label"/
# "Move"/"Call"/"Return" are free in this namespace today, but prefixing
# keeps this tree visually distinct from RParam's "Rp" tree and typedecl's
# "Cg" tree, and matches the Pe/Ps/Rp/Cg convention used throughout.
#
# FIELD PREFIXES: every field is uniquely prefixed per variant (matching
# nodes.yafl's house style) — including `savedVars`, so there is no relied-on
# "covering field" resolution; every read narrows via match first.
#
# `saved_vars` (Python: a kw-only frozenset[StackVar] field on the shared Op
# base, default empty) becomes an explicit `<prefix>SavedVars: List<RParam>`
# field on every variant — constructor calls are not legal defaults in YAFL,
# so every construction site must pass it explicitly (usually `List<RParam>()`).
#
# LParam-typed Python fields (Move.target, IfTask.task_lhs/call_id_lhs,
# NewObject.register, Call.register, Phi.target) are typed `RParam` here —
# see the note at the top of param.yafl; callers must only ever install
# RpStackVar/RpGlobalVar/RpObjectField there.

enum Op
  enum OpLabel(labelName: String, labelSavedVars: List<RParam>)
  enum OpMove(moveTarget: RParam, moveSource: RParam, moveKeep: Bool, moveSavedVars: List<RParam>)
  enum OpJump(jumpName: String, jumpSavedVars: List<RParam>)
  enum OpJumpIf(jumpIfLabel: String, jumpIfCondition: RParam, jumpIfInvert: Bool, jumpIfSavedVars: List<RParam>)
  enum OpIfTask(taskCondition: RParam, taskSource: RParam, taskLhs: RParam, callIdLhs: RParam, callId: Int, taskTarget: String, taskSavedVars: List<RParam>)
  enum OpSwitchJump(switchCondition: RParam, switchCases: List<OpCase>, switchSavedVars: List<RParam>)
  enum OpNewObject(newObjName: String, newObjRegister: RParam, newObjSize: RParam|None, newObjSavedVars: List<RParam>)
  enum OpCall(callFunction: RParam, callParameters: RParam, callRegister: RParam|None, callMusttail: Bool, callImpure: Bool, callResultType: CgType|None, callSavedVars: List<RParam>)
  enum OpReturnVoid(retVoidSavedVars: List<RParam>)
  enum OpAbort(abortReason: String, abortSavedVars: List<RParam>)
  enum OpReturn(returnValue: RParam, returnSavedVars: List<RParam>)
  enum OpParallelCall(parCalls: List<RParam>, parResults: List<RParam>, parRegister: RParam|None, parSavedVars: List<RParam>)
  enum OpPhi(phiTarget: RParam, phiSources: List<OpPhiSource>, phiSavedVars: List<RParam>)

class [final] OpCase(caseValue: Int, caseLabel: String)
class [final] OpPhiSource(sourceLabel: String, sourceValue: RParam)

fun opSavedVars(op: Op): List<RParam>
  ret match(op)
    (x: OpLabel) => x.labelSavedVars
    (x: OpMove) => x.moveSavedVars
    (x: OpJump) => x.jumpSavedVars
    (x: OpJumpIf) => x.jumpIfSavedVars
    (x: OpIfTask) => x.taskSavedVars
    (x: OpSwitchJump) => x.switchSavedVars
    (x: OpNewObject) => x.newObjSavedVars
    (x: OpCall) => x.callSavedVars
    (x: OpReturnVoid) => x.retVoidSavedVars
    (x: OpAbort) => x.abortSavedVars
    (x: OpReturn) => x.returnSavedVars
    (x: OpParallelCall) => x.parSavedVars
    (x: OpPhi) => x.phiSavedVars

# ── test_params(predicate) ───────────────────────────────────────────────────

fun opTestParams(op: Op, pred: (:RParam): Bool): Bool
  ret match(op)
    (x: OpMove) => pred(x.moveTarget) || pred(x.moveSource)
    (x: OpJumpIf) => pred(x.jumpIfCondition)
    (x: OpIfTask) => pred(x.taskCondition) || pred(x.taskSource)
    (x: OpSwitchJump) => pred(x.switchCondition)
    (x: OpCall) => opTestParamsCall(x, pred)
    (x: OpReturn) => pred(x.returnValue)
    (o: Op) => false   # base default: False (Label/Jump/NewObject/ReturnVoid/Abort/ParallelCall/Phi don't override)

fun opTestParamsCall(x: OpCall, pred: (:RParam): Bool): Bool
  ret pred(x.callFunction) || pred(x.callParameters) || opTestParamsCallRegister(x.callRegister, pred)

fun opTestParamsCallRegister(register: RParam|None, pred: (:RParam): Bool): Bool
  ret match(register)
    (r: RParam) => pred(r)
    ()          => false

# ── all_params() ─────────────────────────────────────────────────────────────

fun opAllParams(op: Op): List<RParam>
  ret match(op)
    (x: OpMove) => concat<RParam>(rpFlatten(x.moveTarget, false), rpFlatten(x.moveSource, true))
    (x: OpJumpIf) => rpFlatten(x.jumpIfCondition, true)
    (x: OpIfTask) => opAllParamsIfTask(x)
    (x: OpSwitchJump) => rpFlatten(x.switchCondition, true)
    (x: OpNewObject) => opAllParamsNewObject(x)
    (x: OpCall) => opAllParamsCall(x)
    (x: OpReturn) => rpFlatten(x.returnValue, true)
    (x: OpParallelCall) => opAllParamsParallel(x)
    (x: OpPhi) => opAllParamsPhi(x)
    (o: Op) => List<RParam>()   # base default: [] (Label/Jump/ReturnVoid/Abort don't override)

fun opAllParamsIfTask(x: OpIfTask): List<RParam>
  ret concat<RParam>(concat<RParam>(rpFlatten(x.taskCondition, true), rpFlatten(x.taskSource, true)),
                      concat<RParam>(rpFlatten(x.taskLhs, false), rpFlatten(x.callIdLhs, false)))

fun opAllParamsNewObject(x: OpNewObject): List<RParam>
  ret concat<RParam>(rpFlatten(x.newObjRegister, false), rpFlattenOpt(x.newObjSize, true))

fun opAllParamsCall(x: OpCall): List<RParam>
  ret concat<RParam>(concat<RParam>(rpFlatten(x.callFunction, true), rpFlatten(x.callParameters, true)),
                      opAllParamsCallRegister(x.callRegister))

fun opAllParamsCallRegister(register: RParam|None): List<RParam>
  ret match(register)
    (r: RParam) => rpFlatten(r, false)
    ()          => List<RParam>()

fun opAllParamsParallel(x: OpParallelCall): List<RParam>
  let reads = fold(x.parCalls, List<RParam>(), (acc: List<RParam>, c: RParam) => concat<RParam>(acc, rpFlatten(c, true)))
  let writes = fold(x.parResults, List<RParam>(), (acc: List<RParam>, r: RParam) => concat<RParam>(acc, rpFlatten(r, false)))
  ret concat<RParam>(reads, concat<RParam>(writes, opAllParamsCallRegister(x.parRegister)))

fun opAllParamsPhi(x: OpPhi): List<RParam>
  let sourceParams = fold(x.phiSources, List<RParam>(), (acc: List<RParam>, s: OpPhiSource) => concat<RParam>(acc, rpFlatten(s.sourceValue, true)))
  ret concat<RParam>(sourceParams, rpFlatten(x.phiTarget, false))

# ── rename_vars(renames) ─────────────────────────────────────────────────────

fun opRenameVars(op: Op, renames: List<RpRename>): Op
  ret match(op)
    (x: OpLabel) => OpLabel(renameLookup(renames, x.labelName), x.labelSavedVars)
    (x: OpMove) => OpMove(rpRenameVars(x.moveTarget, renames), rpRenameVars(x.moveSource, renames), x.moveKeep, x.moveSavedVars)
    (x: OpJump) => OpJump(renameLookup(renames, x.jumpName), x.jumpSavedVars)
    (x: OpJumpIf) => OpJumpIf(renameLookup(renames, x.jumpIfLabel), rpRenameVars(x.jumpIfCondition, renames), x.jumpIfInvert, x.jumpIfSavedVars)
    (x: OpIfTask) => OpIfTask(rpRenameVars(x.taskCondition, renames), rpRenameVars(x.taskSource, renames),
                              rpRenameVars(x.taskLhs, renames), rpRenameVars(x.callIdLhs, renames), x.callId,
                              renameLookup(renames, x.taskTarget), x.taskSavedVars)
    (x: OpSwitchJump) => OpSwitchJump(rpRenameVars(x.switchCondition, renames),
                                      map(x.switchCases, (c: OpCase) => OpCase(c.caseValue, renameLookup(renames, c.caseLabel))),
                                      x.switchSavedVars)
    (x: OpNewObject) => OpNewObject(x.newObjName, rpRenameVars(x.newObjRegister, renames), rpRenameVarsOpt(x.newObjSize, renames), x.newObjSavedVars)
    (x: OpCall) => OpCall(rpRenameVars(x.callFunction, renames), rpRenameVars(x.callParameters, renames),
                          opRenameVarsOpt(x.callRegister, renames), x.callMusttail, x.callImpure, x.callResultType, x.callSavedVars)
    (x: OpReturn) => OpReturn(rpRenameVars(x.returnValue, renames), x.returnSavedVars)
    (x: OpParallelCall) => OpParallelCall(map(x.parCalls, (c: RParam) => rpRenameVars(c, renames)),
                                          map(x.parResults, (r: RParam) => rpRenameVars(r, renames)),
                                          opRenameVarsOpt(x.parRegister, renames), x.parSavedVars)
    (x: OpPhi) => OpPhi(rpRenameVars(x.phiTarget, renames),
                        map(x.phiSources, (s: OpPhiSource) => OpPhiSource(renameLookup(renames, s.sourceLabel), rpRenameVars(s.sourceValue, renames))),
                        x.phiSavedVars)
    (o: Op) => op   # base default: self (ReturnVoid/Abort don't override)

fun opRenameVarsOpt(o: RParam|None, renames: List<RpRename>): RParam|None
  ret match(o)
    (v: RParam) => rpRenameVars(v, renames)
    ()          => None

# ── replace_params(replacer) ─────────────────────────────────────────────────

fun opReplaceParams(op: Op, replacer: (:RParam): RParam): Op
  ret match(op)
    (x: OpMove) => OpMove(rpReplaceParams(x.moveTarget, replacer), rpReplaceParams(x.moveSource, replacer), x.moveKeep, x.moveSavedVars)
    (x: OpJumpIf) => OpJumpIf(x.jumpIfLabel, rpReplaceParams(x.jumpIfCondition, replacer), x.jumpIfInvert, x.jumpIfSavedVars)
    (x: OpIfTask) => OpIfTask(rpReplaceParams(x.taskCondition, replacer), rpReplaceParams(x.taskSource, replacer),
                              rpReplaceParams(x.taskLhs, replacer), rpReplaceParams(x.callIdLhs, replacer), x.callId,
                              x.taskTarget, x.taskSavedVars)
    (x: OpSwitchJump) => OpSwitchJump(rpReplaceParams(x.switchCondition, replacer), x.switchCases, x.switchSavedVars)
    (x: OpNewObject) => OpNewObject(x.newObjName, rpReplaceParams(x.newObjRegister, replacer), rpReplaceParamsOpt(x.newObjSize, replacer), x.newObjSavedVars)
    (x: OpCall) => OpCall(rpReplaceParams(x.callFunction, replacer), rpReplaceParams(x.callParameters, replacer),
                          opReplaceParamsOpt(x.callRegister, replacer), x.callMusttail, x.callImpure, x.callResultType, x.callSavedVars)
    (x: OpReturn) => OpReturn(rpReplaceParams(x.returnValue, replacer), x.returnSavedVars)
    (x: OpParallelCall) => OpParallelCall(map(x.parCalls, (c: RParam) => replacer(c)),
                                          map(x.parResults, (r: RParam) => replacer(r)),
                                          opReplaceParamsRegisterDirect(x.parRegister, replacer), x.parSavedVars)
    (x: OpPhi) => OpPhi(replacer(x.phiTarget),
                        map(x.phiSources, (s: OpPhiSource) => OpPhiSource(s.sourceLabel, rpReplaceParams(s.sourceValue, replacer))),
                        x.phiSavedVars)
    (o: Op) => op   # base default: self (Label/Jump/ReturnVoid/Abort don't override)

fun opReplaceParamsOpt(o: RParam|None, replacer: (:RParam): RParam): RParam|None
  ret match(o)
    (v: RParam) => rpReplaceParams(v, replacer)
    ()          => None

# ParallelCall.replace_params calls `replacer(r)` DIRECTLY on each element
# (NOT `r.replace_params(replacer)`) — matches Python exactly.
fun opReplaceParamsRegisterDirect(o: RParam|None, replacer: (:RParam): RParam): RParam|None
  ret match(o)
    (v: RParam) => replacer(v)
    ()          => None

# ── get_live_vars() -> (reads, writes) ──────────────────────────────────────

fun opGetLiveVars(op: Op): (reads: List<RParam>, writes: List<RParam>)
  ret match(op)
    (x: OpMove) => opGetLiveVarsMove(x)
    (x: OpJumpIf) => (rpGetLiveVars(x.jumpIfCondition), List<RParam>())
    (x: OpIfTask) => (rpStackVarUnion(rpGetLiveVars(x.taskCondition), rpGetLiveVars(x.taskSource)), List<RParam>())
    (x: OpSwitchJump) => (rpGetLiveVars(x.switchCondition), List<RParam>())
    (x: OpNewObject) => opGetLiveVarsNewObject(x)
    (x: OpCall) => opGetLiveVarsCall(x)
    (x: OpReturn) => (rpGetLiveVars(x.returnValue), List<RParam>())
    (x: OpParallelCall) => opGetLiveVarsParallel(x)
    (x: OpPhi) => opGetLiveVarsPhi(x)
    (o: Op) => (List<RParam>(), List<RParam>())   # base default: (set(), set()) (Label/Jump/ReturnVoid/Abort don't override)

fun opGetLiveVarsMove(x: OpMove): (reads: List<RParam>, writes: List<RParam>)
  let live = rpGetLiveVars(x.moveSource)
  ret match(x.moveTarget)
    (sv: RpStackVar) => (live, append<RParam>(List<RParam>(), x.moveTarget))
    (o: RParam)      => (rpStackVarUnion(live, rpGetLiveVars(x.moveTarget)), List<RParam>())

fun opGetLiveVarsNewObject(x: OpNewObject): (reads: List<RParam>, writes: List<RParam>)
  let live = rpGetLiveVarsOpt(x.newObjSize)
  ret match(x.newObjRegister)
    (sv: RpStackVar) => (live, append<RParam>(List<RParam>(), x.newObjRegister))
    (o: RParam)      => (rpStackVarUnion(live, rpGetLiveVars(x.newObjRegister)), List<RParam>())

fun opGetLiveVarsCall(x: OpCall): (reads: List<RParam>, writes: List<RParam>)
  let live = rpStackVarUnion(rpGetLiveVars(x.callFunction), rpGetLiveVars(x.callParameters))
  ret match(x.callRegister)
    (r: RParam) => opGetLiveVarsCallRegister(live, r)
    ()           => (live, List<RParam>())

fun opGetLiveVarsCallRegister(live: List<RParam>, r: RParam): (reads: List<RParam>, writes: List<RParam>)
  let dead = rpGetLiveVars(r)
  ret match(r)
    (sv: RpStackVar) => (live, dead)
    (o: RParam)       => (rpStackVarUnion(live, dead), List<RParam>())

fun opGetLiveVarsParallel(x: OpParallelCall): (reads: List<RParam>, writes: List<RParam>)
  let reads = fold(x.parCalls, List<RParam>(), (acc: List<RParam>, c: RParam) => rpStackVarUnion(acc, rpGetLiveVars(c)))
  let writes = fold(x.parResults, List<RParam>(), (acc: List<RParam>, r: RParam) => rpStackVarUnion(acc, append<RParam>(List<RParam>(), r)))
  ret match(x.parRegister)
    (r: RParam) => (reads, rpStackVarUnion(writes, append<RParam>(List<RParam>(), r)))
    ()           => (reads, writes)

fun opGetLiveVarsPhi(x: OpPhi): (reads: List<RParam>, writes: List<RParam>)
  let reads = fold(x.phiSources, List<RParam>(), (acc: List<RParam>, s: OpPhiSource) => rpStackVarUnion(acc, rpGetLiveVars(s.sourceValue)))
  ret match(x.phiTarget)
    (sv: RpStackVar) => (reads, append<RParam>(List<RParam>(), x.phiTarget))
    (o: RParam)      => (rpStackVarUnion(reads, rpGetLiveVars(x.phiTarget)), List<RParam>())

# ── is_direct_call() (Call only) ────────────────────────────────────────────

fun opIsDirectCall(x: OpCall): Bool
  ret match(x.callFunction)
    (g: RpGlobalFunction) => true
    (o: RParam)           => false

# ── to_c ─────────────────────────────────────────────────────────────────────

fun opToC(op: Op, cache: List<CgCacheEntry>): (text: String, cache: List<CgCacheEntry>)
  ret match(op)
    (x: OpLabel) => (mangleName(x.labelName) + ":\n", cache)
    (x: OpMove) => opToCMove(x, cache)
    (x: OpJump) => ("    goto " + mangleName(x.jumpName) + ";\n", cache)
    (x: OpJumpIf) => opToCJumpIf(x, cache)
    (x: OpIfTask) => opToCIfTask(x, cache)
    (x: OpSwitchJump) => opToCSwitchJump(x, cache)
    (x: OpNewObject) => opToCNewObject(x, cache)
    (x: OpCall) => opToCCall(x, cache)
    (x: OpReturnVoid) => ("    return;\n", cache)
    (x: OpAbort) => opToCAbort(x, cache)
    (x: OpReturn) => opToCReturn(x, cache)
    (x: OpParallelCall) => ("", cache)   # unreachable: async_lower must remove ParallelCall before codegen
    (x: OpPhi) => ("", cache)            # unreachable: from_ssa must lower Phi to Moves before codegen

fun opToCMove(x: OpMove, cache0: List<CgCacheEntry>): (text: String, cache: List<CgCacheEntry>)
  let sourceC = rpToC(x.moveSource, cache0)
  ret rpToCStore(x.moveTarget, sourceC.cache, sourceC.text)

fun opToCJumpIf(x: OpJumpIf, cache0: List<CgCacheEntry>): (text: String, cache: List<CgCacheEntry>)
  let condC = rpToC(x.jumpIfCondition, cache0)
  let test = x.jumpIfInvert ? "!(" + condC.text + ")" : condC.text
  ret ("    if (" + test + ") goto " + mangleName(x.jumpIfLabel) + ";\n", condC.cache)

fun opToCIfTask(x: OpIfTask, cache0: List<CgCacheEntry>): (text: String, cache: List<CgCacheEntry>)
  let condC = rpToC(x.taskCondition, cache0)
  let dstC = rpToC(x.taskLhs, condC.cache)
  let srcC = rpToC(x.taskSource, dstC.cache)
  let cidC = rpToC(x.callIdLhs, srcC.cache)
  let dstType = cgDeclare(rpGetType(x.taskLhs), cidC.cache)
  let text = "    if (UNLIKELY(" + condC.text + ")) {\n"
    + "        " + dstC.text + " = (" + dstType.text + ")TASK_UNTAG(" + srcC.text + ");\n"
    + "        " + cidC.text + " = ((int32_t)" + String(x.callId) + ");\n"
    + "        goto " + mangleName(x.taskTarget) + ";\n"
    + "    }\n"
  ret (text, dstType.cache)

fun opToCSwitchJump(x: OpSwitchJump, cache0: List<CgCacheEntry>): (text: String, cache: List<CgCacheEntry>)
  let condC = rpToC(x.switchCondition, cache0)
  let cases = join(map(x.switchCases, (c: OpCase) => "        case " + String(c.caseValue) + ": goto " + mangleName(c.caseLabel) + ";"), "\n")
  ret ("    switch (" + condC.text + ") {\n" + cases + "\n        default: abort();\n    }\n", condC.cache)

fun opToCNewObject(x: OpNewObject, cache0: List<CgCacheEntry>): (text: String, cache: List<CgCacheEntry>)
  ret match(x.newObjSize)
    (sz: RParam) => opToCNewObjectSized(x, sz, cache0)
    ()            => rpToCStore(x.newObjRegister, cache0, "object_new(obj_" + mangleName(x.newObjName) + ")")

fun opToCNewObjectSized(x: OpNewObject, sz: RParam, cache0: List<CgCacheEntry>): (text: String, cache: List<CgCacheEntry>)
  let szC = rpToC(sz, cache0)
  ret rpToCStore(x.newObjRegister, szC.cache, "array_create(obj_" + mangleName(x.newObjName) + ", " + szC.text + ")")

fun opToCAbort(x: OpAbort, cache: List<CgCacheEntry>): (text: String, cache: List<CgCacheEntry>)
  let note = length(x.abortReason) == 0 ? "" : "  // " + x.abortReason
  ret ("    abort();" + note + "\n", cache)

fun opToCReturn(x: OpReturn, cache0: List<CgCacheEntry>): (text: String, cache: List<CgCacheEntry>)
  let sub = rpToC(x.returnValue, cache0)
  ret ("    return " + sub.text + ";\n", sub.cache)

# `Call.to_c` — the most involved emission method in this file. Cache
# threading follows Python's exact left-to-right evaluation order: return
# type first, then (for a NewStruct argument) each arg's type then each
# arg's value in two separate passes — since Python's type_cache is one
# shared mutable dict, the first pass's growth is visible to the second.

fun opToCCall(x: OpCall, cache0: List<CgCacheEntry>): (text: String, cache: List<CgCacheEntry>)
  let rt = opToCCallReturnType(x, cache0)
  let tailreturn = x.callMusttail ? "return " : ""
  let ptype = rpGetType(x.callParameters)
  ret match(cgFieldsOf(ptype))
    (fields: List<CgField>) => opToCCallBody(x, rt.text, tailreturn, ptype, fields, rt.cache)
    ()                       => ("", rt.cache)   # unreachable (Python raises ValueError: "parameters must be a struct type")

fun opToCCallReturnType(x: OpCall, cache0: List<CgCacheEntry>): (text: String, cache: List<CgCacheEntry>)
  ret match(x.callRegister)
    (r: RParam) => cgDeclare(rpGetType(r), cache0)
    ()           => opToCCallReturnTypeNoRegister(x, cache0)

fun opToCCallReturnTypeNoRegister(x: OpCall, cache0: List<CgCacheEntry>): (text: String, cache: List<CgCacheEntry>)
  ret match(x.callResultType)
    (t: CgType) => cgDeclare(t, cache0)
    ()           => ("void", cache0)

fun opToCCallBody(x: OpCall, returnType: String, tailreturn: String, ptype: CgType, fields: List<CgField>, cache0: List<CgCacheEntry>): (text: String, cache: List<CgCacheEntry>)
  ret match(x.callParameters)
    (prms: RpNewStruct) => opToCCallNewStruct(x, returnType, tailreturn, prms, cache0)
    (prms: RParam)        => opToCCallGenericParams(x, returnType, tailreturn, ptype, fields, prms, cache0)

fun opToCCallPrefixJoin(list: List<String>): String
  ret fold(list, "", (acc: String, s: String) => acc + ", " + s)

fun opToCCallTypesFromValues(values: List<RpNamedValue>, cache0: List<CgCacheEntry>): (list: List<String>, cache: List<CgCacheEntry>)
  ret fold(values, (List<String>(), cache0), (acc: (list: List<String>, cache: List<CgCacheEntry>), v: RpNamedValue) => opToCCallTypesStep(acc, v))

fun opToCCallTypesStep(acc: (list: List<String>, cache: List<CgCacheEntry>), v: RpNamedValue): (list: List<String>, cache: List<CgCacheEntry>)
  let sub = cgDeclare(rpGetType(v.value), acc.cache)
  ret (append<String>(acc.list, sub.text), sub.cache)

fun opToCCallParamsFromValues(values: List<RpNamedValue>, cache0: List<CgCacheEntry>): (list: List<String>, cache: List<CgCacheEntry>)
  ret fold(values, (List<String>(), cache0), (acc: (list: List<String>, cache: List<CgCacheEntry>), v: RpNamedValue) => opToCCallParamsStep(acc, v))

fun opToCCallParamsStep(acc: (list: List<String>, cache: List<CgCacheEntry>), v: RpNamedValue): (list: List<String>, cache: List<CgCacheEntry>)
  let sub = rpToC(v.value, acc.cache)
  ret (append<String>(acc.list, sub.text), sub.cache)

fun opToCCallNewStruct(x: OpCall, returnType: String, tailreturn: String, prms: RpNewStruct, cache0: List<CgCacheEntry>): (text: String, cache: List<CgCacheEntry>)
  let typesR = opToCCallTypesFromValues(prms.values, cache0)
  let paramsR = opToCCallParamsFromValues(prms.values, typesR.cache)
  let typesStr = opToCCallPrefixJoin(typesR.list)
  let paramsStr = opToCCallPrefixJoin(paramsR.list)
  ret opToCCallFinish(x, returnType, tailreturn, typesStr, paramsStr, "", paramsR.cache)

fun opToCCallTypesFromFields(fields: List<CgField>, cache0: List<CgCacheEntry>): (list: List<String>, cache: List<CgCacheEntry>)
  ret fold(fields, (List<String>(), cache0), (acc: (list: List<String>, cache: List<CgCacheEntry>), f: CgField) => opToCCallTypesFieldStep(acc, f))

fun opToCCallTypesFieldStep(acc: (list: List<String>, cache: List<CgCacheEntry>), f: CgField): (list: List<String>, cache: List<CgCacheEntry>)
  let sub = cgDeclare(f.fieldType, acc.cache)
  ret (append<String>(acc.list, sub.text), sub.cache)

# NOTE: Python builds each unpacked param as `f"prm.{name}"` using the RAW
# (unmangled) field name, not `mangle_name(name)` — inconsistent with every
# other struct-field access in this file, which mangles. Ported as-is; see
# the port report for this being flagged as a suspected upstream bug.
fun opToCCallGenericParams(x: OpCall, returnType: String, tailreturn: String, ptype: CgType, fields: List<CgField>, prms: RParam, cache0: List<CgCacheEntry>): (text: String, cache: List<CgCacheEntry>)
  let typesR = opToCCallTypesFromFields(fields, cache0)
  let typesStr = opToCCallPrefixJoin(typesR.list)
  let paramsStr = opToCCallPrefixJoin(map(fields, (f: CgField) => "prm." + f.fieldName))
  ret isEmpty<CgField>(fields)
    ? opToCCallFinish(x, returnType, tailreturn, typesStr, paramsStr, "", typesR.cache)
    : opToCCallGenericWithUnpack(x, returnType, tailreturn, ptype, typesStr, paramsStr, prms, typesR.cache)

fun opToCCallGenericWithUnpack(x: OpCall, returnType: String, tailreturn: String, ptype: CgType, typesStr: String, paramsStr: String, prms: RParam, cache0: List<CgCacheEntry>): (text: String, cache: List<CgCacheEntry>)
  let declared = cgDeclare(ptype, cache0)
  let prmsC = rpToC(prms, declared.cache)
  let unpack = "        " + declared.text + " prm = " + prmsC.text + ";\n"
  ret opToCCallFinish(x, returnType, tailreturn, typesStr, paramsStr, unpack, prmsC.cache)

fun opToCCallFinish(x: OpCall, returnType: String, tailreturn: String, typesStr: String, paramsStr: String, unpack: String, cache0: List<CgCacheEntry>): (text: String, cache: List<CgCacheEntry>)
  ret match(x.callFunction)
    (fn: RpGlobalFunction) => length(unpack) == 0
      ? opToCCallDirect(x, fn, returnType, tailreturn, typesStr, paramsStr, cache0)
      : opToCCallIndirect(x, returnType, tailreturn, typesStr, paramsStr, unpack, cache0)
    (fn: RParam) => opToCCallIndirect(x, returnType, tailreturn, typesStr, paramsStr, unpack, cache0)

fun opToCCallDirect(x: OpCall, fn: RpGlobalFunction, returnType: String, tailreturn: String, typesStr: String, paramsStr: String, cache0: List<CgCacheEntry>): (text: String, cache: List<CgCacheEntry>)
  let fRef = match(fn.cSymbol)
    (s: String) => s
    ()          => mangleName(fn.name)
  let objR = opToCCallDirectObject(fn.object, cache0)
  let call = "((" + returnType + "(*)(object_t*" + typesStr + "))" + fRef + ")(" + objR.text + paramsStr + ")"
  ret match(x.callRegister)
    (rg: RParam) => rpToCStore(rg, objR.cache, call)
    ()            => ("    " + tailreturn + call + ";\n", objR.cache)

fun opToCCallDirectObject(o: RParam|None, cache0: List<CgCacheEntry>): (text: String, cache: List<CgCacheEntry>)
  ret match(o)
    (v: RParam) => rpToC(v, cache0)
    ()           => ("NULL", cache0)

fun opToCCallIndirect(x: OpCall, returnType: String, tailreturn: String, typesStr: String, paramsStr: String, unpack: String, cache0: List<CgCacheEntry>): (text: String, cache: List<CgCacheEntry>)
  let fnC = rpToC(x.callFunction, cache0)
  let funDecl = "        fun_t fun = " + fnC.text + ";\n"
  let call = "((" + returnType + "(*)(object_t*" + typesStr + "))fun.f)(fun.o" + paramsStr + ")"
  ret match(x.callRegister)
    (rg: RParam) => opToCCallIndirectFinish(funDecl, unpack, rpToCStore(rg, fnC.cache, call))
    ()            => opToCCallIndirectFinish(funDecl, unpack, ("        " + tailreturn + call + ";\n", fnC.cache))

fun opToCCallIndirectFinish(funDecl: String, unpack: String, assignR: (text: String, cache: List<CgCacheEntry>)): (text: String, cache: List<CgCacheEntry>)
  ret ("    {\n" + funDecl + unpack + assignR.text + "    }\n", assignR.cache)

# ── get_live_vars: the READS half (writes live in ssa_validate's walker) ─────
# Python: reads = StackVars in read positions; a non-StackVar TARGET (an
# ObjectField store) contributes its inner reads (the pointer) as reads.

fun rpReadVarNames(r: RParam): List<String>
  ret fold(rpFlatten(r, true), List<String>(), rpTakeStackVarName)

fun rpTakeStackVarName(acc: List<String>, x: RParam): List<String>
  ret match(x)
    (sv: RpStackVar) => append(acc, sv.name)
    (o: RParam)       => acc

fun rpTargetReadNames(target: RParam): List<String>
  ret match(target)
    (sv: RpStackVar) => List<String>()
    (o: RParam)       => rpReadVarNames(target)

fun rpOptReadNames(r: RParam|None): List<String>
  ret match(r)
    (x: RParam) => rpReadVarNames(x)
    ()           => List<String>()

fun opReadVarNames(op: Op): List<String>
  ret match(op)
    (m: OpMove)          => concat(rpReadVarNames(m.moveSource), rpTargetReadNames(m.moveTarget))
    (ji: OpJumpIf)       => rpReadVarNames(ji.jumpIfCondition)
    (t2: OpIfTask)       => concat(rpReadVarNames(t2.taskCondition), rpReadVarNames(t2.taskSource))
    (sw: OpSwitchJump)   => rpReadVarNames(sw.switchCondition)
    (n: OpNewObject)     => concat(rpOptReadNames(n.newObjSize), rpTargetReadNames(n.newObjRegister))
    (c: OpCall)          => concat(concat(rpReadVarNames(c.callFunction), rpReadVarNames(c.callParameters)),
                                   rpOptTargetReadNames(c.callRegister))
    (r: OpReturn)        => rpReadVarNames(r.returnValue)
    (pc: OpParallelCall) => fold(pc.parCalls, List<String>(), (acc: List<String>, x: RParam) => concat(acc, rpReadVarNames(x)))
    (ph: OpPhi)          => fold(ph.phiSources, List<String>(), (acc: List<String>, s2: OpPhiSource) => concat(acc, rpReadVarNames(s2.sourceValue)))
    (o: Op)              => List<String>()

fun rpOptTargetReadNames(r: RParam|None): List<String>
  ret match(r)
    (x: RParam) => rpTargetReadNames(x)
    ()           => List<String>()

# ── saved_vars setter (async_lower's liveness fixpoint rewrites them) ────────

fun opWithSavedVars(op: Op, sv: List<RParam>): Op
  ret match(op)
    (x: OpLabel)        => OpLabel(x.labelName, sv)
    (x: OpMove)         => opWsvMove(x, sv)
    (x: OpJump)         => OpJump(x.jumpName, sv)
    (x: OpJumpIf)       => opWsvJumpIf(x, sv)
    (x: OpIfTask)       => OpIfTask(x.taskCondition, x.taskSource, x.taskLhs, x.callIdLhs, x.callId, x.taskTarget, sv)
    (x: OpSwitchJump)   => OpSwitchJump(x.switchCondition, x.switchCases, sv)
    (x: OpNewObject)    => OpNewObject(x.newObjName, x.newObjRegister, x.newObjSize, sv)
    (x: OpCall)         => opWsvCall(x, sv)
    (x: OpReturnVoid)   => OpReturnVoid(sv)
    (x: OpAbort)        => OpAbort(x.abortReason, sv)
    (x: OpReturn)       => OpReturn(x.returnValue, sv)
    (x: OpParallelCall) => OpParallelCall(x.parCalls, x.parResults, x.parRegister, sv)
    (x: OpPhi)          => OpPhi(x.phiTarget, x.phiSources, sv)

# The Bool fields are LET-BOUND with explicit types before the rebuild: a
# union-slot Bool read feeding an inlined constructor mints precision-
# inconsistent StackVars (i16 slot view vs i8 param) that Python's
# uninit_check rejects — TODO.md OPEN 2026-07-17 (bool slot precision).
fun opWsvMove(x: OpMove, sv: List<RParam>): Op
  let keep: Bool = x.moveKeep
  ret OpMove(x.moveTarget, x.moveSource, keep, sv)

fun opWsvJumpIf(x: OpJumpIf, sv: List<RParam>): Op
  let invert: Bool = x.jumpIfInvert
  ret OpJumpIf(x.jumpIfLabel, x.jumpIfCondition, invert, sv)

fun opWsvCall(x: OpCall, sv: List<RParam>): Op
  let musttail: Bool = x.callMusttail
  let impure: Bool = x.callImpure
  ret OpCall(x.callFunction, x.callParameters, x.callRegister, musttail, impure, x.callResultType, sv)

# Reads as StackVar RPARAMS (types intact — the liveness sets feed state-field
# layout); the names-only twin is opReadVarNames above.
fun rpReadStackVars(r: RParam): List<RParam>
  ret fold(rpFlatten(r, true), List<RParam>(), rpTakeStackVar)

fun rpTakeStackVar(acc: List<RParam>, x: RParam): List<RParam>
  ret match(x)
    (sv: RpStackVar) => append(acc, x)
    (o: RParam)       => acc

fun rpTargetReadStackVars(target: RParam): List<RParam>
  ret match(target)
    (sv: RpStackVar) => List<RParam>()
    (o: RParam)       => rpReadStackVars(target)

fun rpOptReadStackVars(r: RParam|None): List<RParam>
  ret match(r)
    (x: RParam) => rpReadStackVars(x)
    ()           => List<RParam>()

fun rpOptTargetReadStackVars(r: RParam|None): List<RParam>
  ret match(r)
    (x: RParam) => rpTargetReadStackVars(x)
    ()           => List<RParam>()

fun opReadStackVars(op: Op): List<RParam>
  ret match(op)
    (m: OpMove)          => concat(rpReadStackVars(m.moveSource), rpTargetReadStackVars(m.moveTarget))
    (ji: OpJumpIf)       => rpReadStackVars(ji.jumpIfCondition)
    (t2: OpIfTask)       => concat(rpReadStackVars(t2.taskCondition), rpReadStackVars(t2.taskSource))
    (sw: OpSwitchJump)   => rpReadStackVars(sw.switchCondition)
    (n: OpNewObject)     => concat(rpOptReadStackVars(n.newObjSize), rpTargetReadStackVars(n.newObjRegister))
    (c: OpCall)          => concat(concat(rpReadStackVars(c.callFunction), rpReadStackVars(c.callParameters)),
                                   rpOptTargetReadStackVars(c.callRegister))
    (r: OpReturn)        => rpReadStackVars(r.returnValue)
    (pc: OpParallelCall) => fold(pc.parCalls, List<RParam>(), (acc: List<RParam>, x: RParam) => concat(acc, rpReadStackVars(x)))
    (ph: OpPhi)          => fold(ph.phiSources, List<RParam>(), (acc: List<RParam>, s2: OpPhiSource) => concat(acc, rpReadStackVars(s2.sourceValue)))
    (o: Op)              => List<RParam>()
