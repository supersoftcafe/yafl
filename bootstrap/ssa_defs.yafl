# bootstrap/ssa_defs.yafl — ported from lowering/ssa_defs.py: SSA def-chain
# analysis over the pre-async IR — a LIBRARY, not a pass. Pre-async, every
# StackVar has at most one definition (ssa_validate enforces it), so "what
# value does this local hold?" is answerable by chasing Moves. Several
# pipeline stages share that question — struct-read folding, known-tag
# resolution, string-append flattening — and this module is its single home.
# Nothing here rewrites anything: pure queries, safe to call from any stage.
namespace Bootstrap

import System

# Each StackVar's sole defining source; a None VALUE means unknowable (Phi
# merge, call result, or — defensively — a repeated definition). Entries with
# sdSource: RParam|None keep "absent" and "known-unknowable" distinct, exactly
# like Python's dict-with-None-values (both answer None from sdGet, which is
# also Python's `defs.get(name)` behaviour).
class [final] SsaDef(sdName: String, sdSource: RParam|None)

fun sdMaxChase(): Int
  ret 8   # def-chain depth bound (copies of copies of packs)

fun singleDefs(f: CgFunction): List<SsaDef>
  ret fold(f.fnOps, List<SsaDef>(), sdCollectOp)

fun sdCollectOp(acc: List<SsaDef>, op: Op): List<SsaDef>
  ret match(op)
    (m: OpMove)  => match(m.moveTarget)
      (sv: RpStackVar) => sdDefine(acc, sv.name, m.moveSource)
      (o: RParam)      => acc
    (c: OpCall)  => match(c.callRegister)
      (r0: RParam) => match(r0)
        (sv: RpStackVar) => sdDefine(acc, sv.name, None)
        (o: RParam)      => acc
      ()           => acc
    (ph: OpPhi)  => match(ph.phiTarget)
      (sv: RpStackVar) => sdDefine(acc, sv.name, None)
      (o: RParam)      => acc
    (o: Op)      => acc

# A REPEATED definition poisons to None (defensive — ssa_validate should
# forbid it pre-async).
fun sdDefine(acc: List<SsaDef>, name: String, source: RParam|None): List<SsaDef>
  ret sdHas(chain(acc), name)
    ? map(acc, (d: SsaDef) => d.sdName == name ? SsaDef(name, None) : d)
    : append(acc, SsaDef(name, source))

fun [tail] sdHas(ds: Chain<SsaDef>, name: String): Bool
  ret match(ds)
    (nil: ChainEnd) => false
    (l: ChainLink)  => l.value.sdName == name ? true : sdHas(l.next, name)

fun [tail] sdGet(ds: Chain<SsaDef>, name: String): RParam|None
  ret match(ds)
    (nil: ChainEnd) => None
    (l: ChainLink)  => l.value.sdName == name
      ? l.value.sdSource
      : sdGet(l.next, name)

# How many ops read each StackVar (a def whose value is read exactly once can
# be absorbed into its sole reader). saved_vars count as reads — a var marked
# to persist across a call has a future reader (async lowering's state
# machine) that get_live_vars cannot see; deadstores applies the same rule,
# and dropping such a def segfaults at resumption.
fun sdReadCounts(f: CgFunction): List<StrCount>
  ret fold(f.fnOps, List<StrCount>(), sdCountOp)

fun sdCountOp(acc: List<StrCount>, op: Op): List<StrCount>
  ret fold(opSavedVars(op),
           fold(opGetLiveVars(op).reads, acc, sdCountVar), sdCountVar)

fun sdCountVar(acc: List<StrCount>, rp: RParam): List<StrCount>
  ret match(rp)
    (sv: RpStackVar) => strCountIncr(acc, sv.name)
    (o: RParam)      => acc

# Chase `param` through StackVar copies to its defining value, if that value
# is statically known. Returns a NewStruct/Integer/... or None.
fun resolveValue(param: RParam, defs: List<SsaDef>, depth: Int): RParam|None
  if depth <= 0
    ret None
  ret match(param)
    (sv: RpStackVar)       => match(sdGet(chain(defs), sv.name))
      (src: RParam) => resolveValue(src, defs, depth - 1)
      ()            => None
    (sf: RpStructField)    => sdResolveField(sf, defs, depth)
    (ns: RpNewStruct)      => param
    (i: RpInteger)         => param
    (s2: RpString)         => param
    (fl: RpFloat)          => param
    (np: RpNullPointer)    => param
    (gv: RpGlobalVar)      => param
    (gf: RpGlobalFunction) => param
    (o: RParam)            => None

fun sdResolveField(sf: RpStructField, defs: List<SsaDef>, depth: Int): RParam|None
  ret match(resolveValue(sf.structVal, defs, depth - 1))
    (base: RParam) => match(base)
      (ns: RpNewStruct) => sdFieldValue(chain(ns.values), sf.field, defs, depth)
      (o: RParam)       => None
    ()             => None

# `resolve_value(fval) or fval`: prefer the chased value, else the raw one.
fun [tail] sdFieldValue(vs: Chain<RpNamedValue>, field: String,
                        defs: List<SsaDef>, depth: Int): RParam|None
  ret match(vs)
    (nil: ChainEnd) => None
    (l: ChainLink)  => l.value.name == field
      ? sdPreferChased(l.value.value, defs, depth)
      : sdFieldValue(l.next, field, defs, depth)

fun sdPreferChased(v: RParam, defs: List<SsaDef>, depth: Int): RParam
  ret match(resolveValue(v, defs, depth - 1))
    (rv: RParam) => rv
    ()           => v

# A value simple enough to duplicate into each read site: pure, no evaluation
# order, no code growth beyond a name. (RuntimeInvoke and friends are
# excluded — side effects / non-trivial C expressions stay anchored.)
fun sdIsDuplicable(p: RParam): Bool
  ret match(p)
    (sv: RpStackVar)       => true
    (i: RpInteger)         => true
    (s2: RpString)         => true
    (fl: RpFloat)          => true
    (np: RpNullPointer)    => true
    (gv: RpGlobalVar)      => true
    (gf: RpGlobalFunction) => true
    (o: RParam)            => false

# The compile-time integer value of `param`, or None if not decidable.
fun staticInt(param: RParam, defs: List<SsaDef>): Int|None
  ret match(param)
    (eq: RpIntEqConst) => match(staticInt(eq.value, defs))
      (v: Int) => v == eq.constVal ? 1 : 0
      ()       => None
    (o: RParam)        => match(resolveValue(param, defs, sdMaxChase()))
      (rv: RParam) => match(rv)
        (i: RpInteger) => i.value
        (o2: RParam)   => None
      ()           => None
