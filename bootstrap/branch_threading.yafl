# bootstrap/branch_threading.yafl — ported from lowering/branch_threading.py:
# replace Jump(L) with a copy of the terminator immediately following
# Label(L) when that terminator is itself Return/ReturnVoid/unconditional
# Jump; fixpoint, then strip newly-unreachable ops. Python's `terminator is
# not op` identity guard becomes a structural same-name-Jump guard here —
# the only shape where substitution would spin (Label L; Jump L).
namespace Bootstrap

import System

fun threadBranches(a: CgApp): CgApp
  ret appWithFunctions(a, map(a.appFunctions, btFunction))

fun [tail] btFunction(f: CgFunction): CgFunction
  let out = btOnce(f.fnOps)
  ret out.btChanged
    ? btFunction(cgFunctionStripUnusedOperations(cgFunctionWith(f, out.btOps, f.fnStackVars)))
    : f

class [final] BtOut(btOps: List<Op>, btChanged: Bool)

fun btOnce(ops: List<Op>): BtOut
  ret fold(ops, BtOut(List<Op>(), false),
           (acc: BtOut, op: Op) => btStep(acc, op, ops))

fun btStep(acc: BtOut, op: Op, ops: List<Op>): BtOut
  ret match(op)
    (j: OpJump) => match(btTerminatorAfter(chain(ops), j.jumpName))
      (t2: Op) => btSameJump(t2, j)
        ? BtOut(append(acc.btOps, op), acc.btChanged)
        : BtOut(append(acc.btOps, t2), true)
      ()        => BtOut(append(acc.btOps, op), acc.btChanged)
    (o: Op)     => BtOut(append(acc.btOps, op), acc.btChanged)

fun btSameJump(t2: Op, j: OpJump): Bool
  ret match(t2)
    (j2: OpJump) => j2.jumpName == j.jumpName
    (o: Op)      => false

fun [tail] btTerminatorAfter(ops: Chain<Op>, labelName: String): Op|None
  ret match(ops)
    (nil: ChainEnd) => None
    (l: ChainLink)  => btIsTargetLabel(l.value, labelName)
      ? btNextTerminator(l.next)
      : btTerminatorAfter(l.next, labelName)

fun btIsTargetLabel(op: Op, labelName: String): Bool
  ret match(op)
    (lb: OpLabel) => lb.labelName == labelName
    (o: Op)       => false

fun btNextTerminator(rest: Chain<Op>): Op|None
  ret match(rest)
    (nil: ChainEnd) => None
    (l: ChainLink)  => match(l.value)
      (r: OpReturn)      => l.value
      (rv: OpReturnVoid) => l.value
      (j: OpJump)        => l.value
      (o: Op)            => None
