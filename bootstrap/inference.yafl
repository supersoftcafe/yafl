# bootstrap/inference.yafl — call-site generic-parameter inference, ported
# from pyast/inference.py.
#
# The compile-fixpoint twin of algebra.yafl: where the algebra answers
# questions about types, this answers ONE question about a USE of a generic
# statement — what type arguments should it carry? — by combining the three
# sources, strongest first: the argument types, the expected result type, and
# the `where` constraints discharged against the `[trait]` instances in scope.
# Results may be PARTIAL (an unbound param keeps its own placeholder for a
# later pass) and are MONOTONE across passes (fresh bindings MEET stored ones
# — inference refines, never forgets).
namespace Bootstrap

import System

# ── the entry point (NamedExpression.compile) ────────────────────────────────
# The type arguments a use of generic `stmt` should carry: `supplied` if it is
# COMPLETE, otherwise re-inferred from the enclosing call's expected type.
# Complete is scope-aware and structural (hasFreePlaceholders): a placeholder
# that resolves in scope is an enclosing generic's param passing through and
# LATCHES; one that does not — even buried inside a compound argument — is a
# not-yet-bound leftover, and this use refreshes once the inner hole fills.

fun useSiteTypeParams(stmt: PStmt, supplied: List<Spec>, expected: Spec|None,
                      r: Resolver): List<Spec>
  let gens = stmtGens(stmt)
  if isEmpty(gens)
    ret supplied
  ret match(expected)
    (e2: Spec) => match(e2)
      (want: SCallable) => suppliedComplete(supplied, gens, r)
        ? supplied
        : reinferred(stmt, gens, supplied, want, r)
      (o: Spec)         => supplied
    ()         => supplied

fun suppliedComplete(supplied: List<Spec>, gens: List<PGen>,
                     r: Resolver): Bool
  ret listLen(supplied) == listLen(gens) && !anyFree(chain(supplied), r)

fun [tail] anyFree(ts: Chain<Spec>, r: Resolver): Bool
  ret match(ts)
    (nil: ChainEnd) => false
    (l: ChainLink)  => hasFreePlaceholders(l.value, r) ? true : anyFree(l.next, r)

fun reinferred(stmt: PStmt, gens: List<PGen>, supplied: List<Spec>,
               want: SCallable, r: Resolver): List<Spec>
  ret match(stmtType(stmt))
    (dt: Spec) => match(dt)
      (declared: SCallable) => match(inferTypeParams(stmt, gens, declared,
                                                     want, r))
        (mapping: List<Binding>) => mergedParams(gens, supplied, mapping)
        ()                       => supplied
      (o: Spec)             => supplied
    ()         => supplied

# MONOTONE re-inference: a param this pass could not re-derive keeps its
# previously stored binding (MEET — a fresh hole must never overwrite a ground
# binding); a param never bound keeps its OWN placeholder, so the use stays
# generic until a later pass.
fun mergedParams(gens: List<PGen>, supplied: List<Spec>,
                 mapping: List<Binding>): List<Spec>
  let prior = listLen(supplied) == listLen(gens)
    ? priorBindings(chain(gens), chain(supplied), List<Binding>())
    : List<Binding>()
  ret mergeLoop(chain(gens), prior, mapping, List<Spec>())

fun [tail] priorBindings(gs: Chain<PGen>, ss: Chain<Spec>,
                         acc: List<Binding>): List<Binding>
  ret match(gs)
    (nil: ChainEnd) => acc
    (g2: ChainLink) => match(ss)
      (nil2: ChainEnd) => acc
      (s2: ChainLink)  => priorBindings(g2.next, s2.next,
                                        append(acc, Binding(g2.value.genName,
                                                            s2.value)))

fun [tail] mergeLoop(gs: Chain<PGen>, prior: List<Binding>,
                     mapping: List<Binding>, acc: List<Spec>): List<Spec>
  ret match(gs)
    (nil: ChainEnd) => acc
    (l: ChainLink)  => mergeLoop(l.next, prior, mapping,
                                 append(acc, boundParam(l.value, prior,
                                                        mapping)))

fun boundParam(g2: PGen, prior: List<Binding>, mapping: List<Binding>): Spec
  let fresh = match(bindingOf(mapping, g2.genName))
    (b: Spec) => b
    ()        => ownPlaceholder(g2)
  ret match(meet(bindingOf(prior, g2.genName), fresh))
    (ms: MSpec) => ms.mSpec
    (o: Meet)   => fresh

fun ownPlaceholder(g2: PGen): Spec
  ret SGeneric(g2.genName, isLinearGen(g2), g2.pgLine)

# ── _infer_type_params ───────────────────────────────────────────────────────
# Three sources, strongest first: argument types (declared parameter tuple vs
# the call's actual one), the expected result, and — for a param that appears
# only in a `where` clause — the trait instances in scope. The mapping may be
# PARTIAL; None means the shapes don't unify at all.

fun inferTypeParams(stmt: PStmt, gens: List<PGen>, declared: SCallable,
                    want: SCallable, r: Resolver): List<Binding>|None
  let names = genNames(chain(gens), List<String>())
  ret match(unifyGeneric(declared.scParams2, want.scParams2, names,
                         List<Binding>()))
    (m: UMap)  => match(resultUnified(declared, want, names, m.uBindings))
      (rm: List<Binding>) => viaWhere(stmt, gens, rm, r, declared.scParams2)
      ()                  => None
    (f: UFail) => None

# A result-unify FAILURE fails the whole inference (Python: `mapping = ...;
# if mapping is None: return None`), not just this source.
fun resultUnified(declared: SCallable, want: SCallable, names: List<String>,
                  mapping: List<Binding>): List<Binding>|None
  ret match(declared.scResult)
    (dr: Spec) => match(want.scResult)
      (wr: Spec) => match(unifyGeneric(dr, wr, names, mapping))
        (m: UMap)  => m.uBindings
        (f: UFail) => None
      ()         => mapping
    ()         => mapping

fun [tail] genNames(gs: Chain<PGen>, acc: List<String>): List<String>
  ret match(gs)
    (nil: ChainEnd) => acc
    (l: ChainLink)  => genNames(l.next, append(acc, l.value.genName))

# ── _infer_type_params_via_where ─────────────────────────────────────────────
# Bind type params argument inference CANNOT determine — those appearing in no
# value parameter — by discharging the statement's `where` constraints against
# the trait instances. A param that DOES appear in the value parameters must
# come from the arguments; binding it from an arbitrary instance would pick
# the wrong one. Additive: the mapping is untouched when nothing grounds.

fun viaWhere(stmt: PStmt, gens: List<PGen>, mapping: List<Binding>,
             r: Resolver, declaredParams: Spec): List<Binding>
  let argInferrable = placeholderNames(declaredParams)
  let targets = whereTargets(chain(gens), mapping, argInferrable,
                             List<String>())
  if isEmpty(targets)
    ret mapping
  ret whereLoop(chain(stmtWheres(stmt)), gens, mapping, argInferrable,
                traitInstances(r), r)

fun [tail] whereTargets(gs: Chain<PGen>, mapping: List<Binding>,
                        argInferrable: List<String>,
                        acc: List<String>): List<String>
  ret match(gs)
    (nil: ChainEnd) => acc
    (l: ChainLink)  => isWhereTarget(l.value.genName, mapping, argInferrable)
      ? whereTargets(l.next, mapping, argInferrable,
                     append(acc, l.value.genName))
      : whereTargets(l.next, mapping, argInferrable, acc)

fun isWhereTarget(name: String, mapping: List<Binding>,
                  argInferrable: List<String>): Bool
  ret match(bindingOf(mapping, name))
    (b: Spec) => false
    ()        => !contains2(argInferrable, name)

fun [tail] whereLoop(ws: Chain<Spec>, gens: List<PGen>,
                     mapping: List<Binding>, argInferrable: List<String>,
                     instances: List<TraitInst>, r: Resolver): List<Binding>
  let targets = whereTargets(chain(gens), mapping, argInferrable,
                             List<String>())
  if isEmpty(targets)
    ret mapping
  ret match(ws)
    (nil: ChainEnd) => mapping
    (l: ChainLink)  => whereLoop(l.next, gens,
                                 dischargeOne(l.value, mapping, targets,
                                              instances, r),
                                 argInferrable, instances, r)

fun dischargeOne(wc: Spec, mapping: List<Binding>, targets: List<String>,
                 instances: List<TraitInst>, r: Resolver): List<Binding>
  ret match(substitute(wc, mapping))
    (sub: SClass) => match(solveTraitConstraint(sub, targets, instances, r))
      (b: List<Binding>) => concat(mapping, b)
      ()                 => mapping
    (o: Spec)     => mapping

fun stmtWheres(stmt: PStmt): List<Spec>
  ret match(stmt)
    (f: PsFun)   => f.fWheres
    (l: PsLet)   => l.lWheres
    (c: PsClass) => c.cWheres
    (o: PStmt)   => List<Spec>()

# ── _trait_instances ─────────────────────────────────────────────────────────
# Every `[trait]` instance in scope, CONCRETE instances first. A non-generic
# instance grounds a constraint directly; a generic provider carries its
# params, matched from the constraint's own type args. An instance whose
# witness class has not resolved its parents yet is skipped this pass.

fun traitInstances(r: Resolver): List<TraitInst>
  ret sortByParamCount(instLoop(chain(traitLets(r)), r, List<TraitInst>()))

fun [tail] instLoop(ts: Chain<PStmt>, r: Resolver,
                    acc: List<TraitInst>): List<TraitInst>
  ret match(ts)
    (nil: ChainEnd) => acc
    (l: ChainLink)  => match(l.value)
      (let2: PsLet) => instLoop(l.next, r, instancesOf(let2, r, acc))
      (o: PStmt)    => instLoop(l.next, r, acc)

fun instancesOf(let2: PsLet, r: Resolver, acc: List<TraitInst>): List<TraitInst>
  ret match(let2.lType)
    (dt: Spec) => match(dt)
      (dc: SClass) => match(soleItem(findType(r, dc.scName)))
        (f: Found) => match(f.fStmt)
          (cls: PsClass) => witnessParents(let2, dc, cls, acc)
          (o: PStmt)     => acc
        ()         => acc
      (o2: Spec)   => acc
    ()         => acc

fun witnessParents(let2: PsLet, dc: SClass, cls: PsClass,
                   acc: List<TraitInst>): List<TraitInst>
  ret match(cls.cAllParents)
    (parents: List<Spec>) => parentIfaces(chain(parents),
                                          witnessRemap(dc, cls),
                                          genNames(chain(let2.lGens),
                                                   List<String>()),
                                          acc)
    ()                    => acc     # parents not resolved yet this pass

fun witnessRemap(dc: SClass, cls: PsClass): List<Binding>
  ret !isEmpty(cls.cGens)
      && chainLength(chain(cls.cGens)) == chainLength(chain(dc.scParams))
    ? paramMapping(cls.cGens, dc.scParams)
    : List<Binding>()

fun [tail] parentIfaces(ps: Chain<Spec>, remap: List<Binding>,
                        paramNames: List<String>,
                        acc: List<TraitInst>): List<TraitInst>
  ret match(ps)
    (nil: ChainEnd) => acc
    (l: ChainLink)  => match(l.value)
      (pc: SClass) => parentIfaces(l.next, remap, paramNames,
                                   addIface(substitute(l.value, remap),
                                            paramNames, acc))
      (o: Spec)    => parentIfaces(l.next, remap, paramNames, acc)

fun addIface(iface: Spec, paramNames: List<String>,
             acc: List<TraitInst>): List<TraitInst>
  ret match(iface)
    (ic: SClass) => append(acc, TraitInst(paramNames, ic))
    (o: Spec)    => acc

# Stable insertion sort by param count — concrete (zero-param) instances win
# ties in declaration order, exactly like Python's stable sort.
fun sortByParamCount(is2: List<TraitInst>): List<TraitInst>
  ret isortLoop(chain(is2), List<TraitInst>())

fun [tail] isortLoop(is2: Chain<TraitInst>, acc: List<TraitInst>): List<TraitInst>
  ret match(is2)
    (nil: ChainEnd) => acc
    (l: ChainLink)  => isortLoop(l.next, insertByCount(chain(acc), l.value,
                                                       List<TraitInst>()))

fun [tail] insertByCount(as2: Chain<TraitInst>, x: TraitInst,
                         acc: List<TraitInst>): List<TraitInst>
  ret match(as2)
    (nil: ChainEnd) => append(acc, x)
    (l: ChainLink)  => listLen(x.tiParams) < listLen(l.value.tiParams)
      ? concat(append(acc, x), List<TraitInst>(as2))
      : insertByCount(l.next, x, append(acc, l.value))
