# bootstrap/builders.yafl — parse-time tree transforms ported from parser.py,
# as pure functions over the mirrored nodes. The parser rework calls these
# from its build actions; each mirrors its Python original by name.
namespace Bootstrap

import System

# ── shared little constructors ──────────────────────────────────────────────

fun hashName(name: String, lr: PLine): String
  ret name + "@" + hash6(lr.plFile, lr.plLine, lr.plCol)

fun oneEntryTuple(x: PExpr, lr: PLine): PExpr
  ret PeTuple(append(List<PTupEnt>(), PTupEnt("", false, x)), lr)

fun twoEntryTuple(a: PExpr, b: PExpr, lr: PLine): PExpr
  ret PeTuple(append(append(List<PTupEnt>(), PTupEnt("", false, a)),
                     PTupEnt("", false, b)), lr)

fun callNamed(name: String, args: PExpr, lr: PLine): PExpr
  ret PeCall(PeName(name, List<Spec>(), lr), args, lr)

# ── __to_call_operators / __fold_binary: `a op b` → `op`(a, b), andNot fold ──

fun foldBinary(op: String, lhs: PExpr, rhs: PExpr, lr: PLine): PExpr
  if op == "&"
    ret match(invertOperand(rhs))
      (ir: PExpr) => andNot(lhs, ir, lr)
      ()          => match(invertOperand(lhs))
        (il: PExpr) => andNot(rhs, il, lr)
        ()          => opCall(op, lhs, rhs, lr)
  ret opCall(op, lhs, rhs, lr)

fun opCall(op: String, lhs: PExpr, rhs: PExpr, lr: PLine): PExpr
  ret callNamed("`" + op + "`", twoEntryTuple(lhs, rhs, lr), lr)

fun andNot(a: PExpr, b: PExpr, lr: PLine): PExpr
  ret callNamed("andNot", twoEntryTuple(a, b, lr), lr)

# A `~x` operand's inner expression, when the expression is exactly the
# complement call the unary parser built (`` `~` ``(x)).
fun invertOperand(x: PExpr): PExpr|None
  ret match(x)
    (c: PeCall) => match(c.function)
      (n: PeName) => n.refName == "`~`" ? innerOfUnary(c.parameter) : None
      ()          => None
    ()          => None

fun innerOfUnary(param: PExpr): PExpr|None
  ret match(param)
    (t2: PeTuple) => match(head(t2.exprs))
      (en: PTupEnt) => isEmpty(tail(t2.exprs)) ? en.tupValue : None
      ()            => None
    ()            => None

# ── __to_pipeline: beta-reduction and the `_` placeholder ───────────────────

# `l |> stage`: a lambda stage beta-reduces to a Block binding its params
# from l; a call stage with one `_` placeholder binds l to $pipe@hash and
# substitutes; any other stage becomes stage(l).
fun pipeStage(last: PExpr, stage: PExpr): PExpr
  let holes = placeholderCount(stage)
  if holes == 1
    ret pipePlaceholder(last, stage)
  ret match(stage)
    (lm: PeLambda) => pipeBeta(last, lm)
    ()             => PeCall(stage, pipeArgs(last), exprLine(stage))

# `l |> f` wraps l in a tuple UNLESS it already is one (Python __to_pipeline).
fun pipeArgs(last: PExpr): PExpr
  ret match(last)
    (t2: PeTuple) => last
    (o)           => oneEntryTuple(last, exprLine(last))

fun placeholderCount(stage: PExpr): Int
  ret match(stage)
    (c: PeCall) => match(c.parameter)
      (t2: PeTuple) => countHoles(chain(t2.exprs), 0)
      ()            => 0
    ()          => 0

fun [tail] countHoles(es: Chain<PTupEnt>, acc: Int): Int
  ret match(es)
    (nil: ChainEnd) => acc
    (l: ChainLink)  => countHoles(l.next, acc + (isHole(l.value.tupValue) ? 1 : 0))

fun isHole(x: PExpr): Bool
  ret match(x)
    (n: PeName) => n.refName == "_"
    ()          => false

fun pipePlaceholder(last: PExpr, stage: PExpr): PExpr
  let lr = exprLine(stage)
  let tmp = "$pipe@" + hash6(lr.plFile, lr.plLine, lr.plCol)
  let filled = match(stage)
    (c: PeCall) => PeCall(c.function, fillHole(c.parameter, tmp, lr), c.pecLine)
    (other)     => stage
  let bind = PsLet(tmp, List<PAttr>(), List<PGen>(), None, last, "", List<Spec>(), lr)
  ret PeBlock(append(List<PStmt>(), bind), filled, "", lr)

fun fillHole(param: PExpr, tmp: String, lr: PLine): PExpr
  ret match(param)
    (t2: PeTuple) => PeTuple(map(t2.exprs, (en: PTupEnt) =>
        isHole(en.tupValue)
          ? PTupEnt(en.tupName, en.tupSpread, PeName(tmp, List<Spec>(), lr))
          : en), t2.petLine)
    (other)       => param

# Beta-reduce `l |> (a, b) => body` — CAPTURE-AVOIDING, exactly as parser.py:
# an OUTER block binds `l` to a fresh $pipe@hash intermediate (nothing inside
# `l` can resolve to it), and an INNER block binds the lambda's parameters
# from that name — one target binds it directly, several destructure it.
fun pipeBeta(last: PExpr, lm: PeLambda): PExpr
  let lr = lm.pelLine
  let tmp = "$pipe@" + hash6(lr.plFile, lr.plLine, lr.plCol)
  let ref = PeName(tmp, List<Spec>(), lr)
  let binder = betaBinder(lm.lamParams, ref, lr)
  let inner = PeBlock(append(List<PStmt>(), binder), lm.lamBody, "", lr)
  let outer = PsLet(tmp, List<PAttr>(), List<PGen>(), None, last, "", List<Spec>(), lr)
  ret PeBlock(append(List<PStmt>(), outer), inner, "", lr)

fun betaBinder(params: PStmt, ref: PExpr, lr: PLine): PStmt
  ret match(params)
    (d: PsDestructure) => match(head(d.dTargets))
      (only: PStmt) => isEmpty(tail(d.dTargets))
        ? letWithValue(only, ref)
        : destructureWithValue(d, ref)
      ()            => destructureWithValue(d, ref)
    (o: PStmt)         => o

fun letWithValue(target: PStmt, value: PExpr): PStmt
  ret match(target)
    (l: PsLet) => PsLet(l.lName, l.lAttrs, l.lGens, l.lType, value, l.lArrayLen,
                        l.lWheres, l.pslLine)
    (o: PStmt) => o

# A DestructureStatement WITH a default value: the holder binds the piped
# intermediate and its targets destructure it.
fun destructureWithValue(d: PsDestructure, value: PExpr): PStmt
  ret PsDestructure(d.dName, d.dAttrs, d.dType, d.dTargets, value, d.psdLine)

# ── class constructors (pyast/utils.create_constructor) ────────────────────
# Every non-interface class gets a constructor function of its own name whose
# body is a New expression over a tuple of NAMED entries — one per field.

fun classConstructorOf(st: PStmt): PStmt
  ret match(st)
    (c: PsClass) => classConstructor(c)
    (o: PStmt)   => o

fun classConstructor(c: PsClass): PStmt
  let lr = c.pscLine
  let tps = map(c.cGens, (g2: PGen) => SGeneric(g2.genName, false, g2.pgLine))
  let clsTy = SClass(c.cName, tps, lr)
  let fields = paramsOf(c.cParams)
  let entries = map(fields, (f: PStmt) => ctorEntry(f))
  let body = PeBlock(List<PStmt>(), PeNew(clsTy, PeTuple(entries, lr), lr), "", lr)
  let ctorParams = PsDestructure("_", List<PAttr>(), None,
                                 map(fields, (f: PStmt) => ctorParam(f)), None, lr)
  # The constructor COPIES its class's ImportGroup (create_constructor).
  ret PsFun(c.cName, List<PAttr>(), c.cGens, ctorParams, body, clsTy, c.cWheres,
            lr, false, false, c.cImports)

# An array field is CONSTRUCTED from an initialiser function `(:Int32): Elem`
# whose results are tabulated into the trailing storage (utils.__constructor_param).
fun ctorParam(f: PStmt): PStmt
  ret match(f)
    (l: PsLet) => match(arrayElem(l.lType))
      (el: Spec) => PsLet(l.lName, l.lAttrs, l.lGens,
                         SCallable(STuple(append(List<SEntry>(),
                                     SEntry("", SBuiltin("int32", l.pslLine), None)),
                                    l.pslLine), el, l.pslLine),
                         l.lDefault, l.lArrayLen, l.lWheres, l.pslLine)
      ()        => l
    (o: PStmt) => o

fun ctorEntry(f: PStmt): PTupEnt
  ret match(f)
    (l: PsLet) => PTupEnt(l.lName, false, PeName(l.lName, List<Spec>(), l.pslLine))
    (o: PStmt) => PTupEnt("", false, PeNothing(stmtLine(o)))

fun stmtLine(st: PStmt): PLine
  ret match(st)
    (f: PsFun) => f.psfLine
    (d: PsDestructure) => d.psdLine
    (l: PsLet) => l.pslLine
    (c: PsClass) => c.pscLine
    (e: PsEnum) => e.pseLine
    (ta: PsTypealias) => ta.pstLine
    (im: PsImport) => im.psiLine
    (ns: PsNamespace) => ns.psnLine
    (r: PsRet) => r.psrLine
    (i2: PsIf) => i2.psifLine
    (ei: PsElseIf) => ei.pseiLine
    (el: PsElse) => el.pselLine
    (ac: PsAction) => ac.psaLine

# ── array accessor (pyast/utils.create_array_accessor) ─────────────────────
# A class with a trailing array field gains an accessor member `field@hash6r`
# — a `(Int32): Elem` function reading the element via ArrayRead.

fun withArrayAccessor(c: PsClass): PStmt
  ret match(accessorFor(chain(paramsOf(c.cParams))))
    (acc: PStmt) => PsClass(c.cName, c.cAttrs, c.cGens, c.cParams, c.cImplements,
                            c.cWheres, append(c.cMembers, acc), c.cIsInterface,
                            c.pscLine, c.cAllParents, c.cAllSlots, c.cImports)
    ()           => c

# The accessor is built INSIDE the narrowed arm — a field read through a
# PStmt-typed binder mis-generates (see the open representation bug).
fun [tail] accessorFor(ps: Chain<PStmt>): PStmt|None
  ret match(ps)
    (nil: ChainEnd) => None
    (l: ChainLink)  => match(l.value)
      (let2: PsLet) => match(arrayElem(let2.lType))
        (el: Spec) => arrayAccessor(bareName(let2.lName), el, let2.pslLine)
        ()        => accessorFor(l.next)
      (o: PStmt)    => accessorFor(l.next)

fun arrayElem(ty: Spec|None): Spec|None
  ret match(ty)
    (t2: Spec) => arrayElemOf(t2)
    ()        => None

fun arrayElemOf(t2: Spec): Spec|None
  ret match(t2)
    (af: SArrayField) => af.safElem
    (o)                => None

fun arrayAccessor(field: String, elem: Spec, lr: PLine): PStmt
  let idxName = hashName("index", lr)
  let idx = PsLet(idxName, List<PAttr>(), List<PGen>(), SBuiltin("int32", lr),
                  None, "", List<Spec>(), lr)
  let body = PeBlock(List<PStmt>(),
                     PeArrayRead(PeName("this", List<Spec>(), lr),
                                 PeName(idxName, List<Spec>(), lr), lr), "", lr)
  ret PsFun(field + "@" + hash6(lr.plFile, lr.plLine, lr.plCol) + "r",
            List<PAttr>(), List<PGen>(),
            PsDestructure("_", List<PAttr>(), None, append(List<PStmt>(), idx), None, lr),
            body, elem, List<Spec>(), lr)

fun bareName(name: String): String
  let at = findByte(name, '@', 0)
  ret at < 0 ? name : slice(name, 0, at)

# ── enum leaf constructors (parser.py _create_enum_leaf_constructors) ───────
# Each LEAF (a variant with no variants of its own) gets a constructor named
# after the leaf, taking every field from the root down to it, returning the
# ROOT enum type, its body a NewEnum expression.

fun enumLeafConstructors(root: PsEnum, grp: List<PStmt>): List<PStmt>
  ret leafWalk(root, root, List<PStmt>(), grp, List<PStmt>())

fun leafWalk(root: PsEnum, node: PsEnum, inherited: List<PStmt>,
             grp: List<PStmt>, acc: List<PStmt>): List<PStmt>
  let params = concat(inherited, paramsOf(node.eParams))
  if isEmpty(node.eVariants)
    ret node.eHasParams
      ? append(acc, leafConstructor(root, node, params, grp))
      : acc
  ret variantsWalk(root, chain(node.eVariants), params, grp, acc)

fun [tail] variantsWalk(root: PsEnum, vs: Chain<PStmt>, params: List<PStmt>,
                        grp: List<PStmt>, acc: List<PStmt>): List<PStmt>
  ret match(vs)
    (nil: ChainEnd) => acc
    (l: ChainLink)  => variantsWalk(root, l.next, params, grp,
                                    leafWalkOf(root, l.value, params, grp, acc))

fun leafWalkOf(root: PsEnum, v: PStmt, params: List<PStmt>,
               grp: List<PStmt>, acc: List<PStmt>): List<PStmt>
  ret match(v)
    (e: PsEnum) => leafWalk(root, e, params, grp, acc)
    (o: PStmt)  => acc

fun paramsOf(d: PStmt): List<PStmt>
  ret match(d)
    (ds: PsDestructure) => ds.dTargets
    (o: PStmt)          => List<PStmt>()

fun leafConstructor(root: PsEnum, leaf: PsEnum, params: List<PStmt>,
                    grp: List<PStmt>): PStmt
  let lr = leaf.pseLine
  let tps = map(root.eGens, (g2: PGen) => SGeneric(g2.genName, false, g2.pgLine))
  let retTy = SNamed(root.eName, tps, lr)
  let body = PeBlock(List<PStmt>(),
                     PeNewEnum(root.eName, leaf.eName,
                               map(params, (p: PStmt) =>
                                 PFieldArg(letName(p),
                                           PeName(letName(p), List<Spec>(), lr))),
                               tps, lr), "", lr)
  # A leaf constructor carries the file's ImportGroup, like any top-level fun.
  ret PsFun(leaf.eName, List<PAttr>(), root.eGens,
            PsDestructure("_", List<PAttr>(), None, params, None, lr),
            body, retTy, List<Spec>(), lr, false, false, grp)

fun letName(p: PStmt): String
  ret match(p)
    (l: PsLet) => l.lName
    (o: PStmt) => "_"

# The line_ref Python's combinators give a whole expression PARSE: the first
# token of the expression — which for a call is its callee's start and for a
# dot/ternary its left/condition start — except a parenthesised tuple, whose
# own line is already the post-paren position (requires(sym("("), ...)).
fun startLine(x: PExpr): PLine
  ret match(x)
    (c: PeCall)     => startLine(c.function)
    (d: PeDot)      => startLine(d.base)
    (t3: PeTernary) => startLine(t3.condition)
    (bk: PeBlock)   => blockStart(bk)
    (other)         => exprLine(x)

# A pipe stage beta-reduces to `{ let $pipe = <piped value>; ... }` — the
# expression's PARSE start is still the piped value's, not the lambda's, so
# see through the block the pipeline built.
fun blockStart(bk: PeBlock): PLine
  ret match(head(bk.blockStmts))
    (st: PStmt) => match(st)
      (l: PsLet) => startsWith(l.lName, "$pipe@") ? letStart(l, bk) : bk.pebkLine
      (o: PStmt) => bk.pebkLine
    ()          => bk.pebkLine

fun letStart(l: PsLet, bk: PeBlock): PLine
  ret match(l.lDefault)
    (v: PExpr) => startLine(v)
    ()         => bk.pebkLine

fun exprLine(x: PExpr): PLine
  ret match(x)
    (i: PeInt) => i.peiLine
    (f: PeFloat) => f.pefLine
    (b: PeBool) => b.pebLine
    (s2: PeStr) => s2.pesLine
    (r: PeRegex) => r.perLine
    (n: PeName) => n.penLine
    (d: PeDot) => d.pedLine
    (c: PeCall) => c.pecLine
    (tu: PeTuple) => tu.petLine
    (t3: PeTernary) => t3.pety
    (lm: PeLambda) => lm.pelLine
    (bk: PeBlock) => bk.pebkLine
    (m: PeMatch) => m.pemLine
    (lp: PeLoop) => lp.pelpLine
    (rc: PeRecur) => rc.percLine
    (lz: PeLazy) => lz.pelzLine
    (bo: PeBuiltinOp) => bo.peboLine
    (pl: PeParallel) => pl.pepLine
    (ng: PeNothing) => ng.pengLine
    (ne: PeNewEnum) => ne.penewLine
    (nw: PeNew) => nw.penwLine
    (ar: PeArrayRead) => ar.pearLine
    (cv: PeConvert) => cv.pecvLine

# ── parse() fixups: namespace qualification, import removal ─────────────────
# Mirrors parser.py parse()'s tail: imports and namespaces vanish from the
# output; each named declaration takes the current namespace as a prefix
# (enum variants included, recursively). Constructor/accessor/leaf-constructor
# synthesis is ported separately (create_constructor et al.).

fun fixupProgram(stmts: List<PStmt>): List<PStmt>
  ret fixupLoop(chain(stmts), "Main::",
                importGroupOf(chain(stmts), List<PStmt>()), List<PStmt>())

# The file-wide ImportGroup: every import, AND every namespace declaration (a
# namespace IS an import of itself — that is how a bare `print` finds
# `System::print` inside the stdlib), in file order.
fun [tail] importGroupOf(ss: Chain<PStmt>, acc: List<PStmt>): List<PStmt>
  ret match(ss)
    (nil: ChainEnd) => acc
    (l: ChainLink)  => match(l.value)
      (im: PsImport)    => importGroupOf(l.next, append(acc, l.value))
      (n2: PsNamespace) => importGroupOf(l.next,
                                         append(acc, PsImport(n2.nsPath,
                                                              n2.psnLine)))
      (o: PStmt)        => importGroupOf(l.next, acc)

fun [tail] fixupLoop(ss: Chain<PStmt>, ns: String, grp: List<PStmt>,
                     acc: List<PStmt>): List<PStmt>
  ret match(ss)
    (nil: ChainEnd) => acc
    (l: ChainLink)  => match(l.value)
      (im: PsImport)    => fixupLoop(l.next, ns, grp, acc)
      (n2: PsNamespace) => fixupLoop(l.next, n2.nsPath + "::", grp, acc)
      (e: PsEnum)       => fixupLoop(l.next, ns, grp,
                             concat(append(acc,
                                           withImports(addNamespace(e, ns), grp)),
                                    enumLeafConstructors(namespacedEnum(e, ns),
                                                         grp)))
      (c: PsClass)      => fixupLoop(l.next, ns, grp, classWithCtor(c, ns, grp, acc))
      (other)           => fixupLoop(l.next, ns, grp,
                                     withImports(addNamespace(l.value, ns), grp)
                                       |> (st) => append(acc, st))

# Attach the ImportGroup to a NAMED statement (the kinds parse() attaches to).
fun withImports(st: PStmt, grp: List<PStmt>): PStmt
  ret match(st)
    (f: PsFun)  => PsFun(f.fName, f.fAttrs, f.fGens, f.fParams, f.fBody,
                         f.fRet, f.fWheres, f.psfLine, f.fRetInferred,
                         f.fNested, grp)
    (l: PsLet)  => PsLet(l.lName, l.lAttrs, l.lGens, l.lType, l.lDefault,
                         l.lArrayLen, l.lWheres, l.pslLine, l.lTypeInferred,
                         grp)
    (c: PsClass) => PsClass(c.cName, c.cAttrs, c.cGens, c.cParams,
                            c.cImplements, c.cWheres, c.cMembers,
                            c.cIsInterface, c.pscLine, c.cAllParents,
                            c.cAllSlots, grp)
    (ta: PsTypealias) => PsTypealias(ta.taName, ta.taAttrs, ta.taGens,
                                     ta.taType, ta.taWheres, ta.pstLine, grp)
    (e: PsEnum) => PsEnum(e.eName, e.eGens, e.eParams, e.eVariants,
                          e.eHasParams, e.pseLine, e.eRootName, e.eSpec, grp)
    (other)     => st

# A class emits itself then its constructor (interfaces get neither).
fun classWithCtor(c: PsClass, ns: String, grp: List<PStmt>,
                  acc: List<PStmt>): List<PStmt>
  let named = importedClass(namespacedClass(c, ns), grp)
  ret c.cIsInterface
    ? append(acc, named)
    : withArrayAccessor(named)
      |> (full) => append(append(acc, full), classConstructorOf(full))

fun importedClass(c: PsClass, grp: List<PStmt>): PsClass
  ret match(withImports(c, grp))
    (c2: PsClass) => c2
    (other)       => c

fun namespacedClass(c: PsClass, ns: String): PsClass
  ret match(addNamespace(c, ns))
    (c2: PsClass) => c2
    (other)       => c

fun namespacedEnum(e: PsEnum, ns: String): PsEnum
  ret match(addNamespace(e, ns))
    (e2: PsEnum) => e2
    (other)      => e

fun addNamespace(st: PStmt, ns: String): PStmt
  ret match(st)
    (f: PsFun)  => PsFun(ns + f.fName, f.fAttrs, f.fGens, f.fParams, f.fBody,
                         f.fRet, f.fWheres, f.psfLine)
    (l: PsLet)  => PsLet(ns + l.lName, l.lAttrs, l.lGens, l.lType, l.lDefault,
                         l.lArrayLen, l.lWheres, l.pslLine)
    (c: PsClass) => PsClass(ns + c.cName, c.cAttrs, c.cGens, c.cParams,
                            c.cImplements, c.cWheres, c.cMembers,
                            c.cIsInterface, c.pscLine)
    (ta: PsTypealias) => PsTypealias(ns + ta.taName, ta.taAttrs, ta.taGens,
                                     ta.taType, ta.taWheres, ta.pstLine)
    (e: PsEnum) => PsEnum(ns + e.eName, e.eGens, e.eParams,
                          map(e.eVariants, (v: PStmt) => addNamespace(v, ns)),
                          e.eHasParams, e.pseLine)
    (other)     => st
