# bootstrap/algebra.yafl — the type algebra, ported from
# compiler/pyast/typespec/algebra.py: substitution, placeholder scanning, the
# meet/refine refinement rules the compile fixpoint relies on, and generic
# unification. Pure functions of specs (+ a read-only scope for resolution
# questions); nothing here mutates.
#
# Conflict is a VALUE (MConflict), distinct from "no information" (MNone) —
# statement-level callers use refine, which absorbs conflicts.
namespace Bootstrap::Types

import System

import Bootstrap::Ast
import Bootstrap::Driver
import Bootstrap::Parse
import Bootstrap::Resolve



# meet's three-way result: a refined type, no information, or a real clash.
enum Meet
  enum MSpec(mSpec: Spec)
  enum MNone()
  enum MConflict()

# ── placeholders ────────────────────────────────────────────────────────────

# A HOLE carries no type information yet: absent, an unbound placeholder, or a
# still-unresolved name.
fun isHole(sp: Spec|None) => match(sp)
  (s2: Spec) => isHoleSpec(s2)
  ()         => true

fun isHoleSpec(sp: Spec) => match(sp)
  (g: SGeneric) => true
  (n: SNamed)   => true
  (o)           => false

# A LIST with a linear dedup, NOT a Set — deliberately.
#
# A spec mentions one to three placeholders. This is called from
# hasFreePlaceholders and sharesName, which sit in the type algebra's hot
# path: every assignability and unification check reaches here. A Set means a
# hash-tree allocation per call to hold three names, which costs far more than
# the cons cells plus a three-element scan. Dedupe still happens (a
# placeholder in several positions is one placeholder); it just happens
# against the short list.
fun placeholderNames(sp) => phNames(sp, List())

fun phAdd(acc, n): List<String> => any(acc, (y) => y == n) ? acc : prepend(n, acc)

fun phNames(sp, acc): List<String> => match(sp)
  (g: SGeneric)      => phAdd(acc, g.sgName)
  (c: SClass)        => phList(chain(c.scParams), acc)
  (e: SEnum)         => phList(chain(e.seParams), acc)
  (n: SNamed)        => phList(chain(n.snParams), acc)
  (cm: SCombination) => phList(chain(cm.scTypes), acc)
  (cl: SCallable)    => phOpt(cl.scResult, phNames(cl.scParams2, acc))
  (t2: STuple)       => phEntries(chain(t2.stEntries), acc)
  (af: SArrayField)  => phNames(af.safElem, acc)
  (ls: SLazyStub)    => phOpt(ls.slsTarget, acc)
  (b: SBuiltin)      => acc

fun [tail] phList(ts: Chain<Spec>, acc: List<String>) => match(ts)
  (nil: ChainEnd) => acc
  (l: ChainLink)  => phList(l.next, phNames(l.value, acc))

fun [tail] phEntries(es: Chain<SEntry>, acc): List<String> => match(es)
  (nil: ChainEnd) => acc
  (l: ChainLink)  => phEntries(l.next, phOpt(l.value.seType, acc))

fun phOpt(sp: Spec|None, acc): List<String> => match(sp)
  (s2: Spec) => phNames(s2, acc)
  ()         => acc

# ── substitution ────────────────────────────────────────────────────────────
# substitute_placeholders: replace every placeholder named in `mapping` with
# its concrete type, throughout the spec. Unions are re-canonicalised after
# substitution (a substituted member can create a ground duplicate, and a
# duplicate must not survive as a distinct SPELLING).

class [final] Binding(bName: String, bSpec: Spec)

fun substitute(sp, mapping: List<Binding>)
  if isEmpty(mapping)
    ret sp
  ret match(sp)
    (g: SGeneric)      => substGeneric(sp, mapping, g.sgName)
    (c: SClass)        => SClass(c.scName, substList(c.scParams, mapping), c.scLine)
    (e: SEnum)         => SEnum(e.seRoot, e.seValidLeaves, e.seAllLeaves,
                                substList(e.seParams, mapping), e.seLine)
    (n: SNamed)        => SNamed(n.snName, substList(n.snParams, mapping), n.snLine)
    (cm: SCombination) => canonUnion(SCombination(substList(cm.scTypes, mapping),
                                                  cm.scmLine))
    (cl: SCallable)    => SCallable(substitute(cl.scParams2, mapping),
                                    substOpt(cl.scResult, mapping), cl.sclLine)
    (t2: STuple)       => STuple(substEntries(t2.stEntries, mapping), t2.stLine)
    (af: SArrayField)  => SArrayField(substitute(af.safElem, mapping),
                                      af.safLenField, af.safLine)
    (ls: SLazyStub)    => SLazyStub(substOpt(ls.slsTarget, mapping), ls.slsLine)
    (b: SBuiltin)      => sp

fun substGeneric(sp, mapping: List<Binding>, name: String) => match(bindingOf(mapping, name))
  (b: Spec) => b
  ()        => sp

fun substList(ts: List<Spec>, mapping: List<Binding>) => substLoop(chain(ts), mapping, builder())

fun [tail] substLoop(ts: Chain<Spec>, mapping: List<Binding>,
                     acc: ListBuilder<Spec>) => match(ts)
  (nil: ChainEnd) => build(acc)
  (l: ChainLink)  => substLoop(l.next, mapping, push(acc, substitute(l.value, mapping)))

fun substOpt(sp: Spec|None, mapping: List<Binding>) => match(sp)
  (s2: Spec) => substitute(s2, mapping)
  ()         => None

fun substEntries(es: List<SEntry>, mapping: List<Binding>)
  ret substEntLoop(chain(es), mapping, List())

fun substEntLoop(es: Chain<SEntry>, mapping: List<Binding>,
                        acc: List<SEntry>) => build(substEntLoopB(es, mapping, builderFrom(acc)))

fun [tail] substEntLoopB(es: Chain<SEntry>, mapping: List<Binding>,
                        [terminal] acc): ListBuilder<SEntry> => match(es)
  (nil: ChainEnd) => acc
  (l: ChainLink)  => substEntLoopB(l.next, mapping,
      push(acc, SEntry(l.value.seName, substOpt(l.value.seType, mapping),
                l.value.seDefault)))

fun bindingOf(ms: List<Binding>, name: String) => bindingLoop(chain(ms), name)

fun [tail] bindingLoop(ms: Chain<Binding>, name: String) => match(ms)
  (nil: ChainEnd) => None
  (l: ChainLink)  => l.value.bName == name ? l.value.bSpec : bindingLoop(l.next, name)

# A union whose canonical members collapse to one IS that one type.
fun canonUnion(sp) => match(sp)
  (cm: SCombination) => canonMembers(reprMembers(cm), cm.scmLine, sp)
  (o)                => sp

fun canonMembers(members, lr, orig) => match(head(members))
  (only: Spec) => isEmpty(tail(members)) ? only : SCombination(members, lr)
  ()           => orig

# ── meet / refine ───────────────────────────────────────────────────────────
# meet: the most-refined common form of two possibly-partial types. A hole is
# refined by the other side; compounds meet element-wise and propagate a
# conflict; two ground leaves must be equal. Symmetric.

# ── merge (docs/type-merge-design.md) ───────────────────────────────────────
# The one type merge. LEFT is the receiver, RIGHT the value: left must be
# assignable from right. Fills gaps and resolves hierarchy, never widens.
# Returns the best correct answer (None when nothing merges), the bindings
# extended by what was learned (returned, never mutated) and every
# contradiction found — the caller collects them and carries on.
#
# A HOLE is absent, an unresolved name, or a placeholder that does not resolve
# in scope; it takes the other side. A placeholder listed in the bindings is a
# NAMED hole — the reference site's mapping (`T@callee = Int`, or another
# scope's `T@caller`): unbound it binds once, bound it must agree — holes
# inside the binding fill, nothing widens it. Generic ARGUMENTS are invariant
# (hole-filling only); a generic spelled without arguments (a leaf pattern
# `ListFull`) is a shape whose every argument is a hole. A value lifts to the
# receiver's head through its class's recorded ancestor spelling (cAllParents:
# `Car<X,Y>` records `Automobile<Y>`); an ancestor never fits a descendant.
# Callable parameters reverse direction.

class [final] MBind(mbName: String, mbSpec: Spec|None)
class [final] MergeOut(moSpec: Spec|None, moBinds: List<MBind>, moErrs: Set<PErr>)
class [final] MergeArgs(maSpecs: List<Spec>|None, maBinds: List<MBind>, maErrs: Set<PErr>)

fun mergeSpecs(left: Spec|None, right: Spec|None, binds: List<MBind>, r): MergeOut
  ret mgGo(left, right, binds, false, false, true, r)

# `widen`: for a STORED inference only (refine) — a narrowed enum view there is
# provisional, so a receiver's view widens to the union of both views,
# arguments included, instead of conflicting.
#
# `calleeLeft`: which side is the CALLEE's own spelling — the only side where a
# bound name is a hole (it flips through callable parameters). On the other
# side the same name is the reference site's: its own type in scope, else a
# leaked unbound placeholder — an anonymous hole (a nested call to the same
# generic sees the outer call's unbound V under the name of its own V).
fun mergeSpecsWidening(left: Spec|None, right: Spec|None, binds: List<MBind>,
                       calleeLeft: Bool, r): MergeOut
  ret mgGo(left, right, binds, false, true, calleeLeft, r)

fun mgBindable(binds: List<MBind>, name) => any(binds, (b) => b.mbName == name)

fun mgBoundSpec(binds: List<MBind>, name): Spec|None => match(head(filter(binds, (b) => b.mbName == name)))
  (b: MBind) => b.mbSpec
  ()         => None

fun mgRebind(binds: List<MBind>, name, sp: Spec|None) => map(binds, (b) => b.mbName == name ? MBind(name, sp) : b)

fun mgBindableName(x: Spec|None, binds: List<MBind>, calleeSide: Bool): String => match(x)
  (s2: Spec) => match(s2)
    (g: SGeneric) => calleeSide && mgBindable(binds, g.sgName) ? g.sgName : ""
    (o: Spec)     => ""
  ()         => ""

fun mgIsHole(x: Spec|None, binds: List<MBind>, calleeSide: Bool, r): Bool => match(x)
  (s2: Spec) => match(s2)
    (n: SNamed)   => true
    (g: SGeneric) => !(calleeSide && mgBindable(binds, g.sgName)) && !resolvesInScope(g.sgName, r)
    (o: Spec)     => false
  ()         => true

fun mgLine(x: Spec|None) => match(x)
  (s2: Spec) => specLine(s2)
  ()         => PLine("", 0, 0)

fun mgOk(sp: Spec|None, binds: List<MBind>) => MergeOut(sp, binds, noErrs())

fun mgConflict(l: Spec|None, rr: Spec|None, binds: List<MBind>, why): MergeOut
  let at = match(rr)
    (rs: Spec) => specLine(rs)
    ()         => mgLine(l)
  ret MergeOut(None, binds, oneErr(at, "cannot merge " + Bootstrap::Frontend::typeStr(l)
                                          + " with " + Bootstrap::Frontend::typeStr(rr) + ": " + why))

# A named hole meeting `other`; `holderLeft` says which side it is on.
# Bound: agree with it — holes inside the binding fill, nothing widens it.
# Both sides are the reference site's types now, so no name in them is a named
# hole (`S@drain = S@drain` in a self-recursive call is the caller's own S).
fun mgNamed(name, other: Spec|None, binds: List<MBind>, holderLeft: Bool, wv: Bool, cl: Bool, r): MergeOut => match(mgBoundSpec(binds, name))
  (bound: Spec) => mgAgree(name, binds, holderLeft ? mgGo(bound, other, List<MBind>(), true, wv, true, r)
                                                  : mgGo(other, bound, List<MBind>(), true, wv, true, r))
  ()            => mgIsHole(other, binds, false, r)
    ? mgOk(SGeneric(name, false, mgLine(other)), binds)
    : mgOk(other, mgRebind(binds, name, other))

fun mgAgree(name, binds: List<MBind>, m: MergeOut): MergeOut => isEmpty(m.moErrs)
  ? mgOk(m.moSpec, mgRebind(binds, name, m.moSpec))
  : MergeOut(None, binds, m.moErrs)

fun mgGo(l: Spec|None, rr: Spec|None, binds: List<MBind>, inv: Bool, wv: Bool, cl: Bool, r): MergeOut
  let ln = mgBindableName(l, binds, cl)
  if ln != ""
    ret mgNamed(ln, rr, binds, true, wv, cl, r)
  let rn = mgBindableName(rr, binds, !cl)
  if rn != ""
    ret mgNamed(rn, l, binds, false, wv, cl, r)
  if mgIsHole(l, binds, cl, r)
    ret mgOk(rr, binds)
  if mgIsHole(rr, binds, !cl, r)
    ret mgOk(l, binds)
  ret match(l)
    (ls: Spec) => match(rr)
      (rs: Spec) => mgShapes(ls, rs, binds, inv, wv, cl, r)
      ()         => mgOk(l, binds)
    ()         => mgOk(rr, binds)

fun mgIsUnion(x) => match(x)
  (cm: SCombination) => true
  (o: Spec)          => false

fun mgIsTuple(x) => match(x)
  (t2: STuple) => true
  (o: Spec)    => false

fun mgIsGeneric(x) => match(x)
  (g: SGeneric) => true
  (o: Spec)     => false

# A 1-tuple's element, or None when `x` is not a 1-tuple.
fun mgSingle(x): SEntry|None => match(x)
  (t2: STuple) => exactly(chain(t2.stEntries), 1) ? head(t2.stEntries) : None
  (o: Spec)    => None

fun mgShapes(l: Spec, rr: Spec, binds: List<MBind>, inv: Bool, wv: Bool, cl: Bool, r): MergeOut
  if mgIsUnion(l) || mgIsUnion(rr)
    ret mgUnions(l, rr, binds, inv, wv, cl, r)
  # A 1-tuple is its element.
  if !mgIsTuple(rr)
    ret match(mgSingle(l))
      (e: SEntry) => mgGo(e.seType, rr, binds, inv, wv, cl, r)
      ()          => mgShapes2(l, rr, binds, inv, wv, cl, r)
  if !mgIsTuple(l)
    ret match(mgSingle(rr))
      (e: SEntry) => mgGo(l, e.seType, binds, inv, wv, cl, r)
      ()          => mgShapes2(l, rr, binds, inv, wv, cl, r)
  ret mgShapes2(l, rr, binds, inv, wv, cl, r)

fun mgShapes2(l: Spec, rr: Spec, binds: List<MBind>, inv: Bool, wv: Bool, cl: Bool, r): MergeOut
  # In scope on both sides: a real type, equal only to itself.
  if mgIsGeneric(l) || mgIsGeneric(rr)
    ret mgSameOrConflict(l, rr, binds)
  ret match(l)
    (lt: STuple)    => match(rr)
      (rt: STuple) => mgTuples(lt, rt, binds, inv, wv, cl, r)
      (o: Spec)    => mgSameOrConflict(l, rr, binds)
    (le: SEnum)     => match(rr)
      (re2: SEnum) => mgEnums(le, re2, binds, inv, wv, cl, r)
      (o: Spec)    => mgSameOrConflict(l, rr, binds)
    (lc: SClass)    => match(rr)
      (rc: SClass) => mgClasses(lc, rc, binds, inv, wv, cl, r)
      (o: Spec)    => mgSameOrConflict(l, rr, binds)
    (lf: SCallable) => match(rr)
      (rf: SCallable) => mgCallables(lf, rf, binds, inv, wv, cl, r)
      (o: Spec)       => mgSameOrConflict(l, rr, binds)
    (o: Spec)       => mgSameOrConflict(l, rr, binds)

fun mgSameOrConflict(l, rr, binds: List<MBind>) => eqSpec(l, rr)
  ? mgOk(l, binds)
  : mgConflict(l, rr, binds, "different types")

fun mgCallables(l: SCallable, rr: SCallable, binds: List<MBind>, inv: Bool, wv: Bool, cl: Bool, r): MergeOut
  let p = mgGo(rr.scParams2, l.scParams2, binds, inv, wv, !cl, r)      # reversed
  let res = mgGo(l.scResult, rr.scResult, p.moBinds, inv, wv, cl, r)
  if !isEmpty(p.moErrs) || !isEmpty(res.moErrs)
    ret MergeOut(None, res.moBinds, union(p.moErrs, res.moErrs))
  ret match(p.moSpec)
    (ps: Spec) => mgOk(SCallable(ps, res.moSpec, l.sclLine), res.moBinds)
    ()         => mgOk(SCallable(l.scParams2, res.moSpec, l.sclLine), res.moBinds)

fun mgTuples(l: STuple, rr: STuple, binds: List<MBind>, inv: Bool, wv: Bool, cl: Bool, r): MergeOut
  ret match(bindTupleEntries(l.stEntries, map(rr.stEntries, (e) => e.seName)))
    (b: List<Int>) => mgEntries(chain(l.stEntries), chain(b), rr.stEntries, binds, inv, wv, cl, r,
                                builder(), noErrs(), l)
    ()             => mgConflict(l, rr, binds, "tuple shapes differ")

fun [tail] mgEntries(ls: Chain<SEntry>, bs: Chain<Int>, rs: List<SEntry>, binds: List<MBind>,
                     inv: Bool, wv: Bool, cl: Bool, r, [terminal] acc: ListBuilder<SEntry>, errs: Set<PErr>,
                     l: STuple): MergeOut => match(ls)
  (nil: ChainEnd) => mgEntriesDone(build(acc), binds, errs, l)
  (le: ChainLink) => match(bs)
    (nil2: ChainEnd) => mgEntriesDone(build(acc), binds, errs, l)
    (bl: ChainLink)  => match(bl.value < 0 ? None : head(drop(rs, bl.value)))
      (re2: SEntry) => mgGo(le.value.seType, re2.seType, binds, inv, wv, cl, r)
        |> (m) => mgEntries(le.next, bl.next, rs, m.moBinds, inv, wv, cl, r,
                            push(acc, SEntry(le.value.seName != "" ? le.value.seName : re2.seName,
                                             m.moSpec, le.value.seDefault)),
                            union(errs, m.moErrs), l)
      ()            => mgEntries(le.next, bl.next, rs, binds, inv, wv, cl, r, push(acc, le.value), errs, l)

fun mgEntriesDone(es: List<SEntry>, binds: List<MBind>, errs: Set<PErr>, l: STuple) => isEmpty(errs)
  ? mgOk(STuple(es, l.stLine), binds)
  : MergeOut(None, binds, errs)

fun mgEnums(l: SEnum, rr: SEnum, binds: List<MBind>, inv: Bool, wv: Bool, cl: Bool, r): MergeOut
  if l.seRoot != rr.seRoot
    ret mgConflict(l, rr, binds, "different enums")
  if !wv && inv && !(allIn(chain(l.seValidLeaves), rr.seValidLeaves) && allIn(chain(rr.seValidLeaves), l.seValidLeaves))
    ret mgConflict(l, rr, binds, "different views of one enum are different types")
  if !wv && !allIn(chain(rr.seValidLeaves), l.seValidLeaves)
    ret mgConflict(l, rr, binds, "the receiver cannot hold every variant of the value")
  let leaves = wv ? unionLeaves(l.seValidLeaves, rr.seValidLeaves) : l.seValidLeaves
  let a = mgArgs(l.seParams, rr.seParams, binds, wv, cl, r)
  ret match(a.maSpecs)
    (ps: List<Spec>) => mgOk(SEnum(l.seRoot, leaves, l.seAllLeaves, ps, l.seLine), a.maBinds)
    ()               => MergeOut(None, a.maBinds, a.maErrs)

fun mgClasses(l: SClass, rr: SClass, binds: List<MBind>, inv: Bool, wv: Bool, cl: Bool, r): MergeOut
  if l.scName == rr.scName
    ret mgSameClass(l, mgArgs(l.scParams, rr.scParams, binds, wv, cl, r))
  if inv
    ret mgConflict(l, rr, binds, "different types")
  # Lift the value to the receiver's head along its recorded ancestry.
  ret match(soleItem(findType(r, rr.scName)))
    (f: Found) => match(f.fStmt)
      (cls: PsClass) => match(cls.cAllParents)
        (ps: List<Spec>) => match(head(filter(ps, (p) => mgNamesClass(p, l.scName))))
          (anc: Spec) => mgGo(l, substitute(anc, mgOwn(chain(cls.cGens), chain(rr.scParams), List())),
                              binds, false, wv, cl, r)
          ()          => mgConflict(l, rr, binds, "the value's class does not implement the receiver")
        ()               => mgOk(l, binds)    # ancestry not known yet: nothing to add
      (o: PStmt)     => mgConflict(l, rr, binds, "unrelated types")
    ()         => mgConflict(l, rr, binds, "unrelated types")

fun mgSameClass(l: SClass, a: MergeArgs) => match(a.maSpecs)
  (ps: List<Spec>) => mgOk(SClass(l.scName, ps, l.scLine), a.maBinds)
  ()               => MergeOut(None, a.maBinds, a.maErrs)

fun mgNamesClass(p, name) => match(p)
  (c: SClass) => c.scName == name
  (o: Spec)   => false

fun [tail] mgOwn(gs: Chain<PGen>, as2: Chain<Spec>, acc: List<Binding>): List<Binding> => match(gs)
  (nil: ChainEnd) => acc
  (g: ChainLink)  => match(as2)
    (nil2: ChainEnd) => acc
    (a: ChainLink)   => mgOwn(g.next, a.next, prepend(Binding(g.value.genName, a.value), acc))

# Invariant generic arguments; an argument list left unspelled is all holes.
fun mgArgs(la: List<Spec>, ra: List<Spec>, binds: List<MBind>, wv: Bool, cl: Bool, r): MergeArgs
  if isEmpty(la)
    ret MergeArgs(ra, binds, noErrs())
  if isEmpty(ra)
    ret MergeArgs(la, binds, noErrs())
  if !sameLen(chain(la), chain(ra))
    ret MergeArgs(None, binds, oneErr(mgLine(head(la)), "cannot merge: generic argument counts differ"))
  ret mgArgLoop(chain(la), chain(ra), binds, wv, cl, r, builder(), noErrs())

fun [tail] mgArgLoop(ls: Chain<Spec>, rs: Chain<Spec>, binds: List<MBind>, wv: Bool, cl: Bool, r,
                     [terminal] acc: ListBuilder<Spec>, errs: Set<PErr>): MergeArgs => match(ls)
  (nil: ChainEnd) => mgArgsDone(build(acc), binds, errs)
  (l: ChainLink)  => match(rs)
    (nil2: ChainEnd) => mgArgsDone(build(acc), binds, errs)
    (rl: ChainLink)  => mgGo(l.value, rl.value, binds, true, wv, cl, r)
      |> (m) => mgArgLoop(l.next, rl.next, m.moBinds, wv, cl, r, mgPushOpt(acc, m.moSpec),
                          union(errs, m.moErrs))

fun mgPushOpt([terminal] acc: ListBuilder<Spec>, sp: Spec|None): ListBuilder<Spec> => match(sp)
  (s2: Spec) => push(acc, s2)
  ()         => acc

fun mgArgsDone(ps: List<Spec>, binds: List<MBind>, errs: Set<PErr>) => isEmpty(errs)
  ? MergeArgs(ps, binds, errs)
  : MergeArgs(None, binds, errs)

# A union is a SET. Value members pair with receiver members first; then a
# single callee-side named hole takes what is left by set difference — on the
# value side the receiver members nobody matched, on the receiver side the
# value members nobody placed (the error-growing `E | ParseError` pattern). An
# anonymous receiver hole stands for the rest and becomes what it took.
# Several holes on one side have no partition and stay as they are.
fun mgUnions(l: Spec, rr: Spec, binds: List<MBind>, inv: Bool, wv: Bool, cl: Bool, r): MergeOut
  let lMembers = mgMembers(l)
  let rMembers = mgMembers(rr)
  if !mgIsUnion(l)
    # Every member of the value must fit the one receiver.
    ret mgAllInto(chain(rMembers), l, binds, inv, wv, cl, r, noErrs())
  let rHoles = filter(rMembers, (m) => mgBindableName(m, binds, !cl) != "")
  let rGround = filter(rMembers, (m) => mgBindableName(m, binds, !cl) == "")
  ret mgEachFinds(chain(rGround), lMembers, List<Int>(), List<Spec>(), binds, inv, wv, cl, r,
                  noErrs(), l, rr, rHoles)

fun mgLeftHole(m, binds: List<MBind>, cl: Bool, r) => mgIsHole(m, binds, cl, r) || mgBindableName(m, binds, cl) != ""

fun mgMembers(x) => match(x)
  (cm: SCombination) => reprMembers(cm)
  (o: Spec)          => prepend(x, List<Spec>())

fun [tail] mgAllInto(rs: Chain<Spec>, out: Spec|None, binds: List<MBind>, inv: Bool, wv: Bool, cl: Bool, r,
                     errs: Set<PErr>): MergeOut => match(rs)
  (nil: ChainEnd) => isEmpty(errs) ? mgOk(out, binds) : MergeOut(None, binds, errs)
  (l: ChainLink)  => mgGo(out, l.value, binds, inv, wv, cl, r)
    |> (m) => match(m.moSpec)
      (sp: Spec) => mgAllInto(l.next, sp, m.moBinds, inv, wv, cl, r, union(errs, m.moErrs))
      ()         => MergeOut(None, m.moBinds, union(errs, m.moErrs))

# Each value member finds the receiver member that takes it; one no member
# takes lands in a receiver HOLE.
fun [tail] mgEachFinds(rs: Chain<Spec>, members: List<Spec>, matched: List<Int>,
                       absorbed: List<Spec>, binds: List<MBind>, inv: Bool, wv: Bool, cl: Bool, r,
                       errs: Set<PErr>, l: Spec, rr: Spec, rHoles: List<Spec>): MergeOut => match(rs)
  (nil: ChainEnd) => mgValueHole(members, matched, absorbed, binds, inv, wv, cl, r, errs, l, rr, rHoles)
  (x: ChainLink)  => match(mgFindMember(chain(members), 0, x.value, binds, inv, wv, cl, r))
    (fm: MgFound) => mgEachFinds(x.next, mgSetAt(members, fm.mfIndex, fm.mfSpec),
                                 prepend(fm.mfIndex, matched), absorbed, fm.mfBinds, inv, wv, cl, r,
                                 errs, l, rr, rHoles)
    ()            => any(members, (m) => mgLeftHole(m, binds, cl, r))
      ? mgEachFinds(x.next, members, matched, build(push(builderFrom(absorbed), x.value)),
                    binds, inv, wv, cl, r, errs, l, rr, rHoles)
      : mgEachFinds(x.next, members, matched, absorbed, binds, inv, wv, cl, r,
                    union(errs, mgConflict(l, x.value, binds,
                                           "the receiver has no member for it").moErrs),
                    l, rr, rHoles)

# A value-side named hole: the receiver members nobody matched.
fun mgValueHole(members: List<Spec>, matched: List<Int>, absorbed: List<Spec>, binds: List<MBind>,
                inv: Bool, wv: Bool, cl: Bool, r, errs: Set<PErr>, l: Spec, rr: Spec,
                rHoles: List<Spec>): MergeOut
  let restIx = mgRestIndexes(chain(members), 0, matched, binds, cl, r, List<Int>())
  if !exactly(chain(rHoles), 1) || isEmpty(restIx)
    ret mgReceiverHole(members, matched, absorbed, binds, inv, wv, cl, r, errs, l, rr)
  let rest = mgAtIndexes(members, restIx)
  let m = mgNamed(mgBindableName(head(rHoles), binds, !cl), mgAsType(rest, l), binds, false, wv, cl, r)
  ret mgReceiverHole(members, concat(matched, restIx), absorbed, m.moBinds, inv, wv, cl, r,
                     union(errs, m.moErrs), l, rr)

# A receiver-side named hole: the value members nobody placed.
fun mgReceiverHole(members: List<Spec>, matched: List<Int>, absorbed: List<Spec>, binds: List<MBind>,
                   inv: Bool, wv: Bool, cl: Bool, r, errs: Set<PErr>, l: Spec, rr: Spec): MergeOut
  let lNamed = filter(members, (m) => mgBindableName(m, binds, cl) != "")
  if isEmpty(absorbed) || !exactly(chain(lNamed), 1) || any(members, (m) => mgIsHole(m, binds, cl, r))
    ret mgUnionDone(members, matched, absorbed, binds, inv, wv, cl, r, errs, l, rr)
  let m = mgNamed(mgBindableName(head(lNamed), binds, cl), mgAsType(absorbed, l), binds, true, wv, cl, r)
  ret mgUnionDone(members, matched, absorbed, m.moBinds, inv, wv, cl, r, union(errs, m.moErrs), l, rr)

fun mgAbsorb(members: List<Spec>, absorbed: List<Spec>, binds: List<MBind>, cl: Bool, r) => isEmpty(absorbed)
  ? members
  : concat(filter(members, (m) => !mgLeftHole(m, binds, cl, r)), absorbed)

fun mgAsType(ms: List<Spec>, l: Spec) => match(head(ms))
  (only: Spec) => exactly(chain(ms), 1) ? only : SCombination(ms, specLine(l))
  ()           => l

fun [tail] mgRestIndexes(ms: Chain<Spec>, i: Int, matched: List<Int>, binds: List<MBind>, cl: Bool,
                         r, acc: List<Int>): List<Int> => match(ms)
  (nil: ChainEnd) => acc
  (x: ChainLink)  => !any(matched, (j) => j == i) && !mgLeftHole(x.value, binds, cl, r)
    ? mgRestIndexes(x.next, i + 1, matched, binds, cl, r, build(push(builderFrom(acc), i)))
    : mgRestIndexes(x.next, i + 1, matched, binds, cl, r, acc)

fun mgAtIndexes(ms: List<Spec>, ixs: List<Int>): List<Spec> => fold(ixs, List<Spec>(), (acc, i) => mgPushAt(acc, ms, i))

fun mgPushAt(acc: List<Spec>, ms: List<Spec>, i: Int): List<Spec> => match(head(drop(ms, i)))
  (sp: Spec) => build(push(builderFrom(acc), sp))
  ()         => acc

class [final] MgFound(mfIndex: Int, mfSpec: Spec|None, mfBinds: List<MBind>)

fun [tail] mgFindMember(ms: Chain<Spec>, i: Int, v: Spec, binds: List<MBind>, inv: Bool, wv: Bool, cl: Bool,
                        r): MgFound|None => match(ms)
  (nil: ChainEnd) => None
  (l: ChainLink)  => mgLeftHole(l.value, binds, cl, r)
    ? mgFindMember(l.next, i + 1, v, binds, inv, wv, cl, r)
    : mgGo(l.value, v, binds, inv, wv, cl, r)
      |> (m) => isEmpty(m.moErrs)
        ? MgFound(i, m.moSpec, m.moBinds)
        : mgFindMember(l.next, i + 1, v, binds, inv, wv, cl, r)

fun mgSetAt(ms: List<Spec>, i: Int, v: Spec|None): List<Spec> => match(v)
  (sp: Spec) => mgSetLoop(chain(ms), 0, i, sp, builder())
  ()         => ms

fun [tail] mgSetLoop(ms: Chain<Spec>, j: Int, i: Int, v: Spec,
                     [terminal] acc: ListBuilder<Spec>): List<Spec> => match(ms)
  (nil: ChainEnd) => build(acc)
  (l: ChainLink)  => mgSetLoop(l.next, j + 1, i, v, push(acc, j == i ? v : l.value))

fun mgUnionDone(members: List<Spec>, matched: List<Int>, absorbed: List<Spec>,
                binds: List<MBind>, inv: Bool, wv: Bool, cl: Bool, r, errs: Set<PErr>, l: Spec, rr: Spec): MergeOut
  let unmatched = inv && isEmpty(errs) && mgAnyUnmatched(chain(members), 0, matched, binds, cl, r)
  let all = unmatched ? union(errs, mgConflict(l, rr, binds, "different unions").moErrs) : errs
  if !isEmpty(all)
    ret MergeOut(None, binds, all)
  let out = reprMembersOf(mgAbsorb(members, absorbed, binds, cl, r))
  ret match(head(out))
    (only: Spec) => mgOk(exactly(chain(out), 1) ? only : SCombination(out, specLine(l)), binds)
    ()           => mgOk(l, binds)

fun [tail] mgAnyUnmatched(ms: Chain<Spec>, i: Int, matched: List<Int>, binds: List<MBind>, cl: Bool,
                          r): Bool => match(ms)
  (nil: ChainEnd) => false
  (l: ChainLink)  => !any(matched, (m) => m == i) && !mgLeftHole(l.value, binds, cl, r)
    ? true
    : mgAnyUnmatched(l.next, i + 1, matched, binds, cl, r)

fun meet(a: Spec|None, b: Spec|None)
  if isHole(a)
    ret optMeet(b)
  if isHole(b)
    ret optMeet(a)
  ret match(a)
    (sa: Spec) => match(b)
      (sb: Spec) => meetIdempotent(sa, sb)
      ()         => MNone()
    ()         => MNone()

# Idempotent: a type meets itself. Every rule in meetSpecs already agrees
# except the union's set-wise one, which has no ground ids to compare for a
# union holding placeholder-bearing members (`Leaf<T> | Branch<T>`).
fun meetIdempotent(a, b) => eqSpec(a, b) ? MSpec(a) : meetSpecs(a, b)

fun optMeet(sp: Spec|None) => match(sp)
  (s2: Spec) => MSpec(s2)
  ()         => MNone()

fun meetSpecs(a, b) => match(a)
  (ca: SClass)       => meetClass(ca, b)
  (ea: SEnum)        => meetEnum(ea, b)
  (ta: STuple)       => meetTuple(ta, b)
  (ua: SCombination) => meetUnion(ua, b)
  (cla: SCallable)   => meetCallable(cla, b)
  (o)                => eqSpec(a, b) ? MSpec(a) : MConflict()

# A union is a SET, and its member list is NOT canonically ordered (only the
# id is sorted), so meet set-wise, never positionally. Two fully-ground unions
# meet iff they are the same set. If one side is ground, the other's ground
# members must all be present in it — its holes then absorb the remainder —
# otherwise it carries a member the ground side lacks: a real conflict. Both
# sides still holey: defer (CONFLICT here just skips this pass; a later pass
# grounds one side and resolves it).
fun meetUnion(ua, b: Spec) => match(b)
  (ub2: SCombination) => meetUnionPair(ua, ub2)
  (o)                 => MConflict()

fun meetUnionPair(a, b): Meet
  # SHORT LISTS, not Sets. The only consumer is the subset test below, so
  # there is no order — but a union carries a handful of members, and `meet`
  # runs on every assignability check. Two hash-tree allocations per meet to
  # hold three uids costs more than the O(n) scan they were meant to replace.
  fun [tail] groundUids(ms: Chain<Spec>, acc) => match(ms)
    (nil: ChainEnd) => acc
    (l: ChainLink)  => uid(l.value) == ""
      ? groundUids(l.next, acc)
      : groundUids(l.next, contains2(acc, uid(l.value))
                             ? acc
                             : prepend(uid(l.value), acc))
  fun subLoop(xs: List<String>, ys: List<String>): Bool => all(xs, (x) => contains2(ys, x))
  let ia = uid(a)
  let ib = uid(b)
  if ia != "" && ib != ""
    ret ia == ib ? MSpec(a) : MConflict()
  let ga = groundUids(chain(a.scTypes), List())
  let gb = groundUids(chain(b.scTypes), List())
  if ia != ""
    ret subLoop(gb, ga) ? MSpec(a) : MConflict()
  if ib != ""
    ret subLoop(ga, gb) ? MSpec(b) : MConflict()
  ret MConflict()

fun meetCallable(a: SCallable, b: Spec) => match(b)
  (cb: SCallable) => meetCallablePair(a, cb)
  (o)             => MConflict()

fun meetCallablePair(a: SCallable, b: SCallable)
  fun mcParams(pm) => match(pm)
    (ms: MSpec) => ms.mSpec
    (o: Meet)   => a.scParams2
  ret match(meet(a.scParams2, b.scParams2))
    (pc: MConflict) => MConflict()
    (pm: Meet)      => match(meet(a.scResult, b.scResult))
      (rc: MConflict) => MConflict()
      (rm: MSpec)     => MSpec(SCallable(mcParams(pm), rm.mSpec, a.sclLine))
      (rn: Meet)      => MSpec(SCallable(mcParams(pm), None, a.sclLine))

fun meetClass(ca, b: Spec) => match(b)
  (cb: SClass) => ca.scName == cb.scName
                  && sameLen(chain(ca.scParams), chain(cb.scParams))
    ? meetParams(ca, ca.scParams, cb.scParams)
    : MConflict()
  (o)          => MConflict()

# Enum IDENTITY is root + valid leaves (a narrowed enum is a different type),
# by NAME (sameEnum) — the family question is identity-by-name, never
# equality (which now includes seParams: a complete spec's identity is its
# name plus ALL its arguments). Params refine positionally.
fun meetEnum(ea, b: Spec) => match(b)
  (eb: SEnum) => ea.seRoot != eb.seRoot
    ? MConflict()
    : meetEnumViews(ea, eb)
  (o)         => MConflict()

# Same enum, possibly different VIEWS — a leaf-typed construction meeting
# the root (or a sibling leaf) from another flow. Views JOIN: the union of
# the valid leaf sets is what both flows satisfy, and every view shares one
# representation (the enum-encoding principle), so the join costs nothing.
fun meetEnumViews(ea, eb: SEnum)
  # Views join only within ONE instantiation: the all-leaf sets must agree
  # (mirrors specs.py meet's guard); different all-sets are stale copies of
  # different instantiations — a genuine conflict.
  if !(sameLen(chain(ea.seAllLeaves), chain(eb.seAllLeaves))
       && allIn(chain(ea.seAllLeaves), eb.seAllLeaves))
    ret MConflict()
  let joined = sameEnum(ea, eb)
    ? ea
    : SEnum(ea.seRoot, unionLeaves(ea.seValidLeaves, eb.seValidLeaves),
            ea.seAllLeaves, ea.seParams, ea.seLine)
  ret isEmpty(ea.seParams) || !sameLen(chain(ea.seParams), chain(eb.seParams))
    ? MSpec(joined)
    : meetParams(joined, ea.seParams, eb.seParams)

fun unionLeaves(a: List<String>, b: List<String>) => fold(b, a, (acc, n) =>
    contains2(acc, n) ? acc : prepend(n, acc))

fun sameEnum(ea: SEnum, eb: SEnum) => ea.seRoot == eb.seRoot
    && sameLen(chain(ea.seValidLeaves), chain(eb.seValidLeaves))
    && allIn(chain(ea.seValidLeaves), eb.seValidLeaves)

fun meetTuple(ta: STuple, b: Spec) => match(b)
  (tb: STuple) => !sameLen(chain(ta.stEntries), chain(tb.stEntries))
    ? MConflict()
    : meetEntries(ta, chain(ta.stEntries), chain(tb.stEntries), builder())
  (o)          => MConflict()

# The entries are a TUPLE's fields, so their order is the tuple's identity —
# this is genuinely ordered accumulation, and a threaded ListBuilder is the
# answer rather than a different container. build() at the base case turns it
# back into the List the STuple holds.
fun meetEntries(base: STuple, as2: Chain<SEntry>, bs: Chain<SEntry>,
                [terminal] acc) => match(as2)
  (nil: ChainEnd) => MSpec(STuple(build(acc), base.stLine))
  (la: ChainLink) => match(bs)
    (lb: ChainLink) => meetEntry(base, la, lb, acc)
    ()              => MConflict()

fun meetEntry(base: STuple, la: ChainLink<SEntry>, lb: ChainLink<SEntry>,
              [terminal] acc) => match(meet(la.value.seType, lb.value.seType))
  (mc: MConflict) => MConflict()
  (ms: MSpec)     => meetEntries(base, la.next, lb.next,
      push(acc, SEntry(entryName(la.value, lb.value), ms.mSpec, la.value.seDefault)))
  ()              => meetEntries(base, la.next, lb.next,
      push(acc, SEntry(entryName(la.value, lb.value), None, la.value.seDefault)))

fun entryName(a: SEntry, b: SEntry) => a.seName != "" ? a.seName : b.seName

fun meetParams(base, as2: List<Spec>, bs: List<Spec>)
  ret meetParamLoop(base, chain(as2), chain(bs), builder())

# Type parameters: position IS the meaning (List<A,B> is not List<B,A>), so a
# threaded builder, not a container swap.
fun meetParamLoop(base, as2: Chain<Spec>, bs: Chain<Spec>,
                  [terminal] acc) => match(as2)
  (nil: ChainEnd) => MSpec(withParams(base, build(acc)))
  (la: ChainLink) => match(bs)
    (lb: ChainLink) => meetParam(base, la, lb, acc)
    ()              => MConflict()

fun meetParam(base, la: ChainLink<Spec>, lb: ChainLink<Spec>,
              [terminal] acc) => match(meet(la.value, lb.value))
  (mc: MConflict) => MConflict()
  (ms: MSpec)     => meetParamLoop(base, la.next, lb.next, push(acc, ms.mSpec))
  ()              => meetParamLoop(base, la.next, lb.next, push(acc, la.value))

fun withParams(base, params) => match(base)
  (c: SClass) => SClass(c.scName, params, c.scLine)
  (e: SEnum)  => SEnum(e.seRoot, e.seValidLeaves, e.seAllLeaves, params,
                       e.seLine)
  (o)         => base

# refine: the ONE rule for a stored inferred type (an untyped let's declared
# type, an undeclared function's return type). Refinable only while `current`
# is absent or still carries a hole; an inferred view is adopted only when
# ground; the merge is `meet`, so information only ever accumulates, and a
# conflict leaves `current` untouched.
# Gate — refinable only while `current` is missing (None) or carries a FREE
# placeholder (one that does not resolve in this scope); anything else is
# finished and returned untouched. In particular a NON-CONCRETE current — an
# unresolved SNamed — is a DECLARATION whose names haven't resolved yet: its
# own compile resolves it and check owns any mismatch; inference never
# overwrites it.
# Threshold — an inferred view is adopted only if CONCRETE (a placeholder may
# travel across a statement boundary and fill later; an unresolved NAME may
# not — a callee's raw T would land in a scope that cannot resolve it).
# A stored type holding a NARROWED enum view (`List<Op{Move}>`, latched on an
# early pass) stays refinable too: generic arguments are invariant, so it must
# widen with its right-hand side rather than pin the view.
#
# A stored type that names a generic without its arguments (a leaf pattern
# `ListFull`, or a type stored from one) is a shape — every argument a hole —
# so it stays refinable too; filling holes is a merge (the stored type
# RECEIVES the inference), and a contradiction leaves it unchanged.
fun refine(current: Spec|None, r, inferred: Spec|None) => match(current)
  (c: Spec) => hasFreePlaceholders(c, r) || hasMissingArguments(c, r) || containsNarrowedView(c)
    ? refineMerging(current, inferred, r)
    : current
  ()        => refineMerging(current, inferred, r)

# The stored type RECEIVES the inference (docs/type-merge-design.md), its
# narrowed views provisional; a contradiction leaves it unchanged.
fun refineMerging(current: Spec|None, inferred: Spec|None, r) => match(inferred)
  (i2: Spec) => !isConcrete(i2)
    ? current
    : mergeSpecsWidening(current, i2, List<MBind>(), true, r)
      |> (m) => isEmpty(m.moErrs) ? mergedOr(m.moSpec, current) : current
  ()         => current

fun mergedOr(sp: Spec|None, current: Spec|None) => match(sp)
  (s2: Spec) => s2
  ()         => current

# A GENERIC class or enum named without its type arguments anywhere inside —
# a leaf pattern `ListFull`, or a type stored from one: a shape whose every
# argument is a hole, not a settled type. A monomorphised instantiation
# carries its arguments in its name and is complete.
fun hasMissingArguments(sp, r): Bool => match(sp)
  (c: SClass)        => isEmpty(c.scParams)
    ? isGenericDecl(c.scName, r)
    : any(c.scParams, (p) => hasMissingArguments(p, r))
  (e: SEnum)         => isEmpty(e.seParams)
    ? isGenericDecl(e.seRoot, r)
    : any(e.seParams, (p) => hasMissingArguments(p, r))
  (n: SNamed)        => any(n.snParams, (p) => hasMissingArguments(p, r))
  (cm: SCombination) => any(cm.scTypes, (m) => hasMissingArguments(m, r))
  (t2: STuple)       => any(t2.stEntries, (en) => optMissingArguments(en.seType, r))
  (cl: SCallable)    => hasMissingArguments(cl.scParams2, r) || optMissingArguments(cl.scResult, r)
  (af: SArrayField)  => hasMissingArguments(af.safElem, r)
  (ls: SLazyStub)    => optMissingArguments(ls.slsTarget, r)
  (o: Spec)          => false

fun optMissingArguments(sp: Spec|None, r) => match(sp)
  (s2: Spec) => hasMissingArguments(s2, r)
  ()         => false

fun isGenericDecl(name, r) => !contains(name, "$generic$") && match(soleItem(findType(r, name)))
  (f: Found) => match(f.fStmt)
    (e: PsEnum)  => !isEmpty(e.eGens)
    (c: PsClass) => !isEmpty(c.cGens)
    (o: PStmt)   => false
  ()         => false

# An enum VIEW narrower than its enum — `Circle` of `Shape`. A type inferred
# from such a value is provisional: the context may ask for the root (or a
# wider view), and `meet` joins views. The valid leaves are always a subset of
# all leaves, so "narrower" is "fewer".
fun isNarrowedView(sp) => match(sp)
  (e: SEnum) => !sameLen(chain(e.seValidLeaves), chain(e.seAllLeaves))
  (o: Spec)  => false

# A narrowed view anywhere in `sp` — `Circle` itself, or the `Op{Move}` inside
# a stored `List<Op{Move}>`. Such an inferred type is provisional: a use-site
# binding re-infers against its expected type, and a stored let/return type
# keeps refining, so `meet` widens it exactly as far as the context demands.
fun containsNarrowedView(sp) => match(sp)
  (e: SEnum)         => isNarrowedView(sp) || any(e.seParams, (p) => containsNarrowedView(p))
  (c: SClass)        => any(c.scParams, (p) => containsNarrowedView(p))
  (t2: STuple)       => any(t2.stEntries, (en) => optNarrowed(en.seType))
  (cm: SCombination) => any(cm.scTypes, (m) => containsNarrowedView(m))
  (cl: SCallable)    => containsNarrowedView(cl.scParams2) || optNarrowed(cl.scResult)
  (o: Spec)          => false

fun optNarrowed(sp: Spec|None) => match(sp)
  (s2: Spec) => containsNarrowedView(s2)
  ()         => false

# has_free_placeholders: `sp` contains a generic placeholder that does NOT
# resolve in the current scope — a blank that leaked out of another
# declaration's generic context. The scope-aware complement of isConcrete: a
# placeholder is a real type inside its declaring generic, a hole elsewhere.
# "Does ANY placeholder fail to resolve" is a question about membership, not
# about order, so it is asked of the set directly.
fun hasFreePlaceholders(sp, r) => any(placeholderNames(sp), (n) => !resolvesInScope(n, r))

# `sp` read where its placeholders are in scope: each one stands as an opaque
# ground type, named by its (globally unique) placeholder name and equal only
# to itself — a template's own `T` is a real type there.
fun withOpaquePlaceholders(sp) => substitute(sp, map(placeholderNames(sp),
    (n) => Binding(n, SBuiltin("$" + n, specLine(sp)))))

# as_unique_id_str read INSIDE a scope: a placeholder that resolves there (a
# template's own `T`, and so `List<T>`) is a real type with an identity; one
# that does not is still a hole ("").
fun scopedUid(sp, r) => hasFreePlaceholders(sp, r) ? "" : uid(withOpaquePlaceholders(sp))

# The scope test for a placeholder NAME: it resolves when the use sits inside
# its declaring generic (an enclosing function's own `T`), where the
# placeholder is a real type; anywhere else it is a hole.
fun resolvesInScope(name, r) => !isEmpty(findType(r, name).bItems)

# _contains_named_spec: `sp` is or contains a raw SNamed spelling — a signature
# view that hasn't compiled yet. Its names are only meaningful in the declaring
# scope, so it must never escape into a type-param binding that outlives that
# scope (compiled at a use site, the `T` inside a latched `List<T>` can never
# resolve and survives to the post-converge scan).
fun containsNamedSpec(sp) => match(sp)
  (n: SNamed)        => true
  (c: SClass)        => cnsList(chain(c.scParams))
  (e: SEnum)         => cnsList(chain(e.seParams))
  (cm: SCombination) => cnsList(chain(cm.scTypes))
  (cl: SCallable)    => containsNamedSpec(cl.scParams2) || cnsOpt(cl.scResult)
  (t2: STuple)       => cnsEntries(chain(t2.stEntries))
  (af: SArrayField)  => containsNamedSpec(af.safElem)
  (ls: SLazyStub)    => cnsOpt(ls.slsTarget)
  (g: SGeneric)      => false
  (b: SBuiltin)      => false

fun [tail] cnsList(ts: Chain<Spec>) => match(ts)
  (nil: ChainEnd) => false
  (l: ChainLink)  => containsNamedSpec(l.value) ? true : cnsList(l.next)

fun [tail] cnsEntries(es: Chain<SEntry>) => match(es)
  (nil: ChainEnd) => false
  (l: ChainLink)  => cnsOpt(l.value.seType) ? true : cnsEntries(l.next)

fun cnsOpt(sp: Spec|None) => match(sp)
  (s2: Spec) => containsNamedSpec(s2)
  ()         => false


# ══ unification ══════════════════════════════════════════════════════════════
# unify_generic: match a generic type tree against a concrete one, returning
# the {placeholder → concrete} bindings, or failure. Unknown / mismatched
# shapes DEFER (return the mapping unchanged) rather than fail hard — the
# caller decides whether a partial mapping is good enough, and the fixpoint
# retries once types ground.

enum Unify
  enum UMap(uBindings: List<Binding>)
  enum UFail()

fun unifyGeneric(generic, concrete, names: List<String>,
                 mapping) => unifyGenericIn(generic, concrete, names, None, mapping)

# `scope` is the use site's scope (Python's `in_scope`): a concrete-side
# placeholder that resolves there is a real type and may be bound to. Only
# use-site inference has one; every other caller unifies without.
#
# A callable's parameter is contravariant: `(:Shape): Int` is a fine
# `(:Circle): Int`. So it binds only a placeholder that appears nowhere else,
# and otherwise may only refine a binding (names, holes), never widen a view.
fun unifyGenericIn(generic, concrete, names: List<String>,
                   scope: Resolver|None, mapping)
  let covariant = withoutCallableParams(generic)
  ret match(unifyTree(covariant, concrete, names, scope, mapping))
    (um: UMap)  => eqSpec(covariant, generic)
      ? um
      : UMap(refinedBy(um.uBindings, placeholderNames(covariant),
                       unifyTree(generic, concrete, names, scope, List())))
    (uf: UFail) => uf

fun refinedBy(mapping: List<Binding>, elsewhere: List<String>,
              upper) => match(upper)
  (um: UMap)  => fold(um.uBindings, mapping,
                      (acc, b) => refinedOne(acc, elsewhere, b))
  (uf: UFail) => mapping

fun refinedOne(mapping: List<Binding>, elsewhere: List<String>,
               b: Binding) => match(bindingOf(mapping, b.bName))
  (existing: Spec) => containsNarrowedView(existing)
    ? mapping
    : match(meet(existing, b.bSpec))
      (ms: MSpec) => rebind(mapping, b.bName, ms.mSpec)
      (o: Meet)   => mapping
  ()               => contains2(elsewhere, b.bName) ? mapping : prepend(b, mapping)

fun withoutCallableParams(sp: Spec): Spec => rwSpec(sp, rwOnSpec(blankParams))

fun blankParams(sp): Spec|None => match(sp)
  (cb: SCallable) => match(cb.scParams2)
    (t2: STuple) => with cb(scParams2 = with t2(stEntries = map(t2.stEntries,
                                                               (en) => SEntry(en.seName, None, en.seDefault))))
    (o: Spec)    => None
  (o: Spec)       => None

fun unifyTree(generic: Spec, concrete, names: List<String>,
              scope: Resolver|None, mapping)
  # A placeholder we own binds to the concrete side (see bindHole for which
  # concrete sides are concrete enough).
  ret match(generic)
    (g: SGeneric)      => contains2(names, g.sgName)
      ? bindHole(g.sgName, concrete, names, scope, mapping)
      : UMap(mapping)
    (b: SBuiltin)      => unifyBuiltin(b, concrete, mapping)
    (c: SClass)        => unifyClass(c, concrete, names, scope, mapping)
    (e: SEnum)         => unifyEnum(e, concrete, names, scope, mapping)
    (n: SNamed)        => unifyNamed(n, concrete, names, scope, mapping)
    (t2: STuple)       => unifyTuple(t2, concrete, names, scope, mapping)
    (cm: SCombination) => unifyUnion(cm, concrete, names, scope, mapping)
    (cl: SCallable)    => unifyCallable(cl, concrete, names, scope, mapping)
    (o)                => UMap(mapping)

# Two bindings for one placeholder MEET rather than collide: a hole refines to
# ground; only a genuine ground-vs-ground clash fails.
# A bind is a COPY out of the concrete side's scope, and a NamedSpec is only
# safely resolvable in its original context — so a spec that is or contains
# one must never bind (containsNamedSpec, deep). DEFER — the fixpoint retries
# once the callee's signature grounds.
fun bindHole(name, concrete, names: List<String>,
             scope: Resolver|None, mapping)
  if placeholderUnbindable(concrete, names, scope) || containsNamedSpec(concrete)
    ret UMap(mapping)
  ret match(bindingOf(mapping, name))
    (prior: Spec) => eqSpec(prior, concrete)
      ? UMap(mapping)
      : mergeBinding(name, prior, concrete, mapping)
    ()            => UMap(prepend(Binding(name, concrete), mapping))

# A concrete-side placeholder pins nothing down when it is one of the callee's
# OWN params (binding to itself) or another declaration's unbound leftover (a
# hole). But an ENCLOSING generic's parameter, in scope at the use site, is a
# real type there: inside `shorter<T, U>`, `isEnd(b)` with `b: Chain<U>` binds
# isEnd's T to U. Refusing it left the callee's own placeholder behind, which
# monomorphisation then completed by bare NAME to the host's T — a silent
# miscompile. Without a scope every placeholder stays a hole.
fun placeholderUnbindable(concrete: Spec, names: List<String>,
                          scope: Resolver|None) => match(concrete)
  (g: SGeneric) => match(scope)
    (r: Resolver) => contains2(names, g.sgName) || !resolvesInScope(g.sgName, r)
    ()            => true
  (o)           => false

fun mergeBinding(name, prior: Spec, concrete: Spec,
                 mapping) => match(meet(prior, concrete))
  (mc: MConflict) => UFail()
  (ms: MSpec)     => UMap(rebind(mapping, name, ms.mSpec))
  ()              => UMap(mapping)

fun rebind(mapping: List<Binding>, name, sp) => rebindLoop(chain(mapping), name, sp, List())

fun rebindLoop(ms, name: String, sp,
                      acc: List<Binding>) => build(rebindLoopB(ms, name, sp, builderFrom(acc)))

fun [tail] rebindLoopB(ms: Chain<Binding>, name, sp,
                      [terminal] acc: ListBuilder<Binding>) => match(ms)
  (nil: ChainEnd) => acc
  (l: ChainLink)  => rebindLoopB(l.next, name, sp,
      push(acc, l.value.bName == name ? Binding(name, sp) : l.value))

fun unifyBuiltin(b: SBuiltin, concrete: Spec, mapping) => match(concrete)
  (cb: SBuiltin) => b.sbName == cb.sbName ? UMap(mapping) : UFail()
  (o)            => UMap(mapping)

fun unifyClass(c: SClass, concrete: Spec, names: List<String>,
               scope: Resolver|None, mapping) => match(concrete)
  (cc: SClass) => c.scName != cc.scName
                  || !sameLen(chain(c.scParams), chain(cc.scParams))
    ? UMap(mapping)
    : unifyList(chain(c.scParams), chain(cc.scParams), names, scope, mapping)
  (o)          => UMap(mapping)

# Generic ENUM instances (List<T> vs List<Thing>, Dict<K,V>) unify through
# their type arguments exactly like classes — this is how a container-only
# call site binds its element type.
fun unifyEnum(e: SEnum, concrete: Spec, names: List<String>,
              scope: Resolver|None, mapping) => match(concrete)
  (ce: SEnum) => e.seRoot != ce.seRoot
                 || isEmpty(e.seParams)
                 || !sameLen(chain(e.seParams), chain(ce.seParams))
    ? UMap(mapping)
    : unifyList(chain(e.seParams), chain(ce.seParams), names, scope, mapping)
  (o)         => UMap(mapping)

fun unifyNamed(n: SNamed, concrete: Spec, names: List<String>,
               scope: Resolver|None, mapping) => match(concrete)
  (cn: SNamed) => n.snName != cn.snName
                  || isEmpty(n.snParams)
                  || !sameLen(chain(n.snParams), chain(cn.snParams))
    ? UMap(mapping)
    : unifyList(chain(n.snParams), chain(cn.snParams), names, scope, mapping)
  (o)          => UMap(mapping)

fun unifyCallable(cl: SCallable, concrete: Spec, names: List<String>,
                  scope: Resolver|None, mapping) => match(concrete)
  (cc: SCallable) => match(unifyTree(cl.scParams2, cc.scParams2, names, scope, mapping))
    (uf: UFail) => UFail()
    (um: UMap)  => unifyOpt(cl.scResult, cc.scResult, names, scope, um.uBindings)
  (o)             => UMap(mapping)

fun unifyOpt(a: Spec|None, b: Spec|None, names: List<String>,
             scope: Resolver|None, mapping) => match(a)
  (sa: Spec) => match(b)
    (sb: Spec) => unifyTree(sa, sb, names, scope, mapping)
    ()         => UMap(mapping)
  ()         => UMap(mapping)

# Tuple entries pair via the shared BINDING, so a named/defaulted argument
# unifies against the field it actually binds (positional zip would infer a
# placeholder from the wrong field). Default-filled fields contribute nothing.
fun unifyTuple(t2: STuple, concrete: Spec, names: List<String>,
               scope: Resolver|None, mapping) => match(concrete)
  (ct: STuple) => match(bindTupleEntries(t2.stEntries,
                          entryNames(chain(ct.stEntries), List())))
    (b2: List<Int>) => unifyBound(chain(t2.stEntries), b2, ct.stEntries, names, scope,
                                  mapping)
    ()              => UMap(mapping)
  (o)          => UMap(mapping)

fun entryNames(es: Chain<SEntry>, acc: List<String>) => build(entryNamesB(es, builderFrom(acc)))

fun [tail] entryNamesB(es: Chain<SEntry>, [terminal] acc): ListBuilder<String> => match(es)
  (nil: ChainEnd) => acc
  (l: ChainLink)  => entryNamesB(l.next, push(acc, l.value.seName))

fun [tail] unifyBound(ds: Chain<SEntry>, binding: List<Int>, supplied: List<SEntry>,
               names: List<String>, scope: Resolver|None,
               mapping) => match(ds)
  (nil: ChainEnd) => UMap(mapping)
  (l: ChainLink)  => match(head(binding))
    (ix: Int) => ix < 0
      ? unifyBound(l.next, tail(binding), supplied, names, scope, mapping)
      : unifyEntryPair(l.value, nthEntry(supplied, ix), l.next, tail(binding),
                       supplied, names, scope, mapping)
    ()        => UMap(mapping)

fun unifyEntryPair(d: SEntry, s2: SEntry|None, rest,
                   restBind: List<Int>, supplied: List<SEntry>,
                   names: List<String>, scope: Resolver|None,
                   mapping) => match(s2)
  (se: SEntry) => match(unifyOpt(d.seType, se.seType, names, scope, mapping))
    (uf: UFail) => UFail()
    (um: UMap)  => unifyBound(rest, restBind, supplied, names, scope, um.uBindings)
  ()           => unifyBound(rest, restBind, supplied, names, scope, mapping)

fun nthEntry(es: List<SEntry>, ix) => head(drop(es, ix))

fun [tail] unifyList(gs: Chain<Spec>, cs: Chain<Spec>, names: List<String>,
              scope: Resolver|None, mapping) => match(gs)
  (nil: ChainEnd) => UMap(mapping)
  (lg: ChainLink) => match(cs)
    (lc: ChainLink) => match(unifyTree(lg.value, lc.value, names, scope, mapping))
      (uf: UFail) => UFail()
      (um: UMap)  => unifyList(lg.next, lc.next, names, scope, um.uBindings)
    ()              => UMap(mapping)

# Union-vs-union: members are a SET. Positional alignment FIRST (the fixpoint's
# progression is tuned to it), then a set-wise fallback for when position lies:
# ground pattern members are matched and removed, and a single unbound
# placeholder member binds to whatever concrete members remain.
fun unifyUnion(cm: SCombination, concrete: Spec, names: List<String>,
               scope: Resolver|None, mapping) => match(concrete)
  (cc: SCombination) => unifyUnionSets(cm, cc, names, scope, mapping)
  (o)                => UMap(mapping)

fun unifyUnionSets(cm: SCombination, cc: SCombination, names: List<String>,
                   scope: Resolver|None, mapping)
  if sameLen(chain(cm.scTypes), chain(cc.scTypes))
    let trial = unifyList(chain(cm.scTypes), chain(cc.scTypes), names, scope, mapping)
    ret match(trial)
      (um: UMap)  => um
      (uf: UFail) => unifyUnionBySet(cm, cc, names, mapping)
  ret unifyUnionBySet(cm, cc, names, mapping)

fun unifyUnionBySet(cm: SCombination, cc: SCombination, names: List<String>,
                    mapping)
  let gen = reprMembers(cm)
  let con = reprMembers(cc)
  let holes = ownHoles(chain(gen), names, List())
  let ground = groundMembers(chain(gen), names, builder())
  if isEmpty(holes) || holesMoreThanOne(holes) || anyGroundHole(chain(ground), names)
    ret UMap(mapping)                      # no single-hole partition: defer
  ret match(removeGround(chain(ground), con))
    (rest: List<Spec>) => bindRemainder(holes, rest, con, cm, mapping)
    ()                 => UMap(mapping)    # a ground member is absent: defer

# A short list: `holes` is tested for "exactly one" and then read. A union's
# holes number zero or one in practice, so this never needs a tree.
fun [tail] ownHoles(ms: Chain<Spec>, names: List<String>,
                    acc) => match(ms)
  (nil: ChainEnd) => acc
  (l: ChainLink)  => ownHoles(l.next, names, holeName(l.value, names, acc))

fun holeName(sp: Spec, names: List<String>, acc) => match(sp)
  (g: SGeneric) => contains2(names, g.sgName) && !contains2(acc, g.sgName)
    ? prepend(g.sgName, acc)
    : acc
  (o)           => acc

fun [tail] groundMembers(ms: Chain<Spec>, names: List<String>,
                         [terminal] acc: ListBuilder<Spec>) => match(ms)
  (nil: ChainEnd) => build(acc)
  (l: ChainLink)  => groundMembers(l.next, names,
      isOwnHole(l.value, names) ? acc : push(acc, l.value))

fun isOwnHole(sp: Spec, names: List<String>) => match(sp)
  (g: SGeneric) => contains2(names, g.sgName)
  (o)           => false

# A ground pattern member that itself mentions one of our placeholders leaves
# no clean set partition.
fun [tail] anyGroundHole(ms: Chain<Spec>, names: List<String>) => match(ms)
  (nil: ChainEnd) => false
  (l: ChainLink)  => sharesName(placeholderNames(l.value), names)
    ? true
    : anyGroundHole(l.next, names)

# Do these two name collections overlap? Set-against-list, and neither side's
# order can change the answer.
fun sharesName(a: List<String>, b: List<String>) => any(a, (n) => contains2(b, n))

fun [tail] sharesLoop(a: Chain<String>, b: List<String>) => match(a)
  (nil: ChainEnd) => false
  (l: ChainLink)  => contains2(b, l.value) ? true : sharesLoop(l.next, b)

# Remove each ground pattern member from the concrete set; None when one is
# absent (deferral, not failure — the concrete side may still be settling).
# Matched by STRUCTURAL equality (Python `cm == gm`): a raw SNamed spelling has
# no uid yet must still match its equal spelling on the concrete side.
fun [tail] removeGround(gs: Chain<Spec>, con) => match(gs)
  (nil: ChainEnd) => con
  (l: ChainLink)  => match(removeOne(con, l.value))
    (rest: List<Spec>) => removeGround(l.next, rest)
    ()                 => None

fun removeOne(con: List<Spec>, gm) => removeLoop(chain(con), gm, builder(), false)

fun [tail] removeLoop(ms: Chain<Spec>, gm, [terminal] acc: ListBuilder<Spec>,
                      dropped) => match(ms)
  (nil: ChainEnd) => dropped ? build(acc) : None
  (l: ChainLink)  => !dropped && eqSpec(l.value, gm)
    ? removeLoop(l.next, gm, acc, true)
    : removeLoop(l.next, gm, push(acc, l.value), dropped)

# An already-pinned hole makes the slot a set-equality CHECK, not a binding
# site: `existing ∪ ground` must equal the concrete set — every leftover
# concrete member is in the binding and every binding member is in the
# concrete union; a mismatch fails unless the concrete side still holds a
# hole of its own. Otherwise `E | X` against bare `X` leaves nothing for E:
# ambiguous, so defer.
# `isMoreThanOne` and `singleOrNone` exist for Set and Bag but NOT for List, so
# these ask the chain directly. (The resolver reports that as "Ambiguous —
# Candidates: ..." rather than "nothing accepts a List", which is misleading;
# that diagnostic is tracked separately. These helpers are correct either way.)
fun holesMoreThanOne(holes: List<String>) => match(chain(holes))
  (l: ChainLink) => l.next is ChainLink
  (e: ChainEnd)  => false

fun holesSingle(holes: List<String>) => match(chain(holes))
  (l: ChainLink) => l.next is ChainEnd ? l.value : None
  (e: ChainEnd)  => None

fun bindRemainder(holes: List<String>, rest, con: List<Spec>,
                  cm: SCombination, mapping) => match(holesSingle(holes))
  (name: String) => match(bindingOf(mapping, name))
    (prior: Spec) => checkPinned(prior, rest, con, mapping)
    ()            => isEmpty(rest)
      ? UMap(mapping)
      : bindHoleTo(name, rest, cm, mapping)
  ()             => UMap(mapping)

fun checkPinned(prior, rest: List<Spec>, con: List<Spec>,
                mapping)
  fun hasSpec(ys, x) => hasLoop(chain(ys), x)
  fun [tail] hasLoop(ys: Chain<Spec>, x: Spec): Bool => match(ys)
    (nil: ChainEnd) => false
    (l: ChainLink)  => eqSpec(l.value, x) ? true : hasLoop(l.next, x)
  fun [tail] allInSet(xs: Chain<Spec>, ys) => match(xs)
    (nil: ChainEnd) => true
    (l: ChainLink)  => hasSpec(ys, l.value) ? allInSet(l.next, ys) : false
  fun [tail] anyHole(ms: Chain<Spec>) => match(ms)
    (nil: ChainEnd) => false
    (l: ChainLink)  => isHoleSpec(l.value) ? true : anyHole(l.next)
  let bound = match(prior)
    (u: SCombination) => reprMembers(u)
    (o: Spec)         => prepend(o, List())
  if allInSet(chain(rest), bound) && allInSet(chain(bound), con)
    ret UMap(mapping)
  ret anyHole(chain(con)) ? UMap(mapping) : UFail()

fun bindHoleTo(name, rest, cm: SCombination,
               mapping)
  let value = match(head(rest))
    (only: Spec) if isEmpty(tail(rest)) => only
    ()           => SCombination(rest, cm.scmLine)
  ret UMap(prepend(Binding(name, value), mapping))

# ── join ────────────────────────────────────────────────────────────────────
# The type of a BRANCH (a match, a ternary) whose sides yield `a` and `b`: the
# same type when they agree, otherwise their flattened SET UNION. Total — a
# branch always HAS a type; only the receiver can reject it. Unlike meet, which
# refines and can conflict, join never fails.
#
# Pure set semantics, nothing cleverer (user ruling): no common-parent search
# (Child1 ⊔ Child2 is Child1|Child2, never their base), no field-wise tuple
# merge, no assignability absorption. The one collapse is the set's own —
# flatten + dedupe via reprMembers — so `A ⊔ (A|None)` is `A|None`, and
# `A ⊔ A` is `A`.
fun join(a: Spec|None, b): Spec|None => match(a)
  (x: Spec) => match(b)
    (y: Spec) => joinBoth(x, y)
    ()        => x
  () => b

fun joinBoth(x, y)
  if eqSpec(x, y)
    ret x
  let members = reprMembersOf(prepend(x, prepend(y, List())))
  ret exactly(chain(members), 1)
    ? soleMember(members, x)
    : SCombination(members, specLine(x))

fun soleMember(members: List<Spec>, fallback) => match(head(members))
  (m: Spec) => m
  ()        => fallback

# ── refine_widening ─────────────────────────────────────────────────────────
# `refine` for a type inferred from a source that can WIDEN across passes.
#
# A branch broadens its arms to their least upper bound, and that GROWS as arms
# resolve late (`A`, then `A|None`). Plain refine latches the first concrete
# view and its meet then rejects the wider one as a conflict — freezing the
# narrow type. So any receiver inferring from such a source (an undeclared
# return, an untyped let, a destructure target) must be free to widen.
#
# The trigger is purely FRESH-vs-STORED: adopt the fresh view iff it is a
# STRICT superset (assignable FROM the stored type, but not the reverse). The
# type can only grow — a flip-flop would need strict widening both ways — and
# growth is bounded by the program's finite member types, so the fixpoint still
# terminates. Deliberately NOT gated on whether the AST changed: a receiver's
# type can widen while its own expression is value-equal, because the widening
# happened inside a callee.
fun refineWidening(current, fresh: Spec|None, r)
  let refined = refine(current, r, fresh)
  ret match(refined)
    (rf: Spec) if isConcrete(rf) => widenTo(rf, fresh, r)
    ()         => refined

# A fresh type still holding a hole is not wider, only less finished:
# adopted, the hole would outlive every later, complete answer.
fun widenTo(refined, fresh: Spec|None, r) => match(fresh)
  (f: Spec) if isConcrete(f) && !hasFreePlaceholders(f, r) && !hasMissingArguments(f, r)
               && strictlyWider(f, refined, r) => f
  ()        => refined

# `f` is a STRICT superset of `refined`: it accepts everything refined does,
# and refined does not accept everything it does.
fun strictlyWider(f, refined, r) => triTrue(assignableFrom(r, f, refined))
    && !triTrue(assignableFrom(r, refined, f))

# ── trait-constraint solving ─────────────────────────────────────────────────
# The call-site (pre-monomorphisation) where-discharge: ground a constraint's
# still-unbound placeholders by matching it against the `[trait]` instances in
# scope. (Its mono-time counterpart is lowering/generics.py's binder — kept
# deliberately separate in Python, and so here.)

# A [trait] instance as the solver sees it: the implemented interface,
# expressed over the instance's own param names (empty for a concrete one).
class [final] TraitInst(tiParams: List<String>, tiIface: SClass)

# Positionally match an already-substituted constraint against a CONCRETE
# instance interface. Strict and positional, deliberately NOT unifyGeneric: at
# each position a target placeholder binds to the instance's type (only if
# that side is itself concrete — an unresolved NAME would copy into a scope
# that cannot resolve it); a concrete anchor must equal the instance's
# EXACTLY; anything else rejects the whole match. A lenient match would bind
# a target from an unrelated instance and cascade into runaway instantiation.
fun bindFromConstraintMatch(constraint: SClass, iface: SClass,
                            targets: List<String>): List<Binding>|None
  if constraint.scName != iface.scName
     || !sameLen(chain(constraint.scParams), chain(iface.scParams))
    ret None
  ret match(bfcLoop(chain(constraint.scParams), chain(iface.scParams),
                    targets, builder()))
    (b: List<Binding>) => isEmpty(b) ? None : b
    ()                 => None

fun [tail] bfcLoop(cs: Chain<Spec>, is2: Chain<Spec>, targets: List<String>,
                   [terminal] acc: ListBuilder<Binding>) => match(cs)
  (nil: ChainEnd) => build(acc)
  (c: ChainLink)  => match(is2)
    (nil2: ChainEnd) => build(acc)
    (i: ChainLink)   => match(bfcOne(c.value, i.value, targets, acc))
      (next2: ListBuilder<Binding>) => bfcLoop(c.next, i.next, targets, next2)
      ()                            => None

fun bfcOne(cArg: Spec, iArg: Spec, targets: List<String>,
           [terminal] acc: ListBuilder<Binding>) => match(cArg)
  (g2: SGeneric) => contains2(targets, g2.sgName)
    ? (isConcrete(iArg) ? push(acc, Binding(g2.sgName, iArg)) : None)
    : anchorsEqual(cArg, iArg, acc)
  (o: Spec)      => anchorsEqual(cArg, iArg, acc)

# Threads the builder through untouched when the two anchors agree, and fails
# the whole match otherwise — it adds no binding of its own.
fun anchorsEqual(cArg, iArg,
                 [terminal] acc): ListBuilder<Binding>|None
  ret uid(cArg) != "" && uid(cArg) == uid(iArg) ? acc : None

# Could `pattern` (a provider's interface, still holding its placeholders)
# match `constraint`? A placeholder on either side is a wildcard; two class
# specs must share name and arity and agree element-wise; other concrete
# types must have equal ids. A cheap structural prune so the solver only
# unifies a RELEVANT provider.
fun traitPatternCompatible(pattern, constraint) => match(pattern)
  (pg: SGeneric) => true
  (pc: SClass)   => match(constraint)
    (cg: SGeneric) => true
    (cc: SClass)   => pc.scName == cc.scName
                      && patternArgsCompatible(chain(pc.scParams),
                                               chain(cc.scParams))
    (co: Spec)     => idsCompatible(pattern, constraint)
  (po: Spec)     => match(constraint)
    (cg: SGeneric) => true
    (co: Spec)     => idsCompatible(pattern, constraint)

fun [tail] patternArgsCompatible(ps: Chain<Spec>, cs: Chain<Spec>) => match(ps)
  (nil: ChainEnd) => match(cs)
    (nil2: ChainEnd) => true
    (c: ChainLink)   => false
  (p: ChainLink)  => match(cs)
    (nil2: ChainEnd) => false
    (c: ChainLink)   => traitPatternCompatible(p.value, c.value)
      ? patternArgsCompatible(p.next, c.next)
      : false

fun idsCompatible(pattern, constraint) => uid(pattern) == "" || uid(constraint) == ""
  ? true
  : uid(pattern) == uid(constraint)

# Ground the `targets` placeholders of a trait constraint by matching it
# against the instances (concrete first); the first whose grounded interface
# binds the targets wins. A constraint whose SUBJECT is still a bare
# placeholder cannot be matched — wait for the fixpoint to make it concrete.
fun solveTraitConstraint(constraint, targets: List<String>,
                         instances: List<TraitInst>,
                         r: Resolver)
  if subjectIsPlaceholder(constraint)
    ret None
  ret solveLoop(chain(instances), constraint, targets, r)

fun subjectIsPlaceholder(constraint: SClass) => match(head(constraint.scParams))
  (s2: Spec) => match(s2)
    (g2: SGeneric) => true
    (o: Spec)      => false
  ()         => false

fun [tail] solveLoop(is2: Chain<TraitInst>, constraint,
                     targets: List<String>, r: Resolver) => match(is2)
  (nil: ChainEnd) => None
  (l: ChainLink)  => match(tryInstance(l.value, constraint, targets, r))
    (b: List<Binding>) => b
    ()                 => solveLoop(l.next, constraint, targets, r)

fun tryInstance(inst: TraitInst, constraint, targets: List<String>,
                r: Resolver)
  if !traitPatternCompatible(inst.tiIface, constraint)
    ret None
  ret match(instanceMapping(inst, constraint))
    (m: List<Binding>) => groundedBinding(inst, m, constraint, targets)
    ()                 => None

# The instance's OWN params must all be fixed by the constraint.
fun instanceMapping(inst: TraitInst, constraint)
  if isEmpty(inst.tiParams)
    ret List<Binding>()
  ret match(unifyGeneric(inst.tiIface, constraint, inst.tiParams,
                         List()))
    (m: UMap)  => allParamsBound(chain(inst.tiParams), m.uBindings)
      ? m.uBindings
      : None
    (f: UFail) => None

fun [tail] allParamsBound(ps: Chain<String>, m: List<Binding>) => match(ps)
  (nil: ChainEnd) => true
  (l: ChainLink)  => match(bindingOf(m, l.value))
    (b: Spec) => allParamsBound(l.next, m)
    ()        => false

fun groundedBinding(inst: TraitInst, m: List<Binding>, constraint: SClass,
                    targets: List<String>)
  if isEmpty(m)
    ret bindFromConstraintMatch(constraint, inst.tiIface, targets)
  ret match(substitute(inst.tiIface, m))
    (g2: SClass) => bindFromConstraintMatch(constraint, g2, targets)
    (o: Spec)    => None
