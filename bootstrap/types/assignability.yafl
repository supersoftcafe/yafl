# bootstrap/assignability.yafl — trivially_assignable_from / _equals, ported
# from compiler/pyast/typespec/specs.py.
#
# "Can a `right`-typed value be used where `left` is expected?" — answered in
# THREE values, and the third one is the whole point:
#
#   true  — yes, structurally.
#   false — no, definitively. A caller may discard the candidate.
#   None  — NOT YET DECIDABLE. Some type on the path is still an SNamed, or a
#           generic placeholder that may fit once bound. The fixpoint asks
#           again next pass.
#
# Collapsing None into false is the tempting bug: it would let overload
# resolution discard the candidate that was going to win, one pass before its
# types resolved. Every rule below returns None the moment it meets something
# unresolved, and the combinators propagate it.
namespace Bootstrap::Types

import System

import Bootstrap::Ast
import Bootstrap::Parse
import Bootstrap::Resolve



# `Bool|None` IS the three-valued answer — None means undecided.
typealias Tri : Bool|None

fun triTrue(x: Tri) => match(x)
  (b: Bool) => b
  ()        => false

fun triFalse(x: Tri) => match(x)
  (b: Bool) => !b
  ()        => false

# ── the entry point ─────────────────────────────────────────────────────────
# trivially_assignable_equals: the 1-tuple unwrap and the union-on-the-right
# decomposition happen HERE, before the left type's own rule sees anything.

fun assignableEq(r, left: Spec|None, right: Spec|None) => match(left)
  (l: Spec) => match(right)
    (rt: Spec) => assignableEqBoth(r, l, rt)
    ()         => None
  () => None

fun assignableEqBoth(r, left, right)
  # The empty type (a leafless enum — Never) is the BOTTOM type: it has no
  # values, so a Never-typed expression fits anywhere.
  if isNever(right)
    ret true
  # Tuple-against-tuple goes straight to the tuple rule: arity may legally
  # differ when the uncovered fields carry defaults, so unwrapping a 1-tuple
  # first would turn `(x = 5)` against `(x: Int, y: Int = 10)` into a spurious
  # element-vs-tuple mismatch.
  if isTuple(left) && isTuple(right)
    ret assignableFrom(r, left, right)
  # A 1-tuple IS its element (recursively). The unwrap must be SYMMETRIC: if
  # either side is a 1-tuple whose entry type is unknown, the comparison is
  # undecided — unwrapping only the known side yields a spurious mismatch.
  let lu = unwrapOne(left)
  let ru = unwrapOne(right)
  ret match(lu)
    (l: Spec) => match(ru)
      (rt: Spec) => assignableUnwrapped(r, l, rt)
      ()         => None
    () => None

fun assignableUnwrapped(r, left, right)
  # Set semantics of a union VALUE: it is ONE of its members, so a union on the
  # right is assignable iff EVERY member is. (A union on the LEFT keeps its own
  # memberwise rule, below.)
  ret isUnion(right) && !isUnion(left)
    ? allMembersAssignable(r, left, unionMembers(right))
    : assignableFrom(r, left, right)

fun allMembersAssignable(r, left: Spec, members: List<Spec>)
  ret memberLoop(members, r, left, false)

fun [tail] memberLoop(ms: List<Spec>, r, left: Spec,
                      sawUnknown) => isEmpty(ms)
  ? (sawUnknown ? None : true)
  : assignableEq(r, left, first(ms))
    |> (res) => triFalse(res)
      ? false
      : memberLoop(tail(ms), r, left, sawUnknown || !triTrue(res))

# ── the per-type rules ──────────────────────────────────────────────────────

fun assignableFrom(r, left, right)
  # An unresolved RIGHT tells us nothing yet, whatever the left is.
  if isNamed(right)
    ret None
  ret match(left)
    (b: SBuiltin)      => builtinFrom(b, right)
    (c: SClass)        => classFrom(r, c, right)
    (e: SEnum)         => enumFrom(r, e, right)
    (t2: STuple)       => tupleFrom(r, t2, right)
    (cm: SCombination) => unionFrom(r, cm, right)
    (af: SArrayField)  => arrayFrom(r, af, right)
    (cl: SCallable)    => callableFrom(r, cl, right)
    (ls: SLazyStub)    => isLazy(right)
    # A candidate-side placeholder has not been bound yet: it MIGHT accept this
    # right after substitution. Undecided, never a blanket false — a false here
    # would prematurely filter a valid generic candidate out of overload
    # resolution.
    (g: SGeneric)      => genericFrom(g, right)
    (n: SNamed)        => None                    # left not resolved yet

fun builtinFrom(b: SBuiltin, right) => match(right)
  (rb: SBuiltin) => b.sbName == rb.sbName
  (o: Spec)      => false

fun genericFrom(g: SGeneric, right) => match(right)
  (rg: SGeneric) => g.sgName == rg.sgName ? true : None
  (o: Spec)      => None

# A class accepts itself and its descendants. `_all_parents` is computed by the
# class's own compile; while it is absent the hierarchy is not known yet.
fun classFrom(r, c: SClass, right)
  if !contains(c.scName, "@")
    ret None                                      # left not resolved yet
  ret match(right)
    (rc: SClass) => c.scName == rc.scName
      ? argsInvariant(r, c.scParams, rc.scParams)
      : inheritsFrom(r, c, rc)
    (o: Spec)    => false

# Same class or enum root — but generic type arguments are INVARIANT, and
# enum EQUALITY deliberately excludes type_params (convergence metadata), so
# assignability compares them itself: pre-monomorphisation, List<A> and
# List<B> share root and leaves and differ ONLY here. Three-valued:
# placeholders and unresolved arguments are Unknown, never a rejection —
# template bodies are checked before monomorphisation grounds them.
fun [tail] argsInvariant(r, ls: List<Spec>, rs: List<Spec>) => isEmpty(ls)
  ? (isEmpty(rs)
    ? true
    : None)  # None: an arity mismatch here is convergence noise
  : isEmpty(rs)
    ? None
    : argPairSame(r, first(ls), first(rs)) == 1
      ? argsInvariant(r, tail(ls), tail(rs))
      : argPairSame(r, first(ls), first(rs)) == 0
        ? argsRestUnknown(r, tail(ls), tail(rs))
        : false

# Once one pair is Unknown the answer can never be `true` again — walk the
# rest only to find a definite `false`.
fun [tail] argsRestUnknown(r, ls: List<Spec>, rs: List<Spec>) => isEmpty(ls)
  ? None
  : isEmpty(rs)
    ? None
    : argPairSame(r, first(ls), first(rs)) != -1
      ? argsRestUnknown(r, tail(ls), tail(rs))
      : false

# 1 = equivalent, 0 = unknown, -1 = definitely different. Not spec-EQUAL is
# not the end: invariance means type EQUIVALENCE, which the existing rules
# define with their deliberate leniencies (callable parameter NAMES do not
# distinguish types) — mutually assignable arguments are equivalent.
#
# Views of one enum are NOT one type argument: `Box<Circle>` and `Box<Shape>`
# are different types (user ruling), whatever representation or monomorphised
# instance they might share — sharing code is an optimisation question, never
# a typing rule. A narrower view is assignable to the root but not the other
# way, so the mutual check rejects the pair.
fun argPairSame(r, a, b)
  if eqSpec(a, b)
    ret 1
  ret argPairMutual(r, a, b)

fun argPairMutual(r, a, b)
  if argOneUnknown(a, b)
    ret 0
  ret match(assignableFrom(r, a, b))
    (fwd: Bool) => !fwd
      ? -1
      : match(assignableFrom(r, b, a))
        (bwd: Bool) => bwd ? 1 : -1
        ()          => 0
    ()          => 0

fun argOneUnknown(a, b) => specUnresolved(a) || specUnresolved(b)

fun specUnresolved(sp) => match(sp)
  (g2: SGeneric)     => true
  (n: SNamed)        => true
  (c: SClass)        => anyUnresolved(c.scParams)
  (e2: SEnum)        => anyUnresolved(e2.seParams)
  (cm: SCombination) => anyUnresolved(cm.scTypes)
  (t2: STuple)       => anyEntryUnresolved(t2.stEntries)
  (o: Spec)          => false

fun [tail] anyUnresolved(ss: List<Spec>) => isEmpty(ss)
  ? false
  : specUnresolved(first(ss)) ? true : anyUnresolved(tail(ss))

fun [tail] anyEntryUnresolved(es: List<SEntry>) => isEmpty(es)
  ? false
  : match(first(es).seType)
    (sp: Spec) => specUnresolved(sp) ? true : anyEntryUnresolved(tail(es))
    ()         => anyEntryUnresolved(tail(es))

fun inheritsFrom(r, c: SClass, rc: SClass) => match(soleItem(findType(r, rc.scName)))
  (f: Found) => parentsOf(f.fStmt)
    |> (ps) => match(ps)
      (list: List<Spec>) => anyNamed(list, c.scName)
      ()                 => None                # parents not resolved yet
  ()         => None

fun parentsOf(st) => match(st)
  (cs: PsClass) => cs.cAllParents
  (o: PStmt)    => None

fun [tail] anyNamed(ps: List<Spec>, name) => isEmpty(ps)
  ? false
  : specName(first(ps)) == name ? true : anyNamed(tail(ps), name)

fun specName(sp) => match(sp)
  (c: SClass) => c.scName
  (n: SNamed) => n.snName
  (o: Spec)   => ""

# An enum accepts a NARROWING of itself: same root, and the right's valid
# leaves a subset of ours.
fun enumFrom(r, e: SEnum, right) => match(right)
  (re: SEnum) => !contains(e.seRoot, "@") || !contains(re.seRoot, "@")
    ? None
    : (re.seRoot != e.seRoot
        ? false
        : !allIn(re.seValidLeaves, e.seValidLeaves)
          ? false
          : argsInvariant(r, e.seParams, re.seParams))
  (o: Spec)   => false

fun arrayFrom(r, af: SArrayField, right) => match(right)
  (ra: SArrayField) => af.safLenField != ra.safLenField
    ? false
    : assignableFrom(r, af.safElem, ra.safElem)
  (o: Spec)         => false

# Callables do not auto-widen their result: the return types must be
# equivalent in BOTH directions, and an undecided direction defers the verdict.
# Return types must be EQUIVALENT (bidirectionally assignable) — callables do
# not auto-widen results (no implicit thunk). EITHER direction undecided
# defers the whole result verdict (a definite asymmetry is False). Parameters
# swap direction (contravariance) and are compared DIRECTLY by the tuple rule
# — never via the 1-tuple unwrap: a parameter list's ARITY is significant, so
# an N-vs-1 mismatch rejects on the arguments alone even while the lone
# parameter's type is unresolved.
fun callableFrom(r, cl: SCallable, right) => match(right)
  (rn: SNamed)    => None                       # not resolved yet
  (rc: SCallable) => callableVerdict(resultEquiv(r, cl.scResult, rc.scResult),
                                     assignableFrom(r, rc.scParams2,
                                                    cl.scParams2))
  (o: Spec)       => false

fun resultEquiv(r, a: Spec|None, b: Spec|None)
  let fwd = assignableEq(r, a, b)
  let rev = assignableEq(r, b, a)
  ret fwd is None || rev is None
    ? None
    : (triTrue(fwd) && triTrue(rev) ? true : false)

fun callableVerdict(res: Tri, params: Tri) => triFalse(res) || triFalse(params)
  ? false
  : (triTrue(res) && triTrue(params) ? true : None)

# ── the tuple rule ──────────────────────────────────────────────────────────
# Fields correspond via the SHARED binding (positional, then by name, unbound
# fields covered by their defaults). Only the BOUND pairs are type-compared —
# a default's type was already checked at its declaration.

fun tupleFrom(r, left: STuple, right) => match(right)
  (rt: STuple) => tupleFromTuple(r, left, rt)
  (o: Spec)    => false

fun tupleFromTuple(r, left: STuple, right: STuple)
  ret match(bindTupleEntries(left.stEntries, entryNames(right.stEntries)))
    (b: List<Int>) => comparePairs(r, left, right, b)
    ()             => false                       # does not bind at all

fun entryNames(es: List<SEntry>) => nameLoop(es, List())

fun nameLoop(es: List<SEntry>, acc: List<String>) => (nameLoopB(es, acc))

fun [tail] nameLoopB(es: List<SEntry>, acc): List<String> => isEmpty(es)
  ? acc
  : nameLoopB(tail(es), append(acc, first(es).seName))

# The subtlety, transcribed rather than paraphrased: a false from a
# PLACEHOLDER left is not structural — it may fit once bound — so it is
# promoted to undecided. But if EVERY pair failed, nothing offered structural
# grounding and the answer is false.
class [final] PairTally(ptStructFalse: Bool, ptAnyFalse: Bool,
                        ptAllFalse: Bool, ptUnknown: Bool, ptCount: Int)

fun comparePairs(r, left: STuple, right: STuple,
                 binding: List<Int>)
  let t2 = pairLoop(zipBinding(left.stEntries, binding), r,
                    right.stEntries,
                    PairTally(false, false, true, false, 0))
  ret t2.ptStructFalse ? false
    : (t2.ptCount > 0 && t2.ptAllFalse ? false
      : (t2.ptUnknown ? None : true))

class [final] Pair(prLeft: SEntry, prSlot: Int)

fun zipBinding(es: List<SEntry>, binding: List<Int>)
  ret zipLoop(es, binding, List())

# Pairs an entry with the binding index it fills. Positional data — the pair
# order mirrors the tuple's — so it is appended in order, O(1) per pair.
fun [tail] zipLoop(es: List<SEntry>, bs: List<Int>,
                   acc: List<Pair>) => isEmpty(es)
  ? acc
  : isEmpty(bs)
    ? acc
    : zipLoop(tail(es), tail(bs),
                                first(bs) < 0 ? acc          # filled by default
                                            : append(acc, Pair(first(es), first(bs))))

fun [tail] pairLoop(ps: List<Pair>, r, rights: List<SEntry>,
                    acc: PairTally) => isEmpty(ps)
  ? acc
  : pairLoop(tail(ps), r, rights,
                              tally(acc, r, first(ps), rights))

fun tally(acc: PairTally, r, p: Pair, rights: List<SEntry>)
  let res = assignableEq(r, p.prLeft.seType, entryAt(rights, p.prSlot))
  let isFalse = triFalse(res)
  let placeholder = isGenericSpec(p.prLeft.seType)
  ret PairTally(acc.ptStructFalse || (isFalse && !placeholder),
                acc.ptAnyFalse || isFalse,
                acc.ptAllFalse && isFalse,
                # a placeholder-false is promoted to UNDECIDED, not false
                acc.ptUnknown || (!triTrue(res) && !(isFalse && !placeholder)),
                acc.ptCount + 1)

fun entryAt(es: List<SEntry>, i) => entryAtLoop(es, i)

fun [tail] entryAtLoop(es: List<SEntry>, i) => isEmpty(es)
  ? None
  : i <= 0 ? first(es).seType : entryAtLoop(tail(es), i - 1)

fun isGenericSpec(sp: Spec|None) => match(sp)
  (g: Spec) => match(g)
    (x: SGeneric) => true
    (o: Spec)     => false
  () => false

# ── the union rule (union on the LEFT) ──────────────────────────────────────
# Every member of the right must be assignable to SOME member of the left.

fun unionFrom(r, cm: SCombination, right)
  ret outerLoop(unionMembers(right), r, cm.scTypes, true)

fun [tail] outerLoop(rs: List<Spec>, r, lefts: List<Spec>,
                     allTrue) => isEmpty(rs)
  ? (allTrue ? true : None)
  : fitsAny(r, lefts, first(rs))
    |> (res) => triFalse(res)
      ? false
      : outerLoop(tail(rs), r, lefts, allTrue && triTrue(res))

# Fits SOME left member: one true wins; all false loses; otherwise undecided.
fun fitsAny(r, lefts: List<Spec>, right: Spec) => innerLoop(lefts, r, right, true)

fun [tail] innerLoop(ls: List<Spec>, r, right: Spec,
                     allFalse) => isEmpty(ls)
  ? (allFalse ? false : None)
  : assignableEq(r, first(ls), right)
    |> (res) => triTrue(res)
      ? true
      : innerLoop(tail(ls), r, right, allFalse && triFalse(res))

# ── shape helpers ───────────────────────────────────────────────────────────

fun isNever(sp) => match(sp)
  (e: SEnum) => isEmpty(e.seValidLeaves)
  (o: Spec)  => false

fun isTuple(sp) => match(sp)
  (t2: STuple) => true
  (o: Spec)    => false

fun isUnion(sp) => match(sp)
  (cm: SCombination) => true
  (o: Spec)          => false

fun isNamed(sp) => match(sp)
  (n: SNamed) => true
  (o: Spec)   => false

fun isLazy(sp) => match(sp)
  (ls: SLazyStub) => true
  (o: Spec)       => false

fun unionMembers(sp): List<Spec> => match(sp)
  (cm: SCombination) => cm.scTypes
  (o: Spec)          => prepend(sp, List())

# Unwrap a 1-tuple to its element, repeatedly. None = an entry type is unknown,
# so the caller must treat the comparison as undecided.
fun unwrapOne(sp) => match(sp)
  (t2: STuple) => exactly(t2.stEntries, 1)
    ? unwrapEntry(head(t2.stEntries))
    : sp
  (o: Spec)    => sp

fun unwrapEntry(en: SEntry|None) => match(en)
  (e: SEntry) => match(e.seType)
    (t2: Spec) => unwrapOne(t2)
    ()         => None
  ()          => None
