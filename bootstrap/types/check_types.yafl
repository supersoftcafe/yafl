# bootstrap/check_types.yafl — TypeSpec.check per kind, ported from
# pyast/typespec/specs.py, plus the shared default-value rule and
# check_caller_type_params (base.py). Every message string is copied VERBATIM:
# the contract diffs the printed diagnostics byte for byte.
namespace Bootstrap::Types

import System

import Bootstrap::Ast
import Bootstrap::Codegen
import Bootstrap::Frontend
import Bootstrap::Parse
import Bootstrap::Resolve



# One diagnostic. `errWarn` mirrors Error.severity ("warning" reports and
# continues; anything else fails the build). `errCategory` mirrors
# Error.category — the -W flag name gating a warning (see
# bootstrap/frontend/warnings.yafl); unused for errors.
enum PErr(errLine: PLine, errMsg: String, errWarn: Bool = false, errCategory: String = "")

fun noErrs(): Set<PErr> => Set()

fun oneErr(lr, msg) => add(Set(), PErr(lr, msg))

# ── TypeSpec.check ──────────────────────────────────────────────────────────

fun checkSpec(sp, r): Set<PErr> => match(sp)
  (b: SBuiltin)      => isKnownBuiltin(b.sbName)
    ? noErrs()
    : oneErr(b.sbLine, "Unresolved reference to '" + b.sbName + "'")
  (n: SNamed)        => checkNamed(n, r)
  (c: SClass)        => checkClassSpec(c, r)
  # Field types are checked at their DECLARATION (the enum statement's
  # own check); a reference has nothing to recurse into.
  (e2: SEnum)        => noErrs()
  (g2: SGeneric)     => noErrs()
  (cl: SCallable)    => union(checkSpec(cl.scParams2, r),
                               checkSpecOpt(cl.scResult, r))
  (cm: SCombination) => checkSpecs(chain(cm.scTypes), r, noErrs())
  (t2: STuple)       => checkTuple(t2, r)
  (af: SArrayField)  => checkSpec(af.safElem, r)
  (ls: SLazyStub)    => checkSpecOpt(ls.slsTarget, r)

fun checkSpecOpt(sp: Spec|None, r): Set<PErr> => match(sp)
  (s2: Spec) => checkSpec(s2, r)
  ()         => noErrs()

fun [tail] checkSpecs(ss: Chain<Spec>, r: Resolver,
                      acc: Set<PErr>): Set<PErr> => match(ss)
  (nil: ChainEnd) => acc
  (l: ChainLink)  => checkSpecs(l.next, r, union(acc, checkSpec(l.value, r)))

fun [tail] checkFields(fs: Chain<SField>, r,
                       acc): Set<PErr> => match(fs)
  (nil: ChainEnd) => acc
  (l: ChainLink)  => checkFields(l.next, r,
                                 union(acc, checkSpec(l.value.sfType, r)))

fun isKnownBuiltin(name) => name == "str" || name == "bigint" || name == "bool"
    || name == "int8" || name == "int16" || name == "int32"
    || name == "int64" || name == "float32" || name == "float64"

fun checkNamed(n: SNamed, r)
  let found = findType(r, n.snName)
  if atLeast(chain(found.bItems), 2)
    ret oneErr(n.snLine, "Ambiguous reference to '" + n.snName + "'")
  if exactly(chain(found.bItems), 1)
    ret noErrs()
  ret oneErr(n.snLine, "Unresolved reference to '" + n.snName + "'")

fun checkClassSpec(c: SClass, r)
  let tpErrs = checkSpecs(chain(c.scParams), r, noErrs())
  let found = findType(r, c.scName)
  if isEmpty(found.bItems)
    ret union(oneErr(c.scLine, "Failed to resolve class " + c.scName), tpErrs)
  if atLeast(chain(found.bItems), 2)
    ret union(oneErr(c.scLine, "Found too many classes named " + c.scName),
               tpErrs)
  ret match(soleItem(found))
    (f: Found) => match(f.fStmt)
      (cs: PsClass) => union(checkCallerTypeParams(cs, c.scParams, c.scLine, r),
                              tpErrs)
      (o: PStmt)    => union(oneErr(c.scLine, "Not a class " + c.scName),
                              tpErrs)
    ()         => tpErrs

# A tuple: all named entries after all positional ones, then each entry.
fun checkTuple(t2: STuple, r)
  if namedBeforePositional(t2.stEntries)
    ret oneErr(t2.stLine,
               "Named parameters are not allowed before positional parameters")
  ret checkEntries(chain(t2.stEntries), r, noErrs())

# True iff an unnamed entry follows a named one — a single flag-carrying
# walk (was last-unnamed-index > first-named-index; same relation).
fun namedBeforePositional(es: List<SEntry>) => unnamedAfterNamed(chain(es), false)

fun [tail] unnamedAfterNamed(es: Chain<SEntry>, seenNamed) => match(es)
  (nil: ChainEnd) => false
  (l: ChainLink)  => l.value.seName == ""
    ? (seenNamed ? true : unnamedAfterNamed(l.next, seenNamed))
    : unnamedAfterNamed(l.next, true)

fun [tail] checkEntries(es: Chain<SEntry>, r,
                        acc: Set<PErr>) => match(es)
  (nil: ChainEnd) => acc
  (l: ChainLink)  => checkEntries(l.next, r, union(acc, checkEntry(l.value, r)))

fun checkEntry(en: SEntry, r)
  let err1 = checkSpecOpt(en.seType, r)
  let err2 = checkExprOpt(en.seDefault, r, en.seType)
  ret union(err1,
             union(err2, defaultValueErrors(en.seDefault, r,
                                             entryLine(en), "tuple field")))

fun entryLine(en: SEntry) => match(en.seType)
  (t2: Spec) => ctSpecLine(t2)
  ()         => PLine("", 0, 0)

# ── the default-value rule ──────────────────────────────────────────────────
# A default is cloned into every site that omits the field, so it must be a
# literal or a [const] value: no captures, no effects, no evaluation order.

fun defaultValueErrors(default: PExpr|None, r, lr,
                       what) => match(default)
  (d: PExpr) => isLiteralValue(d)
    ? noErrs()
    : (isConstReference(stripConversions(d), r)
       ? noErrs()
       : oneErr(lr, "a " + what + " default must be a literal or a [const] value"))
  ()         => noErrs()

fun isLiteralValue(x) => match(stripConversions(x))
  (i: PeInt)     => true
  (f: PeFloat)   => true
  (s2: PeStr)    => true
  (b: PeBool)    => true
  (ng: PeNothing) => true
  (tp: PeTuple)  => allLiteralEntries(chain(tp.exprs))
  (o: PExpr)     => false

fun [tail] allLiteralEntries(es: Chain<PTupEnt>) => match(es)
  (nil: ChainEnd) => true
  (l: ChainLink)  => !l.value.tupSpread && isLiteralValue(l.value.tupValue)
    ? allLiteralEntries(l.next)
    : false

fun [tail] stripConversions(x) => match(x)
  (cv: PeConvert) => stripConversions(cv.convInner)
  (o: PExpr)      => x

fun isConstReference(x, r) => match(x)
  (nm: PeName) => match(soleItem(findData(r, nm.refName)))
    (f: Found) => hasAttr(stmtAttrs(f.fStmt), "const")
    ()         => false
  (o: PExpr)   => false

fun stmtAttrs(st) => match(st)
  (f: PsFun)        => f.fAttrs
  (l: PsLet)        => l.lAttrs
  (d: PsDestructure) => d.dAttrs
  (c: PsClass)      => c.cAttrs
  (ta: PsTypealias) => ta.taAttrs
  (o: PStmt)        => List()

# ── check_caller_type_params (NamedStatement) ───────────────────────────────
# Arity first; then each `where` constraint, instantiated with the caller's
# type args, must be provided in scope.

fun checkCallerTypeParams(st, callerParams: List<Spec>, lr,
                          r) => callerTypeParamErrs(narrowClassStmt(st), callerParams, lr, r)

fun narrowClassStmt(st): PStmt => st

# check_caller_type_params on ANY named statement (a function reference with
# explicit type args checks the same arity + where-discharge rules).
fun callerTypeParamErrs(st, callerParams: List<Spec>, lr,
                        r)
  let gens = stmtGens(st)
  if shorterThan(chain(gens), chain(callerParams))
    ret oneErr(lr, "Excess type parameters")
  if shorterThan(chain(callerParams), chain(gens))
    ret oneErr(lr, "Not enough type parameters")
  ret checkWheres(chain(stmtWheres(st)), instantiation(chain(gens), chain(callerParams), List()),
                  RTypes(callerGenFounds(chain(gens), chain(callerParams),
                                         List()),
                         r, List()),
                  lr)

# The constraint compiles to the declaration's own placeholders; this use
# instantiates them (`BasicCompare<TVal>` at `>=`<Int> is BasicCompare<Int>).
fun [tail] instantiation(gs: Chain<PGen>, cs: Chain<Spec>, acc: List<Binding>): List<Binding> => match(gs)
  (nil: ChainEnd) => acc
  (g2: ChainLink) => match(cs)
    (nil2: ChainEnd) => acc
    (c: ChainLink)   => instantiation(g2.next, c.next, prepend(Binding(g2.value.genName, c.value), acc))

fun callerGenFounds(gs, cs,
                           acc: List<Found>): List<Found>
  ret build(callerGenFoundsB(gs, cs, builderFrom(acc)))

fun [tail] callerGenFoundsB(gs: Chain<PGen>, cs: Chain<Spec>,
                           [terminal] acc: ListBuilder<Found>) => match(gs)
  (nil: ChainEnd) => acc
  (g2: ChainLink) => match(cs)
    (nil2: ChainEnd) => acc
    (c: ChainLink)   => callerGenFoundsB(g2.next, c.next,
        push(acc, Found(g2.value.genName,
                  PsTypealias(g2.value.genName, List(),
                              List(), c.value, List(),
                              g2.value.pgLine),
                  ScLocal())))

# Each constraint, instantiated for this use, must be provided: by a `where`
# in scope, a `[trait]` let, or an instance. The first that is not is the
# error.
fun [tail] checkWheres(ws: Chain<Spec>, inst: List<Binding>, r, lr): Set<PErr> => match(ws)
  (nil: ChainEnd) => noErrs()
  (l: ChainLink)  => checkOneWhere(l.value, inst, r, lr)
    |> (errs) => isEmpty(errs) ? checkWheres(l.next, inst, r, lr) : errs

fun checkOneWhere(w, inst: List<Binding>, r, lr)
  let compiled = compileSpec(w, r)
  if !isEmpty(compiled.soGlobals)
    ret oneErr(lr, "Compile steps incomplete for '" + ctWhereName(w)
                   + "'. Seeing this message indicates a compiler error.")
  let wanted = substitute(compiled.soSpec, inst)
  ret any(whereClauses(r), (w2) => satisfies(wanted, w2, List(), r))
       || any(traitLets(r), (t2) => letSatisfies(wanted, t2, r))
       || any(traitInstanceStmts(r), (t2) => instanceSatisfies(wanted, t2, r))
    ? noErrs()
    : oneErr(lr, "Trait parameter '" + ctWhereName(w)
                 + "' does not match any trait")

# A provider satisfies a constraint when it merges into it — an instance's own
# params are the holes, and an interface lifts through its ancestry
# (BasicMath<Int> is a BasicCompare<Int>).
fun satisfies(wanted, provider: Spec|None, own: List<String>, r)
  let m = mgGo(wanted, provider, map(own, (n) => MBind(n, None)), false, false, false, r)
  ret match(m.moSpec)
    (sp: Spec) => isEmpty(m.moErrs)
    ()         => false

fun letSatisfies(wanted, st: PStmt, r) => match(st)
  (let2: PsLet) => satisfies(wanted, let2.lType, List(), r)
  (o: PStmt)    => false

# PRE-LOWERING first-class instances: the pattern IS the interface.
fun instanceSatisfies(wanted, st: PStmt, r) => match(st)
  (ti: PsTraitInstance) => satisfies(wanted, ti.tiPattern, genNames(chain(ti.tiGens), List()), r)
  (o: PStmt)            => false

fun ctWhereName(sp) => match(sp)
  (n: SNamed) => n.snName
  (c: SClass) => c.scName
  (o: Spec)   => ""

fun ctSpecLine(sp) => match(sp)
  (b: SBuiltin)      => b.sbLine
  (n: SNamed)        => n.snLine
  (c: SClass)        => c.scLine
  (e2: SEnum)        => e2.seLine
  (g2: SGeneric)     => g2.sgLine
  (cl: SCallable)    => cl.sclLine
  (cm: SCombination) => cm.scmLine
  (t2: STuple)       => t2.stLine
  (af: SArrayField)  => af.safLine
  (ls: SLazyStub)    => ls.slsLine
