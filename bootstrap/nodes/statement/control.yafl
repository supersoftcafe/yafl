# bootstrap/nodes/statement/control.yafl — PsRet, PsAction, PsFieldAssign, PsIf, PsElseIf, PsElse: every question the
# compiler asks of this node kind, in one place (Python's pyast/statement/control.py).
namespace Bootstrap::Nodes

import System
import System::Containers

import Bootstrap::Ast
import Bootstrap::Codegen
import Bootstrap::Frontend
import Bootstrap::Ir
import Bootstrap::Lower::Ast
import Bootstrap::Parse
import Bootstrap::Resolve
import Bootstrap::StdlibCandidates
import Bootstrap::Types



fun blockEndLabel(f) => match(f)
  (fb: FrBlock) => "blockend$" + fb.fbTag
  (fl: FrLoop)  => ""   # unreachable: only called on a FrBlock

fun [tail] getBlockFrame(r): GenFrame|None => match(r)
  (rg: RGen) => match(rg.rgFrame)
    (fb: FrBlock) => rg.rgFrame
    (fl: FrLoop)  => getBlockFrame(rg.rgParent)
  (root: RRoot)    => None
  (d: RData)       => getBlockFrame(d.rdParent)
  (t2: RTypes)     => getBlockFrame(t2.rtParent)
  (sc: RScopes)    => getBlockFrame(sc.rsParent)
  (tr: RTraits)    => getBlockFrame(tr.rtrParent)
  (cb: RClassBody) => getBlockFrame(cb.rcbParent)

# A return converges on the FUNCTION's return type — that is how the expected
# type reaches every tail of the body.
fun compileRet(rt: PsRet, r, retType)
  let v = compileExpr(rt.retValue, r, retType)
  ret StmtOut(PsRet(v.eoExpr, rt.psrLine), v.eoGlobals, v.eoHints)

fun compileAction(a: PsAction, r)
  let v = compileExpr(a.action, r, None)
  ret StmtOut(PsAction(v.eoExpr, a.psaLine), v.eoGlobals, v.eoHints)

# The value is received by the FIELD's type, so a narrower value converts into a
# wider slot (a Node into a `Node|None`, a bare None into the union's empty case).
fun compileFieldAssign(fa: PsFieldAssign, r) => match(elementTarget(fa.faTarget))
  (et: ElementTarget) => compileElementTarget(fa, et, r)
  ()                  => compileFieldTarget(fa, r)

# An element target keeps its call shape — subject and index compiled, never
# the call itself — until the subject's class is known to have that array
# field; then it is the element's PeArrayRead (control.py __compile_target).
fun compileElementTarget(fa: PsFieldAssign, et: ElementTarget, r)
  let b = compileExpr(et.etDot.base, r, None)
  let ix = compileExpr(et.etIndex, r, SBuiltin("int32", fa.psfaLine))
  let target = match(arrayClassOf(b.eoExpr, r))
    (cs: PsClass) => isArrayFieldNamed(cs, et.etDot.member)
      ? PeArrayRead(b.eoExpr, ix.eoExpr, et.etCall.pecLine)
      : elementCall(et, b.eoExpr, ix.eoExpr)
    ()            => elementCall(et, b.eoExpr, ix.eoExpr)
  let v = compileExpr(fa.faValue, r, exprType(target, r))
  ret StmtOut(PsFieldAssign(target, v.eoExpr, fa.psfaLine),
              concat(concat(b.eoGlobals, ix.eoGlobals), v.eoGlobals),
              mergeHints(mergeHints(b.eoHints, ix.eoHints), v.eoHints))

fun elementCall(et: ElementTarget, base: PExpr, index: PExpr): PExpr => match(et.etCall.parameter)
  (t2: PeTuple) => PeCall(PeDot(base, et.etDot.member, et.etDot.pedLine, et.etDot.pedIndex),
                          PeTuple(append(List<PTupEnt>(), PTupEnt("", false, index)), t2.petLine),
                          et.etCall.pecLine)
  (o: PExpr)    => et.etCall   # unreachable: elementTarget matched a tuple

fun compileFieldTarget(fa: PsFieldAssign, r)
  let t1 = compileExpr(fa.faTarget, r, None)
  let v = compileExpr(fa.faValue, r, exprType(t1.eoExpr, r))
  ret StmtOut(PsFieldAssign(t1.eoExpr, v.eoExpr, fa.psfaLine),
              concat(t1.eoGlobals, v.eoGlobals),
              mergeHints(t1.eoHints, v.eoHints))

# Each branch folds its OWN else-if chain before compiling (the second fold
# site — a block's statement list is the first).
fun compileIf(i: PsIf, r, retType): StmtOut
  let cond = compileExpr(i.ifCond, r, SBuiltin("bool", i.psifLine))
  let t0 = collapseElseIf(i.ifTrue)
  let f0 = collapseElseIf(i.ifFalse)
  let t2 = compileStmts(t0, blockScope(t0, r), retType,
                        List(), List())
  let f = compileStmts(f0, blockScope(f0, r), retType,
                       List(), List())
  ret StmtOut(PsIf(cond.eoExpr, t2.slStmts, f.slStmts, i.psifLine),
              concat(cond.eoGlobals, concat(t2.slGlobals, f.slGlobals)),
              mergeHints(cond.eoHints,
                         mergeHints(withoutLocals(t2.slHints, t2.slStmts),
                                    withoutLocals(f.slHints, f.slStmts))))

fun checkRet(rt: PsRet, r, retTy: Spec|None) => match(exprType(rt.retValue, r))
  (xt: Spec) if triFalse(assignableEq(r, retTy, xt)) =>
      oneErr(rt.psrLine, "Incorrect return type")
  ()         => checkExpr(rt.retValue, r, retTy)

# No value vanishes silently: a statement-position expression discards its
# result. Unit carries nothing and is fine; anything else warns.
fun checkAction(a: PsAction, r)
  let errs = checkExpr(a.action, r, None)
  ret match(exprType(a.action, r))
    (xt: Spec) => isUnitType(xt)
      ? errs
      : add(errs, PErr(a.psaLine,
                          "statement value is discarded — bind it to '_' to "
                          + "discard explicitly", true, "discarded-value"))
    ()         => errs

# `subject.field := value` (pyast FieldAssignStatement.check): the left is a
# field of a class instance; the class is [pinnable] or [mutable]; the value fits
# the field's type. The compiler does not check that a pin is held.
fun checkFieldAssign(fa: PsFieldAssign, r) => union(
    union(checkExpr(fa.faTarget, r, None), checkExpr(fa.faValue, r, None)),
    fieldAssignErrors(fa, r))

fun fieldAssignErrors(fa: PsFieldAssign, r) => match(fa.faTarget)
  (d: PeDot) => match(writtenField(d, "':='", r))
    (cs: PsClass) => union(lateWriteErrors(fa.psfaLine, cs, "':='"), faValueFits(fa, r))
    (msg: String) => oneErr(fa.psfaLine, msg)
  (ar: PeArrayRead) => match(arrayClassOf(ar.arrObj, r))
    (cs: PsClass) => union(lateWriteErrors(fa.psfaLine, cs, "':='"), faValueFits(fa, r))
    ()            => oneErr(fa.psfaLine, "':=' writes an element of an array field of a class instance")
  (o: PExpr) => match(elementTarget(fa.faTarget))
    (et: ElementTarget) => oneErr(fa.psfaLine, notAnArrayField(et, r))
    ()                  => oneErr(fa.psfaLine,
                                  "the left of ':=' must be a field, as in 'subject.field := value'")

# `subject.items(i) := value`: the left side as written, a call on a field with
# one unnamed argument (control.py _element_target). Compile turns it into a
# PeArrayRead once the subject's class is known to have that array field.
class [final] ElementTarget(etCall: PeCall, etDot: PeDot, etIndex: PExpr)

fun elementTarget(target: PExpr): ElementTarget|None => match(target)
  (c: PeCall) => match(c.function)
    (d: PeDot) => match(soleIndexArg(c.parameter))
      (ix: PExpr) => ElementTarget(c, d, ix)
      ()          => None
    (o: PExpr) => None
  (o: PExpr)  => None

fun soleIndexArg(p: PExpr): PExpr|None => match(p)
  (t2: PeTuple) => match(exactly(t2.exprs, 1) ? head(t2.exprs) : None)
    (e2: PTupEnt) => e2.tupName == "" && !e2.tupSpread ? e2.tupValue : None
    ()            => None
  (o: PExpr)    => None

# The class of `subject`'s type when it is an array class (control.py
# _array_class).
fun arrayClassOf(subject: PExpr, r): PsClass|None => match(exprType(subject, r))
  (c2: SClass) => match(soleItem(findType(r, c2.scName)))
    (f: Found) => match(f.fStmt)
      (cs: PsClass) => isEmpty(arrayFieldsOf(classFields(cs), List())) ? None : cs
      (o: PStmt)    => None
    ()         => None
  (o: Spec)    => None
  ()           => None

# Whether the array field of `cs` is the one named `name`.
fun isArrayFieldNamed(cs: PsClass, name: String) => match(head(arrayFieldsOf(classFields(cs), List())))
  (af: PStmt) => nameMatches(stmtName(af), name)
  ()          => false

# An element target still in its call shape at check: the subject is not an
# array class, or the field is not its array.
fun notAnArrayField(et: ElementTarget, r): String => match(arrayClassOf(et.etDot.base, r))
  (cs: PsClass) => "'" + et.etDot.member + "' is not an array field of '" + bareOfUnique(cs.cName) + "'"
  ()            => match(exprType(et.etDot.base, r))
    (c2: SClass) => "'" + et.etDot.member + "' is not an array field of '" + bareOfUnique(c2.scName) + "'"
    (o: Spec)    => "':=' writes an element of an array field of a class instance"
    ()           => "':=' writes an element of an array field of a class instance"

# The field bounding an element write's index: the [capacity] field when the
# class has one (the storage holds that many elements, past the length), else
# the length field.
fun arrayBoundField(cs: PsClass, afSpec: SArrayField): String|None
  let fields = classFields(cs)
  ret match(firstWhere(fields, isCapacityField))
    (p: PStmt) => stmtName(p)
    ()         => match(fieldNamed2(fields, afSpec.safLenField))
      (l: PsLet) => l.lName
      ()          => None

fun faValueFits(fa: PsFieldAssign, r) => match(exprType(fa.faTarget, r))
  (ft: Spec) => match(exprType(fa.faValue, r))
    (vt: Spec) => triFalse(assignableEq(r, ft, vt))
      ? oneErr(fa.psfaLine, "Incorrect type assigned to the " + (fa.faTarget is PeArrayRead ? "element" : "field"))
      : noErrs()
    ()         => noErrs()
  ()         => noErrs()

fun checkIf(i: PsIf, r, retTy: Spec|None): Set<PErr>
  let condErr = checkExpr(i.ifCond, r, SBuiltin("bool", i.psifLine))
  let boolErr = match(exprType(i.ifCond, r))
    (ct: Spec) => triTrue(assignableEq(r, SBuiltin("bool", i.psifLine), ct))
      ? noErrs()
      : oneErr(exprLine(i.ifCond), "if condition must be Bool")
    ()         => noErrs()
  ret union(condErr,
      union(boolErr,
      union(branchChecks(i.ifTrue, blockScope(i.ifTrue, r), retTy,
                          noErrs()),
             branchChecks(i.ifFalse, blockScope(i.ifFalse, r), retTy,
                          noErrs()))))

# `subject.field := value`: an ordinary NON-fresh field store. The object was
# built long before this statement, across safe points, so the store owes the
# barriers any heap store owes.
fun genFieldAssign(fa: PsFieldAssign, r) => match(fa.faTarget)
  (d: PeDot) => match(exprType(d.base, r))
    (c: SClass) => genFieldAssignClass(fa, d, c, r)
    (o: Spec)   => emptyBundle()   # unreachable: check() requires a class subject
    ()          => emptyBundle()
  (ar: PeArrayRead) => match(arrayClassOf(ar.arrObj, r))
    (cs: PsClass) => genElementAssign(fa, ar, cs, r)
    ()            => emptyBundle()   # unreachable: check() requires an array class
  (o: PExpr) => emptyBundle()      # unreachable: check() requires a field

fun genFieldAssignClass(fa: PsFieldAssign, d: PeDot, c: SClass, r) => match(soleItem(findType(r, c.scName)))
  (found: Found) => match(found.fStmt)
    (cs: PsClass) => genFieldAssignField(fa, d, cs, r)
    (o: PStmt)    => emptyBundle()   # unreachable
  ()               => emptyBundle()   # unreachable

fun genFieldAssignField(fa: PsFieldAssign, d: PeDot, cs: PsClass, r) => match(head(classFindData(cs, r, d.member)))
  (found: Found) => match(found.fStmt)
    (l: PsLet) => genFieldAssignStore(fa, d, cs, l, r)
    (o: PStmt) => emptyBundle()      # unreachable: check() requires a field
  ()              => emptyBundle()   # unreachable

fun genFieldAssignStore(fa: PsFieldAssign, d: PeDot, cs: PsClass, l: PsLet, r)
  let baseB = genExpr(d.base, r)
  let valB = withPrefix(genExprTo(fa.faValue, r, exprType(fa.faTarget, r)), "fas")
  let place = RpObjectField(specGenerateOpt(l.lType, r), mustResult(baseB), cs.cName, d.member, None, false, false)
  ret bundleJoin(bundleJoin(baseB, valB),
                 bundleOp1(OpMove(place, mustResult(valB), false, Dict())))

# An element of the array field: the index checked against the bound
# (array_index_check), then an ordinary NON-fresh element store — the barriers
# any late store owes (control.py __generate_element).
fun genElementAssign(fa: PsFieldAssign, ar: PeArrayRead, cs: PsClass, r) => match(head(arrayFieldsOf(classFields(cs), List())))
  (l: PsLet) => match(asArrayFieldVariant(l.lType))
    (afSpec: SArrayField) => match(arrayBoundField(cs, afSpec))
      (bound: String) => genElementStore(fa, ar, cs, afSpec.safElem, bound, r)
      ()              => emptyBundle()   # unreachable: check() requires the length field
    ()                    => emptyBundle()   # unreachable
  ()         => emptyBundle()                 # unreachable

fun genElementStore(fa: PsFieldAssign, ar: PeArrayRead, cs: PsClass, elem: Spec, bound: String, r)
  let baseB = withPrefix(genExpr(ar.arrObj, r), "eab")
  let idxB = withPrefix(genExpr(ar.arrIndex, r), "eai")
  let valB = withPrefix(genExprTo(fa.faValue, r, elem), "eav")
  let baseVar = RpStackVar(CgDataPointer(false), "eabase")
  let idxVar = RpStackVar(CgInt(32), "eaindex")
  let checked = RpRuntimeInvoke("array_index_check",
                  RpNewStruct(list2(RpNamedValue("index", mustResult(idxB)),
                                    RpNamedValue("bound", RpObjectField(CgInt(32), baseVar, cs.cName, bound,
                                                                        None, false, false)))),
                  CgInt(32))
  let place = RpObjectField(specGenerate(elem, r), baseVar, cs.cName, "array", idxVar, false, false)
  let ops = arrayOf<Op>(OpMove(baseVar, mustResult(baseB), false, Dict()),
                      OpMove(idxVar, checked, false, Dict()),
                      OpMove(place, mustResult(valB), false, Dict()))
  ret bundleJoin(bundleJoin(bundleJoin(baseB, idxB), valB),
                 GBundle(list2(baseVar, idxVar), ops, None, List(), List()))

# A `return` never emits a function Return — it branches to the end of the
# nearest enclosing BlockExpression, supplying its value as one source of that
# block's end Phi. The value is coerced to the BLOCK's result type; the
# (exit-label, value) pair flows up via exit_sources.
fun genRet(rt: PsRet, r) => match(asFrBlock(getBlockFrame(r)))
  (f2: FrBlock) => genRetInFrame(rt, r, f2)
  ()             => bundleOp1(OpAbort("ReturnStatement generated outside any BlockExpression", Dict()))

# asFrLoop's twin (a two-step narrow: union member first, then variant).
fun asFrBlock(f: GenFrame|None) => match(f)
  (f2: GenFrame) => asFrBlockOf(f2)
  ()              => None

fun asFrBlockOf(f2) => match(f2)
  (fb: FrBlock) => fb
  (fl: FrLoop)  => None

fun genRetInFrame(rt: PsRet, r, frame)
  let vb = genExprTo(rt.retValue, r, frame.fbResultType)
  # The value itself transferred control away (a [tail] recur, an inner
  # return): no fall-through to jump from, and the block Phi must not receive
  # a source for this dead edge.
  ret bundleBottom(vb)
    ? GBundle(vb.gbStackVars, vb.gbOps, None, vb.gbRecurSources, vb.gbExitSources)
    : genRetJump(rt, frame, vb)

fun genRetJump(rt: PsRet, frame, vb: GBundle): GBundle
  let exitLabel = "blockexit$" + frame.fbTag + "$" + String(rt.retIndex)
  let tail = arrayOf<Op>(OpLabel(exitLabel, Dict()), OpJump(blockEndLabel(frame), Dict()))
  ret match(vb.gbResult)
    (rv: RParam) => genRetValued(rt, frame, vb, exitLabel, tail, rv)
    # This exit edge is the LAST phi source added so far, matching the label.
    ()            => GBundle(vb.gbStackVars, pushAll<Op>(vb.gbOps, tail), None,
                             vb.gbRecurSources,
                             append(vb.gbExitSources, ExitSource(exitLabel, None)))

fun genRetValued(rt: PsRet, frame: FrBlock, vb: GBundle, exitLabel,
                 tail: Array<Op>, rv)
  let valvar = RpStackVar(rpGetType(rv), "blockval$" + frame.fbTag + "$" + String(rt.retIndex))
  ret GBundle(append(vb.gbStackVars, valvar),
              pushAll<Op>(push<Op>(vb.gbOps, OpMove(valvar, rv, false, Dict())), tail),
              None, vb.gbRecurSources,
              append(vb.gbExitSources, ExitSource(exitLabel, valvar)))

# Branches are pure scopes (branch-local lets + nested fns, mirrored by
# localScope). Labels are prefix-relative names — with_prefix renames them per
# call site, exactly like Python's bare "T_branch"/"F_branch"/"if_end".
fun genIf(f2: PsIf, r, expected: Spec|None)
  let condBundle = withPrefix(genExpr(f2.ifCond, r), "cond")
  let trueBundle = genIfBranch(f2.ifTrue, r, expected, "T")
  let falseBundle = genIfBranch(f2.ifFalse, r, expected, "F")
  ret bundleJoin(condBundle,
      bundleJoin(bundleOps(arrayOf<Op>(OpJumpIf("T_branch", mustResult(condBundle), false, Dict()),
                                       OpLabel("F_branch", Dict()))),
      bundleJoin(falseBundle,
      bundleJoin(bundleOps(arrayOf<Op>(OpJump("if_end", Dict()),
                                       OpLabel("T_branch", Dict()))),
      bundleJoin(trueBundle,
                 bundleOp1(OpLabel("if_end", Dict())))))))

fun genIfBranch(stmts: List<PStmt>, r, expected: Spec|None, prefix): GBundle
  ret genIfBranchLoop(stmts, localScope(stmts, r), expected, prefix, 0, emptyBundle())

# State fields named to match another fold over the same types — workaround for #88.
fun genIfBranchLoop(ss: List<PStmt>, r: Resolver, expected: Spec|None,
                    prefix: String, i: Int, acc: GBundle): GBundle
  ret fold(ss, (acc = acc, i = i),
           (st, s) =>
             (acc = bundleJoin(st.acc, withPrefix(gsStmt(s, r, expected), prefix + "s" + String(st.i))),
              i = st.i + 1)).acc
