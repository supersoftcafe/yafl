# bootstrap/nodes/expression/call.yafl — PeCall: every question the
# compiler asks of this node kind, in one place (Python's pyast/expression/call.py).
namespace Bootstrap::Nodes

import System
import System::Containers

import Bootstrap::Ast
import Bootstrap::Codegen
import Bootstrap::Frontend
import Bootstrap::Ir
import Bootstrap::Lower::Ast
import Bootstrap::Parse
import Bootstrap::Resolve
import Bootstrap::StdlibCandidates
import Bootstrap::Types



fun compileCall(c: PeCall, r, expected)
  let before = paramShapeOf(calleeType(c.function, c.parameter, r))
  let arg = compileExpr(c.parameter, r, before)
  ret match(exprType(arg.eoExpr, r))
    (tp: STuple) => callWithShape(c, r, arg, tp, expected, before)
    ()           => partialCall(c, arg)

fun partialCall(c: PeCall, arg: ExprOut)
  ret ExprOut(PeCall(c.function, arg.eoExpr, c.pecLine, c.pecOrigin), arg.eoGlobals,
              arg.eoHints)

fun callWithShape(c: PeCall, r, arg, tp,
                  expected, before: Spec|None)
  let fn = compileExpr(c.function, r, SCallable(tp, expected, c.pecLine))
  let args = retriedArgs(arg, before,
                         paramShapeOf(calleeType(fn.eoExpr, arg.eoExpr, r)),
                         tp, r)
  ret ExprOut(converted(PeCall(fn.eoExpr, args.eoExpr, c.pecLine, c.pecOrigin), expected, r),
              concat(fn.eoGlobals, args.eoGlobals),
              mergeHints(fn.eoHints, args.eoHints))

# The callee pinned just now: give the open arguments its parameter types.
fun retriedArgs(arg, before: Spec|None, pinned, tp,
                r) => match(pinned)
  (p: Spec) => before is None && !isConcrete(tp)
    ? againOver(arg, compileExpr(arg.eoExpr, r, pinned))
    : arg
  ()        => arg

fun againOver(first: ExprOut, again: ExprOut)
  ret ExprOut(again.eoExpr, concat(first.eoGlobals, again.eoGlobals),
              again.eoHints)

fun paramShapeOf(ft: Spec|None) => match(ft)
  (cl: SCallable) => cl.scParams2
  ()              => None

fun checkCall(c: PeCall, r) => match(c.pecOrigin)
  (o: POrigin) => originErrs(o, c.pecLine, checkCallPlain(c, r))
  ()           => checkCallPlain(c, r)

# A lowered call's OWN errors are about a call the user never wrote: say what
# they did write (Python CallExpression.check). An argument's errors are about
# their code already — and when there are any, they are the cause: an argument
# of unknown type makes every candidate fit, so the call's own complaint would
# only be noise.
fun originErrs(o: POrigin, lr: PLine, errs: Set<PErr>): Set<PErr>
  let others = filter(errs, (e2) => !sameStart(e2.errLine, lr))
  ret !isEmpty(others) ? others
    : map(errs, (e2) => PErr(e2.errLine, originReword(o, e2.errMsg), e2.errWarn, e2.errCategory))

fun checkCallPlain(c: PeCall, r)
  let calleeParams = paramShapeOf(exprType(c.function, r))
  # The callee is LOADED to be called, so its check gets everything this call
  # knows about it: a function taking these arguments. The load narrows its
  # overloads by that shape and reports none or several (Python __check).
  let fnErrs = checkExpr(c.function, r, callShape(c, r))
  let argErrs = checkExpr(c.parameter, r, calleeParams)
  # An argument with an error has no type to narrow by, so every candidate
  # "might" take it and the callee would only add noise ("ambiguous"): the
  # argument's error is the cause.
  if !isEmpty(argErrs) && !argumentsTyped(c, r)
    ret argErrs
  let sub = union(fnErrs, argErrs)
  if !isEmpty(sub)
    ret sub
  ret match(exprType(c.parameter, r))
    (tp: STuple) => callShapeErrs(c, tp, r)
    ()           => oneErr(c.pecLine, "parameter expression must be of TupleType")

fun callShapeErrs(c: PeCall, ptype, r) => match(exprType(c.function, r))
  (ft: Spec) => match(ft)
    (cl: SCallable) => triFalse(assignableFrom(r, cl.scParams2, ptype))
      ? oneErr(c.pecLine, "Parameters are not assignment compatible")
      : noErrs()
    (o: Spec)       => add(noErrs(), unresolvedCallError(c, ptype, ft, r))
  ()         => add(noErrs(), unresolvedCallError2(c, ptype, r))

fun entryTyped(e: SEntry): Bool => match(e.seType)
  (sp: Spec) => true
  ()         => false

fun argumentsTyped(c: PeCall, r): Bool => match(exprType(c.parameter, r))
  (tp: STuple) => all(tp.stEntries, entryTyped)
  ()           => false

# What this call tells its callee: a function of the argument tuple (None
# while the arguments have no type to say).
fun callShape(c: PeCall, r): Spec|None => match(exprType(c.parameter, r))
  (tp: STuple) => SCallable(tp, None, c.pecLine)
  ()           => None

# A load's candidates narrowed by the call shape it is loaded for. Any other
# expected type leaves them alone.
fun narrowedByCall(cands: List<Found>, expected: Spec|None, r): Bag<Found> => match(expected)
  (c: SCallable) => resolveOverloads(r, c, cands)
  (o: Spec)      => Bag(cands)
  ()             => Bag(cands)

# Nothing among `cands` accepts the call: qualifying is impossible, so say
# which arguments failed and what the candidates actually take.
fun noMatchErrs(line: PLine, name: String, expected: Spec|None, cands: List<Found>): Set<PErr> =>
  match(expected)
    (c: SCallable) => oneErr(line, "no " + backTicked(bareOfUnique(name))
                                   + " accepts arguments " + typeStr2(c.scParams2)
                                   + " — candidates: "
                                   + join(sort(dedupeStrs(candidateSigs(cands, List()))), "; "))
    (o: Spec)      => noErrs()
    ()             => noErrs()

# The callee didn't resolve to a single callable. Say WHY in the author's
# terms: the called name, the argument types, the candidate signatures.
fun unresolvedCallError2(c: PeCall, ptype, r) => match(c.function)
  (nm: PeName) => namedCallError(c, nm, ptype, r)
  (o: PExpr)   => PErr(c.pecLine,
                       "the value being called is not a function (its type is unknown)")

fun unresolvedCallError(c: PeCall, ptype, ft: Spec, r) => match(c.function)
  (nm: PeName) => namedCallError(c, nm, ptype, r)
  (o: PExpr)   => PErr(c.pecLine,
                       "the value being called is not a function (its type is "
                       + typeStr(ft) + ")")

fun namedCallError(c: PeCall, nm: PeName, ptype, r)
  let name = backTicked(bareOfUnique(nm.refName))
  let cands = findData(r, nm.refName).bItems
  if isEmpty(cands)
    ret PErr(c.pecLine, "no function named " + name + " is in scope")
  let sigs = candidateSigs(cands, List())
  if isEmpty(sigs)
    ret match(firstNonCallable(cands))
      (t2: Spec) => PErr(c.pecLine, name + " is not a function — it is a "
                                    + typeStr(t2))
      ()         => PErr(c.pecLine,
                         "no " + name + " accepts arguments "
                         + typeStr2(ptype) + " — candidates: ")
  ret PErr(c.pecLine,
           "no " + name + " accepts arguments " + typeStr2(ptype)
           + " — candidates: " + join(sort(dedupeStrs(sigs)), "; "))

fun backTicked(raw) => startsWith(raw, "`") ? raw : "`" + raw + "`"

fun candidateSigs(cs: List<Found>, acc): List<String> =>
  fold(cs, acc, candidateSigsStep)

fun candidateSigsStep(a: List<String>, x: Found) => match(candidateSignature(x))
  (ty: Spec) => match(ty)
    (cl: SCallable) => append(a, typeStr(ty))
    (o: Spec) => a
  () => a

fun firstNonCallable(cs: List<Found>) => firstSome(cs, nonCallableType)

fun nonCallableType(c: Found) => match(stmtType(c.fStmt))
  (ty: Spec) => match(ty)
    (cl: SCallable) => None
    (o: Spec)       => ty
  ()         => None

# The callee's type as THIS call sees it: tuples its signature leaves unnamed
# carry the field names the arguments supply (call.py __callee_type).
# `function` and `parameter` are the call's parts as they now stand — compile
# asks about the ones it has just compiled.
fun calleeType(function: PExpr, parameter: PExpr, r): Spec|None =>
  namedAtCallSite(exprType(function, r), exprType(parameter, r))

# A call's type is its callee's RESULT — and nothing else. A callee that has
# not resolved to a callable yet simply has no result yet.
fun typeOfCall(c: PeCall, r) => match(calleeType(c.function, c.parameter, r))
  (cl: SCallable) => callResultType(c, cl.scResult, r)
  ()              => None

fun genCall(c: PeCall, r) => match(exprType(c.function, r))
  (cl: SCallable) => genCallOn(c, cl, r)
  ()              => emptyBundle()          # unreachable

fun genCallOn(c: PeCall, cl: SCallable, r)
  let funBundle = withPrefix(genExpr(c.function, r), "fn")
  let prmBundle = withPrefix(genExprTo(c.parameter, r, cl.scParams2), "args")
  let funRef = mustResult(funBundle)
  let resultType = specGenerateOpt(cl.scResult, r)
  let resultVar = RpStackVar(resultType, "result")
  let callOp = OpCall(funRef, mustResult(prmBundle), resultVar, false, isImpureCall(funRef), None, Dict())
  let callBundle = GBundle(list1(resultVar), arrayOf<Op>(callOp), resultVar, List(), List())
  ret bundleJoin(bundleJoin(funBundle, prmBundle), callBundle)

fun isImpureCall(funRef) => match(funRef)
  (gf: RpGlobalFunction) => gf.impure
  (o: RParam)             => false
