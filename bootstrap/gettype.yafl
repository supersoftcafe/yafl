# bootstrap/gettype.yafl — get_type for STATEMENTS, ported from the get_type
# methods in compiler/pyast/statement/.
#
# Nothing here caches. A statement's type is DERIVED from the statement each
# time it is asked for — that is what lets the compile fixpoint use plain
# structural equality of the AST as its termination test (see equality.yafl):
# the tree is the whole state, and every type is a function of it.
#
# The expression half (get_type over PExpr) lands with the expression pass.
namespace Bootstrap

import System

# A let's type is simply what it declares (inference fills that in).
fun letType(l: PsLet): Spec|None
  ret l.lType

# A destructure IS a tuple type — and this is where a parameter's `= literal`
# default surfaces, into the CallableSpec that every call site sees.
fun destructureType(d: PsDestructure): Spec
  ret STuple(targetEntries(chain(d.dTargets), List<SEntry>()), d.psdLine)

fun [tail] targetEntries(ts: Chain<PStmt>, acc: List<SEntry>): List<SEntry>
  ret match(ts)
    (nil: ChainEnd) => acc
    (l: ChainLink)  => targetEntries(l.next, addTarget(acc, l.value))

fun addTarget(acc: List<SEntry>, st: PStmt): List<SEntry>
  ret match(st)
    (l: PsLet) => append(acc, SEntry(l.lName, l.lType, l.lDefault))
    (o: PStmt) => acc

# A function is a callable over its parameter tuple.
fun funType(f: PsFun): Spec
  ret SCallable(paramsTupleOf(f.fParams), f.fRet, f.psfLine)

# The parameter tuple of a fun/class param list. A class's parameters are its
# STRUCTURAL type — which is what a [final] class member of a union is
# represented as (see conversions.yafl).
fun paramsTupleOf(params: PStmt): Spec
  ret match(params)
    (d: PsDestructure) => destructureType(d)
    (o: PStmt)         => STuple(List<SEntry>(), stmtLine(o))

fun paramsTuple(params: PStmt): Spec|None
  ret paramsTupleOf(params)

# The type a statement DECLARES, if it declares one.
fun stmtType(st: PStmt): Spec|None
  ret match(st)
    (f: PsFun)         => funType(f)
    (l: PsLet)         => letType(l)
    (d: PsDestructure) => destructureType(d)
    (o: PStmt)         => None


# ── expressions ─────────────────────────────────────────────────────────────
# get_type over PExpr. Nothing is cached: a type is DERIVED from the node and
# the resolver every time it is asked for. That is what lets the fixpoint use
# structural equality of the AST as its termination test — the tree is the whole
# state (see equality.yafl).
#
# `None` means "not knowable YET", never "no type": an unresolved name, a call
# whose callee has not resolved, a lambda not yet inferred. The fixpoint asks
# again next pass.

fun exprType(x: PExpr, r: Resolver): Spec|None
  ret match(x)
    (i: PeInt)       => SBuiltin(intBuiltin(i.precision), i.peiLine)
    (f: PeFloat)     => SBuiltin(floatBuiltin(f.fPrecision), f.pefLine)
    (bo: PeBool)     => SBuiltin("bool", bo.pebLine)
    (st: PeStr)      => SBuiltin("str", st.pesLine)
    (rx: PeRegex)    => SBuiltin("str", rx.perLine)
    (n: PeNothing)   => None
    (nm: PeName)     => nameType(nm, r)
    (d: PeDot)       => dotType(d, r)
    (c: PeCall)      => callType(c, r)
    (tp: PeTuple)    => tupleType(tp, r)
    (te: PeTernary)  => join(exprType(te.trueResult, r),
                            exprType(te.falseResult, r))
    (lm: PeLambda)   => None            # filled in by inference, not derived
    (bk: PeBlock)    => exprType(bk.blockValue, r)
    (mt: PeMatch)    => matchType(mt, r)
    (op: PeBuiltinOp) => op.opType
    (pl: PeParallel) => None
    (ne: PeNewEnum)  => newEnumType(ne, r)
    (nw: PeNew)      => nw.newType
    (ar: PeArrayRead) => arrayReadType(ar, r)
    (cv: PeConvert)   => cv.convTarget

# A literal's precision names its builtin (0 = the unbounded default).
fun intBuiltin(precision: Int): String
  ret precision == 0 ? "bigint"
    : precision == 8 ? "int8"
    : precision == 16 ? "int16"
    : precision == 32 ? "int32"
    : "int64"

fun floatBuiltin(precision: Int): String
  ret precision == 32 ? "float32" : "float64"

# A name's type is its DECLARATION's type — so a name that resolves to exactly
# one statement has a type, and one that is ambiguous or unresolved does not
# (yet). An INCOMPLETE search proves nothing: defer.
fun nameType(nm: PeName, r: Resolver): Spec|None
  let bag = findData(r, nm.refName)
  if !bag.bComplete
    ret None
  ret match(soleItem(bag))
    (f: Found) => stmtType(f.fStmt)
    ()         => None

# A branch's type is the JOIN of its arms' own types — the honest set union,
# independent of any expected type.
fun matchType(mt: PeMatch, r: Resolver): Spec|None
  ret armJoin(chain(mt.arms), r, None)

fun [tail] armJoin(as2: Chain<PArm>, r: Resolver, acc: Spec|None): Spec|None
  ret match(as2)
    (nil: ChainEnd) => acc
    (l: ChainLink)  => armJoin(l.next, r, join(acc, exprType(l.value.armBody, r)))

# A call's type is its callee's RESULT — and nothing else. A callee that has
# not resolved to a callable yet simply has no result yet.
fun callType(c: PeCall, r: Resolver): Spec|None
  ret match(exprType(c.function, r))
    (ft: Spec) => match(ft)
      (cl: SCallable) => cl.scResult
      (o: Spec)       => None
    ()         => None

fun tupleType(tp: PeTuple, r: Resolver): Spec|None
  ret STuple(tupEntries(chain(tp.exprs), r, List<SEntry>()), tp.petLine)

fun [tail] tupEntries(es: Chain<PTupEnt>, r: Resolver,
                      acc: List<SEntry>): List<SEntry>
  ret match(es)
    (nil: ChainEnd) => acc
    (l: ChainLink)  => tupEntries(l.next, r,
                                  append(acc, SEntry(l.value.tupName,
                                                     exprType(l.value.tupValue, r),
                                                     None)))

# An enum constructor yields the ROOT enum type, read from the declaration —
# never from a spec instance in hand (which may be a stale copy).
fun newEnumType(ne: PeNewEnum, r: Resolver): Spec|None
  ret match(soleItem(findType(r, ne.rootName)))
    (f: Found) => match(f.fStmt)
      (e: PsEnum) => e.eSpec
      (o: PStmt)  => None
    ()         => None

# A field read: through a tuple by entry NAME, through a class or enum by
# looking the member up on the DECLARATION.
fun dotType(d: PeDot, r: Resolver): Spec|None
  ret match(exprType(d.base, r))
    (bt: Spec) => memberType(bt, d.member, r)
    ()         => None

fun memberType(bt: Spec, name: String, r: Resolver): Spec|None
  ret match(bt)
    (t2: STuple) => entryNamed(chain(t2.stEntries), name)
    (c: SClass)  => classMemberType(c, name, r)
    (e: SEnum)   => enumFieldType(e, name)
    (o: Spec)    => None

fun [tail] entryNamed(es: Chain<SEntry>, name: String): Spec|None
  ret match(es)
    (nil: ChainEnd) => None
    (l: ChainLink)  => l.value.seName == name
      ? l.value.seType
      : entryNamed(l.next, name)

fun classMemberType(c: SClass, name: String, r: Resolver): Spec|None
  ret match(soleItem(findType(r, c.scName)))
    (f: Found) => match(f.fStmt)
      (cs: PsClass) => classMemberOf(cs, name)
      (o: PStmt)    => None
    ()         => None

fun classMemberOf(cs: PsClass, name: String): Spec|None
  ret memberOfTuple(paramsTupleOf(cs.cParams), name)

fun memberOfTuple(t2: Spec, name: String): Spec|None
  ret match(t2)
    (tp: STuple) => entryNamed(chain(tp.stEntries), name)
    (o: Spec)    => None

# An enum's fields live on the spec's all_fields — which compile_types refreshes
# from the declaration every pass, so this never reads a stale copy.
fun [tail] fieldNamed(fs: Chain<SField>, name: String): Spec|None
  ret match(fs)
    (nil: ChainEnd) => None
    (l: ChainLink)  => l.value.sfName == name
      ? l.value.sfType
      : fieldNamed(l.next, name)

fun enumFieldType(e: SEnum, name: String): Spec|None
  ret fieldNamed(chain(e.seAllFields), name)

# An array read yields the ELEMENT type of the array field it indexes.
fun arrayReadType(ar: PeArrayRead, r: Resolver): Spec|None
  ret match(exprType(ar.arrObj, r))
    (ot: Spec) => elementOf(ot)
    ()         => None

fun elementOf(ot: Spec): Spec|None
  ret match(ot)
    (af: SArrayField) => af.safElem
    (o: Spec)         => None
