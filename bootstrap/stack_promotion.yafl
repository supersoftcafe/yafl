# bootstrap/stack_promotion.yafl — ported from lowering/stack_promotion.py:
# promote non-escaping heap objects to per-field stack locals. A NewObject
# creates a blank heap instance the following ops fill in by field stores;
# if the pointer never leaves the function, the allocation — and every GC
# cost attached to it — buys nothing. A promoted object dissolves into ONE
# LOCAL PER FIELD (`reg$field`): stores and reads become plain Moves and
# StackVar reads. ESCAPES (any one disqualifies): returned / call arg /
# Phi'd; bare pointer consumed anywhere (a field READ of it is fine);
# saved across a suspension; an unmodelled op shape reading it; a
# multiply-defined register; an arrayed/mutable/foreign class; a sized
# NewObject. Runs between phi_removal and async_lower (the field locals are
# multi-write by nature, so this lives on the non-SSA side).
namespace Bootstrap

import System

# One promotable candidate: register name → the class's payload fields.
class [final] SpCand(spReg: String, spPayload: List<CgField>)

# The class's payload (fields minus the vtable header), or None when the
# shape isn't promotable.
fun spPayloadFields(obj: CgObject|None): List<CgField>|None
  ret match(obj)
    (o: CgObject) => o.objLengthField is None && !o.objIsMutable
                     && !o.objIsForeign
      ? spFieldsOf(o)
      : None
    ()            => None

fun spFieldsOf(o: CgObject): List<CgField>|None
  let fields = filter(cgFieldsOfOrEmpty(o.objFields),
                      (f: CgField) => f.fieldName != "type")
  ret any(fields, (f: CgField) => spIsArray(f.fieldType)) ? None : fields

fun spIsArray(t2: CgType): Bool
  ret t2 is CgArray

fun spZeroOf(ft: CgType): RParam
  ret match(ft)
    (dp: CgDataPointer) => RpNullPointer()
    (i: CgInt)          => RpInteger(0, i.precision)
    (o: CgType)         => RpZeroOf(ft)

# True if `name` occurs in `param`'s tree anywhere other than as the base of
# a plain ObjectField read — i.e. the raw pointer is consumed.
fun spBarePointerIn(param: RParam|None, name: String): Bool
  ret match(param)
    (p: RParam) => spBareIn(p, name)
    ()          => false

fun spBareIn(p: RParam, name: String): Bool
  ret match(p)
    (sv: RpStackVar)    => sv.name == name
    (of: RpObjectField) => spBaseIsName(of.pointer, name)
      ? spBarePointerIn(of.index, name)
      : spBareIn(of.pointer, name) || spBarePointerIn(of.index, name)
    # Any other compound (NewStruct pack, RuntimeInvoke args, …): an
    # occurrence anywhere in here is the pointer travelling. Conservative
    # by construction.
    (o: RParam)         => rpTest(p, (q: RParam) => saIsVarNamed(q, name))

fun spBaseIsName(ptr: RParam, name: String): Bool
  ret match(ptr)
    (sv: RpStackVar) => sv.name == name
    (o: RParam)      => false

# ── candidate discovery ─────────────────────────────────────────────────────

fun spCandidates(f: CgFunction, a: CgApp): List<SpCand>
  let news = fold(f.fnOps, List<SpCand>(),
                  (acc: List<SpCand>, op: Op) => spNewsOp(acc, op, a))
  ret filter(news,
             (c: SpCand) => spDefCount(f.fnOps, c.spReg) == 1
                            && !any(f.fnOps,
                                    (op: Op) => spOpEscapes(op, c.spReg)))

fun spNewsOp(acc: List<SpCand>, op: Op, a: CgApp): List<SpCand>
  ret match(op)
    (no: OpNewObject) => no.newObjSize is None
      ? spNewsRegister(acc, no, a)
      : acc
    (o: Op)           => acc

fun spNewsRegister(acc: List<SpCand>, no: OpNewObject, a: CgApp): List<SpCand>
  ret match(no.newObjRegister)
    (sv: RpStackVar) => match(spPayloadFields(appObject(a, no.newObjName)))
      (payload: List<CgField>) => append(acc, SpCand(sv.name, payload))
      ()                       => acc
    (o: RParam)      => acc

fun spDefCount(ops: List<Op>, name: String): Int
  ret fold(ops, 0,
           (n: Int, op: Op) => n + countIf(opGetLiveVars(op).writes,
                                           (sv: RParam) => saIsVarNamed(sv,
                                                                        name)))

fun countIf<T>(l: List<T>, pred: (:T): Bool): Int
  ret listLen(filter(l, pred))

fun spOpEscapes(op: Op, name: String): Bool
  if any(opSavedVars(op), (sv: RParam) => saIsVarNamed(sv, name))
    ret true
  ret match(op)
    (c: OpCall)          => spReadsName(op, name)
    (pc: OpParallelCall) => spReadsName(op, name)
    (r: OpReturn)        => spReadsName(op, name)
    (ph: OpPhi)          => spReadsName(op, name)
    (m: OpMove)          => spMoveEscapes(m, name)
    (ji: OpJumpIf)       => spBareIn(ji.jumpIfCondition, name)
    (sw: OpSwitchJump)   => spBareIn(sw.switchCondition, name)
    (no: OpNewObject)    => false
    (o: Op)              => spReadsName(op, name)

fun spReadsName(op: Op, name: String): Bool
  ret any(opGetLiveVars(op).reads, (sv: RParam) => saIsVarNamed(sv, name))

fun spMoveEscapes(m: OpMove, name: String): Bool
  if spBareIn(m.moveSource, name)
    ret true
  ret match(m.moveTarget)
    (of: RpObjectField) => spBaseIsName(of.pointer, name)
      # Store INTO the candidate = constructor write; the pointer is the
      # base, not the value. An indexed store needs the index checked.
      ? spBarePointerIn(of.index, name)
      : spBareIn(of.pointer, name)
    (o: RParam)         => false

# ── the rewrite ─────────────────────────────────────────────────────────────

fun promoteToStack(a: CgApp): CgApp
  ret appWithFunctions(a, map(a.appFunctions,
                              (f: CgFunction) => spFunction(f, a)))

fun spFunction(f: CgFunction, a: CgApp): CgFunction
  let promoted = spCandidates(f, a)
  if isEmpty(promoted)
    ret f
  let newOps = fold(f.fnOps, List<Op>(),
                    (acc: List<Op>, op: Op) => spRewriteOp(acc, op,
                                                           promoted))
  ret cgFunctionWith(f, newOps, spRestack(f, promoted))

fun [tail] spCandFor(cs: Chain<SpCand>, name: String): SpCand|None
  ret match(cs)
    (nil: ChainEnd) => None
    (l: ChainLink)  => l.value.spReg == name ? l.value : spCandFor(l.next,
                                                                  name)

fun spFieldLocal(cand: SpCand, field: String): RParam
  let ft = spFieldType(chain(cand.spPayload), field)
  ret RpStackVar(ft, cand.spReg + "$" + field)

fun [tail] spFieldType(fs: Chain<CgField>, field: String): CgType
  ret match(fs)
    (nil: ChainEnd) => CgVoid()
    (l: ChainLink)  => l.value.fieldName == field
      ? l.value.fieldType
      : spFieldType(l.next, field)

fun spRewrite(p: RParam, promoted: List<SpCand>): RParam
  ret match(p)
    (of: RpObjectField) => of.index is None
      ? spRewriteField(of, promoted)
      : p
    (o: RParam)         => p

fun spRewriteField(of: RpObjectField, promoted: List<SpCand>): RParam
  ret match(of.pointer)
    (sv: RpStackVar) => match(spCandFor(chain(promoted), sv.name))
      (cand: SpCand) => spFieldLocal(cand, of.field)
      ()             => of
    (o: RParam)      => of

fun spRewriteOp(acc: List<Op>, op: Op, promoted: List<SpCand>): List<Op>
  ret match(op)
    (no: OpNewObject) => match(spPromotedRegister(no, promoted))
      (cand: SpCand) => spZeroFills(acc, cand)
      ()             => append(acc, spReplaced(op, promoted))
    (m: OpMove)       => match(spPromotedStore(m, promoted))
      (cand: SpCand) => append(acc, spStoreMove(m, cand, promoted))
      ()             => append(acc, spReplaced(op, promoted))
    (o: Op)           => append(acc, spReplaced(op, promoted))

fun spReplaced(op: Op, promoted: List<SpCand>): Op
  ret opReplaceParams(op, (p: RParam) => spRewrite(p, promoted))

fun spPromotedRegister(no: OpNewObject, promoted: List<SpCand>): SpCand|None
  ret match(no.newObjRegister)
    (sv: RpStackVar) => spCandFor(chain(promoted), sv.name)
    (o: RParam)      => None

# NewObject zero-fills; the field locals must match so a partially-
# initialised read stays defined.
fun spZeroFills(acc: List<Op>, cand: SpCand): List<Op>
  ret fold(cand.spPayload, acc,
           (a2: List<Op>, fld: CgField) =>
             append(a2, OpMove(spFieldLocal(cand, fld.fieldName),
                               spZeroOf(fld.fieldType), false,
                               List<RParam>())))

fun spPromotedStore(m: OpMove, promoted: List<SpCand>): SpCand|None
  ret match(m.moveTarget)
    (of: RpObjectField) => of.index is None
      ? match(of.pointer)
        (sv: RpStackVar) => spCandFor(chain(promoted), sv.name)
        (o: RParam)      => None
      : None
    (o: RParam)         => None

fun spStoreMove(m: OpMove, cand: SpCand, promoted: List<SpCand>): Op
  let field = match(m.moveTarget)
    (of: RpObjectField) => of.field
    (o: RParam)         => ""
  ret OpMove(spFieldLocal(cand, field),
             rpReplaceParams(m.moveSource,
                             (p: RParam) => spRewrite(p, promoted)),
             false, List<RParam>())

# Declare the field locals; retire the promoted registers.
fun spRestack(f: CgFunction, promoted: List<SpCand>): CgType
  let kept = filter(cgFieldsOfOrEmpty(f.fnStackVars),
                    (fld: CgField) => spCandFor(chain(promoted),
                                                fld.fieldName) is None)
  ret CgStruct(fold(promoted, kept, spCandFields))

fun spCandFields(acc: List<CgField>, cand: SpCand): List<CgField>
  ret fold(cand.spPayload, acc,
           (a2: List<CgField>, fld: CgField) =>
             append(a2, CgField(cand.spReg + "$" + fld.fieldName,
                                fld.fieldType)))
