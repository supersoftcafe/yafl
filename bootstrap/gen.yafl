# bootstrap/gen.yafl — the Application C-emission assembly, ported from
# codegen/gen.py: per-function cleanup + prototype/implement emission,
# per-object hashed vtables (typedef + VTABLE_DECLARE with linear probing) in
# extends order, per-global emission with GC-root path collection, the
# _declare_roots chain and main(), all threaded through ONE type cache in
# Python's exact sequence — anonymous-struct numbering depends on it.
# gen() validation of __entrypoint__'s shape lives in the driver.
namespace Bootstrap

import System

# ── pointer paths (typedecl get_pointer_paths) ───────────────────────────────

fun cgTypePointerPaths(t2: CgType, path: String): List<String>
  ret match(t2)
    (d: CgDataPointer)      => list1(path)
    (fp: CgFuncPointer)     => list1(path + ".o")
    (s2: CgStruct)          => cgPathsFields(s2.fields, path)
    (im: CgImmediateStruct) => cgPathsFields(im.fields, path)
    (o: CgType)             => List<String>()

fun cgPathsFields(fields: List<CgField>, path: String): List<String>
  ret fold(fields, List<String>(), (acc: List<String>, f2: CgField) =>
        concat(acc, cgTypePointerPaths(f2.fieldType, path + "." + mangleName(f2.fieldName))))

# ── function-id enum ─────────────────────────────────────────────────────────

fun genFunctionIds(methodIds: List<MethodId>): String
  if isEmpty(methodIds)
    ret ""
  ret "enum {" + join(map(methodIds, (m: MethodId) =>
        "\n    __FUNCTION_ID__" + mangleName(m.mName) + " = rotate_function_id(" + String(m.mId) + ")"), ",")
      + "\n};\n"

fun miIdOf(methodIds: List<MethodId>, name: String): Int
  ret match(head(filter(methodIds, (m: MethodId) => m.mName == name)))
    (m: MethodId) => m.mId
    ()             => 0   # unreachable: every slot id was assigned

fun vsSizeOf(sizes: List<VtableSize>, name: String): Int
  ret match(head(filter(sizes, (v: VtableSize) => v.vsClassName == name)))
    (v: VtableSize) => v.vsSize
    ()               => 1   # unreachable: sizes computed for every object

# ── the emission accumulator (Python's per-Application string lists) ─────────

class [final] GenAcc(gaCache: List<CgCacheEntry>, gaTypedefs: List<String>,
                     gaForwards: List<String>, gaVariables: List<String>,
                     gaFunctions: List<String>, gaGcRoots: List<String>)

fun genAccEmpty(): GenAcc
  ret GenAcc(List<CgCacheEntry>(), List<String>(), List<String>(),
             List<String>(), List<String>(), List<String>())

# ── per-function: cleanup chain then prototype + implement ───────────────────

fun genFunction(acc: GenAcc, f0: CgFunction): GenAcc
  # SSA → imperative first (Phi → per-edge Moves while the CFG is intact);
  # everything downstream is Phi-unaware.
  let f = cgFunctionEliminateCSE(cgFunctionSimplifyControlFlow(cgFunctionCopyPropagate(
            cgFunctionFoldStructFields(cgFunctionSimplifyControlFlow(
              cgFunctionStripUnusedOperations(cgFunctionLowerPhis(f0)))))))
  let proto = cgFunctionToCPrototype(f, acc.gaCache)
  let impl = cgFunctionToCImplement(f, proto.cache)
  ret GenAcc(impl.cache, acc.gaTypedefs,
             append(acc.gaForwards, proto.text), acc.gaVariables,
             append(acc.gaFunctions, impl.text), acc.gaGcRoots)

fun genExtern(acc: GenAcc, f: CgFunction): GenAcc
  let ext = cgFunctionToCExtern(f, acc.gaCache)
  ret GenAcc(ext.cache, acc.gaTypedefs, append(acc.gaForwards, ext.text),
             acc.gaVariables, acc.gaFunctions, acc.gaGcRoots)

# ── extends-order object walk (DFS, insertion tie-break, pre-marked) ─────────

fun objectsInExtendsOrder(a: CgApp): List<CgObject>
  ret fold(a.appObjects, (List<CgObject>(), List<String>()),
           (acc: (order: List<CgObject>, seen: List<String>), o: CgObject) =>
             objVisit(acc, o.objName, a)).order

fun objVisit(acc: (order: List<CgObject>, seen: List<String>), name: String,
             a: CgApp): (order: List<CgObject>, seen: List<String>)
  if strListMember(acc.seen, name)
    ret acc
  # Pre-mark: extends cycles terminate; foreign/extern parents not in the
  # registry are marked and skipped rather than emitted.
  let marked = (acc.order, strListAdd(acc.seen, name))
  ret match(appObject(a, name))
    (o: CgObject) => objVisitParents(marked, o, a)
    ()             => marked

fun objVisitParents(acc: (order: List<CgObject>, seen: List<String>), o: CgObject,
                    a: CgApp): (order: List<CgObject>, seen: List<String>)
  let afterParents = fold(o.objExtends, acc,
        (a2: (order: List<CgObject>, seen: List<String>), p: String) => objVisit(a2, p, a))
  ret (append(afterParents.order, o), afterParents.seen)

# ── per-object: hashed vtable + typedef + VTABLE_DECLARE ─────────────────────

class [final] VtRow(vtI: String, vtF: String)

fun vtDefaultRow(): VtRow
  ret VtRow("-1", "(void*)&abort_on_vtable_lookup")

fun vtIsDefault(r: VtRow): Bool
  ret r.vtI == "-1"

fun genObject(acc: GenAcc, o: CgObject, methodIds: List<MethodId>,
              sizes: List<VtableSize>): GenAcc
  let vtableSize = vsSizeOf(sizes, o.objName)
  let rows0 = vtRows(vtableSize, List<VtRow>())
  let rows1 = fold(o.objFunctions, rows0, (rs: List<VtRow>, s2: CgFuncSlot) =>
                vtPlace(rs, s2, methodIds, vtableSize))
  # Ensure the last entry is an empty catch-all.
  let rows = vtLastIsDefault(rows1) ? rows1 : append(rows1, vtDefaultRow())
  let mangled = mangleName(o.objName)
  let implementsArr = map(o.objExtends, (e2: String) => "obj_" + mangleName(e2))
  let vtableStr = join(map(rows, (r: VtRow) =>
        "\n        { .i = " + r.vtI + ", .f = " + r.vtF + " }"), ",")
  let commentLine = cgObjectCommentLine(o)
  let typedefDecl = cgDeclare(o.objFields, acc.gaCache)
  let typedefs1 = append(acc.gaTypedefs,
        commentLine + "typedef " + typedefDecl.text + " ALIGNED " + mangled + "_t;\n")
  let arrElSize = cgObjectGetArrayElSize(o, typedefDecl.cache)
  let arrPtrMask = cgObjectGetArrayPointerMask(o, arrElSize.cache)
  let masks = genObjectMasks(o, commentLine, mangled)
  let variables1 = concat(concat(acc.gaVariables, masks.gmVarLines),
        list1(commentLine + "static vtable_t* const obj_" + mangled
              + " = VTABLE_DECLARE(" + String(listLen(rows)) + "){\n"
              + "    .object_size = " + cgObjectGetObjectSize(o) + ",\n"
              + "    .array_el_size = " + arrElSize.text + ",\n"
              + "    .functions_mask = rotate_function_id(" + String(vtableSize - 1) + "),\n"
              + "    .object_pointer_locations = " + cgObjectGetPointerMask(o) + ",\n"
              + "    .array_el_pointer_locations = " + arrPtrMask.text + ",\n"
              + masks.gmMasksInit
              + "    .array_len_offset = " + genArrayLenOffset(o) + ",\n"
              + "    .is_mutable = " + (o.objIsMutable ? "1" : "0") + ",\n"
              + "    .discriminator = " + String(o.objDiscriminator) + ",\n"
              + "    .name = \"" + o.objName + "\",\n"
              + "    .implements_array = VTABLE_IMPLEMENTS(" + String(listLen(implementsArr))
              + ", " + join(implementsArr, ", ") + "),\n"
              + "    .lookup = { " + vtableStr + " },\n"
              + "};\n"))
  ret GenAcc(arrPtrMask.cache, typedefs1,
             append(acc.gaForwards, commentLine + "static vtable_t* const obj_" + mangled + ";\n"),
             variables1, acc.gaFunctions, acc.gaGcRoots)

fun [tail] vtRows(n: Int, acc: List<VtRow>): List<VtRow>
  if n <= 0
    ret acc
  ret vtRows(n - 1, append(acc, vtDefaultRow()))

# Is the LAST row the catch-all? (An empty table has nothing to guard.)
fun vtLastIsDefault(rows: List<VtRow>): Bool
  ret vtLastLoop(chain(rows), true)

fun [tail] vtLastLoop(rs: Chain<VtRow>, sofar: Bool): Bool
  ret match(rs)
    (nil: ChainEnd) => sofar
    (l: ChainLink)  => vtLastLoop(l.next, vtIsDefault(l.value))

# id & (size-1), linear probe past occupied rows, growing as needed.
fun vtPlace(rows: List<VtRow>, s2: CgFuncSlot, methodIds: List<MethodId>, size: Int): List<VtRow>
  let id = miIdOf(methodIds, s2.slotVirtualName)
  ret vtProbe(rows, id & (size - 1),
              VtRow("__FUNCTION_ID__" + mangleName(s2.slotVirtualName),
                    "(void*)&" + mangleName(s2.slotGlobalName)))

# ONE walk places the row: skip to `index`, then probe forward to the first
# default slot, splicing the new row in where it lands (or appending when the
# probe runs off the end). The old form re-indexed and rebuilt the whole table
# per probe step.
fun vtProbe(rows: List<VtRow>, index: Int, row: VtRow): List<VtRow>
  ret vtProbeLoop(chain(rows), index, row, List<VtRow>())

fun [tail] vtProbeLoop(rest: Chain<VtRow>, index: Int, row: VtRow,
                       seen: List<VtRow>): List<VtRow>
  ret match(rest)
    (nil: ChainEnd) => append(seen, row)
    (l: ChainLink)  => index > 0
      ? vtProbeLoop(l.next, index - 1, row, append(seen, l.value))
      : vtIsDefault(l.value)
        ? concat(append(seen, row), List<VtRow>(l.next))
        : vtProbeLoop(l.next, index, row, append(seen, l.value))

fun genArrayLenOffset(o: CgObject): String
  ret match(o.objLengthField)
    (l: String) => "offsetof(" + mangleName(o.objName) + "_t, " + mangleName(l) + ")"
    ()           => "0"

class [final] GenMasks(gmVarLines: List<String>, gmMasksInit: String)

# Objects wider than 64 slots carry the rest of the pointer map in a static
# window array; window 0 duplicates the inline word.
fun genObjectMasks(o: CgObject, commentLine: String, mangled: String): GenMasks
  let nwindows = cgObjectGetPointerMaskWindowCount(o)
  if nwindows <= 1
    ret GenMasks(List<String>(), "")
  let masksName = "pmasks_" + mangled
  let windows = join(genMaskWindows(o, nwindows, 0, List<String>()), ",\n    ")
  ret GenMasks(list1(commentLine + "static const ptr_mask_t " + masksName + "[" + String(nwindows)
                     + "] = {\n    " + windows + "\n};\n"),
               "    .object_pointer_masks = " + masksName + ",\n"
               + "    .object_pointer_mask_words = " + String(nwindows) + ",\n")

fun [tail] genMaskWindows(o: CgObject, n: Int, w: Int, acc: List<String>): List<String>
  if w >= n
    ret acc
  ret genMaskWindows(o, n, w + 1, append(acc, cgObjectGetPointerMaskWindow(o, w)))

# ── per-global: emission + GC roots ──────────────────────────────────────────

fun genGlobal(acc: GenAcc, g2: CgGlobal, a: CgApp): GenAcc
  # to_c_prototype: the FULL dispatch (static-object globals tentatively
  # declare their `<name>_data` struct too) plus the ";\n" terminator —
  # not the bare Plain form.
  let proto = cgGlobalToCPrototype(g2, acc.gaCache)
  let impl = cgGlobalToCImplement(g2, proto.cache)
  let roots = genGlobalRoots(g2, a)
  ret GenAcc(impl.cache, acc.gaTypedefs, append(acc.gaForwards, proto.text),
             append(acc.gaVariables, impl.text), acc.gaFunctions,
             concat(acc.gaGcRoots, roots))

fun genGlobalRoots(g2: CgGlobal, a: CgApp): List<String>
  # Old-style lazy global: the value lives directly in the slot.
  if isNoneStr(g2.globalObjectName) && !isNoneStr(g2.globalLazyInitFunction)
    ret cgTypePointerPaths(g2.globalType, cgGlobalToCName(g2))
  # Static class-instance global: register the <name>_data in-struct pointer
  # field addresses (skip the leading vtable `type` field). INTERNED STRING
  # LITERALS are not roots: compile-time constants, bytes in .data, never
  # written after static initialisation — they alone put thousands of dead
  # roots into every cycle's scan. (Pruning ALL frozen statics broke the
  # runtime — a non-string static holds a heap pointer; tracked separately.)
  if !isNoneStr(g2.globalObjectName) && !isNoneR2(g2.globalInit)
     && !(isNoneStr(g2.globalLazyInitFunction)
          && startsWith(g2.globalName, "$strings::"))
    ret genStaticInstanceRoots(g2, a)
  ret List<String>()

fun isNoneR2(r: RParam|None): Bool
  ret match(r)
    (x: RParam) => false
    ()           => true

fun genStaticInstanceRoots(g2: CgGlobal, a: CgApp): List<String>
  ret match(g2.globalObjectName)
    (objName: String) => match(appObject(a, objName))
      (cls: CgObject) => genStaticRootsFields(cls, g2)
      ()               => List<String>()
    ()                 => List<String>()

fun genStaticRootsFields(cls: CgObject, g2: CgGlobal): List<String>
  let fields = cgFieldsOfOrEmpty(cls.objFields)
  if listLen(fields) <= 1
    ret List<String>()
  ret cgPathsFields(tail(fields), cgGlobalToCName(g2) + "_data")

# ── roots + main ─────────────────────────────────────────────────────────────

fun genDeclareRoots(roots: List<String>): String
  let declarations = join(map(roots, (r: String) => "declare((object_t**)&" + r + ")"), ";\n    ")
  ret "static roots_declaration_func_t _previous_declare_roots;\n"
      + "static void _declare_roots(void(*declare)(object_t**)) {\n"
      + "    _previous_declare_roots(declare);\n"
      + "    " + declarations + ";\n"
      + "}\n"

fun genDeclareMain(): String
  ret "int main(int argc, char** argv) {\n"
      + "    _yafl_argc = argc;\n"
      + "    _yafl_argv = argv;\n"
      + "    _previous_declare_roots = add_roots_declaration_func(_declare_roots);\n"
      + "    thread_start(__entrypoint__);\n"
      + "    return 0;\n"
      + "}\n"

# ── the assembly ─────────────────────────────────────────────────────────────

fun genDiagnostics(): String
  ret join(map(append(append(append(append(List<String>(),
        "-Wunused-variable"), "-Wunused-but-set-variable"), "-Wunused-parameter"),
        "-Wunused-const-variable"),
        (w: String) => "#pragma GCC diagnostic ignored \"" + w + "\""), "\n")
      + "\n#pragma GCC diagnostic ignored \"-Wmissing-braces\""

fun genApplication(a: CgApp, headers: List<String>): List<String>
  let vtables = fold(a.appObjects, List<VtableEntry>(), (acc: List<VtableEntry>, o: CgObject) =>
                  o.objIsForeign
                    ? acc
                    : append(acc, VtableEntry(o.objName,
                        map(o.objFunctions, (s2: CgFuncSlot) => s2.slotVirtualName))))
  let ph = createPerfectLookups(vtables)
  let acc1 = fold(a.appFunctions, genAccEmpty(), (acc: GenAcc, f: CgFunction) =>
               isNoneStr(f.fnForeignSymbol) ? genFunction(acc, f) : genExtern(acc, f))
  let acc2 = fold(objectsInExtendsOrder(a), acc1, (acc: GenAcc, o: CgObject) =>
               o.objIsForeign ? acc : genObject(acc, o, ph.methodIds, ph.vtableSizes))
  let acc3 = fold(a.appGlobals, acc2, (acc: GenAcc, g2: CgGlobal) => genGlobal(acc, g2, a))
  # A flat list of modest fragments, never one giant string — the caller
  # streams them to stdout in order (Application.gen returns the same parts
  # shape). Separators are explicit elements: "\n" between the items of a
  # section, "\n\n" between sections (including empty ones — the vtables
  # section is always empty here, matching Python's unused __vtables list).
  # Assembling the joined text needed one ~83MB contiguous allocation at the
  # end of a compiler-sized run.
  ret genFlatten(append(append(append(append(append(append(append(append(append(append(append(
        List<List<String>>(),
        map(headers, (h: String) => "#include <" + h + ">")),
        append(List<String>(), genDiagnostics())),
        append(List<String>(), genFunctionIds(ph.methodIds))),
        map(acc3.gaCache, (e2: CgCacheEntry) => e2.entryTypedef)),
        acc3.gaTypedefs),
        acc3.gaForwards),
        List<String>()),
        acc3.gaVariables),
        acc3.gaFunctions),
        append(List<String>(), genDeclareRoots(acc3.gaGcRoots))),
        append(List<String>(), genDeclareMain())))

# Flatten sections into the parts list with separator elements. Byte-exact
# twin of the old nested join: "\n\n" precedes every section but the first,
# "\n" precedes every item but its section's first.
fun genFlatten(sections: List<List<String>>): List<String>
  ret gfSections(chain(sections), true, List<String>())

fun [tail] gfSections(ss: Chain<List<String>>, first: Bool,
                      acc: List<String>): List<String>
  ret match(ss)
    (nil: ChainEnd) => acc
    (l: ChainLink)  => gfSections(l.next, false,
        gfItems(chain(l.value), true, first ? acc : append(acc, "\n\n")))

fun [tail] gfItems(is2: Chain<String>, first: Bool,
                   acc: List<String>): List<String>
  ret match(is2)
    (nil: ChainEnd) => acc
    (l: ChainLink)  => gfItems(l.next, false,
        append(first ? acc : append(acc, "\n"), l.value))
