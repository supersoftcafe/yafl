# bootstrap/check_stmt.yafl — Statement.check per kind, ported from the
# check() methods in compiler/pyast/statement/. Message strings VERBATIM.
namespace Bootstrap

import System

fun checkStmtKind(st: PStmt, r: Resolver, retTy: Spec|None): List<PErr>
  ret match(st)
    (f: PsFun)         => checkFun2(f, r)
    (l: PsLet)         => checkLet2(l, r)
    (d: PsDestructure) => checkDestructure2(d, r)
    (c: PsClass)       => checkClass2(c, r)
    (e2: PsEnum)       => checkEnum2(e2, r)
    (ta: PsTypealias)  => checkTypealias2(ta, r)
    (rt: PsRet)        => checkRet2(rt, r, retTy)
    (a: PsAction)      => checkAction2(a, r)
    (i: PsIf)          => checkIf2(i, r, retTy)
    (ei: PsElseIf)     => oneErr(ei.pseiLine,
                                 "`else if` without a matching preceding `if`")
    (el: PsElse)       => oneErr(el.pselLine,
                                 "`else` without a matching preceding `if`")
    (im: PsImport)     => noErrs()
    (ns: PsNamespace)  => noErrs()
    # Never survives parse() — expanded by the fixup; arm for exhaustiveness.
    (inst: PsInstance) => noErrs()

# ── FunctionStatement ───────────────────────────────────────────────────────

fun checkFun2(f: PsFun, r0: Resolver): List<PErr>
  let r = genScope(f.fGens, r0)
  let bodyR = localScope(paramLets(f.fParams),
                         f.fNested ? r : traitScope(f.fWheres, r))
  let err1 = checkSpecOpt(f.fRet, r)
  let err2 = checkStmt2(f.fParams, r, None)
  let err3 = match(f.fBody)
    (b: PExpr) => checkExpr(b, bodyR, f.fRet)
    ()         => noErrs()
  let err4 = checkSpecs(chain(f.fWheres), r, noErrs())
  ret concat(err1,
      concat(err2,
      concat(err3,
      concat(err4,
      concat(funAttrErrs(f),
      concat(paramDefaultErrs(chain(flattenParams(f.fParams)), r, noErrs()),
      concat(missingRetErrs(f, bodyR),
             unusedParamWarns(f))))))))

# A declared result must actually be produced: a body that type-checks to no
# value (no `ret` reaches the function block and no trailing value) would
# generate `Return(None)` and crash codegen — a bare tail-call STATEMENT where
# `ret f(...)` was meant.
fun missingRetErrs(f: PsFun, bodyR: Resolver): List<PErr>
  ret match(f.fBody)
    (b: PExpr) => match(f.fRet)
      (rt: Spec) => match(exprType(b, bodyR))
        (bt: Spec) => noErrs()
        ()          => oneErr(f.psfLine,
                              "function '" + bareOfUnique(f.fName)
                              + "' declares a result but its body never returns a value — missing `ret`?")
      ()         => noErrs()
    ()         => noErrs()

fun funAttrErrs(f: PsFun): List<PErr>
  ret concat(foreignErrs(f),
      concat(noArgAttr(f, "impure", "[impure] takes no arguments"),
      concat(noArgAttr(f, "sync", "[sync] takes no arguments"),
      concat(tailErrs(f),
      concat(noArgAttr(f, "terminal", "[terminal] takes no arguments"),
             innerWhereErrs(f))))))

fun attrValueOf(attrs: List<PAttr>, name: String): PExpr|None
  ret avLoop(chain(attrs), name)

fun [tail] avLoop(as2: Chain<PAttr>, name: String): PExpr|None
  ret match(as2)
    (nil: ChainEnd) => None
    (l: ChainLink)  => l.value.attrName == name
      ? l.value.attrValue
      : avLoop(l.next, name)

fun noArgAttr(f: PsFun, name: String, msg: String): List<PErr>
  if !hasAttr(f.fAttrs, name)
    ret noErrs()
  ret match(attrValueOf(f.fAttrs, name))
    (v: PExpr) => oneErr(f.psfLine, msg)
    ()         => noErrs()

fun foreignErrs(f: PsFun): List<PErr>
  if !hasAttr(f.fAttrs, "foreign")
    ret noErrs()
  if !isOneStringArg(attrValueOf(f.fAttrs, "foreign"))
    ret oneErr(f.psfLine,
               "[foreign] requires exactly one string argument: [foreign(\"symbol\")]")
  ret match(f.fBody)
    (b: PExpr) => oneErr(f.psfLine, "[foreign] functions must have no body")
    ()         => noErrs()

fun isOneStringArg(v: PExpr|None): Bool
  ret match(v)
    (x: PExpr) => match(x)
      (tp: PeTuple) => listLen(tp.exprs) == 1 && firstIsString(head(tp.exprs))
      (o: PExpr)    => false
    ()         => false

fun firstIsString(en: PTupEnt|None): Bool
  ret match(en)
    (e2: PTupEnt) => match(e2.tupValue)
      (s2: PeStr) => true
      (o: PExpr)  => false
    ()            => false

fun tailErrs(f: PsFun): List<PErr>
  if !hasAttr(f.fAttrs, "tail")
    ret noErrs()
  let argErr = noArgAttr(f, "tail", "[tail] takes no arguments")
  ret match(f.fBody)
    (b: PExpr) => argErr
    ()         => concat(argErr,
                         oneErr(f.psfLine,
                                "[tail] cannot be applied to a foreign function"))

# An inner function carries no `where` — it inherits its owner's trait scope,
# so a `where` on it would silently do nothing.
fun innerWhereErrs(f: PsFun): List<PErr>
  ret f.fNested && !isEmpty(f.fWheres)
    ? oneErr(f.psfLine,
             "`where` is not allowed on an inner function — move it to a top-level function")
    : noErrs()

fun [tail] paramDefaultErrs(ls: Chain<PStmt>, r: Resolver,
                            acc: List<PErr>): List<PErr>
  ret match(ls)
    (nil: ChainEnd) => acc
    (l: ChainLink)  => match(l.value)
      (let2: PsLet) => paramDefaultErrs(l.next, r,
                         concat(acc, defaultValueErrors(let2.lDefault, r,
                                                        let2.pslLine,
                                                        "parameter")))
      (o: PStmt)    => paramDefaultErrs(l.next, r, acc)

# No value vanishes silently: a parameter the body never reads. `this` is
# implicit; a `_` prefix is the opt-out; [terminal] params are consumed on
# arrival.
fun unusedParamWarns(f: PsFun): List<PErr>
  ret match(f.fBody)
    (b: PExpr) => unusedParamLoop(chain(flattenParams(f.fParams)),
                                  referencedNames(b, List<String>()), noErrs())
    ()         => noErrs()

fun [tail] unusedParamLoop(ls: Chain<PStmt>, referenced: List<String>,
                           acc: List<PErr>): List<PErr>
  ret match(ls)
    (nil: ChainEnd) => acc
    (l: ChainLink)  => match(l.value)
      (let2: PsLet) => skipParamWarn(let2, referenced)
        ? unusedParamLoop(l.next, referenced, acc)
        : unusedParamLoop(l.next, referenced,
            append(acc, PErr(let2.pslLine,
                             "parameter '" + bareOfUnique(let2.lName)
                             + "' is never used", true)))
      (o: PStmt)    => unusedParamLoop(l.next, referenced, acc)

fun skipParamWarn(let2: PsLet, referenced: List<String>): Bool
  ret startsWith(bareOfUnique(let2.lName), "_")
      || bareOfUnique(let2.lName) == "this"
      || hasAttr(let2.lAttrs, "terminal")
      || contains2(referenced, let2.lName)

# ── LetStatement / DestructureStatement ─────────────────────────────────────

fun checkLet2(l: PsLet, r: Resolver): List<PErr>
  let bad = letTypeErr(l, r)
  ret isEmpty(bad) ? letSubErrs(l, r) : bad

fun letTypeErr(l: PsLet, r: Resolver): List<PErr>
  ret match(l.lDefault)
    (d: PExpr) => match(l.lType)
      (want: Spec) => match(exprType(d, r))
        (xt: Spec) => triFalse(assignableEq(r, want, xt))
          ? oneErr(l.pslLine, "Incorrect type")
          : noErrs()
        ()         => noErrs()
      ()           => noErrs()
    ()         => noErrs()

fun letSubErrs(l: PsLet, r: Resolver): List<PErr>
  let err1 = match(l.lDefault)
    (d: PExpr) => checkExpr(d, r, l.lType)
    ()         => noErrs()
  let err2 = checkSpecOpt(l.lType, r)
  let whereErr = checkSpecs(chain(l.lWheres), r, noErrs())
  ret concat(err1, concat(err2, concat(letAttrErrs(l, r), whereErr)))

fun letAttrErrs(l: PsLet, r: Resolver): List<PErr>
  ret concat(constErrs(l), lazyFutureErrs(l))

fun constErrs(l: PsLet): List<PErr>
  if !hasAttr(l.lAttrs, "const")
    ret noErrs()
  let argErr = letAttrArgErr(l, "const", "[const] takes no arguments")
  ret isConstLiteral(l.lDefault)
    ? argErr
    : concat(argErr, oneErr(l.pslLine, "[const] requires a literal value"))

fun letAttrArgErr(l: PsLet, name: String, msg: String): List<PErr>
  ret match(attrValueOf(l.lAttrs, name))
    (v: PExpr) => oneErr(l.pslLine, msg)
    ()         => noErrs()

fun hasInit(l: PsLet): Bool
  ret match(l.lDefault)
    (d: PExpr) => true
    ()         => false

fun isConstLiteral(d: PExpr|None): Bool
  ret match(d)
    (x: PExpr) => isLiteralValue(x)
    ()         => false

fun lazyFutureErrs(l: PsLet): List<PErr>
  ret concat(lazyErrs(l), futureErrs(l))

fun lazyErrs(l: PsLet): List<PErr>
  if !hasAttr(l.lAttrs, "lazy")
    ret noErrs()
  let argErr = letAttrArgErr(l, "lazy", "[lazy] takes no arguments")
  ret hasInit(l)
    ? argErr
    : concat(argErr, oneErr(l.pslLine, "[lazy] requires an initialiser"))

fun futureErrs(l: PsLet): List<PErr>
  if !hasAttr(l.lAttrs, "future")
    ret noErrs()
  let argErr = letAttrArgErr(l, "future", "[future] takes no arguments")
  let initErr = hasInit(l)
    ? noErrs()
    : oneErr(l.pslLine, "[future] requires an initialiser")
  let bothErr = hasAttr(l.lAttrs, "lazy")
    ? oneErr(l.pslLine,
             "[lazy] and [future] are mutually exclusive — a future IS "
             + "lazy when the worker pool is busy; pick one")
    : noErrs()
  ret concat(argErr, concat(initErr, bothErr))

# A destructure inherits the let rules (Python: DestructureStatement extends
# LetStatement and does not override check).
fun checkDestructure2(d: PsDestructure, r: Resolver): List<PErr>
  let typeErr = match(d.dDefault)
    (x: PExpr) => match(d.dType)
      (want: Spec) => match(exprType(x, r))
        (xt: Spec) => triFalse(assignableEq(r, want, xt))
          ? oneErr(d.psdLine, "Incorrect type")
          : noErrs()
        ()         => noErrs()
      ()           => noErrs()
    ()         => noErrs()
  if !isEmpty(typeErr)
    ret typeErr
  let err1 = match(d.dDefault)
    (x: PExpr) => checkExpr(x, r, d.dType)
    ()         => noErrs()
  ret concat(err1, checkSpecOpt(d.dType, r))

# ── control ─────────────────────────────────────────────────────────────────

fun checkRet2(rt: PsRet, r: Resolver, retTy: Spec|None): List<PErr>
  ret match(exprType(rt.retValue, r))
    (xt: Spec) => triFalse(assignableEq(r, retTy, xt))
      ? oneErr(rt.psrLine, "Incorrect return type")
      : checkExpr(rt.retValue, r, retTy)
    ()         => checkExpr(rt.retValue, r, retTy)

# No value vanishes silently: a statement-position expression discards its
# result. Unit carries nothing and is fine; anything else warns.
fun checkAction2(a: PsAction, r: Resolver): List<PErr>
  let errs = checkExpr(a.action, r, None)
  ret match(exprType(a.action, r))
    (xt: Spec) => isUnitType(xt)
      ? errs
      : append(errs, PErr(a.psaLine,
                          "statement value is discarded — bind it to '_' to "
                          + "discard explicitly", true))
    ()         => errs

fun isUnitType(xt: Spec): Bool
  ret match(xt)
    (tp: STuple) => isEmpty(tp.stEntries)
    (o: Spec)    => false

fun checkIf2(i: PsIf, r: Resolver, retTy: Spec|None): List<PErr>
  let condErr = checkExpr(i.ifCond, r, SBuiltin("bool", i.psifLine))
  let boolErr = match(exprType(i.ifCond, r))
    (ct: Spec) => triTrue(assignableEq(r, SBuiltin("bool", i.psifLine), ct))
      ? noErrs()
      : oneErr(exprLine(i.ifCond), "if condition must be Bool")
    ()         => noErrs()
  ret concat(condErr,
      concat(boolErr,
      concat(branchChecks(chain(i.ifTrue), blockScope(i.ifTrue, r), retTy,
                          noErrs()),
             branchChecks(chain(i.ifFalse), blockScope(i.ifFalse, r), retTy,
                          noErrs()))))

fun [tail] branchChecks(ss: Chain<PStmt>, r: Resolver, retTy: Spec|None,
                        acc: List<PErr>): List<PErr>
  ret match(ss)
    (nil: ChainEnd) => acc
    (l: ChainLink)  => branchChecks(l.next, r, retTy,
                                    concat(acc, checkStmt2(l.value, r, retTy)))

# ── classes / enums / typealiases ───────────────────────────────────────────

fun checkClass2(c: PsClass, r0: Resolver): List<PErr>
  ret match(c.cAllParents)
    (ps: List<Spec>) => classChecks(c, r0)
    ()               => oneErr(c.pscLine, "Missed compile step")

# NOT PORTED YET: the [foreign]-class rules and the slot multi-override /
# no-implementation checks (classdef.py:235-260, needs invert_and_merge_slots)
# — the check contract's first-diff will demand them when a corpus case does.
fun classChecks(c: PsClass, r0: Resolver): List<PErr>
  let inh = findClassesOrError(c.cImplements, r0)
  let implErr = implErrors(chain(c.cImplements), r0, noErrs())
  let pureErr = allPureInterfaces(chain(inh))
    ? noErrs()
    : oneErr(c.pscLine, "Must only inherit from pure interfaces")
  let finalErr = finalParentErrs(c, chain(inh), noErrs())
  let fragile = fragileWarns(c, inh, r0)
  let prmErr = checkStmt2(c.cParams, genScope(c.cGens, r0), None)
  # Member fns CHECK under the same transient owner-wheres copy they
  # compiled under (compile_stmt withOwnerWheres).
  let stmErr = branchChecks(chain(withOwnerWheres(c.cMembers, c.cWheres)),
                            genScope(c.cGens, RClassBody(c, r0)), None,
                            noErrs())
  ret concat(implErr,
      concat(pureErr,
      concat(finalErr,
      concat(fragile,
      concat(prmErr, concat(stmErr, arrayFieldErrs(c, r0)))))))

# The trailing array field: at most one, the class [final], and its length
# field an Int32 sibling.
fun arrayFieldErrs(c: PsClass, r: Resolver): List<PErr>
  let fields = classFields(c)
  let arrays = arrayFieldsOf(chain(fields), List<PStmt>())
  if isEmpty(arrays)
    ret noErrs()
  let countErr = listLen(arrays) > 1
    ? oneErr(c.pscLine, "a class may have at most one array field")
    : noErrs()
  let finalErr2 = hasAttr(c.cAttrs, "final")
    ? noErrs()
    : oneErr(c.pscLine, "a class with an array field must be [final]")
  ret concat(countErr,
             concat(finalErr2, lenFieldErrs(chain(arrays), fields, noErrs())))

fun classFields(c: PsClass): List<PStmt>
  ret concat(flattenParams(c.cParams), letMembers(chain(c.cMembers),
                                                  List<PStmt>()))

fun [tail] letMembers(ms: Chain<PStmt>, acc: List<PStmt>): List<PStmt>
  ret match(ms)
    (nil: ChainEnd) => acc
    (l: ChainLink)  => match(l.value)
      (let2: PsLet) => letMembers(l.next, append(acc, l.value))
      (o: PStmt)    => letMembers(l.next, acc)

fun [tail] arrayFieldsOf(fs: Chain<PStmt>, acc: List<PStmt>): List<PStmt>
  ret match(fs)
    (nil: ChainEnd) => acc
    (l: ChainLink)  => isArrayStorage(l.value)
      ? arrayFieldsOf(l.next, append(acc, l.value))
      : arrayFieldsOf(l.next, acc)

fun [tail] lenFieldErrs(as2: Chain<PStmt>, fields: List<PStmt>,
                        acc: List<PErr>): List<PErr>
  ret match(as2)
    (nil: ChainEnd) => acc
    (l: ChainLink)  => match(l.value)
      (af: PsLet) => lenFieldErrs(l.next, fields,
                                  concat(acc, oneLenErr(af, fields)))
      (o: PStmt)  => lenFieldErrs(l.next, fields, acc)

fun oneLenErr(af: PsLet, fields: List<PStmt>): List<PErr>
  let lenName = arrayLenName(af.lType)
  ret match(fieldNamed2(chain(fields), lenName))
    (m: PsLet) => isInt32Field(m)
      ? noErrs()
      : oneErr(af.pslLine, "array length field '" + lenName
                           + "' must be of type Int32")
    ()         => oneErr(af.pslLine, "array length field '" + lenName
                                     + "' is not a field of this class")

fun arrayLenName(ty: Spec|None): String
  ret match(ty)
    (t2: Spec) => match(t2)
      (af: SArrayField) => af.safLenField
      (o: Spec)         => ""
    ()         => ""

fun [tail] fieldNamed2(fs: Chain<PStmt>, name: String): PsLet|None
  ret match(fs)
    (nil: ChainEnd) => None
    (l: ChainLink)  => match(l.value)
      (let2: PsLet) => matchName(let2.lName, name)
        ? let2
        : fieldNamed2(l.next, name)
      (o: PStmt)    => fieldNamed2(l.next, name)

fun isInt32Field(m: PsLet): Bool
  ret match(m.lType)
    (t2: Spec) => match(t2)
      (b: SBuiltin) => b.sbName == "int32"
      (o: Spec)     => false
    ()         => false

# find_classes_or_error's ERROR half, reconstructed with the same messages.
fun [tail] implErrors(ts: Chain<Spec>, r: Resolver,
                      acc: List<PErr>): List<PErr>
  ret match(ts)
    (nil: ChainEnd) => acc
    (l: ChainLink)  => implErrors(l.next, r, concat(acc, implError(l.value, r)))

fun implError(xtype: Spec, r: Resolver): List<PErr>
  ret match(xtype)
    (n: SNamed) => implNameError(n.snName, ctSpecLine(xtype), r)
    (c: SClass) => implNameError(c.scName, ctSpecLine(xtype), r)
    (o: Spec)   => oneErr(ctSpecLine(xtype),
                          "Class cannot inherit from this type \"<class 't'>\"")

fun implNameError(name: String, lr: PLine, r: Resolver): List<PErr>
  let found = findType(r, name)
  if bagSize(found) == 0
    ret oneErr(lr, "Could not find class named \"" + name + "\"")
  if bagSize(found) > 1
    ret oneErr(lr, "Found too many classes named \"" + name + "\"")
  ret match(soleItem(found))
    (f: Found) => match(f.fStmt)
      (cs: PsClass) => noErrs()
      (o: PStmt)    => oneErr(lr, "Found non-class named \"" + name + "\"")
    ()         => noErrs()

fun [tail] allPureInterfaces(fs: Chain<FoundClass>): Bool
  ret match(fs)
    (nil: ChainEnd) => true
    (l: ChainLink)  => match(l.value.fcClass)
      (cs: PsClass) => cs.cIsInterface ? allPureInterfaces(l.next) : false
      ()            => allPureInterfaces(l.next)

fun [tail] finalParentErrs(c: PsClass, fs: Chain<FoundClass>,
                           acc: List<PErr>): List<PErr>
  ret match(fs)
    (nil: ChainEnd) => acc
    (l: ChainLink)  => match(l.value.fcClass)
      (cs: PsClass) => hasAttr(cs.cAttrs, "final")
        ? finalParentErrs(c, l.next,
            append(acc, PErr(c.pscLine,
                             "Cannot inherit from final class '" + cs.cName
                             + "'")))
        : finalParentErrs(c, l.next, acc)
      ()            => finalParentErrs(c, l.next, acc)

# Fragile-base warning: one method overriding several similar methods of a
# SINGLE immediate parent.
fun fragileWarns(c: PsClass, inh: List<FoundClass>, r: Resolver): List<PErr>
  ret fbLoop(chain(createSlotsFromMembers(c)), c, inh, r, noErrs())

fun [tail] fbLoop(bs: Chain<Slot>, c: PsClass, inh: List<FoundClass>,
                  r: Resolver, acc: List<PErr>): List<PErr>
  ret match(bs)
    (nil: ChainEnd) => acc
    (l: ChainLink)  => fbLoop(l.next, c, inh, r,
                              fbParents(l.value, chain(inh), c, r, acc))

fun [tail] fbParents(slot: Slot, fs: Chain<FoundClass>, c: PsClass,
                     r: Resolver, acc: List<PErr>): List<PErr>
  ret match(fs)
    (nil: ChainEnd) => acc
    (l: ChainLink)  => match(l.value.fcClass)
      (p: PsClass) => fbParents(slot, l.next, c, r,
                                fbOne(slot, p, c, r, acc))
      ()           => fbParents(slot, l.next, c, r, acc)

fun fbOne(slot: Slot, p: PsClass, c: PsClass, r: Resolver,
          acc: List<PErr>): List<PErr>
  let captured = sort(capturedNames(chain(createSlotsFromMembers(p)), slot, r,
                                    List<String>()))
  ret listLen(captured) > 1
    ? append(acc, PErr(c.pscLine,
                       "`" + bareOfUnique(slot.slotName) + "` overrides "
                       + String(listLen(captured)) + " similar methods of `"
                       + bareOfUnique(p.cName)
                       + "` at once — a broad override silently captures "
                       + "them; give it a narrower signature or override "
                       + "each explicitly", true))
    : acc

fun [tail] capturedNames(ps: Chain<Slot>, slot: Slot, r: Resolver,
                         acc: List<String>): List<String>
  ret match(ps)
    (nil: ChainEnd) => acc
    (l: ChainLink)  => matchName(slot.slotName, l.value.slotName)
                       && triTrue(assignableEq(r, l.value.slotType,
                                               slot.slotType))
      ? capturedNames(l.next, slot, r, addNameOnce(acc, l.value.slotName))
      : capturedNames(l.next, slot, r, acc)

fun checkEnum2(e2: PsEnum, r: Resolver): List<PErr>
  ret match(e2.eSpec)
    (sp: Spec) => concat(checkStmt2(e2.eParams, r, None),
                  concat(branchChecks(chain(e2.eVariants), r, None, noErrs()),
                         linearGenErrs(e2, chain(e2.eGens), noErrs())))
    ()         => oneErr(e2.pseLine, "Missed compile step")

fun [tail] linearGenErrs(e2: PsEnum, gs: Chain<PGen>,
                         acc: List<PErr>): List<PErr>
  ret match(gs)
    (nil: ChainEnd) => acc
    (l: ChainLink)  => hasAttr(l.value.genAttrs, "linear")
      ? linearGenErrs(e2, l.next,
          append(acc, PErr(e2.pseLine,
                           "[linear] type parameters are only supported on functions")))
      : linearGenErrs(e2, l.next, acc)

fun checkTypealias2(ta: PsTypealias, r0: Resolver): List<PErr>
  let r = isEmpty(ta.taGens) && isEmpty(ta.taWheres)
    ? r0
    : genScope(ta.taGens, r0)
  ret concat(checkSpec(ta.taType, r),
             checkSpecs(chain(ta.taWheres), r, noErrs()))
