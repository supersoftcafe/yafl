# list_bench — System::Containers::List workloads.
#
#   list_bench <build|prepend|map|filter|concat|takedrop>
#
# Each mode prints a checksum, which must not change between builds: it is
# the correctness check. The wall time is taken outside, like every other
# bench in this folder (the language has no clock by design).
#
# (This bench used to compare the old cons-chain System::List against the
# then-new list; the old one is gone. The modes, scales and checksums are
# unchanged, so numbers stay comparable with those runs.)
#
#   env -u YAFL_PATH -u YAFL_LIBYAFL_A build/ybootstrap -O3 -o build/bench_list bench/list_bench.yafl
#   bench/run_bench.py --modes build,prepend,map,filter,concat,takedrop list=build/bench_list
namespace Bench::ListBench

import System
import System::Containers


# ── scales ───────────────────────────────────────────────────────────────────
# Sized so each mode is long enough to time but stays inside the runner's
# timeout. n is the element count every mode builds; concat splits it into
# `chunks` pieces of `chunkSize`.

let modulus: System::Int = 1000000007
let n:       System::Int = 3000000

let chunkSize: System::Int = 50000
let chunks:    System::Int = 40


# ── workloads ────────────────────────────────────────────────────────────────

fun [tail] buildRange(l: List<System::Int>, i: System::Int, upto: System::Int): List<System::Int>
  ret i >= upto ? l : buildRange(append<System::Int>(l, i), i + 1, upto)

fun range(from: System::Int, upto: System::Int): List<System::Int>
  ret buildRange(List<System::Int>(), from, upto)

fun sum(l: List<System::Int>): System::Int
  ret fold<System::Int, System::Int>(l, 0, (acc: System::Int, x: System::Int) => (acc + x) % modulus)

fun build(): System::Int
  ret sum(range(0, n))

fun [tail] prependLoop(l: List<System::Int>, i: System::Int, upto: System::Int): List<System::Int>
  ret i >= upto ? l : prependLoop(prepend<System::Int>(i, l), i + 1, upto)

fun prependAll(): System::Int
  ret sum(prependLoop(List<System::Int>(), 0, n))

fun mapAll(): System::Int
  ret sum(map<System::Int, System::Int>(range(0, n), (x: System::Int) => (x * 2 + 1) % modulus))

fun filterAll(): System::Int
  ret sum(filter<System::Int>(range(0, n), (x: System::Int) => x % 3 != 0))

fun [tail] concatLoop(acc: List<System::Int>, i: System::Int, end: System::Int): List<System::Int>
  ret i >= end ? acc
    : concatLoop(concat<System::Int>(acc, range(i, i + chunkSize)), i + chunkSize, end)

fun concatAll(): System::Int
  ret sum(concatLoop(List<System::Int>(), 0, chunkSize * chunks))

fun takeDrop(): System::Int
  let l = range(0, n)
  let half = n / 2
  ret (sum(take<System::Int>(l, half)) + sum(drop<System::Int>(l, half))) % modulus


# ── entry point ──────────────────────────────────────────────────────────────

fun report(mode: System::String, result: System::Int): System::Int
  println(mode + " checksum " + String(result))
  ret 0

fun run(mode: System::String): System::Int
  ret mode == "build"    ? build()
    : mode == "prepend"  ? prependAll()
    : mode == "map"      ? mapAll()
    : mode == "filter"   ? filterAll()
    : mode == "concat"   ? concatAll()
    : mode == "takedrop" ? takeDrop()
    : -1

fun main(): System::Int
  fun usage(): System::Int
    println("usage: list_bench <build|prepend|map|filter|concat|takedrop>")
    ret 2

  fun dispatch(mode: System::String): System::Int
    let result = run(mode)
    ret result < 0 ? usage() : report(mode, result)

  ret match(head<System::String>(System::args()))
    (mode: System::String) => dispatch(mode)
    (e: System::None)      => usage()
